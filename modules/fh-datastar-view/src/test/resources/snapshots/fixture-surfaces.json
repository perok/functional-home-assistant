{
  "card" : {
    "card" : "fhcol",
    "children" : [
      {
        "card" : "tabs",
        "cell" : {
          "classes" : [
            "fh-cols-full"
          ]
        },
        "children" : [
          {
            "card" : "tab",
            "children" : [
            ],
            "kind" : "component",
            "slots" : {
              "active" : "$ui_@@NODE_ID@@ == 0",
              "label" : "Temp",
              "onclick" : "@post('sse/surface/open/@@NODE_ID@@_t0'); $ui_@@NODE_ID@@ = 0"
            }
          },
          {
            "card" : "tab",
            "children" : [
            ],
            "kind" : "component",
            "slots" : {
              "active" : "$ui_@@NODE_ID@@ == 1",
              "label" : "Light",
              "onclick" : "@post('sse/surface/open/@@NODE_ID@@_t1'); $ui_@@NODE_ID@@ = 1"
            }
          }
        ],
        "inlineSurfaces" : {
          "t0" : {
            "activation" : {
              "defaultOpen" : true,
              "kind" : "user"
            },
            "bakeAs" : "panel",
            "bakeIndex" : 0,
            "bakeInto" : "@@NODE_ID@@",
            "content" : {
              "card" : "fhrow",
              "children" : [
                {
                  "card" : "entityCard",
                  "children" : [
                  ],
                  "kind" : "component",
                  "slots" : {
                    "entity_id" : "sensor.outside_temp",
                    "icon" : "mdi-thermometer",
                    "label" : "Outside Temperature",
                    "value" : {
                      "bypassUnavailable" : true,
                      "reactive" : true,
                      "transform" : "$state & ($attr.unit_of_measurement ? \" \" & $attr.unit_of_measurement : \"\")"
                    }
                  }
                }
              ],
              "kind" : "component",
              "slots" : {
                
              }
            }
          },
          "t1" : {
            "bakeAs" : "panel",
            "bakeIndex" : 1,
            "bakeInto" : "@@NODE_ID@@",
            "content" : {
              "card" : "fhrow",
              "children" : [
                {
                  "card" : "entityCard",
                  "children" : [
                  ],
                  "kind" : "component",
                  "slots" : {
                    "entity_id" : "light.kitchen",
                    "icon" : "mdi-lightbulb",
                    "label" : "Kitchen",
                    "value" : {
                      "bypassUnavailable" : true,
                      "reactive" : true,
                      "transform" : "$state & ($attr.unit_of_measurement ? \" \" & $attr.unit_of_measurement : \"\")"
                    }
                  }
                }
              ],
              "kind" : "component",
              "slots" : {
                
              }
            }
          }
        },
        "kind" : "component",
        "slots" : {
          
        }
      },
      {
        "card" : "ifhost",
        "cell" : {
          "classes" : [
            "fh-cols-full"
          ]
        },
        "children" : [
        ],
        "inlineSurfaces" : {
          "else" : {
            "activation" : {
              "condition" : {
                "items" : [
                ],
                "kind" : "and"
              },
              "kind" : "state"
            },
            "bakeAs" : "branch",
            "bakeIndex" : 1,
            "bakeInto" : "@@NODE_ID@@",
            "content" : {
              "card" : "fhrow",
              "children" : [
                {
                  "card" : "entityCard",
                  "children" : [
                  ],
                  "kind" : "component",
                  "slots" : {
                    "entity_id" : "sensor.outside_temp",
                    "icon" : "mdi-thermometer",
                    "label" : "Outside Temperature",
                    "value" : {
                      "bypassUnavailable" : true,
                      "reactive" : true,
                      "transform" : "$state & ($attr.unit_of_measurement ? \" \" & $attr.unit_of_measurement : \"\")"
                    }
                  }
                }
              ],
              "kind" : "component",
              "slots" : {
                
              }
            }
          },
          "then" : {
            "activation" : {
              "condition" : {
                "entity" : "light.kitchen",
                "kind" : "cmp",
                "op" : "eq",
                "property" : "state",
                "value" : "on"
              },
              "kind" : "state"
            },
            "bakeAs" : "branch",
            "bakeIndex" : 0,
            "bakeInto" : "@@NODE_ID@@",
            "content" : {
              "card" : "fhrow",
              "children" : [
                {
                  "card" : "entityCard",
                  "children" : [
                  ],
                  "kind" : "component",
                  "slots" : {
                    "entity_id" : "light.kitchen",
                    "icon" : "mdi-lightbulb",
                    "label" : "Kitchen",
                    "value" : {
                      "bypassUnavailable" : true,
                      "reactive" : true,
                      "transform" : "$state & ($attr.unit_of_measurement ? \" \" & $attr.unit_of_measurement : \"\")"
                    }
                  }
                }
              ],
              "kind" : "component",
              "slots" : {
                
              }
            }
          }
        },
        "kind" : "component",
        "slots" : {
          
        }
      }
    ],
    "kind" : "component",
    "slots" : {
      
    }
  },
  "cards" : {
    "button" : {
      "slots" : [
        "label"
      ],
      "template" : "{{#href}}<a class=\"button card\" href=\"{{{href}}}\">{{label}}</a>{{/href}}{{^href}}<button class=\"card\" data-on:click=\"{{{onclick}}}\">{{label}}</button>{{/href}}"
    },
    "entityCard" : {
      "slots" : [
        "label",
        "value",
        "entity_id"
      ],
      "template" : "<article class=\"card entity{{#tappable}} tappable{{/tappable}}\"{{#tappable}}\n  data-on:click=\"{{{onclick}}}\"{{/tappable}}>\n  <header>{{#icon}}<i class=\"mdi {{icon}}\"></i>{{/icon}}{{label}}</header>\n  <span class=\"state\">{{value}}</span>{{#secondary}}\n  <span class=\"secondary\">{{secondary}}</span>{{/secondary}}\n</article>"
    },
    "fhcol" : {
      "mount" : "<div class=\"fh-col{{#class}} {{class}}{{/class}}\">{{#children}}{{{html}}}{{/children}}</div>",
      "slots" : [
      ],
      "template" : "{{{self}}}{{{mount}}}"
    },
    "fhgrid" : {
      "mount" : "<div class=\"fh-grid{{#class}} {{class}}{{/class}}\">{{#children}}{{{html}}}{{/children}}</div>",
      "slots" : [
      ],
      "template" : "{{{self}}}{{{mount}}}"
    },
    "fhrow" : {
      "mount" : "<div class=\"fh-row{{#class}} {{class}}{{/class}}\">{{#children}}{{{html}}}{{/children}}</div>",
      "slots" : [
      ],
      "template" : "{{{self}}}{{{mount}}}"
    },
    "ifhost" : {
      "mount" : "<div class=\"fh-ifhost\" id=\"{{mountId}}\">{{{branch}}}</div>",
      "slots" : [
      ],
      "template" : "{{{self}}}{{{mount}}}"
    },
    "pill" : {
      "slots" : [
        "label"
      ],
      "template" : "{{#href}}<a class=\"chip\" href=\"{{{href}}}\">{{label}}</a>{{/href}}{{^href}}<button class=\"chip\" data-on:click=\"{{{onclick}}}\">{{label}}</button>{{/href}}"
    },
    "popup" : {
      "mount" : "<dialog open class=\"popup\"><button class=\"popup-close\" data-on:click=\"@post('sse/popup/close'); $ui_popups = ''\">✕</button>{{#children}}{{{html}}}{{/children}}</dialog>",
      "slots" : [
      ],
      "template" : "{{{self}}}{{{mount}}}"
    },
    "sectionTitle" : {
      "slots" : [
        "label"
      ],
      "template" : "<h2 class=\"section\">{{label}}</h2>"
    },
    "slider" : {
      "slots" : [
        "label",
        "state",
        "value",
        "action",
        "min",
        "max",
        "key",
        "entity_id"
      ],
      "template" : "<article class=\"card\">\n  <div class=\"slider-head\"><strong>{{label}}</strong><span class=\"state\">{{state}}</span></div>\n  <div class=\"slider max\" style=\"--_start: 0%;--_end: {{fill}}%\">\n    <input type=\"range\" min=\"{{min}}\" max=\"{{max}}\"\n      data-signals=\"{ _val_{{id}}: {{value}} }\"\n      data-bind=\"_val_{{id}}\"\n      data-on:change=\"@post('sse/action/{{{action}}}/{{{entity_id}}}/{{key}}/' + $_val_{{id}}, {filterSignals:{exclude:'.*'}})\" />\n    <span style=\"background:{{fillColor}}\"></span>\n  </div>\n</article>"
    },
    "tab" : {
      "slots" : [
        "label",
        "onclick",
        "active"
      ],
      "template" : "<a data-on:click=\"{{{onclick}}}\" data-class=\"{active: {{{active}}}}\">{{label}}</a>",
      "wrapAsCell" : false
    },
    "tabs" : {
      "mount" : "<div id=\"{{mountId}}\" class=\"tab-panel\" data-effect=\"fhUrl('ui.{{id}}', $ui_{{id}})\">{{{panel}}}</div>",
      "self" : "<div id=\"{{selfId}}\" class=\"tabs\" data-signals__ifmissing=\"{ ui_{{id}}: {{bakeIndex}} }\">{{#children}}{{{html}}}{{/children}}</div>",
      "slots" : [
      ],
      "template" : "<div class=\"fh-col\">{{{self}}}{{{mount}}}</div>"
    }
  },
  "surfaces" : {
    
  }
}