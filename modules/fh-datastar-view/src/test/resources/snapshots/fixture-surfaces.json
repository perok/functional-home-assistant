          "else" : {
            "activation" : {
              "condition" : {
                "items" : [
                ],
                "kind" : "and"
              },
              "kind" : "state"
            },
            "bakeAs" : "branch",
            "bakeIndex" : 1,
            "bakeInto" : "@@NODE_ID@@",
            "content" : {
              "card" : "fhrow",
              "children" : [
                {
                  "card" : "entityCard",
                  "children" : [
                  ],
                  "inlineSurfaces" : {
                    "self" : {
                      "content" : {
                        "card" : "popup",
                        "children" : [
                          {
                            "card" : "fhcol",
                            "children" : [
                              {
                                "card" : "entityCard",
                                "children" : [
