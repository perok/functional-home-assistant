            "bakeAs" : "panel",
            "bakeIndex" : 1,
            "bakeInto" : "@@NODE_ID@@",
            "content" : {
              "card" : "fhrow",
              "children" : [
                {
                  "card" : "entityCard",
                  "children" : [
                  ],
                  "kind" : "component",
                  "slots" : {
                    "entity_id" : "light.kitchen",
                    "icon" : "mdi-lightbulb",
                    "label" : "Kitchen",
                    "onclick" : {
                      "bypassUnavailable" : false,
                      "reactive" : false,
                      "transform" : "\"@post('sse/action/\" & (\"light/toggle\") & \"/\" & $entity_id & \"', {filterSignals:{exclude:'.*'}})\""
                    },
