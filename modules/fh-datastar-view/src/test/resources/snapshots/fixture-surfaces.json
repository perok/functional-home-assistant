                    }
                  }
                }
              ],
              "kind" : "component",
              "slots" : {
                
              }
            }
          },
          "then" : {
            "activation" : {
              "condition" : {
                "entity" : "light.kitchen",
                "kind" : "cmp",
                "op" : "eq",
                "property" : "state",
                "value" : "on"
              },
              "kind" : "state"
            },
            "bakeAs" : "branch",
            "bakeIndex" : 0,
            "bakeInto" : "@@NODE_ID@@",
            "content" : {
              "card" : "fhrow",
              "children" : [
                {
                  "card" : "entityCard",
                  "children" : [
                  ],
                  "kind" : "component",
                  "slots" : {
                    "entity_id" : "light.kitchen",
                    "icon" : "mdi-lightbulb",
                    "label" : "Kitchen",
