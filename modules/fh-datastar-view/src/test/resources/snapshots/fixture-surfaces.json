                                ],
                                "kind" : "component",
                                "slots" : {
                                  "attributes" : {
                                    "bypassUnavailable" : true,
                                    "default" : "",
                                    "reactive" : true,
                                    "transform" : "$join($sort($each($attr, function($v, $k) { $k & \": \" & $string($v) })), \"\\n\")"
                                  },
                                  "entity_id" : "sensor.outside_temp"
                                }
                              },
                              {
                                "card" : "button",
                                "children" : [
                                ],
                                "kind" : "component",
                                "slots" : {
                                  "label" : "Close",
                                  "onclick" : "@post('sse/popup/close'); $ui_popups = ''"
                                }
                              }
                            ],
                            "kind" : "component",
                            "slots" : {
                              
                            }
                          }
                        ],
                        "kind" : "component",
                        "slots" : {
                          
                        }
                      }
                    }
                  },
                  "kind" : "component",
                  "slots" : {
                    "entity_id" : "sensor.outside_temp",
                    "icon" : "mdi-thermometer",
                    "label" : "Outside Temperature",
                    "onclick" : "@post('sse/surface/open/@@NODE_ID@@_self'); $ui_popups = '@@NODE_ID@@_self'",
                    "tappable" : "1",
                    "value" : {
                      "bypassUnavailable" : true,
                      "reactive" : true,
                      "transform" : "$state & ($attr.unit_of_measurement ? \" \" & $attr.unit_of_measurement : \"\")"
                    }
                  }
                }
              ],
              "kind" : "component",
              "slots" : {
                
