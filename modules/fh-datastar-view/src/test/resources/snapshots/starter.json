      "script" : "(() => {\n  const ARM_PX = 6, SCROLL_PX = 10, TAP_MS = 350, STILL_MS = 400;\n  let wrap = null, input = null, x0 = 0, y0 = 0, t0 = 0, pointerId = 0;\n  let armed = false, tap = false, lastScroll = 0;\n  document.addEventListener('scroll', () => { lastScroll = Date.now(); },\n    { capture: true, passive: true });\n\n  const release = () => {\n    if (wrap) {\n      wrap.classList.remove('fh-armed');\n      try { wrap.releasePointerCapture(pointerId); } catch (e) {}\n    }\n    wrap = null; input = null; armed = false; tap = false;\n  };\n\n  const setAt = (clientX, commit) => {\n    if (!wrap || !input) return;\n    const box = wrap.getBoundingClientRect();\n    if (!box.width) return;\n    const min = +input.min || 0, max = +input.max || 100, step = +input.step || 1;\n    const along = Math.min(1, Math.max(0, (clientX - box.left) / box.width));\n    const value = Math.min(max, Math.max(min,\n      Math.round((min + along * (max - min)) / step) * step));\n    if (value != +input.value) {\n      input.value = value;\n      input.dispatchEvent(new Event('input', { bubbles: true }));\n    }\n    if (commit) input.dispatchEvent(new Event('change', { bubbles: true }));\n  };\n\n  document.addEventListener('pointerdown', (e) => {\n    if (e.pointerType === 'mouse') return;\n    const slider = e.target && e.target.closest && e.target.closest('.fh-slider');\n    if (!slider) return;\n    release();\n    const range = slider.querySelector('input[type=range]');\n    if (!range) return;\n    wrap = slider; input = range;\n    x0 = e.clientX; y0 = e.clientY; t0 = e.timeStamp; pointerId = e.pointerId;\n    tap = Date.now() - lastScroll > STILL_MS;\n  }, true);\n\n  document.addEventListener('pointermove', (e) => {\n    if (!wrap) return;\n    const dx = e.clientX - x0, dy = e.clientY - y0;\n    if (!armed) {\n      if (Math.abs(dy) > SCROLL_PX && Math.abs(dy) > Math.abs(dx)) { release(); return; }\n      if (Math.abs(dx) < ARM_PX) return;\n      armed = true;\n      wrap.classList.add('fh-armed');\n      try { wrap.setPointerCapture(pointerId); } catch (e) {}\n      if (navigator.vibrate) navigator.vibrate(8);\n    }\n    setAt(e.clientX, false);\n  }, true);\n\n  const end = (e) => {\n    if (!wrap) return;\n    const isTap = tap && e.timeStamp - t0 <= TAP_MS\n      && Math.abs(e.clientX - x0) < ARM_PX && Math.abs(e.clientY - y0) < SCROLL_PX;\n    if (e.type === 'pointerup' && (armed || isTap)) setAt(e.clientX, true);\n    release();\n  };\n  document.addEventListener('pointerup', end, true);\n  document.addEventListener('pointercancel', end, true);\n})();",
