{{id}}__busy_change\" data-attr:disabled=\"$_{{id}}__busy_change\"\n      data-on:input=\"${{fill__signal}} = (100 - ((evt.target.value - {{min}}) * 100 / ({{max}} - {{min}}))) + '%'{{#dragPercent}}; ${{state__signal}} = Math.round(((evt.target.value - {{min}}) * 100 / ({{max}} - {{min}}))) + ' %'{{/dragPercent}}\"\n      data-on:change=\"$_{{id}}__busy_change ? '' : @post('sse/action/{{dashboardSlug}}/{{{action}}}/{{{entity_id}}}/{{key}}/' + $_{{id}}__slide, {filterSignals:{exclude:'.*'}})\" />{{/toggle}}\n    <span style=\"background:{{fillColor}}\" {{{fillColor__bind}}}></span>\n    {{#toggle}}<button type=\"button\" class=\"slider-toggle\" aria-label=\"{{label}}\"\n      {{{value__bind}}}\n      data-on:click=\"$_{{id}}__busy_change ? '' : {{{toggleClick}}}\"\n      data-indicator=\"_{{id}}__busy_change\" data-attr:disabled=\"$_{{id}}__busy_change\"></button>{{/toggle}}\n  </div>\n</div>"
