        "slots" : {
          "label" : "Features"
        }
      },
      {
        "card" : "entityCard",
        "children" : [
        ],
        "kind" : "component",
        "slots" : {
          "entity_id" : "sensor.outside_temp",
          "icon" : "mdi-thermometer",
          "label" : "Outside Temperature",
          "value" : {
            "bypassUnavailable" : true,
            "reactive" : true,
            "transform" : "$state & ($attr.unit_of_measurement ? \" \" & $attr.unit_of_measurement : \"\")"
          }
        }
      },
      {
        "card" : "entityCard",
        "children" : [
        ],
        "kind" : "component",
        "slots" : {
          "entity_id" : "light.kitchen",
          "icon" : "mdi-lightbulb",
          "label" : "Kitchen",
          "onclick" : {
            "bypassUnavailable" : false,
            "reactive" : false,
            "transform" : "\"@post('sse/action/\" & (($a := $lookup({\"scene\": \"scene/turn_on\", \"script\": \"script/turn_on\", \"button\": \"button/press\", \"input_button\": \"input_button/press\"}, $domain); $a ? $a : \"homeassistant/toggle\")) & \"/\" & $entity_id & \"', {filterSignals:{exclude:'.*'}})\""
          },
          "tappable" : "1",
          "value" : {
            "bypassUnavailable" : true,
            "reactive" : true,
            "transform" : "$state & ($attr.unit_of_measurement ? \" \" & $attr.unit_of_measurement : \"\")"
          }
        }
      },
      {
        "card" : "slider",
        "children" : [
        ],
        "kind" : "component",
        "slots" : {
          "action" : "light/turn_on",
          "entity_id" : "light.kitchen",
          "fill" : {
            "bypassUnavailable" : false,
            "default" : "100",
            "reactive" : true,
            "transform" : "($v := $attr.brightness; $v != null ? 100 - (($v - 1) * 100 / (255 - 1)) : 100)"
          },
          "fillColor" : {
            "bypassUnavailable" : false,
            "default" : "currentcolor",
            "reactive" : true,
            "transform" : "($rgb := $attr.rgb_color; $k := $attr.color_temp_kelvin; $count($rgb) = 3 ? \"rgb(\" & $string($rgb[0]) & \",\" & $string($rgb[1]) & \",\" & $string($rgb[2]) & \")\" : $k != null ? ($t := $k < 2000 ? 0 : ($k > 6500 ? 1 : ($k - 2000) / 4500); \"rgb(\" & $string($round(255 - 54 * $t)) & \",\" & $string($round(166 + 60 * $t)) & \",\" & $string($round(87 + 168 * $t)) & \")\") : null)"
          },
          "key" : "brightness",
          "label" : "Kitchen",
          "max" : "255",
          "min" : "1",
          "state" : {
            "bypassUnavailable" : true,
            "reactive" : true,
            "transform" : "$state"
          },
          "value" : {
            "bypassUnavailable" : false,
            "default" : "0",
            "reactive" : true,
            "transform" : "$attr.brightness"
          }
        }
      },
      {
        "candidates" : [
          "light.kitchen",
          "light.living_room"
        ],
        "kind" : "set",
        "members" : {
          "light.kitchen" : {
            "clauses" : [
              {
                "node" : {
                  "card" : "entityCard",
                  "children" : [
                  ],
                  "kind" : "component",
                  "slots" : {
                    "entity_id" : "light.kitchen",
                    "icon" : "mdi-lightbulb",
                    "label" : "Kitchen",
                    "value" : {
                      "bypassUnavailable" : true,
                      "reactive" : true,
                      "transform" : "$state & ($attr.unit_of_measurement ? \" \" & $attr.unit_of_measurement : \"\")"
                    }
                  }
                },
                "when" : {
                  "kind" : "cmp",
                  "op" : "eq",
                  "property" : "state",
                  "value" : "on"
                }
              }
            ]
          },
          "light.living_room" : {
            "clauses" : [
              {
                "node" : {
                  "card" : "entityCard",
                  "children" : [
                  ],
                  "kind" : "component",
                  "slots" : {
                    "entity_id" : "light.living_room",
                    "icon" : "mdi-lightbulb",
                    "label" : "Living Room",
                    "value" : {
                      "bypassUnavailable" : true,
                      "reactive" : true,
                      "transform" : "$state & ($attr.unit_of_measurement ? \" \" & $attr.unit_of_measurement : \"\")"
                    }
                  }
                },
                "when" : {
                  "kind" : "cmp",
                  "op" : "eq",
                  "property" : "state",
                  "value" : "on"
                }
              }
            ]
          }
        },
        "orderBy" : [
        ]
      },
      {
        "card" : "button",
        "children" : [
        ],
        "kind" : "component",
        "slots" : {
          "label" : "Detail…",
          "onclick" : "@post('sse/surface/open/detail'); $ui_popups = 'detail'"
        }
      },
      {
        "card" : "button",
        "children" : [
        ],
        "inlineSurfaces" : {
          "self" : {
            "content" : {
              "card" : "popup",
              "children" : [
                {
                  "card" : "fhcol",
                  "children" : [
                    {
                      "card" : "sectionTitle",
                      "children" : [
                      ],
                      "kind" : "component",
                      "slots" : {
                        "label" : "Inline"
                      }
                    },
                    {
                      "card" : "button",
                      "children" : [
                      ],
