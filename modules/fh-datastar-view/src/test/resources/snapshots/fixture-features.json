                      "slots" : {
                        "label" : "Close",
                        "onclick" : "@post('sse/popup/close'); $ui_popups = ''"
                      }
                    }
                  ],
                  "kind" : "component",
                  "slots" : {
                    
                  }
                }
              ],
              "kind" : "component",
              "slots" : {
                
              }
            }
          }
        },
        "kind" : "component",
        "slots" : {
          "label" : "Inline…",
          "onclick" : "@post('sse/surface/open/@@NODE_ID@@_self'); $ui_popups = '@@NODE_ID@@_self'"
        }
      }
    ],
    "kind" : "component",
    "slots" : {
      
    }
