  "cards" : {
    "button" : {
      "slots" : [
        "label"
      ],
      "template" : "{{#href}}<a class=\"button card\" href=\"{{{href}}}\">{{label}}</a>{{/href}}{{^href}}<button class=\"card\" data-on:click=\"{{{onclick}}}\">{{label}}</button>{{/href}}"
    },
    "entityCard" : {
      "slots" : [
        "label",
        "value",
        "entity_id"
      ],
      "template" : "<article class=\"card entity{{#tappable}} tappable{{/tappable}}\"{{#tappable}}\n  data-on:click=\"{{{onclick}}}\"{{/tappable}}>\n  <header>{{#icon}}<i class=\"mdi {{icon}}\"></i>{{/icon}}{{label}}</header>\n  <span class=\"state\">{{value}}</span>{{#secondary}}\n  <span class=\"secondary\">{{secondary}}</span>{{/secondary}}\n</article>"
    },
    "fhcol" : {
      "mount" : "<div class=\"fh-col{{#class}} {{class}}{{/class}}\">{{#children}}{{{html}}}{{/children}}</div>",
      "slots" : [
      ],
      "template" : "{{{self}}}{{{mount}}}"
    },
    "fhgrid" : {
      "mount" : "<div class=\"fh-grid{{#class}} {{class}}{{/class}}\">{{#children}}{{{html}}}{{/children}}</div>",
      "slots" : [
      ],
      "template" : "{{{self}}}{{{mount}}}"
    },
    "fhrow" : {
      "mount" : "<div class=\"fh-row{{#class}} {{class}}{{/class}}\">{{#children}}{{{html}}}{{/children}}</div>",
      "slots" : [
      ],
      "template" : "{{{self}}}{{{mount}}}"
    },
    "ifhost" : {
      "mount" : "<div class=\"fh-ifhost\" id=\"{{mountId}}\">{{{branch}}}</div>",
      "slots" : [
      ],
      "template" : "{{{self}}}{{{mount}}}"
    },
    "pill" : {
      "slots" : [
        "label"
      ],
      "template" : "{{#href}}<a class=\"chip\" href=\"{{{href}}}\">{{label}}</a>{{/href}}{{^href}}<button class=\"chip\" data-on:click=\"{{{onclick}}}\">{{label}}</button>{{/href}}"
    },
    "popup" : {
      "mount" : "<dialog open class=\"popup\"><button class=\"popup-close\" data-on:click=\"@post('sse/popup/close'); $ui_popups = ''\">✕</button>{{#children}}{{{html}}}{{/children}}</dialog>",
      "slots" : [
      ],
      "template" : "{{{self}}}{{{mount}}}"
    },
    "sectionTitle" : {
      "slots" : [
        "label"
      ],
      "template" : "<h2 class=\"section\">{{label}}</h2>"
    },
    "slider" : {
      "slots" : [
        "label",
        "state",
        "value",
        "action",
        "min",
        "max",
        "key",
        "entity_id"
      ],
      "template" : "<article class=\"card\">\n  <div class=\"slider-head\"><strong>{{label}}</strong><span class=\"state\">{{state}}</span></div>\n  <div class=\"slider max\" style=\"--_start: 0%;--_end: {{fill}}%\">\n    <input type=\"range\" min=\"{{min}}\" max=\"{{max}}\"\n      data-signals=\"{ _val_{{id}}: {{value}} }\"\n      data-bind=\"_val_{{id}}\"\n      data-on:change=\"@post('sse/action/{{{action}}}/{{{entity_id}}}/{{key}}/' + $_val_{{id}}, {filterSignals:{exclude:'.*'}})\" />\n    <span style=\"background:{{fillColor}}\"></span>\n  </div>\n</article>"
    },
    "sliderGroup" : {
      "mount" : "<div class=\"slider-group-members\">{{#children}}{{{html}}}{{/children}}</div>",
      "self" : "<div id=\"{{selfId}}\" class=\"slider-group-head\">\n  <div class=\"slider-head\"><strong>{{#icon}}<i class=\"mdi {{icon}}\"></i>{{/icon}}{{label}}</strong><span class=\"state\">{{state}}</span>{{#onclick}}<button class=\"circle small slider-group-action\" data-on:click=\"{{{onclick}}}\"><i class=\"mdi mdi-power\"></i></button>{{/onclick}}</div>\n  <div class=\"slider max slider-group-track\" style=\"--_start: 0%;--_end: {{fill}}%\">\n    <input type=\"range\" min=\"{{min}}\" max=\"{{max}}\"\n      data-signals=\"{ _val_{{id}}: {{value}} }\"\n      data-bind=\"_val_{{id}}\"\n      data-on:change=\"@post('sse/action/{{{action}}}/{{{entity_id}}}/{{key}}/' + $_val_{{id}}, {filterSignals:{exclude:'.*'}})\" />\n    <span style=\"background:{{fillColor}}\"></span>\n  </div>\n</div>",
      "slots" : [
        "label",
        "state",
        "value",
        "action",
        "min",
        "max",
        "key",
        "entity_id"
      ],
      "template" : "<article class=\"card slider-group\">{{{self}}}{{{mount}}}</article>"
    },
    "tab" : {
      "slots" : [
        "label",
        "onclick",
        "active"
      ],
      "template" : "<a data-on:click=\"{{{onclick}}}\" data-class=\"{active: {{{active}}}}\">{{label}}</a>",
      "wrapAsCell" : false
    },
    "tabs" : {
      "mount" : "<div id=\"{{mountId}}\" class=\"tab-panel\" data-effect=\"fhUrl('ui.{{id}}', $ui_{{id}})\">{{{panel}}}</div>",
      "self" : "<div id=\"{{selfId}}\" class=\"tabs\" data-signals__ifmissing=\"{ ui_{{id}}: {{bakeIndex}} }\">{{#children}}{{{html}}}{{/children}}</div>",
      "slots" : [
      ],
      "template" : "<div class=\"fh-col\">{{{self}}}{{{mount}}}</div>"
    },
    "toggle" : {
      "slots" : [
        "label"
      ],
      "template" : "<article class=\"card row\">\n  <span class=\"max\">{{label}}</span>\n  <label class=\"switch\">\n    <input type=\"checkbox\" {{{checked}}} data-on:click=\"{{{onclick}}}\" />\n    <span></span>\n  </label>\n</article>"
    }
  },
