/// SPIKE — the proposed `set` wire format for dynamics, worked through six
/// authoring scenarios. See `docs/plan-dynamics-one-entity-lifecycle.md`.
///
/// This is NOT the shipped library: `dynamics/wire.pkl` is a proposal, and the
/// real build will do the shape compression in Scala (`DashboardBuild`). It
/// lives here as tests so the format is pinned and readable — the
/// `.pkl-expected.pcf` sibling IS the worked example, and a format change shows
/// up as a diff rather than a discussion.
///
/// The property each scenario is really demonstrating: a registry-derived slot
/// varies per member and becomes a `var`; a state-derived slot is identical
/// across members and stays on the shared case. That is the D1 -> D2
/// compression, and it is why the wire grows in candidates but the client does
/// not.
amends "pkl:test"

import "dynamics/wire.pkl"
import "dynamics/query.pkl" as q
import "dynamics/fixtures.pkl"

local stueLights = fixtures.all.filter((e) -> e.area_id == "stue" && e.domain == "light")

// --- the branches each scenario composes ---------------------------------

local sliderBranch = new wire.Branch {
  key = (_e) -> true
  render = (e) -> new wire.Node {
    card = "slider"
    slots = Map(
      "label", new wire.Lit { literal = e.friendly_name },
      "state", new wire.Xf { transform = "$state" })
  }
}

local interpolatedBranch = new wire.Branch {
  key = (_e) -> true
  render = (e) -> new wire.Node {
    card = "entityCard"
    slots = Map(
      "label", new wire.Lit { literal = "Blah \(e.friendly_name)" },
      "state", new wire.Xf { transform = "$state" })
  }
}

local lightBranch = new wire.Branch {
  key = (e) -> e.domain == "light"
  render = (e) -> new wire.Node {
    card = "slider"
    slots = Map("label", new wire.Lit { literal = e.friendly_name })
  }
}

local mediaBranch = new wire.Branch {
  key = (e) -> e.domain == "media_player"
  render = (e) -> new wire.Node {
    card = "mediaCard"
    slots = Map("label", new wire.Lit { literal = e.friendly_name })
  }
}

local dimmableBranch = new wire.Branch {
  key = (e) -> e.supported_features > 4
  render = (e) -> new wire.Node {
    card = "slider"
    slots = Map("label", new wire.Lit { literal = e.friendly_name })
  }
}

local plainBranch = new wire.Branch {
  key = (_e) -> true
  render = (e) -> new wire.Node {
    card = "toggle"
    slots = Map("label", new wire.Lit { literal = e.friendly_name })
  }
}

/// The one branch whose key defers: dispatch depends on live state, so both
/// shapes stay possible for every member and the choice rides the wire.
local whenOnBranch = new wire.Branch {
  key = (e) -> e.stateIs("on")
  render = (e) -> new wire.Node {
    card = "slider"
    slots = Map("label", new wire.Lit { literal = e.friendly_name })
  }
}

local alwaysPresent = (_e) -> true

/// Resolve alternative `i` of `eid` through the set's condition table.
/// `null` means unconditional.
local condOf = (s, eid: String, i: Int) -> s.members[eid].clauses[i].`when`

// D1 helpers: there are no shared tables any more, so "how many distinct shapes
// / conditions" is a question you ask of the members.
local allClauses = (s) -> s.members.values.flatMap((m) -> m.clauses)
local cards = (s) -> allClauses.apply(s).map((c) -> c.node.card).distinct
local conds = (s) -> allClauses.apply(s).map((c) -> c.`when`).distinct
local firstNode = (s) -> s.members.values.first.clauses.first.node

facts {
  ["1. every member carries a complete node"] {
    local s = wire.buildSet(stueLights, List(sliderBranch), (e) -> e.stateIs("on"), List(), null)
    s.candidates.length == 3
    cards.apply(s).length == 1
    // each member's node is COMPLETE: the shared transform and its own literal,
    // both inline. Nothing to look up, nothing to merge.
    firstNode.apply(s).slots.containsKey("state")
    firstNode.apply(s).slots.containsKey("label")
    (s.members["light.taklys"].clauses.first.node.slots["label"] as wire.Lit).literal == "Taklys"
    (s.members["light.lampe"].clauses.first.node.slots["label"] as wire.Lit).literal == "Lampe"
  }

  ["2. an interpolated label is still a build-time literal, still a var"] {
    local s = wire.buildSet(stueLights, List(interpolatedBranch), alwaysPresent, List(), null)
    (s.members["light.taklys"].clauses.first.node.slots["label"] as wire.Lit).literal == "Blah Taklys"
    (s.members["light.spot"].clauses.first.node.slots["label"] as wire.Lit).literal == "Blah Spot"
    cards.apply(s).length == 1
    // nothing defers: the member's only alternative is unconditional
    condOf.apply(s, "light.taklys", 0) == null
  }

  // WHY THERE IS NO SET-LEVEL `present` FIELD. An `or` mixing a registry fact
  // with live state folds DIFFERENTLY per candidate: statically true for a
  // dimmable light, a live state test for a dumb one. One shared predicate
  // cannot express both, so presence is per-member — and once it is per-member
  // it is indistinguishable from "no alternative matched", so it collapses into
  // `alts` instead of sitting beside it.
  ["presence residuals diverge across members of one set"] {
    local presence = (e) -> wire.any(List(e.supported_features > 4, e.stateIs("on")))
    presence.apply(fixtures.taklys) == true
    presence.apply(fixtures.lampe) is wire.Bound
    presence.apply(fixtures.taklys) != presence.apply(fixtures.lampe)

    local s = wire.buildSet(stueLights, List(plainBranch), presence, List(), null)
    // the dimmable one is unconditionally present...
    condOf.apply(s, "light.taklys", 0) == null
    // ...the dumb one carries its residual on the alternative
    condOf.apply(s, "light.lampe", 0).property == "state"
    // and the two distinct residuals are stored ONCE, not per member
    conds.apply(s).length == 2
  }

  ["3. static domain dispatch resolves to a shape index, no runtime `when`"] {
    local s = wire.buildSet(fixtures.all, List(lightBranch, mediaBranch), alwaysPresent, List(), null)
    cards.apply(s).length == 2
    // every member has exactly one alternative, and it is unconditional
    s.members.values.every((m) -> m.clauses.length == 1)
    s.members.values.every((m) -> m.clauses.first.`when` == null)
    s.members["media_player.tv"].clauses.first.node.card !=
      s.members["light.taklys"].clauses.first.node.card
  }

  ["4. a capability branch is static too — supported_features is registry data"] {
    local s = wire.buildSet(stueLights, List(dimmableBranch, plainBranch), alwaysPresent, List(), null)
    // taklys/spot (features 8) take the slider; lampe (features 2) falls through
    s.members["light.taklys"].clauses.length == 1
    s.members["light.lampe"].clauses.length == 1
    s.members["light.taklys"].clauses.first.node.card !=
      s.members["light.lampe"].clauses.first.node.card
    s.members.values.every((m) -> m.clauses.first.`when` == null)
  }

  ["5. state-dependent dispatch keeps BOTH shapes, choice deferred to the wire"] {
    local s = wire.buildSet(stueLights, List(whenOnBranch, plainBranch), alwaysPresent, List(), null)
    // two alternatives per member: the conditional one, then the fallback
    s.members["light.taklys"].clauses.length == 2
    condOf.apply(s, "light.taklys", 0) != null
    condOf.apply(s, "light.taklys", 0).property == "state"
    // the unconditional fallback terminates the list
    condOf.apply(s, "light.taklys", 1) == null
    // all three members share the SAME condition object, stored once
    conds.apply(s).length == 2
  }

  ["6. `all` folds a mixed key three ways, per candidate"] {
    // both static terms pass -> only the runtime residue survives
    wire.all(List(true, true, fixtures.taklys.stateIs("on"))) is wire.Bound
    // a failing static term decides the candidate at build time
    wire.all(List(true, false, fixtures.taklys.stateIs("on"))) == false
    // nothing defers -> no predicate on the wire
    wire.all(List(true, true)) == true
    // several runtime terms conjoin
    (wire.all(List(true, fixtures.taklys.stateIs("on"),
                   fixtures.taklys.attrAbove("brightness", 40))) as wire.PAnd).items.length == 2
  }

  // ORDERING folds too, and — unlike presence — a diverging key is an ERROR
  // rather than a case to support. Two order keys are only useful if they are
  // mutually comparable; a brightness against a friendly_name is not.
  ["7a. a registry-derived order key sorts at build time and emits nothing"] {
    local s = wire.buildSet(
      fixtures.all.filter((e) -> e.domain == "light"),
      List(plainBranch), alwaysPresent, List(q.asc(q.prop("friendly_name"))), null)
    // sorted NOW; the runtime just filters and preserves this order
    s.candidates == List("light.kjokken", "light.lampe", "light.spot", "light.taklys")
    s.orderBy == null
  }

  ["7b. a live order key is shared set-level, candidates keep author order"] {
    local s = wire.buildSet(
      stueLights, List(plainBranch), alwaysPresent,
      List(q.desc(q.prop("brightness"))), null)
    ((s.orderBy.first as wire.LiveSort).by as wire.PropRef).property == "attr:brightness"
    (s.orderBy.first as wire.LiveSort).dir == "desc"
    s.orderBy.length == 1
    s.candidates == List("light.taklys", "light.lampe", "light.spot")
  }

  // MULTI-KEY ordering is ordinary lexicographic sorting, and each POSITION
  // folds on its own. "on first, then brightest, then by name": two live keys
  // and a static tail.
  ["7c. multi-key: on first, then brightness, then name"] {
    local s = wire.buildSet(
      stueLights, List(plainBranch), alwaysPresent,
      List(
        q.desc(q.eq(q.stateProp, "on")),
        q.desc(q.prop("brightness")),
        q.asc(q.prop("friendly_name"))), null)
    s.orderBy.length == 3
    (s.orderBy[0] as wire.LiveSort).by is wire.Bound
    ((s.orderBy[1] as wire.LiveSort).by as wire.PropRef).property == "attr:brightness"
    // the static tail cannot fold away — two live keys outrank it — so it
    // becomes a per-member sort value the runtime compares
    ((s.orderBy[2] as wire.LiveSort).by as wire.PropRef).property == "reg:friendly_name"
  }

  ["7d. a STATIC key may outrank a live one — by name, then brightness"] {
    local s = wire.buildSet(
      stueLights, List(plainBranch), alwaysPresent,
      List(q.asc(q.prop("friendly_name")),
           q.desc(q.prop("brightness"))), null)
    // the static key is FIRST, so it cannot be pre-sorted away either: the
    // runtime must apply it before the live key
    (s.orderBy[0] as wire.LiveSort).by is wire.PropRef
    s.orderBy[1] is wire.LiveSort
    ((s.orderBy[0] as wire.LiveSort).by as wire.PropRef).property == "reg:friendly_name"
  }

  ["7e. all keys static => sorted now, nothing emitted, no sortVars"] {
    local s = wire.buildSet(
      fixtures.all.filter((e) -> e.domain == "light"), List(plainBranch), alwaysPresent,
      List(q.asc(q.prop("area_id")),
           q.asc(q.prop("friendly_name"))), null)
    s.orderBy == null
    // kjokken area first, then the three stue lights alphabetically
    s.candidates == List("light.kjokken", "light.lampe", "light.spot", "light.taklys")
  }

  // COUNT-INDEPENDENCE. var-vs-shape is decided by TYPE, not by diffing the
  // members that happen to share a shape. A literal is always a var, a transform
  // is always on the shape — so the emitted structure is a function of the
  // authoring alone, and adding a second entity of some kind never restructures
  // the output.
  ["structure is a function of the authoring, never of member count"] {
    local s = wire.buildSet(fixtures.all, List(lightBranch, mediaBranch), alwaysPresent, List(), null)

    // mediaCard has ONE member, slider has four — and both put the literal in
    // vars, because both were authored the same way
    (s.members["media_player.tv"].clauses.first.node.slots["label"] as wire.Lit).literal == "TV"
    (s.members["light.taklys"].clauses.first.node.slots["label"] as wire.Lit).literal == "Taklys"
  }

  ["a transform is inline on every member's node"] {
    local s = wire.buildSet(stueLights, List(sliderBranch), alwaysPresent, List(), null)
    // `state` is an Xf: the entity it reads comes from the member binding, so
    // every member carries the same transform text. Repeating it is the price of
    // dropping the shapes table — measured at ~2.5x on a server-side artifact.
    s.members.values.every((m) -> m.clauses.first.node.slots.containsKey("state"))
    s.members.values.every((m) ->
      (m.clauses.first.node.slots["state"] as wire.Xf).transform == "$state")
  }

  ["a statically-false candidate never reaches the wire"] {
    local s = wire.buildSet(fixtures.all, List(lightBranch), alwaysPresent, List(), null)
    // media_player.tv matches no branch -> dropped entirely
    !s.candidates.contains("media_player.tv")
    s.candidates.length == 4
  }
}

/// Rendered as JSON text, not as the objects themselves: an `examples` block
/// writes typed instances to `.pcf` as untyped `new { ... }`, which then fails
/// to re-read ("Please specify a parent explicitly"), so the expected file
/// could never assert on a second run. A String round-trips, and JSON is the
/// form worth reading here anyway — it IS the wire.
local function asJson(v: Any): String = new JsonRenderer { indent = "  " }.renderValue(v)

examples {
  ["uniform set, present-when-on, ordered by brightness"] {
    asJson(wire.buildSet(
      stueLights,
      List(sliderBranch),
      (e) -> e.stateIs("on"),
      List(q.desc(q.prop("brightness"))), null))
  }

  ["static domain dispatch across the whole house"] {
    asJson(wire.buildSet(fixtures.all, List(lightBranch, mediaBranch), alwaysPresent, List(), null))
  }

  ["state-dependent dispatch: the alternatives list"] {
    asJson(wire.buildSet(stueLights, List(whenOnBranch, plainBranch), alwaysPresent, List(), null))
  }
}
