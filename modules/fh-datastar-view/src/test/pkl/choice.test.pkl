/// Choices in a nodes slot (`nodeMod.iff`, `nodeMod.match`, `c.iff(…).elif`):
/// what each writes, the `Chosen` fill the runtime decides by a pick.
///
/// Outside `lib/` deliberately — see `components.test.pkl`.
amends "pkl:test"

import "../../main/resources/dashboards/lib/components.pkl" as c
import "../../main/resources/dashboards/lib/hass.pkl" as hass
import "../../main/resources/dashboards/lib/query.pkl" as q
import "../../main/resources/dashboards/lib/core/node.pkl" as nodeMod
import "../../main/resources/dashboards/lib/core/choice.pkl" as choiceMod
import "../../main/resources/dashboards/lib/core/group.pkl" as groupMod
import "../../main/resources/dashboards/lib/core/predicate.pkl" as predMod
import "../../main/resources/dashboards/lib/core/slot.pkl" as slotMod
import "../../main/resources/dashboards/lib/layout.pkl" as layout

local lamp: hass.LightEntity = new {
  entity_id = "light.lamp"
  colourModes { "brightness" }
}
local fan: hass.LightEntity = new {
  entity_id = "light.fan"
  colourModes { "brightness" }
}
local mode = c.variable("mode")
local other = c.variable("other")

const local branch = slotMod.nodes("branch")

local class Host extends nodeMod.Node {
  card = "host"
  cardDef = new nodeMod.CardDef { template = "\(branch)" }
  hidden choice: Any
  slots { branch.of(choice) }
}

/// What the node's choice writes: its own, or its inner group's, a choice being
/// its card's whole template.
local function chosen(n: nodeMod.Node): choiceMod.ChosenNodes =
  let (own = n.nodesSlots.findOrNull((s) -> s.choice != null))
    if (own != null) (own.fill as slotMod.NodesFill).choice as choiceMod.ChosenNodes
    else chosen(n.nodesSlots.flatMap((s) -> s.nodes.toList()).find((k) -> k is groupMod.Group) as nodeMod.Node)

local function keys(w: choiceMod.ChosenNodes): List<Any> = w.cases.toList().map((k) -> k.`is`)

local function isOn(e: hass.LightEntity) = q.entity(e).stateIs("on")

facts {
  ["an elif chain is a first-true position over its conditions, a case each, the else the otherwise"] {
    local h = new Host {
      choice = nodeMod.iff(isOn(lamp)).then(c.title("a")).elif(isOn(fan)).then(c.title("b")).`else`(c.title("x"))
    }
    local w = chosen(h)
    w.by is predMod.FirstTrue
    (w.by as predMod.FirstTrue).items.length == 2
    keys(w) == List(0, 1)
    w.otherwise!!.length == 1
    // Its card places the host and declares the slot.
    h.nodesDeclared == Set("branch")
    // A choice is a fill, not a surface.
    h.inlineSurfaces == null
  }
  ["a lone condition is the key itself, and no else is no otherwise"] {
    local w = chosen(new Host { choice = nodeMod.iff(isOn(lamp)).then(c.title("a")) })
    !(w.by is predMod.FirstTrue)
    keys(w) == List(true)
    w.otherwise == null
  }
  ["a then after an elif fills that elif, not the first branch"] {
    local i = nodeMod.iff(isOn(lamp)).then(c.title("a")).elif(isOn(fan)).then(c.title("b"))
    i.`then`.length == 1
    i.elifs.length == 1
    i.elifs[0].nodes.length == 1
  }
  ["c.iff takes elif the same way, and keeps then and else as properties"] {
    local i = c.iff(isOn(lamp)).then(c.title("a")).elif(isOn(fan)).then(c.title("b")).`else`(c.title("x"))
    i.`then`.length == 1 && i.`else`.length == 1 && i.elifs.length == 1
    // Each branch is a row of its nodes, as an If's always was.
    let (w = chosen(i))
      w.cases.length == 2 && w.cases[1].value[0] is layout.Row && w.otherwise!![0] is layout.Row
  }
  ["an elif chain over one variable is a match on its value, the else at any other"] {
    local w = chosen(new Host {
      choice = nodeMod.iff(mode.valueIs("a")).then(c.title("a")).elif(mode.valueIs("b")).then(c.title("b"))
    })
    (w.by.source as slotMod.VarRead).name == "mode" && w.by.steps.isEmpty
    keys(w) == List("a", "b")
    // A variable shows something at every value, so the else is there empty.
    (w.otherwise!![0] as layout.Row).children.isEmpty
  }
  ["a chain reading a variable and live state is an error naming R4d"] {
    module.catch(() -> chosen(new Host {
      choice = nodeMod.iff(mode.valueIs("a")).then(c.title("a")).elif(isOn(fan)).then(c.title("b"))
    })).contains("R4d")
    module.catch(() -> chosen(new Host {
      choice = nodeMod.iff(mode.valueIs("a")).then(c.title("a")).elif(other.valueIs("b")).then(c.title("b"))
    })).contains("R4d")
  }
  ["a match over a variable has a case per key, in order, and the otherwise at any other"] {
    local w = chosen(new Host {
      choice = nodeMod.match(mode.value, new Mapping { ["heat"] = c.title("h"); ["cool"] = c.title("k") }).otherwise(c.title("off"))
    })
    keys(w) == List("heat", "cool")
    (w.by.source as slotMod.VarRead).name == "mode"
    w.otherwise != null
    // One node is its own case.
    !(w.cases[0].value[0] is layout.Row)
  }
  ["a match without an otherwise has none, and several nodes in a case sit in a row"] {
    local w = chosen(new Host {
      choice = nodeMod.match(mode.value, new Mapping { ["a"] = new Listing { c.title("x"); c.title("y") } })
    })
    w.otherwise == null
    w.cases.length == 1
    w.cases[0].value.length == 1
    w.cases[0].value[0] is layout.Row
  }
  ["a match over entity state is an error naming R4"] {
    module.catch(() -> nodeMod.match(c.isOn(lamp), new Mapping { ["on"] = c.title("x") })).contains("R4 of")
  }
  ["a tab bar is a match over its variable, filling a group the bar places beside its buttons"] {
    local t = (c.tabs) { tabs { ["A"] { c.title("a") }; ["B"] { c.title("b") } } }
    local w = chosen(t)
    keys(w) == List("0", "1")
    (w.by.source as slotMod.VarRead).name == "tab"
    t.nodesDeclared == Set("panel", "children")
    let (g = t.regions["panel"][0] as groupMod.Group)
      g.cardDef.template == "{{{children}}}" && !g.cardDef.layoutCell && g.classes == "fh-tab-panel"
  }

  ["a choice beside other content is refused: the card's root is its host"] {
    module.catch(() -> new Host {
      cardDef = new nodeMod.CardDef { template = "<p>x</p>\(branch)" }
      choice = nodeMod.iff(isOn(lamp)).then(c.title("a"))
    }.wireSlots).contains("a choice must be its card's whole template")
  }
}
