/// A call over a query set (#583): the route a tap places, carrying the tally
/// the press filters.
///
/// Outside `lib/` deliberately — see `components.test.pkl`.
amends "pkl:test"

import "pkl:json"

import "../../main/resources/dashboards/lib/components.pkl" as c
import "../../main/resources/dashboards/lib/query.pkl" as q
import "../../main/resources/dashboards/lib/hass.pkl" as hass
import "../../main/resources/dashboards/lib/core/predicate.pkl" as pred
import "../../main/resources/dashboards/lib/core/node.pkl" as nodeMod
import "../../main/resources/dashboards/lib/core/slot.pkl" as slotMod
import "../../main/resources/dashboards/lib/components/base/tile.pkl" as tileMod
import "../../main/resources/dashboards/lib/components/base/onoff.pkl" as switchMod

local taklys: hass.LightEntity = new { entity_id = "light.taklys"; colourModes { "brightness" } }
local lampe: hass.LightEntity = new { entity_id = "light.lampe"; colourModes { "brightness" } }
local bryter: hass.SwitchEntity = new { entity_id = "switch.bryter" }
local sun: hass.GenericEntity = new { entity_id = "sun.sun"; domain = "sun" }

local lit = q.from(List(taklys, lampe)).where(q.eq(q.stateProp, "on"))
// The lamp stays on while the sun is down.
local litByDay = lit.where((e) ->
  if (e == lampe) q.not(q.entity(sun).stateIs("below_horizon")) else true)

// The tally a set call targets, as the wire writes it.
local function setOf(n: nodeMod.Node): Mapping =
  new json.Parser { useMapping = true }.parse(
    new JsonRenderer {}.renderValue((n.declared["tap"].target["entity_id"].toList().single as slotMod.Expr).source)
  ) as Mapping

facts {
  ["a set call targets the set it filters"] {
    let (b = c.button("Av", c.tap.call("light/turn_off", lit)))
      b.declared["tap"].target.keys == Set("entity_id")
      && (setOf(b)["candidates"] as Listing).toList() == List("light.taklys", "light.lampe")
  }
  ["a guard naming another entity rides in the tally"] {
    let (g = (setOf(c.button("Av", c.tap.call("light/turn_off", litByDay)))["when"] as Mapping)["light.lampe"] as Mapping)
      ((g["steps"] as Listing).toList().single as Mapping)["kind"] == "AllOf"
      && ((g["source"] as Mapping)["items"] as Listing).toList().any((p) ->
        ((p as Mapping)["steps"] as Listing).toList().map((s) -> (s as Mapping)["kind"]) == List("Compare", "Not")
        && ((p as Mapping)["source"] as Mapping)["of"] == "sun.sun")
  }
  ["equal sets declare equal calls, different ones do not"] {
    let (declOf = (s: q.EntitySet) -> c.button("Av", c.tap.call("light/turn_off", s)).declared["tap"])
      declOf.apply(lit) == declOf.apply(q.from(List(taklys, lampe)).where(q.eq(q.stateProp, "on")))
      && declOf.apply(lit) != declOf.apply(litByDay)
  }
  ["every card that places a tap carries its set"] {
    let (t = c.tap.lights.off(lit))
      List(
        c.button("Av", t),
        c.pill(t),
        new tileMod.Tile { title = "Av"; tapAction = t },
        new switchMod.Switch { label = "Av"; tapAction = t; on = new { entityId = "light.lampe" } }
      ).every((n) -> setOf(n) == setOf(c.button("Av", t)))
  }
  ["an entity call carries no set"] {
    c.button("Av", c.tap.lights.off(taklys)).declared["tap"].target["entity_id"].toList() == List("light.taklys")
  }
  ["a call with no exclusion declares none"] {
    c.button("Av", c.tap.lights.off(taklys)).declared["tap"].exclude.isEmpty
  }
  ["a fixed exclusion is in the target's shape, under its key"] {
    let (d = c.button("Av", c.tap.lights.off(lit).exclude(lampe)).declared["tap"])
      d.target.keys == Set("entity_id")
      && d.exclude.keys == Set("entity_id")
      && d.exclude["entity_id"].toList() == List("light.lampe")
  }
  ["an excluded set is its tally"] {
    let (d = c.button("Av", c.tap.lights.off(lampe).exclude(litByDay)).declared["tap"])
      d.exclude["entity_id"].toList().single is slotMod.Expr
      && (d.exclude["entity_id"].toList().single as slotMod.Expr).source is pred.Tally
  }
  ["exclusions are kept in the order given, a key's ids together"] {
    let (d = c.button("Av", c.tap.lights.off(lampe).exclude(taklys).exclude(lampe)).declared["tap"])
      d.exclude.keys == Set("entity_id")
      && d.exclude["entity_id"].toList() == List("light.taklys", "light.lampe")
  }
  ["a set of another domain is a build error, naming the strays"] {
    module.catch(() -> c.tap.call("light/turn_off", q.from(List(taklys, bryter))))
      .contains("switch.bryter is not light")
  }
  ["homeassistant/* takes any domain"] {
    c.tap.call("homeassistant/turn_off", q.from(List(taklys, bryter))).target is pred.Tally
  }
  ["a set the build emptied is a build error"] {
    module.catch(() -> c.tap.call("light/turn_off", q.from(List(taklys)).where(false)))
      .contains("no candidates")
  }
  ["an excluded set of areas is its tally, under area_id"] {
    let (d = c.button("Av", c.tap.lights.off(etasje).exclude(soveromWhileNight)).declared["tap"])
      d.exclude.keys == Set("area_id")
      && ((d.exclude["area_id"].toList().single as slotMod.Expr).source as pred.Tally).of == "area"
      && ((d.exclude["area_id"].toList().single as slotMod.Expr).source as pred.Tally).candidates.toList()
        == List("soverom")
  }
  ["a set of floors targets floor_id, whatever the service's domain"] {
    let (d = c.button("Av", c.tap.call("light/turn_off", q.from(List(etasje)).where(night))).declared["tap"])
      d.target.keys == Set("floor_id")
  }
  ["an entity set carries no kind"] {
    let (d = c.button("Av", c.tap.lights.off(lampe).exclude(litByDay)).declared["tap"])
      ((d.exclude["entity_id"].toList().single as slotMod.Expr).source as pred.Tally).of == null
  }
  ["a set mixing kinds is a build error"] {
    module.catch(() -> q.from(List(soverom, etasje))).contains("mixes area, floor")
  }
}

local class Room extends hass.Area
local class Level extends hass.Floor
local soverom: Room = new { area_id = "soverom"; area_name = "Soverom" }
local etasje: Level = new { floor_id = "loft"; floor_name = "Loft" }
local night = (a) -> q.entity(sun).stateIs("below_horizon")
local soveromWhileNight = q.from(List(soverom)).where(night)
