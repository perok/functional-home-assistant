/// Rows and columns: how their children sit. Outside `lib/` for the reason
/// `components.test.pkl` gives.
amends "pkl:test"

import "../../main/resources/dashboards/lib/components.pkl" as c
import "../../main/resources/dashboards/lib/core/css.pkl" as cssMod
import "../../main/resources/dashboards/lib/core/node.pkl" as nodes

// `selector { body }`, innermost, so a rule inside `@media` is its own.
local function rules(css: String): List<Pair<String, String>> =
  Regex(#"([^{}]+)\{([^{}]*)\}"#).findMatchesIn(css)
    .map((m) -> Pair(m.groups[1]!!.value.trim(), m.groups[2]!!.value))

// What a cell reads from its container, taken from the cell rule itself.
local cellProps: Set<String> =
  let (cellRule = rules(cssMod.layoutCss).find((r) -> r.first == ":where(.fh-cell)").second)
    Regex(#"var\((--fh-cell-[a-z-]+)"#).findMatchesIn(cellRule).map((m) -> m.groups[1]!!.value).toSet()

// Every card's CSS in the library index, so a new card is in.
local cardCss: List<String> = c.cards.toMap().values.map((d) -> d.css)

local function declared(body: String): Set<String> =
  body.split(";").map((d) -> d.trim()).filter((d) -> d.startsWith("--fh-cell-"))
    .map((d) -> d.takeWhile((ch) -> ch != ":")).toSet()

local function classes(n: nodes.LayoutNode): List<String> = n.cell?.classes?.toList() ?? List()

facts {
  ["a row is start-packed and one line until told otherwise"] {
    !c.row.slots.containsKey("class")
    c.row.justify("center").slots["class"] == "fh-justify-center"
    c.row.wrap().slots["class"] == "fh-wrap"
    c.row.cssClass("mine").justify("end").wrap().slots["class"] == "mine fh-justify-end fh-wrap"
  }

  ["a column justifies along its own direction"] {
    !c.column.slots.containsKey("class")
    c.column.justify("center").slots["class"] == "fh-justify-center"
  }

  ["each class the builders emit has a rule"] {
    for (cls in List("fh-justify-center", "fh-justify-end", "fh-wrap", "fh-grow", "fh-stick-top", "fh-stick-bottom", "fh-fill-screen")) {
      cssMod.layoutCss.contains(".\(cls){") || cssMod.layoutCss.contains(".\(cls).") || cssMod.layoutCss.contains(".fh-row.\(cls){")
    }
  }

  ["one child grows, or hugs; the author's last word wins, over a card's default too"] {
    classes(c.title("x").grow()) == List("fh-grow")
    classes(c.title("x").hug().grow()) == List("fh-grow")
    classes(c.title("x").grow().hug()) == List("fh-hug")
    classes(c.title("x").columns(3).grow()) == List("fh-cols-3", "fh-grow")
    classes(c.spacer) == List("fh-grow")
    classes(c.spacer.hug()) == List("fh-hug")
  }

  ["a child sticks at one edge"] {
    classes(c.title("x").stick("top")) == List("fh-stick-top")
    classes(c.title("x").stick("top").stick("bottom")) == List("fh-stick-bottom")
  }

  ["a column fills the screen when told"] {
    c.column.fillScreen().slots["class"] == "fh-fill-screen"
    c.column.justify("end").fillScreen().slots["class"] == "fh-justify-end fh-fill-screen"
  }

  // A container passes its cells' layout down by inheritance, so one that sets
  // only part of it hands its PARENT's value for the rest to its own cells: a
  // column in a row would split a filled screen evenly. A refinement
  // (`.fh-row.fh-wrap`) changes one on a box that sets them all.
  ["every rule that sets a cell's layout sets all of it"] {
    cellProps == Set("--fh-cell-flex", "--fh-cell-align-self", "--fh-cell-width")
    cardCss.filter((css) -> css.contains("--fh-cell-")).length >= 2
    (List(cssMod.layoutCss) + cardCss).flatMap((css) -> rules(css))
      .filter((r) -> !r.first.matches(Regex(#"\.[\w-]+(\.[\w-]+)+"#)) && !declared(r.second).isEmpty)
      .filter((r) -> declared(r.second) != cellProps)
      .map((r) -> r.first)
      == List()
  }
}
