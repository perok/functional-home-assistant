examples {
  ["S1 every light in a room, shown while it is on"] {
    """
    {
      "kind": "set",
      "candidates": [
        "light.taklys",
        "light.lampe",
        "light.spot"
      ],
      "members": {
        "light.taklys": {
          "clauses": [
            {
              "when": {
                "kind": "cmp",
                "property": "state",
                "op": "eq",
                "value": "on"
              },
              "node": {
                "card": "slider",
                "slots": {
                  "label": {
                    "literal": "Taklys"
                  },
                  "state": {
                    "transform": "$state",
                    "reactive": true
                  }
                },
                "children": []
              }
            }
          ]
        },
        "light.lampe": {
          "clauses": [
            {
              "when": {
                "kind": "cmp",
                "property": "state",
                "op": "eq",
                "value": "on"
              },
              "node": {
                "card": "slider",
                "slots": {
                  "label": {
                    "literal": "Lampe"
                  },
                  "state": {
                    "transform": "$state",
                    "reactive": true
                  }
                },
                "children": []
              }
            }
          ]
        },
        "light.spot": {
          "clauses": [
            {
              "when": {
                "kind": "cmp",
                "property": "state",
                "op": "eq",
                "value": "on"
              },
              "node": {
                "card": "slider",
                "slots": {
                  "label": {
                    "literal": "Spot"
                  },
                  "state": {
                    "transform": "$state",
