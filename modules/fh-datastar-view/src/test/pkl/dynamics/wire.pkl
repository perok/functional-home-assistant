/// SPIKE: the proposed `set` wire shape and the build-time fold that produces it.
module wire

// ---- runtime predicate terms (always carry a binding) ----

abstract class Term { kind: String }

class Bound extends Term {
  kind: "cmp" = "cmp"
  property: String
  op: String
  value: Any
}

class PAnd extends Term {
  kind: "and" = "and"
  items: List<Term>
}

/// Fold a mixed list of build-time Booleans and runtime Terms.
/// `false` => this candidate is decided statically and drops out entirely.
/// `true`  => nothing defers; no predicate reaches the wire.
/// Both folds CANONICALISE: same-kind nesting is flattened and structurally
/// equal terms are deduped. That is not cosmetic — the `conditions` table dedupes
/// by structure, so two authored expressions meaning the same thing must reduce
/// to the same term or they take two table entries and the runtime evaluates the
/// same predicate twice. One level of flattening suffices: every group is built
/// through these, so nested ones are already flat.
local function flatten(kind: String, ts: List<Term>): List<Term> =
  ts.flatMap((t) ->
    if (kind == "and" && t is PAnd) t.items
    else if (kind == "or" && t is POr) t.items
    else List(t)).distinct

function all(items: List<Boolean|Term>): Boolean|Term =
  if (items.any((i) -> i is Boolean && i == false)) false
  else
    let (rest = flatten("and", items.filter((i) -> i is Term) as List<Term>))
      if (rest.isEmpty) true
      else if (rest.length == 1) rest.first
      else new PAnd { items = rest }

/// The `or` counterpart. A statically-true term short-circuits the whole
/// disjunction, which is what makes presence residuals DIVERGE across the
/// members of one set — see [[SetNode]].
function any(items: List<Boolean|Term>): Boolean|Term =
  if (items.any((i) -> i is Boolean && i == true)) true
  else
    let (rest = flatten("or", items.filter((i) -> i is Term) as List<Term>))
      if (rest.isEmpty) false
      else if (rest.length == 1) rest.first
      else new POr { items = rest }

class POr extends Term {
  kind: "or" = "or"
  items: List<Term>
}

class PNot extends Term {
  kind: "not" = "not"
  item: Term
}

// ---- slots: registry-derived folds to a literal, state-derived stays a transform ----

abstract class Slot
class Lit extends Slot { literal: String }
class Xf extends Slot { transform: String; reactive: Boolean = true }

/// What a render lambda produces for one concrete candidate.
class Node { card: String; slots: Map<String, Slot> }

// ---- the emitted wire node ----

/// One deduped rendering: a card plus the slots that are identical across every
/// member using it. NOT a "case" — the old `DynamicCase` bundled a predicate
/// WITH a rendering, and this format splits those apart; the guard lives in
/// [[SetNode.conditions]] and a [[Clause]] joins the two.
class ShapeDef { card: String; slots: Map<String, Slot> }

/// One guarded rendering rule for a member: "if `cond` holds, render `shape`".
/// Both fields are INDICES into the set's dedup tables
/// ([[SetNode.conditions]] / [[SetNode.shapes]]) — storing either inline would
/// repeat it once per member per rule.
class Clause { cond: Int; shape: Int }

/// A member is a `cond` expression: its clauses are tried in order and the first
/// whose guard holds decides the rendering. Falling off the end means the member
/// is NOT RENDERED — which is why there is no separate presence field.
class MemberDef { vars: Map<String, String>; clauses: List<Clause> }

class SetNode {
  kind: "set" = "set"
  /// In render order. When the ordering key folded to registry facts this list
  /// is already sorted and [[orderBy]] is null: the runtime filters to the
  /// present members and preserves this order, O(P) with no comparisons.
  candidates: List<String>
  /// Lexicographic, most significant first. Null when the whole ordering folded
  /// away and `candidates` is already in render order.
  orderBy: List<OrderTerm>?
  /// Distinct runtime guards, referenced by [[Clause.cond]]. Index 0 is always
  /// `null` = unconditional, so a fully static set carries one entry that every
  /// clause points at.
  conditions: List<Term?>
  shapes: List<ShapeDef>
  members: Map<String, MemberDef>
}

// ---- the build ----

/// One authored dispatch branch: a key applied per candidate, and the card to
/// render when it wins. The key returns `Boolean` (folds at build time) or a
/// `Term` (defers to the wire) — mixed via [[all]].
class Branch {
  key: (Any) -> Boolean|Term
  render: (Any) -> Node
}

/// Which branches survive for one candidate, in author order, with their
/// residual runtime condition. A branch whose key folded to `false` is gone; a
/// branch that folded to `true` is unconditional and ends the list (nothing
/// after it can ever win).
local function liveBranches(e: Any, branches: List<Branch>): List<Pair<Branch, Term?>> =
  let (evaluated = branches
        .map((b) -> Pair(b, b.key.apply(e)))
        .filter((p) -> !(p.second is Boolean && p.second == false)))
    let (firstUnconditional = evaluated.findIndexOrNull((p) -> p.second == true))
      (if (firstUnconditional == null) evaluated else evaluated.take(firstUnconditional + 1))
        .map((p) -> Pair(p.first, if (p.second is Term) p.second as Term else null))

/// Slot keys whose LITERAL value differs across the members sharing a shape.
/// Those become per-member `vars`; everything identical stays on the case.
/// This is the D1 -> D2 compression: emit one case, not one node per member.
local function varyingKeys(nodes: List<Node>): List<String> =
  if (nodes.length <= 1) List()
  else
    nodes.first.slots.keys.toList().filter((k) ->
      nodes.any((n) -> n.slots[k] != nodes.first.slots[k]))

local function shapeOf(n: Node, varying: List<String>): ShapeDef =
  new ShapeDef {
    card = n.card
    slots = n.slots.filter((k, _v) -> !varying.contains(k))
  }

/// A PROPERTY REFERENCE the runtime resolves per member. The prefix says where
/// from: bare `state`, `attr:<name>` from live attributes, `reg:<name>` from the
/// backend's registry table. A `reg:` reference is why a registry-derived key
/// needs no per-member value on the wire — but it requires naming the FACT, not
/// reading it, since the build cannot introspect `(e) -> e.friendly_name`.
class PropRef { kind: "prop" = "prop"; property: String }

/// A named property, NOT namespaced by the author. The build resolves where it
/// comes from: a registry fact when every candidate carries it as a property
/// (so the build can read it with `getProperty`), a live attribute otherwise.
/// `friendly_name` is both, and an author should not have to know which.
open class PropName {
  name: String
  /// Allow the property to be missing on SOME candidates. Without this, mixed
  /// availability is a build error: it means the property resolves to a
  /// registry fact for some members and a live attribute for others, which are
  /// not the same thing. With it, a missing value is null.
  optional: Boolean = false
}

/// Force the LIVE reading of a name that is also a registry fact.
class LiveAttr extends PropName {}

/// A term computed FROM the candidate by an author lambda, resolved at build
/// time. A first-class term rather than a bare lambda, so it composes: it can
/// sit inside `any`/`all`/`not` where a lambda could not, because a lambda has
/// no candidate in scope outside `where`.
class CandidateTerm { fn: (Any) -> Any }

/// An UNRESOLVED boolean group. `all`/`any`/`not` fold immediately when every
/// operand is already resolved; when one is still a [[Pending]] or a
/// [[CandidateTerm]] they produce this instead, and the fold happens per
/// candidate. Same operators either way — the author cannot tell.
class Group { gop: String; items: List<Any> }

/// An UNRESOLVED comparison — the key is still a [[PropName]]. Resolving it
/// against the candidates either folds it to a `Boolean` (a registry fact the
/// build can read) or produces a live [[Bound]].
class Pending { key: PropName; op: String; value: Any }

/// Where a named property actually comes from, for these candidates.
///
/// ALL candidates have it  => a registry fact, readable by the build.
/// NONE have it            => a live attribute. Cannot be validated further:
///                            volatile attributes like `brightness` are
///                            deliberately absent from the dump, so the build
///                            has no list of legal names to check against.
/// SOME have it            => AMBIGUOUS, and a build error unless `optional`.
///                            It would otherwise silently resolve to a live
///                            attribute and quietly stop being the registry
///                            fact the author meant.
function resolveProp(items: List<Any>, p: PropName): PropRef =
  if (p.name == "state") new PropRef { property = "state" }
  else if (p is LiveAttr) new PropRef { property = "attr:" + p.name }
  else
    let (have = items.filter((e) -> e.hasProperty(p.name)).length)
      if (items.isEmpty || have == 0) new PropRef { property = "attr:" + p.name }
      else if (have == items.length) new PropRef { property = "reg:" + p.name }
      else if (p.optional) new PropRef { property = "reg:" + p.name }
      else throw("""
        Property '\(p.name)' is present on \(have) of \(items.length) candidates.
        That is ambiguous: it would be a registry fact for some members and a
        live attribute for others. Either narrow the candidates so every one
        carries it, or wrap it in `q.optional(...)` to accept a null where it is
        missing.
        """)

/// True when the build can read this property itself.
function isBuildReadable(items: List<Any>, p: PropName): Boolean =
  resolveProp(items, p).property.startsWith("reg:")

local function applyOp(op: String, l: Any, r: Any): Boolean =
  if (op == "eq") l == r
  else if (op == "ne") l != r
  else if (op == "gt") l > r
  else if (op == "lt") l < r
  else throw("unknown op \(op)")

/// Resolve one pending comparison for ONE candidate: folded to a Boolean when
/// the build can read the property, otherwise a live term. This is the same
/// static/live split as everywhere else, now reached through one vocabulary.
function resolvePending(items: List<Any>, e: Any, pd: Pending): Boolean|Term =
  if (isBuildReadable(items, pd.key))
    applyOp(pd.op, e.getPropertyOrNull(pd.key.name), pd.value)
  else new Bound { property = resolveProp(items, pd.key).property; op = pd.op; value = pd.value }

/// One ordering position on the wire: a property reference or a [[Term]] whose
/// truth is the key, plus a direction. There is no "static" variant — a
/// registry position stays a `reg:` reference and the backend resolves it, so
/// nothing rides per member.
class LiveSort { by: PropRef|Term; dir: String = "asc" }

typealias OrderTerm = LiveSort

/// An authored ordering position. NOT a lambda: an ordering key never depends
/// on the individual candidate — `attr:brightness` and `reg:area_id` are the
/// same reference for every member — so `orderBy` is a declarative list, unlike
/// `where`, which genuinely is a per-candidate predicate. To order by something
/// COMPUTED, sort the input list with ordinary Pkl before `from`.
class OrderSpec { by: PropName|Pending; dir: String = "asc" }

class Ordering {
  entities: List<Any>
  /// Null when the whole ordering was resolved at build time.
  terms: List<OrderTerm>?
}

/// Fold the ordering. No error case — every position is a reference, so nothing
/// can diverge across candidates.
///
///   - every position is build-readable => sort the candidates NOW (stable sort
///     from the least significant key outwards) and emit nothing.
///   - any position needs live state => emit the whole list; build-readable
///     positions stay `reg:` references the backend resolves, costing nothing
///     per member even when they outrank a live key.
function foldOrder(items: List<Any>, specs: List<OrderSpec>): Ordering =
  let (readable = specs.map((s) ->
        if (s.by is Pending) isBuildReadable(items, (s.by as Pending).key)
        else isBuildReadable(items, s.by as PropName)))
    if (specs.isEmpty || items.isEmpty)
      new Ordering { entities = items; terms = null }
    else if (readable.every((b) -> b))
      new Ordering {
        entities = specs.reverse().fold(items, (acc, s) ->
          if (s.by is Pending)
            let (pd = s.by as Pending)
              acc.sortBy((e) -> resolvePending(items, e, pd) as Boolean)
          else acc.sortBy((e) -> e.getProperty((s.by as PropName).name)))
        terms = null
      }
    else
      new Ordering {
        entities = items
        terms = specs.map((s) ->
          new LiveSort {
            by =
              if (s.by is Pending)
                let (pd = s.by as Pending)
                  new Bound { property = resolveProp(items, pd.key).property; op = pd.op; value = pd.value }
              else resolveProp(items, s.by as PropName)
            dir = s.dir
          })
      }

/// Conjoin a candidate's presence residual with one branch's residual. Either
/// may be statically decided; the result is the runtime condition the wire must
/// carry, or null when nothing defers.
/// Routed through [[all]] rather than building a `PAnd` directly, so the result
/// is canonical: a presence residual identical to the branch guard collapses to
/// one term instead of being conjoined with itself.
local function conjoin(presence: Boolean|Term, branch: Term?): Term? =
  let (parts =
        (if (presence is Term) List(presence as Term) else List()) +
        (if (branch != null) List(branch) else List()))
    if (parts.isEmpty) null else all(parts) as Term

/// Build the wire node from a static candidate list and authored branches.
function buildSet(
  entities: List<Any>,
  branches: List<Branch>,
  presence: (Any) -> Boolean|Term,
  orderSpecs: List<OrderSpec>
): SetNode =
  // 0. fold the ordering first: keys that are all registry-derived sort the
  //    candidates now and emit nothing, so the runtime never compares them.
  let (ordered = foldOrder(entities, orderSpecs))
  // 1. presence folds PER CANDIDATE; a statically-absent one is dropped here and
  //    never reaches the wire.
  let (kept = ordered.entities
        .map((e) -> Pair(e, presence.apply(e)))
        .filter((p) -> !(p.second is Boolean && p.second == false)))
  // 2. dispatch: which branches can win for each surviving candidate.
  let (dispatched = kept
        .map((p) -> Pair(p.first, liveBranches(p.first, branches)))
        .filter((p) -> !p.second.isEmpty))
  // 3. render every (candidate, branch) pair — the full D1 expansion — folding
  //    this candidate's presence residual into each branch's condition, which is
  //    what lets presence and dispatch share one field.
  let (presenceOf = kept.toMap((p) -> p.first.entity_id, (p) -> p.second))
  let (rendered = dispatched.map((p) ->
        Pair(p.first, p.second.map((b) ->
          Pair(b.first.render.apply(p.first),
               conjoin(presenceOf[p.first.entity_id], b.second))))))
  // 4. group the rendered nodes by card to find shapes, then hole out the
  //    literals that vary within a shape.
  let (allNodes = rendered.flatMap((p) -> p.second.map((q) -> q.first)))
  let (byCard = allNodes.groupBy((n) -> n.card))
  let (shapeDefs = byCard.keys.toList().sort().map((card) ->
        shapeOf(byCard[card].first, varyingKeys(byCard[card]))))
  let (varyingByCard = byCard.mapValues((_k, ns) -> varyingKeys(ns)))
  let (shapeIndex = shapeDefs.toList().map((s) -> s.card))
  // 5. dedupe the residual conditions the same way shapes are deduped. Null
  //    first, so index 0 always means unconditional.
  let (conds = List(null) + rendered
        .flatMap((p) -> p.second.map((q) -> q.second))
        .filter((t) -> t != null)
        .distinct)
  new SetNode {
    candidates = dispatched.map((p) -> p.first.entity_id)
    orderBy = ordered.terms
    conditions = conds
    shapes = shapeDefs
    members = rendered.toMap((p) -> p.first.entity_id, (p) ->
      let (winning = p.second.first.first)
        new MemberDef {
          vars = varyingByCard[winning.card]
            .toMap((k) -> k, (k) -> (winning.slots[k] as Lit).literal)
          clauses = p.second.map((q) ->
            new Clause {
              cond = conds.findIndex((t) -> t == q.second)
              shape = shapeIndex.findIndex((c) -> c == q.first.card)
            })
        })
  }
