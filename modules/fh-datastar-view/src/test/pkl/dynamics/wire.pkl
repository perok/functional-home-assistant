/// SPIKE: the proposed `set` wire shape and the build-time fold that produces it.
module wire

// ---- runtime predicate terms (always carry a binding) ----

abstract class Term { kind: String }

class Bound extends Term {
  kind: "cmp" = "cmp"
  property: String
  op: String
  value: Any
}

class PAnd extends Term {
  kind: "and" = "and"
  items: List<Term>
}

/// Fold a mixed list of build-time Booleans and runtime Terms.
/// `false` => this candidate is decided statically and drops out entirely.
/// `true`  => nothing defers; no predicate reaches the wire.
function all(items: List<Boolean|Term>): Boolean|Term =
  if (items.any((i) -> i is Boolean && i == false)) false
  else
    let (rest = items.filter((i) -> i is Term) as List<Term>)
      if (rest.isEmpty) true
      else if (rest.length == 1) rest.first
      else new PAnd { items = rest }

/// The `or` counterpart. A statically-true term short-circuits the whole
/// disjunction, which is what makes presence residuals DIVERGE across the
/// members of one set — see [[SetNode]].
function any(items: List<Boolean|Term>): Boolean|Term =
  if (items.any((i) -> i is Boolean && i == true)) true
  else
    let (rest = items.filter((i) -> i is Term) as List<Term>)
      if (rest.isEmpty) false
      else if (rest.length == 1) rest.first
      else new POr { items = rest }

class POr extends Term {
  kind: "or" = "or"
  items: List<Term>
}

// ---- slots: registry-derived folds to a literal, state-derived stays a transform ----

abstract class Slot
class Lit extends Slot { literal: String }
class Xf extends Slot { transform: String; reactive: Boolean = true }

/// What a render lambda produces for one concrete candidate.
class Node { card: String; slots: Map<String, Slot> }

// ---- the emitted wire node ----

/// One deduped rendering: a card plus the slots that are identical across every
/// member using it. NOT a "case" — the old `DynamicCase` bundled a predicate
/// WITH a rendering, and this format splits those apart; the guard lives in
/// [[SetNode.conditions]] and a [[Clause]] joins the two.
class ShapeDef { card: String; slots: Map<String, Slot> }

/// One guarded rendering rule for a member: "if `cond` holds, render `shape`".
/// Both fields are INDICES into the set's dedup tables
/// ([[SetNode.conditions]] / [[SetNode.shapes]]) — storing either inline would
/// repeat it once per member per rule.
class Clause { cond: Int; shape: Int }

/// A member is a `cond` expression: its clauses are tried in order and the first
/// whose guard holds decides the rendering. Falling off the end means the member
/// is NOT RENDERED — which is why there is no separate presence field.
class MemberDef {
  vars: Map<String, String>
  clauses: List<Clause>
  /// Values for the STATIC ordering positions, indexed by [[StaticSort.slot]].
  /// Empty unless a live key outranks a static one.
  sortVars: List<String> = List()
}

class SetNode {
  kind: "set" = "set"
  /// In render order. When the ordering key folded to registry facts this list
  /// is already sorted and [[orderBy]] is null: the runtime filters to the
  /// present members and preserves this order, O(P) with no comparisons.
  candidates: List<String>
  /// Lexicographic, most significant first. Null when the whole ordering folded
  /// away and `candidates` is already in render order.
  orderBy: List<OrderTerm>?
  /// Distinct runtime guards, referenced by [[Clause.cond]]. Index 0 is always
  /// `null` = unconditional, so a fully static set carries one entry that every
  /// clause points at.
  conditions: List<Term?>
  shapes: List<ShapeDef>
  members: Map<String, MemberDef>
}

// ---- the build ----

/// One authored dispatch branch: a key applied per candidate, and the card to
/// render when it wins. The key returns `Boolean` (folds at build time) or a
/// `Term` (defers to the wire) — mixed via [[all]].
class Branch {
  key: (Any) -> Boolean|Term
  render: (Any) -> Node
}

/// Which branches survive for one candidate, in author order, with their
/// residual runtime condition. A branch whose key folded to `false` is gone; a
/// branch that folded to `true` is unconditional and ends the list (nothing
/// after it can ever win).
local function liveBranches(e: Any, branches: List<Branch>): List<Pair<Branch, Term?>> =
  let (evaluated = branches
        .map((b) -> Pair(b, b.key.apply(e)))
        .filter((p) -> !(p.second is Boolean && p.second == false)))
    let (firstUnconditional = evaluated.findIndexOrNull((p) -> p.second == true))
      (if (firstUnconditional == null) evaluated else evaluated.take(firstUnconditional + 1))
        .map((p) -> Pair(p.first, if (p.second is Term) p.second as Term else null))

/// Slot keys whose LITERAL value differs across the members sharing a shape.
/// Those become per-member `vars`; everything identical stays on the case.
/// This is the D1 -> D2 compression: emit one case, not one node per member.
local function varyingKeys(nodes: List<Node>): List<String> =
  if (nodes.length <= 1) List()
  else
    nodes.first.slots.keys.toList().filter((k) ->
      nodes.any((n) -> n.slots[k] != nodes.first.slots[k]))

local function shapeOf(n: Node, varying: List<String>): ShapeDef =
  new ShapeDef {
    card = n.card
    slots = n.slots.filter((k, _v) -> !varying.contains(k))
  }

/// A LIVE ordering key. `equals` turns the key into a boolean — "state is on"
/// sorts the on-ones first with `dir = "desc"`, rather than sorting the state
/// strings alphabetically.
class SortKey { property: String; dir: String = "asc"; equals: String? = null }

/// A STATIC ordering position: the value is a registry fact, known at build
/// time, but it cannot be folded away because a live key outranks it. Each
/// member carries its value in [[MemberDef.sortVars]] at index `slot`.
class StaticSort { slot: Int; dir: String = "asc" }

typealias OrderTerm = SortKey|StaticSort

class Ordering {
  entities: List<Any>
  /// Null when the whole ordering folded away at build time.
  terms: List<OrderTerm>?
  sortVars: Map<String, List<String>>
}

/// Sort lexicographically by several keys at build time: stable-sort by the
/// LEAST significant key first, then outwards. Verified: Pkl's sort is stable.
local function sortLex(entities: List<Any>, keys: List<(Any) -> Any>): List<Any> =
  keys.reverse().fold(entities, (acc, k) -> acc.sortBy((e) -> k.apply(e)))

/// Fold a LIST of ordering keys. Multi-key ordering is ordinary lexicographic
/// sorting, and each position folds independently:
///
///   - EVERY position static => the whole order is decided now. Sort the
///     candidates and emit nothing; the runtime filters and preserves it.
///   - some position live => emit the term list. Static positions still have to
///     be applied by the runtime (a static key may OUTRANK a live one — "by area,
///     then brightness"), so their per-member values ride in `sortVars`.
///
/// The only error is a single POSITION that folds inconsistently across
/// candidates — static for one, live for another. Those two values are not
/// mutually comparable, and unlike presence there is nothing useful to do with
/// the divergence.
function foldOrder(items: List<Any>, keys: List<(Any) -> Any>): Ordering =
  if (keys.isEmpty || items.isEmpty)
    new Ordering { entities = items; terms = null; sortVars = Map() }
  else
    let (live = keys.map((k) -> k.apply(items.first) is SortKey))
    let (_checked = keys.toList().mapIndexed((i, k) ->
          if (items.every((e) -> (k.apply(e) is SortKey) == live[i])) true
          else throw("""
            Ordering key at position \(i) does not fold to one form across the set:
            it yields a build-time value for some candidates and a live key for
            others. Those are not mutually comparable. Order by a single property
            at each position, or split the set.
            """)))
      if (live.every((b) -> b == false))
        new Ordering { entities = sortLex(items, keys); terms = null; sortVars = Map() }
      else
        let (staticPositions = keys.toList().mapIndexed((i, _k) -> i).filter((i) -> !live[i]))
          new Ordering {
            entities = items
            terms = keys.toList().mapIndexed((i, k) ->
              if (live[i]) k.apply(items.first) as SortKey
              else new StaticSort { slot = staticPositions.findIndex((s) -> s == i) })
            sortVars = items.toMap((e) -> e.entity_id, (e) ->
              staticPositions.map((i) -> keys[i].apply(e).toString()))
          }

/// Conjoin a candidate's presence residual with one branch's residual. Either
/// may be statically decided; the result is the runtime condition the wire must
/// carry, or null when nothing defers.
local function conjoin(presence: Boolean|Term, branch: Term?): Term? =
  if (presence is Boolean)
    (if (presence == true) branch else null)
  else if (branch == null) presence as Term
  else new PAnd { items = List(presence as Term, branch) }

/// Build the wire node from a static candidate list and authored branches.
function buildSet(
  entities: List<Any>,
  branches: List<Branch>,
  presence: (Any) -> Boolean|Term,
  orderKeys: List<(Any) -> Any>
): SetNode =
  // 0. fold the ordering first: keys that are all registry-derived sort the
  //    candidates now and emit nothing, so the runtime never compares them.
  let (ordered = foldOrder(entities, orderKeys))
  // 1. presence folds PER CANDIDATE; a statically-absent one is dropped here and
  //    never reaches the wire.
  let (kept = ordered.entities
        .map((e) -> Pair(e, presence.apply(e)))
        .filter((p) -> !(p.second is Boolean && p.second == false)))
  // 2. dispatch: which branches can win for each surviving candidate.
  let (dispatched = kept
        .map((p) -> Pair(p.first, liveBranches(p.first, branches)))
        .filter((p) -> !p.second.isEmpty))
  // 3. render every (candidate, branch) pair — the full D1 expansion — folding
  //    this candidate's presence residual into each branch's condition, which is
  //    what lets presence and dispatch share one field.
  let (presenceOf = kept.toMap((p) -> p.first.entity_id, (p) -> p.second))
  let (rendered = dispatched.map((p) ->
        Pair(p.first, p.second.map((b) ->
          Pair(b.first.render.apply(p.first),
               conjoin(presenceOf[p.first.entity_id], b.second))))))
  // 4. group the rendered nodes by card to find shapes, then hole out the
  //    literals that vary within a shape.
  let (allNodes = rendered.flatMap((p) -> p.second.map((q) -> q.first)))
  let (byCard = allNodes.groupBy((n) -> n.card))
  let (shapeDefs = byCard.keys.toList().sort().map((card) ->
        shapeOf(byCard[card].first, varyingKeys(byCard[card]))))
  let (varyingByCard = byCard.mapValues((_k, ns) -> varyingKeys(ns)))
  let (shapeIndex = shapeDefs.toList().map((s) -> s.card))
  // 5. dedupe the residual conditions the same way shapes are deduped. Null
  //    first, so index 0 always means unconditional.
  let (conds = List(null) + rendered
        .flatMap((p) -> p.second.map((q) -> q.second))
        .filter((t) -> t != null)
        .distinct)
  new SetNode {
    candidates = dispatched.map((p) -> p.first.entity_id)
    orderBy = ordered.terms
    conditions = conds
    shapes = shapeDefs
    members = rendered.toMap((p) -> p.first.entity_id, (p) ->
      let (winning = p.second.first.first)
        new MemberDef {
          vars = varyingByCard[winning.card]
            .toMap((k) -> k, (k) -> (winning.slots[k] as Lit).literal)
          sortVars = ordered.sortVars.getOrNull(p.first.entity_id) ?? List()
          clauses = p.second.map((q) ->
            new Clause {
              cond = conds.findIndex((t) -> t == q.second)
              shape = shapeIndex.findIndex((c) -> c == q.first.card)
            })
        })
  }
