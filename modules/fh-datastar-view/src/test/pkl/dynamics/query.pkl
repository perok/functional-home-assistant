/// SPIKE — the query surface over a static candidate set.
///
/// Deliberately its OWN namespace, not part of `components.pkl`: this is a
/// query language, and a card knows nothing about it. A `render` lambda hands
/// back an ordinary `Node`, which is the only seam between the two. When this
/// lands for real it becomes `lib/query.pkl`, imported as `q`.
///
/// Candidates are typed `Any`, not `Entity`, on purpose — a member does not
/// have to be an entity (a tile per room makes AREAS the candidates), and
/// baking the assumption in now would have to be unpicked later.
module query

import "wire.pkl"

// ---- boolean structure -----------------------------------------------------
//
// A LIST is conjunction — the common case, so `where` takes one directly and no
// wrapper is needed. Disjunction and negation are explicit, and nest freely:
//
//   .where((e) -> List(e.domain == "light", q.any(List(e.stateIs("on"), e.isFav))))
//
// `&&`/`||` cannot be used across the seam: Pkl rejects `Boolean && Term`, which
// is what keeps a live condition from being smuggled into a static position.

// Each combinator folds NOW when every operand is already resolved, and defers
// to an unresolved `Group` when one is not — so the same three functions cover
// both, and an author never has to pick between an eager and a lazy variant.
// Parameters are deliberately NOT named after the properties they set: inside a
// `new { items = items }` the RHS binds to the object's own member and recurses.
const local function resolved(xs: List<Any>): Boolean =
  xs.every((i) -> i is Boolean || i is wire.Term)

/// Conjunction. A statically-false term decides the candidate immediately.
function all(xs: List<Any>): Any =
  if (resolved(xs)) wire.all(xs as List<Boolean|wire.Term>)
  else new wire.Group { gop = "all"; items = xs }

/// Disjunction. A statically-true term short-circuits the whole thing — which
/// is why presence residuals can differ between members of one set.
function any(xs: List<Any>): Any =
  if (resolved(xs)) wire.any(xs as List<Boolean|wire.Term>)
  else new wire.Group { gop = "any"; items = xs }

/// Negation. Static stays static; a live term becomes a runtime `not`.
function not(x: Any): Any =
  if (x is Boolean) !x
  else if (x is wire.Term) new wire.PNot { item = x as wire.Term }
  else new wire.Group { gop = "not"; items = List(x) }

// ---- property references, shared by predicates AND ordering ----------------
//
// ONE vocabulary. A property is named, not namespaced: the author says
// `q.prop("friendly_name")` and the BUILD decides where it comes from — a
// registry fact if every candidate carries it as a property (build-readable via
// `getProperty`), a live attribute otherwise. `friendly_name` happens to be
// both, and the author should not have to know or care which we use.
//
// The same references feed `where` and `orderBy`, so a predicate and a sort key
// are written the same way.

/// A named property, namespace-resolved at build time (see `wire.resolveProp`).
typealias PropName = wire.PropName

function prop(n: String): wire.PropName = new { name = n }

/// Accept a property only SOME candidates carry; missing reads as null. Without
/// this, mixed availability is a build error — see `wire.resolveProp`.
function optional(p: wire.PropName): wire.PropName = (p) { optional = true }

/// A term computed FROM the candidate. Prefer this over a bare lambda when the
/// term has to COMPOSE: a lambda has no candidate in scope inside
/// `any`/`all`/`not`, but a `candidate` term does.
function candidate(f: (Any) -> Any): wire.CandidateTerm = new { fn = f }

/// The live state value.
const stateProp: wire.PropName = new wire.PropName { name = "state" }

/// A term about a DIFFERENT entity than the member. The id is resolved at build
/// time — usually derived from the candidate, as in "this light's room's motion
/// sensor" — while the test itself stays live.
///
///     q.candidate((e) -> q.entity(motionSensorFor(e.area_id)).eq(q.stateProp, "on"))
class EntityRef {
  id: String
  /// The single-entity shorthand: `q.entity(taklys).stateIs("on")`. The whole point
  /// of naming an entity is usually to test its state, so that should not cost
  /// a `q.eq(q.stateProp, …)` every time.
  function stateIs(s: String): wire.Bound = cmpOn(id, stateProp, "eq", s)
  function stateIsNot(s: String): wire.Bound = cmpOn(id, stateProp, "ne", s)
  function eq(k: wire.PropName, v: Any): wire.Bound = cmpOn(id, k, "eq", v)
  function ne(k: wire.PropName, v: Any): wire.Bound = cmpOn(id, k, "ne", v)
  function gt(k: wire.PropName, v: Any): wire.Bound = cmpOn(id, k, "gt", v)
  function lt(k: wire.PropName, v: Any): wire.Bound = cmpOn(id, k, "lt", v)
}

/// Name one entity. Takes the typed dump entity itself, not just its id, so the
/// common case keeps its typing and a typo is a Pkl error:
/// `q.entity(dump.e_taklys).stateIs("on")`. A bare String is accepted for ids that
/// are computed (`motionByArea[e.area_id]`).
function entity(e: Any): EntityRef =
  new { id = if (e is String) e else (e.getProperty("entity_id") as String) }

// A cross-entity term cannot fold: the build knows WHICH entity, never its
// state. So it is always live, and always names a `state`/`attr:` property.
const local function cmpOn(who: String, k: wire.PropName, cmpOp: String, v: Any): wire.Bound =
  new {
    entity = who
    property = if (k.name == "state") "state" else "attr:" + k.name
    op = cmpOp
    value = v
  }

/// Force the LIVE attribute reading of a name that is also a registry fact.
function attr(n: String): wire.LiveAttr = new { name = n }

// ---- comparisons: the same terms work in `where` and in `orderBy` ----------

// Parameters are deliberately NOT named after the properties they set: inside a
// `new { op = op }` the RHS binds to the object's own member and recurses.
const local function cmp(k: wire.PropName, cmpOp: String, v: Any): wire.Pending =
  new { key = k; op = cmpOp; value = v }

function eq(k: wire.PropName, v: Any): wire.Pending = cmp(k, "eq", v)
function ne(k: wire.PropName, v: Any): wire.Pending = cmp(k, "ne", v)
function gt(k: wire.PropName, v: Any): wire.Pending = cmp(k, "gt", v)
function lt(k: wire.PropName, v: Any): wire.Pending = cmp(k, "lt", v)

// ---- ordering --------------------------------------------------------------
//
// A LIST of positions rather than a lambda: a `where` predicate genuinely
// depends on the candidate, an ordering key never does. `orderBy` accepts a
// single position or a list, since one key is the common case.

function asc(k: wire.PropName|wire.Pending): wire.OrderSpec = new { by = k; dir = "asc" }
function desc(k: wire.PropName|wire.Pending): wire.OrderSpec = new { by = k; dir = "desc" }

// `const` because [[EntitySet.orderBy]] calls it from a class body.
const local function spec(k: wire.OrderSpec|wire.PropName|wire.Pending): wire.OrderSpec =
  if (k is wire.OrderSpec) k else new wire.OrderSpec { by = k as (PropName|wire.Pending) }

// ---- the set ---------------------------------------------------------------

/// A chainable candidate set. Every method returns an amended copy, so a chain
/// is pure accumulation and `build()` hands the four accumulated pieces to the
/// fold. Nothing is evaluated until `build()`.
class EntitySet {
  hidden items: List<Any>
  hidden filters: List<Filter> = List()
  hidden branches: List<wire.Branch> = List()
  hidden specs: List<wire.OrderSpec> = List()

  /// Keep candidates matching the condition. Accepts either a LAMBDA (needed
  /// when the term reads the candidate directly, `(e) -> e.domain == "light"`)
  /// or the DATA form built from the same property references ordering uses
  /// (`q.eq(q.prop("domain"), "light")`), which needs no lambda at all.
  ///
  /// A `List` result is conjunction. Static terms drop candidates at build
  /// time; live terms become the member's condition — one method, one fold.
  function where(f: Filter): EntitySet =
    let (l = this) (l) { filters = l.filters.add(f) }

  /// Lexicographic, most significant first. A declarative LIST rather than a
  /// lambda — unlike [[where]], an ordering key never depends on the individual
  /// candidate. Sort the input list with ordinary Pkl for computed orderings.
  /// One position, or a list of them (lexicographic, most significant first).
  function orderBy(ks: List<wire.OrderSpec|wire.PropName|wire.Pending>|wire.OrderSpec|wire.PropName|wire.Pending): EntitySet =
    let (l = this)
      let (asList = if (ks is List) ks as List<wire.OrderSpec|wire.PropName|wire.Pending> else List(ks))
        (l) { specs = l.specs + asList.map((k) -> spec(k)) }

  /// One guarded rendering. The guard takes exactly what [[where]] takes — a
  /// lambda, a [[candidate]] term, or the data form — and folds the same way:
  /// a `Boolean` decides at build time, anything else defers to the wire.
  function caseOf(g: Filter, r: (Any) -> wire.Node): EntitySet =
    let (l = this)
      (l) {
        branches = l.branches.add(new wire.Branch {
          key = (e) -> normalise(l.items, e, g)
          render = r
        })
      }

  /// Several guarded renderings at once. A `Mapping` keeps author order — which
  /// is match order — and rejects duplicate keys.
  function cases(m: Mapping<Filter, (Any) -> wire.Node>): EntitySet =
    let (l = this)
      (l) {
        branches = l.branches + m.toMap().entries.map((p) ->
          new wire.Branch { key = (e) -> normalise(l.items, e, p.key); render = p.value })
      }

  /// The unconditional last clause. OPTIONAL: with no `else`, a candidate that
  /// matches no clause is simply not rendered, which is often what you want.
  function `else`(r: (Any) -> wire.Node): EntitySet = caseOf((_e) -> true, r)

  /// The only rendering, when there is nothing to dispatch on.
  function render(r: (Any) -> wire.Node): EntitySet = caseOf((_e) -> true, r)

  function build(): wire.SetNode =
    let (l = this)
      wire.buildSet(
        l.items,
        l.branches,
        (e) -> wire.all(l.filters.map((f) -> normalise(l.items, e, f))),
        l.specs)
}

/// Reduce one filter, in either form, to a single folded term for candidate `e`.
const local function normalise(items: List<Any>, e: Any, f: Any): Boolean|wire.Term =
  let (r = if (f is Function) (f as ((Any) -> Any)).apply(e) else f)
    if (r is List)
      wire.all((r as List<Any>).map((x) -> normalise(items, e, x)))
    else if (r is wire.Pending) wire.resolvePending(items, e, r as wire.Pending)
    else if (r is wire.CandidateTerm) normalise(items, e, (r as wire.CandidateTerm).fn)
    else if (r is wire.Group)
      let (g = r as wire.Group)
        let (kids = g.items.map((x) -> normalise(items, e, x)))
          if (g.gop == "all") wire.all(kids)
          else if (g.gop == "any") wire.any(kids)
          else if (kids.first is Boolean) !(kids.first as Boolean)
          else new wire.PNot { item = kids.first as wire.Term }
    else r as (Boolean|wire.Term)

/// What `where` accepts: the data form, a [[candidate]] term, a list of either
/// (conjunction), or a bare lambda over the candidate.
typealias Term = Boolean|wire.Term|wire.Pending|wire.CandidateTerm|wire.Group

typealias Filter = ((Any) -> Term|List<Term>)|Term|List<Term>

/// Start a query. Flexible by design — any list of things with an `entity_id`.
function from(xs: List<Any>): EntitySet = new EntitySet { items = xs }
