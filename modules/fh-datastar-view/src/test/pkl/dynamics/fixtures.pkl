/// SPIKE fixtures: a hand-written stand-in for the generated `@fh-home` dump.
module fixtures

import "wire.pkl"

open class Ent {
  entity_id: String
  domain: String
  friendly_name: String
  area_id: String
  supported_features: Int = 0
  function stateIs(s: String): wire.Bound =
    new { property = "state"; op = "eq"; value = s }
  function attrAbove(n: String, v: Any): wire.Bound =
    new { property = "attr:" + n; op = "gt"; value = v }
  /// A live PROPERTY reference for ordering — the value, not a comparison.
  function attrKey(n: String): wire.PropRef = new { property = "attr:" + n }
}

taklys  = new Ent { entity_id = "light.taklys"; domain = "light"; friendly_name = "Taklys"; area_id = "stue"; supported_features = 8 }
lampe   = new Ent { entity_id = "light.lampe"; domain = "light"; friendly_name = "Lampe"; area_id = "stue"; supported_features = 2 }
spot    = new Ent { entity_id = "light.spot"; domain = "light"; friendly_name = "Spot"; area_id = "stue"; supported_features = 8 }
tv      = new Ent { entity_id = "media_player.tv"; domain = "media_player"; friendly_name = "TV"; area_id = "stue" }
kjokken = new Ent { entity_id = "light.kjokken"; domain = "light"; friendly_name = "Kjøkken"; area_id = "kjokken"; supported_features = 8 }

/// A light also carries a capability the other domains do not — so a property
/// can be present on SOME candidates and absent on others, which is the case
/// `q.optional` exists for.
class LightEnt extends Ent { brightnessMax: Int = 255 }

dimmer = new LightEnt { entity_id = "light.dimmer"; domain = "light"; friendly_name = "Dimmer"; area_id = "stue"; supported_features = 8 }

all: List<Ent> = List(taklys, lampe, spot, tv, kjokken)

/// Mixed shapes: only `dimmer` has `brightnessMax`.
mixed: List<Ent> = List(dimmer, tv)
