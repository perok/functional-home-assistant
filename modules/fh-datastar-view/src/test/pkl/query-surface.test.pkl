/// SPIKE — the authoring surface (`query.pkl`) over the fold in `wire.pkl`.
///
/// The point of these tests is that the surface is THIN: it accumulates four
/// things and hands them to `buildSet`. If a scenario needs the surface to
/// compute anything, that is a signal the split is in the wrong place.
amends "pkl:test"

import "dynamics/query.pkl" as q
import "dynamics/wire.pkl"
import "dynamics/fixtures.pkl"

local slider = (e) -> new wire.Node {
  card = "slider"
  slots = Map("label", new wire.Lit { literal = e.friendly_name },
              "state", new wire.Xf { transform = "$state" })
}
local toggle = (e) -> new wire.Node {
  card = "toggle"
  slots = Map("label", new wire.Lit { literal = e.friendly_name })
}
local mediaCard = (e) -> new wire.Node {
  card = "mediaCard"
  slots = Map("label", new wire.Lit { literal = e.friendly_name })
}

// D1 helpers: there are no shared tables any more, so "how many distinct shapes
// / conditions" is a question you ask of the members.
local allClauses = (s) -> s.members.values.flatMap((m) -> m.clauses)
local cards = (s) -> allClauses.apply(s).map((c) -> c.node.card).distinct
local conds = (s) -> allClauses.apply(s).map((c) -> c.`when`).distinct
local firstNode = (s) -> s.members.values.first.clauses.first.node

facts {
  ["a list argument to `where` is conjunction; static terms drop candidates"] {
    local s = q.from(fixtures.all)
      .where((e) -> List(e.domain == "light", e.area_id == "stue"))
      .render(slider)
      .build()
    s.candidates == List("light.taklys", "light.lampe", "light.spot")
    // nothing live: one condition entry, the unconditional null
    conds.apply(s) == List(null)
  }

  ["chained `where`s conjoin, and a live term becomes the member condition"] {
    local s = q.from(fixtures.all)
      .where((e) -> e.domain == "light")
      .where((e) -> e.stateIs("on"))
      .render(slider)
      .build()
    s.candidates.length == 4
    // one distinct condition, shared by every member. Under the old format this
    // was two, because the table always reserved index 0 for `null`.
    conds.apply(s).length == 1
    (conds.apply(s).first as wire.Bound).property == "state"
  }

  ["`any` is disjunction and nests inside a conjunction list"] {
    local s = q.from(fixtures.all)
      .where((e) -> List(
        e.domain == "light",
        q.any(List(e.supported_features > 4, e.stateIs("on")))))
      .render(slider)
      .build()
    // dimmable lights are unconditionally present; the dumb one defers
    conds.apply(s).length == 2
    s.members["light.taklys"].clauses.first.`when` == null
    s.members["light.lampe"].clauses.first.`when`.property == "state"
  }

  // A list is AND and `any` is OR, so BOTH nestings are expressible. The
  // top-level shape is whichever you write — a list is not forced on you.
  ["`a OR (b AND c)`: `all` nests inside `any` just as `any` nests inside a list"] {
    local s = q.from(fixtures.all)
      .where((e) -> q.any(List(
        e.domain == "media_player",
        q.all(List(e.domain == "light", e.area_id == "stue")))))
      .render(toggle)
      .build()
    // the TV, plus the three stue lights — but not the kjokken light
    s.candidates.length == 4
    s.candidates.contains("media_player.tv")
    !s.candidates.contains("light.kjokken")
  }

  // ONE vocabulary: the same property references drive predicates and ordering,
  // and the data form needs no lambda at all.
  ["the data form of `where` folds a registry property at build time"] {
    local s = q.from(fixtures.all)
      .where(q.eq(q.prop("domain"), "light"))
      .render(toggle)
      .build()
    s.candidates.length == 4
    !s.candidates.contains("media_player.tv")
    // `domain` is a candidate property, so the build read it — nothing deferred
    conds.apply(s) == List(null)
  }

  ["the data form defers a property the build cannot read"] {
    local s = q.from(fixtures.all)
      .where(q.eq(q.stateProp, "on"))
      .render(toggle)
      .build()
    conds.apply(s).length == 1
    (conds.apply(s).filter((c) -> c != null).first as wire.Bound).property == "state"
  }

  ["a name that is not a candidate property resolves to a live attribute"] {
    local s = q.from(fixtures.all)
      .where(q.gt(q.prop("brightness"), 40))
      .render(toggle)
      .build()
    (conds.apply(s).filter((c) -> c != null).first as wire.Bound).property == "attr:brightness"
  }

  ["`orderBy` takes one position as well as a list"] {
    local one = q.from(fixtures.all).where((e) -> e.domain == "light")
      .orderBy(q.desc(q.prop("brightness"))).render(toggle).build()
    one.orderBy.length == 1
    (one.orderBy.first as wire.LiveSort).dir == "desc"
  }

  // VALIDATION. A name present on only SOME candidates is ambiguous: a registry
  // fact for those, a live attribute for the rest. Silently picking one is how a
  // genuinely mixed set quietly stops meaning what the author wrote.
  ["mixed availability is a build error"] {
    module.catchOrNull(() ->
      wire.resolveProp(fixtures.mixed, new wire.PropName { name = "brightnessMax" })
    ) != null
  }

  ["`optional` accepts mixed availability and keeps it a registry read"] {
    wire.resolveProp(fixtures.mixed,
      new wire.PropName { name = "brightnessMax"; optional = true }).property
      == "reg:brightnessMax"
  }

  ["all candidates carry it => registry; none => live attribute"] {
    wire.resolveProp(fixtures.all, new wire.PropName { name = "area_id" }).property
      == "reg:area_id"
    // volatile attributes are deliberately absent from the dump, so this is the
    // limit of what the build can check
    wire.resolveProp(fixtures.all, new wire.PropName { name = "brightness" }).property
      == "attr:brightness"
  }

  ["an optional property missing on a candidate reads as null, not an error"] {
    local s = q.from(fixtures.mixed)
      .where(q.eq(q.optional(q.prop("brightnessMax")), 255))
      .render(toggle)
      .build()
    // the dimmer matches; the TV has no such property, so it compares false
    s.candidates == List("light.dimmer")
  }

  // `candidate` is a first-class TERM, so unlike a bare lambda it composes:
  // inside `any`/`all`/`not` there is no `e` in scope for a lambda to use.
  ["`q.candidate` nests inside `any` where a bare lambda could not"] {
    local s = q.from(fixtures.all)
      .where(q.any(List(
        q.candidate((e) -> e.domain == "media_player"),
        q.candidate((e) -> e.area_id == "kjokken"))))
      .render(toggle)
      .build()
    s.candidates.length == 2
    s.candidates.contains("media_player.tv")
    s.candidates.contains("light.kjokken")
  }

  ["a candidate term composes with a live one inside `any`"] {
    local s = q.from(fixtures.all)
      .where(q.any(List(
        q.candidate((e) -> e.supported_features > 4),
        q.eq(q.stateProp, "on"))))
      .render(toggle)
      .build()
    // dimmables are unconditional; the rest defer to state
    conds.apply(s).length == 2
    s.members["light.taklys"].clauses.first.`when` == null
    s.members["light.lampe"].clauses.first.`when`.property == "state"
  }

  // CANONICAL FORM. The `conditions` table dedupes by structure, so two authored
  // expressions that mean the same thing must reduce to the same term — else
  // they take two table entries and the runtime evaluates the same predicate
  // twice. Both of these were real defects found by inspecting emitted JSON.
  ["a presence residual equal to the branch guard collapses to one term"] {
    local s = q.from(fixtures.all)
      .where((e) -> e.domain == "light")
      .where(q.eq(q.stateProp, "on"))
      .caseOf(q.eq(q.stateProp, "on"), toggle)
      .build()
    // NOT `and[state==on, state==on]`
    conds.apply(s).length == 1
    conds.apply(s).first is wire.Bound
    (conds.apply(s).first as wire.Bound).property == "state"
  }

  ["nested same-kind groups flatten instead of nesting"] {
    local s = q.from(fixtures.all)
      .where((e) -> e.domain == "light")
      .where(q.all(List(
        q.eq(q.stateProp, "on"),
        q.all(List(q.gt(q.prop("brightness"), 40), q.lt(q.prop("brightness"), 200))))))
      .render(toggle)
      .build()
    local live = conds.apply(s).filter((c) -> c != null).first as wire.PAnd
    live.items.length == 3
    live.items.every((i) -> i is wire.Bound)
  }

  ["two spellings of the same filter share ONE condition entry"] {
    local a = q.from(fixtures.all).where((e) -> e.domain == "light")
      .where(q.all(List(q.eq(q.stateProp, "on")))).render(toggle).build()
    local b = q.from(fixtures.all).where((e) -> e.domain == "light")
      .where(q.eq(q.stateProp, "on")).render(toggle).build()
    conds.apply(a) == conds.apply(b)
  }

  ["`not` folds statically when its operand is static"] {
    q.not(true) == false
    q.not(false) == true
    q.not(fixtures.taklys.stateIs("on")) is wire.PNot
  }

  ["`cases` takes several branches at once, author order = match order"] {
    local s = q.from(fixtures.all)
      .cases(new Mapping {
        [(e) -> e.domain == "light"] = slider
        [(e) -> e.domain == "media_player"] = mediaCard
      })
      .build()
    cards.apply(s).length == 2
    s.members["media_player.tv"].clauses.first.node.card !=
      s.members["light.taklys"].clauses.first.node.card
  }

  ["`else` terminates the clause list"] {
    local s = q.from(fixtures.all)
      .where((e) -> e.domain == "light")
      .caseOf((e) -> e.supported_features > 4, slider)
      .`else`(toggle)
      .build()
    s.members.values.every((m) -> m.clauses.length == 1)
    s.members["light.lampe"].clauses.first.node.card !=
      s.members["light.taklys"].clauses.first.node.card
  }

  ["NO `else` is fine: an unmatched candidate is simply not rendered"] {
    local s = q.from(fixtures.all)
      .caseOf((e) -> e.domain == "light", slider)
      .build()
    // the media_player matched no clause and never reaches the wire
    !s.candidates.contains("media_player.tv")
    s.candidates.length == 4
  }

  ["a live clause with no `else` means the member disappears when it fails"] {
    local s = q.from(fixtures.all)
      .where((e) -> e.domain == "light")
      .caseOf((e) -> e.stateIs("on"), slider)
      .build()
    s.members["light.taklys"].clauses.length == 1
    s.members["light.taklys"].clauses.first.`when`.property == "state"
  }

  ["ordering by a PREDICATE sorts by whether it holds — no `equals` field"] {
    local s = q.from(fixtures.all)
      .where((e) -> e.domain == "light")
      .orderBy(List(
        q.desc(q.eq(q.stateProp, "on")),
        q.desc(q.prop("brightness")),
        q.asc(q.prop("friendly_name"))))
      .render(toggle)
      .build()
    s.orderBy.length == 3
    (s.orderBy[0] as wire.LiveSort).by is wire.Bound
    (s.orderBy[0] as wire.LiveSort).dir == "desc"
    (s.orderBy[1] as wire.LiveSort).by is wire.PropRef
    ((s.orderBy[1] as wire.LiveSort).by as wire.PropRef).property == "attr:brightness"
    // the registry tail stays a REFERENCE the backend resolves — nothing per member
    (s.orderBy[2] as wire.LiveSort).by is wire.PropRef
    ((s.orderBy[2] as wire.LiveSort).by as wire.PropRef).property == "reg:friendly_name"
  }

  ["an all-registry ordering is resolved at build time"] {
    local s = q.from(fixtures.all)
      .where((e) -> e.domain == "light")
      .orderBy(List(q.asc(q.prop("friendly_name"))))
      .render(toggle)
      .build()
    // fully static: sorted now, nothing emitted
    s.orderBy == null
    s.candidates == List("light.kjokken", "light.lampe", "light.spot", "light.taklys")
  }
}
