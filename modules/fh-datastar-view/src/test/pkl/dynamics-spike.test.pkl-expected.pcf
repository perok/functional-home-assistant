              "cond": 0,
              "shape": 0
            }
          ]
        },
        "light.kjokken": {
          "vars": {
            "label": "Kjøkken"
          },
          "clauses": [
            {
              "cond": 0,
              "shape": 1
            }
          ]
        }
      }
    }
    """
  }
  ["state-dependent dispatch: the alternatives list"] {
    """
    {
      "kind": "set",
      "candidates": [
        "light.taklys",
        "light.lampe",
        "light.spot"
      ],
      "conditions": [
        null,
        {
          "kind": "cmp",
          "property": "state",
          "op": "eq",
          "value": "on"
        }
      ],
      "shapes": [
        {
          "card": "slider",
          "slots": {}
        },
        {
          "card": "toggle",
          "slots": {}
        }
      ],
      "members": {
        "light.taklys": {
          "vars": {
            "label": "Taklys"
