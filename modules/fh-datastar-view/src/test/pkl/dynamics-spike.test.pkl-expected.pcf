examples {
  ["uniform set, present-when-on, ordered by brightness"] {
    """
    {
      "kind": "set",
      "candidates": [
        "light.taklys",
        "light.lampe",
        "light.spot"
      ],
      "orderBy": {
        "property": "attr:brightness",
        "dir": "desc",
        "tiebreak": "entity_id"
      },
      "conditions": [
        null,
        {
          "kind": "cmp",
          "property": "state",
          "op": "eq",
          "value": "on"
        }
      ],
      "shapes": [
        {
          "card": "slider",
          "slots": {
            "state": {
              "transform": "$state",
              "reactive": true
            }
          }
        }
      ],
      "members": {
        "light.taklys": {
          "vars": {
            "label": "Taklys"
          },
          "clauses": [
            {
              "cond": 1,
              "shape": 0
            }
          ]
        },
        "light.lampe": {
          "vars": {
            "label": "Lampe"
          },
          "clauses": [
            {
              "cond": 1,
              "shape": 0
            }
          ]
        },
        "light.spot": {
          "vars": {
            "label": "Spot"
          },
          "clauses": [
            {
              "cond": 1,
              "shape": 0
            }
          ]
        }
      }
    }
    """
  }
  ["static domain dispatch across the whole house"] {
    """
    {
      "kind": "set",
      "candidates": [
        "light.taklys",
        "light.lampe",
        "light.spot",
        "media_player.tv",
        "light.kjokken"
      ],
      "conditions": [
        null
      ],
      "shapes": [
        {
          "card": "mediaCard",
          "slots": {
            "label": {
              "literal": "TV"
            }
          }
        },
        {
          "card": "slider",
          "slots": {}
        }
      ],
      "members": {
        "light.taklys": {
