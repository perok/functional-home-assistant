examples {
  ["uniform set, present-when-on, ordered by brightness"] {
    """
    {
      "kind": "set",
      "candidates": [
        "light.taklys",
        "light.lampe",
        "light.spot"
      ],
      "orderBy": [
        {
          "by": {
            "kind": "prop",
            "property": "attr:brightness"
          },
          "dir": "desc"
        }
      ],
      "members": {
        "light.taklys": {
          "clauses": [
            {
              "when": {
                "kind": "cmp",
                "property": "state",
                "op": "eq",
                "value": "on"
              },
              "node": {
                "card": "slider",
                "slots": {
                  "label": {
                    "literal": "Taklys"
                  },
                  "state": {
                    "transform": "$state",
                    "reactive": true
                  }
                },
                "children": []
              }
            }
          ]
        },
        "light.lampe": {
          "clauses": [
            {
              "when": {
                "kind": "cmp",
                "property": "state",
                "op": "eq",
                "value": "on"
              },
              "node": {
                "card": "slider",
                "slots": {
                  "label": {
                    "literal": "Lampe"
                  },
                  "state": {
                    "transform": "$state",
                    "reactive": true
                  }
                },
                "children": []
              }
            }
          ]
        },
        "light.spot": {
          "clauses": [
            {
              "when": {
                "kind": "cmp",
                "property": "state",
                "op": "eq",
                "value": "on"
              },
              "node": {
                "card": "slider",
                "slots": {
                  "label": {
                    "literal": "Spot"
                  },
                  "state": {
                    "transform": "$state",
                    "reactive": true
                  }
                },
                "children": []
              }
            }
          ]
        }
      }
    }
    """
  }
