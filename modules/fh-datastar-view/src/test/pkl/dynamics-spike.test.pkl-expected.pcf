examples {
  ["uniform set, present-when-on, ordered by brightness"] {
    """
    {
      "kind": "set",
      "candidates": [
        "light.taklys",
        "light.lampe",
        "light.spot"
      ],
      "orderBy": [
        {
          "by": {
            "kind": "prop",
            "property": "attr:brightness"
          },
          "dir": "desc"
        }
      ],
      "conditions": [
        null,
        {
          "kind": "cmp",
          "property": "state",
          "op": "eq",
          "value": "on"
        }
      ],
      "shapes": [
        {
          "card": "slider",
          "slots": {
            "state": {
              "transform": "$state",
              "reactive": true
            }
          },
          "children": []
        }
      ],
      "members": {
        "light.taklys": {
          "clauses": [
            {
              "cond": 1,
              "shape": 0,
              "vars": {
                "label": "Taklys"
              },
              "fills": []
            }
          ]
        },
        "light.lampe": {
          "clauses": [
            {
              "cond": 1,
              "shape": 0,
              "vars": {
                "label": "Lampe"
              },
              "fills": []
            }
          ]
        },
        "light.spot": {
          "clauses": [
            {
              "cond": 1,
              "shape": 0,
              "vars": {
                "label": "Spot"
              },
              "fills": []
            }
          ]
        }
      }
    }
    """
  }
