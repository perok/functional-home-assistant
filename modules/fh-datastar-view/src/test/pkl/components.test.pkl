/// Unit tests for the `@fh-dashboard` authoring library, run by `pkl test`.
///
/// These live OUTSIDE `lib/` on purpose: `LibPackage` packages that directory
/// into the content-versioned `@fh-dashboard` cache package, so a test module
/// in there would change the package hash and re-evaluate every dashboard.
/// Imports are therefore relative file paths, not `@fh-dashboard/...`.
amends "pkl:test"

import "../../main/resources/dashboards/lib/components.pkl" as c
import "../../main/resources/dashboards/lib/core/node.pkl" as nodes
import "../../main/resources/dashboards/lib/core/css.pkl" as cssMod
import "../../main/resources/dashboards/lib/core/slot.pkl" as slotMod
import "../../main/resources/dashboards/lib/core/tap.pkl" as tapMod
import "../../main/resources/dashboards/lib/core/variable.pkl" as varMod
import "../../main/resources/dashboards/lib/core/simple.pkl" as simpleMod
import "../../main/resources/dashboards/lib/components/history.pkl" as historyMod
import "../../main/resources/dashboards/lib/components/base/onoff.pkl" as switchMod
import "../../main/resources/dashboards/lib/components/base/tile.pkl" as tileMod
import "../../main/resources/dashboards/lib/core/text.pkl" as textMod
import "../../main/resources/dashboards/lib/theme-beer.pkl" as beerMod
import "../../main/resources/dashboards/lib/query.pkl" as q
import "../../main/resources/dashboards/lib/hass.pkl" as hass
import "../../main/resources/dashboards/lib/core/predicate.pkl" as pred
import "../../main/resources/dashboards/lib/hass/active.pkl" as activeTables

local kitchen: hass.LightEntity = new { entity_id = "light.kitchen" }
local dimmer: hass.LightEntity = new {
  entity_id = "light.dimmer"
  colourModes { "brightness" }
}
local outside: hass.SensorEntity = new { entity_id = "sensor.outside" }
// Numeric: HA records statistics for it, which is the strong signal that the
// reading is a number worth charting.
local power: hass.SensorEntity = new {
  entity_id = "sensor.power"
  state_class = "measurement"
  unit_of_measurement = "W"
}
// The appliance trio, in the shape the live instances report: the Electrolux
// washer has a remaining time and NO programme length, the dishwasher has both,
// and the status sensor is words rather than a modelled vocabulary.
local remainingMin: hass.SensorEntity = new {
  entity_id = "sensor.timetoend"
  device_class = "duration"
  unit_of_measurement = "min"
}
local programMin: hass.SensorEntity = new {
  entity_id = "sensor.programduration"
  device_class = "duration"
  unit_of_measurement = "min"
}
local applianceState: hass.SensorEntity = new { entity_id = "sensor.appliancestate" }
// Default-tap fixtures (#106): a domain HA can toggle, one whose service the
// state picks, one that only presses, and one with no action at all.
local frontLock: hass.GenericEntity = new { entity_id = "lock.front"; domain = "lock" }
// The typed lock, with and without the one capability the domain defines.
local latchLock: hass.LockEntity = new {
  entity_id = "lock.latch"
  supported_features = 1
}
local plainLock: hass.LockEntity = new { entity_id = "lock.plain" }
local doorbell: hass.GenericEntity = new { entity_id = "button.doorbell"; domain = "button" }
local class StueArea extends hass.Area { area_id = "stue"; area_name = "Stue" }
local stue = new StueArea {}

// Icon fixtures, shaped as PklDump generates them: a capability attribute lives
// on the class generated PER ENTITY, never on the domain class (ADR 0013), so a
// test that just sets `icon = ...` on a `hass.LightEntity` is testing a shape
// the dump never produces.
local class E_with_icon extends hass.LightEntity {
  icon: String = "mdi:ceiling-light"
  device_class: String = "running"
}
local class E_temp extends hass.SensorEntity { device_class: String = "temperature" }
local class E_custom_icon extends hass.LightEntity { icon: String = "hue:bulb-sultan" }
// A lock carrying its OWN icon — the case that must beat the state table.
local class E_lock_icon extends hass.LockEntity { icon: String = "mdi:key" }

// D1 helpers: there are no shared tables any more, so "how many distinct shapes
// / conditions" is a question you ask of the members.
local allClauses = (s) -> s.members.values.flatMap((m) -> m.clauses)
local cards = (s) -> allClauses.apply(s).map((c) -> c.node.card).distinct
local conds = (s) -> allClauses.apply(s).map((c) -> c.`when`).distinct
local firstNode = (s) -> s.members.values.first.clauses.first.node

facts {
  // The predicate vocabulary lives in `query.pkl` now: there are no free
  // constructors, so every term carries a binding by construction (a set's
  // candidate, or the entity `q.entity` names). These pin the PROPERTY NAMES
  // the runtime reads — `state`, `attr:<name>`, `domain` — which is the part
  // the two sides have to agree on.
  ["a term carries the property name the runtime reads"] {
    local st = q.entity(kitchen).stateIs("on")
    st.property == "state"
    st.op == "eq"
    st.entity == "light.kitchen"

    q.entity(kitchen).lt(q.prop("brightness"), 20).property == "attr:brightness"
    q.entity(kitchen).lt(q.prop("brightness"), 20).op == "lt"
  }

  // The wire spelling of a binding is declared twice — this typealias and
  // `SignalBind.parse` in Scala — and nothing makes them agree, so these pin
  // the strings the Scala side has to accept. A spelling the regex rejects is
  // an eval error here; one the regex accepts but Scala cannot parse decodes
  // to a slot that silently binds nothing.
  ["a binding names its kind on the wire"] {
    slotMod.asText == "text"
    slotMod.asBind == "bind"
    slotMod.asStyle("--_end") == "style:--_end"
    slotMod.asAttr("value") == "attr:value"
    slotMod.asClass("fh-disabled") == "class:fh-disabled"
  }

  ["a numeric threshold stays a number, not a string"] {
    q.entity(kitchen).lt(q.prop("brightness"), 20).value is Int
  }

  ["combinators nest without rebinding `this` to the new object"] {
    // The Pkl trap this pins: a bare `this` inside a `new {}` body rebinds to
    // the object being built, so `and`/`or`/`not` must capture the receiver
    // first. Silent when broken — the term comes out referring to itself.
    local a = q.entity(kitchen).stateIs("on")
    local b = q.entity(kitchen).lt(q.prop("brightness"), 20)
    a.and(b).items.toList().length == 2
    a.and(b).items.toList()[0].property == "state"
    a.or(b).kind == "or"
    a.not().item.property == "state"
    a.not().kind == "not"
  }

  // ---- entity icons -----------------------------------------------------------
  // Resolved at BUILD time, in Home Assistant's own precedence: the entity's own
  // `icon` beats its device_class, which beats its domain. All three are
  // registry facts, so the slot is a LITERAL — it used to be a
  // `$lookup($domain)` JSONata transform on every card.

  ["an entity's OWN icon wins, as the MDI class"] {
    // Its own icon wins over the `running` device_class it also carries.
    c.entityCard(new E_with_icon { entity_id = "light.k" }).slots["icon"]
      == "mdi mdi-ceiling-light"
  }

  ["device_class beats the domain, so a temperature sensor is not a generic one"] {
    local plain: hass.SensorEntity = new { entity_id = "sensor.p" }
    c.entityCard(new E_temp { entity_id = "sensor.t" }).slots["icon"] == "mdi mdi-thermometer"
    // No device_class at all -> the domain default, and no eval error for
    // reading a property this entity does not have.
    c.entityCard(plain).slots["icon"] == "mdi mdi-eye"
  }

  ["a NON-mdi icon set falls through, rather than emitting a dead class"] {
    // Six entities on the reference instance carry `hue:` icons from a HACS
    // integration whose glyphs we do not ship. A class the stylesheet does not
    // define renders as blank space, which is visibly worse than the default.
    c.entityCard(new E_custom_icon { entity_id = "light.h" }).slots["icon"]
      == "mdi mdi-lightbulb"
  }

  ["an unknown domain emits NO icon slot, so the header renders none"] {
    local odd: hass.GenericEntity = new {
      entity_id = "wibble.x"
      domain = "wibble"
    }
    !c.entityCard(odd).slots.containsKey("icon")
  }

  // ---- state-dependent icons ----

  ["a lock's glyph follows its state, as a shared signal"] {
    local tile = c.entityCard(latchLock)
    local m: simpleMod.SimpleMatch = tile.slots["icon"].transform!!
    m.cases.toMap()["locked"] == "mdi mdi-lock"
    m.cases.toMap()["unlocked"] == "mdi mdi-lock-open"
    // `jammed` is the one lock state you want to notice from across the room,
    // and it is not "unlocked".
    m.cases.toMap()["jammed"] == "mdi mdi-lock-alert"
    // An unknown state degrades to the icon this card would have shown anyway —
    // HA ADDS states, so the fallback must not blank the glyph.
    m.otherwise == "mdi mdi-lock"
    // The WHOLE class is the value: the element carries nothing else, so
    // `data-attr:class` has nothing to fight over.
    tile.slots["icon"].signal == "attr:class"
  }

  ["anything more specific than the domain beats the live glyph"] {
    // HA's own precedence, and the reason `stateIconFor` re-checks it: an
    // author's icon, a user's `icon` attribute and a device_class are all more
    // specific than "this is a lock".
    //
    // A plain String, not a `Slot` — which is the whole difference, and is also
    // why both tiers must resolve to the SAME shape of value: the template has
    // one `{{icon}}` and cannot ask which tier filled it.
    c.entityCard(latchLock).icon("mdi:key").slots["icon"] == "mdi mdi-key"
    c.entityCard(new E_lock_icon { entity_id = "lock.k" }).slots["icon"]
      == "mdi mdi-key"
  }

  ["a domain with no state glyphs renders byte-identical to before"] {
    // Most domains are not in the table, and they must not pay for it.
    c.entityCard(kitchen).slots["icon"] == "mdi mdi-lightbulb"
  }

  ["an author override takes either spelling"] {
    local e: hass.LightEntity = new { entity_id = "light.k" }
    c.entityCard(e).icon("mdi:fridge").slots["icon"] == "mdi mdi-fridge"
    c.entityCard(e).icon("mdi-fridge").slots["icon"] == "mdi mdi-fridge"
  }

  ["a node has no cell until a layout builder adds one"] {
    c.title("Lights").cell == null
  }

  ["layout builders put fh- contract classes on the wrapper"] {
    c.title("x").columns(3).cell.classes.toList() == List("fh-cols-3")
    c.title("x").fullWidth().cell.classes.toList() == List("fh-cols-full")
    c.title("x").hug().cell.classes.toList() == List("fh-hug")
    c.title("x").cellClass("my-thing").cell.classes.toList() == List("my-thing")
  }

  ["ONE SPAN PER NODE: a later fh-cols-* drops the earlier one"] {
    c.title("x").columns(3).columns(7).cell.classes.toList() == List("fh-cols-7")
    c.title("x").columns(3).fullWidth().cell.classes.toList() == List("fh-cols-full")
    // a non-span class is additive, not a replacement
    c.title("x").columns(3).hug().cell.classes.toList() == List("fh-cols-3", "fh-hug")
  }

  // ---- more-info (#106) ----
  // The popup a tap opens for an entity nothing can be DONE to: what we know
  // about it, live. Its body is per-entity, hence inline rather than registered.

  ["more-info is an inline popup, so every entity's body is its own surface"] {
    local t = c.tap.moreInfo(kitchen)
    t.inlineSurfaces.containsKey("self")
    // A transform, not a constant: the route carries `dashboard_slug`, which
    // only a transform can read.
    (t.onclick as slotMod.Slot).transform.contains("sse/surface/")
    (t.onclick as slotMod.Slot).transform.contains("/open/\(nodes.NODE_ID)_self")
    (t.onclick as slotMod.Slot).transform.contains("dashboard_slug")
  }

  ["the body is the entity, then the controls its domain has, then its facts"] {
    local body = c.tap.moreInfo(dimmer).inlineSurfaces["self"].content.children[0]
    body.children.toList().map((n) -> n.card)
      == List("tile", "fhcol", "entityInfo", "button")
  }

  ["a numeric sensor's popup carries a chart of where the reading has been"] {
    local body = c.tap.moreInfo(power).inlineSurfaces["self"].content.children[0]
    // The chart arrives under a window chooser, not beside the card: the
    // chooser is what DECLARES the window, so the nesting is what puts the
    // chart in scope of it. Composed here so no dashboard ever writes it.
    body.children.toList().map((n) -> n.card)
      == List("tile", "historyWindows", "entityInfo", "button")
    body.children[1].children[0].card == "historyChart"
    body.children[1].vars["window"] == "24h"
    body.children[1].children[0].slots["chart"].query.params["window"].`var`
      == "window"
  }

  ["a chooser declares the window its charts read, and nothing spells it twice"] {
    local picked = (c.windowChooser) {
      children { c.historyChart(power).chosen() }
    }
    // The DECLARATION and the REFERENCE, produced by two calls that take no
    // name between them — which is the property, not the string: an author
    // cannot misspell one side of this pair because neither side is typed.
    picked.vars["window"] == "24h"
    picked.children[0].slots["chart"].query.params["window"].`var` == "window"
    // The entity is still written down beside it. Only a declared variable is
    // writable, so this chart's subject has nowhere for a write to land.
    picked.children[0].slots["chart"].query.params["entity"] == "sensor.power"
  }

  ["a chart's size is the author's to set, and unset leaves the backend's"] {
    local wide = c.historyChart(power).size(720, 200)
    wide.slots["chart"].transform.params.width == 720
    wide.slots["chart"].transform.params.height == 200
    // A size is how the answer is DRAWN, so the question stays the same one:
    // two sizes of a chart share one fetch.
    wide.slots["chart"].query == c.historyChart(power).slots["chart"].query
    c.historyChart(power).slots["chart"].transform.params.width == null
  }

  ["each window is a tab node of its own, guarded by its own tap"] {
    local bar = (c.windowChooser).regions["bar"].toList()
    bar.map((n) -> n.card) == List("tab", "tab", "tab", "tab")
    bar.map((n) -> (n as nodes.Node).slots["label"]) == List("1h", "24h", "7d", "30d")
    // Per node, so one window's answer never clears another's guard (ADR 0019).
    bar.every((n) -> (n as nodes.Node).slots["busy"] == "1")
    // A window names the chooser by the token, never by an id it cannot know.
    let (week = bar[2] as nodes.Node)
      (week.slots["onclick"] as slotMod.Slot).transform.contains(
        "/" + varMod.declarer("window") + "/window/7d?group=var_" + varMod.declarer("window") + "__window'"
      )
      && (week.slots["active"] as String).endsWith("=== '7d'")
  }

  ["a variable choice is guarded, and takes only plain tokens"] {
    tapMod.setVar("window", "7d").busy
    // A space would split the route segment, and a `'` close the JS string.
    module.catch(() -> tapMod.setVar("window", "7 d")).contains("matches")
    module.catch(() -> tapMod.setVar("window", "it's")).contains("matches")
  }

  ["the declared window moves with `starting`"] {
    local week = (c.windowChooser).starting("7d")
    week.vars["window"] == "7d"
    // The page seeds the highlight from the viewer's value, so the bar
    // carries no copy of the declared one to disagree with it.
    !week.cardDef.template.contains("{{start}}")
  }

  ["a label node is the core label, its tone a slot"] {
    c.label("Leak").cardDef.template == textMod.label("{{tone}}", "{{label}}")
    ((c.label("Leak")) { tone = "error" }).slots["tone"] == "error"
  }

  ["whether a chart makes sense is answered at BUILD time"] {
    // The gate the popup composes on. A sensor with neither a state_class nor
    // a unit is not a number HA records, so no chart is composed at all — and
    // therefore no recorder call is made when the popup opens.
    power.isNumeric
    !outside.isNumeric
  }

  ["a domain with no controls still shows the card and the facts"] {
    // Also the NEGATIVE half of the chart gate: `outside` is a sensor, but a
    // non-numeric one, so no `historyChart` appears between the card and the
    // facts.
    //
    // The property the default flip will rest on: there is no entity for which
    // this popup is empty.
    local body = c.tap.moreInfo(outside).inlineSurfaces["self"].content.children[0]
    body.children.toList().map((n) -> n.card)
      == List("tile", "entityInfo", "button")
  }

  ["the facts card names its subject and reads every attribute live"] {
    local info = c.entityInfo(kitchen)
    info.slots["entity_id"] == "light.kitchen"
    info.slots["attributes"].transform.contains("attr.transformList(k, v,")
    // No attributes evaluates to null, which this default renders as an absent
    // block rather than the word "null".
    info.slots["attributes"].default == ""
  }

  // ---- the default tap (#106) ----
  // Every card is clickable by a default derived from its OWN entity. The
  // build-time half is the point: what used to be one `$lookup($domain)`
  // transform per card is now a literal, and — the part a lookup could not
  // express — sometimes no action at all.

  ["a domain with a real toggle gets a LITERAL route, not a runtime lookup"] {
    // A bare String — no transform, nothing for the runtime to decide, and so
    // nothing that can leave the renderer's identity cache. `service__read`
    // quotes it back into the card's click expression.
    c.entityCard(kitchen).slots["service"] == "light/toggle"
    !c.entityCard(kitchen).slots.containsKey("onclick")
  }

  ["a one-shot domain presses instead of toggling"] {
    c.entityCard(doorbell).slots["service"] == "button/press"
  }

  ["a lock's service is the one thing the STATE has to decide"] {
    local svc: slotMod.Slot = c.entityCard(frontLock).slots["service"]
    local m: simpleMod.SimpleMatch = svc.transform!!
    // A lock's snapshot state decides WHICH service the tap posts; the value
    // itself never changes what the target is.
    m.cases.toMap() == Map("locked", "lock/unlock")
    m.otherwise == "lock/lock"
    // Carried as a SIGNAL with no binding, so the service moves in the signal
    // store and the element's bytes do not — the tile stays in the renderer's
    // identity cache across a lock/unlock (ADR 0017).
    svc.signal == "handler"
    // …and the click expression is therefore not the live one it used to be:
    // the card assembles the URL from `tapMod.serviceClick`.
    !c.entityCard(frontLock).slots.containsKey("onclick")
  }

  ["a domain with NO action falls back to more-info, so nothing is dead"] {
    local card = c.entityCard(outside)
    // Still tappable — but it opens the popup rather than posting a service
    // call HA would reject. This is the flip the more-info work gated.
    card.slots["tappable"] == "1"
    card.inlineSurfaces.containsKey("self")
    !(card.slots["onclick"] as slotMod.Slot).transform.contains("sse/action")
    (card.slots["onclick"] as slotMod.Slot).transform.contains("/open/")
  }

  ["the more-info body's own card does NOT default to more-info"] {
    // Silent when broken, and fatal: `defaultTap` on a non-actionable entity
    // is `moreInfo(e)`, whose body builds this very card — an infinite regress
    // that laziness does not stop, because `slots` forces the tap.
    local body = c.tap.moreInfo(outside).inlineSurfaces["self"].content.children[0]
    body.children.toList().first.inlineSurfaces == null
  }

  ["every class the base stylesheet styles is fh- prefixed, clear of a framework's utilities"] {
    // BeerCSS's `.secondary` is `!important`, and painted a second line white.
    Regex(#"\.([a-zA-Z][\w-]*)"#).findMatchesIn(cssMod.baseCss)
      .map((m) -> m.groups[1].value)
      .every((cls) -> cls.startsWith("fh-"))
  }

  ["a card's features sit in an <article>, beside the tile rather than inside its tap"] {
    // BeerCSS paints a card box only on `<article>`; a `<div class="card">`
    // left the lock floating on the page background.
    c.cards["cardFeatures"].template.contains(#"<article class="card fh-features">"#)
    // Nested inside the tile, one press would post the latch AND the tile's tap.
    local f = c.lock.controls(new hass.LockEntity { entity_id = "lock.front"; supported_features = 1 })
      as nodes.Node
    f.card == "cardFeatures"
    (f.regions!!["actions"].toList().first as nodes.Node).card == "button"
    (f.regions!!["content"].toList().first as nodes.Node).card == "tile"
  }

  ["a tab highlights by STRICT string comparison, so an unseeded '' lights no tab"] {
    // Loose `==` makes `'' == 0` true: an unset selection would look like tab 0.
    local tab = ((c.tabs) { tabs { ["A"] { c.title("a") } ["B"] { c.title("b") } } })
      .children.toList()[1] as nodes.Node
    (tab.slots["active"] as String).endsWith(") === '1'")
    (tab.slots["active"] as String).startsWith("String(")
  }

  ["an If whose branches all fail collapses its cell, rather than leaving a blank band"] {
    c.cards["ifhost"].template.contains(#"class="fh-ifhost""#)
    cssMod.baseCss.contains(".fh-cell:has(>.fh-ifhost:empty){display:none}")
  }

  ["the guard is the tap's: every surface open is guarded, navigate and close are not"] {
    tapMod.openPopup("p").busy
    tapMod.openPopupInline(c.title("x")).busy
    tapMod.setVar("tab", "0").busy
    c.tap.moreInfo(outside).busy
    !tapMod.navigate("home").busy
    !tapMod.closePopup().busy
    // The tab card takes its guard from its tap, like every other card.
    local tab = ((c.tabs) { tabs { ["A"] { c.title("a") } } }).children.toList().first as nodes.Node
    tab.slots["busy"] == "1"
    tab.slots["busyVisual"] == "1"
  }

  ["every pressable card places the guard exactly when its tap asks for it"] {
    local quiet = (tapMod.call("light/toggle", kitchen)) { busyVisual = false }
    local taps = List(
      tapMod.call("light/toggle", kitchen),
      quiet,
      tapMod.openPopup("p"),
      tapMod.navigate("home"),
      tapMod.closePopup()
    )
    local cards = (t: tapMod.TapAction) -> List(
      c.button("b", t),
      c.pill("p", t),
      c.iconButton("mdi:power", t),
      new switchMod.Switch { label = "s"; on = slotMod.stateIn(kitchen, List("on")); tapAction = t },
      new tileMod.Tile { tapAction = t }
    )
    // An anchor (a navigate's `href`) has no splice for the guard to open.
    taps.every((t) -> cards.apply(t).every((n) ->
      let (guarded = t.busy && !n.slots.containsKey("href"))
        n.slots.containsKey("busy") == guarded
          && n.slots.containsKey("busyVisual") == (guarded && t.busyVisual)))
  }

  ["every pressable card refuses a service tap on a dead entity, and only a service tap"] {
    local cards = (t: tapMod.TapAction) -> List(
      c.button("b", t),
      c.pill("p", t),
      c.iconButton("mdi:power", t),
      new switchMod.Switch { label = "s"; on = slotMod.stateIn(kitchen, List("on")); tapAction = t },
      new tileMod.Tile { tapAction = t }
    )
    cards.apply(tapMod.call("light/toggle", kitchen)).every((n) -> n.slots.containsKey("tapDisabled"))
    c.toggle(kitchen).slots.containsKey("tapDisabled")
    List(tapMod.openPopup("p"), tapMod.navigate("home"), tapMod.closePopup())
      .every((t) -> cards.apply(t).every((n) -> !n.slots.containsKey("tapDisabled")))
  }

  ["`tapAction = null` is how a card opts out of being clickable at all"] {
    local card = (c.entityCard(outside)) { tapAction = null }
    !card.slots.containsKey("tappable")
    !card.slots.containsKey("onclick")
  }

  ["a pressable card with nothing to press is a BUILD error"] {
    // The amend form is the one that could reach it: the factories take an
    // action, so only `new c.Button { label = ... }` leaves both unset. It used
    // to post `homeassistant/toggle` with an empty entity id.
    // `slots["onclick"]` and not `slots`: reading the object does not force its
    // entries, so a `catch` over the bare `slots` sees no error at all.
    module.catch(() -> (new c.Button { label = "x" }).slots["onclick"])
      .contains("nothing happens on click")
    // A toggle whose domain cannot be toggled is the same mistake.
    module.catch(() -> c.toggle(outside).slots["onclick"]).contains("nothing happens on click")
  }

  ["disabled on a button that NAVIGATES is a build error, not a no-op"] {
    // A navigating button renders as `<a href>`, and `disabled` is a
    // form-control attribute — there is no inert form of a link short of
    // dropping its href, which would take middle-click and open-in-new-tab with
    // it. Refused rather than accepted and ignored: silently dropping the
    // option is how a control ends up looking guarded and not being it.
    module
      .catch(() ->
        c.entityButton(latchLock)
          .tapAction(c.tap.navigate("/other"))
          .disabled(c.stateIn(latchLock, List("opening")))
          .slots["label"])
      .contains("renders as a link")
    // The same button with a SERVICE tap is fine, which is what makes the
    // check about the link rather than about `disabled`.
    c.entityButton(latchLock)
      .tapAction(c.tap.locks.openLatch(latchLock))
      .disabled(c.stateIn(latchLock, List("opening")))
      .slots["tapDisabled"].signal == "handler"
  }

  // ---- CSS ownership (ADR 0020) ----

  ["the base CSS carries the layout contract and the variables cards read"] {
    // It is a dashboard property, not a theme one, so this is what every
    // dashboard gets whatever look it wears.
    cssMod.baseCss.contains(".fh-grid{display:flex")
    cssMod.baseCss.contains(".fh-cols-12{")
    cssMod.baseCss.contains("--fh-text-dim:var(--secondary-text-color)")
    // The classes the RUNTIME emits, which no card owns.
    cssMod.baseCss.contains(".fh-toast{")
    cssMod.baseCss.contains(".fh-disabled{opacity:.5}")
    // The half of the leaving-page rule that lives here; `src/js/shell.ts` sets
    // the class, and ServerRoutesSuite pins that side. `!important` is the rule,
    // not a detail: `data-show` reveals a banner by clearing its inline display.
    cssMod.baseCss.contains(".fh-leaving .fh-offline{display:none!important}")
    // A hairline edge is a colour ROLE, so it is a contract name rather than a
    // literal in whichever card first needed one.
    cssMod.baseCss.contains("--fh-border:var(--divider-color)")
  }

  ["a control still holds its own label, however long"] {
    local cards = c.cards
    // A framework sizes a button to one line and a row to nowrap; a label
    // longer than either used to spill sideways — the button out of its pill,
    // the toggle's switch off the card. WHAT happens instead is the dashboard's
    // choice now (`core/text.pkl`), so what each card owes is the ROOM to carry
    // it out: a button free to grow down, and a switch that never shrinks.
    cards["button"].css.contains("min-block-size:var(--fh-press-size,3rem)")
    cards["button"].css.contains("block-size:auto")
    cards["switch"].css.contains(".card.row.toggle>.switch{flex:0 0 auto}")
    // ...and the class those rules name is really in the markup. Matched
    // WITHOUT the closing bracket: the element carries bindings now, and this
    // fact is about the class list, not about the tag being bare.
    cards["switch"].template.contains(#"<article class="card row toggle""#)
    // The label itself is a text box in both, which is the half that shrinks.
    cards["button"].template.contains(#"<span class="fh-text">"#)
    cards["switch"].template.contains(#"<span class="max fh-text">"#)
  }

  ["one dashboard-wide answer to a label that does not fit"] {
    local cards = c.cards
    // Every card that shows text places the same two boxes, so the modes are
    // three declaration blocks rather than a rule per card. The OUTER box is
    // what the card's own layout sizes; the INNER one is what a marquee moves,
    // and a bare text node could not be moved at all.
    cards["sectionTitle"].template.contains(#"<h2 class="fh-section fh-text"><span class="fh-text-run">{{label}}</span></h2>"#)
    cards["pill"].template.contains(#"<span class="fh-text"><span class="fh-text-run">{{label}}</span></span>"#)
    cards["tile"].template.contains(#"<span class="fh-sub fh-text">"#)
    // A slider's text is `sliderText`'s, not `sliderHead`'s: the head holds
    // regions now (#151), and a card that holds regions is never patched — so
    // the two values here that move as bytes are their own node.
    cards["sliderText"].template.contains(#"<strong class="fh-text"><span class="fh-text-run">{{label}}</span></strong>"#)
    cards["sliderText"].template.contains(#"<span class="fh-sub fh-text"><span class="fh-text-run" {{{secondary__bind}}}>{{secondary}}</span></span>"#)
    // A signal-backed reading binds on the RUN, not on the box: `data-text`
    // replaces an element's whole content, so binding the box would delete the
    // run on the first tick and the label would never move again.
    cards["tile"].template.contains(#"<span class="fh-text-run" {{{value__bind}}}>{{value}}</span>"#)

    // The mode travels as inherited custom properties. That is not a style
    // choice: two equally-specific `.fh-text-clip .fh-text` / `.fh-text-wrap
    // .fh-text` rules would be settled by stylesheet ORDER, where inheritance is
    // settled by which ancestor is NEARER — which is what "a card inside a
    // scrolling group can say clip" means.
    cssMod.baseCss.contains(".fh-text-clip{--fh-text-lines:nowrap")
    cssMod.baseCss.contains(".fh-text-wrap{--fh-text-lines:normal")
    cssMod.baseCss.contains("white-space:var(--fh-text-lines,nowrap)")
    // Only the scrolling mode measures itself, and it travels by exactly the
    // overflow: `100cqw` is the box, `100%` is the run, and `min()` pins a label
    // that fits at zero — so "only when it does not fit" needs no script.
    cssMod.baseCss.contains("container-type:var(--fh-text-track,normal)")
    cssMod.baseCss.contains("transform:translateX(min(0px,calc(100cqw - 100%)))")
    cssMod.baseCss.contains("@media (prefers-reduced-motion:reduce)")
  }

  ["a node can differ from the dashboard it is on"] {
    // The per-node override is a cell class, so it covers the card AND anything
    // under it — and it is ONE per node: asking twice replaces, it does not
    // stack two modes whose winner would be stylesheet order.
    local scrolling = c.entityCard(kitchen).textOverflow("scroll")
    scrolling.cell.classes.toList() == List("fh-text-scroll")
    scrolling.textOverflow("wrap").cell.classes.toList() == List("fh-text-wrap")
    // ...and it composes with the other cell answers, which are a different
    // question and keep their own slot.
    c.entityCard(kitchen).columns(3).textOverflow("clip").cell.classes.toList()
      == List("fh-cols-3", "fh-text-clip")
    // The default is what a dashboard emits at :root, so a node that says
    // nothing inherits it rather than each card carrying a copy.
    textMod.rootCss("scroll").startsWith(":root{--fh-text-lines:nowrap")
  }

  ["the popup's ✕ is a touch target, and a member row has an edge"] {
    local cards = c.cards
    // 2.75rem = 44px, the platform touch-target minimum; it was a bare glyph
    // with .25rem of padding, in the corner of the screen.
    cards["popup"].css.contains(".popup-close{position:absolute")
    cards["popup"].css.contains("inline-size:2.75rem;block-size:2.75rem")
    // The hairline that makes an OFF member row visible on a dark palette,
    // through the contract rather than as a literal.
    cards["slider"].css.contains("box-shadow:inset 0 0 0 .0625rem var(--fh-border)")
  }

  // #128: a slider's own edge, and a slider on a light that cannot dim.
  ["a slider's edge is drawn OVER its fill, so a full one still ends somewhere"] {
    local cards = c.cards
    // The property, not the rule: whatever draws the edge has to be painted
    // above the descendants, because the fill IS a descendant and reaches the
    // card's boundary at 100 %. An inset shadow on the card itself cannot.
    cards["slider"].css.contains(".slider-card:after{content:\"\";position:absolute")
    // One edge, not two: the member row's own inset shadow was the invisible
    // one, and it is this rule's job now.
    cards["slider"].css.split("box-shadow:inset 0 0 0 .0625rem var(--fh-border)").length == 2
  }

  ["a light the dump caught unavailable, with no colour modes, keeps its slider"] {
    // Toggle-only is HA's positive `onoff`, never "reports no dimmable mode".
    local blind: hass.LightEntity = new { entity_id = "light.away" }
    !c.entitySlider(blind).toggleOnly
    !c.entitySlider(blind).headSlots.containsKey("toggle")
  }

  ["a light that only switches keeps the row, and stops pretending to slide"] {
    local switchOnly: hass.LightEntity = new {
      entity_id = "light.porch"
      colourModes { "onoff" }
    }
    // As a group's rows are composed: the caller does not know, and does not
    // have to, which of a group's lights can dim.
    local row = (c.entitySlider(switchOnly)).readout("percent")
    row.toggleOnly
    row.headSlots["toggle"] == "1"
    // The whole track posts the domain's own toggle.
    row.headSlots["service"] == "light/toggle"
    // All or nothing, in the theme's switch-fill rather than in the text colour
    // — a light with no brightness reports no colour either (`onoff` is a
    // light's SOLE mode when present), so the default is the only paint it can
    // get. A TOKEN, not the literal behind it: the value is the theme's to move.
    // The fill is OPTED IN: a one-armed state match of the simple tier
    // (annotated local = the runtime-checked downcast from the union).
    local fillMatch: simpleMod.SimpleMatch = row.headSlots["fill"].transform!!
    fillMatch.cases.toMap() == Map("on", "0%")
    fillMatch.otherwise == "100%"
    row.headSlots["fillColor"].default == "var(--fh-default-color)"
    // ...and the token is one the contract actually defines. A `var()` naming
    // nothing paints TRANSPARENT, and only a browser would ever say so.
    cssMod.baseCss.contains("--fh-default-color:rgb(189, 189, 176)")
    // A percentage of an axis it does not have reads 0 % forever, so the row
    // reads out its state instead — and nothing drags the readout.
    // The state readout opted in as the raw-state shape.
    (row.headSlots["state"].transform as simpleMod.SimpleValue).op == "state"
    !row.slots.containsKey("dragPercent")
    // The markup is ONE template shared by every slider, so the two shapes are
    // sections of it rather than two cards.
    c.cards["sliderHead"].template.contains("{{#toggle}}<button type=\"button\" class=\"slider-toggle\"")
    c.cards["sliderHead"].template.contains("{{^toggle}}<input type=\"range\"")
    // ...and a light that CAN dim is untouched by all of it — as is one that
    // says NOTHING about its modes, which is what an entity that was
    // unavailable when the dump was taken looks like.
    local dim = (c.entitySlider(dimmer)).readout("percent")
    !dim.toggleOnly
    !(c.entitySlider(kitchen)).toggleOnly
    !dim.slots.containsKey("toggle")
    // The percent READOUT rides the "state" slot (shownReadout), opted in as
    // the simple tier's percent over the light's own 1..255 range.
    local statePercent: simpleMod.SimpleValue = dim.headSlots["state"].transform!!
    statePercent.op == "percent"
    statePercent.value == "brightness"
    statePercent.params.toMap() == Map("min", 1, "max", 255)
    dim.headSlots["dragPercent"] == "1"
  }

  ["a card's structure travels with the card"] {
    // The registry is what the renderer concatenates, so the assertion is on
    // the registry rather than on the class: a card whose `css` never reaches
    // it renders unstyled.
    local cards = c.cards
    cards["slider"].css.contains(".slider-head{display:flex")
    cards["tile"].css.contains(".card.tappable{cursor:pointer}")
    cards["entityInfo"].css.contains(".entity-info-attrs{")
    cards["popup"].css.contains("dialog.popup{")
    cards["tabs"].css.contains(".tab-panel{display:contents}")
    // Colour goes through the `--fh-*` contract, never a framework's own role
    // name — that is what makes a card portable to another theme.
    !cards["slider"].css.contains("--surface-container")
    !cards["slider"].css.contains("var(--primary)")
  }

  ["a card binds the plain fh- spinner, for the server to rewrite per theme"] {
    c.cards["tile"].template.contains(#"data-class:fh-busy-spin="$_{{id}}__busy_slow""#)
    // The commit signal is bound by the HEAD, which is the card that moves.
    c.cards["sliderHead"].template.contains(#"data-class:fh-busy-spin="$_{{id}}__busy_change_slow""#)
    // The guard and its immediate dim, which a theme can add to but no card
    // leaves out.
    c.cards["tile"].template.contains("data-class:fh-disabled")
  }

  ["the BeerCSS spinner takes the plain one's place rather than sitting beside it"] {
    // Beside it, the base ring would draw under BeerCSS's mask.
    local content = beerMod.theme.classes["fh-busy-spin"].split(" ")
    content.contains("loading-indicator")
    !content.contains("fh-busy-spin")
  }

  ["`informative` reads the card's OWN entity"] {
    // The amend-scoping trap, and silent when broken: a mixin resolving the
    // entity anywhere but on the card it is applied to opens the wrong popup.
    local card = (c.entityCard(kitchen)) |> c.informative
    card.inlineSurfaces["self"].content.children[0].children[0]
      .slots["entity_id"] == "light.kitchen"
  }

  ["`secondary` means one thing on every card: a String is the text"] {
    // An attribute is asked for by name, never inferred from a bare String —
    // which is what it meant on an entity card before the base cards took it.
    c.entityCard(kitchen).secondary("device_class").slots["secondary"] == "device_class"
    c.button("x", c.tap.closePopup()).secondary("device_class").slots["secondary"] == "device_class"
    c.entitySlider(kitchen).secondary("device_class").textSlots["secondary"] == "device_class"

    local byAttr = c.entityCard(kitchen).secondary(c.attr("device_class")).slots["secondary"] as slotMod.Slot
    byAttr.transform == simpleMod.attr("device_class")
    byAttr.entityId == null
  }

  ["expression values ride the wire as `values`, and only when there are some"] {
    c.button("x", c.tap.closePopup()).values == null
    local lights = List(kitchen)
    local b = (c.button("x", c.tap.closePopup())) {
      expressionValues {
        ["lights_on"] = q.from(lights).where(q.eq(q.stateProp, "on")).count()
        ["lights_total"] = lights.length
        ["floor"] = "Stue"
      }
    }
    b.values["lights_total"] == 1
    b.values["floor"] == "Stue"
    // A count goes out as its tally: what the runtime counts, live.
    local on = b.values["lights_on"] as pred.Tally
    on.candidates.toList() == List("light.kitchen")
    on.`when`["light.kitchen"].property == "state"
  }

  ["the expressionValues builder is the amend, as a chain step"] {
    local lights = List(kitchen)
    local amended = (c.button("x", c.tap.closePopup()).secondary(c.expr("string(n)"))) {
      expressionValues { ["n"] = q.from(lights).count() }
    }
    local chained = c.button("x", c.tap.closePopup())
      .secondary(c.expr("string(n)"))
      .expressionValues(new Mapping { ["n"] = q.from(lights).count() })
    new JsonRenderer {}.renderValue(chained) == new JsonRenderer {}.renderValue(amended)
  }

  ["every card placing `secondary` binds it, and guards it by presence"] {
    // A live `secondary` is a text signal (ADR 0017). Its patch-form value is
    // blank, so a VALUE guard (`{{#secondary}}`) would delete the element on the
    // first tick, and a run without the bind would never update.
    local placing = c.cards.toMap().filter((_, d) -> d.template.contains("{{secondary}}"))
    placing.keys == Set("tile", "button", "sliderText")
    placing.every((_, d) ->
      d.template.contains("{{{secondary__bind}}}") && !d.template.contains("{{#secondary}}"))

    (c.entityCard(kitchen).secondary(c.expr("state")).slots["secondary"] as slotMod.Slot).signal == "text"
    // A literal is the text itself, and a reading that is not live stays bytes.
    c.entityCard(kitchen).secondary("Kjøkken").slots["secondary"] == "Kjøkken"
    local once = new slotMod.Slot { transform = "state"; reads = "once" }
    (c.entityCard(kitchen).secondary(once).slots["secondary"] as slotMod.Slot).signal == null
  }

  ["a button takes a second line, and one without it is untouched"] {
    local plain = c.button("Stue", c.tap.closePopup())
    !plain.slots.containsKey("secondary")

    local literal = plain.secondary("Turns off 4 lights")
    literal.slots["secondary"] == "Turns off 4 lights"
    literal.slots["label"] == "Stue"

    // A `c.expr` is a live reading of the subject, like a label's.
    local live = c.entityButton(kitchen).secondary(c.expr("state"))
    (live.slots["secondary"] as slotMod.Slot).transform == "state"
    live.slots["entity_id"] == kitchen.entity_id

    // A glyph with a second line is not a bare icon, so it stays rectangular.
    local glyphed = c.iconButton("mdi:power", c.tap.closePopup()).secondary("Off")
    !glyphed.slots.containsKey("round")

    // Both arms place it, under the same section that opens the column.
    local t = c.cards["button"].template
    t.split("{{#secondary__has}}<span class=\"fh-lines\">").length == 3
    t.contains("<span class=\"fh-sub fh-text\"><span class=\"fh-text-run\" {{{secondary__bind}}}>{{secondary}}</span></span></span>")
  }

  ["a button or a pill can be a glyph, a label, or both"] {
    // What the slider's head action needed over `c.pill` was a glyph, no label
    // and the `active` tint. None of the three is about sliders, so all three are
    // the shared cards' — one icon button in the library, not a private copy.
    local labelled = c.button("Close", c.tap.closePopup())
    !labelled.slots.containsKey("glyph")
    !labelled.slots.containsKey("round")
    labelled.slots["label"] == "Close"

    local glyphOnly = c.iconButton("mdi:power", c.tap.closePopup())
    glyphOnly.slots["glyph"] == "mdi mdi-power"
    // ROUND exactly when the glyph is alone: a bare icon in a rectangle reads
    // as a label that failed to render.
    glyphOnly.slots["round"] == "1"
    glyphOnly.slots["label"] == ""

    // Both together stay rectangular — that is an ordinary button with an icon.
    local both = (c.button("Power", c.tap.closePopup())).icon("mdi:power")
    both.slots["glyph"] == "mdi mdi-power"
    !both.slots.containsKey("round")

    // A pill takes the glyph too; it has no round variant because a chip is
    // already pill-shaped.
    local chip = (c.pill("Up", c.tap.navigate("under"))).icon("mdi:arrow-up")
    chip.slots["glyph"] == "mdi-arrow-up"
    !chip.slots.containsKey("round")

    // `active` is OFF by default — most buttons do something rather than
    // reflect a state — and rides the CELL, which the button card paints.
    glyphOnly.cell == null
    c.entityButton(kitchen).cell == null
    c.entityButton(kitchen).active(c.isOn(kitchen)).cell.classWhen["fh-active"].signal
      == "class:fh-active"
    c.cards["button"].css.contains(".fh-cell.fh-active>")
  }

  ["a toggle and an entity card are their base built by hand, and nothing more"] {
    local sw = new switchMod.Switch {
      label = kitchen.entity_id
      on = new slotMod.Slot {
        transform = simpleMod.enumOf("on", "on", "")
        default = ""
        bypassUnavailable = false
      }
      tapAction = c.tap.toggle(kitchen)
      subject = kitchen.entity_id
      glyph = "mdi mdi-lightbulb"
    }
    c.toggle(kitchen).slots == sw.slots
    c.toggle(kitchen).cardDef == sw.cardDef
    // A plain sensor: no state icon, so its glyph is the domain's literal.
    local tile = new tileMod.Tile {
      title = outside.entity_id
      reading = slotMod.valueSlot(null)
      glyph = "mdi mdi-eye"
      tapAction = c.tap.default(outside)
      subject = outside.entity_id
    }
    c.entityCard(outside).slots == tile.slots
    c.entityCard(outside).cardDef == tile.cardDef
    // The entity card's own inputs mean something about ITS entity — an
    // attribute name — and become a tile reading.
    c.entityCard(outside).value("battery").slots
      == (tile) { reading = slotMod.valueSlot("battery") }.slots
  }

  ["an entity slider is a base slider with its inputs filled, and nothing more"] {
    // The HA layer is THIN: the head, the text, the group and the card are all
    // the base's, so the whole node tree must be what an author builds by hand.
    local byHand = new c.Slider {
      title = slotMod.labelSlot(kitchen, null)
      glyph = "mdi-lightbulb"
      rangeMin = 1
      rangeMax = 255
      position = new slotMod.Slot {
        transform = simpleMod.attr("brightness")
        default = "0"
        bypassUnavailable = false
      }
      fill = new slotMod.Slot {
        transform = simpleMod.fill("brightness", 1, 255)
        default = "100%"
        bypassUnavailable = false
      }
      reading = new slotMod.Slot { transform = simpleMod.state() }
      commit = (c.tap.call("light/turn_on", kitchen)) { dataKey = "brightness" }
      subject = kitchen.entity_id
    }
    local ha = c.entitySlider(kitchen)
    ha.card == byHand.card
    ha.cardDef == byHand.cardDef
    ha.slots == byHand.slots
    ha.children == byHand.children
    // The power-button shorthand is a leading action, ahead of the author's.
    local t = c.tap.toggle(kitchen)
    local info = c.sliderAction(kitchen, c.tap.moreInfo(kitchen))
    ha.tapAction(t).actions(List(info)).children
      == (byHand) { leadingActions { c.sliderAction(kitchen, t) } }.actions(List(info)).children
  }

  ["a button's cell is the same whichever order its builders run in"] {
    // `active` and `.columns(n)` both write the wrapper's classes, and a cell
    // amended as one value would keep whichever came last.
    local tap = c.tap.toggle(kitchen)
    local after = c.button("x", tap).columns(3).active(c.isOn(kitchen))
    local before = c.button("x", tap).active(c.isOn(kitchen)).columns(3)
    after.cell == before.cell
    after.cell.classes.toList() == List("fh-cols-3")
    after.cell.classWhen.containsKey("fh-active")
    c.button("x", tap).active(true).columns(3).cell.classes.toList().sort()
      == List("fh-active", "fh-cols-3")
  }

  ["an entity button is a base button with its inputs filled, and nothing more"] {
    // The HA layer is THIN: no card, template or slot of its own. So it must be
    // exactly what an author could build by hand from the base.
    local byHand = (c.button(kitchen.entity_id, c.tap.toggle(kitchen))) {
      subject = kitchen.entity_id
      glyph = "mdi mdi-lightbulb"
    }
    c.entityButton(kitchen).slots == byHand.slots
    c.entityButton(kitchen).cardDef == byHand.cardDef
    c.entityButton(kitchen).active(c.isOn(kitchen)).cell
      == byHand.active(c.isOn(kitchen)).cell
  }

  ["a link to a dashboard can tell it is the open one, without a signal"] {
    // Every card that can render a navigate as a link places the mark, read
    // once from the slug the renderer serves.
    local links = List(
      c.button("Home", c.tap.navigate("home")),
      c.pill("Home", c.tap.navigate("home")),
      c.entityButton(kitchen).tapAction(c.tap.navigate("home"))
    )
    links.every((n) ->
      let (cur = n.slots["current"] as slotMod.Slot)
        cur.transform == "dashboard_slug == 'home'" && cur.reads == "once"
          && cur.type == "bool" && cur.signal == null)
    List("button", "pill").every((k) ->
      let (t = c.cards[k].template)
        t.contains(tapMod.currentClass + "\"" + tapMod.currentAttr + " href="))
    // A service tap is no link, so it has nothing to mark.
    !c.button("x", c.tap.toggle(kitchen)).slots.containsKey("current")
    // A slug is a key the author wrote, so a quote in it stays in the string.
    (c.button("x", c.tap.navigate("it's")).slots["current"] as slotMod.Slot).transform
      == #"dashboard_slug == 'it\'s'"#
    // Ringed, not filled: a fill already means on.
    cssMod.baseCss.contains(".fh-cell>.fh-current-dashboard{outline:")
  }

  ["an entity button wears its entity's icon, live where the domain's follows its state"] {
    c.entityButton(kitchen).slots["glyph"] == "mdi mdi-lightbulb"
    // A lock's glyph is its state's, so the button flips with it as its tile does.
    (c.entityButton(plainLock).slots["glyph"] as slotMod.Slot).signal == "attr:class"
    c.entityButton(plainLock).slots["glyph"] == c.entityCard(plainLock).slots["icon"]
    // An author's icon wins, and `noIcon` takes the glyph away entirely.
    c.entityButton(kitchen).icon("mdi:fan").slots["glyph"] == "mdi mdi-fan"
    !c.entityButton(kitchen).noIcon().slots.containsKey("glyph")
    // Labelled, so still the pill and never the round icon form.
    !c.entityButton(kitchen).slots.containsKey("round")
  }

  ["a button's size is a class token a theme can map"] {
    // One literal token per size in the markup, since a theme's class rules
    // rewrite only literal `fh-` tokens, and BeerCSS maps every one.
    local t = c.cards["button"].template
    List("small", "medium", "large").every((sz) ->
      t.contains(" fh-size-\(sz){{/") && beerMod.theme.classes.containsKey("fh-size-\(sz)"))
    // Large by default, and one size at a time.
    c.button("x", c.tap.closePopup()).slots["sizeLarge"] == "1"
    local small = c.button("x", c.tap.closePopup()).size("small")
    small.slots["sizeSmall"] == "1"
    !small.slots.containsKey("sizeLarge")
    // The base heights are fallbacks; under BeerCSS the height is its own.
    c.cards["button"].css.contains(".fh-press.fh-size-small{--fh-press-size:2rem}")
    beerMod.theme.styles.contains("--fh-press-size:var(--_size)")
  }

  ["an entity card's badge fills while its entity is on, by HA's rule for the domain"] {
    local lit = c.entityCard(kitchen).cell.classWhen["fh-active"]
    lit.signal == "class:fh-active"
    lit.entityId == kitchen.entity_id
    lit.type == "bool"
    // `off` and the two unavailable states are off; any other state is on.
    local light = lit.transform as simpleMod.SimpleMatch
    light.cases.toMap() == Map("unavailable", false, "unknown", false, "off", false)
    light.otherwise == true
    // A lock is on while it is not locked: HA's reading, not `on`.
    (c.entityCard(plainLock).cell.classWhen["fh-active"].transform as simpleMod.SimpleMatch)
      .cases.toMap()["locked"] == false
    // A reading has no off, so a sensor carries no live class at all.
    c.entityCard(outside).cell == null
    c.entityCard(kitchen).active(false).cell == null
    c.cards["tile"].css.contains(".fh-cell.fh-active .fh-tile>.fh-badge{background:var(--fh-accent)")
    // A domain sits in at most one of the vendored tables, or which one wins
    // would be an accident of `activeOf`'s order.
    local named = activeTables.neutral.toList() + activeTables.onIn.keys.toList()
      + activeTables.offIn.keys.toList()
    named.length == named.distinct.length
  }

  ["a button knows only its label and its tap; an entity button knows its entity"] {
    local plain = c.button("Kjøkken", c.tap.toggle(kitchen))
    !plain.slots.containsKey("entity_id")
    local about = c.entityButton(kitchen)
    about.slots["entity_id"] == kitchen.entity_id
    // Named after it, and doing what its domain does.
    about.slots["label"] == kitchen.entity_id
    about.slots["service"] == "light/toggle"
    about.slots["targetId"] == kitchen.entity_id
    // The same card: one registry entry, one template.
    about.card == "button"
    c.cards.keys.filter((k) -> k == "button").length == 1
  }

  ["a slider's head actions are NODES, so each owns its own busy signal"] {
    // The reason #151 is a region and not a repeated slot. ADR 0019 allows one
    // busy-guarded element per node, and the busy signal is named after the
    // node — so two buttons sharing the head's id could only ever arm one of
    // them, and pressing either would disable both.
    local row = (c.entitySlider(kitchen))
      .tapAction(c.tap.toggle(kitchen))
      .actions(List(
        c.sliderAction(kitchen, c.tap.moreInfo(kitchen))
          .icon("mdi:information").active(false)
      ))
    local acts = row.children["head"][0].children["actions"]
    acts.length == 2
    // `tapAction` stays FIRST — it is the shorthand for the button this card
    // has always had, and adding a second must not move it.
    acts[0].slots["glyph"] == "mdi mdi-power"
    acts[1].slots["glyph"] == "mdi mdi-information"
    // They are ordinary `button`s — the shared round icon form, not a card of
    // this module's own. What the slider adds is only WHERE they sit.
    acts.toList().every((a) -> a.card == "button")
    acts.toList().every((a) -> a.slots["round"] == "1")
    // Each declares the guard, and the template names the node's own id — the
    // renderer fills `{{id}}` per node, which is what makes the two distinct.
    c.cards["button"].template.contains(#"data-indicator="_{{id}}__busy""#)
    // `active(false)` drops the class signal rather than binding a constant: a
    // button that does not mean "this entity is on" should not light up.
    acts[0].cell.classWhen.containsKey("fh-active")
    acts[1].cell == null
    // A popup action carries its OWN surfaces, so the popup hangs off the
    // button that opens it rather than off the slider.
    acts[1].inlineSurfaces != null
    row.inlineSurfaces == null
  }

  ["a slider with no actions still renders the strip, and the theme hides it"] {
    // A card is ONE shape: its optional pieces are absent, not different. The
    // strip is always in the markup and `:empty` is what removes it, the same
    // way `.slider-members:empty` handles a member-less group.
    local plain = c.entitySlider(kitchen)
    plain.children["head"][0].children["actions"].isEmpty
    c.cards["sliderHead"].template.contains(#"<div class="slider-actions">"#)
    c.cards["slider"].css.contains(".slider-actions:empty{display:none}")
  }

  ["the head is STRUCTURE, so nothing on it reads live as bytes"] {
    // The invariant the split exists to keep (#151). A region-holding card is
    // never a patch target, so a live bytes slot on it would never reach the
    // DOM — `Dashboard.validate` rejects one, and `core/node.pkl` constrains
    // `slots` so it fails in the author's editor first.
    local head = (c.entitySlider(kitchen)).children["head"][0]
    head.cardDef.regions.keys == Set("text", "actions")
    // Every live slot left on it carries a signal binding...
    head.slots.toMap().values
      .filter((v) -> v is slotMod.Slot && v.reads == "live")
      .every((v) -> v.signal != null)
    // ...and the label that stayed behind for the toggle's `aria-label` reads
    // `onRender`: right whenever the card is drawn, never a reason to draw it.
    head.slots["label"] is String || head.slots["label"].reads == "onRender"
  }

  // ---- the lock domain ----

  ["supportsOpen reads the one bit LockEntityFeature defines"] {
    // The whole of what typing a lock buys: `lock/open` releases a latch and is
    // NOT unlocking, and only the bitmask says whether this lock has one. A
    // card cannot see that; the schema can.
    latchLock.supportsOpen
    !plainLock.supportsOpen
  }

  ["a refused switch goes back, and says so where it can be seen"] {
    // Two halves of one report, and each was independently wrong.
    //
    // The LOOK: `fh-error` paints an outline, and the toggle put it on the
    // `<input>` — which BeerCSS hides behind a sibling `<span>` that draws the
    // track. An outline on an invisible element is an outline nobody sees, so
    // the class belongs on the card.
    //
    // The ROLLBACK: `checked` is two-way bound, so a press moves it at once and
    // waits for a state frame to confirm. A refusal produces NO state frame, so
    // an unrestored switch sits in the one position known to be wrong.
    local sw = c.toggle(kitchen)
    local t = c.cards["switch"].template
    // The look rides the card element, the mechanism the input.
    t.contains(#"<article class="card row toggle" "#)
    t.split("<label").first.contains("data-class:fh-error")
    t.split("<label").last.contains("data-on:datastar-fetch__document")
    // Truth lives on a SECOND signal the press cannot reach: same reading,
    // shared rather than node-scoped.
    sw.slots["switched"].transform == sw.slots["checked"].transform
    sw.slots["checked"].signal == "bind"
    sw.slots["switched"].signal == "attr:data-switched"
    // ...and the rollback copies one into the other, gated on the error signal.
    t.contains("data-on-signal-patch-filter=\"{include:/^_{{id}}__error$/}\"")
    t.contains("$_{{id}}__error && (${{checked__signal}} = ${{switched__signal}})")
  }

  ["an appliance with no programme length gets a countdown and NO bar"] {
    // The washer's real shape, measured on the live instance: it reports
    // `timetoend` and nothing to divide it BY. Inventing a denominator — the
    // highest reading seen this cycle, say — needs history this layer does not
    // have, and would be wrong on the first paint after a reload, which is
    // exactly when someone is looking.
    local washer = c.progress(remainingMin).status(applianceState)
    washer.slots.containsKey("left")
    washer.slots["hasLeft"] == "1"
    !washer.slots.containsKey("hasBar")
    !washer.slots.containsKey("total")
    // The status renders as the integration's own words, never interpreted:
    // nothing here knows which of them means "running".
    washer.slots["status"].entityId == "sensor.appliancestate"
  }

  ["a bar appears exactly when there is something to divide by"] {
    local dishwasher = c.progress(remainingMin).total(programMin)
    dishwasher.slots["hasBar"] == "1"
    dishwasher.slots["total"].entityId == "sensor.programduration"
    // The fill is a function of TWO entities, so it cannot be a transform: a
    // slot reads one entity. The guard is the substance — a `total` reading
    // `unknown` compares false, and the bar sits empty rather than painting
    // NaN%.
    local t = c.cards["progressCard"].template
    t.contains("{{#hasBar}}")
    t.contains("? Math.min(100, Math.max(0, 100 - 100 *")
    t.contains("> 0 ?")
  }

  ["the countdown carries the seconds its unit is worth"] {
    // The whole reason the schema derives `durationSeconds`: the same reading
    // is minutes here and seconds elsewhere, and a countdown scaled by a guess
    // runs sixty times fast.
    local d: simpleMod.SimpleValue = c.progress(remainingMin).slots["left"].transform!!
    d.op == "duration"
    d.params!!.toMap() == Map("scale", 60)
    local secs: hass.SensorEntity = new {
      entity_id = "sensor.secs"
      device_class = "duration"
      unit_of_measurement = "s"
    }
    (c.progress(secs).slots["left"].transform as simpleMod.SimpleValue)
      .params!!.toMap() == Map("scale", 1)
  }

  ["a duration that cannot be scaled renders no countdown at all"] {
    // Rather than a plausible wrong number. `durationSeconds` is null for a
    // unit with no fixed length, and the card drops the slot instead of
    // choosing a multiplier for "a month".
    local months: hass.SensorEntity = new {
      entity_id = "sensor.months"
      device_class = "duration"
      unit_of_measurement = "m"
    }
    !c.progress(months).slots.containsKey("left")
    !c.progress(months).slots.containsKey("hasLeft")
    // ...and it is still a card: the label survives.
    c.progress(months).slots.containsKey("label")
  }

  ["a state-dependent tap refuses the press while the entity is mid-move"] {
    // The bug this closes: a two-way `CallByState` has one branch and a
    // fallback, so every transitional state lands in the fallback — a lock read
    // as `unlocking` is not `locked`, so the tile posted `lock/lock` AGAINST
    // the unlock already running. The list is the DOMAIN's, so no author has to
    // know it.
    local tile = c.entityCard(latchLock)
    local inert: simpleMod.SimpleMatch = tile.slots["tapDisabled"].transform!!
    // `unavailable` rides with them but is NOT one of them — see the fact
    // below. The three transitional ones are the domain table's.
    inert.cases.toMap().keys.toList().sort()
      == List("locking", "opening", "unavailable", "unlocking")
    // `open` and `jammed` are NOT here: locking an open door and retrying a jam
    // are both meaningful presses, and only a transitional state is not.
    !inert.cases.toMap().containsKey("open")
    !inert.cases.toMap().containsKey("jammed")
    // Read, not bound: every host shows it its own way — this `<article>` as
    // the `fh-disabled` look through the guard, since only a form control can
    // be disabled.
    tile.slots["tapDisabled"].signal == "handler"
    c.cards["tile"].template.contains("{{#tapDisabled}} fh-disabled{{/tapDisabled}}")
  }

  ["a tap that names its target needs no entity on the card"] {
    local b = c.button("Kjøkken", c.tap.toggle(kitchen))
    !b.slots.containsKey("entity_id")
    b.slots["service"] == "light/toggle"
    b.slots["targetId"] == kitchen.entity_id
    // Availability is the TARGET's, so the refusal reads it by name.
    (b.slots["tapDisabled"] as slotMod.Slot).entityId == kitchen.entity_id
  }

  ["a state-picked service reads the target, not the card's entity"] {
    // A card showing the kitchen light whose tap works the front lock: both the
    // service the lock's state picks and its mid-move inert read the LOCK.
    local b = c.entityButton(kitchen).label("Lås").tapAction(c.tap.toggle(frontLock))
    local svc: slotMod.Slot = b.slots["service"]
    svc.entityId == frontLock.entity_id
    b.slots["targetId"] == frontLock.entity_id
    (b.slots["tapDisabled"] as slotMod.Slot).entityId == frontLock.entity_id
    b.slots["entity_id"] == kitchen.entity_id
  }

  ["an area tap has no state to be inert on"] {
    local b = c.button("Stue av", c.tap.call("light/turn_off", stue))
    b.slots["targetKind"] == "area"
    b.slots["targetId"] == stue.area_id
    !b.slots.containsKey("tapDisabled")
  }

  ["a typed verb is `call` with the service filled in"] {
    c.tap.lights.off(stue) == c.tap.call("light/turn_off", stue)
    c.tap.lights.toggle(kitchen) == c.tap.call("light/toggle", kitchen)
    // The entity card's default, spelled for any card: the domain's service, or
    // more-info where there is none.
    c.tap.default(kitchen) == c.tap.toggle(kitchen)
    c.tap.default(outside).inlineSurfaces != null
  }

  ["a value-carrying tap is the same call with one more segment"] {
    // Not a second route builder: `serviceClick` covers both, and a tap with no
    // value declares no `dataKey`, so the section closes over nothing.
    local plain = c.tap.call("light/turn_on", kitchen)
    plain.service == "light/turn_on"
    plain.dataKey == null
    local valued = c.tap.call("light/turn_on", kitchen).with("effect", "Color loop")
    valued.service == "light/turn_on"
    valued.target == kitchen
    valued.dataKey == "effect"
    // PERCENT-ENCODED for the two characters that break the two contexts the
    // value passes through: a space is invalid in a path segment, and a `'`
    // would close the JS string the URL sits in — Mustache escapes it to
    // `&#39;`, which the browser decodes back to `'` BEFORE the expression is
    // parsed, so the attribute escape cannot save it.
    valued.dataValue == "Color%20loop"
    c.tap.call("a/b", kitchen).with("k", "it's").dataValue == "it%27s"
  }

  ["a SERVICE tap is inert on a dead entity, whatever its domain"] {
    // Availability is a different axis from transitional state: HA rejects a
    // service call on an unavailable entity in EVERY domain, so it is one rule
    // rather than a row per domain or per verb (`Call.disabledWhile`).
    local lit: simpleMod.SimpleMatch =
      c.entityCard(kitchen).slots["tapDisabled"].transform!!
    // `light/toggle` means the same thing in every state, so nothing
    // transitional — and `unavailable` all the same.
    lit.cases.toMap().keys.toList() == List("unavailable")
  }

  ["a tap that calls NO service stays live on a dead entity"] {
    // More-info is exactly what you want to open on an unavailable entity: it
    // is where the reason is. A navigate does not care either.
    !c.entityCard(outside).slots.containsKey("tapDisabled")
    !c.button("Go", c.tap.navigate("other")).slots.containsKey("tapDisabled")
  }

  ["a typed lock still taps by state, like any other lock"] {
    // Typing the domain must not change what the generic tile does with it —
    // the capability is additive (ADR 0016 owns the tap).
    (c.entityCard(latchLock).slots["service"].transform as simpleMod.SimpleMatch)
      .otherwise == "lock/lock"
  }

  ["a lock that can open its latch gets a second control; one that cannot does not"] {
    // The whole of what `c.lock.controls` decides. A lock's tile is the generic
    // one — the composition exists for the capability the generic card cannot
    // see.
    local withLatch = c.lock.controls(latchLock)
    withLatch.card == "cardFeatures"
    withLatch.children["content"].toList().map((n) -> n.card) == List("tile")
    // The latch is a SIBLING of the tile, not a child of it: inside the
    // tappable element, one press would post `lock/open` and the tile's own
    // `lock/lock` together.
    withLatch.children["actions"].toList().map((n) -> n.card) == List("button")
    // No capability, no wrapper — a plain lock is the generic tile and nothing
    // more.
    c.lock.controls(plainLock).card == "tile"
  }

  ["the latch ASKS before it opens; the confirmation is what posts lock/open"] {
    local latch = c.lock.openLatch(latchLock)
    // The latch itself calls nothing — it opens an inline confirmation, which
    // is the whole point: releasing a latch opens a door.
    latch.inlineSurfaces != null
    !latch.slots.containsKey("service")
    // …and `lock/open` lives inside it, aimed at the lock by its own target.
    local body = latch.inlineSurfaces!!["self"].content.children.toList().first
    local press = body.children.toList()
      .filter((n) -> n.card == "button" && n.slots.containsKey("service"))
      .first
    press.slots["service"] == "lock/open"
    press.slots["targetId"] == "lock.latch"
    // …and it is THAT press availability guards, not the latch that opens the
    // dialog: a service tap is inert on a dead entity in every domain, so
    // `CANNOT_OPEN` never had to carry `unavailable` and now cannot.
    (press.slots["tapDisabled"].transform as simpleMod.SimpleMatch)
      .cases.toMap().containsKey("unavailable")
    // The tile beside it still locks/unlocks by state — the two controls are
    // different actions, not two spellings of one.
    (c.entityCard(latchLock).slots["service"].transform as simpleMod.SimpleMatch)
      .cases.toMap() == Map("locked", "lock/unlock")
  }

  ["the latch is inert while the lock is mid-move — which the busy guard cannot see"] {
    local latch = c.lock.openLatch(latchLock)
    // The OPENER's own reason: it opens a popup, so it has no call to carry one.
    local inert: simpleMod.SimpleMatch = latch.slots["disabled"].transform!!
    latch.slots["disabled"].entityId == "lock.latch"
    // HA's `canOpen`, and ONLY that: already open, or mid-move. Every arm
    // answers the same `true` — a set membership test, which is what one
    // `match` buys over the two-armed enum it replaced, and what `stateIn`
    // spells.
    //
    // No `unavailable`. It is not a lock STATE — `hass/lock.pkl` types the list
    // as `LockState`, which refuses it — and the press it guards is protected
    // anyway: the confirmation's own `lock/open` button is a service tap, so
    // `tap.refusedStates` disables THAT on a dead lock. Opening the dialog to be
    // told why is better than a dead button that cannot say.
    inert.cases.toMap().keys.toList().sort()
      == List("locking", "open", "opening", "unlocking")
    inert.cases.toMap().values.toSet() == Set(true)
    // A real `false`, which is the ONLY value that turns a boolean attribute
    // off: `""` would SET `disabled`, because `disabled=""` is how HTML spells
    // ON. That is why the button's one `data-attr:disabled` can read it (ADR 0017).
    inert.otherwise == false
    latch.slots["disabled"].signal == "handler"
  }

  ["every card that sends openLatch refuses HA's canOpen states, not only the one it was written for"] {
    // The refusal rides the CALL, so the property is about the call, whatever
    // carries it. On one card it guards only that card: on the opener alone,
    // the press inside — the one that posts `lock/open` — refused only a dead
    // lock.
    local press = c.tap.locks.openLatch(latchLock)
    local confirm = c.lock.openLatch(latchLock).inlineSurfaces!!["self"].content
      .children.toList().first.children.toList()
      .filter((n) -> n.card == "button" && n.slots.containsKey("service"))
      .first
    local senders = List(
      confirm,
      c.button("Open", press),
      c.pill("Open", press),
      c.iconButton("mdi:door-open", press),
      c.entityButton(latchLock).tapAction(press),
      c.entityCard(latchLock).tapAction(press),
      c.toggle(latchLock).tapAction(press)
    )
    senders.every((n) -> n.slots["service"] == "lock/open")
    senders.every((n) ->
      let (refused = (n.slots["tapDisabled"].transform as simpleMod.SimpleMatch).cases.toMap().keys)
        Set("open", "opening", "unlocking", "locking", "unavailable").every((s) -> refused.contains(s)))
    senders.every((n) -> n.slots["tapDisabled"].entityId == "lock.latch")
  }

  ["every slider refuses to post while its target is unavailable, and only then"] {
    // The commit used to build its route beside `tapRoute`, so it alone carried
    // no refusal and an unavailable cover still got the post. The property is
    // about every row a slider can draw: each axis, and the toggle-only track.
    local switchOnly: hass.LightEntity = new { entity_id = "light.porch"; colourModes { "onoff" } }
    local blind: hass.GenericEntity = new { entity_id = "cover.blind"; domain = "cover" }
    local vent: hass.GenericEntity = new { entity_id = "fan.vent"; domain = "fan" }
    local warmth = new hass.ColourTemp { owner = dimmer; min_kelvin = 2000; max_kelvin = 6500 }
    local rows = List(c.entitySlider(kitchen), c.entitySlider(dimmer), c.entitySlider(warmth), c.entitySlider(blind), c.entitySlider(vent), c.entitySlider(switchOnly))
    rows.every((s) -> s.headSlots.containsKey("service"))
    rows.every((s) ->
      (s.headSlots["tapDisabled"].transform as simpleMod.SimpleMatch).cases.toMap().keys == Set("unavailable"))
    rows.every((s) -> s.headSlots["tapDisabled"].entityId == s.entity.entity_id)
    // The value is the drag's, so the route carries the key and no value.
    rows.filter((s) -> !s.toggleOnly).every((s) -> s.headSlots.containsKey("dataKey") && !s.headSlots.containsKey("dataValue"))
    // The input is disabled by the refusal as well as by its own commit, and
    // the change handler leads with the refusal guard.
    local head = c.cards["sliderHead"].template
    head.contains(#"data-attr:disabled="$_{{id}}__busy_change"# + tapMod.whenRefusable(" || " + tapMod.refused) + "\"")
    head.contains(#"data-on:change=""# + tapMod.refusalGuard + #"$_{{id}}__busy_change ? '' : @post("#)
    // The refusal is the tap's OR the card's own `disabled`, whichever a node
    // carries — so the same guard stops a slider its author disabled.
    tapMod.refused.contains("{{{tapDisabled__read}}}") && tapMod.refused.contains("{{{disabled__read}}}")
    c.entitySlider(kitchen).disabled(c.isOn(kitchen)).headSlots.containsKey("disabled")
    !c.entitySlider(kitchen).headSlots.containsKey("disabled")
  }

  ["a chart stage's params are typed on the wire, and an unset one is absent"] {
    // The JSON `ChartStyleSuite` decodes: a number, not a string, and no null.
    new JsonRenderer { omitNullProperties = true; indent = "" }
      .renderValue(historyMod.chartStage(320, null, "°C"))
      == #"{"stage":"chart","params":{"width":320,"unit":"°C"}}"#
  }
}
