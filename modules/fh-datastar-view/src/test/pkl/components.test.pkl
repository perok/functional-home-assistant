/// Unit tests for the `@fh-dashboard` authoring library, run by `pkl test`.
///
/// These live OUTSIDE `lib/` on purpose: `LibPackage` packages that directory
/// into the content-versioned `@fh-dashboard` cache package, so a test module
/// in there would change the package hash and re-evaluate every dashboard.
/// Imports are therefore relative file paths, not `@fh-dashboard/...`.
amends "pkl:test"

import "../../main/resources/dashboards/lib/components.pkl" as c
import "../../main/resources/dashboards/lib/core/node.pkl" as nodes
import "../../main/resources/dashboards/lib/core/css.pkl" as cssMod
import "../../main/resources/dashboards/lib/query.pkl" as q
import "../../main/resources/dashboards/lib/hass.pkl" as hass

local kitchen: hass.LightEntity = new { entity_id = "light.kitchen" }
local dimmer: hass.LightEntity = new {
  entity_id = "light.dimmer"
  colourModes { "brightness" }
}
local outside: hass.SensorEntity = new { entity_id = "sensor.outside" }
// Default-tap fixtures (#106): a domain HA can toggle, one whose service the
// state picks, one that only presses, and one with no action at all.
local frontLock: hass.GenericEntity = new { entity_id = "lock.front"; domain = "lock" }
local doorbell: hass.GenericEntity = new { entity_id = "button.doorbell"; domain = "button" }

// Icon fixtures, shaped as PklDump generates them: a capability attribute lives
// on the class generated PER ENTITY, never on the domain class (ADR 0013), so a
// test that just sets `icon = ...` on a `hass.LightEntity` is testing a shape
// the dump never produces.
local class E_with_icon extends hass.LightEntity {
  icon: String = "mdi:ceiling-light"
  device_class: String = "running"
}
local class E_temp extends hass.SensorEntity { device_class: String = "temperature" }
local class E_custom_icon extends hass.LightEntity { icon: String = "hue:bulb-sultan" }

// D1 helpers: there are no shared tables any more, so "how many distinct shapes
// / conditions" is a question you ask of the members.
local allClauses = (s) -> s.members.values.flatMap((m) -> m.clauses)
local cards = (s) -> allClauses.apply(s).map((c) -> c.node.card).distinct
local conds = (s) -> allClauses.apply(s).map((c) -> c.`when`).distinct
local firstNode = (s) -> s.members.values.first.clauses.first.node

facts {
  // The predicate vocabulary lives in `query.pkl` now: there are no free
  // constructors, so every term carries a binding by construction (a set's
  // candidate, or the entity `q.entity` names). These pin the PROPERTY NAMES
  // the runtime reads — `state`, `attr:<name>`, `domain` — which is the part
  // the two sides have to agree on.
  ["a term carries the property name the runtime reads"] {
    local st = q.entity(kitchen).stateIs("on")
    st.property == "state"
    st.op == "eq"
    st.entity == "light.kitchen"

    q.entity(kitchen).lt(q.prop("brightness"), 20).property == "attr:brightness"
    q.entity(kitchen).lt(q.prop("brightness"), 20).op == "lt"
  }

  ["a numeric threshold stays a number, not a string"] {
    q.entity(kitchen).lt(q.prop("brightness"), 20).value is Int
  }

  ["combinators nest without rebinding `this` to the new object"] {
    // The Pkl trap this pins: a bare `this` inside a `new {}` body rebinds to
    // the object being built, so `and`/`or`/`not` must capture the receiver
    // first. Silent when broken — the term comes out referring to itself.
    local a = q.entity(kitchen).stateIs("on")
    local b = q.entity(kitchen).lt(q.prop("brightness"), 20)
    a.and(b).items.toList().length == 2
    a.and(b).items.toList()[0].property == "state"
    a.or(b).kind == "or"
    a.not().item.property == "state"
    a.not().kind == "not"
  }

  // ---- entity icons -----------------------------------------------------------
  // Resolved at BUILD time, in Home Assistant's own precedence: the entity's own
  // `icon` beats its device_class, which beats its domain. All three are
  // registry facts, so the slot is a LITERAL — it used to be a
  // `$lookup($domain)` JSONata transform on every card.

  ["an entity's OWN icon wins, as the MDI class"] {
    // Its own icon wins over the `running` device_class it also carries.
    c.entityCard(new E_with_icon { entity_id = "light.k" }).slots["icon"]
      == "mdi-ceiling-light"
  }

  ["device_class beats the domain, so a temperature sensor is not a generic one"] {
    local plain: hass.SensorEntity = new { entity_id = "sensor.p" }
    c.entityCard(new E_temp { entity_id = "sensor.t" }).slots["icon"] == "mdi-thermometer"
    // No device_class at all -> the domain default, and no eval error for
    // reading a property this entity does not have.
    c.entityCard(plain).slots["icon"] == "mdi-eye"
  }

  ["a NON-mdi icon set falls through, rather than emitting a dead class"] {
    // Six entities on the reference instance carry `hue:` icons from a HACS
    // integration whose glyphs we do not ship. A class the stylesheet does not
    // define renders as blank space, which is visibly worse than the default.
    c.entityCard(new E_custom_icon { entity_id = "light.h" }).slots["icon"]
      == "mdi-lightbulb"
  }

  ["an unknown domain emits NO icon slot, so the header renders none"] {
    local odd: hass.GenericEntity = new {
      entity_id = "wibble.x"
      domain = "wibble"
    }
    !c.entityCard(odd).slots.containsKey("icon")
  }

  ["an author override takes either spelling"] {
    local e: hass.LightEntity = new { entity_id = "light.k" }
    c.entityCard(e).icon("mdi:fridge").slots["icon"] == "mdi-fridge"
    c.entityCard(e).icon("mdi-fridge").slots["icon"] == "mdi-fridge"
  }

  ["a node has no cell until a layout builder adds one"] {
    c.title("Lights").cell == null
  }

  ["layout builders put fh- contract classes on the wrapper"] {
    c.title("x").columns(3).cell.classes.toList() == List("fh-cols-3")
    c.title("x").fullWidth().cell.classes.toList() == List("fh-cols-full")
    c.title("x").hug().cell.classes.toList() == List("fh-hug")
    c.title("x").cellClass("my-thing").cell.classes.toList() == List("my-thing")
  }

  ["ONE SPAN PER NODE: a later fh-cols-* drops the earlier one"] {
    c.title("x").columns(3).columns(7).cell.classes.toList() == List("fh-cols-7")
    c.title("x").columns(3).fullWidth().cell.classes.toList() == List("fh-cols-full")
    // a non-span class is additive, not a replacement
    c.title("x").columns(3).hug().cell.classes.toList() == List("fh-cols-3", "fh-hug")
  }

  // ---- more-info (#106) ----
  // The popup a tap opens for an entity nothing can be DONE to: what we know
  // about it, live. Its body is per-entity, hence inline rather than registered.

  ["more-info is an inline popup, so every entity's body is its own surface"] {
    local t = c.moreInfo(kitchen)
    t.inlineSurfaces.containsKey("self")
    t.onclick.contains("sse/surface/open/\(nodes.NODE_ID)_self")
  }

  ["the body is the entity, then the controls its domain has, then its facts"] {
    local body = c.moreInfo(dimmer).inlineSurfaces["self"].content.children[0]
    body.children.toList().map((n) -> n.card)
      == List("entityCard", "fhcol", "entityInfo", "button")
  }

  ["a domain with no controls still shows the card and the facts"] {
    // The property the default flip will rest on: there is no entity for which
    // this popup is empty.
    local body = c.moreInfo(outside).inlineSurfaces["self"].content.children[0]
    body.children.toList().map((n) -> n.card)
      == List("entityCard", "entityInfo", "button")
  }

  ["the facts card names its subject and reads every attribute live"] {
    local info = c.entityInfo(kitchen)
    info.slots["entity_id"] == "light.kitchen"
    info.slots["attributes"].transform.contains("$each($attr")
    // No attributes evaluates to null, which this default renders as an absent
    // block rather than the word "null".
    info.slots["attributes"].default == ""
  }

  // ---- the default tap (#106) ----
  // Every card is clickable by a default derived from its OWN entity. The
  // build-time half is the point: what used to be one `$lookup($domain)`
  // transform per card is now a literal, and — the part a lookup could not
  // express — sometimes no action at all.

  ["a domain with a real toggle gets a LITERAL route, not a runtime lookup"] {
    local onclick = c.entityCard(kitchen).slots["onclick"]
    onclick.transform.contains("light/toggle")
    !onclick.transform.contains("$lookup")
    !onclick.transform.contains("$domain")
    // Identity-derived, so it stays in the renderer's identity cache.
    onclick.reactive == false
  }

  ["a one-shot domain presses instead of toggling"] {
    c.entityCard(doorbell).slots["onclick"].transform.contains("button/press")
  }

  ["a lock's service is the one thing the STATE has to decide"] {
    local onclick = c.entityCard(frontLock).slots["onclick"]
    onclick.transform.contains(#"$state = "locked" ? "lock/unlock" : "lock/lock""#)
    // The whole reason this slot is live — and the only tap shape that is.
    onclick.reactive == true
  }

  ["a domain with NO action falls back to more-info, so nothing is dead"] {
    local card = c.entityCard(outside)
    // Still tappable — but it opens the popup rather than posting a service
    // call HA would reject. This is the flip the more-info work gated.
    card.slots["tappable"] == "1"
    card.inlineSurfaces.containsKey("self")
    !card.slots["onclick"].contains("sse/action")
  }

  ["the more-info body's own card does NOT default to more-info"] {
    // Silent when broken, and fatal: `defaultTap` on a non-actionable entity
    // is `moreInfo(e)`, whose body builds this very card — an infinite regress
    // that laziness does not stop, because `slots` forces the tap.
    local body = c.moreInfo(outside).inlineSurfaces["self"].content.children[0]
    body.children.toList().first.inlineSurfaces == null
  }

  ["`tapAction = null` is how a card opts out of being clickable at all"] {
    local card = (c.entityCard(outside)) { tapAction = null }
    !card.slots.containsKey("tappable")
    !card.slots.containsKey("onclick")
  }

  ["a pressable card with nothing to press is a BUILD error"] {
    // The amend form is the one that could reach it: the factories take an
    // action, so only `new c.Button { label = ... }` leaves both unset. It used
    // to post `homeassistant/toggle` with an empty entity id.
    // `slots["onclick"]` and not `slots`: reading the object does not force its
    // entries, so a `catch` over the bare `slots` sees no error at all.
    module.catch(() -> (new c.Button { label = "x" }).slots["onclick"])
      .contains("nothing happens on click")
    // A toggle whose domain cannot be toggled is the same mistake.
    module.catch(() -> c.toggle(outside).slots["onclick"]).contains("nothing happens on click")
  }

  // ---- CSS ownership (ADR 0020) ----

  ["the base CSS carries the layout contract and the variables cards read"] {
    // It is a dashboard property, not a theme one, so this is what every
    // dashboard gets whatever look it wears.
    cssMod.baseCss.contains(".fh-grid{display:flex")
    cssMod.baseCss.contains(".fh-cols-12{")
    cssMod.baseCss.contains("--fh-text-dim:var(--secondary-text-color)")
    // The classes the RUNTIME emits, which no card owns.
    cssMod.baseCss.contains(".fh-toast{")
    cssMod.baseCss.contains(".fh-disabled{opacity:.5}")
  }

  ["a card's structure travels with the card"] {
    // The registry is what the renderer concatenates, so the assertion is on
    // the registry rather than on the class: a card whose `css` never reaches
    // it renders unstyled.
    local cards = c.cards
    cards["slider"].css.contains(".slider-head{display:flex")
    cards["entityCard"].css.contains(".card.tappable{cursor:pointer}")
    cards["entityInfo"].css.contains(".entity-info-attrs{")
    cards["popup"].css.contains("dialog.popup{")
    cards["tabs"].css.contains(".tab-panel{display:contents}")
    // Colour goes through the `--fh-*` contract, never a framework's own role
    // name — that is what makes a card portable to another theme.
    !cards["slider"].css.contains("--surface-container")
    !cards["slider"].css.contains("var(--primary)")
  }

  ["a theme's own class names reach card markup through the registry"] {
    // The one channel a theme has into a template (`cardsWith`, called by
    // entry.pkl with `theme.classes`): the spinner's class is BeerCSS's under
    // the BeerCSS theme...
    local beer = c.cardsWith(c.modules, new Mapping { ["busySpin"] = "shape loading-indicator" })
    beer["entityCard"].template.contains(#"data-class:shape="$_{{id}}__busy_slow""#)
    beer["entityCard"].template.contains(#"data-class:loading-indicator="$_{{id}}__busy_slow""#)
    // ...and the framework-free fallback otherwise. No hole survives either way.
    local plain = c.cards
    plain["entityCard"].template.contains(#"data-class:fh-busy-spin="$_{{id}}__busy_slow""#)
    !plain["entityCard"].template.contains("@@CLASSBIND")
    !beer["entityCard"].template.contains("@@CLASSBIND")
    // The slider binds its own commit signal, in `self` rather than `template`.
    beer["slider"].self.contains(#"data-class:shape="$_{{id}}__busy_change_slow""#)
  }

  ["a theme that names no spinner binds nothing at all"] {
    local none = c.cardsWith(c.modules, new Mapping {})
    !none["entityCard"].template.contains("data-class:fh-busy-spin")
    !none["entityCard"].template.contains("@@CLASSBIND")
    // The guard and its immediate dim are NOT a theme's to decline.
    none["entityCard"].template.contains("data-class:fh-disabled")
  }

  ["`informative` reads the card's OWN entity"] {
    // The amend-scoping trap, and silent when broken: a mixin resolving the
    // entity anywhere but on the card it is applied to opens the wrong popup.
    local card = (c.entityCard(kitchen)) |> c.informative
    card.inlineSurfaces["self"].content.children[0].children[0]
      .slots["entity_id"] == "light.kitchen"
  }
}
