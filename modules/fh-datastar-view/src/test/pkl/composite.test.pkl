/// SPIKE — COMPOSITE members: a member that renders a subtree, and a member that
/// is not an entity at all and contains a nested set ("a tile per room").
///
/// The structural finding this file pins: a nested set can NEVER live in a
/// shared shape, because two areas never hold the same lights. It has to be
/// per-member data — which turns out to be the SAME rule that decides slot vs
/// var, applied one level down. A child position that differs across the members
/// sharing a shape becomes a `Hole`, and the member fills it.
amends "pkl:test"

import "dynamics/query.pkl" as q
import "dynamics/wire.pkl"
import "dynamics/fixtures.pkl"

local slider = (e) -> new wire.Node {
  card = "slider"
  slots = Map("label", new wire.Lit { literal = e.friendly_name })
}

/// (a) A member rendering a SUBTREE: the candidate is still an entity, the
/// rendering just is not a leaf.
local detailCard = (e) -> new wire.Node {
  card = "col"
  slots = Map()
  children = List(
    new wire.Node { card = "title"; slots = Map("text", new wire.Lit { literal = e.friendly_name }) },
    new wire.Node { card = "slider"; slots = Map("label", new wire.Lit { literal = e.friendly_name }) })
}

/// (b) A TILE PER ROOM: the candidate is an AREA, and the subtree contains a
/// whole set over that area's lights.
local roomTile = (a) -> new wire.Node {
  card = "card"
  slots = Map("title", new wire.Lit { literal = a.name })
  children = List(
    q.from(a.lights).where(q.eq(q.stateProp, "on")).render(slider).build())
}

facts {
  // (a) — a subtree whose leaves all vary. Every child differs per member, so
  // every child position becomes a hole.
  ["C1 a member can render a subtree"] {
    local s = q.from(fixtures.all)
      .where(q.eq(q.prop("domain"), "light"))
      .render(detailCard)
      .build()

    s.shapes.length == 1
    s.shapes.first.card == "col"
    // both children vary (each embeds the entity's own name), so both are holes
    s.shapes.first.children.length == 2
    s.shapes.first.children.every((c) -> c is wire.Hole)
    s.members["light.taklys"].clauses.first.fills.length == 2
    (s.members["light.taklys"].clauses.first.fills[0] as wire.Node).card == "title"
  }

  // A child that is the SAME for everyone stays in the shape rather than
  // becoming a hole — the compression still applies one level down.
  ["C2 an invariant child stays in the shape"] {
    local withStatic = (e) -> new wire.Node {
      card = "col"
      slots = Map()
      children = List(
        new wire.Node { card = "divider"; slots = Map() },          // same for all
        new wire.Node { card = "slider";                             // varies
                        slots = Map("label", new wire.Lit { literal = e.friendly_name }) })
    }
    local s = q.from(fixtures.all).where(q.eq(q.prop("domain"), "light"))
      .render(withStatic).build()

    !(s.shapes.first.children[0] is wire.Hole)
    (s.shapes.first.children[0] as wire.Node).card == "divider"
    s.shapes.first.children[1] is wire.Hole
    s.members["light.taklys"].clauses.first.fills.length == 1
  }

  // (b) — THE TILE PER ROOM. Areas are candidates; each tile holds a set over
  // its own lights.
  ["C3 a tile per room: the candidate is an area, the child is a nested set"] {
    local s = q.from(fixtures.areas).render(roomTile).build()

    s.candidates == List("area.stue", "area.kjokken", "area.bod")
    // one shape for all three tiles — the skeleton compresses...
    s.shapes.length == 1
    s.shapes.first.card == "card"
    // ...the title varies, so it is a var
    s.members["area.stue"].clauses.first.vars["title"] == "Stue"
    s.members["area.kjokken"].clauses.first.vars["title"] == "Kjøkken"
    // ...and the nested set varies, so it is a hole filled per member
    s.shapes.first.children[0] is wire.Hole
    s.members["area.stue"].clauses.first.fills[0] is wire.SetNode
  }

  ["C4 each tile's nested set has its OWN candidates"] {
    local s = q.from(fixtures.areas).render(roomTile).build()
    local inner = (id: String) -> s.members[id].clauses.first.fills[0] as wire.SetNode

    (inner.apply("area.stue")).candidates ==
      List("light.taklys", "light.lampe", "light.spot")
    (inner.apply("area.kjokken")).candidates == List("light.kjokken")
    // an empty room yields an empty set, not an error
    (inner.apply("area.bod")).candidates == List()
  }

  ["C5 the nested set keeps its own conditions and shapes"] {
    local s = q.from(fixtures.areas).render(roomTile).build()
    local stue = s.members["area.stue"].clauses.first.fills[0] as wire.SetNode

    // the inner set defers on state, exactly as it would standalone
    stue.conditions.length == 2
    (stue.conditions[1] as wire.Bound).property == "state"
    stue.shapes.length == 1
    stue.members["light.taklys"].clauses.first.vars["label"] == "Taklys"
  }

  // An empty room can be dropped at BUILD time, because `lights` is registry
  // data. Hiding a room when none of its lights are ON is a different problem —
  // that needs an aggregate over the inner set, which is not designed yet.
  ["C6 an empty room is droppable statically, without aggregates"] {
    local s = q.from(fixtures.areas)
      .where(q.candidate((a) -> a.lights.length > 0))
      .render(roomTile)
      .build()

    s.candidates == List("area.stue", "area.kjokken")
    !s.candidates.contains("area.bod")
  }

  // AGGREGATES. The reduction that makes these cheap: an aggregate counts the
  // PRESENT members of a set, and presence is already per-member and already
  // computed. So `count` needs no predicate machinery of its own, and
  // any/none/all are three comparisons rather than three quantifiers.
  ["C7 count is a comparison, and any/none/all derive from it"] {
    local onLights = q.from(fixtures.stue.lights).where(q.eq(q.stateProp, "on"))

    onLights.count().gt(2) is wire.AggCmp
    (onLights.count().gt(2) as wire.AggCmp).agg.op == "count"
    // any/none are the same aggregate, compared differently — no Quantifier
    (onLights.any() as wire.AggCmp).op == "gt"
    (onLights.any() as wire.AggCmp).value == 0
    (onLights.none() as wire.AggCmp).op == "eq"
    (onLights.none() as wire.AggCmp).value == 0
    // the aggregate carries the set it counts, so the runtime needs no lookup
    (onLights.any() as wire.AggCmp).agg.over.candidates.length == 3
  }

  // The live half of the tile-per-room case, which is what aggregates were
  // blocking: hide the room while none of its lights are on.
  ["C8 hide a room while none of its lights are on"] {
    local roomsWithLightOn = q.from(fixtures.areas)
      .where(q.candidate((a) ->
        q.from((a as fixtures.Area).lights).where(q.eq(q.stateProp, "on")).any()))
      .render(roomTile)
      .build()

    // the empty room is gone at BUILD time — an empty set can never be non-empty
    !roomsWithLightOn.candidates.contains("area.bod")
    // the others defer: each carries an aggregate over its OWN lights
    local stueCond = roomsWithLightOn.conditions[
      roomsWithLightOn.members["area.stue"].clauses.first.cond] as wire.AggCmp
    stueCond.agg.over.candidates.length == 3
    local kjokkenCond = roomsWithLightOn.conditions[
      roomsWithLightOn.members["area.kjokken"].clauses.first.cond] as wire.AggCmp
    kjokkenCond.agg.over.candidates.length == 1
  }

  // LIMIT. A third member state — present-but-cut — distinct from absent.
  // Applied after ordering, so "the three brightest" is well defined.
  ["C9 limit: the three brightest"] {
    local s = q.from(fixtures.all)
      .where(q.eq(q.prop("domain"), "light"))
      .orderBy(q.desc(q.prop("brightness")))
      .limit(3)
      .render(slider)
      .build()

    s.limit == 3
    // every candidate still ships — which of them is cut is a runtime decision,
    // because it depends on the live ordering
    s.candidates.length == 4
  }

  ["C10 no limit means no cap on the wire"] {
    q.from(fixtures.stue.lights).render(slider).build().limit == null
  }

  // THE SAME ENTITY IN TWO SETS. The id scheme says a member is identified by
  // (set, entity) rather than by entity alone. These pin what the WIRE must
  // carry for that to be derivable — because if the format were ambiguous here,
  // the backend could not assign distinct ids no matter how it walked.
  ["C11 two sets over the same entity keep independent members"] {
    local asSlider = (e) -> new wire.Node {
      card = "slider"
      slots = Map("label", new wire.Lit { literal = e.friendly_name })
    }
    local asRow = (e) -> new wire.Node {
      card = "row"
      slots = Map("caption", new wire.Lit { literal = "in \((e as fixtures.Ent).area_id)" })
    }

    // taklys is a candidate of BOTH, rendered differently and gated differently
    local a = q.from(fixtures.stue.lights).render(asSlider).build()
    local b = q.from(fixtures.stue.lights).where(q.eq(q.stateProp, "on")).render(asRow).build()

    a.candidates.contains("light.taklys")
    b.candidates.contains("light.taklys")

    // each set carries its OWN member entry — nothing is shared or merged
    a.members["light.taklys"].clauses.first.vars["label"] == "Taklys"
    b.members["light.taklys"].clauses.first.vars["caption"] == "in stue"
    // and its own conditions: a is unconditional, b defers on state
    a.conditions[a.members["light.taklys"].clauses.first.cond] == null
    b.conditions[b.members["light.taklys"].clauses.first.cond] != null
  }

  // The nastier version: the same entity in an outer set AND in a nested set
  // inside one of that outer set's own members.
  ["C12 the same entity nested inside a set that already holds it"] {
    local nesting = (e) -> new wire.Node {
      card = "col"
      slots = Map("label", new wire.Lit { literal = e.friendly_name })
      children = List(
        q.from(fixtures.stue.lights).where(q.eq(q.stateProp, "on")).render(slider).build())
    }
    local s = q.from(fixtures.stue.lights).render(nesting).build()

    // taklys is an outer member...
    s.candidates.contains("light.taklys")
    // ...and also a candidate of the set nested inside its OWN member
    local inner = s.members["light.taklys"].clauses.first.fills.first as wire.SetNode
    inner.candidates.contains("light.taklys")
    // the two are distinct entries in distinct SetNodes, so (set, entity)
    // separates them; entity alone would collide
    inner.members["light.taklys"].clauses.first.vars["label"] == "Taklys"
  }

  // What the format does NOT carry, deliberately: a set has no id of its own.
  // Identity comes from CONTAINMENT — a set is reached either as a node in the
  // layout tree or as a member's fill, and that path is what the backend keys
  // on. This asserts the containment is unambiguous: every nested set is
  // reachable by exactly one (member, hole) route.
  ["C13 a set carries no id — containment supplies it"] {
    local s = q.from(fixtures.areas).render(roomTile).build()

    // each area's inner set is reachable only through THAT member's fill
    s.members.toMap().every((id, m) ->
      m.clauses.length == 1 && m.clauses.first.fills.length == 1)
    // and the shape holds a hole, not the set — so no set is duplicated between
    // the shared shape and a member
    s.shapes.first.children.every((c) -> c is wire.Hole)
  }
}

local function asJson(v: Any): String = new JsonRenderer { indent = "  " }.renderValue(v)

examples {
  ["C3 a tile per room"] {
    asJson(q.from(fixtures.areas).render(roomTile).build())
  }
}
