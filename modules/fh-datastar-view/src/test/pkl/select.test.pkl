/// `c.select`: one value for a target, in a style. Outside `lib/` for the
/// reason `components.test.pkl` gives.
amends "pkl:test"

import "../../main/resources/dashboards/lib/components.pkl" as c
import "../../main/resources/dashboards/lib/core/slot.pkl" as slotMod
import "../../main/resources/dashboards/lib/core/choice.pkl" as choiceMod
import "../../main/resources/dashboards/lib/core/group.pkl" as groupMod
import "../../main/resources/dashboards/lib/core/tap.pkl" as tapMod
import "../../main/resources/dashboards/lib/hass.pkl" as hass
import "../../main/resources/dashboards/lib/components/select.pkl" as selectMod
import "../../main/resources/dashboards/lib/components/base/button.pkl" as buttonMod
import "../../main/resources/dashboards/lib/core/node.pkl" as nodeMod
import "../../main/resources/dashboards/lib/core/predicate.pkl" as predMod
import "../../main/resources/dashboards/lib/core/simple.pkl" as simpleMod
import "pkl:reflect"

local shade = c.variable("shade")

local mode: hass.SelectEntity = new {
  entity_id = "select.robot_mode"
  options { "quiet"; "turbo"; "it's max" }
}

local lamp: hass.LightEntity = new {
  entity_id = "light.lamp"
  colourModes { "hs" }
  effects = new hass.Effects { owner = lamp; list { "none"; "Rainbow Slow" } }
}

/// What a button's tap chooses, as `variable=value`.
local function route(n: Any): String =
  let (d = n.declared["tap"] as slotMod.SetVarCall) "\(d.variable)=\(d.value)"

// A baked select's cases in order: what each shows, and the value showing it.
local function members(s: selectMod.Select): List<Pair<Any, String?>> =
  let (g = s.nodesSlots.flatMap((x) -> x.nodes.toList()).find((n) -> n is groupMod.Group) as groupMod.Group)
  let (w = (g.nodesSlots.findOrNull((x) -> x.choice != null)!!.fill as slotMod.NodesFill).choice as choiceMod.ChosenNodes)
    w.cases.toList().map((k) -> Pair(k.value[0], k.`is` as String?))

facts {
  ["a variable in history is in the URL: kept out of it, it is refused"] {
    shade.defaultingTo("a").inHistory().inHistory
    !shade.defaultingTo("a").inHistory
    module.catch(() -> shade.defaultingTo("a").notInUrl().inHistory().inHistory).contains("!this || inUrl")
  }

  ["style keeps what was set on the select before it; every node field is carried or the card's"] {
    local before = c.select(shade).options(List("a", "b")).columns(6).cellStyle("--x", new slotMod.Reading { entityId = "sensor.x"; steps { simpleMod.cel("state") } }) as selectMod.Select
    local after = before.style("dropdown")
    after.layoutClasses.toList() == List("fh-cols-6")
    after.liveStyles == before.liveStyles && !after.liveStyles.isEmpty
    after.card == "selectVarDropdown"
    // A field Node gains must be named here: carried by `style`, or computed by
    // the card. Otherwise it is dropped by `.style(…)` without a word.
    local carried = Set("cellClasses", "layoutClasses", "stateClasses", "liveClasses", "liveStyles", "id", "vars", "inputs")
    local cards = Set("kind", "cell", "card", "cardDef", "variants", "slots", "wireSlots", "valueSlots", "nodesSlots", "nodesDeclared", "slotsByName", "declared", "calls", "children", "regions", "wireInputs")
    reflect.Class(nodeMod.LayoutNode).properties.keys + reflect.Class(nodeMod.Node).properties.keys == carried + cards
  }

  ["over a variable: buttons by default, one per option, each choosing its own"] {
    local s = c.select(shade).options(List("pale", "deep"))
    s is selectMod.SelectButtons
    local opts = s.children.toList()
    opts.length == 2
    route(opts[0]) == "shade=pale" && route(opts[1]) == "shade=deep"
    // Lit while `shade` holds it; the renderer reads the ask while one is out.
    opts[1].liveClasses["fh-chosen"] == nodeMod.booleanReading(shade.valueIs("deep"))
  }

  ["a style is the same choice in another card, a variable's baked"] {
    local base = c.select(shade).options(List("pale", "deep"))
    base.style("dropdown").card == "selectVarDropdown"
    base.style("cycle").card == "selectVarCycle"
    base.style("dropdown").style("buttons").card == "selectButtons"
    base.style("cycle").choices == base.choices
    c.select(mode).style("dropdown").card == "selectDropdown"
    c.select(mode).style("cycle").card == "selectCycle"
  }

  ["a variable's dropdown label is one member per option, selected at its value"] {
    local d = c.select(shade)
      .options(List(new selectMod.Choice { value = "pale"; label = "it's pale" }, "deep"))
      .style("dropdown")
    members(d).map((m) -> m.second) == List("pale", "deep")
    members(d).map((m) -> (m.first as selectMod.ChoiceLabel).label) == List("it's pale", "deep")
    // The list still holds every option.
    d.children.toList().length == 2
    // An icon takes the label's place on the face.
    local iconic = members(c.select(shade)
      .options(List(new selectMod.Choice { value = "a"; label = "A"; icon = "mdi:palette" }, "b"))
      .style("dropdown"))
    (iconic[0].first as selectMod.ChoiceLabel).slotsByName["glyph"].value == "mdi mdi-palette"
    !(iconic[1].first as selectMod.ChoiceLabel).slotsByName.containsKey("glyph")
  }

  ["a variable's cycle bakes one button per option, each choosing the next, round"] {
    local cyc = c.select(shade).options(List("a", "b", "c")).style("cycle")
    cyc.children.isEmpty
    local bs = members(cyc)
    bs.map((m) -> m.second) == List("a", "b", "c")
    route(bs[0].first) == "shade=b" && route(bs[1].first) == "shade=c" && route(bs[2].first) == "shade=a"
    // Each face is a pill in its option's look: an icon replaces the label,
    // which still names it, and the pill is round.
    local iconic = members(c.select(shade)
      .options(List(new selectMod.Choice { value = "a"; label = "Aa"; icon = "mdi:palette" }, "b"))
      .style("cycle"))
    local face = iconic[0].first as buttonMod.Pill
    face.slotsByName["glyph"].value == "mdi-palette" && face.slotsByName["name"].value == "Aa" && face.slotsByName["round"].value == true
    !(iconic[1].first as buttonMod.Pill).slotsByName.containsKey("glyph")
  }

  ["over a select entity: its own options, each a call lit by the state"] {
    local opts = c.select(mode).children.toList()
    opts.map((o) -> o.slotsByName["label"].value) == List("quiet", "turbo", "it's max")
    local tap = (opts[1] as selectMod.EntityOption).tapAction
    tap.service == "select/select_option"
    tap.data.toMap() == Map("option", "turbo")
    local lit = (opts[2] as selectMod.EntityOption).active as predMod.Cmp
    lit.part == null && lit.op == "eq" && lit.value == "it's max" && lit.entity == "select.robot_mode"
    // The dropdown's label is the server's, so the first HTML names it.
    local shownSlot = c.select(mode).style("dropdown").slotsByName["chosen"]
    local shown = shownSlot.value as slotMod.Reading
    shown.entityId == "select.robot_mode"
    shownSlot.signal == slotMod.asText
    // An option it has no label for shows as itself.
    (shown.steps.toList().last as simpleMod.Match).otherwise is slotMod.EntityRead
    local effect = (c.select(lamp.effects!!).style("dropdown").slotsByName["chosen"].value as slotMod.Reading)
    local effectMatch = effect.steps.toList().last as simpleMod.Match
    effect.part.name == "effect"
    (effectMatch.otherwise as slotMod.EntityRead).part.name == "effect"
  }

  ["over a light's effects: turn_on with the effect, lit by its attribute"] {
    local cyc = c.select(lamp.effects!!).style("cycle").children.toList()
    // A cycle's faces are pills, marked by the server so only the chosen shows;
    // not lit, which would read as "on".
    local tap = (cyc[0] as buttonMod.Pill).tapAction as tapMod.Call
    tap.service == "light/turn_on"
    tap.data.toMap() == Map("effect", "Rainbow Slow")
    (((cyc[1] as buttonMod.Pill).liveClasses["fh-chosen"].source as slotMod.EntityRead).part as simpleMod.Attr).name == "effect"
    (cyc[1] as buttonMod.Pill).active == false
  }

  [".options picks, orders and relabels an entity's, and refuses one it lacks"] {
    local picked = c.select(mode)
      .options(List("turbo", new selectMod.Choice { value = "quiet"; label = "Shh" }))
    picked.children.toList().map((o) -> o.slotsByName["label"].value) == List("turbo", "Shh")
    module.catch(() -> c.select(mode).options(List("eco")).card)
      .contains("c.select(select.robot_mode) offers no eco: it has quiet, turbo, it's max")
  }

  ["no options, or a variable value no route can carry, is a build error"] {
    module.catch(() -> c.select(shade).children).contains("has no options: give them with .options(…)")
    module.catch(() -> c.select(shade).options(List("two words")).children.toList()[0].slots).contains("two words")
  }
}
