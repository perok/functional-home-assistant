/// The query surface (`lib/query.pkl`) — what an author writes, and what the
/// fold emits for it.
///
/// The one thing every test here is really about: a REGISTRY fact is a build-
/// time selection and never reaches the wire, while a LIVE condition becomes a
/// per-member guard. An author writes both the same way and never names the
/// seam, so these assert where each one ended up.
///
/// Outside `lib/` deliberately — see `components.test.pkl`.
amends "pkl:test"

import "../../main/resources/dashboards/lib/components.pkl" as c
import "../../main/resources/dashboards/lib/query.pkl" as q
import "../../main/resources/dashboards/lib/hass.pkl" as hass

// A stand-in dump. Two rooms, one light that is dimmable and one that is not,
// plus a sensor with a capability nothing else has — the mixed set that makes
// property resolution ambiguous.
local taklys: hass.LightEntity = new {
  entity_id = "light.taklys"
  friendly_name = "Taklys"
  area_id = "stue"
  supported_features = 8
}
local lampe: hass.LightEntity = new {
  entity_id = "light.lampe"
  friendly_name = "Lampe"
  area_id = "stue"
  supported_features = 0
}
local kjokken: hass.LightEntity = new {
  entity_id = "light.kjokken"
  friendly_name = "Kjøkken"
  area_id = "kjokken"
  supported_features = 8
}
local motion: hass.SensorEntity = new {
  entity_id = "binary_sensor.stue_motion"
  friendly_name = "Stue motion"
  area_id = "stue"
}

local stue = List(taklys, lampe)
local allEnts: List<hass.Entity> = List(taklys, lampe, kjokken, motion)

local clausesOf = (s) -> s.members.toMap().values.flatMap((m) -> m.clauses.toList())
local guards = (s) -> clausesOf.apply(s).map((cl) -> cl.`when`)
local ids = (s) -> s.candidates.toList()
local memberOf = (s, id) -> s.members[id].clauses.toList()

facts {
  ["a live condition becomes a per-member guard"] {
    // S1. The candidates are all of them — presence is decided at runtime, not
    // by dropping anyone here.
    local s = q.from(stue).where(q.eq(q.stateProp, "on")).render((e) -> c.entityCard(e)).build()
    ids.apply(s) == List("light.taklys", "light.lampe")
    guards.apply(s).every((g) -> g.property == "state" && g.op == "eq" && g.value == "on")
    guards.apply(s).length == 2
  }

  ["a registry condition SELECTS candidates and reaches no wire"] {
    // The point of the whole design: `area_id` is build-time data, so it
    // decides membership here and the runtime never sees it.
    local s = q.from(allEnts)
      .where(q.eq(q.prop("area_id"), "stue"))
      .render((e) -> c.entityCard(e))
      .build()
    ids.apply(s) == List("light.taklys", "light.lampe", "binary_sensor.stue_motion")
    guards.apply(s).every((g) -> g == null)
  }

  ["a candidate lambda folds too — dispatch on a CAPABILITY costs nothing live"] {
    // S4. `supported_features` is registry data, so which card each light gets
    // is settled at build time and neither clause carries a guard.
    local s = q.from(stue)
      .caseOf(q.candidate((e) -> (e as hass.LightEntity).supportsFlash), (e) -> c.entityCard(e))
      .`else`((e) -> c.pill("off-duty", c.navigate("/")))
      .build()
    memberOf.apply(s, "light.taklys").length == 1
    memberOf.apply(s, "light.taklys")[0].`when` == null
    memberOf.apply(s, "light.taklys")[0].node.card == "entityCard"
    memberOf.apply(s, "light.lampe").length == 1
    memberOf.apply(s, "light.lampe")[0].node.card == "pill"
  }

  ["dispatch on LIVE state keeps both renderings, first match winning"] {
    // S5. Two clauses per member: the guarded one, then the unconditional
    // fallback. Order is author order, which IS match order.
    local s = q.from(stue)
      .caseOf(q.eq(q.stateProp, "on"), (e) -> c.entityCard(e))
      .`else`((e) -> c.pill("off", c.navigate("/")))
      .build()
    memberOf.apply(s, "light.taklys").length == 2
    memberOf.apply(s, "light.taklys")[0].`when`.property == "state"
    memberOf.apply(s, "light.taklys")[1].`when` == null
  }

  ["omitting the `else` is how 'only while on' is written"] {
    // S6. The missing fallback is the feature: fall off the end and the member
    // is not rendered at all.
    local s = q.from(stue).caseOf(q.eq(q.stateProp, "on"), (e) -> c.entityCard(e)).build()
    clausesOf.apply(s).length == 2
    clausesOf.apply(s).every((cl) -> cl.`when` != null)
  }

  ["a list is AND, `any` is OR, and they nest"] {
    // S7. The dimmable light comes out unconditional — its half of the
    // disjunction is statically true — while the other defers to its state.
    // That divergence is exactly why presence lives on the clause.
    local s = q.from(stue)
      .where(List(
        q.eq(q.prop("area_id"), "stue"),
        q.any(List(
          q.candidate((e) -> (e as hass.LightEntity).supportsFlash),
          q.eq(q.stateProp, "on")))))
      .render((e) -> c.entityCard(e))
      .build()
    memberOf.apply(s, "light.taklys")[0].`when` == null
    memberOf.apply(s, "light.lampe")[0].`when`.property == "state"
  }

  ["a statically-false condition drops the candidate entirely"] {
    local s = q.from(allEnts)
      .where(q.eq(q.prop("area_id"), "nowhere"))
      .render((e) -> c.entityCard(e))
      .build()
    ids.apply(s).isEmpty
    s.members.isEmpty
  }

  ["an all-registry ordering is resolved NOW"] {
    // S10. Nothing rides on the wire: `candidates` comes out sorted and the
    // runtime only filters, with no comparisons.
    local s = q.from(allEnts)
      .orderBy(q.asc(q.prop("friendly_name")))
      .render((e) -> c.entityCard(e))
      .build()
    // By NAME — Kjøkken, Lampe, Stue motion, Taklys — not by entity id.
    ids.apply(s) == List(
      "light.kjokken", "light.lampe", "binary_sensor.stue_motion", "light.taklys")
  }

  ["`desc` inverts the comparison, not the ties"] {
    local s = q.from(allEnts)
      .orderBy(List(q.desc(q.prop("area_id")), q.asc(q.prop("friendly_name"))))
      .render((e) -> c.entityCard(e))
      .build()
    // "stue" before "kjokken" (desc), and WITHIN stue the names still ascend —
    // Lampe, Stue motion, Taklys. A `desc` that reversed the sorted list
    // instead of the comparison would hand back Taklys, Stue motion, Lampe.
    ids.apply(s) == List(
      "light.lampe", "binary_sensor.stue_motion", "light.taklys", "light.kjokken")
  }

  ["a guard may name ANOTHER entity, resolved to an id at build time"] {
    // The motion-gated room: the reference is build-time (derived from
    // `area_id`), the state test is live.
    local s = q.from(stue)
      .where(q.candidate((_e) -> q.entity(motion).stateIs("on")))
      .render((e) -> c.entityCard(e))
      .build()
    guards.apply(s).every((g) -> g.entity == "binary_sensor.stue_motion")
    guards.apply(s).every((g) -> g.property == "state")
  }

  ["a member's node is COMPLETE — it carries its own entity"] {
    // What makes a clause unable to be wrong about which member it belongs to,
    // and what the renderer relies on: nothing is injected per render.
    local s = q.from(stue).render((e) -> c.entityCard(e)).build()
    memberOf.apply(s, "light.lampe")[0].node.slots["entity_id"] == "light.lampe"
  }

  ["a property only SOME candidates carry needs `optional`"] {
    // Without it this is a build error: it would silently be a registry fact
    // for the lights and a live attribute for the sensor.
    local s = q.from(allEnts)
      .where(q.eq(q.optional(q.prop("supported_features")), 8))
      .render((e) -> c.entityCard(e))
      .build()
    ids.apply(s) == List("light.taklys", "light.kjokken")
  }

  ["a LIVE ordering key is emitted for the runtime to compare"] {
    // The build cannot know a brightness, so this one has to ride the wire —
    // and then `candidates` is NOT the render order, it is just the tiebreak.
    local s = q.from(stue)
      .orderBy(q.desc(q.prop("brightness")))
      .render((e) -> c.entityCard(e))
      .build()
    s.orderBy.toList().length == 1
    s.orderBy[0].by.property == "attr:brightness"
    s.orderBy[0].dir == "desc"
  }

  ["ordering by a PREDICATE sorts on whether it holds"] {
    // "The ones that are on first, then the rest" — the same comparison
    // vocabulary `where` uses, so there is no second notion of a sort key.
    local s = q.from(stue)
      .orderBy(q.desc(q.eq(q.stateProp, "on")))
      .render((e) -> c.entityCard(e))
      .build()
    s.orderBy[0].by.kind == "holds"
    s.orderBy[0].by.predicate.property == "state"
    s.orderBy[0].by.predicate.value == "on"
  }

  ["registry keys AFTER a live one are folded into the candidate order"] {
    // Mixed, in the order that works: the live key rides, and the registry key
    // is supplied as the tiebreak by pre-sorting — the runtime's sort is stable
    // over candidate order, so it survives.
    local s = q.from(allEnts)
      .orderBy(List(q.desc(q.prop("brightness")), q.asc(q.prop("friendly_name"))))
      .render((e) -> c.entityCard(e))
      .build()
    s.orderBy.toList().length == 1
    s.orderBy[0].by.property == "attr:brightness"
    ids.apply(s) == List(
      "light.kjokken", "light.lampe", "binary_sensor.stue_motion", "light.taklys")
  }

  ["`limit` rides to the runtime, because only it knows who wins"] {
    local s = q.from(stue)
      .orderBy(q.desc(q.prop("brightness")))
      .limit(1)
      .render((e) -> c.entityCard(e))
      .build()
    s.limit == 1
    // Every candidate still SHIPS — which one is cut is a live question.
    ids.apply(s).length == 2
  }

  ["`count` compares the PRESENT members, with no quantifier"] {
    // The original ask: "if more than X elements then we show this."
    local cond = q.from(stue).where(q.eq(q.stateProp, "on")).count().gt(1)
    cond.kind == "count"
    cond.op == "gt"
    cond.value == 1
    cond.candidates.toList() == List("light.taklys", "light.lampe")
    // A per-candidate guard, for the same reason a member's clauses are.
    cond.`when`["light.taklys"].property == "state"
  }

  ["`any` and `none` are comparisons on the count, not quantifiers"] {
    q.from(stue).where(q.eq(q.stateProp, "on")).any().op == "gt"
    q.from(stue).where(q.eq(q.stateProp, "on")).any().value == 0
    q.from(stue).where(q.eq(q.stateProp, "on")).none().op == "eq"
    q.from(stue).where(q.eq(q.stateProp, "on")).none().value == 0
  }

  ["a count the BUILD can settle folds to a constant"] {
    // No live filter, so the answer is known now — and the card this guards is
    // dropped at build time rather than carrying a condition that cannot move.
    q.from(stue).count().gt(1) == true
    q.from(stue).count().gt(5) == false
    // An empty room counts zero, so `any()` is statically false.
    q.from(List()).any() == false
    // A registry filter still folds: only one light is in kjokken.
    q.from(allEnts).where(q.eq(q.prop("area_id"), "kjokken")).count().eq(1) == true
  }

  ["a counted set needs no card — counting is not rendering"] {
    // `count` reads `where` only, so a set can be counted without ever being
    // given a branch. The spike needed a marker branch here; this does not.
    local cond = q.from(stue).where(q.eq(q.stateProp, "on")).count().gt(0)
    cond.candidates.toList().length == 2
  }

  ["a tile per room is PLAIN Pkl around a set, not a query over rooms"] {
    // Which rooms exist is registry data — static, known now, never moving — so
    // iterating them is an ordinary `for`. Only the lights inside need the
    // query language, because only their presence is live. Reaching for
    // `q.from(rooms)` here would be the drift P9 exists to stop: it buys
    // nothing and costs a concept.
    local rooms = new Mapping<String, List<hass.LightEntity>> {
      ["Stue"] = stue
      ["Kjøkken"] = List(kjokken)
    }
    local card = (c.grid) {
      children {
        for (name, lights in rooms) {
          (c.column) {
            children {
              new c.SectionTitle { text = name }
              q.from(lights).where(q.eq(q.stateProp, "on")).render((e) -> c.entityCard(e)).build()
            }
          }
        }
      }
    }
    // The rooms are ordinary layout; each holds one set of its own.
    card.children.toList().length == 2
    local stueSet = card.children.toList()[0].children.toList()[1]
    stueSet.kind == "set"
    stueSet.candidates.toList() == List("light.taklys", "light.lampe")
    stueSet.members["light.taklys"].clauses.toList()[0].`when`.property == "state"
    // ...and a room's title is a LITERAL, which is why the tile needs no
    // patch target of its own.
    card.children.toList()[1].children.toList()[0].slots["label"] == "Kjøkken"
  }

  ["a set NESTS inside another's render, when the outer membership is live"] {
    // The case plain Pkl cannot reach: which GROUPS are on is live, so the
    // outer loop has to be a query too. Contrast the room test above — rooms
    // are registry data, so that outer loop is a `for`. Live outer membership
    // is the whole criterion for reaching for a nested set.
    local grp: hass.LightEntity = new {
      entity_id = "light.stue_group"
      friendly_name = "Stue"
      members = stue
    }
    local s = q.from(List(grp))
      .where(q.eq(q.stateProp, "on"))
      .render((g) -> (c.column) { children {
        new c.SectionTitle { text = g.friendly_name }
        q.from(g.members).where(q.eq(q.stateProp, "on")).render((e) -> c.entityCard(e)).build()
      } })
      .build()

    // The outer set is live: the group's tile appears only while it is on.
    ids.apply(s) == List("light.stue_group")
    memberOf.apply(s, "light.stue_group")[0].`when`.property == "state"
    // ...and the tile holds a set of its own, with its own guards. The runtime
    // gives that inner set its own id, so a bulb patches its own element
    // rather than re-rendering the group tile.
    local inner = memberOf.apply(s, "light.stue_group")[0].node.children.toList()[1]
    inner.kind == "set"
    inner.candidates.toList() == List("light.taklys", "light.lampe")
    inner.members["light.lampe"].clauses.toList()[0].`when`.property == "state"
  }

  // ---- ported from the spike's scenario suites, now against the real lib ----

  ["S2 an interpolated label is computed at build time, so it is a literal"] {
    local s = q.from(stue)
      .render((e) -> (c.entityCard(e)) { label = "Blah \(e.friendly_name)" })
      .build()
    memberOf.apply(s, "light.taklys")[0].node.slots["label"] == "Blah Taklys"
  }

  ["S3 a different card per domain, resolved at build time"] {
    local s = q.from(allEnts)
      .cases(new Mapping {
        [q.eq(q.prop("domain"), "light")] = (e) -> c.entityCard(e)
        [q.eq(q.prop("domain"), "sensor")] = (e) -> c.pill("s", c.navigate("/"))
      })
      .build()
    memberOf.apply(s, "light.taklys")[0].node.card == "entityCard"
    // The motion sensor is a SensorEntity, so it takes the sensor branch.
    memberOf.apply(s, "binary_sensor.stue_motion")[0].node.card == "pill"
    guards.apply(s).every((g) -> g == null)
  }

  ["S8 a OR (b AND c) — `all` nests inside `any`"] {
    local s = q.from(allEnts)
      .where(q.any(List(
        q.eq(q.prop("domain"), "media_player"),
        q.all(List(q.eq(q.prop("domain"), "light"), q.eq(q.prop("area_id"), "stue"))))))
      .render((e) -> c.entityCard(e))
      .build()
    ids.apply(s) == List("light.taklys", "light.lampe")
  }

  ["S14 `q.entity(x).stateIs(...)` is the one-entity shorthand"] {
    local t = q.entity(motion).stateIs("on")
    t.entity == "binary_sensor.stue_motion"
    t.property == "state"
    t.op == "eq"
    t.value == "on"
  }

  ["S23 an unconditional case drops everything after it"] {
    // Nothing after a branch that always wins can ever match, so it never
    // reaches the wire.
    local s = q.from(stue)
      .caseOf(q.candidate((_e) -> true), (e) -> c.entityCard(e))
      .`else`((e) -> c.pill("never", c.navigate("/")))
      .build()
    memberOf.apply(s, "light.taklys").length == 1
    memberOf.apply(s, "light.taklys")[0].node.card == "entityCard"
  }

  ["chained `where`s conjoin"] {
    local s = q.from(allEnts)
      .where(q.eq(q.prop("domain"), "light"))
      .where(q.eq(q.prop("area_id"), "stue"))
      .render((e) -> c.entityCard(e))
      .build()
    ids.apply(s) == List("light.taklys", "light.lampe")
  }

  ["`attr` forces the LIVE reading of a name that is also a registry fact"] {
    // `friendly_name` is both. Without `attr` the build reads it and folds;
    // with it, the comparison defers.
    local s = q.from(stue)
      .where(q.eq(q.attr("friendly_name"), "Taklys"))
      .render((e) -> c.entityCard(e))
      .build()
    guards.apply(s).every((g) -> g.property == "attr:friendly_name")
    ids.apply(s).length == 2
  }

  ["a name NO candidate carries resolves to a live attribute"] {
    local s = q.from(stue)
      .where(q.eq(q.prop("brightness"), 5))
      .render((e) -> c.entityCard(e))
      .build()
    guards.apply(s).every((g) -> g.property == "attr:brightness")
  }

  ["`not` folds statically when its operand does"] {
    local s = q.from(allEnts)
      .where(q.not(q.eq(q.prop("area_id"), "stue")))
      .render((e) -> c.entityCard(e))
      .build()
    ids.apply(s) == List("light.kjokken")
  }

  ["a presence residual equal to its branch guard collapses to ONE term"] {
    // Not tidiness: the runtime would otherwise evaluate `state == on` twice
    // per member. The fold has to canonicalise, not just build an `and`.
    local s = q.from(stue)
      .where(q.eq(q.stateProp, "on"))
      .caseOf(q.eq(q.stateProp, "on"), (e) -> c.entityCard(e))
      .build()
    memberOf.apply(s, "light.taklys")[0].`when`.kind == "cmp"
  }

  ["same-kind nesting FLATTENS instead of nesting"] {
    // A single-element inner group collapses by accident, which is how this
    // hid in the spike — so the inner group needs two live terms.
    local s = q.from(stue)
      .where(q.all(List(
        q.eq(q.stateProp, "on"),
        q.all(List(q.eq(q.prop("brightness"), 5), q.eq(q.prop("effect"), "x"))))))
      .render((e) -> c.entityCard(e))
      .build()
    local g = memberOf.apply(s, "light.taklys")[0].`when`
    g.kind == "and"
    g.items.toList().length == 3
    g.items.toList().every((i) -> i.kind == "cmp")
  }

  ["two spellings of the same filter produce the SAME term"] {
    // Structural equality is what a backend intern (or a human diff) relies on.
    local a = q.from(stue).where(q.all(List(q.eq(q.stateProp, "on")))).render((e) -> c.entityCard(e)).build()
    local b = q.from(stue).where(q.eq(q.stateProp, "on")).render((e) -> c.entityCard(e)).build()
    memberOf.apply(a, "light.taklys")[0].`when` == memberOf.apply(b, "light.taklys")[0].`when`
  }

  ["C2 an invariant child is simply repeated on every member"] {
    local s = q.from(stue)
      .render((e) -> (c.column) { children {
        new c.SectionTitle { text = "Light" }
        c.entityCard(e)
      } })
      .build()
    local heads = clausesOf.apply(s).map((cl) -> cl.node.children.toList()[0].slots["label"])
    heads == List("Light", "Light")
    // ...and each member's own card still carries its own entity.
    memberOf.apply(s, "light.lampe")[0].node.children.toList()[1].slots["entity_id"] == "light.lampe"
  }

  ["the emitted node is a `set`, and every candidate has a member"] {
    local s = q.from(stue).where(q.eq(q.stateProp, "on")).render((e) -> c.entityCard(e)).build()
    s.kind == "set"
    ids.apply(s).every((id) -> s.members.containsKey(id))
  }
}
