/// The domain schema's SCOPE VOCABULARY: every scope — the house, an area, a
/// floor, a device — answers `all`, and a domain is picked out of one by a
/// SELECTOR, so `q.from(...)` takes any of them and an author moving between
/// scopes rewrites nothing.
///
/// Worth pinning because most of it is DERIVED: a floor's `all` from its areas,
/// a device's from its entities, and every per-domain list from a selector. A
/// derivation that drifts from what the generator emits is silent — the list is
/// simply wrong, never absent.
///
/// The other property pinned here is that the selectors PARTITION `all`:
/// `generic` is a hand-written complement, so the edit that adds a domain and
/// forgets to remove it from `generic` double-counts, and nothing else notices.
///
/// Outside `lib/` for the usual reason — see `components.test.pkl`.
amends "pkl:test"

import "../../main/resources/dashboards/lib/hass.pkl" as hass
import "../../main/resources/dashboards/lib/internal/dump-base.pkl" as dumpBase

const local bulb: hass.LightEntity = new { entity_id = "light.a"; area_id = "stue" }
const local temp: hass.SensorEntity = new { entity_id = "sensor.t"; area_id = "stue" }
const local plug: hass.SwitchEntity = new { entity_id = "switch.p"; area_id = "stue" }
const local door: hass.LockEntity = new { entity_id = "lock.d"; area_id = "stue" }
const local ajar: hass.BinarySensorEntity = new {
  entity_id = "binary_sensor.d"
  area_id = "stue"
  device_class = "door"
}
const local tv: hass.GenericEntity = new {
  entity_id = "media_player.tv"
  domain = "media_player"
  area_id = "stue"
}

const local everything: List<hass.Entity> = List(bulb, temp, plug, door, ajar, tv)

/// An appliance's "time to end", in the shape the live Electrolux integration
/// reports it: a plain number whose unit lives in the registry.
const local remaining: hass.SensorEntity = new {
  entity_id = "sensor.timetoend"
  device_class = "duration"
  unit_of_measurement = "min"
}

local class Stue extends hass.Area {
  area_id = "stue"
  area_name = "Stue"
  allWithHidden = everything
}

local class Loft extends hass.Floor {
  floor_id = "loft"
  floor_name = "Loft"
  areas = List(new Stue {})
}

local class Appliance extends hass.Device {
  device_id = "d1"
  device_name = "Appliance"
  entities = everything
}

local stue: Stue = new {}
local loft: Loft = new {}
local dev: Appliance = new {}
local house: dumpBase.EntityNamespace = new { allWithHidden = everything }

/// Hidden in HA, so no default list may show it.
const local stashed: hass.LightEntity = new {
  entity_id = "light.stashed"
  area_id = "stue"
  id_hidden = true
}
local withStashed = everything + List(stashed)

local ids = (xs: List<hass.Entity>) -> xs.map((e) -> e.entity_id)

// The domains a tap fires rather than switches, beside the rest.
const local kveld: hass.SceneEntity = new { entity_id = "scene.kveld"; area_id = "stue" }
const local goodnight: hass.ScriptEntity = new { entity_id = "script.goodnight" }
const local restart: hass.ButtonEntity = new { entity_id = "button.restart" }
const local doorbell: hass.InputButtonEntity = new { entity_id = "input_button.doorbell" }
const local withFired: List<hass.Entity> =
  everything + List(kveld, goodnight, restart, doorbell)

facts {
  ["a selector picks one domain out of any scope"] {
    ids.apply(hass.lights(stue.all)) == List("light.a")
    ids.apply(hass.locks(loft.all)) == List("lock.d")
    ids.apply(hass.sensors(dev.all)) == List("sensor.t")
    ids.apply(hass.binarySensors(dev.all)) == List("binary_sensor.d")
    ids.apply(hass.switches(house.all)) == List("switch.p")
    // The complement: a media_player has no selector, so it lands here.
    ids.apply(hass.generic(stue.all)) == List("media_player.tv")
  }

  ["`sensors` does NOT swallow binary_sensors"] {
    // Two domains, two classes, and neither `is` test may catch the other —
    // the names invite exactly that mistake, and a selector that over-matched
    // would put a door contact in every numeric query in the house.
    hass.sensors(everything).isEmpty == false
    hass.sensors(everything).every((e) -> e.domain == "sensor")
    hass.binarySensors(everything).every((e) -> e.domain == "binary_sensor")
  }

  ["the selectors partition `all` — nothing dropped, nothing counted twice"] {
    local parts = hass.lights(everything) + hass.locks(everything)
      + hass.sensors(everything) + hass.binarySensors(everything)
      + hass.switches(everything)
      + hass.generic(everything)
    parts.length == everything.length
    parts.toSet() == everything.toSet()
  }

  ["a floor's `all` is its areas', and a device's is its entities'"] {
    ids.apply(loft.all) == ids.apply(stue.all)
    ids.apply(dev.all) == ids.apply(dev.entities)
  }

  ["the house's per-domain namespaces are the selectors over its `all`"] {
    // The everyday spelling (`dump.lights.all`) and the scoped one
    // (`hass.lights(area.all)`) must be the same function, not two filters that
    // agree today. Which entities the generator puts in each namespace is
    // `PklBuildSuite`'s to hold; this is the base's half.
    (new dumpBase.LightNamespace { allWithHidden = hass.lights(everything) }).all
      == hass.lights(house.all)
    (new dumpBase.LockNamespace { allWithHidden = hass.locks(everything) }).all
      == hass.locks(house.all)
    (new dumpBase.SensorNamespace { allWithHidden = hass.sensors(everything) }).all
      == hass.sensors(house.all)
    (new dumpBase.BinarySensorNamespace { allWithHidden = hass.binarySensors(everything) }).all
      == hass.binarySensors(house.all)
    (new dumpBase.SwitchNamespace { allWithHidden = hass.switches(everything) }).all
      == hass.switches(house.all)
    (new dumpBase.GenericNamespace { allWithHidden = hass.generic(everything) }).all
      == hass.generic(house.all)
  }

  ["an EMPTY scope answers an empty list, never an error"] {
    // The property the starter dashboard rests on: it queries these lists
    // having never seen this home's dump. A missing generated property would be
    // `Cannot find property` at eval, on a first boot; a declared default
    // cannot fail that way.
    local bare: dumpBase = new {}
    bare.entities.all.isEmpty
    bare.lights.all.isEmpty
    bare.locks.all.isEmpty
    bare.sensors.all.isEmpty
    bare.binarySensors.all.isEmpty
    bare.switches.all.isEmpty
    bare.generic.all.isEmpty
    (new Loft { areas = List() }).all.isEmpty
    (new Appliance { entities = List() }).all.isEmpty
  }

  ["an entity hidden in HA is in no scope's `all`, and still in `allWithHidden`"] {
    // Asserted per scope, since each derives its own `all` and one that forgot
    // the filter would show the entity only there.
    local room = new Stue { allWithHidden = withStashed }
    local floor = new Loft { areas = List(room) }
    local appliance = new Appliance { entities = withStashed }
    local home: dumpBase.EntityNamespace = new { allWithHidden = withStashed }
    local homeLights: dumpBase.LightNamespace = new { allWithHidden = hass.lights(withStashed) }
    !room.all.contains(stashed) && room.allWithHidden.contains(stashed)
    !floor.all.contains(stashed) && floor.allWithHidden.contains(stashed)
    !appliance.all.contains(stashed) && appliance.allWithHidden.contains(stashed)
    !home.all.contains(stashed) && home.allWithHidden.contains(stashed)
    !homeLights.all.contains(stashed) && homeLights.allWithHidden.contains(stashed)
    ids.apply(home.all) == ids.apply(everything)
  }

  ["a duration sensor carries the seconds its unit is worth"] {
    // The fact a countdown rests on: `253` means minutes here and seconds
    // elsewhere, and only the registry says which. Getting this wrong is not a
    // visible error — it is a progress bar that finishes 60x early.
    remaining.durationSeconds == 60
    (new hass.SensorEntity {
      entity_id = "sensor.s"
      device_class = "duration"
      unit_of_measurement = "s"
    }).durationSeconds == 1
  }

  ["a duration with no fixed length is NOT scalable"] {
    // Weeks/months/years are absent from DURATION_SECONDS on purpose: a
    // multiplier for "a month" would be a lie that renders a plausible wrong
    // countdown instead of failing. null is the answer that makes a card
    // choose.
    (new hass.SensorEntity {
      entity_id = "sensor.s"
      device_class = "duration"
      unit_of_measurement = "m"
    }).durationSeconds == null
    // Same answer by the other two routes into "cannot scale this".
    (new hass.SensorEntity {
      entity_id = "sensor.s"
      device_class = "duration"
    }).durationSeconds == null
    temp.durationSeconds == null
  }

  ["a sensor with no device class is ordinary, not broken"] {
    // Measured on the live instance: an appliance's own status sensors declare
    // none at all, so this is the common shape rather than a degenerate one.
    temp.device_class == null
    temp.isEnum == false
    temp.isDuration == false
    temp.isInstant == false
    temp.isNumeric == false
  }

  ["what counts as a number a card may compute with"] {
    remaining.isNumeric
    (new hass.SensorEntity {
      entity_id = "sensor.s"
      state_class = "measurement"
    }).isNumeric
    // An enum's options can look like numbers and are labels regardless, and
    // an instant is a string that would parse as nothing useful.
    (new hass.SensorEntity {
      entity_id = "sensor.s"
      device_class = "enum"
      options = new { "1"; "2" }
    }).isNumeric == false
    (new hass.SensorEntity {
      entity_id = "sensor.s"
      device_class = "timestamp"
    }).isInstant
  }

  ["a binary sensor says what `on` means, and the polarity is not uniform"] {
    // The trap this exists for: `door` on means OPEN, but `lock` on means
    // UNLOCKED. A card rendering "on" as "active" is wrong for half of them.
    ajar.onMeans == "open"
    (new hass.BinarySensorEntity {
      entity_id = "binary_sensor.l"
      device_class = "lock"
    }).onMeans == "unlocked"
    (new hass.BinarySensorEntity { entity_id = "binary_sensor.x" }).onMeans == null
  }

  ["a scene, a script and both buttons each have a selector of their own"] {
    ids.apply(hass.scenes(withFired)) == List("scene.kveld")
    ids.apply(hass.scripts(withFired)) == List("script.goodnight")
    ids.apply(hass.buttons(withFired)) == List("button.restart")
    ids.apply(hass.inputButtons(withFired)) == List("input_button.doorbell")
    // A helper button is not a button: two domains, two services.
    hass.buttons(withFired).every((e) -> e.domain == "button")
  }

  ["the selectors partition `all` with the fired domains in it"] {
    local parts = hass.lights(withFired) + hass.locks(withFired)
      + hass.sensors(withFired) + hass.binarySensors(withFired)
      + hass.switches(withFired) + hass.scenes(withFired)
      + hass.scripts(withFired) + hass.buttons(withFired)
      + hass.inputButtons(withFired)
      + hass.generic(withFired)
    parts.length == withFired.length
    parts.toSet() == withFired.toSet()
  }

  ["an empty house's namespaces each answer an empty `all`"] {
    // The first-boot property: the starter queries these having never seen the
    // home, and a generator emits a namespace only when it has members.
    local bare: dumpBase = new {}
    bare.entities.all.isEmpty && bare.generic.all.isEmpty
    bare.lights.all.isEmpty && bare.locks.all.isEmpty && bare.switches.all.isEmpty
    bare.sensors.all.isEmpty && bare.binarySensors.all.isEmpty
    bare.scenes.all.isEmpty && bare.scripts.all.isEmpty
    bare.buttons.all.isEmpty && bare.inputButtons.all.isEmpty
  }

  ["a namespace's `all` leaves out what HA hides, as a scope's does"] {
    local secret: hass.SceneEntity = new { entity_id = "scene.secret"; id_hidden = true }
    local scenes: dumpBase.SceneNamespace = new { allWithHidden = List(kveld, secret) }
    ids.apply(scenes.all) == List("scene.kveld")
    local everyone: dumpBase.EntityNamespace = new { allWithHidden = withFired + List(secret) }
    ids.apply(everyone.all) == ids.apply(withFired)
    ids.apply(hass.scenes((new Stue { allWithHidden = withFired }).all)) == List("scene.kveld")
  }
}
