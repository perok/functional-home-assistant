/// `c.progress(sensor)`: the parts it finds beside that sensor on its device,
/// by `defaults.progress` (#541).
///
/// Outside `lib/` for the usual reason — see `components.test.pkl`.
amends "pkl:test"

import "../../main/resources/dashboards/lib/components.pkl" as c
import "../../main/resources/dashboards/lib/components/base/bar.pkl" as barBaseMod
import "../../main/resources/dashboards/lib/components/base/surface.pkl" as surfacesMod
import "../../main/resources/dashboards/lib/components/defaults.pkl" as defaultsMod
import "../../main/resources/dashboards/lib/components/fetch.pkl" as fetchMod
import "../../main/resources/dashboards/lib/core/predicate.pkl" as pred
import "../../main/resources/dashboards/lib/core/slot.pkl" as slotMod
import "../../main/resources/dashboards/lib/hass.pkl"
import "progress-devices.pkl" as house
import "workspace-components.pkl" as ws

local class Dev extends hass.Device {}

/// `xs` on one device, each linked back to it as the generator links them.
local function dev(name: String, xs: List<hass.Entity>): Dev = new {
  device_id = name
  device_name = name
  entities = let (d = this) xs.map((e) -> (e) { device = d })
}

/// `given` on a device beside `others`, as a card is given it.
local function onDevice(given: hass.SensorEntity, others: List<hass.SensorEntity>): hass.SensorEntity =
  dev("Appliance", List(given) + others).entities.first as hass.SensorEntity

local function minutes(id: String, key: String): hass.SensorEntity =
  new { entity_id = "sensor.\(id)"; translation_key = key; device_class = "duration"; unit_of_measurement = "min" }

local function words(id: String, key: String): hass.SensorEntity =
  new { entity_id = "sensor.\(id)"; translation_key = key }

local function parts(card: c.ProgressCard): Map<String, String?> =
  Map("percent", card.percent?.entity_id, "total", card.total?.entity_id, "status", card.status?.entity_id)

local shipped = c.defaults.progress

/// What `rules` find beside `given`.
local function using(rules: defaultsMod.ProgressRules, given: hass.SensorEntity, others: List<hass.SensorEntity>): Map<String, String?> =
  parts((c.progress(onDevice(given, others))) { defaults { progress = rules } })

/// The bar a progress card shows, inside the `c.iff` that shows it only while
/// it runs.
local function barOf(card: c.ProgressCard): barBaseMod.ProgressBar =
  let (f = card.features[0]) (if (f is surfacesMod.If) f.`then`[0] else f) as barBaseMod.ProgressBar

local function inHouse(key: String, id: String): hass.SensorEntity =
  dev(house.devices[key].device_name, house.devices[key].entities).entities
    .find((e) -> e.entity_id == id) as hass.SensorEntity

facts {
  ["in a real house, the sensor given finds its parts on its device"] {
    parts(c.progress(inHouse("dishwasher", "sensor.dishwasher_current_program_remaining_time"))) == Map(
      "percent", null, "total", "sensor.dishwasher_current_program_duration",
      "status", "sensor.dishwasher_current_program_phase")
    parts(c.progress(inHouse("printer", "sensor.p1s_remaining_time"))) == Map(
      "percent", "sensor.p1s_print_progress", "total", null, "status", "sensor.p1s_current_stage")
    // A percentage given is its own bar.
    parts(c.progress(inHouse("vacuum", "sensor.roborock_s8_cleaning_progress"))) == Map(
      "percent", "sensor.roborock_s8_cleaning_progress", "total", null, "status", "sensor.roborock_s8_status")
    // Two countdowns on one car: each finds the status it shares words with.
    parts(c.progress(inHouse("car", "sensor.car_id4gtx_charging_time_left")))["status"]
      == "sensor.car_id4gtx_charging_state"
    parts(c.progress(inHouse("car", "sensor.car_id4gtx_electric_remaining_climatisation_time")))["status"]
      == "sensor.car_id4gtx_climatisation_state"
    parts(c.progress(inHouse("washer", "sensor.electrolux_washing_machine_timetoend_2"))) == Map(
      "percent", null, "total", null, "status", "sensor.electrolux_washing_machine_cyclephase_2")
    parts(c.progress(inHouse("phone", "sensor.le2123_remaining_charge_time"))) == Map(
      "percent", null, "total", null, "status", "sensor.le2123_battery_state")
    // The device's name is the label.
    c.progress(inHouse("washer", "sensor.electrolux_washing_machine_timetoend_2")).slots["label"]
      == house.devices["washer"].device_name
  }

  ["a countdown with nothing to divide by fills out of where it started, from its history"] {
    local left = minutes("rem", "time_to_end")
    local bar = barOf(c.progress(onDevice(left, List(words("ph", "cycle_phase")))))
    (bar.slots["value"] as slotMod.Slot).entityId == "sensor.rem"
    bar.slots["down"] == "1"
    // The whole is a live CEL slot on the countdown, reading its history.
    local whole = bar.slots["of"] as slotMod.Slot
    whole.entityId == "sensor.rem"
    whole.transform.toString().contains("past.transformList")
    whole.values.toMap() == Map("past", c.fetch.history(left))
    local past = whole.values["past"] as fetchMod.History
    past.entity == "sensor.rem"
    past.window == c.window.raw(24.h)
    past.everyPoint
    // A countdown on no device gets the same bar.
    (barOf(c.progress(left)).slots["of"] as slotMod.Slot).values.toMap() == Map("past", c.fetch.history(left))
  }

  ["c.fetch.history reads one sensor over a window, and an unused slot input is not on the wire"] {
    local left = minutes("rem", "time_to_end")
    local week = c.fetch.history(left).over(c.window.raw(7.d))
    week.entity == "sensor.rem"
    week.window == c.window.raw(7.d)
    week.everyPoint
    week.provider == "history"
    // Without inputs a slot's wire is what it always was.
    (new slotMod.Slot { transform = "state" }).values == null
  }

  ["the workspace's names add to the shipped ones, and an ignored name takes a sensor out"] {
    local left = minutes("rem", "time_to_end")
    local prog = words("prog", "programme")
    // A name the library does not ship finds nothing, until the workspace's
    // defaults add it.
    parts(c.progress(onDevice(left, List(prog))))["status"] == null
    parts(ws.progress(onDevice(left, List(prog))))["status"] == "sensor.prog"
    // `ignore` takes it out, whatever else names it.
    using((shipped) { ignore { "appliance" } }, left, List(words("st", "appliance_state")))["status"] == null
  }

  ["a name cannot loosen a part's shape"] {
    local left = minutes("rem", "time_to_end")
    // A programme length that is text: it plays no part.
    using(shipped, left, List(words("dur", "program_duration")))["total"] == null
  }

  ["a running total and an ignored word play no part"] {
    local left = minutes("rem", "time_to_end")
    local counter: hass.SensorEntity = (minutes("all", "program_duration")) { state_class = "total_increasing" }
    using(shipped, left, List(counter))["total"] == null
    using(shipped, left, List(minutes("last", "last_program_duration")))["total"] == null
  }

  ["two that fit one role: shared words, then the plainer name, then the primary one, else neither"] {
    local left = minutes("rem", "program_remaining_time")
    // Shared words with the sensor given.
    using(shipped, left, List(minutes("dose", "auto_dose_duration"), minutes("prog", "program_duration")))["total"]
      == "sensor.prog"
    // The plainer name.
    using(shipped, left, List(words("sub", "cycle_sub_phase"), words("ph", "cycle_phase")))["status"] == "sensor.ph"
    // The one not marked diagnostic.
    local diag: hass.SensorEntity = (words("a", "machine_state")) { entity_category = "diagnostic" }
    using(shipped, left, List(diag, words("b", "appliance_state")))["status"] == "sensor.b"
    // Else neither.
    using(shipped, left, List(words("a", "machine_state"), words("b", "appliance_state")))["status"] == null
    // Unrelated names tie whatever their length.
    using(shipped, minutes("t", "time_to_end"), List(words("a", "charging_state"), words("b", "remaining_climatisation_state")))["status"]
      == null
  }

  ["one bar: a percent, else left of total; never a battery on its own"] {
    local left = minutes("rem", "remaining_time")
    local pct: hass.SensorEntity = new { entity_id = "sensor.pct"; translation_key = "print_progress"; unit_of_measurement = "%" }
    local total = minutes("dur", "program_duration")
    local battery: hass.SensorEntity = new { entity_id = "sensor.bat"; device_class = "battery"; unit_of_measurement = "%" }
    using(shipped, left, List(pct, total))["percent"] == "sensor.pct"
    using(shipped, left, List(pct, total))["total"] == null
    using(shipped, left, List(total))["total"] == "sensor.dur"
    // Charging or not: a charge fills out of where its countdown started.
    local charging = c.progress(onDevice(minutes("ch", "charging_time_left"), List(battery)))
    charging.percent == null
    (barOf(charging).slots["of"] as slotMod.Slot).values.toMap().containsKey("past")
  }

  ["the card shows what was found, and each builder overrides one part"] {
    local left = minutes("rem", "remaining_time")
    local pct: hass.SensorEntity = new { entity_id = "sensor.pct"; translation_key = "progress"; unit_of_measurement = "%" }
    local total = minutes("dur", "program_duration")
    local card = c.progress(onDevice(left, List(pct, total, words("st", "status"))))
    card.slots["label"] == "Appliance"
    card.slots["entity_id"] == "sensor.rem"
    (card.slots["secondary"] as slotMod.Slot).entityId == "sensor.st"
    (barOf(card).slots["value"] as slotMod.Slot).entityId == "sensor.pct"
    // `.total` asks for that bar, dropping the percent found.
    (barOf(card.total(total)).slots["of"] as slotMod.Slot).entityId == "sensor.dur"
    (card.status(left).slots["secondary"] as slotMod.Slot).entityId == "sensor.rem"
    // A percentage given reads as itself.
    local vacuum = c.progress(pct)
    vacuum.slots["entity_id"] == "sensor.pct"
    (vacuum.slots["value"] as slotMod.Slot).transform != null
  }

  ["the bar shows and the countdown has a value only while it runs; a battery's bar always"] {
    local left = minutes("rem", "remaining_time")
    local total = minutes("dur", "program_duration")
    local pct: hass.SensorEntity = new { entity_id = "sensor.pct"; translation_key = "progress"; unit_of_measurement = "%" }
    local battery: hass.SensorEntity = new { entity_id = "sensor.bat"; device_class = "battery"; unit_of_measurement = "%" }
    local function cmp(id: String, o: pred.PredicateOp, v: Int|String): pred.Cmp =
      new { entity = id; property = "state"; op = o; value = v }
    local washer = c.progress(onDevice(left, List(total, words("st", "status"))))
    washer.running == cmp("sensor.rem", "gt", 0)
    // The bar is structure, gone while idle; the countdown is a value, empty.
    (washer.features[0] as surfacesMod.If).condition == washer.running
    (washer.slots["value"] as slotMod.Slot).valueWhile == washer.running
    // An author hides the whole card on the same rule.
    c.iff(washer.running).then(washer).condition == washer.running
    // A percentage, short of 100.
    c.progress(pct).running == cmp("sensor.pct", "gt", 0).and(cmp("sensor.pct", "lt", 100))
    // A battery's bar, named by hand, always shows; its countdown reads only
    // while it charges.
    local car = c.progress(onDevice(minutes("ch", "charging_time_left"), List(battery))).percent(battery)
    car.features[0] is barBaseMod.ProgressBar
    (car.slots["value"] as slotMod.Slot).valueWhile == cmp("sensor.ch", "gt", 0)
    // A status in an idle state means idle, whatever the numbers say.
    (washer) { defaults { progress { idleStates { "off" } } } }.running
      == cmp("sensor.rem", "gt", 0).and(cmp("sensor.st", "ne", "off"))
  }

  ["a sensor that is neither a countdown nor a percentage is a build error"] {
    module.catch(() -> c.progress(words("a", "firmware")).slots)
      .contains("c.progress(sensor.a) takes a countdown (a duration sensor) or a percentage (a % sensor)")
  }
}
