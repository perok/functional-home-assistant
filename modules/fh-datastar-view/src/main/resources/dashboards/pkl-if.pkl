// A Pkl-authored If/else dashboard — point a key at it from `dashboard.pkl`
// to serve it (ADR 0021).
// The demo entry for conditional sections. An `If` is the tabs machinery with
// a condition: each branch is an inline surface baked into the host's
// `{{{branch}}}` hole, and the ACTIVE member is selected by a condition over
// live entity state (server truth, shared by every viewer) instead of a
// click/selection. The hidden branch is not rendered and receives no updates;
// toggling the condition entity swaps the branch live in every open client.
//
// A condition NAMES the entities it reads — `q.entity(e)` for one, `q.from(…)`
// for a set. There is no quantifier: over a named set `any()` is `count > 0`
// and `none()` is `count == 0`, so what used to be "some entity in the house
// matches" is now the set the author actually meant.
//
// `amends "@fh-dashboard/entry.pkl"` supplies the `cards`/`theme` scaffold; this
// entry sets only `card` (its branches become hoisted surfaces at build time).
// (Plain `//` comments: a doc comment would attach to the first import, which
// Pkl rejects — entries have no `module` clause to absorb it.)

amends "@fh-dashboard/entry.pkl"

import "@fh-dashboard/components.pkl" as c
import "@fh-dashboard/query.pkl" as q
import "@fh-home/dump.pkl" as dump

local demoLight =
  dump.entities.light_skyconnect_v1_0_light_group_overetasje_stue_sittegruppe_gang

card = (c.column) {
  children {
    c.title("If/else")

    // BUILDER form: `iff(condition).then(card).`else`(card)` — `else` is a Pkl
    // reserved word, so its call sites are backticked. One entity, named once.
    c.iff(q.entity(demoLight).stateIs("on"))
      .then(c.title("Demo light is on"))
      .`else`(c.title("Demo light is off"))

    // AMEND form — multi-card branches list their cards directly (comma-free,
    // like a tab body); the outer parens around the amended call are mandatory.
    (c.iff(q.entity(demoLight).stateIsNot("on"))) {
      `then` {
        c.title("Something is off")
        c.entityCard(dump.entities.sensor_ams_1a4e_q)
      }
      `else` {
        c.title("All quiet")
      }
    }

    // A SET condition: shown while none of these are on. `none()` is a
    // comparison on the count of present members, so the runtime looks up the
    // candidates rather than scanning every entity. No `else` branch: while one
    // is on, the host bakes empty.
    c.iff(q.from(List(demoLight)).where(q.eq(q.stateProp, "on")).none())
      .then(c.entityCard(dump.entities.sensor_ams_1a4e_u1))
  }
}
