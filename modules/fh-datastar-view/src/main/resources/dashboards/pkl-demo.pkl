// The Pkl-authored demo dashboard. A MODULE, not a dashboard by itself: point
// a key at it from `dashboard.pkl` to serve it (ADR 0021).
// Exercises the MVP component set: entity
// cards (default value, live expr override, tap), a domain-checked slider,
// and cross-dashboard navigation back to the jsonnet default.
//
// `amends "@fh-dashboard/entry.pkl"` supplies the `cards`/`theme` scaffold; the
// entry sets only `surfaces` + `card`. `lib/dump.pkl` is GENERATED (by PklDump, from
// the live HA registry) when the server or build runs — like `dump.libsonnet`
// on the jsonnet track. (Plain `//` comments here: a doc comment would attach
// to the first import, which Pkl rejects — entries have no `module` clause.)

amends "@fh-dashboard/entry.pkl"

import "@fh-dashboard/components.pkl" as c
import "@fh-dashboard/query.pkl" as q
import "@fh-home/dump.pkl" as dump

// Registered popup surfaces: opened by an `openPopup("detail")` tap and
// rendered/streamed only while open. Amending the key into existence builds a
// `PopupSurface` (the mapping default from lib/entry.pkl), so the `popup`
// dialog wrap is automatic — the body lists the dialog's cards directly.
// Mirrors dashboard.jsonnet:42-52.
surfaces {
  ["detail"] {
    body {
      c.title("Power detail")
      c.entityCard(dump.entities.sensor_ams_1a4e_q)
      c.button("Close", c.tap.closePopup())
    }
  }
}


// The GRID is the default top-level container (HA "sections" feel): children
// flow as rows, each cell spanning `columns(n)` of 12 (default 4 — a third,
// HA's default card size); a partial row group-centers by default. Section
// titles span the full width so they break the flow like HA section headings.
// (`columns(n)`/`fullWidth()` are GRID-only — inside a row/column, cells
// share/fill instead. See ADR 0008.)
card = (c.grid) {
  children {
    c.title("Pkl demo").fullWidth()
    // Default display: friendly_name label, $state + auto-appended unit.
    // No layout builder -> the default third-grid cell.

    (c.column) {
      children {

        c.entityCard(dump.entities.sensor_ams_1a4e_q)

        // MORE-INFO on tap: everything we know about the entity — its live
        // state, whatever controls its domain has, and every attribute it
        // reports — in a popup the hoist builds from this card's own entity.
        // A sensor cannot be toggled, so this is the tap that makes sense for
        // one (issue #106).
        c.entityCard(dump.entities.sensor_ams_1a4e_q) |> c.informative

        // Live value expression + explicit tap service, BUILDER style: each option
        // is a method that returns the card, so they chain paren-free (vs the
        // mandatory-paren amend `(c.entityCard(x)) { ... }`). Pure sugar — the
        // emitted node is byte-identical (the wire snapshot guards this).
        c.entityCard(dump.entities.sensor_ams_1a4e_u1)
          .value(c.expr(#"$round($number($state), 1) & " V""#))
          .tapAction(c.tap.service("homeassistant/toggle"))

        // Domain-checked: only entities with a sliderSpec row (lights) compile.
        // A slider wants room — span the full grid width.
        (c.slider(dump.entities.light_skyconnect_v1_0_light_group_overetasje_stue_sittegruppe_gang)).fullWidth()
      }
    }


    // A QUERY with per-domain DISPATCH: a card per entity that is on, the card
    // chosen by the first matching case (author order = match order). The light
    // case is a bare `c.slider` value (its action/key/min/max/position resolve
    // per light at BUILD time, now that the candidate is a known entity);
    // `else` is the fallback for every other one, toggled on tap.
    //
    // The candidates are static — every entity in the house, decided when the
    // dump was built — and what the runtime decides is which of them are on and
    // in what order. Omitting `else` would be how you write "only while on";
    // here the guard is on the `where`, so an entity that is off simply has no
    // matching clause and is not rendered. The set's root is itself a grid cell
    // (fullWidth here); its members flow in its own 12-column grid, two-up.
    c.title("Active now").fullWidth()
    q.from(dump.all)
      .where(q.eq(q.stateProp, "on"))
      .caseOf(q.eq(q.prop("domain"), "light"), c.slider)
      .`else`((e) -> c.entityCard(e)
        .tapAction(c.tap.toggle)
        .label(c.expr(#"$attr.friendly_name & " (" & $state & ")""#)))
      .build()
      .fullWidth()

    // A SINGLE card and a numeric LIVE filter: every device_class:battery
    // sensor under 20%, tracked live as batteries drain. `device_class` is
    // registry data, so it selects the candidates at build time and never
    // reaches the runtime — `optional` because most sensors report none, and a
    // name only SOME candidates carry is an error rather than a silent live
    // attribute. The charge level is the sensor's state, so that half is live.
    c.title("Low battery").fullWidth()
    q.from(dump.sensors)
      .where(q.eq(q.optional(q.prop("device_class")), "battery"))
      .where(q.lt(q.stateProp, 20))
      .render((e) -> c.entityCard(e)
        .label(c.expr(#"$attr.friendly_name & " — " & $state & "%""#))
        .secondary("device_class"))
      .build()
      .fullWidth()

    // POPUPS. A COLUMN inside a grid cell: the three buttons stack vertically
    // in one half-grid cell (a column is just another cell — containers nest
    // freely in the grid). The first button opens the REGISTERED `detail`
    // surface; the second opens an INLINE popup whose content the build-phase
    // hoist lifts into a surface (keyed by this button's derived id + "_self").
    c.title("Popups").fullWidth()
    (c.row) {
      children {
        c.button("Power detail…", c.tap.openPopup("detail"))
        c.button("Quick info…", c.tap.openPopupInline(new c.Column {
          children {
            c.title("Quick info")
            c.entityCard(dump.entities.sensor_ams_1a4e_u1)
            c.button("Close", c.tap.closePopup())
          }
        }))
        c.button("« Back to jsonnet", c.tap.navigate("dashboard"))
      }
    }
  }
}
