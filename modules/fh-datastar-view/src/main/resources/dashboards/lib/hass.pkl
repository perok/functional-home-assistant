/// The Home Assistant domain schema: what the build-time dump carries
/// (`RegistryDump.scala`) — registry identity and capability attributes. Live
/// values (state, brightness, …) are never in the dump; they are read at run
/// time.
module hass

// `as` aliases, because Pkl binds an import to its file name and a bare
// `light` would read as a light entity.
import "hass/light.pkl" as hassLight
import "hass/lock.pkl" as hassLock
import "hass/sensor.pkl" as hassSensor
import "hass/binary_sensor.pkl" as hassBinarySensor

typealias EntityId = String(matches(Regex(#"[a-z_0-9]+\.[a-z0-9_]+"#)))

// Capability attributes (device_class, supported_color_modes, min/max, …) are
// not declared here: they sit on the per-entity class the dump generates, only
// on entities that report them, so reading a missing one is an eval error
// rather than a silent null (ADR 0013).
abstract class Entity {
  entity_id: EntityId
  domain: String
  friendly_name: String? = null
  area_id: String? = null
  floor_id: String? = null
  /// Hidden in HA's entity settings: left out of every scope's `all`, still
  /// reachable by name and through `allWithHidden`.
  id_hidden: Boolean = false
  /// The physical device this entity belongs to, if any (`dump.devices`).
  device_id: String? = null
  /// `"config"` or `"diagnostic"` for the entities HA keeps off its main
  /// dashboard (about half of a typical instance); null for a primary entity.
  entity_category: String? = null

  /// The live attributes this entity can report, as `name -> type name`. Names
  /// only, never values, so the dump's content hash cannot move with state.
  ///
  /// Derived from capability attributes rather than observed, because an
  /// unavailable entity drops its live attributes (2 kinds against 12 for one
  /// light). Empty means "domain not modelled", which `query.pkl` does not
  /// check against.
  hidden volatileAttrs: Mapping<String, String> = new {}

  /// The entities this one drives (a light group's bulbs), as references to
  /// the dump entities; groups nest. Empty for a plain entity.
  hidden members: List<Entity> = List()
}

typealias ColorMode = hassLight.ColorMode

typealias LightControl = hassLight.Control

typealias LockState = hassLock.LockState

typealias SensorDeviceClass = hassSensor.SensorDeviceClass

typealias SensorStateClass = hassSensor.SensorStateClass

/// What a binary sensor's `on` means — the only thing that says which of
/// `on`/`off` is the interesting one.
typealias BinarySensorDeviceClass = hassBinarySensor.BinarySensorDeviceClass

// ---- capability groups ----
//
// A capability whose values travel together is ONE nullable object: null means
// the entity lacks it, so the group is the predicate, and an unguarded read of a
// value is an eval error rather than a blank slot. Each group carries its owner,
// so a card takes the group alone (`c.entitySlider(l.colourTemp)`) and the
// editor can type-check the choice (ADR 0013, "Shapes considered").

/// One Home Assistant account that can log in (`dump.users`), named by access
/// rules (ADR 0023). Only real people: HA's system users are left out.
class User {
  user_id: String
  user_name: String
  is_admin: Boolean
  is_owner: Boolean
}

/// When an [[Axis]] is the one its entity is on: a live attribute holding one of
/// these values.
class AttrIn {
  attr: String
  values: List<String>
}

/// One value of an entity that a slider can drive: where it is read, how it is
/// written, its range, and, where the entity has several, when it is the one in
/// use. A capability group that is one extends this, so a card takes the group
/// and reads the rest off it, and a new axis is a class here, not a branch in
/// the card.
open class Axis {
  owner: Entity
  /// Its main-control name, which is also its value in the slider's `control`
  /// variable.
  name: String
  attr: String
  service: String
  key: String
  min: Int
  max: Int
  /// The attribute is a list and the value this element of it: the hue at
  /// `hs_color[0]`.
  element: Int? = null
  /// Sent after the value, in one list: `[h, 100]` is a hue at full saturation.
  sentWith: List<Int> = List()
  /// When the entity is on this axis now. Null is always.
  inUseWhen: AttrIn? = null
}

/// Present only on lights that dim; derived from the colour modes, since the
/// range is HA's own.
class Brightness extends Axis {
  owner: LightEntity
  name: "brightness" = "brightness"
  attr = "brightness"
  service = "light/turn_on"
  key = "brightness"
  min = 1
  max = 255
}

/// Present only on lights supporting `color_temp`. `PklDump` omits the group
/// rather than emit half of it.
class ColourTemp extends Axis {
  owner: LightEntity
  min_kelvin: Int
  max_kelvin: Int
  name: "colourTemp" = "colourTemp"
  attr = "color_temp_kelvin"
  service = "light/turn_on"
  key = "color_temp_kelvin"
  min = min_kelvin
  max = max_kelvin
  inUseWhen = new { attr = "color_mode"; values = List("color_temp") }
}

/// What an entity is set to, one value at a time: what it offers, where the
/// current one is read, and how a choice is written. A capability group that is
/// one extends this, so `c.select` takes the group and reads the rest off it,
/// as a slider does an [[Axis]].
open class Options {
  owner: Entity
  list: Listing<String>
  /// What it is called after the entity's id; null where the entity is the
  /// choice itself.
  name: String? = null
  /// The attribute holding the current value; null is the state.
  attr: String? = null
  service: String
  key: String
}

class Effects extends Options {
  owner: LightEntity
  name = "effects"
  attr = "effect"
  service = "light/turn_on"
  key = "effect"
}

/// A `select` entity's options: the state is the chosen one.
class SelectOptions extends Options {
  owner: SelectEntity
  service = "select/select_option"
  key = "option"
}

/// Present only on lights with a colour mode (`hass_light.COLOUR_MODES`). No
/// dump values: the hue range is HA's own, 0–360, so the group is the predicate
/// and the owner alone (`c.entitySlider(l.colour)`).
class Colour extends Axis {
  owner: LightEntity
  name: "colour" = "colour"
  attr = "hs_color"
  service = "light/turn_on"
  key = "hs_color"
  min = 0
  max = 360
  element = 0
  sentWith = List(100)
  inUseWhen = new { attr = "color_mode"; values = hassLight.COLOUR_MODES }
}

/// developers.home-assistant.io/docs/core/entity/light
open class LightEntity extends Entity {
  domain: "light" = "light"

  hidden colourModes: Listing<ColorMode> = new Listing {}

  /// The raw `LightEntityFeature` bitmask, for a bit the predicates below do
  /// not name: `hassLight.supports(l.supported_features, hassLight.FLASH)`.
  hidden supported_features: Int = 0

  hidden brightness: Brightness? =
    let (self = this) if (supportsBrightness) new Brightness { owner = self } else null
  hidden colourTemp: ColourTemp? = null
  hidden colour: Colour? = null
  hidden effects: Effects? = null
  /// What a slider can drive on this light, in HA's order.
  hidden axes: List<Axis> = List(brightness, colourTemp, colour).filterNonNull() as List<Axis>

  // Derived here, beside the vendored constants they read, not by the generator.
  hidden supportsColour: Boolean =
    colourModes.toList().any((m) -> hassLight.COLOUR_MODES.contains(m))
  /// HA converts a colour-temperature light's kelvin into the colour
  /// representations, so those lights report `rgb_color` too.
  hidden reportsRgbColour: Boolean =
    supportsColour || colourModes.toList().contains("color_temp")
  hidden supportsBrightness: Boolean =
    colourModes.toList().any((m) -> hassLight.DIMMABLE_MODES.contains(m))
  hidden supportsColourTemp: Boolean = colourTemp != null
  hidden supportsEffects: Boolean = effects != null
  hidden supportsFlash: Boolean =
    hassLight.supports(supported_features, hassLight.FLASH)
  hidden supportsTransition: Boolean =
    hassLight.supports(supported_features, hassLight.TRANSITION)

  // Checked against 45 lights: the colour modes predict this set exactly,
  // except integration-specific names, which `q.attr(name)` reaches.
  volatileAttrs = new {
    ["color_mode"] = "String"
    when (supportsBrightness) {
      ["brightness"] = "Int"
    }
    // The MODE, not `supportsColourTemp`: a light can report a temperature
    // without the dump knowing its bounds.
    when (colourModes.toList().contains("color_temp")) {
      ["color_temp_kelvin"] = "Int"
    }
    when (reportsRgbColour) {
      ["hs_color"] = "List<Float>"
      ["rgb_color"] = "List<Int>"
      ["xy_color"] = "List<Float>"
    }
    when (colourModes.toList().contains("rgbw")) {
      ["rgbw_color"] = "List<Int>"
    }
    when (colourModes.toList().contains("rgbww")) {
      ["rgbww_color"] = "List<Int>"
    }
    when (supportsEffects) {
      ["effect"] = "String"
    }
  }
}

/// developers.home-assistant.io/docs/core/entity/lock
///
/// Modelled in part. Not modelled: code entry (`code_format` still reaches an
/// author as an ordinary attribute, but there is no keypad primitive), a
/// distinct look for `jammed` (icons resolve at build time), and confirmation
/// before unlocking (only the latch has one, through an inline popup).
open class LockEntity extends Entity {
  domain: "lock" = "lock"

  hidden supported_features: Int = 0

  /// Whether this lock can release its latch (`lock/open`) as well as unlock.
  hidden supportsOpen: Boolean = supported_features.and(hassLock.OPEN) != 0

  volatileAttrs = new {
    ["changed_by"] = "String"
  }
}

/// developers.home-assistant.io/docs/core/entity/sensor
///
/// What a sensor means lives entirely in three registry attributes. Unlike other
/// capability attributes they are nullable (ADR 0013): a card branches on the
/// device class, and an absent one is common (an appliance's status sensors
/// declare none) — Pkl cannot branch on whether a property exists.
open class SensorEntity extends Entity {
  domain: "sensor" = "sensor"

  hidden device_class: SensorDeviceClass? = null

  /// Present only where HA records long-term statistics.
  hidden state_class: SensorStateClass? = null

  /// An open `String`: an integration may report any unit, and a home with one
  /// we have not vendored must keep evaluating.
  hidden unit_of_measurement: String? = null

  /// An `enum` sensor's states, in the integration's order.
  hidden options: Listing<String> = new Listing {}

  hidden isEnum: Boolean = device_class == "enum"
  hidden isDuration: Boolean = device_class == "duration"

  /// The state is an ISO 8601 instant, not arithmetic-safe as a string.
  hidden isInstant: Boolean =
    device_class != null && hassSensor.INSTANT_CLASSES.contains(device_class)

  /// The reading is a number a card may compute with: `state_class` is the
  /// strong signal, a unit the weaker one. An `enum`'s options are labels even
  /// when they look like numbers.
  hidden isNumeric: Boolean =
    !isEnum && !isInstant
      && (state_class != null || unit_of_measurement != null)

  /// Seconds per unit of a duration reading, or null when it has no fixed
  /// length: "45 minutes left" arrives as `45` from one appliance and `2700`
  /// from another.
  hidden durationSeconds: Number? =
    if (!isDuration || unit_of_measurement == null) null
    else hassSensor.DURATION_SECONDS.getOrNull(unit_of_measurement)
}

/// developers.home-assistant.io/docs/core/entity/binary-sensor
open class BinarySensorEntity extends Entity {
  domain: "binary_sensor" = "binary_sensor"

  hidden device_class: BinarySensorDeviceClass? = null

  /// What `on` reads as for this sensor, or null where nothing documented
  /// applies. The polarity is not uniform across classes.
  hidden onMeans: String? =
    if (device_class == null) null
    else hassBinarySensor.ON_MEANS.getOrNull(device_class)
}

open class SwitchEntity extends Entity {
  domain: "switch" = "switch"
}

open class NumberEntity extends Entity {
  domain: "number" = "number"
}

open class SelectEntity extends Entity {
  domain: "select" = "select"

  /// What it can be set to, in the integration's order.
  hidden options: Listing<String> = new Listing {}
  /// The same, as the choice `c.select(s)` reads.
  hidden choices: SelectOptions = let (self = this) new SelectOptions { owner = self; list = self.options }
}

/// developers.home-assistant.io/docs/core/entity/scene
///
/// Has no on or off: its state is when it was last activated, or `unknown`.
/// [[members]] are the entities it sets, for a scene HA defines; one an
/// integration supplies (a Hue scene) reports none.
open class SceneEntity extends Entity {
  domain: "scene" = "scene"
}

/// `on` while a run is in progress.
open class ScriptEntity extends Entity {
  domain: "script" = "script"
}

/// developers.home-assistant.io/docs/core/entity/button
///
/// Its state is when it was last pressed, as a scene's is.
open class ButtonEntity extends Entity {
  domain: "button" = "button"
}

/// A helper button: [[ButtonEntity]]'s state, defined in HA rather than by an
/// integration.
open class InputButtonEntity extends Entity {
  domain: "input_button" = "input_button"
}

/// What is fired rather than switched: `c.tap.activate(x)` takes any of them.
typealias Activatable = SceneEntity|ScriptEntity|ButtonEntity|InputButtonEntity

/// Every domain without a class of its own; add one (and a `PklDump` row) to
/// specialise a domain.
open class GenericEntity extends Entity {}

// ---- registry structure (the generated dump subclasses these) ----

/// Every scope answers one name, `all` (entity-id order), and a domain comes
/// out of it through a selector, so a new domain is one function rather than a
/// list on every scope:
///
///     lights(dump.floors.loft.all)   // every light upstairs
///     locks(dump.areas.stue.all)     // this room's locks
abstract class Area {
  area_id: String
  area_name: String
  floor_id: String? = null
  /// Filled by the generated subclass.
  hidden allWithHidden: List<Entity> = List()
  hidden all: List<Entity> = shown(allWithHidden)
}

abstract class Floor {
  floor_id: String
  floor_name: String
  hidden areas: List<Area> = List()
  /// Vertical order from the floor registry; a basement is negative.
  level: Int? = null

  // Derived, so a floor's entities cannot disagree with its areas'.
  hidden all: List<Entity> = areas.flatMap((a) -> a.all)
  hidden allWithHidden: List<Entity> = areas.flatMap((a) -> a.allWithHidden)
}

/// One physical device, a grouping orthogonal to area/floor.
abstract class Device {
  device_id: String
  device_name: String
  area_id: String? = null
  manufacturer: String? = null
  model: String? = null
  hidden entities: List<Entity> = List()

  hidden allWithHidden: List<Entity> = entities
  hidden all: List<Entity> = shown(entities)
}

const function shown(scope: List<Entity>): List<Entity> =
  scope.filter((e) -> !e.id_hidden)

// ---- domain selectors ------------------------------------------------------
//
// One per modelled domain. A new one also leaves `generic`, in the same edit,
// which is what keeps the selectors a partition of `all`.

function lights(scope: List<Entity>): List<LightEntity> =
  scope.filter((e) -> e is LightEntity) as List<LightEntity>

function locks(scope: List<Entity>): List<LockEntity> =
  scope.filter((e) -> e is LockEntity) as List<LockEntity>

function sensors(scope: List<Entity>): List<SensorEntity> =
  scope.filter((e) -> e is SensorEntity) as List<SensorEntity>

function binarySensors(scope: List<Entity>): List<BinarySensorEntity> =
  scope.filter((e) -> e is BinarySensorEntity) as List<BinarySensorEntity>

function switches(scope: List<Entity>): List<SwitchEntity> =
  scope.filter((e) -> e is SwitchEntity) as List<SwitchEntity>

function scenes(scope: List<Entity>): List<SceneEntity> =
  scope.filter((e) -> e is SceneEntity) as List<SceneEntity>

function scripts(scope: List<Entity>): List<ScriptEntity> =
  scope.filter((e) -> e is ScriptEntity) as List<ScriptEntity>

function buttons(scope: List<Entity>): List<ButtonEntity> =
  scope.filter((e) -> e is ButtonEntity) as List<ButtonEntity>

function inputButtons(scope: List<Entity>): List<InputButtonEntity> =
  scope.filter((e) -> e is InputButtonEntity) as List<InputButtonEntity>

/// The entities no selector claims. A number or select lands here despite its
/// typed class: nothing has wanted every number in the house as a group yet.
function generic(scope: List<Entity>): List<Entity> =
  scope.filter((e) ->
    !(e is LightEntity) && !(e is LockEntity)
      && !(e is SensorEntity) && !(e is BinarySensorEntity)
      && !(e is SwitchEntity) && !(e is SceneEntity)
      && !(e is ScriptEntity) && !(e is ButtonEntity)
      && !(e is InputButtonEntity))
