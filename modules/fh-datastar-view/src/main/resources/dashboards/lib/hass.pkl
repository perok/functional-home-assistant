/// Hand-written Home Assistant domain schema for the Pkl authoring track.
///
/// Types exactly what the build-phase dump carries (see `RegistryDump.scala`):
/// registry identity + the per-domain attributes the dump carries.
/// Live values (state, brightness, ...) stay runtime-side as JSONata over the
/// SSE stream — never in the build-time dump (phase discipline).
///
/// Pkl gotchas honored throughout the Pkl track:
///   - `override` is a reserved keyword — never use it as an identifier;
///   - module-level properties referenced from class bodies must be `const`;
///   - local functions used from class bodies need `const local`.
module hass

// HA's own `light` domain constants (ColorMode, LightEntityFeature), vendored.
// Re-exported below as `ColorMode` so the generated dump can type its colour
// modes without a second import. (A `///` doc comment cannot attach to an
// import in Pkl — it is a parse error.) The `as` alias keeps the reading clear:
// a bare `import "hass/light.pkl"` would bind the name `light`, which reads as a
// light ENTITY rather than as HA's light-domain constants.
import "hass/light.pkl" as hassLight

// HA's own `lock` domain constants (LockState, LockEntityFeature), vendored —
// same reasoning as the light import above.
import "hass/lock.pkl" as hassLock

typealias EntityId = String(matches(Regex(#"[a-z_0-9]+\.[a-z0-9_]+"#)))

abstract class Entity {
  entity_id: EntityId
  domain: String
  friendly_name: String? = null
  area_id: String? = null
  floor_id: String? = null
  id_hidden: Boolean = false
  /// The physical device this entity belongs to, if any — helpers and
  /// integrations without hardware have none. Look it up in `dump.devices`.
  device_id: String? = null
  /// Registry classification: `"config"` or `"diagnostic"` for the entities HA
  /// keeps off the main dashboard (about half of a typical instance), null for
  /// a primary entity. Only the entity REGISTRY carries this — it is not a
  /// state attribute — so it is the sharpest filter available for cutting a
  /// dynamic group down to the things a person actually looks at.
  entity_category: String? = null

  /// The LIVE attributes this entity can report, as `name -> type name`.
  ///
  /// Names and types ONLY — there is nowhere here for a value to go, and that
  /// is deliberate: a value slot is the thing that later gets helpfully filled
  /// in with the live reading, which would churn the dump's content hash on
  /// every state change. This carries no values, so it cannot.
  ///
  /// DERIVED from capability attributes, never observed. Observing what an
  /// entity currently reports is unsafe — an unavailable entity drops its
  /// volatile attributes (measured: an unavailable light reports 2 kinds where
  /// an available one reports 12), so one bulb leaving the mesh would delete an
  /// attribute and re-evaluate every dashboard. Capability attributes survive
  /// unavailability, so a schema computed from them inherits that stability.
  ///
  /// EMPTY means "this domain is not modelled", not "this entity has no live
  /// attributes" — coverage is progressive, exactly like the capability typing
  /// above, and `query.pkl` checks a name only against a NON-empty schema. So
  /// an unmodelled domain is untouched rather than newly rejected.
  hidden volatileAttrs: Mapping<String, String> = new {}

  // NOTE: capability attributes (device_class, supported_color_modes,
  // effect_list, min/max/step, options, ...) are deliberately NOT declared here.
  // They live on the per-entity class the dump generates, and ONLY on the
  // entities that actually report them, so reading one off an entity that has
  // no such capability is a Pkl error ("Cannot find property") rather than a
  // silent null. See ADR 0013, "Capabilities are per-entity, not nullable
  // fields".

  /// The entities this one drives, as REFERENCES to the real dump entities —
  /// an HA Light Group helper or a Zigbee group fans out to its members, so
  /// `e.members.map((m) -> m.entity_id)` reaches the individual bulbs and
  /// `e.members[0].members` walks a group nested inside a group. Empty for a
  /// plain entity. Authoring convenience, never rendered into dashboard JSON.
  hidden members: List<Entity> = List()
}

/// A light's supported colour modes, typed against HA's own `ColorMode` enum —
/// so `"colour_temp"` is an eval error, not a silently-never-matching string.
typealias ColorMode = hassLight.ColorMode

/// The states a lock reports — see [[hassLock.LockState]] for why nothing is
/// typed against it yet.
typealias LockState = hassLock.LockState

// ---- domain classes ----
// Each carries its domain literal and its capability PREDICATES, nothing else.
// They exist so a value can be typed by domain (`List<LightEntity>`, a card
// factory that only accepts a light), and each is `open` because the generated
// dump extends it once per entity to add that entity's own capability VALUES.

// ---- capability groups ----
// A capability whose values travel together becomes ONE nullable object rather
// than several independent nullable fields. Two things follow, and both are the
// reason for the shape:
//
//   - `null` means the light does not have the capability, so the group IS the
//     predicate — `l.colourTemp != null` needs no parallel `supportsX` flag
//     that could disagree with it;
//   - values are reached THROUGH the group, so one guard covers all of them and
//     an unguarded read is an eval error ("Cannot find property `min_kelvin` in
//     object of type `Null`") rather than a null that renders as a blank slot.
//
// A capability with no associated values stays a derived Boolean below — a group
// with no fields would carry nothing.

// Each group carries its OWNER — the entity whose capability it is. That is
// what lets a card take the group ALONE and still know its subject, so the
// entity is named once (`c.slider(l.colourTemp)`) and no second argument can
// disagree with it. It also keeps the choice checkable in the editor: passing
// a group is an argument whose type pkl-lsp reads, where deriving one inside
// an amend (`on = entity.colourTemp`) makes it fall back to the declared type
// and flag valid lines. See ADR 0013, "Shapes considered".

/// The colour-temperature range, present only on lights supporting `color_temp`.
/// Both bounds are set whenever this is non-null; `PklDump` omits the whole
/// group rather than emitting a half of it (and warns when HA reports a half).
/// One Home Assistant account that can log in — what `@fh-home`'s `dump.users`
/// is made of, and what an access rule names (ADR 0023).
///
/// Only real PEOPLE reach the dump: HA's own listing also carries Supervisor,
/// Cast and the content user, two of which are admins, and none of which is
/// somebody a dashboard could belong to.
///
/// `user_id` is the opaque HA id the backend compares against; the rest is here
/// so a dashboard can read a name or branch on a role without a second lookup.
class User {
  user_id: String
  user_name: String
  is_admin: Boolean
  is_owner: Boolean
}

class ColourTemp {
  owner: LightEntity
  min_kelvin: Int
  max_kelvin: Int
}

/// The named effects a light exposes.
class Effects {
  owner: LightEntity
  list: Listing<String>
}

/// developers.home-assistant.io/docs/core/entity/light
open class LightEntity extends Entity {
  domain: "light" = "light"

  // ---- what the dump emits: DATA, not conclusions ----

  /// The colour modes HA reports. Mandatory for a light, so this is not
  /// nullable — a light that somehow reports none gets an empty Listing.
  hidden colourModes: Listing<ColorMode> = new Listing {}

  /// The raw `LightEntityFeature` bitmask. Prefer the derived predicates below;
  /// this is here so an author can test a bit the schema does not name yet, via
  /// `hassLight.supports(l.supported_features, hassLight.FLASH)`.
  hidden supported_features: Int = 0

  hidden colourTemp: ColourTemp? = null
  hidden effects: Effects? = null

  // ---- what the schema DERIVES ----
  // Deliberately computed here rather than baked in by the generator, so the
  // rule for "what counts as colour" lives in exactly one place next to the
  // vendored constants it reads.

  hidden supportsColour: Boolean =
    colourModes.toList().any((m) -> hassLight.COLOUR_MODES.contains(m))
  /// Whether this light reports `rgb_color` live: a colour-mode light does,
  /// and HA CONVERTS a colour-temperature light's temperature into the colour
  /// representations, so those arrive together with the kelvin. The build-time
  /// fact a fill-colour expression needs to know which of its branches are
  /// dead (verified against the live set along with the rest of
  /// [[volatileAttrs]]).
  hidden reportsRgbColour: Boolean =
    supportsColour || colourModes.toList().contains("color_temp")
  hidden supportsBrightness: Boolean =
    colourModes.toList().any((m) -> hassLight.DIMMABLE_MODES.contains(m))
  hidden supportsColourTemp: Boolean = colourTemp != null
  hidden supportsEffects: Boolean = effects != null
  hidden supportsFlash: Boolean =
    hassLight.supports(supported_features, hassLight.FLASH)
  hidden supportsTransition: Boolean =
    hassLight.supports(supported_features, hassLight.TRANSITION)

  /// What a light reports live, derived from the modes it supports.
  ///
  /// Verified against 45 available lights: `supported_color_modes` predicts
  /// this set EXACTLY. The only attributes it does not predict are
  /// integration-specific (`off_brightness` and `off_with_transition` from Hue,
  /// `group_entities` from light-group helpers) — those are reachable through
  /// `query.attr(name)`, which is the "I mean a live attribute, do not check
  /// it" spelling.
  volatileAttrs = new {
    // Every light reports which mode it is CURRENTLY in, `onoff` included.
    ["color_mode"] = "String"
    when (supportsBrightness) {
      ["brightness"] = "Int"
    }
    // Keyed on the MODE, not on `supportsColourTemp` — that one asks whether we
    // know the kelvin BOUNDS (the `colourTemp` group, which the slider needs),
    // and a light can report a colour temperature without us having them.
    when (colourModes.toList().contains("color_temp")) {
      ["color_temp_kelvin"] = "Int"
    }
    // A colour-TEMP light reports the colour representations too — HA converts
    // the temperature into them, so all four arrive together. That is why this
    // is not simply `supportsColour` (see [[reportsRgbColour]]).
    when (reportsRgbColour) {
      ["hs_color"] = "List<Float>"
      ["rgb_color"] = "List<Int>"
      ["xy_color"] = "List<Float>"
    }
    when (colourModes.toList().contains("rgbw")) {
      ["rgbw_color"] = "List<Int>"
    }
    when (colourModes.toList().contains("rgbww")) {
      ["rgbww_color"] = "List<Int>"
    }
    when (supportsEffects) {
      ["effect"] = "String"
    }
  }
}

/// developers.home-assistant.io/docs/core/entity/lock
///
/// MODELLED IN PART, and the part is chosen by what a card can currently do:
///
///   - the OPEN feature bit, because it decides whether a second control
///     (`lock/open`, releasing the latch) belongs on the card at all;
///   - `changed_by`, because it is the one live attribute a lock reports
///     besides its state.
///
/// NOT modelled, each for a stated reason rather than for lack of a doc page:
///
///   - **code entry.** A lock reporting `code_format` wants a keypad before
///     `lock/unlock`, and there is no input primitive in the component layer to
///     build one from. `code_format` still reaches an author — it falls through
///     to the per-entity class as an ordinary attribute (ADR 0013) — so a
///     dashboard can SEE that a lock wants a code even though no shipped card
///     asks for one.
///   - **a jammed state that looks different.** `jammed` renders as the value
///     text and nothing more. Making it look alarming needs a state-dependent
///     look, and this project resolves an icon at BUILD time (`core/icon.pkl`).
///   - **a `dump.locks` list.** The house-wide lists are `lights`/`sensors`/
///     `switches`/`generic`, so a lock arrives in `generic` and a dashboard
///     reaches it by name or by `q.from(dump.all).where(domain == "lock")`.
///     Adding a list per modelled domain touches `internal/dump-base.pkl`, the
///     area classes and the floor classes together; worth doing once for
///     several domains, not once per domain.
///   - **confirmation before unlocking.** There is no confirm primitive in
///     `core/tap.pkl`; adding one is a decision about taps in general, not
///     about locks, and would land the same way for `siren` and `alarm_control_panel`.
open class LockEntity extends Entity {
  domain: "lock" = "lock"

  /// The raw `LockEntityFeature` bitmask, as the dump read it.
  hidden supported_features: Int = 0

  /// Whether this lock can release its latch (`lock/open`) as well as unlock.
  hidden supportsOpen: Boolean = supported_features.and(hassLock.OPEN) != 0

  /// A lock reports what moved it last, and nothing else that moves. Its STATE
  /// is the reading a card shows, and that is not an attribute.
  volatileAttrs = new {
    ["changed_by"] = "String"
  }
}

open class SensorEntity extends Entity {
  domain: "sensor" = "sensor"
}

open class SwitchEntity extends Entity {
  domain: "switch" = "switch"
}

open class NumberEntity extends Entity {
  domain: "number" = "number"
}

open class SelectEntity extends Entity {
  domain: "select" = "select"
}

/// Fallback for every domain without a dedicated class yet — add a typed
/// class (and a PklDump dispatch row) to specialize a domain.
open class GenericEntity extends Entity {}

// ---- registry structure (generated dump.pkl subclasses these) ----

abstract class Area {
  area_id: String
  area_name: String
  floor_id: String? = null
  // Per-domain member lists for iteration; the generated subclass fills them.
  // Hidden: authoring convenience only, never rendered into dashboard JSON.
  hidden lights: List<LightEntity> = List()
  hidden sensors: List<SensorEntity> = List()
  hidden switches: List<SwitchEntity> = List()
  hidden generic: List<Entity> = List()
  hidden all: List<Entity> = lights + sensors + switches + generic
}

abstract class Floor {
  floor_id: String
  floor_name: String
  hidden areas: List<Area> = List()
  /// Vertical ordering from the floor registry — a basement is negative. Lets a
  /// dashboard sort floors the way the house is stacked instead of by name.
  level: Int? = null

  // The same five names as [[Area]] and the dump's house-wide lists, so the
  // three scopes are one vocabulary. DERIVED from `areas` rather than filled by
  // the generator: a floor's entities are its areas' entities by definition, and
  // deriving them keeps that impossible to disagree about.
  hidden lights: List<LightEntity> = areas.flatMap((a) -> a.lights)
  hidden sensors: List<SensorEntity> = areas.flatMap((a) -> a.sensors)
  hidden switches: List<SwitchEntity> = areas.flatMap((a) -> a.switches)
  hidden generic: List<Entity> = areas.flatMap((a) -> a.generic)
  hidden all: List<Entity> = areas.flatMap((a) -> a.all)
}

/// One physical device. The OTHER grouping an entity belongs to, orthogonal to
/// area/floor: a single bulb or appliance usually exposes a handful of entities
/// (the light itself plus firmware/identify/config ones), and `entities` holds
/// them all so a card can render a device as a unit.
abstract class Device {
  device_id: String
  device_name: String
  area_id: String? = null
  manufacturer: String? = null
  model: String? = null
  hidden entities: List<Entity> = List()

  // The shared five again. `entities` is the raw list the generator fills, and
  // `all` is its alias — one name for "everything in this scope" wherever you
  // are. The per-domain ones are type tests over it, which is why a device's
  // lists need no generator support: a device is a handful of entities, not a
  // registry join.
  hidden all: List<Entity> = entities
  hidden lights: List<LightEntity> =
    entities.filter((e) -> e is LightEntity) as List<LightEntity>
  hidden sensors: List<SensorEntity> =
    entities.filter((e) -> e is SensorEntity) as List<SensorEntity>
  hidden switches: List<SwitchEntity> =
    entities.filter((e) -> e is SwitchEntity) as List<SwitchEntity>
  hidden generic: List<Entity> = entities.filter((e) ->
    !(e is LightEntity) && !(e is SensorEntity) && !(e is SwitchEntity))
}
