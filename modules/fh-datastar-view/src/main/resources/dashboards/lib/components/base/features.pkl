/// A card and the controls that belong to it, in one box — knows nothing about
/// Home Assistant; the lock card is what puts its latch here.
module components.base.features

import "../../core/node.pkl" as nodes

/// A card and its FEATURES — HA's own shape, where a tile carries controls that
/// belong to the entity but are not the tile's own tap (`hui-card-features`).
///
/// A WRAPPER rather than a region on the entity card, and both halves of that are
/// forced. A card declaring a region is STRUCTURE, and `core/node.pkl` forbids
/// structure from carrying a live BYTE slot — an entity card has several (a
/// query-rendered member's `label`, a `CallByState` tap's `onclick`), so it
/// cannot hold a region and them at once. And a feature must sit OUTSIDE the
/// tappable element: nested inside it, one press on a lock's latch would post
/// `lock/open` and the tile's own `lock/lock` together.
///
/// This card holds no slots at all, so it is structure with nothing live in it,
/// and the tile it wraps is untouched — which is also why a state tick repaints
/// the tile and leaves the features alone.
class CardFeatures extends nodes.Node {
  card = "cardFeatures"
  cardDef = new nodes.CardDef {
    regions = new Mapping {
      ["content"] = new nodes.Region {}
      ["actions"] = new nodes.Region {}
    }
    template = """
      <article class="card fh-features">
        <div class="fh-features-content">{{#content}}{{{html}}}{{/content}}</div>
        <div class="fh-features-actions">{{#actions}}{{{html}}}{{/actions}}</div>
      </article>
      """
    // The wrapper wears the card chrome and the tile inside it sheds it, so the
    // two read as ONE card rather than a card with a second one stacked under
    // it. Nothing here knows the theme: `.card` is what the tile already asked
    // for, this only moves which element gets it.
    //
    // An `<article>`, because that is what BeerCSS paints a card box on — the
    // `card` CLASS is how `base/button.pkl` spells a rectangular BUTTON, and on a
    // `<div>` it draws nothing. A `<div class="card">` here left the lock
    // floating on the page background with no box at all.
    //
    // The strip selector walks the exact chain `.fh-features-content > .fh-cell
    // > <the card root>`: every node is cell-wrapped (ADR 0008), so a `>` from
    // the content misses the tile entirely, while a descendant selector on
    // `.card` would also catch a feature button and strip its paint. Naming the
    // chain hits the wrapped card and nothing else, whatever card it is.
    css = """
      .fh-features{display:flex;flex-direction:column}
      .fh-features-content>.fh-cell>*{background:none;box-shadow:none;border:0;
      padding:0;margin:0}
      .fh-features-actions{display:flex;gap:.5rem;margin-block-start:.75rem}
      .fh-features-actions>*{flex:1 1 0}
      """
  }
  hidden tile: nodes.LayoutNode
  hidden actions: Listing<nodes.LayoutNode> = new {}
  children = new Mapping {
    ["content"] = new Listing { tile }
    ["actions"] = actions
  }
}

/// `withFeatures(c.entityCard(e), List(button))` — the tile, then its
/// controls beneath it in the same card box. See [[CardFeatures]].
function withFeatures(
  card: nodes.LayoutNode,
  xs: List<nodes.LayoutNode>
): CardFeatures = new CardFeatures { tile = card; actions = xs.toListing() }
