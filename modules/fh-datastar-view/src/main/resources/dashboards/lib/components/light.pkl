/// Light composition: the controls a light supports, and none it does not.
/// A card takes a capability GROUP, which carries its `owner`, so the entity is
/// named once and a control aimed at a light lacking the capability cannot be
/// written (ADR 0013). Other domains follow this pattern.
module components.light

import "../hass.pkl"
import "../layout.pkl" as layout
import "entity.pkl" as entityMod
import "select.pkl" as selectMod
import "slider.pkl" as sliderMod

/// A brightness slider when it dims (a tappable card when it only switches), a
/// colour-temperature slider when it has a kelvin range, a hue slider when it
/// shows colour, an effect dropdown when it names effects: every control at once,
/// where `c.entitySlider(l)` switches between them.
function controls(l: hass.LightEntity): layout.Column = new layout.Column {
  children {
    when (l.supportsBrightness) {
      sliderMod.entitySlider(l).buttons(List())
    } else {
      (entityMod.entityCard(l)) |> entityMod.tappable
    }
    when (l.colourTemp != null) {
      sliderMod.entitySlider(l.colourTemp!!)
    }
    when (l.colour != null) {
      sliderMod.entitySlider(l.colour!!)
    }
    when (l.effects != null) {
      selectMod.select(l.effects!!).style("dropdown")
    }
  }
}
