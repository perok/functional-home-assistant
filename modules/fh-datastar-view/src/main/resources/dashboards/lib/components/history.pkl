/// History cards, as `c.history`: a chart of one sensor's recorded past drawn on
/// the server, and a window chooser over charts. What a chart reads is the
/// `history` provider's (`providers/history.pkl`, as `p.history`).
///
/// The chart arrives as SVG in the card's bytes, so it morphs, caches and
/// resumes like any other leaf.
module components.history

import "../core/node.pkl" as nodes
import "../core/slot.pkl" as slotMod
import "../core/variable.pkl" as varMod
import "../providers.pkl" as providersMod
import "../providers/history.pkl" as historyProv
import "base/chart.pkl" as chartMod
import "select.pkl" as selectMod
import "../hass.pkl"

/// One entity's readings over one window. The SVG goes in a RAW hole
/// (`{{{chart}}}`); the backend rejects an escaped one at build time.
class HistoryChart extends nodes.Node {
  card = "historyChart"
  cardDef = new nodes.CardDef {
    template = """
      <div class="fh-card fh-chart">{{{chart}}}</div>
      """
    slots { "chart" }
    // The SVG carries its own `viewBox`: drawn once per cache bucket, scaled
    // by the browser to the cell.
    css = """
      .fh-chart{padding:.25rem}
      .fh-chart svg{display:block;inline-size:100%;block-size:auto;font-size:12px}
      """
  }

  hidden entity: hass.SensorEntity

  /// The window drawn, written down or chosen by a node variable.
  hidden window: historyProv.Over = historyProv.presets["24h"]

  /// The drawing's own size in SVG units; null for the backend's default. The
  /// SVG scales to its cell, so this sets the proportions and how large the
  /// labels read against the line, not the pixels on screen (ADR 0032).
  hidden chartWidth: Int(isPositive)? = null
  hidden chartHeight: Int(isPositive)? = null

  slots {
    ["chart"] = new slotMod.Slot {
      fetch = historyProv.of(entity, window)
      transform = chartMod.chartStage(chartWidth, chartHeight, entity.unit_of_measurement)
    }
  }

  /// A window from the providers, imported or handed in:
  /// `.over((p) -> p.history.statistics(7.d, "hour"))`.
  function over(w: providersMod.HistoryWindow): HistoryChart =
    let (self = this) (self) { window = providersMod.historyWindow(w) }

  /// Draw at `w`×`h` instead of the default — wider for a full-width panel,
  /// narrower so labels read larger on a small cell.
  function size(w: Int(isPositive), h: Int(isPositive)): HistoryChart =
    let (self = this) (self) { chartWidth = w; chartHeight = h }

  /// Read the window from the nearest [[chooser]] above this chart.
  function fromChooser(): HistoryChart =
    over(historyProv.chosen(windowVar, historyProv.presets))
}

/// A chart of `e`'s last 24 hours — `.over((p) -> p.history.statistics(7.d,
/// "hour"))` for any other window. A [[hass.SensorEntity]] because only a
/// numeric one charts; [[hass.SensorEntity.isNumeric]] lets a composition ask
/// before it draws.
function chart(e: hass.SensorEntity): HistoryChart = new HistoryChart { entity = e }

/// The node variable [[chooser]] declares and [[HistoryChart.fromChooser]]
/// reads. Fixed rather than an argument on either, so the pair cannot drift.
const windowVar: varMod.Variable = new { name = "window" }

/// A window bar over the charts beneath it: press `7d` and every
/// [[HistoryChart.fromChooser]] in this subtree redraws at a week.
///
///     (c.history.chooser) {
///       children { c.history.chart(sensor).fromChooser() }
///     }
hidden chooser: selectMod.Chooser =
  selectMod.chooser(selectMod.select(windowVar).options(historyProv.presets.keys.toList()))
    .defaultingTo("24h")
