/// The value slider, and the per-domain table that tells it what it drives.
///
/// Give it children and the same card is a GROUP: the slider becomes the head
/// and the children are the members it stands for.
module components.slider

import "../core/icon.pkl" as icons
import "../core/node.pkl" as nodes
import "../core/slot.pkl" as slotMod
import "../core/tap.pkl" as tapMod
import "../hass.pkl"

// The slider's controllable config per domain: the service to call, the
// service_data key the value rides on, the range bounds, and which attribute
// is the live position. Add a domain (cover/fan/climate…) by adding a row —
// TYPED: a missing/misspelled field is a build error. A slider resolves its
// config AT BUILD TIME from the entity's domain, as baked literals — always,
// now that a set's candidates are known entities.
class SliderSpec {
  action: String
  key: String
  min: Int
  max: Int
  value: String
}

const sliderSpec: Mapping<String, SliderSpec> = new {
  ["light"] = new { action = "light/turn_on"; key = "brightness"; min = 1; max = 255; value = "brightness" }
  ["cover"] = new { action = "cover/set_cover_position"; key = "position"; min = 0; max = 100; value = "current_position" }
  ["fan"] = new { action = "fan/set_percentage"; key = "percentage"; min = 0; max = 100; value = "percentage" }
}

// The slider fill colour from the entity's own light attributes: an explicit
// `rgb_color` wins, else `color_temp_kelvin` interpolated over the mired-free
// 2000K..6500K span between a warm amber and a cool white — the same ramp HA's
// own temperature picker shows. Null for every entity that reports neither
// (covers, fans, a light that is off), which the slot's default turns back into
// `currentcolor`.
const local sliderFillColor: String =
  #"($rgb := $attr.rgb_color; $k := $attr.color_temp_kelvin; $count($rgb) = 3 "#
  + #"? "rgb(" & $string($rgb[0]) & "," & $string($rgb[1]) & "," & $string($rgb[2]) & ")" "#
  + #": $k != null ? ($t := $k < 2000 ? 0 : ($k > 6500 ? 1 : ($k - 2000) / 4500); "#
  + #""rgb(" & $string($round(255 - 54 * $t)) & "," & $string($round(166 + 60 * $t)) "#
  + #"& "," & $string($round(87 + 168 * $t)) & ")") : null)"#

// The dragged position as a percentage of the card's own range, in JS — the
// client-side twin of `percentExpr`'s JSONata, spliced into the template so the
// range arrives through the `min`/`max` SLOTS. It cannot read `minExpr`/
// `maxExpr` instead: `cardDef` is shared by every slider on the page, and
// reading this card's own entity there closes the `on`/`entity` mutual default
// into a stack overflow.
//
// `evt.target.value` rather than the bound signal, because `data-bind` listens
// for `input` on this same element and the earlier-registered listener wins —
// off the event there is no ordering to get wrong.
const local dragPos: String = "((evt.target.value - {{min}}) * 100 / ({{max}} - {{min}}))"

// A slider config slot (action/key/min/max): author override, else the spec
// literal (stringified — the backend slot decoder rejects numbers).
//
// There used to be a third tier, a `$lookup($domain)` JSONata transform, for a
// slider whose entity was a `$self` placeholder. It was the plan's motivating
// example: four `reactive: false` transforms per member computing a BUILD-TIME
// fact at runtime, because the entity was unknown at build time. A candidate
// set knows it, so all four are literals and the tier is gone.
// `override` is a Pkl reserved word — the param is `ovr`.
const local function sliderConfig(ovr: String?, spec: SliderSpec, get: (SliderSpec) -> Any): String =
  if (ovr != null) ovr else "\(get.apply(spec))"

/// What a [[Slider]] drives: an ENTITY (its domain's default axis — a light's
/// brightness, a cover's position) or one of that entity's capability GROUPS
/// (`l.colourTemp`). The group carries its `owner`, so passing one names the
/// entity exactly once and the slider derives everything else from it.
///
/// This union is the "which axis" decision as a VALUE rather than a name, which
/// is what keeps a wrong choice visible in the editor: `c.slider(l.colourTemp)`
/// on a light with no kelvin range is a nullability mismatch pkl-lsp reports
/// without evaluating. A selector enum or a `.colourTemp()` builder method
/// would both hide the choice from it — see ADR 0013, "Shapes considered".
typealias SlideAxis = hass.Entity|hass.ColourTemp

/// The named readings a slider's line offers beside its label — the two that
/// need the card's own axis config, plus "nothing". Anything else is an
/// [[Expr]]; see [[Slider.readout]].
typealias Readout = "state"|"percent"|"none"

/// Value slider. Takes an entity whose domain has a sliderSpec row, and bakes
/// that config in at build time. A slider on e.g. a sensor is a BUILD error
/// naming the dashboard line — including inside a query, where the fold drops a
/// branch whose guard cannot hold before its render lambda is applied.
///
/// Give it CHILDREN and the same card is a GROUP: the slider becomes the head
/// (the group light, the cover group) and the children are the members it
/// stands for, stacked inside it with the master's fill painted across the
/// whole card behind them — one control with its parts shown, not a titled
/// list.
///
///   (c.slider(dump.entities.light_lys)) {
///     icon = "mdi:lightbulb-group"
///     secondary = c.exprOf(dump.entities.sensor_kitchen_temp, #"$state & " °C""#)
///     tap = c.toggle
///     children { c.slider(a).readout("percent") c.slider(b).readout("percent") }
///   }
///
/// One card rather than a separate group card, because the members are
/// ORDINARY nodes: a member can be another grouped slider (nesting works by
/// construction), an [[EntityCard]], or a [[DynamicGroup]] of everything in an
/// area, and each keeps its own entity, its own domain config and its own live
/// patch. [[sliderGroup]] is the shorthand for the common "a master and its
/// member entities" case.
///
/// The head is the card's `self` and the members its `mount`, so a state change
/// on the master repaints the head alone and never the rows (ADR 0012) — the
/// reason this is a container card even when it holds nothing.
class Slider extends nodes.Node {
  card = "slider"
  /// WHAT this slider drives — see [[SlideAxis]]. Setting `entity` directly
  /// still works and means the domain's default axis; the two default to each
  /// other, so exactly one of them is ever needed.
  hidden on: SlideAxis = entity
  hidden entity: hass.Entity(sliderSpec.containsKey(domain)) =
    if (on is hass.ColourTemp) on.owner else on
  hidden label: (String|slotMod.Expr)? = null
  // Per-instance overrides of the domain default. Each DEFAULTS to what the
  // axis says, so a capability axis configures the whole slider and an author
  // amending one of these still wins (late binding re-derives `slots`).
  hidden action: String? = if (on is hass.ColourTemp) "light/turn_on" else null
  hidden key: String? = if (on is hass.ColourTemp) "color_temp_kelvin" else null
  hidden min: Int? = if (on is hass.ColourTemp) on.min_kelvin else null
  hidden max: Int? = if (on is hass.ColourTemp) on.max_kelvin else null
  // The ATTRIBUTE holding the live position, overriding the domain default
  // (`brightness` for a light) — so a slider driving a second axis of the same
  // entity tracks the value it actually writes.
  hidden valueAttr: String? =
    if (on is hass.ColourTemp) "color_temp_kelvin" else null
  // Never null: the `entity` constraint above admits only a domain with a row,
  // and a slider's subject is always a known entity now that a set's candidates
  // are. That is what retired the runtime `$lookup($domain)` config tier — it
  // existed for a member whose domain was unknown until it matched.
  hidden spec: SliderSpec = sliderSpec[entity.domain]!!
  // The JSONata pieces of the `fill` computation, honouring the same two config
  // tiers as the input's own slots: author override → build-time spec literal.
  hidden valueExpr: String =
    if (valueAttr != null) "$attr." + valueAttr!!
    else "$attr." + spec.value
  hidden minExpr: String = if (min != null) "\(min!!)" else "\(spec.min)"
  hidden maxExpr: String = if (max != null) "\(max!!)" else "\(spec.max)"
  /// The badge left of the label, defaulting to the entity's OWN icon in Home
  /// Assistant's resolution order (see [[iconFor]]) — so a slider looks like
  /// what it drives without being told. An MDI name (`mdi:lightbulb-group`)
  /// overrides it; an explicit `icon = null` renders no badge at all.
  hidden icon: String? = icons.iconFor(entity)
  /// A button at the right of the line — the group's on/off. Null renders none.
  hidden tapAction: tapMod.TapAction? = null
  /// Second line under the label — an attribute name, or an [[expr]] naming a
  /// DIFFERENT entity (the room's temperature beside its lights). Null renders
  /// no second line.
  hidden secondary: (String|slotMod.Expr)? = null
  /// What the line reads out beside the label: the entity's state (`on`/`off`),
  /// the LEVEL as a percentage of min..max, nothing, or an [[Expr]] of your own.
  ///
  /// The two names are shorthands, not a closed set — they exist because they
  /// need the axis config this card resolved (which attribute holds the value,
  /// and over which range), not because a readout has to be one of them. That
  /// config is `hidden` properties, so an expression can splice the pieces
  /// instead of re-deriving the range:
  ///
  ///   (c.slider(l)) { readout = c.expr("\(percentExpr) & \" · \" & $state") }
  ///   (c.slider(l)) { readout = c.exprOf(power, #"$state & " W""#) }
  ///
  /// Defaults by SHAPE: a head that has member rows under it does not repeat a
  /// readout (the rows carry their own), a plain row shows its state.
  hidden readout: (Readout|slotMod.Expr) = if (children.isEmpty) "state" else "none"
  // The `fill` percentage the other way round (value, not distance from the
  // right edge), rounded and suffixed — a readout, not a geometry, so unlike
  // `fill` it wants whole numbers. No position attribute (a light that is off)
  // reads 0 %, which is what the row shows: an empty track.
  hidden percentExpr: String =
    "($v := \(valueExpr); $v != null ? $string($round(($v - \(minExpr)) * 100 / (\(maxExpr) - \(minExpr)))) & \" %\" : \"0 %\")"
  // Copy the tap's inline surfaces onto the node so the hoist lifts them
  // (see [[EntityCard.inlineSurfaces]]).
  inlineSurfaces = if (tapAction != null) tapAction!!.inlineSurfaces else null
  // Resolved here rather than inline in `slots`, because a body that AMENDS an
  // inherited property does not see the inherited `icon` by name — only this
  // class's own members and the module.
  hidden resolvedIcon: String? = if (icon != null) icons.mdiClass(icon!!) else null
  slots {
    ["entity_id"] = entity.entity_id
    ["label"] = slotMod.labelSlot(entity, label)
    // The one difference the card's markup takes from having children: the
    // group modifier class. Everything else the two shapes need is an optional
    // piece that is absent on a plain row anyway.
    when (!children.isEmpty) {
      ["group"] = "slider-group"
    }
    when (resolvedIcon != null) {
      ["icon"] = resolvedIcon!!
    }
    when (tapAction != null) {
      ["onclick"] = tapAction!!.onclick
      // Lights the button while the entity is on — the one thing the fill
      // cannot say, since a light at 0 % and a light that is off look alike.
      // A CLASS signal slot: the FIFTH thing on this card that moves, and the
      // one that would have kept re-rendering it on every on/off had it stayed
      // bytes. `""` for off, because an empty string is the only falsy value a
      // slot can produce.
      ["lit"] = new slotMod.Slot {
        transform = #"$state = "on" ? "lit" : """#
        default = ""
        bypassUnavailable = false
        signal = slotMod.asClass("lit")
      }
    }
    when (tapAction != null && tapAction!!.busy) {
      ["busy"] = "1"
    }
    when (secondary != null) {
      ["secondary"] = slotMod.secondarySlot(secondary!!)
    }
    // The display header (inherits entity_id, bypassUnavailable default).
    // Omitted entirely when the readout is "none": an absent slot renders ""
    // and the template's `{{#state}}` section then drops the whole span.
    // A TEXT signal slot (ADR 0017): the readout is one of the four things on
    // this card that move when brightness does, and all four are signals — see
    // `value`/`fill`/`fillColor` below. Between them they are the whole reason a
    // slider used to re-render on every tick.
    when (readout != "none") {
      ["state"] =
        if (readout is slotMod.Expr)
          new slotMod.Slot { entityId = readout.entityId; transform = readout.transform; signal = slotMod.asText }
        else if (readout == "percent")
          new slotMod.Slot { transform = percentExpr; default = "0 %"; bypassUnavailable = false; signal = slotMod.asText }
        else new slotMod.Slot { signal = slotMod.asText }
    }
    // The range input's numeric position: opt OUT of bypass so an unavailable
    // entity falls back to `default` ("0") rather than "unavailable". Static:
    // read the domain's position attr; dynamic: $lookup it per match.
    //
    // A TWO-WAY signal slot: `data-bind` on the range input, so the backend
    // writes the position and a drag writes it back. This REPLACES the
    // hand-rolled `data-signals="{ _val_<id>: <value> }"` the template used to
    // bake — one signal instead of two, and a brightness change elsewhere now
    // moves the thumb with a frame rather than by re-rendering the card to
    // re-run its seed.
    ["value"] = new slotMod.Slot {
      transform = valueExpr
      default = "0"
      bypassUnavailable = false
      signal = slotMod.asBind
    }
    // The track fill, as the `--_end` percentage (distance from the RIGHT
    // edge, per BeerCSS's span/clip-path convention): 100 - value% of the
    // min..max range. Null-guarded — an absent position attribute (light off)
    // means an empty fill (end = 100), not a JSONata type error.
    //
    // NOT rounded: beer.min.js recomputes the same percentage unrounded on
    // load and after every morph, so a rounded server value visibly twitched
    // into place (brightness 155 of 1..255: `39%` baked, `39.37…%` a frame
    // later). Full precision makes the JS rewrite a no-op.
    //
    // A STYLE signal slot bound to `--_end`, so the fill follows a brightness
    // change without the card being re-rendered. The value carries its own `%`
    // — the binding reads the signal bare, so the unit is decided in the
    // transform and nowhere else.
    ["fill"] = new slotMod.Slot {
      transform = "$string(($v := \(valueExpr); $v != null ? 100 - (($v - \(minExpr)) * 100 / (\(maxExpr) - \(minExpr))) : 100)) & \"%\""
      default = "100%"
      bypassUnavailable = false
      signal = slotMod.asStyle("--_end")
    }
    // The fill COLOUR, on the `<span>`'s own style attribute — NOT the
    // wrapper's, which beer.min.js overwrites wholesale (`style.cssText = …`)
    // every time it repaints the fill. A light reports either an explicit
    // `rgb_color` or a `color_temp_kelvin`, which maps onto the usual
    // warm→cool ramp; anything else (a cover, a fan, a light that is off)
    // yields null and the slot default hands the paint back to the theme.
    ["fillColor"] = new slotMod.Slot {
      transform = sliderFillColor
      default = "currentcolor"
      bypassUnavailable = false
      // Bound to the span's OWN `background`, which is also why this one has to
      // be a signal: it moves with a light's colour, and leaving it as bytes
      // would re-render the card on exactly the ticks the other three avoid.
      signal = slotMod.asStyle("background")
    }
    // Whether a DRAG should also move the readout — only a percent one is a
    // function of the position; `"state"` is on/off and any [[Expr]] is the
    // author's own. A section flag, not the expression itself: the expression
    // names signals, and a signal's name is a template var the renderer fills.
    when (readout == "percent") {
      ["dragPercent"] = "1"
    }
    ["action"] = sliderConfig(action, spec, (s) -> s.action)
    ["key"] = sliderConfig(key, spec, (s) -> s.key)
    ["min"] = sliderConfig(if (min != null) "\(min)" else null, spec, (s) -> s.min)
    ["max"] = sliderConfig(if (max != null) "\(max)" else null, spec, (s) -> s.max)
  }
  // Fluent config (see [[EntityCard]]'s builder methods). The per-instance
  // overrides mirror the `hidden` props above; amending re-runs the two-tier
  // `sliderConfig` resolution with the new value.
  function label(l: String|slotMod.Expr): Slider = let (self = this) (self) { label = l }
  function action(a: String): Slider = let (self = this) (self) { action = a }
  function key(k: String): Slider = let (self = this) (self) { key = k }
  function min(m: Int): Slider = let (self = this) (self) { min = m }
  function max(m: Int): Slider = let (self = this) (self) { max = m }
  function valueAttr(a: String): Slider = let (self = this) (self) { valueAttr = a }
  function readout(r: Readout|slotMod.Expr): Slider = let (self = this) (self) { readout = r }
  // Nullable so `.icon(null)` is how a chain says "no badge" — the property
  // already means that, and a second `noIcon()` builder would be a parallel way
  // to say the same thing.
  function icon(i: String?): Slider = let (self = this) (self) { icon = i }
  function tapAction(t: tapMod.TapAction): Slider = let (self = this) (self) { tapAction = t }
  function secondary(s: String|slotMod.Expr): Slider = let (self = this) (self) { secondary = s }
  // The range input rides inside BeerCSS's slider markup (`.slider` wrapper +
  // trailing `<span>` = the painted MD3 track, `max` = full card width; NO
  // `.tooltip` — its value text bled through behind the track, and the live
  // value already shows in the head line). The FILL is OURS, never BeerCSS's:
  // its own fill is an inline style its JS writes on `input`, which a Datastar
  // morph wipes — and with the vars defaulting to 0% the track then snaps to
  // fully-filled. The `fill` slot owns `--_end` instead, baked into the style
  // attribute for the first paint and bound as a signal after it, with
  // `data-on:input` keeping it under the thumb mid-gesture. The label line is a
  // `.slider-head` class contract (both themes style it) — NOT a `<header>`
  // (BeerCSS styles header as a 4rem app-bar grid, which swallowed the text)
  // and NOT BeerCSS `.row`/`.max` (inline-size:100% squeezes the state span
  // into per-character wrapping).
  //
  // A drag is LIVE client-side (`data-on:input`) but only COMMITS on release
  // (`data-on:change` → the value POST), so a drag back on while that POST is
  // in flight must not fire a second commit. `\(tapMod.busyAttrsChange)`
  // (indicator + `data-attr:disabled`) and `\(tapMod.busyGuardChange)` are the
  // same busy pieces the power button uses, under the input's own
  // `_<id>__busy_change` signal — see `tap.pkl` for why the name is separate
  // and why disabling is safe.
  //
  // The head is the `self` and the members the `mount`, so the group's rows are
  // never carried by the master's patch (ADR 0012). A childless slider still
  // renders the mount — an empty `<div>` the theme hides — because a card is
  // one shape, and its optional pieces (icon, second line, button, members) are
  // absent rather than different.
  cardDef = new nodes.ContainerCard {
    template = """
      <article class="card slider-card{{#group}} {{group}}{{/group}}">{{{self}}}{{{mount}}}</article>
      """
    self = """
      <div id="{{selfId}}" class="slider-body">
        <div class="slider-head">
          {{#icon}}<div class="slider-icon"><i class="mdi {{icon}}"></i></div>{{/icon}}
          <strong>{{label}}</strong>
          {{#secondary}}<span class="slider-sub">{{secondary}}</span>{{/secondary}}
          {{#state}}<span class="state" \(slotMod.signalBind("state"))>{{state}}</span>{{/state}}
          {{#onclick}}<button class="circle small slider-action {{lit}}" \(slotMod.signalBind("lit")) data-on:click="{{#busy}}\(tapMod.busyGuard){{/busy}}{{{onclick}}}"{{#busy}} \(tapMod.busyAttrs){{/busy}}><i class="mdi mdi-power"></i></button>{{/onclick}}
        </div>
        <div class="slider max" style="--_start: 0%;--_end: {{fill}}" \(slotMod.signalBind("fill")) \(tapMod.busyClassChange)>
          <input type="range" min="{{min}}" max="{{max}}" value="{{value}}"
            \(slotMod.signalBind("value"))
            \(tapMod.busyAttrsChange)
            data-on:input="$\(slotMod.signalRef("fill")) = (100 - \(dragPos)) + '%'{{#dragPercent}}; $\(slotMod.signalRef("state")) = Math.round(\(dragPos)) + ' %'{{/dragPercent}}"
            data-on:change="\(tapMod.busyGuardChange)@post('sse/action/{{{action}}}/{{{entity_id}}}/{{key}}/' + $\(slotMod.signalRef("value")), \(tapMod.noSignals))" />
          <span style="background:{{fillColor}}" \(slotMod.signalBind("fillColor"))></span>
        </div>
      </div>
      """
    mount = """
      <div class="slider-members">{{#children}}{{{html}}}{{/children}}</div>
      """
    // `state` is NOT declared: a grouped head omits the slot entirely (see
    // [[readout]]), and a declared slot is one every node of the card must have.
    slots { "label"; "value"; "action"; "min"; "max"; "key"; "entity_id" }
  }
}

/// Value slider as a call (see [[Slider]] for the domain contract). Takes an
/// entity for its domain's default axis, or a capability group for that axis:
/// `c.slider(l)` is brightness, `c.slider(l.colourTemp)` is colour temperature.
function slider(a: SlideAxis): Slider = new Slider { on = a }
/// The slider constructor as a VALUE, for a query's render positions.
hidden slider: (hass.Entity) -> Slider = (e) -> slider(e)

/// The common group as one call: a master and the entities it stands for, each
/// a member [[Slider]] on its own domain's default axis, reading out its LEVEL
/// (a hand-composed member says `.readout("percent")` for the same).
function sliderGroup(a: SlideAxis, members: List<hass.Entity>): Slider =
  new Slider {
    on = a
    children { for (m in members) { (slider(m)) { readout = "percent" } } }
  }
