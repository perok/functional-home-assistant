/// The value slider, and the per-domain table that tells it what it drives.
///
/// Give it children and the same card is a GROUP: the slider becomes the head
/// and the children are the members it stands for.
module components.slider

import "../core/icon.pkl" as icons
import "../core/node.pkl" as nodes
import "../core/slot.pkl" as slotMod
import "../core/tap.pkl" as tapMod
import "../core/text.pkl" as textMod
import "../hass.pkl"

// The slider's controllable config per domain: the service to call, the
// service_data key the value rides on, the range bounds, and which attribute
// is the live position. Add a domain (cover/fan/climate…) by adding a row —
// TYPED: a missing/misspelled field is a build error. A slider resolves its
// config AT BUILD TIME from the entity's domain, as baked literals — always,
// now that a set's candidates are known entities.
class SliderSpec {
  action: String
  key: String
  min: Int
  max: Int
  value: String
}

const sliderSpec: Mapping<String, SliderSpec> = new {
  ["light"] = new { action = "light/turn_on"; key = "brightness"; min = 1; max = 255; value = "brightness" }
  ["cover"] = new { action = "cover/set_cover_position"; key = "position"; min = 0; max = 100; value = "current_position" }
  ["fan"] = new { action = "fan/set_percentage"; key = "percentage"; min = 0; max = 100; value = "percentage" }
}

// The slider fill colour from the entity's own light attributes: an explicit
// `rgb_color` wins, else `color_temp_kelvin` interpolated over the mired-free
// 2000K..6500K span between a warm amber and a cool white — the same ramp HA's
// own temperature picker shows. Null for every entity that reports neither
// (covers, fans, a light that is off), which the slot's default turns back into
// `currentcolor`.
const local sliderFillColor: String =
  #"($rgb := $attr.rgb_color; $k := $attr.color_temp_kelvin; $count($rgb) = 3 "#
  + #"? "rgb(" & $string($rgb[0]) & "," & $string($rgb[1]) & "," & $string($rgb[2]) & ")" "#
  + #": $k != null ? ($t := $k < 2000 ? 0 : ($k > 6500 ? 1 : ($k - 2000) / 4500); "#
  + #""rgb(" & $string($round(255 - 54 * $t)) & "," & $string($round(166 + 60 * $t)) "#
  + #"& "," & $string($round(87 + 168 * $t)) & ")") : null)"#

// The dragged position as a percentage of the card's own range, in JS — the
// client-side twin of `percentExpr`'s JSONata, spliced into the template so the
// range arrives through the `min`/`max` SLOTS. It cannot read `minExpr`/
// `maxExpr` instead: `cardDef` is shared by every slider on the page, and
// reading this card's own entity there closes the `on`/`entity` mutual default
// into a stack overflow.
//
// `evt.target.value` rather than the bound signal, because `data-bind` listens
// for `input` on this same element and the earlier-registered listener wins —
// off the event there is no ordering to get wrong.
const local function posFrom(v: String): String =
  "((\(v) - {{min}}) * 100 / ({{max}} - {{min}}))"

const local dragPos: String = posFrom("evt.target.value")

/// The client-owned position: what the control is SHOWING, which during a
/// gesture is the finger and at rest is whatever the server last said.
///
/// It has to be a second signal rather than the value slot itself, and the
/// reason is not tidiness: `data-on-signal-patch` fires on every write to a
/// name, local ones included, so a card cannot tell the SERVER's write from
/// its own drag on one signal. "Where the device is" and "where the control
/// is" therefore need two names to be distinguishable at all (ADR 0025).
///
/// The corollary is what makes this a fix rather than a refactor: while the
/// drag wrote the server's own slot, the session's `holds` — what the server
/// believes this DOM has — was false, so a commit that FAILED produced no
/// correcting frame (the server's value never moved) and the slider kept
/// showing a position the device never took.
const local slideSig: String = "_{{id}}__slide"

/// Adopt what the device says: confirmation and CORRECTION are the same line,
/// so HA clamping a brightness needs no case of its own. Filtered to the value
/// signal, which only the server writes now.
const local adoptCommitted: String =
  #"data-on-signal-patch-filter="{include:/^\#(slotMod.signalRef("value"))$/}" data-on-signal-patch="$\#(slideSig) = $\#(slotMod.signalRef("value"))""#

// The same statement as [[adoptCommitted]] — "show what the device last said"
// — reached when nothing is coming. `fill` and `state` are RECOMPUTED rather
// than shadowed, because they are functions of the position: restoring the
// position restores them, and the formula is the one the drag already uses.
//
// Sourced from the committed signal, not from the just-assigned `slideSig`, so
// the three writes have no ordering between them. Comma-separated because this
// splices inside a `&&`, where a `;` would not parse.
const local rollbackToCommitted: String =
  let (committed = "$" + slotMod.signalRef("value"))
    "$\(slideSig) = \(committed), " +
      "$\(slotMod.signalRef("fill")) = (100 - \(posFrom(committed))) + '%'" +
      "{{#dragPercent}}, $\(slotMod.signalRef("state")) = " +
      "Math.round(\(posFrom(committed))) + ' %'{{/dragPercent}}"

/// The two ways an ask ends with no commit coming (ADR 0025), both answered by
/// [[rollbackToCommitted]]: a REFUSAL is a status the server actually sent
/// (Datastar dispatches `error` from `onopen`, so it fires only when a response
/// arrived), and `_sse` is the shell's own counter for the stream the commit
/// would have ridden. Neither is a timeout.
const local restoreOnFailure: String =
  #"data-on:datastar-fetch__document="evt.detail.type === 'error' && (\#(rollbackToCommitted))" data-effect="$_sse > 0 && (\#(rollbackToCommitted))""#

// A slider config slot (action/key/min/max): author override, else the spec
// literal (stringified — the backend slot decoder rejects numbers).
//
// There used to be a third tier, a `$lookup($domain)` JSONata transform, for a
// slider whose entity was a `$self` placeholder. It was the plan's motivating
// example: four `reactive: false` transforms per member computing a BUILD-TIME
// fact at runtime, because the entity was unknown at build time. A candidate
// set knows it, so all four are literals and the tier is gone.
// `override` is a Pkl reserved word — the param is `ovr`.
const local function sliderConfig(ovr: String?, spec: SliderSpec, get: (SliderSpec) -> Any): String =
  if (ovr != null) ovr else "\(get.apply(spec))"

/// What a [[Slider]] drives: an ENTITY (its domain's default axis — a light's
/// brightness, a cover's position) or one of that entity's capability GROUPS
/// (`l.colourTemp`). The group carries its `owner`, so passing one names the
/// entity exactly once and the slider derives everything else from it.
///
/// This union is the "which axis" decision as a VALUE rather than a name, which
/// is what keeps a wrong choice visible in the editor: `c.slider(l.colourTemp)`
/// on a light with no kelvin range is a nullability mismatch pkl-lsp reports
/// without evaluating. A selector enum or a `.colourTemp()` builder method
/// would both hide the choice from it — see ADR 0013, "Shapes considered".
typealias SlideAxis = hass.Entity|hass.ColourTemp

/// The named readings a slider's line offers beside its label — the two that
/// need the card's own axis config, plus "nothing". Anything else is an
/// [[Expr]]; see [[Slider.readout]].
typealias Readout = "state"|"percent"|"none"

/// Value slider. Takes an entity whose domain has a sliderSpec row, and bakes
/// that config in at build time. A slider on e.g. a sensor is a BUILD error
/// naming the dashboard line — including inside a query, where the fold drops a
/// branch whose guard cannot hold before its render lambda is applied.
///
/// Give it CHILDREN and the same card is a GROUP: the slider becomes the head
/// (the group light, the cover group) and the children are the members it
/// stands for, stacked inside it with the master's fill painted across the
/// whole card behind them — one control with its parts shown, not a titled
/// list.
///
///   (c.slider(dump.entities.light_lys)) {
///     icon = "mdi:lightbulb-group"
///     secondary = c.exprOf(dump.entities.sensor_kitchen_temp, #"$state & " °C""#)
///     tap = c.toggle
///     children { c.slider(a).readout("percent") c.slider(b).readout("percent") }
///   }
///
/// One card rather than a separate group card, because the members are
/// ORDINARY nodes: a member can be another grouped slider (nesting works by
/// construction), an [[EntityCard]], or a [[DynamicGroup]] of everything in an
/// area, and each keeps its own entity, its own domain config and its own live
/// patch. [[sliderGroup]] is the shorthand for the common "a master and its
/// member entities" case.
///
/// The head is the card's `self` and the members its `mount`, so a state change
/// on the master repaints the head alone and never the rows (ADR 0012) — the
/// reason this is a container card even when it holds nothing.
class Slider extends nodes.Node {
  card = "slider"
  /// WHAT this slider drives — see [[SlideAxis]]. Setting `entity` directly
  /// still works and means the domain's default axis; the two default to each
  /// other, so exactly one of them is ever needed.
  hidden on: SlideAxis = entity
  hidden entity: hass.Entity(sliderSpec.containsKey(domain)) =
    if (on is hass.ColourTemp) on.owner else on
  hidden label: (String|slotMod.Expr)? = null
  // Per-instance overrides of the domain default. Each DEFAULTS to what the
  // axis says, so a capability axis configures the whole slider and an author
  // amending one of these still wins (late binding re-derives `slots`).
  hidden action: String? = if (on is hass.ColourTemp) "light/turn_on" else null
  hidden key: String? = if (on is hass.ColourTemp) "color_temp_kelvin" else null
  hidden min: Int? = if (on is hass.ColourTemp) on.min_kelvin else null
  hidden max: Int? = if (on is hass.ColourTemp) on.max_kelvin else null
  // The ATTRIBUTE holding the live position, overriding the domain default
  // (`brightness` for a light) — so a slider driving a second axis of the same
  // entity tracks the value it actually writes.
  hidden valueAttr: String? =
    if (on is hass.ColourTemp) "color_temp_kelvin" else null
  // Never null: the `entity` constraint above admits only a domain with a row,
  // and a slider's subject is always a known entity now that a set's candidates
  // are. That is what retired the runtime `$lookup($domain)` config tier — it
  // existed for a member whose domain was unknown until it matched.
  hidden spec: SliderSpec = sliderSpec[entity.domain]!!
  // The JSONata pieces of the `fill` computation, honouring the same two config
  // tiers as the input's own slots: author override → build-time spec literal.
  hidden valueExpr: String =
    if (valueAttr != null) "$attr." + valueAttr!!
    else "$attr." + spec.value
  hidden minExpr: String = if (min != null) "\(min!!)" else "\(spec.min)"
  hidden maxExpr: String = if (max != null) "\(max!!)" else "\(spec.max)"
  /// Whether the axis this card drives EXISTS on its entity. A light whose only
  /// colour mode is `onoff` has no brightness to set, so a slider on it would
  /// be a track that never fills posting a `brightness` HA discards.
  ///
  /// The card carries the variant rather than the caller choosing a different
  /// card, so a member of `sliderGroup` still reads as one of the rows around
  /// it: same pill, same head, but filled all-or-nothing and tapped rather than
  /// dragged. Only a light can report this — every other axis is settable by
  /// construction (a `colourTemp` group exists only where the range does).
  ///
  /// Positive test, NOT `!supportsBrightness`: colour modes come from the state
  /// snapshot, and an entity that was unavailable when the dump was taken
  /// reports almost none of its attributes — so "says nothing" has to keep the
  /// slider it has always had. `onoff` is HA's own statement that this light
  /// switches and nothing more (their rule: it is the SOLE mode when present).
  hidden toggleOnly: Boolean =
    if (on is hass.LightEntity) on.colourModes.toList() == List("onoff") else false
  /// What a tap on a [[toggleOnly]] row does — the domain's own toggle service
  /// (`hass/actions.pkl`), which every domain with a `sliderSpec` row has. It is
  /// a property so an author can point the row at something else without
  /// reaching for a different card.
  hidden toggleTap: tapMod.TapAction = tapMod.byDomain(entity) ?? tapMod.toggle
  /// The badge left of the label, defaulting to the entity's OWN icon in Home
  /// Assistant's resolution order (see [[iconFor]]) — so a slider looks like
  /// what it drives without being told. An MDI name (`mdi:lightbulb-group`)
  /// overrides it; an explicit `icon = null` renders no badge at all.
  hidden icon: String? = icons.iconFor(entity)
  /// A button at the right of the line — the group's on/off. Null renders none.
  hidden tapAction: tapMod.TapAction? = null
  /// Whether this slider's busy LOOK shows at all — the commit's immediate
  /// `fh-disabled` dim on the track and badge, its delayed spinner on the
  /// badge, AND the power button's. The GUARD and the
  /// input freeze (`data-attr:disabled`) are signal-driven and stay either way;
  /// false only hides the visuals. The power button additionally honours its
  /// OWN tap's `TapAction.busyVisual`, so the two knobs compose.
  hidden busyVisual: Boolean = true
  /// Second line under the label — an attribute name, or an [[expr]] naming a
  /// DIFFERENT entity (the room's temperature beside its lights). Null renders
  /// no second line.
  hidden secondary: (String|slotMod.Expr)? = null
  /// What the line reads out beside the label: the entity's state (`on`/`off`),
  /// the LEVEL as a percentage of min..max, nothing, or an [[Expr]] of your own.
  ///
  /// The two names are shorthands, not a closed set — they exist because they
  /// need the axis config this card resolved (which attribute holds the value,
  /// and over which range), not because a readout has to be one of them. That
  /// config is `hidden` properties, so an expression can splice the pieces
  /// instead of re-deriving the range:
  ///
  ///   (c.slider(l)) { readout = c.expr("\(percentExpr) & \" · \" & $state") }
  ///   (c.slider(l)) { readout = c.exprOf(power, #"$state & " W""#) }
  ///
  /// Defaults by SHAPE: a head that has member rows under it does not repeat a
  /// readout (the rows carry their own), a plain row shows its state.
  hidden readout: (Readout|slotMod.Expr) = if (children.isEmpty) "state" else "none"
  // The `fill` percentage the other way round (value, not distance from the
  // right edge), rounded and suffixed — a readout, not a geometry, so unlike
  // `fill` it wants whole numbers. No position attribute (a light that is off)
  // reads 0 %, which is what the row shows: an empty track.
  hidden percentExpr: String =
    "($v := \(valueExpr); $v != null ? $string($round(($v - \(minExpr)) * 100 / (\(maxExpr) - \(minExpr)))) & \" %\" : \"0 %\")"
  // A percentage of an axis the entity does not have is a permanent "0 %", so a
  // toggle-only row reads out its STATE instead — `sliderGroup` gives every
  // member `percent` without knowing which of them can dim. An author's own
  // [[Expr]] is left alone: it may well be about something else entirely.
  hidden shownReadout: (Readout|slotMod.Expr) =
    if (toggleOnly && readout == "percent") "state" else readout
  // The track fill, as the `--_end` percentage — see the `fill` slot. A
  // toggle-only row has no position to express, so it fills all or nothing.
  hidden fillExpr: String =
    if (toggleOnly) #"$state = "on" ? "0%" : "100%""#
    else "$string(($v := \(valueExpr); $v != null ? 100 - (($v - \(minExpr)) * 100 / (\(maxExpr) - \(minExpr))) : 100)) & \"%\""
  // Copy the tap's inline surfaces onto the node so the hoist lifts them
  // (see [[EntityCard.inlineSurfaces]]).
  inlineSurfaces = if (tapAction != null) tapAction!!.inlineSurfaces else null
  // Resolved here rather than inline in `slots`, because a body that AMENDS an
  // inherited property does not see the inherited `icon` by name — only this
  // class's own members and the module.
  hidden resolvedIcon: String? = if (icon != null) icons.mdiClass(icon!!) else null
  slots {
    ["entity_id"] = entity.entity_id
    ["label"] = slotMod.labelSlot(entity, label)
    // The one difference the card's markup takes from having children: the
    // group modifier class. Everything else the two shapes need is an optional
    // piece that is absent on a plain row anyway.
    when (!children.isEmpty) {
      ["group"] = "slider-group"
    }
    when (resolvedIcon != null) {
      ["icon"] = resolvedIcon!!
    }
    when (tapAction != null) {
      ["onclick"] = tapAction!!.onclick
      // Lights the button while the entity is on — the one thing the fill
      // cannot say, since a light at 0 % and a light that is off look alike.
      // A CLASS signal slot: the FIFTH thing on this card that moves, and the
      // one that would have kept re-rendering it on every on/off had it stayed
      // bytes. `""` for off, because an empty string is the only falsy value a
      // slot can produce.
      ["lit"] = new slotMod.Slot {
        transform = #"$state = "on" ? "lit" : """#
        default = ""
        bypassUnavailable = false
        signal = slotMod.asClass("lit")
      }
    }
    when (tapAction != null && tapAction!!.busy) {
      ["busy"] = "1"
    }
    // The commit's busy LOOK (the wrapper + badge `fh-disabled` bindings) is
    // gated on the card's own `busyVisual`; the power button's on the same AND
    // its tap's — see the `busyVisual` doc above.
    when (busyVisual) {
      ["busyVisual"] = "1"
    }
    when (tapAction != null && tapAction!!.busy && busyVisual && tapAction!!.busyVisual) {
      ["busyTapVisual"] = "1"
    }
    when (secondary != null) {
      ["secondary"] = slotMod.secondarySlot(secondary!!)
    }
    // The display header (inherits entity_id, bypassUnavailable default).
    // Omitted entirely when the readout is "none": an absent slot renders ""
    // and the template's `{{#state}}` section then drops the whole span.
    // A TEXT signal slot (ADR 0017): the readout is one of the four things on
    // this card that move when brightness does, and all four are signals — see
    // `value`/`fill`/`fillColor` below. Between them they are the whole reason a
    // slider used to re-render on every tick.
    when (shownReadout != "none") {
      ["state"] =
        if (shownReadout is slotMod.Expr)
          new slotMod.Slot { entityId = shownReadout.entityId; transform = shownReadout.transform; signal = slotMod.asText }
        else if (shownReadout == "percent")
          new slotMod.Slot { transform = percentExpr; default = "0 %"; bypassUnavailable = false; signal = slotMod.asText }
        else new slotMod.Slot { signal = slotMod.asText }
    }
    // The range input's numeric position: opt OUT of bypass so an unavailable
    // entity falls back to `default` ("0") rather than "unavailable". Static:
    // read the domain's position attr; dynamic: $lookup it per match.
    //
    // WHERE THE DEVICE IS — server-written, and never touched by this card.
    // It used to be the input's `data-bind`, which made the drag write it, and
    // that is the bug [[slideSig]] describes: the session's `holds` went stale,
    // so a FAILED commit produced no correcting frame and the thumb stayed
    // where the finger left it.
    //
    // `data-attr:value` is a PLACEMENT, not a binding that does anything: this
    // signal is read by [[adoptCommitted]] and [[rollbackToCommitted]], and it
    // has no DOM home of its own. ADR 0017 requires every signal slot to place
    // its bind somewhere, so it lands on the attribute the value would
    // naturally have had — where `data-bind` beats it from the first pass and
    // it is inert for the life of the page.
    //
    // Measured, and contradicting what the spec alone suggested (the dirty-value
    // flag is real, but `data-bind` sets `.value` through the IDL before any
    // user touches it, so the attribute never positions the thumb even once):
    // `DatastarMorphContractSuite`, "data-bind makes a co-located
    // data-attr:value inert from the start". The live position is [[slideSig]].
    ["value"] = new slotMod.Slot {
      transform = valueExpr
      default = "0"
      bypassUnavailable = false
      signal = slotMod.asAttr("value")
    }
    // The track fill, as the `--_end` percentage (distance from the RIGHT
    // edge, per BeerCSS's span/clip-path convention): 100 - value% of the
    // min..max range. Null-guarded — an absent position attribute (light off)
    // means an empty fill (end = 100), not a JSONata type error.
    //
    // NOT rounded: beer.min.js recomputes the same percentage unrounded on
    // load and after every morph, so a rounded server value visibly twitched
    // into place (brightness 155 of 1..255: `39%` baked, `39.37…%` a frame
    // later). Full precision makes the JS rewrite a no-op.
    //
    // A STYLE signal slot bound to `--_end`, so the fill follows a brightness
    // change without the card being re-rendered. The value carries its own `%`
    // — the binding reads the signal bare, so the unit is decided in the
    // transform and nowhere else.
    ["fill"] = new slotMod.Slot {
      transform = fillExpr
      default = "100%"
      bypassUnavailable = false
      signal = slotMod.asStyle("--_end")
    }
    // The fill COLOUR, on the `<span>`'s own style attribute — NOT the
    // wrapper's, which beer.min.js overwrites wholesale (`style.cssText = …`)
    // every time it repaints the fill. A light reports either an explicit
    // `rgb_color` or a `color_temp_kelvin`, which maps onto the usual
    // warm→cool ramp; anything else (a cover, a fan, a light that is off)
    // yields null and the slot default hands the paint back to the theme.
    ["fillColor"] = new slotMod.Slot {
      transform = sliderFillColor
      // A toggle-only row has no colour of its own to report (HA allows `onoff`
      // only as a light's SOLE colour mode), and `currentcolor` on a full-width
      // fill reads as text, not as "this is on" — so it takes
      // `--fh-default-color`, the contract's paint for exactly this case: a
      // colour a card had to assume because the device named none.
      default = if (toggleOnly) "var(--fh-default-color)" else "currentcolor"
      bypassUnavailable = false
      // Bound to the span's OWN `background`, which is also why this one has to
      // be a signal: it moves with a light's colour, and leaving it as bytes
      // would re-render the card on exactly the ticks the other three avoid.
      signal = slotMod.asStyle("background")
    }
    // Whether a DRAG should also move the readout — only a percent one is a
    // function of the position; `"state"` is on/off and any [[Expr]] is the
    // author's own. A section flag, not the expression itself: the expression
    // names signals, and a signal's name is a template var the renderer fills.
    when (shownReadout == "percent") {
      ["dragPercent"] = "1"
    }
    // The toggle variant: no range input, the track itself is the button. A
    // section flag plus the click expression, because `cardDef` is one template
    // shared by every slider on the page — the shape has to travel as a slot.
    when (toggleOnly) {
      ["toggle"] = "1"
      ["toggleClick"] = toggleTap.onclick
    }
    ["action"] = sliderConfig(action, spec, (s) -> s.action)
    ["key"] = sliderConfig(key, spec, (s) -> s.key)
    ["min"] = sliderConfig(if (min != null) "\(min)" else null, spec, (s) -> s.min)
    ["max"] = sliderConfig(if (max != null) "\(max)" else null, spec, (s) -> s.max)
  }
  // Fluent config (see [[EntityCard]]'s builder methods). The per-instance
  // overrides mirror the `hidden` props above; amending re-runs the two-tier
  // `sliderConfig` resolution with the new value.
  function label(l: String|slotMod.Expr): Slider = let (self = this) (self) { label = l }
  function action(a: String): Slider = let (self = this) (self) { action = a }
  function key(k: String): Slider = let (self = this) (self) { key = k }
  function min(m: Int): Slider = let (self = this) (self) { min = m }
  function max(m: Int): Slider = let (self = this) (self) { max = m }
  function valueAttr(a: String): Slider = let (self = this) (self) { valueAttr = a }
  function readout(r: Readout|slotMod.Expr): Slider = let (self = this) (self) { readout = r }
  // Nullable so `.icon(null)` is how a chain says "no badge" — the property
  // already means that, and a second `noIcon()` builder would be a parallel way
  // to say the same thing.
  function icon(i: String?): Slider = let (self = this) (self) { icon = i }
  function tapAction(t: tapMod.TapAction): Slider = let (self = this) (self) { tapAction = t }
  function busyVisual(b: Boolean): Slider = let (self = this) (self) { busyVisual = b }
  function secondary(s: String|slotMod.Expr): Slider = let (self = this) (self) { secondary = s }
  // The range input rides inside BeerCSS's slider markup (`.slider` wrapper +
  // trailing `<span>` = the painted MD3 track, `max` = full card width; NO
  // `.tooltip` — its value text bled through behind the track, and the live
  // value already shows in the head line). The FILL is OURS, never BeerCSS's:
  // its own fill is an inline style its JS writes on `input`, which a Datastar
  // morph wipes — and with the vars defaulting to 0% the track then snaps to
  // fully-filled. The `fill` slot owns `--_end` instead, baked into the style
  // attribute for the first paint and bound as a signal after it, with
  // `data-on:input` keeping it under the thumb mid-gesture. The label line is a
  // `.slider-head` class contract (both themes style it) — NOT a `<header>`
  // (BeerCSS styles header as a 4rem app-bar grid, which swallowed the text)
  // and NOT BeerCSS `.row`/`.max` (inline-size:100% squeezes the state span
  // into per-character wrapping).
  //
  // A drag is LIVE client-side (`data-on:input`) but only COMMITS on release
  // (`data-on:change` → the value POST), so a drag back on while that POST is
  // in flight must not fire a second commit. `\(tapMod.busyAttrsChange)`
  // (indicator + `data-attr:disabled`) and `\(tapMod.busyGuardChange)` are the
  // same busy pieces the power button uses, under the input's own
  // `_<id>__busy_change` signal — see `tap.pkl` for why the name is separate
  // and why disabling is safe.
  //
  // A [[toggleOnly]] row drops the range input and puts a full-bleed button in
  // its place, LAST so it sits over the painted fill without either of them
  // needing a stacking rule. It reuses the input's own `_<id>__busy_change`
  // signal rather than a tap's `_<id>__busy`: it stands exactly where the commit
  // did, and the power button may still be holding the other name (the
  // one-guarded-element-per-node rule in ADR 0019).
  //
  // The head is the `self` and the members the `mount`, so the group's rows are
  // never carried by the master's patch (ADR 0012). A childless slider still
  // renders the mount — an empty `<div>` the theme hides — because a card is
  // one shape, and its optional pieces (icon, second line, button, members) are
  // absent rather than different.
  cardDef = new nodes.ContainerCard {
    template = """
      <article class="card slider-card{{#group}} {{group}}{{/group}}">{{{self}}}{{{mount}}}</article>
      """
    self = """
      <div id="{{selfId}}" class="slider-body">
        <div class="slider-head">
          {{#icon}}<div class="slider-icon"{{#busyVisual}} \(tapMod.busyClassChange) \(tapMod.busyShapeClassChange){{/busyVisual}}><i class="mdi {{icon}}"></i></div>{{/icon}}
          <strong class="\(textMod.BOX)">\(textMod.run("label"))</strong>
          {{#secondary}}<span class="slider-sub \(textMod.BOX)">\(textMod.run("secondary"))</span>{{/secondary}}
          {{#state}}<span class="state" \(slotMod.signalBind("state"))>{{state}}</span>{{/state}}
          {{#onclick}}<button class="circle small slider-action {{lit}}" \(slotMod.signalBind("lit")) data-on:click="{{#busy}}\(tapMod.busyGuard){{/busy}}{{{onclick}}}"{{#busy}} \(tapMod.busyAttrs){{/busy}}{{#busyTapVisual}} \(tapMod.busyClass) \(tapMod.busyShapeClass){{/busyTapVisual}}><i class="mdi mdi-power"></i></button>{{/onclick}}
        </div>
        <div class="slider max" style="--_start: 0%;--_end: {{fill}}" \(slotMod.signalBind("fill")){{#busyVisual}} \(tapMod.busyClassChange){{/busyVisual}}>
          {{^toggle}}<input type="range" min="{{min}}" max="{{max}}" value="{{value}}"
            \(slotMod.signalBind("value"))
            data-signals__ifmissing="{ \(slideSig): '{{value}}' }"
            data-bind="\(slideSig)"
            \(adoptCommitted)
            \(restoreOnFailure)
            \(tapMod.busyAttrsChange)
            data-on:input="$\(slotMod.signalRef("fill")) = (100 - \(dragPos)) + '%'{{#dragPercent}}; $\(slotMod.signalRef("state")) = Math.round(\(dragPos)) + ' %'{{/dragPercent}}"
            data-on:change="\(tapMod.busyGuardChange)@post('sse/action/{{dashboardSlug}}/{{{action}}}/{{{entity_id}}}/{{key}}/' + $\(slideSig), \(tapMod.noSignals))" />{{/toggle}}
          <span style="background:{{fillColor}}" \(slotMod.signalBind("fillColor"))></span>
          {{#toggle}}<button type="button" class="slider-toggle" aria-label="{{label}}"
            \(slotMod.signalBind("value"))
            data-on:click="\(tapMod.busyGuardChange){{{toggleClick}}}"
            \(tapMod.busyAttrsChange)></button>{{/toggle}}
        </div>
      </div>
      """
    mount = """
      <div class="slider-members">{{#children}}{{{html}}}{{/children}}</div>
      """
    // `state` is NOT declared: a grouped head omits the slot entirely (see
    // [[readout]]), and a declared slot is one every node of the card must have.
    slots { "label"; "value"; "action"; "min"; "max"; "key"; "entity_id" }
    css = sliderCss
  }
}

// The slider's own structure — the largest card in the library and the one that
// most needs its CSS next to its markup. Colour goes through the `--fh-*`
// variables (`core/css.pkl`); what stays with the theme is paint and BeerCSS's
// private knobs (`--_padding`, `.shape`), because those name things this card
// does not emit.
//
// `.slider.max` IS emitted here (BeerCSS's slider markup — wrapper + trailing
// `<span>` painted as the MD3 track), so the rules keyed on it are this card's
// even though the class name is the framework's.
const local sliderCss: String = """
  /* The label line: label left, live state right. It is PAINTED OVER the track
     (`.slider.max` is an absolutely-positioned overlay filling the card), so it
     must not take the pointer — without this the label and the live value are
     two dead strips the user has to aim around.
     The readout is pushed right rather than the line being `space-between`,
     because the line has THREE items once a slider carries its entity's icon
     badge — and "spread evenly" would centre the label between the badge and
     the readout instead of keeping it next to what it names.
     An explicit line-height, because `normal` is the FONT's own figure: the line
     box then changes size with whatever font resolved, which is half of how the
     same markup ends up looking different per engine. 1.5 is what the current
     stack already computed, so this pins today's rhythm rather than changing it.
     The label and its second line are text BOXES (`core/text.pkl`); the readout
     deliberately is not — it is a level or an on/off, not prose to clip.
     It does RESERVE its width, though, and that is the point of
     `--fh-readout-size`: shrink-wrapped, the box was as wide as whatever it
     currently reads, so a drag from `9 %` to `100 %` widened it and slid its
     left edge — and the label, which caps against that edge, re-clipped on
     every frame. Reserving the widest ordinary reading and aligning to the END
     pins the edge, so the number changes and nothing moves. A LONGER reading
     (`unavailable`) still gets its room; the floor only stops the box from
     collapsing below it. */
  .slider-head{display:flex;gap:.75rem;align-items:center;padding:.5rem;line-height:1.5;z-index:3;pointer-events:none}
  .slider-head>.state{margin-inline-start:auto;flex:0 0 auto;
  min-inline-size:var(--fh-readout-size,3.25rem);text-align:end}
  /* The edge of the control, drawn OVER the fill and never under it. Without it
     a nearly-full slider has no visible end: the fill runs to the card's own
     boundary and, on a bright light against a light palette, the last few
     percent are the same brightness as the page behind them — so the row reads
     as "some colour ending somewhere". The ring is what says where.
     A pseudo-element rather than the card's own `box-shadow:inset`, which is
     painted BEHIND the descendants and therefore behind the fill — that is the
     rule this replaces, and it was invisible on exactly the rows (a member near
     100 %) it was added for. `border-radius:inherit` takes the card's, since
     that is the box it traces. */
  .slider-card{position:relative}
  .slider-card:after{content:"";position:absolute;inset:0;border-radius:inherit;
  box-shadow:inset 0 0 0 .0625rem var(--fh-border);pointer-events:none;z-index:4}
  /* A slider is dragged sideways, so say so: the grab hand reads as "pick this
     up and move it anywhere". */
  .slider.max,.slider.max>input{cursor:ew-resize}
  .slider.max>input::-webkit-slider-thumb{cursor:ew-resize}
  .slider.max>input::-moz-range-thumb{cursor:ew-resize}
  /* The loading commit overrides the drag affordance once a slider's value POST
     has held past the loading delay: the wrapper and the input each set their own
     ew-resize, so `.fh-loading` alone (which matches the input only by
     inheritance) never beats them. Pairs with `.fh-disabled`'s dim (which lands
     instantly, before this), so the whole control says "wait" together. */
  .slider.max.fh-loading,.slider.max.fh-loading>input{cursor:progress}
  .slider.max.fh-loading>input::-webkit-slider-thumb{cursor:progress}
  .slider.max.fh-loading>input::-moz-range-thumb{cursor:progress}
  /* Slide the fill to a state change instead of snapping. `inset` is what
     BeerCSS derives from `--_start`/`--_end`, so animating it covers every
     writer of those props alike; `background` covers a light changing colour.
     Suppressed while the slider is being dragged — there the fill must track the
     thumb frame by frame, and a transition reads as lag. :active alone is not
     enough: a pointer drag ends with the input still focused, and the echoed
     state should land where the user let go. */
  .slider.max>span:not([class]){transition:inset .3s cubic-bezier(.2,0,0,1),background .3s linear}
  .slider.max:is(:active,:focus-within,.fh-armed)>span:not([class]){transition:none}
  /* Touch: the CSS half of the axis-intent gate (theme.pkl's sliderHoldScript
     owns the timing). The range input is inert so a swipe that starts on a card
     scrolls the list instead of setting a value, and `pan-y` keeps that scroll
     native; the script drives the value itself — on a drag once armed, and on a
     TAP, which an inert input would otherwise swallow entirely. */
  @media (pointer:coarse){
  .slider.max{touch-action:pan-y}
  .slider.max>input{pointer-events:none}
  .slider.max.fh-armed{box-shadow:inset 0 0 0 .125rem var(--fh-accent)}
  }
  /* The toggle variant's whole-track button (a light that only switches). It is
     invisible on purpose — the fill IS the feedback — so every one of a
     framework's button paints has to be undone, `all:unset` being unavailable
     here because it would also drop the box the click needs. `cursor:pointer`
     rather than the `ew-resize` above, which is the point: this row is pressed,
     not dragged.
     `block-size:auto` is load-bearing, not tidiness: BeerCSS gives every
     `button` a fixed `2.5rem` height, which OVER-CONSTRAINS `inset:0` — the
     browser keeps the top and the height and throws the bottom away, so the
     button was a 40 px strip at the top of a 64 px card. Invisible in itself,
     except that a hover paints the framework's overlay across exactly that box:
     the press target sat above the middle of the row it belongs to. */
  .slider-toggle{position:absolute;inset:0;block-size:auto;inline-size:auto;
  z-index:1;margin:0;padding:0;border:0;
  background:none;box-shadow:none;color:inherit;font:inherit;border-radius:inherit;
  appearance:none;-webkit-appearance:none;cursor:pointer}
  /* The card's two structural wrappers. `display:contents` on the self wrapper is
     deliberate: it is the patch target (`{{selfId}}`), and a boxless one leaves
     the head and the track laid out by the CARD exactly as they were before the
     card split into self + mount. The mount is an empty div on every childless
     slider, which is the whole reason `:empty` is here. */
  .slider-body{display:contents}
  .slider-members:empty{display:none}
  /* A slider that HOLDS sliders. The master's fill is the whole card's
     background, painted BEHIND the member rows, which is what makes the group
     read as one control rather than a titled list — `.slider.max` already fills
     the card, so the group only has to keep the rows on top of it and the drag
     surface off them.

     The head is the same markup a plain row has: the badge, the second line and
     the button are pieces a plain row simply does not carry, so only the
     arrangement changes — a two-row grid with the badge and the button spanning
     both rows. */
  .slider-group{overflow:hidden}
  /* Scoped through `.slider-body` on purpose: `display:contents` removes its BOX,
     not its place in the DOM, so it still has to appear in a selector — and every
     one of these rules must miss the members' own heads and tracks, which are
     `.slider-head`/`.slider.max` too.
     Rows are DECLARED, not implicit, so the label and its second line are one
     block of ordinary text: an implicit grid sizes its rows to whatever spans
     them, and the badge (taller than two lines together) pushed the two lines
     apart to fill itself. Declaring them makes the text keep its own rhythm and
     the badge centre against the pair. Same reason the spans say `1/3` rather
     than `1/-1`: `-1` is the last line of the EXPLICIT grid, which is only well
     defined now that there is one. */
  .slider-group>.slider-body>.slider-head{display:grid;grid-template-columns:auto 1fr auto auto;
  grid-template-rows:auto auto;align-items:center;align-content:center;
  min-block-size:4.5rem;box-sizing:border-box;gap:0 .75rem}
  .slider-group>.slider-body>.slider-head>strong{grid-column:2;grid-row:1}
  .slider-group>.slider-body>.slider-head>.slider-sub{grid-column:2;grid-row:2}
  .slider-group>.slider-body>.slider-head>.slider-icon{grid-row:1/3}
  .slider-group>.slider-body>.slider-head>.state{grid-column:3;grid-row:1/3}
  .slider-group>.slider-body>.slider-head>.slider-action{grid-column:4;grid-row:1/3}
  .slider-icon{display:flex;align-items:center;justify-content:center;
  inline-size:2rem;block-size:2rem;border-radius:50%;
  background:var(--fh-surface-alt);color:var(--fh-accent)}
  .slider-icon>i{font-size:1.25rem}
  /* Bigger on a group's head alone, where the badge reads as a card header
     rather than a row's icon. */
  .slider-group>.slider-body>.slider-head>.slider-icon{inline-size:2.75rem;block-size:2.75rem}
  .slider-group>.slider-body>.slider-head>.slider-icon>i{font-size:1.5rem}
  .slider-sub{font-size:.8rem;color:var(--fh-text-dim)}
  /* The one thing in the head that IS a control has to take the pointer back
     from `.slider-head`'s `pointer-events:none`. */
  .slider-action{pointer-events:auto;background:var(--fh-surface-alt);color:var(--fh-text)}
  .slider-action.lit{background:var(--fh-accent);color:var(--fh-on-accent)}
  /* BeerCSS's `.slider.max` is already `position:absolute;inset:0` of the card,
     so the master's track — and its painted span — span the WHOLE card, members
     included. Nothing constrains the master's range input to the head strip
     either, and it should not: the member rows are painted over it (opaque,
     stacked below), so a drag lands on the master exactly where its own fill is
     what the finger is on. */
  .slider-group>.slider-body>.slider.max>span:not([class]){inset:0 var(--_end) 0 0;block-size:auto;border-radius:0;opacity:.45;pointer-events:none}
  /* Above the master's painted `<span>`, which is positioned and would otherwise
     cover the member rows' own backgrounds — the fill belongs AROUND the rows,
     not through them.
     Indented to start where the head's BADGE does, not where its card does — so
     the rows read as belonging to the head rather than as a second list. It also
     lands each row's own label at the head's label, since the row is inset by
     exactly the difference between the two badge sizes. */
  .slider-members{display:flex;flex-direction:column;gap:.25rem;
  padding:0 .5rem .5rem;z-index:2}
  /* A member is an ordinary slider card collapsed onto its own track: card and
     track share one grid cell, so the label and the live value ride ON the fill
     instead of sitting in a line above it. Members carry their own surface and no
     elevation — a shadow over the master's coloured fill reads as grime.
     Its edge is the shared `.slider-card:after` ring above, which is also what a
     DARK palette needs to see the row at all: a sunken surface and a card
     surface are a couple of percent apart there, so an OFF member (no fill,
     nothing but its own background) all but vanished into the group. */
  .slider-members .card{display:grid;min-block-size:3rem;margin:0;
  background:var(--fh-surface-sunken);
  border-radius:1.5rem;overflow:hidden}
  .slider-members :is(.slider-head,.slider.max){grid-area:1/1}
  /* Block padding off: a row is sized by `min-block-size`, so its own padding
     would only make it taller than the pill it is. */
  .slider-members .slider-head{align-items:center;padding-block:0;padding-inline:.75rem}
  .slider-members .slider.max{margin:0;block-size:100%}
  .slider-members .slider.max>input{block-size:100%}
  .slider-members .slider.max:before{display:none}
  .slider-members .slider.max>span:not([class]){inset:0 var(--_end) 0 0;block-size:auto;border-radius:0}
  """

/// Value slider as a call (see [[Slider]] for the domain contract). Takes an
/// entity for its domain's default axis, or a capability group for that axis:
/// `c.slider(l)` is brightness, `c.slider(l.colourTemp)` is colour temperature.
function slider(a: SlideAxis): Slider = new Slider { on = a }
/// The slider constructor as a VALUE, for a query's render positions.
hidden slider: (hass.Entity) -> Slider = (e) -> slider(e)

/// The common group as one call: a master and the entities it stands for, each
/// a member [[Slider]] on its own domain's default axis, reading out its LEVEL
/// (a hand-composed member says `.readout("percent")` for the same).
function sliderGroup(a: SlideAxis, members: List<hass.Entity>): Slider =
  new Slider {
    on = a
    children { for (m in members) { (slider(m)) { readout = "percent" } } }
  }
