/// The value slider ABOUT an entity, and the per-domain table that tells it
/// what it drives. The card itself is `base/slider.pkl`'s [[sliderBase.Slider]];
/// this fills its inputs.
module components.slider

import "../core/icon.pkl" as icons
import "../core/simple.pkl" as simpleMod
import "../core/slot.pkl" as slotMod
import "../core/tap.pkl" as tapMod
import "base/slider.pkl" as sliderBase
import "its.pkl" as itsMod
import "select.pkl" as selectMod
import "../hass.pkl"
import "defaults.pkl" as defaultsMod

/// What a slider on an entity given as itself drives, per domain, with the
/// owner left for the slider to fill. A new domain is a row; a light's is its
/// [[hass.Brightness]], which an `onoff` light lacks as a group but still
/// commits through.
const domainAxes: Mapping<String, hass.Axis> = new {
  ["light"] = new hass.Brightness {}
  ["cover"] = new hass.Axis { name = "position"; attr = "current_position"; service = "cover/set_cover_position"; key = "position"; min = 0; max = 100 }
  ["fan"] = new hass.Axis { name = "percentage"; attr = "percentage"; service = "fan/set_percentage"; key = "percentage"; min = 0; max = 100 }
}

// The fill colour paints what the slider drives: a kelvin axis gets a warm→cool
// ramp over its own range, an axis on a colour light the light's `rgb_color`,
// anything else the theme's paint. A hue axis has no fill, only a marker over
// a track painted with the hues (`hueTrack`).
//
// Every read keeps a presence guard (`attr[?'x']…orValue('')`): capability is a
// build-time fact but a live state may drop the attribute, and in CEL a missing
// key throws. Kelvin arrives as a Long and CEL's double overloads take no Long,
// hence `double(k)`. The strings ship as written; only the indent and the edge
// newline go.
const local sliderFillColourRgb: String =
  #"""
  attr[?'rgb_color'].optMap(rgb,
    size(rgb) == 3
      ? 'rgb(' + str(rgb[0]) + ',' + str(rgb[1]) + ',' + str(rgb[2]) + ')'
      : '').orValue('')
  """#.trim()

// `\(minK).0`: the double literal CEL needs, from whole kelvin.
const local function sliderFillColourRamp(minK: Int, maxK: Int): String =
  """
  attr[?'color_temp_kelvin'].optMap(k,
    cel.bind(t,
      (double(k) - \(minK).0) < 0.0 ? 0.0 :
      ((double(k) - \(minK).0) > \(maxK - minK).0
        ? 1.0 : (double(k) - \(minK).0) / \(maxK - minK).0),
      'rgb(' + str(math.round(255.0 - 54.0 * t))
      + ',' + str(math.round(166.0 + 60.0 * t))
      + ',' + str(math.round(87.0 + 168.0 * t)) + ')')).orValue('')
  """.trim()

/// What an [[EntitySlider]] drives: an entity (its domain's default axis) or
/// one of its axes (`l.brightness`, `l.colourTemp`, `l.colour` for the hue),
/// which carries its owner. A value rather than a selector, so
/// `c.entitySlider(l.colourTemp)` on a light with no kelvin range is a
/// nullability error the editor shows (ADR 0013, "Shapes considered").
typealias SlideAxis = hass.Entity|hass.Axis

/// The named readouts: the two that need the card's axis config, and none.
/// Anything else is an [[Expr]]; see [[EntitySlider.readout]].
typealias Readout = "state"|"percent"|"none"

/// A slider on an entity whose domain has a [[domainAxes]] row; any other is a
/// build error at the dashboard line. The card is [[sliderBase.Slider]].
class EntitySlider extends sliderBase.Slider {
  /// What this slider drives. `on` and `entity` default to each other, so
  /// either one is enough.
  hidden on: SlideAxis = entity
  hidden entity: hass.Entity(domainAxes.containsKey(domain)) =
    if (on is hass.Axis) on.owner else on
  hidden axis: hass.Axis =
    if (on is hass.Axis) on else let (e = entity) (domainAxes[e.domain]!!) { owner = e }
  /// The hue's track and marker, a look of this card's.
  hidden hue: Boolean = on is hass.Colour
  /// A list element no simple shape reaches, so such an axis reads through CEL.
  hidden element: Int? = axis.element
  hidden label: (String|slotMod.Expr)? = null
  // What the axis says, which an author's amend overrides.
  hidden action: String = axis.service
  hidden key: String = axis.key
  hidden min: Int = axis.min
  hidden max: Int = axis.max
  // The attribute holding the live position, so a second axis of the same
  // entity tracks the value it writes.
  hidden valueAttr: String = axis.attr
  /// The hue's full saturation, as Mushroom's hue slider: a pastel is a colour
  /// wheel's job, and white is the kelvin axis'.
  valueRest = if (axis.sentWith.isEmpty) null else axis.sentWith.map((n) -> ",\(n)").join("")
  hidden reportsRgb: Boolean =
    if (entity is hass.LightEntity) entity.reportsRgbColour else false
  hidden reportsKelvin: Boolean =
    if (entity is hass.LightEntity)
      entity.colourModes.toList().contains("color_temp")
    else false
  hidden fillColorExpr: String =
    if (hue) "\(valueExpr).optMap(h, 'hsl(' + str(math.round(h)) + ',100%,50%)').orValue('')"
    else if (on is hass.ColourTemp && reportsKelvin) sliderFillColourRamp(min, max)
    else sliderFillColourRgb
  /// Whether the fill colour can change. Where it cannot — most lights — the
  /// base paints a constant, with no signal and no CEL behind it. A hue's is
  /// its marker, in the hue it marks.
  hidden fillColourMoves: Boolean =
    hue || (on is hass.ColourTemp && reportsKelvin) || reportsRgb
  /// The guarded position read, an optional (empty while a light is off): splice
  /// it as `\(valueExpr).optMap(v, …).orValue(…)`.
  hidden valueExpr: String =
    // The binding is named for the attribute (`hs`), as the hue's always was.
    if (element != null)
      let (b = valueAttr.split("_").first)
        "attr[?'\(valueAttr)'].optMap(\(b), double(\(b)[\(element)]))"
    else "attr[?'\(valueAttr)']"
  rangeMin = min
  rangeMax = max
  /// The range as CEL double literals, since `/` on two ints divides as
  /// integers.
  hidden minExpr: String = "\(min).0"
  hidden maxExpr: String = "\(max).0"
  /// A light whose only colour mode is `onoff` has no brightness to set, so the
  /// row becomes a toggle — same pill, filled all-or-nothing, tapped rather than
  /// dragged — and a group's rows still match. HA's positive `onoff`, not "no
  /// dimmable mode": a light the dump caught unavailable reports none.
  hidden toggleOnly: Boolean =
    if (on is hass.LightEntity) on.colourModes.toList() == List("onoff") else false
  /// What a tap on a [[toggleOnly]] row does; every domain with a slider row has
  /// a toggle.
  hidden toggleTap: tapMod.TapAction = tapMod.toggle(entity)
  // A key and no value: the drag supplies it. Refuses only while unavailable —
  // an `opening` cover takes a new position.
  hidden commitTap: tapMod.Call =
    let (k = key) (tapMod.call(action, entity)) { dataKey = k }
  /// The badge, defaulting to the entity's own icon ([[iconFor]]). An MDI name
  /// overrides it; `null` renders none.
  hidden icon: String? = icons.iconFor(entity)
  /// What the line reads out: the state, the level as a percentage of the
  /// range, nothing, or an [[Expr]]. The names are shorthands for readings that
  /// need the axis config, which is exposed for splicing:
  ///
  ///   (c.entitySlider(l)) { readout = c.expr("\(percentExpr) + ' · ' + state") }
  ///   (c.entitySlider(l)) { readout = c.exprOf(power, #"state + ' W'"#) }
  ///
  /// A head with member rows reads out nothing; the rows carry their own.
  hidden readout: (Readout|slotMod.Expr) = if (members.isEmpty) "state" else "none"
  // A readout, so whole numbers; no position (a light that is off) reads 0 %.
  hidden percentExpr: String =
    "\(valueExpr).optMap(v, str(math.round((double(v) - \(minExpr)) * 100.0 / (\(maxExpr) - \(minExpr)))) + ' %').orValue('0 %')"
  // A toggle-only row would read a permanent "0 %", and a group's rows usually
  // get `percent` in one `map`. An author's own [[Expr]] is left alone.
  hidden shownReadout: (Readout|slotMod.Expr) =
    if (toggleOnly && readout == "percent") "state" else readout
  subject = entity.entity_id
  active = slotMod.activeOf(entity) ?? false
  title = slotMod.labelSlot(entity, label)
  glyph = if (icon != null) icons.mdiClass(icon!!) else null
  // An unavailable entity reads "0", not "unavailable".
  position = new slotMod.Reading {
    transform =
      if (element != null) "\(valueExpr).optMap(v, str(math.round(v))).orValue('0')"
      else simpleMod.attr(valueAttr)
    default = "0"
    bypassUnavailable = false
  }
  // Not rounded: beer.min.js recomputes the same percentage unrounded after
  // every morph, and a rounded value twitched into place.
  fill = new slotMod.Reading {
    transform =
      if (toggleOnly) simpleMod.enumOf("on", "0%", "100%")
      else if (hue) "\(valueExpr).optMap(v, str(100.0 - (v - \(minExpr)) * 100.0 / (\(maxExpr) - \(minExpr))) + '%').orValue('100%')"
      else simpleMod.fill(valueAttr, rangeMin, rangeMax)
    default = "100%"
    bypassUnavailable = false
  }
  fillColor = if (fillColourMoves) new slotMod.Reading { transform = fillColorExpr } else null
  // A toggle-only light reports no colour, and `currentcolor` on a full fill
  // reads as text: `--fh-default-color` is the paint for an assumed colour.
  fillDefault =
    if (toggleOnly) "var(--fh-default-color)" else if (hue) "#fff"
    else if (on is hass.ColourTemp && reportsKelvin) "transparent"
    else "currentcolor"
  hueTrack = hue
  kelvinTrack = on is hass.ColourTemp && reportsKelvin
  reading =
    if (shownReadout == "none") null
    else if (shownReadout is slotMod.Expr)
      new slotMod.Reading { entityId = shownReadout.entityId; transform = shownReadout.transform }
    else if (shownReadout == "percent")
      new slotMod.Reading {
        transform =
          if (element != null) percentExpr else simpleMod.percent(valueAttr, rangeMin, rangeMax)
        default = "0 %"
        bypassUnavailable = false
      }
    else new slotMod.Reading { transform = simpleMod.state() }
  readingFollowsDrag = shownReadout == "percent"
  commit = commitTap
  press = if (toggleOnly) toggleTap else null

  /// The main control switch alone: its place among the buttons is the
  /// author's, and without one there is none.
  buttons = List(itsMod.mainControl)

  /// The main controls a light given as itself has, in the order they are
  /// offered: brightness, then each capability. A capability axis
  /// (`l.colourTemp`) is one axis.
  hidden availableControls: List<itsMod.MainControl> =
    if (on is hass.LightEntity && on.brightness != null) on.axes.map((a) -> a.name) as List<itsMod.MainControl>
    else List()
  /// The main control switch among [[buttons]], if any.
  hidden switchSpec: itsMod.MainControlSwitch? =
    let (ss = buttons.filter((b) -> b is itsMod.MainControlSwitch))
      if (ss.length > 1)
        throw("c.entitySlider(\(entity.entity_id)) has \(ss.length) main control switches among its buttons; one switch picks one head.")
      else if (ss.isEmpty) null
      else ss[0] as itsMod.MainControlSwitch
  /// [[fromChooser]]: the control is the nearest chooser's, not this slider's.
  hidden chosenAbove: Boolean = false
  /// The switch's controls where the light has them; none without a switch.
  hidden offeredControls: List<itsMod.MainControl> =
    if (switchSpec == null) List()
    else if (switchSpec.only == null) availableControls
    else switchSpec.only!!.filter((m) -> availableControls.contains(m))
  /// This slider's own head as the given control's axis, dimmed and disabled
  /// for a control a group's row lacks. On a slider with a pill, the buttons
  /// are the pill's.
  function controlHead(m: itsMod.MainControl, dim: Boolean, keepButtons: Boolean): sliderBase.SliderHead =
    let (self = this)
    let (a = (on as hass.LightEntity).axes.find((x) -> x.name == m))
      (self) {
        on = a
        chosenAbove = false
        members = new {}
        readout = self.readout
        greyed = dim
        disabled = if (dim) true else self.disabled
        // Without its switch, so the head is one axis.
        buttons = if (keepButtons) self.buttons.filter((b) -> !(b is itsMod.MainControlSwitch)) else List()
      }.headNode
  hidden following: Boolean = chosenAbove && !availableControls.isEmpty
  controls =
    if (following)
      itsMod.allControls.map((m) ->
        new sliderBase.ControlHead {
          value = m
          head =
            if (m == "brightness" || availableControls.contains(m)) controlHead(m, false, true)
            else controlHead("brightness", true, true)
        })
    else if (offeredControls.length > 1)
      offeredControls.map((m) -> new sliderBase.ControlHead { value = m; head = controlHead(m, false, false) })
    else List()
  declaresControl = !following && controls.length > 1
  /// What this slider starts from ([[defaultsMod.Defaults]]).
  hidden defaults: defaultsMod.Defaults = new {}
  /// What the slider opens on, tried in order as the page opens: the first axis
  /// the light is on then wins, else its first control. Empty is the first
  /// control alone: brightness, where the light dims. From
  /// `defaults.light.opensOn` unless [[opensOn]] says otherwise.
  hidden opensOnAxes: List<hass.Axis> =
    if (on is hass.LightEntity)
      let (l = on)
        defaults.light.opensOn.map((n) -> l.axes.findOrNull((a) -> a.name == n)).filterNonNull() as List<hass.Axis>
    else List()
  /// The tries that can win, up to the first that always does.
  hidden openingTries: List<hass.Axis> =
    let (tries = opensOnAxes.filter((a) -> offeredControls.contains(a.name)))
      let (always = tries.findIndexOrNull((a) -> a.inUseWhen == null))
        if (always == null) tries else tries.take(always + 1)
  /// The start as CEL, the tries nested: `a ? 'colour' : (b ? … : 'brightness')`.
  hidden openingExpr: String? =
    if (!declaresControl || openingTries.every((a) -> a.inUseWhen == null)) null
    else
      openingTries.reverse().fold("'\(controls[0].value)'", (rest, a) ->
        if (a.inUseWhen == null) "'\(a.name)'"
        else
          let (w = a.inUseWhen!!)
            "(attr[?'\(w.attr)'].orValue('') in [\(w.values.map((v) -> "'\(v)'").join(", "))] ? '\(a.name)' : \(rest))")
  controlDeclaration =
    if (openingExpr == null) super.controlDeclaration
    else super.controlDeclaration.withInitialTransform(entity, openingExpr!!)
  /// What this slider hands its `c.its` buttons: a row reading its head's
  /// controls has no switch of its own, so it hands none.
  hidden holder: itsMod.Holder =
    let (e = entity) let (cs = if (declaresControl) offeredControls else List())
      new itsMod.Holder { entity = e; mainControls = cs }
  shownButtons =
    let (h = holder)
      buttons.map((b) -> if (b is itsMod.ItsButton) b.resolve(h) else b)
  /// One control left by the switch that is not brightness: the slider is that axis.
  headNode =
    if (!following && offeredControls.length == 1 && offeredControls[0] != "brightness")
      controlHead(offeredControls[0], false, true)
    else super.headNode

  function label(l: String|slotMod.Expr): EntitySlider = let (self = this) (self) { label = l }
  function action(a: String): EntitySlider = let (self = this) (self) { action = a }
  function key(k: String): EntitySlider = let (self = this) (self) { key = k }
  function min(m: Int): EntitySlider = let (self = this) (self) { min = m }
  function max(m: Int): EntitySlider = let (self = this) (self) { max = m }
  function valueAttr(a: String): EntitySlider = let (self = this) (self) { valueAttr = a }
  function readout(r: Readout|slotMod.Expr): EntitySlider = let (self = this) (self) { readout = r }
  /// No switch of its own: it shows the control chosen by the nearest switch
  /// above it, a group head's or [[controlChooser]]'s, greyed on one its light
  /// lacks. One press, the whole group on colour. A light with no main
  /// controls keeps its plain row.
  function fromChooser(): EntitySlider = let (self = this) (self) { chosenAbove = true }
  /// The order to try as the page opens: the first axis the light is on then,
  /// else the first control. Read once; an open page does not follow the
  /// light. Without it the slider follows `defaults.light.opensOn`, which
  /// opens on brightness unless your `components.pkl` sets it; this opens on
  /// the mode the light is in:
  ///
  ///   c.entitySlider(l).opensOn(List(l.colourTemp, l.colour))
  function opensOn(xs: List<hass.Axis?>): EntitySlider =
    let (self = this) let (axs = xs.filterNonNull() as List<hass.Axis>) (self) { opensOnAxes = axs }
  /// The member rows, each composed by the caller:
  ///
  ///   c.entitySlider(l).withSubSliders(
  ///     l.members.map((m) -> c.entitySlider(m).readout("percent").icon(null))
  ///   )
  ///
  /// A member that is not a slider goes through `members` directly.
  function withSubSliders(sliders: List<EntitySlider>): EntitySlider =
    let (self = this) (self) { members = sliders.toListing() }
  /// `.icon(null)` renders no badge.
  function icon(i: String?): EntitySlider = let (self = this) (self) { icon = i }
  /// `.buttons(List(c.its.toggle, c.its.mainControl, c.its.colourWheel))`: on
  /// a light with main controls they are on its pill. Without
  /// `c.its.mainControl` the slider has one, its plain row.
  function buttons(xs: List<sliderBase.SliderButton?>): EntitySlider =
    let (self = this) (self) { buttons = xs }
  function secondary(s: slotMod.Secondary): EntitySlider = let (self = this) (self) { secondary = s }
}

/// One switch over the light sliders beneath it that are
/// [[EntitySlider.fromChooser]]: press colour and each shows its colour head.
hidden controlChooser: selectMod.Chooser = selectMod.chooser(itsMod.controlSelect(itsMod.allControls, "buttons"))

/// `c.entitySlider(l)` switches between the main controls the light has, opening
/// on brightness unless `defaults.light.opensOn` or [[EntitySlider.opensOn]]
/// says otherwise; `c.entitySlider(l.brightness)`
/// is brightness alone, `c.entitySlider(l.colourTemp)` colour temperature,
/// `c.entitySlider(l.colour)` the hue.
function entitySlider(a: SlideAxis): EntitySlider = new EntitySlider { on = a }
/// The constructor as a value, for a query's render positions.
hidden entitySlider: (hass.Entity) -> EntitySlider = (e) -> entitySlider(e)
