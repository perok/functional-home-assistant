/// The value slider ABOUT an entity, and the per-domain table that tells it
/// what it drives. The card itself is `base/slider.pkl`'s [[sliderBase.Slider]];
/// this fills its inputs.
module components.slider

import "../core/icon.pkl" as icons
import "../core/simple.pkl" as simpleMod
import "../core/slot.pkl" as slotMod
import "../core/tap.pkl" as tapMod
import "control.pkl" as control
import "base/slider.pkl" as sliderBase
import "../hass.pkl"

/// A domain's slider config: the service, the key the value rides on, the
/// range, and the attribute holding the live position. A new domain is a row.
class SliderSpec {
  action: String
  key: String
  min: Int
  max: Int
  value: String
}

const sliderSpec: Mapping<String, SliderSpec> = new {
  ["light"] = new { action = "light/turn_on"; key = "brightness"; min = 1; max = 255; value = "brightness" }
  ["cover"] = new { action = "cover/set_cover_position"; key = "position"; min = 0; max = 100; value = "current_position" }
  ["fan"] = new { action = "fan/set_percentage"; key = "percentage"; min = 0; max = 100; value = "percentage" }
}

// The fill colour paints what the slider drives: a kelvin axis gets a warm→cool
// ramp over its own range, an axis on a colour light the light's `rgb_color`,
// anything else the theme's paint. A hue axis has no fill, only a marker over
// a track painted with the hues (`hueTrack`).
//
// Every read keeps a presence guard (`attr[?'x']…orValue('')`): capability is a
// build-time fact but a live state may drop the attribute, and in CEL a missing
// key throws. Kelvin arrives as a Long and CEL's double overloads take no Long,
// hence `double(k)`. The strings ship as written; only the indent and the edge
// newline go.
const local sliderFillColourRgb: String =
  #"""
  attr[?'rgb_color'].optMap(rgb,
    size(rgb) == 3
      ? 'rgb(' + str(rgb[0]) + ',' + str(rgb[1]) + ',' + str(rgb[2]) + ')'
      : '').orValue('')
  """#.trim()

// `\(minK).0`: the double literal CEL needs, from whole kelvin.
const local function sliderFillColourRamp(minK: Int, maxK: Int): String =
  """
  attr[?'color_temp_kelvin'].optMap(k,
    cel.bind(t,
      (double(k) - \(minK).0) < 0.0 ? 0.0 :
      ((double(k) - \(minK).0) > \(maxK - minK).0
        ? 1.0 : (double(k) - \(minK).0) / \(maxK - minK).0),
      'rgb(' + str(math.round(255.0 - 54.0 * t))
      + ',' + str(math.round(166.0 + 60.0 * t))
      + ',' + str(math.round(87.0 + 168.0 * t)) + ')')).orValue('')
  """.trim()

// The author's override, else the spec's value as a string (a slot is never a
// number). `ovr` because `override` is reserved.
const local function sliderConfig(ovr: String?, spec: SliderSpec, get: (SliderSpec) -> Any): String =
  if (ovr != null) ovr else "\(get.apply(spec))"

/// What an [[EntitySlider]] drives: an entity (its domain's default axis) or
/// one of its capability groups (`l.colourTemp`, `l.colour` for the hue), which
/// carries its owner. A value rather than a selector, so
/// `c.entitySlider(l.colourTemp)` on a light with no kelvin range is a
/// nullability error the editor shows (ADR 0013, "Shapes considered").
typealias SlideAxis = hass.Entity|hass.ColourTemp|hass.Colour

/// What a light's slider can switch to, in the order [[EntitySlider]] offers
/// them. On/off is not one: it is the pill's power button.
typealias SliderMode = "brightness"|"colourTemp"|"colour"

const local modeIcons: Mapping<SliderMode, String> = new {
  ["brightness"] = "mdi:brightness-6"
  ["colourTemp"] = "mdi:thermometer"
  ["colour"] = "mdi:palette"
}

const local modeLabels: Mapping<SliderMode, String> = new {
  ["brightness"] = "Brightness"
  ["colourTemp"] = "Colour temperature"
  ["colour"] = "Colour"
}

/// The named readouts: the two that need the card's axis config, and none.
/// Anything else is an [[Expr]]; see [[EntitySlider.readout]].
typealias Readout = "state"|"percent"|"none"

/// One button at the right of a slider's head: an ordinary round
/// [[control.EntityButton]]. Each is its own node, so two can be in flight at
/// once (ADR 0019 allows one guarded element per node).
///
///     c.entitySlider(l).actions(List(
///       c.sliderAction(l, c.tap.toggle(l)),
///       c.sliderAction(l, c.tap.moreInfo(l)).icon("mdi:information").active(false)
///     ))
const function sliderAction(e: hass.Entity, t: tapMod.TapAction): control.EntityButton =
  (control.entityButton(e)) { icon = "mdi:power"; label = ""; tapAction = t; active = slotMod.activeOf(e) ?? false }

/// A slider on an entity whose domain has a [[sliderSpec]] row; any other is a
/// build error at the dashboard line. The card is [[sliderBase.Slider]].
class EntitySlider extends sliderBase.Slider {
  /// What this slider drives. `on` and `entity` default to each other, so
  /// either one is enough.
  hidden on: SlideAxis = entity
  hidden entity: hass.Entity(sliderSpec.containsKey(domain)) =
    if (on is hass.ColourTemp) on.owner else if (on is hass.Colour) on.owner else on
  /// The hue lives at `hs_color[0]`, which no simple shape reaches, so this
  /// axis reads through CEL.
  hidden hue: Boolean = on is hass.Colour
  hidden label: (String|slotMod.Expr)? = null
  // Overrides of the domain default. Each defaults to what the axis says, so a
  // capability axis configures the whole slider and an author's amend still
  // wins.
  hidden action: String? = if (on is hass.ColourTemp || hue) "light/turn_on" else null
  hidden key: String? =
    if (on is hass.ColourTemp) "color_temp_kelvin" else if (hue) "hs_color" else null
  hidden min: Int? = if (on is hass.ColourTemp) on.min_kelvin else if (hue) 0 else null
  hidden max: Int? = if (on is hass.ColourTemp) on.max_kelvin else if (hue) 360 else null
  // The attribute holding the live position, so a second axis of the same
  // entity tracks the value it writes.
  hidden valueAttr: String? =
    if (on is hass.ColourTemp) "color_temp_kelvin" else if (hue) "hs_color" else null
  /// Full saturation, as Mushroom's hue slider: a pastel is a colour wheel's
  /// job, and white is the kelvin axis'.
  valueRest = if (hue) ",100" else null
  hidden spec: SliderSpec = sliderSpec[entity.domain]!!
  hidden reportsRgb: Boolean =
    if (entity is hass.LightEntity) entity.reportsRgbColour else false
  hidden reportsKelvin: Boolean =
    if (entity is hass.LightEntity)
      entity.colourModes.toList().contains("color_temp")
    else false
  hidden fillColorExpr: String =
    if (on is hass.ColourTemp && reportsKelvin) sliderFillColourRamp(min!!, max!!)
    else sliderFillColourRgb
  /// Whether the fill colour can change. Where it cannot — most lights — the
  /// base paints a constant, with no signal and no CEL behind it.
  hidden fillColourMoves: Boolean =
    (on is hass.ColourTemp && reportsKelvin) || (reportsRgb && !hue)
  /// The guarded position read, an optional (empty while a light is off): splice
  /// it as `\(valueExpr).optMap(v, …).orValue(…)`.
  hidden valueExpr: String =
    if (hue) "attr[?'hs_color'].optMap(hs, double(hs[0]))"
    else if (valueAttr != null) "attr[?'\(valueAttr!!)']"
    else "attr[?'\(spec.value)']"
  hidden valueAttrName: String = valueAttr ?? spec.value
  rangeMin = min ?? spec.min
  rangeMax = max ?? spec.max
  /// The range as CEL double literals, since `/` on two ints divides as
  /// integers.
  hidden minExpr: String = if (min != null) "\(min!!).0" else "\(spec.min).0"
  hidden maxExpr: String = if (max != null) "\(max!!).0" else "\(spec.max).0"
  /// A light whose only colour mode is `onoff` has no brightness to set, so the
  /// row becomes a toggle — same pill, filled all-or-nothing, tapped rather than
  /// dragged — and a group's rows still match. HA's positive `onoff`, not "no
  /// dimmable mode": a light the dump caught unavailable reports none.
  hidden toggleOnly: Boolean =
    if (on is hass.LightEntity) on.colourModes.toList() == List("onoff") else false
  /// What a tap on a [[toggleOnly]] row does; every domain with a slider row has
  /// a toggle.
  hidden toggleTap: tapMod.TapAction = tapMod.toggle(entity)
  // A key and no value: the drag supplies it. Refuses only while unavailable —
  // an `opening` cover takes a new position.
  hidden commitTap: tapMod.Call =
    (tapMod.call(sliderConfig(action, spec, (s) -> s.action), entity)) {
      dataKey = sliderConfig(key, spec, (s) -> s.key)
    }
  /// The badge, defaulting to the entity's own icon ([[iconFor]]). An MDI name
  /// overrides it; `null` renders none.
  hidden icon: String? = icons.iconFor(entity)
  /// The one-button shorthand: it leads the author's `actions`.
  hidden tapAction: tapMod.TapAction? = null
  /// What the line reads out: the state, the level as a percentage of the
  /// range, nothing, or an [[Expr]]. The names are shorthands for readings that
  /// need the axis config, which is exposed for splicing:
  ///
  ///   (c.entitySlider(l)) { readout = c.expr("\(percentExpr) + ' · ' + state") }
  ///   (c.entitySlider(l)) { readout = c.exprOf(power, #"state + ' W'"#) }
  ///
  /// A head with member rows reads out nothing; the rows carry their own.
  hidden readout: (Readout|slotMod.Expr) = if (members.isEmpty) "state" else "none"
  // A readout, so whole numbers; no position (a light that is off) reads 0 %.
  hidden percentExpr: String =
    "\(valueExpr).optMap(v, str(math.round((double(v) - \(minExpr)) * 100.0 / (\(maxExpr) - \(minExpr)))) + ' %').orValue('0 %')"
  // A toggle-only row would read a permanent "0 %", and a group's rows usually
  // get `percent` in one `map`. An author's own [[Expr]] is left alone.
  hidden shownReadout: (Readout|slotMod.Expr) =
    if (toggleOnly && readout == "percent") "state" else readout
  subject = entity.entity_id
  active = slotMod.activeOf(entity) ?? false
  title = slotMod.labelSlot(entity, label)
  glyph = if (icon != null) icons.mdiClass(icon!!) else null
  // An unavailable entity reads "0", not "unavailable".
  position = new slotMod.Slot {
    transform =
      if (hue) "\(valueExpr).optMap(v, str(math.round(v))).orValue('0')"
      else simpleMod.attr(valueAttrName)
    default = "0"
    bypassUnavailable = false
  }
  // Not rounded: beer.min.js recomputes the same percentage unrounded after
  // every morph, and a rounded value twitched into place.
  fill = new slotMod.Slot {
    transform =
      if (toggleOnly) simpleMod.enumOf("on", "0%", "100%")
      else if (hue) "\(valueExpr).optMap(v, str(100.0 - (v - \(minExpr)) * 100.0 / (\(maxExpr) - \(minExpr))) + '%').orValue('100%')"
      else simpleMod.fill(valueAttrName, rangeMin, rangeMax)
    default = "100%"
    bypassUnavailable = false
  }
  fillColor = if (fillColourMoves) new slotMod.Slot { transform = fillColorExpr } else null
  // A toggle-only light reports no colour, and `currentcolor` on a full fill
  // reads as text: `--fh-default-color` is the paint for an assumed colour.
  fillDefault =
    if (toggleOnly) "var(--fh-default-color)" else if (hue) "#fff" else "currentcolor"
  hueTrack = hue
  reading =
    if (shownReadout == "none") null
    else if (shownReadout is slotMod.Expr)
      new slotMod.Slot { entityId = shownReadout.entityId; transform = shownReadout.transform }
    else if (shownReadout == "percent")
      new slotMod.Slot {
        transform =
          if (hue) percentExpr else simpleMod.percent(valueAttrName, rangeMin, rangeMax)
        default = "0 %"
        bypassUnavailable = false
      }
    else new slotMod.Slot { transform = simpleMod.state() }
  readingFollowsDrag = shownReadout == "percent"
  commit = commitTap
  press = if (toggleOnly) toggleTap else null
  leadingActions = new Listing {
    when (tapAction != null) {
      (sliderAction(entity, tapAction!!))
    }
  }

  /// What a light given as itself can switch to: brightness, then each
  /// capability it has. A capability axis (`l.colourTemp`) is one axis.
  hidden availableModes: List<SliderMode> =
    if (on is hass.LightEntity && on.supportsBrightness)
      List("brightness")
        + (if (on.colourTemp != null) List("colourTemp") else List())
        + (if (on.colour != null) List("colour") else List())
    else List()
  /// [[modes]]'s choice; null offers every one the light has.
  hidden modeChoice: List<SliderMode>? = null
  hidden singleMode: Boolean = false
  /// Set on a group's row by its head: the head's modes, which the row shows
  /// in step, greyed where it lacks one.
  hidden followModes: List<SliderMode>? = null
  hidden pickedModes: List<SliderMode> =
    if (modeChoice == null) availableModes
    else
      let (picked = modeChoice!!.filter((m) -> availableModes.contains(m)))
        if (picked.isEmpty)
          throw("c.entitySlider(\(entity.entity_id)).modes(\(modeChoice!!)): the light has none of them; it has \(availableModes)")
        else picked
  /// Rendered once per member of a candidate set, a slider cannot declare
  /// [[sliderBase.modeVar]] (ADR 0033), so it keeps its first mode.
  hidden offeredModes: List<SliderMode> =
    if (singleMode || perMember) pickedModes.take(1) else pickedModes
  /// This slider's own head as the given mode's axis — its default one for
  /// brightness — dimmed and disabled for a mode a group's row lacks. On a
  /// slider with a pill, the actions are the pill's.
  function modeHead(m: SliderMode, dim: Boolean, keepActions: Boolean): sliderBase.SliderHead =
    let (self = this)
    let (axis =
        if (m == "colourTemp") (on as hass.LightEntity).colourTemp!!
        else if (m == "colour") (on as hass.LightEntity).colour!!
        else self.on)
      (self) {
        on = axis
        singleMode = true
        modeChoice = null
        followModes = null
        members = new {}
        readout = self.readout
        greyed = dim
        disabled = if (dim) true else self.disabled
        tapAction = if (keepActions) self.tapAction else null
        actions = if (keepActions) self.actions else new {}
      }.headNode
  hidden following: Boolean = followModes != null && followModes!!.length > 1
  modes =
    if (following)
      followModes!!.map((m) ->
        new sliderBase.ModeHead {
          head =
            if (m == "brightness" || availableModes.contains(m)) modeHead(m, false, true)
            else modeHead("brightness", true, true)
        })
    else if (offeredModes.length > 1)
      let (n = offeredModes.length)
        offeredModes.mapIndexed((i, m) ->
          new sliderBase.ModeHead {
            head = modeHead(m, false, false)
            button = new sliderBase.ModeButton {
              label = modeLabels[m]
              icon = modeIcons[m]
              // A switch answers too fast for a spinner to mean anything.
              tapAction = (sliderBase.modeVar.choose(((i + 1) % n).toString())) { busyVisual = false }
            }
          })
    else List()
  declaresMode = !following && modes.length > 1
  /// One mode left by [[modes]] that is not brightness: the slider is that axis.
  headNode =
    if (!following && offeredModes.length == 1 && offeredModes[0] != "brightness")
      modeHead(offeredModes[0], false, true)
    else super.headNode
  pillActions = if (declaresMode) new Listing { ...leadingActions ...actions } else new {}
  memberRows =
    if (declaresMode)
      let (ms = offeredModes)
        members.toList().map((n) -> if (n is EntitySlider) (n) { followModes = ms } else n).toListing()
    else members

  function label(l: String|slotMod.Expr): EntitySlider = let (self = this) (self) { label = l }
  function action(a: String): EntitySlider = let (self = this) (self) { action = a }
  function key(k: String): EntitySlider = let (self = this) (self) { key = k }
  function min(m: Int): EntitySlider = let (self = this) (self) { min = m }
  function max(m: Int): EntitySlider = let (self = this) (self) { max = m }
  function valueAttr(a: String): EntitySlider = let (self = this) (self) { valueAttr = a }
  function readout(r: Readout|slotMod.Expr): EntitySlider = let (self = this) (self) { readout = r }
  /// One axis, the light's first: brightness on a dimmer. No mode switch.
  function single(): EntitySlider = let (self = this) (self) { singleMode = true }
  /// These modes, in this order, where the light has them; one left is that
  /// axis alone. A light with none of them is a build error naming it.
  ///
  ///   c.entitySlider(l).modes(List("colour", "colourTemp"))
  function modes(ms: List<SliderMode>): EntitySlider = let (self = this) (self) { modeChoice = ms }
  /// The member rows, each composed by the caller:
  ///
  ///   c.entitySlider(l).withSubSliders(
  ///     l.members.map((m) -> c.entitySlider(m).readout("percent").icon(null))
  ///   )
  ///
  /// A member that is not a slider goes through `members` directly.
  function withSubSliders(sliders: List<EntitySlider>): EntitySlider =
    let (self = this) (self) { members = sliders.toListing() }
  /// `.icon(null)` renders no badge.
  function icon(i: String?): EntitySlider = let (self = this) (self) { icon = i }
  function tapAction(t: tapMod.TapAction): EntitySlider = let (self = this) (self) { tapAction = t }
  function secondary(s: slotMod.Secondary): EntitySlider = let (self = this) (self) { secondary = s }
}

/// `c.entitySlider(l)` is brightness, switching to each other mode the light
/// has; `c.entitySlider(l.colourTemp)` is colour temperature alone,
/// `c.entitySlider(l.colour)` the hue.
function entitySlider(a: SlideAxis): EntitySlider = new EntitySlider { on = a }
/// The constructor as a value, for a query's render positions.
hidden entitySlider: (hass.Entity) -> EntitySlider = (e) -> entitySlider(e)
