/// A tile that knows nothing about Home Assistant: a glyph, a title, a reading,
/// an optional secondary line, an optional tap, and features under it. HA's
/// entity card is `components/entity.pkl`'s `EntityCard`, which only fills these.
module components.base.tile

import "../../core/badge.pkl" as badgeMod
import "../../core/node.pkl" as nodes
import "../../core/predicate.pkl" as predMod
import "../../core/slot.pkl" as slotMod
import "../../core/tap.pkl" as tapMod
import "../../core/text.pkl" as textMod

/// The tile. `title`, `reading`, `secondary` and `glyph` each take a literal or
/// a reading; the card decides how each is carried.
open class Tile extends nodes.ActiveNode {
  card = "tile"
  cardDef = new nodes.CardDef {
    // Features are nodes, so the tile is structure and everything on it that
    // moves is a signal. The tap, its guard and its dimming are the ROW's, so a
    // feature's own press never also posts the tile's and a refused tile does
    // not dim its latch.
    regions = new Mapping {
      ["features"] = new nodes.Region {}
    }
    // The glyph in the shared badge, which is also the spinner's host, then the
    // title with its reading and second line under it. A `div`, not BeerCSS's
    // `<header>`, which is a 4rem app-bar grid.
    template = """
      <article class="card entity fh-tile-card">
        <div class="fh-tile{{#tappable}} tappable{{/tappable}}\(tapMod.refusedNow(" fh-disabled"))"{{#tappable}}
        data-on:click="\(tapMod.guardClick)\(tapMod.click)"{{/tappable}}\(tapMod.guard)>\(badgeMod.seat("", "{{icon}}", badgeMod.tapSpin))<span class="fh-lines"><span class="\(textMod.BOX)">\(textMod.liveRun("label"))</span>
        <span class="fh-reading \(textMod.BOX)">\(textMod.liveRun("value"))</span>\(slotMod.ifSlot("secondary"))
        <span class="fh-sub \(textMod.BOX)">\(textMod.liveRun("secondary"))</span>\(slotMod.endIfSlot("secondary"))</span></div>{{#features}}{{{html}}}{{/features}}
      </article>
      """
    slots { "label"; "value" }
    // The row and its on look are `core/css.pkl`'s, shared with the switch. The
    // card's padding is on the row, so the whole card still answers a press;
    // each feature is a full-width cell under it, the card resetting what a
    // cell inherits.
    css = """
      .card.tappable,.fh-tile.tappable{cursor:pointer}
      .fh-tile-card{--fh-cell-flex:0 0 auto;--fh-cell-width:auto;--fh-cell-align-self:stretch}
      .fh-tile-card>.fh-cell{margin:0 1rem .5rem}
      .fh-tile-card>.fh-tile+.fh-cell{margin-block-start:-.25rem}
      .fh-tile-card>.fh-cell:last-child{margin-block-end:1rem}
      .fh-tile .fh-reading{font-size:.875em}
      """
  }
  hidden title: String|slotMod.Slot = ""
  /// A reading is carried as a signal (ADR 0017): a temperature ticking costs a
  /// few bytes instead of the tile.
  hidden reading: String|slotMod.Slot = ""
  hidden secondary: slotMod.Secondary? = null
  /// The `<i>`'s WHOLE class (`mdi mdi-lock`), a literal or a reading. Whole,
  /// so the template has one `{{icon}}` and needs no flag saying which; a
  /// reading is a signal on `class`.
  hidden glyph: (String|slotMod.Slot)? = null
  /// Null opts the card out of clicks entirely.
  hidden tapAction: tapMod.TapAction? = null
  inlineSurfaces = if (tapAction != null) tapAction!!.inlineSurfaces else null
  /// See `Button.subject`.
  hidden subject: String? = null
  /// Controls and readouts under the tile, HA's card features: nodes, each its
  /// own patch target and its own tap, outside the tile's.
  hidden features: Listing<nodes.LayoutNode> = new {}
  children = if (features.isEmpty) new Listing {} else new Mapping { ["features"] = features }
  /// Refuses the tap and wears `fh-disabled` while it holds, ORed with the
  /// tap's own refusal, as `Button.disabled`.
  hidden disabled: nodes.BooleanInput? = null
  derivedValues {
    when (disabled is predMod.Predicate) { ["__disabled"] = disabled!! }
  }
  slots {
    when (subject != null) {
      ["entity_id"] = subject!!
    }
    ["label"] = if (title is slotMod.Slot) (title as slotMod.Slot) { signal = slotMod.asText } else title
    ["value"] = if (reading is slotMod.Slot) (reading as slotMod.Slot) { signal = slotMod.asText } else reading
    when (glyph != null) {
      ["icon"] =
        if (glyph is slotMod.Slot) (glyph as slotMod.Slot) { signal = slotMod.asAttr("class") }
        else glyph!!
    }
    when (secondary != null) {
      ["secondary"] = slotMod.secondarySlot(secondary!!)
    }
    // A class and a click guard, not `disabled`: an `<article>` cannot be
    // disabled.
    for (k, v in tapMod.tapSlots(tapAction)) {
      [k] = v
    }
    for (k, v in badgeMod.slots(active)) {
      [k] = v
    }
    when (nodes.disabledSlot(disabled) != null) {
      ["disabled"] = nodes.disabledSlot(disabled)!!
    }
  }
  function disabled(d: nodes.BooleanInput): Tile = let (self = this) (self) { disabled = d }
  /// `c.entityCard(l).features(List(latch))`.
  function features(xs: List<nodes.LayoutNode>): Tile = let (self = this) (self) { features = xs.toListing() }
  /// `c.entityCard(l).active(false)` for a badge with neither an on nor an off look.
  function active(a: nodes.BooleanInput): Tile = let (self = this) (self) { active = a }
}
