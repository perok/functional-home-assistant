/// Cards kept as worked examples, as `c.examples`: each shows one mechanism a
/// component author may copy, and none is part of the everyday set.
module components.examples

import "../core/node.pkl" as nodes
import "../core/slot.pkl" as slotMod
import "../core/text.pkl" as textMod
import "../providers.pkl" as providersMod
import "../providers/history.pkl" as historyProv
import "history.pkl" as historyMod
import "../hass.pkl"

/// The history answer as data rather than a drawing: now, low and high over
/// the window — the worked example of the passthrough stage.
///
/// A fetch slot is bytes, never a signal (ADR 0031), so the card lifts the
/// JSON into a client-only signal itself, `data-signals:_hist_<id>` over an
/// escaped hole. A re-fetch morphs the attribute, and Datastar re-applies a
/// changed `data-*` attribute, so every reading re-runs. The JSON is the
/// history provider's `{"points": [[epochMillis, value], …]}`, every point.
class HistoryReadings extends nodes.Node {
  card = "historyReadings"
  cardDef = new nodes.CardDef {
    template = """
      <article class="fh-card fh-readings" data-signals:\(readingsSignal)="{{readings}}">
        <header>\(textMod.hole("label"))</header>
        <dl>
          <div><dt>Now</dt><dd data-text="\(stat("p[p.length - 1]"))"></dd></div>
          <div><dt>Low</dt><dd data-text="\(stat("Math.min(...p)"))"></dd></div>
          <div><dt>High</dt><dd data-text="\(stat("Math.max(...p)"))"></dd></div>
          <div><dt>Covers</dt><dd class="fh-readings-span" data-text="\(covers)"></dd></div>
        </dl>
      </article>
      """
    slots { "label"; "readings"; "unit"; "entity_id" }
    css = """
      .fh-readings dl{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.5rem;margin:0}
      .fh-readings dt{color:var(--fh-text-dim);font-size:.75rem}
      .fh-readings dd{margin:0;font-variant-numeric:tabular-nums}
      """
  }

  hidden entity: hass.SensorEntity
  hidden window: historyProv.Over = historyProv.presets["24h"]

  slots {
    ["entity_id"] = entity.entity_id
    ["label"] = slotMod.labelSlot(entity, null)
    ["unit"] = entity.unit_of_measurement ?? ""
    // No `transform`: a fetch slot's default stage is passthrough.
    ["readings"] = new slotMod.Slot { fetch = historyProv.of(entity, window) }
  }

  function over(w: providersMod.HistoryWindow): HistoryReadings =
    let (self = this) (self) { window = providersMod.historyWindow(w) }
  function fromChooser(): HistoryReadings =
    over(historyProv.chosen(historyMod.windowVar, historyProv.presets))
}

// Named by the node, so two readings cards never share one signal.
const local readingsSignal: String = "_hist_{{id}}"

// One reading over the signal's values, rounded, with the unit; a dash when the
// window holds nothing. `p` is the values, nulls dropped.
const local function stat(of: String): String =
  "(p => p.length ? Math.round(\(of) * 10) / 10 + '{{#unit}} {{unit}}{{/unit}}' : '–')" +
    "($\(readingsSignal).points.map(x => x[1]).filter(v => v !== null))"

// How many hours the answer spans, from the timestamps.
const local covers: String =
  "(q => q.length > 1 ? Math.round((q[q.length - 1][0] - q[0][0]) / 3600000) + ' h' : '–')" +
    "($\(readingsSignal).points)"

/// Now, low and high of `e` over the last 24 hours; `.fromChooser()` under a
/// `c.history.chooser`.
function historyReadings(e: hass.SensorEntity): HistoryReadings =
  new HistoryReadings { entity = e }
