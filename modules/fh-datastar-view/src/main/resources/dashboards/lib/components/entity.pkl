/// The entity card — HA's familiar icon, label and value tile.
module components.entity

import "../core/icon.pkl" as icons
import "../core/slot.pkl" as slotMod
import "../core/tap.pkl" as tapMod
import "../hass.pkl"
import "base/tile.pkl" as tileMod
import "moreinfo.pkl"

/// Icon, label, value (the state or an attribute, unit appended; a scene's or a
/// button's last activation as a clock time, [[slotMod.readingOf]]), an optional
/// second line and an optional tap. Its badge is lit while the entity is on, by
/// HA's per-domain rule (`slotMod.activeOf`). A thin [[tileMod.Tile]]: its own inputs
/// are entity-relative (`value("brightness")` names an attribute of THIS
/// entity) and become the tile's `title`, `reading` and `glyph`.
open class EntityCard extends tileMod.Tile {
  hidden entity: hass.Entity
  hidden label: (String|slotMod.Reading)? = null
  hidden value: (String|slotMod.Reading)? = null
  /// An MDI name overriding [[icons.iconFor]].
  hidden icon: String? = null
  /// The domain's service, else more-info, and more-info for a lock
  /// ([[moreinfo.defaultTap]]); `null` for no click at all.
  tapAction = moreinfo.defaultTap(entity)
  subject = entity.entity_id
  title = slotMod.labelSlot(entity, label)
  reading = slotMod.valueSlot(value ?? slotMod.readingOf(entity))
  glyph = icons.glyphOf(entity, icon)
  active = slotMod.activeOf(entity) ?? false
  // Each option is also a chainable method,
  // `c.entityCard(x).tapAction(c.tap.toggle(x)).label("Office")`, emitting the
  // same JSON as the amend form.
  function label(l: String|slotMod.Reading): this = (this) { label = l }
  function value(v: String|slotMod.Reading): this = (this) { value = v }
  function secondary(s: slotMod.Secondary): this = (this) { secondary = s }
  /// `mdi:thermometer`, or the `mdi-thermometer` class spelling.
  function icon(i: String): this = (this) { icon = i }
  function tapAction(t: tapMod.TapAction): this = (this) { tapAction = t }
}

function entityCard(e: hass.Entity): EntityCard = new EntityCard { entity = e }
/// The constructor as a value, for a query's render positions:
/// `q.from(xs).render(c.entityCard)`.
hidden entityCard: (hass.Entity) -> EntityCard = (e) -> entityCard(e)

/// Forces `homeassistant/toggle`: `c.entityCard(x) |> c.tappable`. Only for a
/// domain `hass/actions.pkl` does not know.
tappable: Mixin<EntityCard> = new { tapAction = tapMod.call("homeassistant/toggle", entity) }
