/// The entity card — HA's familiar icon + label + value tile — and the icon
/// resolution every card shares.
module components.entity

import "../core/icon.pkl" as icons
import "../core/node.pkl" as nodes
import "../core/slot.pkl" as slotMod
import "../core/tap.pkl" as tapMod
import "../core/text.pkl" as textMod
import "../hass.pkl"
import "moreinfo.pkl"

/// HA-like entity card: icon + label + value (state or attribute, unit
/// auto-appended) + optional secondary line + optional tap. `icon` overrides
/// what [[iconFor]] resolved, as an MDI name (`mdi:thermometer`).
class EntityCard extends nodes.Node {
  card = "entityCard"
  cardDef = new nodes.CardDef {
    template = """
      <article class="card entity{{#tappable}} tappable{{/tappable}}"{{#tappable}}
        data-on:click="\(tapMod.guardClick){{{onclick}}}"{{/tappable}}\(tapMod.guard)>
        <header>{{#icon}}{{#busy}}<span class="fh-icon-shape"{{#busyVisual}} \(tapMod.busyShapeClass){{/busyVisual}}>{{/busy}}<i class="mdi {{icon}}"></i>{{#busy}}</span>{{/busy}}{{/icon}}\(textMod.hole("label"))</header>
        <span class="state \(textMod.BOX)">\(textMod.liveRun("value"))</span>{{#secondary}}
        <span class="secondary \(textMod.BOX)">\(textMod.run("secondary"))</span>{{/secondary}}
      </article>
      """
    slots { "label"; "value"; "entity_id" }
    // The card's own structure. The icon rules are metrics only — which FONT
    // draws the glyph is the theme's (it ships the icon set), and so is the
    // spinner badge's paint.
    //
    // The header is a FLEX line because its label is a box now (`core/text.pkl`)
    // and a block box beside an inline icon would drop to its own line. The icon
    // must not be the thing that shrinks, so the label is — which is what the
    // clip and scroll modes need to act on at all.
    css = """
      .card.tappable{cursor:pointer}
      .entity header{display:flex;align-items:center;min-inline-size:0}
      .entity header>:is(i.mdi,.fh-icon-shape){flex:0 0 auto}
      .entity header i.mdi{font-size:1.25rem;line-height:1;
      margin-inline-end:.375rem;color:var(--fh-accent)}
      .entity .secondary{font-size:.8em;color:var(--fh-text-dim)}
      """
  }
  hidden entity: hass.Entity
  hidden label: (String|slotMod.Expr)? = null
  hidden value: (String|slotMod.Expr)? = null
  hidden secondary: (String|slotMod.Expr)? = null
  hidden icon: String? = null
  /// What a click does. Defaults to [[moreinfo.defaultTap]] — this entity's
  /// domain service if it has one, more-info if it does not — so a card is
  /// always clickable and never claims an action it cannot perform. `tapAction = null`
  /// opts a card out entirely (no pointer, no handler).
  hidden tapAction: tapMod.TapAction? = moreinfo.defaultTap(entity)
  // Copy the tap's inline surfaces onto the node so the hoist lifts them
  // (mirror jsonnet tapInline, components.libsonnet:186-188). Null when the tap
  // is null or carries no inline popup → dropped by omitNullProperties.
  inlineSurfaces = if (tapAction != null) tapAction!!.inlineSurfaces else null
  slots {
    // entity_id is the card's subject — the magical slot the others inherit.
    ["entity_id"] = entity.entity_id
    ["label"] = slotMod.labelSlot(entity, label)
    // A SIGNAL slot (ADR 0017): the reading is the one thing on this card that
    // moves on an ordinary tick, so carrying it as a signal is what turns a
    // temperature ticking from 21.4 to 21.5 into a few bytes instead of the
    // whole tile. Everything else here — icon, label, tap — is a registry fact
    // or a literal and never moves at all.
    ["value"] = slotMod.signalValueSlot(value)
    // A LITERAL, always: the entity's own icon, its device_class or its domain
    // are all registry facts, so there is nothing here for the runtime to
    // decide. This used to be a `$lookup($domain)` transform on every card,
    // because a query group's member had no identity at build time.
    when (icons.iconFor(entity) != null || icon != null) {
      ["icon"] = if (icon != null) icons.mdiClass(icon!!) else icons.iconFor(entity)!!
    }
    when (secondary != null) {
      ["secondary"] = slotMod.secondarySlot(secondary!!)
    }
    when (tapAction != null) {
      ["tappable"] = "1"
      ["onclick"] = tapAction!!.onclick
    }
    when (tapAction != null && tapAction!!.busy) {
      ["busy"] = "1"
    }
    // The LOOK is a separate slot from the GUARD (`busy`): the class binding
    // behind it is the whole `fh-disabled`/`fh-loading` visual, and a tap with
    // `busyVisual = false` still swallows re-clicks, just never dims or spins.
    when (tapAction != null && tapAction!!.busy && tapAction!!.busyVisual) {
      ["busyVisual"] = "1"
    }
  }
  // ---- fluent config (builder style) ----
  // Each option is ALSO a method: it amends `this` and returns the same class,
  // so options chain paren-free — `c.entityCard(x).tapAction(c.tap.toggle).label("Office")`
  // — instead of the mandatory-paren amend `(c.entityCard(x)) { ... }`. Methods
  // and properties are separate namespaces, so `function tapAction` coexists with
  // the `hidden tapAction` prop; late binding re-derives `slots` from the amended value, so
  // the emitted node JSON is byte-identical to the amend form (see the
  // builder-vs-amend identity test). `let (self = this)` captures the receiver
  // before the amend body (where a bare `this` would rebind). The param is never
  // named after the property it sets (that would self-reference in the amend).
  function label(l: String|slotMod.Expr): EntityCard = let (self = this) (self) { label = l }
  function value(v: String|slotMod.Expr): EntityCard = let (self = this) (self) { value = v }
  function secondary(s: String|slotMod.Expr): EntityCard = let (self = this) (self) { secondary = s }
  /// Override the resolved icon with an MDI name — `mdi:thermometer`, or the
  /// `mdi-thermometer` class spelling; both work.
  function icon(i: String): EntityCard = let (self = this) (self) { icon = i }
  function tapAction(t: tapMod.TapAction): EntityCard = let (self = this) (self) { tapAction = t }
}

/// A card and its FEATURES — HA's own shape, where a tile carries controls that
/// belong to the entity but are not the tile's own tap (`hui-card-features`).
///
/// A WRAPPER rather than a region on [[EntityCard]], and both halves of that are
/// forced. A card declaring a region is STRUCTURE, and `core/node.pkl` forbids
/// structure from carrying a live BYTE slot — an entity card has several (a
/// query-rendered member's `label`, a `CallByState` tap's `onclick`), so it
/// cannot hold a region and them at once. And a feature must sit OUTSIDE the
/// tappable element: nested inside it, one press on a lock's latch would post
/// `lock/open` and the tile's own `lock/lock` together.
///
/// This card holds no slots at all, so it is structure with nothing live in it,
/// and the tile it wraps is untouched — which is also why a state tick repaints
/// the tile and leaves the features alone.
class CardFeatures extends nodes.Node {
  card = "cardFeatures"
  cardDef = new nodes.CardDef {
    regions = new Mapping {
      ["content"] = new nodes.Region {}
      ["actions"] = new nodes.Region {}
    }
    template = """
      <div class="card fh-features">
        <div class="fh-features-content">{{#content}}{{{html}}}{{/content}}</div>
        <div class="fh-features-actions">{{#actions}}{{{html}}}{{/actions}}</div>
      </div>
      """
    // The wrapper wears the card chrome and the tile inside it sheds it, so the
    // two read as ONE card rather than a card with a second one stacked under
    // it. Nothing here knows the theme: `.card` is what the tile already asked
    // for, this only moves which element gets it.
    //
    // Scoped to the CONTENT, and a descendant selector rather than a child one.
    // Both matter: every node is wrapped in a `.fh-cell` (ADR 0008), so `>`
    // never reaches the tile at all — the first cut of this rule silently
    // matched nothing and the button rendered outside the box. And a feature
    // BUTTON also carries `.card` (that is how `control.pkl` spells a
    // non-round one), so an unscoped rule would strip its paint too.
    css = """
      .fh-features{display:flex;flex-direction:column}
      .fh-features-content .card{background:none;box-shadow:none;border:0;
      padding:0;margin:0}
      .fh-features-actions{display:flex;gap:.5rem;margin-block-start:.75rem}
      .fh-features-actions>*{flex:1 1 0}
      """
  }
  hidden tile: nodes.LayoutNode
  hidden actions: Listing<nodes.LayoutNode> = new {}
  children = new Mapping {
    ["content"] = new Listing { tile }
    ["actions"] = actions
  }
}

/// `c.withFeatures(c.entityCard(e), List(button))` — the tile, then its
/// controls beneath it in the same card box. See [[CardFeatures]].
function withFeatures(
  card: nodes.LayoutNode,
  xs: List<nodes.LayoutNode>
): CardFeatures = new CardFeatures { tile = card; actions = xs.toListing() }

/// Static entity card as a call (amend options in parens).
function entityCard(e: hass.Entity): EntityCard = new EntityCard { entity = e }
/// The SAME constructor as a VALUE, for a query's render positions:
/// `q.from(xs).render(c.entityCard)`. Methods and function-value
/// properties are separate namespaces, so this delegate co-exists with the method
/// above — the parens in `entityCard(e)` pick the method (no recursion). The
/// factory param is `e`, NOT `entity`: a param named after the property it sets
/// self-references inside the amend (the amend-scoping gotcha).
hidden entityCard: (hass.Entity) -> EntityCard = (e) -> entityCard(e)

/// Force the blunt `homeassistant/toggle` on a card: `c.entityCard(x) |>
/// c.tappable`. Rarely what you want now that [[EntityCard.tapAction]] defaults to the
/// domain-derived action — reach for this only when this library's table
/// ([[hass_actions]]) does not know a domain you do.
tappable: Mixin<EntityCard> = new { tapAction = tapMod.toggle }
