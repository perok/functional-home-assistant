/// What a click shows — `c.view`. Unlike `c.tap`, nothing here reaches Home
/// Assistant: a view tap changes only this screen, so its button is never lit
/// by an entity and nothing at HA can refuse it.
///
///     c.entityCard(l).tapAction(c.view.moreInfo(l))
///     c.button("Detail…", c.view.popup("detail", c.title("…")))
///     c.pill(c.view.navigate("under")).label("Underetasje")
///
/// A dashboard-tier module because [[moreInfo]] is a component; the tap kit a
/// component author builds on is `core/tap.pkl`.
module components.view

import "../core/tap.pkl" as core
import "../core/node.pkl" as nodeMod
import "../hass.pkl"
import "moreinfo.pkl" as moreinfo
import "popup.pkl" as popupMod
import "wheel.pkl" as wheelMod

/// Open `e`'s more-info popup: its card, its domain's controls, and every
/// attribute it reports.
function moreInfo(e: hass.Entity): core.SetVar =
  (moreinfo.moreInfo(e)) { icon = "mdi:information-outline"; label = "Details" }

/// Go to dashboard `slug`.
function navigate(slug: String): core.Click = core.navigate(slug)

/// Open the popup `popupId`, holding `body`: `c.view.popup("help", c.title("…"))`,
/// or `new c.Column { … }` for several cards. Any number of taps may open it,
/// each giving the same body; its cards' ids start with `popupId`.
function popup(popupId: String, body: nodeMod.LayoutNode): core.SetVar = popupMod.popup(popupId, body)

/// A colour wheel for the light, in a popup: hue and saturation, where a
/// slider's hue track has full saturation only.
/// `c.button("Colour", c.view.colourWheel(l.colour!!))`; on a light's own slider,
/// `c.its.colourWheel`.
function colourWheel(colour: hass.Colour): core.SetVar =
  (popupMod.popup(popupMod.idFor("wheel", colour.owner), wheelMod.colourWheel(colour.owner))) {
    icon = "mdi:palette-swatch"
    label = "Colour"
  }

/// Close the open popup.
function closePopup(): core.Click = (popupMod.closePopup()) { icon = "mdi:close"; label = "Close" }
