/// What the components start from. A workspace sets its own once, in the
/// `components.pkl` every dashboard file imports as `c`:
///
///     amends "@fh-dashboard/components.pkl"
///
///     defaults {
///       light { opensOn = List("colourTemp", "colour") }
///     }
///
/// One group per card family, each default named after the builder that
/// overrides it on one card: `defaults.light.opensOn` is `.opensOn(…)`'s. A
/// default takes names, not values about one entity, since it applies to
/// every entity.
///
/// A card that reads a default carries the whole object, so it can hand it to
/// what it builds itself; the facade's functions and the recipes hand it over
/// (ADR 0015). Imports nothing from the card modules, which import it.
module components.defaults

import "../hass.pkl"

class Defaults {
  /// A light's slider.
  light: Light = new {}
  /// Which sensors beside a `c.progress` card's own, on its device, play which
  /// part on it.
  progress: ProgressRules = new {}
}

/// One section per role, each a list of names: a name's words must all be
/// among a sensor's `translation_key` and `original_name` words (`_` and `-`
/// count as spaces). Yours add to these; assigning a section replaces it. A
/// name only narrows: a total is still a sensor with a fixed-length time unit,
/// a percent a `%` sensor with no device class, a phase or a status a sensor
/// with no unit. A running total plays no role. One card's exact sensor is its
/// builder's (`.status(…)`), not a rule.
///
///     progress {
///       status { "programme" }
///       ignore { "service" }
///     }
class ProgressRules {
  /// The whole programme's length, for a bar of the countdown out of it.
  total: Listing<String> = new { "duration"; "length" }
  /// How far along, as a percentage.
  percent: Listing<String> = new { "progress" }
  /// What step it is at; shown before [[status]].
  phase: Listing<String> = new { "phase"; "stage" }
  /// What the device is doing.
  status: Listing<String> = new { "status"; "state" }
  /// What plays no part, whatever else names it.
  ignore: Listing<String> = new { "total"; "last"; "lifetime" }
  /// A status in one of these states means it is not running, whatever the
  /// numbers say (a delayed start shows the programme's length as time left).
  /// Words differ between integrations, so none are shipped.
  idleStates: Listing<String> = new {}
}

class Light {
  /// The main controls a light's slider opens on, tried in order as the page
  /// opens: the first the light is in then wins, else brightness. Empty opens
  /// on brightness. `.opensOn(…)` overrides it on one slider.
  opensOn: List<hass.LightControl> = List()
}
