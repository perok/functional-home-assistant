/// The cards built on surfaces: a tab bar over one panel, and a conditional
/// section whose branch live state chooses. Pure composition over
/// `core/surface.pkl`; the backend never reads a card name (ADR 0002/0007).
module components.base.surface

import "../../core/node.pkl" as nodeMod
import "../../core/choice.pkl" as choiceMod
import "../../core/slot.pkl" as slotMod
import "../../core/tap.pkl" as tapMod
import "../../core/variable.pkl" as varMod

/// One tab in an `.fh-tabs` bar, an anchor straight under it: a [[Tabs]]
/// member, or an option of `c.select(v)`. Built by the bar, not by an author.
class TabButton extends nodeMod.Node {
  card = "tab"
  cardDef = new nodeMod.CardDef {
    // An anchor, so a theme can style the bar's `> a`.
    tag = "a"
    layoutCell = false
    attrs = #"data-on:click="\#(tapMod.guardClick)\#(tapMod.click)"\#(tapMod.guard)\#(tapMod.busyVisual.ifSet(" " + tapMod.busyTextClass))"#
    // Not a `core/text.pkl` box: the bar scrolls, so a tab is reached rather
    // than shortened.
    template = "\(labelSlot)"
  }
  hidden label: String
  hidden tapAction: tapMod.SetVar
  slots {
    labelSlot.of(label)
    ...tapMod.tapRoute(tapAction)
    ...tapMod.guardSlots(tapAction)
  }
}

const local labelSlot: slotMod.Slot = slotMod.slot("label")

/// The slot holding the panel the open tab is baked into.
const local panelSlot: slotMod.NodesSlot = slotMod.nodes("panel")

/// The tab choosing `choice` for `v`, lit while `v` holds it: every button bar
/// over a node variable — a [[Tabs]], `c.select(v)`. Lit for the viewer in the
/// first HTML, and live off the variable's own signals, the ask while one is
/// out, so a press lights at once; a patch carrying the class could land after
/// a second press and light two tabs (ADRs 0019, 0025).
const function tabButton(v: varMod.Variable, choice: varMod.Value, text: String): nodeMod.LayoutNode = (new TabButton {
  label = text
  tapAction = v.choose(choice)
}).cellClassWhen("fh-chosen", v.valueIs(choice))

/// A tab bar over one panel. It declares the node variable `tab`, the open
/// tab's index; each tab's cards become a branch of a match over it, baked into
/// the panel and selected by it, and each button writes it (ADR 0033). The server
/// commits `_var_<id>__tab` once the panel is in, the bar's cell mirrors it into
/// the URL as `v.<id>.tab`, and a refresh restores the tab without a flash.
class Tabs extends nodeMod.Node {
  card = "tabs"
  // The bar is structure: it holds the buttons and carries no live value; a
  // selection arrives as a signal frame. A live header goes beside the buttons
  // as a node of its own.
  cardDef = new nodeMod.CardDef {
    classes = "fh-col"
    template = """
      <div class="fh-tabs">\(slotMod.childrenSlot)</div><div id="{{hostId}}" class="fh-tab-panel">\(panelSlot)</div>
      """
    // A patch target that must not be a box, so the tab's own layout reaches
    // the surrounding column.
    css = ".fh-tab-panel{display:contents}"
  }
  layoutClasses { "fh-cols-full" }
  hidden tabCases: Mapping<varMod.Value, Listing<nodeMod.LayoutNode>> =
    new { for (i, l in labels) { [i.toString()] = tabs[l] } }
  slots {
    panelSlot.of(nodeMod.match(tabVar.value, tabCases))
  }
  /// label -> that tab's cards, in bar order. A tab amends into existence:
  ///   (c.tabs) { tabs { ["Lights"] { c.entityCard(e) c.entitySlider(l) } } }
  /// A tab's cards sit in a [[Row]]; nest another container as its one card
  /// for a different layout.
  hidden tabs: Mapping<String, Listing<nodeMod.LayoutNode>> = new { default = (_) -> new Listing {} }
  // A List, because the derivations below need each tab's index.
  hidden labels: List<String> = tabs.keys.toList()
  vars { tabVar.defaultingTo("0") }
  children = new Listing {
    for (i, l in labels) {
      tabButton(tabVar, i.toString(), l)
    }
  }
}

/// `(c.tabs) { tabs { ["Lights"] { ... } } }`.
hidden tabs: Tabs = new Tabs {}

/// The node variable a [[Tabs]] declares and its buttons write. Fixed, as the
/// window chooser's is, so the declaration and its writers cannot drift.
const tabVar: varMod.Variable = new { name = "tab" }

const local branchSlot: slotMod.NodesSlot = slotMod.nodes("branch")

/// A conditional section: `then` while `condition` holds, the optional `else`
/// while it does not, and `elif`s between. The tabs machinery, and the inactive
/// branch is neither rendered nor updated. Over live state the choice is shared
/// by every viewer; over a node variable it is each viewer's own, as a tab
/// bar's is.
///
///   c.iff(q.entity(dump.e_x).stateIs("on"))
///     .then(c.title("on")).`else`(c.title("off"))
///   c.iff(p).then(a).elif(q).then(b).`else`(x)
///   c.iff(window.valueIs("30d")).then(c.title("Month"))
///   (c.iff(p)) { `then` { ...cards... } `else` { ...cards... } }
///
/// The same chain as `nodeMod.iff`, in a node of its own.
class If extends nodeMod.Node {
  card = "ifhost"
  // `fh-ifhost` lets the base stylesheet collapse a cell whose branches all
  // failed.
  cardDef = new nodeMod.CardDef {
    template = #"<div class="fh-ifhost" id="{{hostId}}">\#(branchSlot)</div>"#
  }
  layoutClasses { "fh-cols-full" }
  hidden condition: slotMod.Expr
  hidden `then`: Listing<nodeMod.LayoutNode> = new {}
  hidden elifs: Listing<choiceMod.Elif> = new {}
  hidden `else`: Listing<nodeMod.LayoutNode> = new {}
  hidden chain: choiceMod.Iff =
    let (i = this)
      new choiceMod.Iff { condition = i.condition; `then` = i.`then`; elifs = i.elifs; `else` = i.`else` }
  slots { branchSlot.of(chain) }

  /// Append one node, or `new Listing { ... }` for several, to the branch being
  /// built: `then`, or the last `elif`'s.
  function then(n: choiceMod.Branch): this = let (l = this) let (c = l.chain.then(n))
    (l) { `then` = c.`then`; elifs = c.elifs }
  /// A further branch, taken when none before it holds: `.elif(q).then(b)`.
  function elif(p: choiceMod.Condition): this = let (l = this) let (c = l.chain.elif(p))
    (l) { elifs = c.elifs }
  /// `` .`else`(c.title("off")) ``.
  function `else`(n: choiceMod.Branch): this = let (l = this) let (c = l.chain.`else`(n))
    (l) { `else` = c.`else` }
}

/// `c.iff(p).then(...).`else`(...)`. A condition over state must name the
/// entities it reads (`q.entity(e)`, or an aggregate over `q.from(…)`). A
/// `Boolean` is accepted because the build folds: `q.from(emptyRoom).any()` is
/// already `false`. `v.valueIs(x)` chooses by a node variable instead.
function iff(p: choiceMod.Condition): If =
  new If { condition = choiceMod.conditionOf(p) }
