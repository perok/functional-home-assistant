/// The cards built on surfaces: a tab bar over one panel, and a conditional
/// section whose branch live state chooses. Pure composition over
/// `core/surface.pkl`; the backend never reads a card name (ADR 0002/0007).
module components.base.surface

import "../../core/icon.pkl" as icons
import "../../core/node.pkl" as nodes
import "../../core/surface.pkl" as surfaceMod
import "../../core/predicate.pkl" as pred
import "../../core/tap.pkl" as tapMod
import "../../core/variable.pkl" as varMod
import "../../layout.pkl" as layout

/// One tab in an `.fh-tabs` bar, an anchor straight under it: a [[Tabs]]
/// member, or a window in `c.windowChooser`. Built by the bar, not by an author.
class TabButton extends nodes.Node {
  card = "tab"
  cardDef = new nodes.CardDef {
    template = #"<a data-on:click="\#(tapMod.guardClick){{{onclick}}}"\#(tapMod.guard){{#busyVisual}} \#(tapMod.busyTextClass){{/busyVisual}} data-class:fh-chosen="{{{active}}}">{{label}}</a>"#
    slots { "label"; "onclick"; "active" }
    // Not a `core/text.pkl` box: the bar scrolls, so a tab is reached rather
    // than shortened. Unwrapped, so a theme can style the bar's `> a`.
    wrapAsCell = false
  }
  hidden label: String
  hidden tapAction: tapMod.SetVar
  /// A Datastar boolean expression for `fh-chosen`, the open tab.
  hidden active: String
  slots {
    ["label"] = label
    ["active"] = active
    for (k, v in tapMod.tapSlots(tapAction)) {
      [k] = v
    }
  }
}

/// A tab bar over one panel. It declares the node variable `tab`, the open
/// tab's index; each tab's cards become an inline surface baked into the panel
/// host and selected by it, and each button writes it (ADR 0033). The server
/// commits `_var_<id>__tab` once the panel is in, the panel mirrors it into the
/// URL as `v.<id>.tab`, and a refresh restores the tab without a flash.
class Tabs extends nodes.Node {
  card = "tabs"
  // The pending signal is seeded `__ifmissing` on the BAR, not the panel:
  // `__ifmissing` declines for a signal something already read, and the bar's
  // buttons read it. A parent's seed reaches its children's readers, a later
  // sibling's does not (`DatastarMorphContractSuite`). The committed one is the
  // page shell's, seeded for every declaration.
  //
  // The bar is structure: it holds the buttons and carries no live value; a
  // selection arrives as a signal frame. A live header goes beside the buttons
  // as a node of its own.
  cardDef = new nodes.CardDef {
    regions = new Mapping {
      [nodes.defaultRegion] = new nodes.Region {}
      ["panel"] = new nodes.Region { fill = "baked" }
    }
    template = """
      <div class="fh-col"><div class="fh-tabs" data-signals__ifmissing="{ \(tabVar.own.pendingSeed) }" \(tabVar.own.pendingClear)>{{#children}}{{{html}}}{{/children}}</div><div id="{{hostId}}" class="fh-tab-panel" \(tabVar.own.urlMirror)>{{#panel}}{{{html}}}{{/panel}}</div></div>
      """
    // A patch target that must not be a box, so the tab's own layout reaches
    // the surrounding column.
    css = ".fh-tab-panel{display:contents}"
  }
  cellClasses { "fh-cols-full" }
  /// label -> that tab's cards, in bar order. A tab amends into existence:
  ///   (c.tabs) { tabs { ["Lights"] { c.entityCard(e) c.entitySlider(l) } } }
  /// A tab's cards sit in a [[Row]]; nest another container as its one card
  /// for a different layout.
  hidden tabs: Mapping<String, Listing<nodes.LayoutNode>> = new { default = (_) -> new Listing {} }
  // A List, because the derivations below need each tab's index.
  hidden labels: List<String> = tabs.keys.toList()
  vars = tabVar.declare("0")
  inlineSurfaces = new Mapping {
    for (i, l in labels) {
      ["t\(i)"] = new surfaceMod.SurfaceDef {
        content = new layout.Row { children = tabs[l] }
        bakeInto = nodes.NODE_ID
        bakeAs = "panel"
        bakeIndex = i
        activation = tabVar.selects
      }
    }
  }
  children = new Listing {
    for (i, l in labels) {
      new TabButton {
        label = l
        // Strict, as strings: loose `==` makes `'' == 0` true, so an unseeded
        // selection would highlight tab 0. `Number('')` is 0 too, hence
        // `String(…)`.
        active = "String(\(tabVar.below.chosen)) === '\(i)'"
        tapAction = tabVar.choose(i.toString())
      }
    }
  }
}

/// `(c.tabs) { tabs { ["Lights"] { ... } } }`.
hidden tabs: Tabs = new Tabs {}

/// One panel of a [[Modes]]: its button, and the node it shows.
class Mode {
  /// An MDI name, `mdi:palette`.
  icon: String
  /// The button's accessible name and tooltip.
  label: String
  body: nodes.LayoutNode
}

/// A round button in a [[Modes]] bar. Built by the bar, not by an author.
class ModeButton extends nodes.Node {
  card = "modeButton"
  cardDef = new nodes.CardDef {
    template = #"<button class="fh-circle" title="{{label}}" aria-label="{{label}}" data-on:click="\#(tapMod.guardClick){{{onclick}}}"\#(tapMod.guard) data-class:fh-chosen="{{{active}}}" data-attr:aria-pressed="({{{active}}}) ? 'true' : 'false'"><i class="{{glyph}}"></i></button>"#
    slots { "label"; "glyph"; "onclick"; "active" }
  }
  hidden label: String
  hidden icon: String
  hidden tapAction: tapMod.SetVar
  /// A Datastar boolean expression, as [[TabButton.active]].
  hidden active: String
  slots {
    ["label"] = label
    ["glyph"] = "mdi " + icons.mdiClass(icon)
    ["active"] = active
    for (k, v in tapMod.tapSlots(tapAction)) {
      [k] = v
    }
  }
}

/// One control at a time, with a round button per mode beside it, as HA's
/// light dialog and Mushroom's light card switch brightness, colour
/// temperature and colour. The [[Tabs]] machinery with icons for labels: it
/// declares the node variable `mode`, the open panel's index, so the choice is
/// per viewer, survives a refresh through the URL, and a panel not shown is
/// neither rendered nor kept live. One mode renders no buttons.
///
///   (c.modes) { modes { new c.Mode { icon = "mdi:blinds"; label = "Position"; body = c.entitySlider(cover) } } }
open class Modes extends nodes.Node {
  card = "modes"
  // The pending seed sits on the wrapper, the parent of both the panel and the
  // buttons that read it — the placement [[Tabs]] explains.
  cardDef = new nodes.CardDef {
    regions = new Mapping {
      [nodes.defaultRegion] = new nodes.Region {}
      ["panel"] = new nodes.Region { fill = "baked" }
    }
    template = """
      <div class="fh-modes" data-signals__ifmissing="{ \(modeVar.own.pendingSeed) }" \(modeVar.own.pendingClear)><div id="{{hostId}}" class="fh-modes-panel" \(modeVar.own.urlMirror)>{{#panel}}{{{html}}}{{/panel}}</div><div class="fh-modes-bar">{{#children}}{{{html}}}{{/children}}</div></div>
      """
    css = modesCss
  }
  hidden modes: Listing<Mode> = new {}
  vars = modeVar.declare("0")
  inlineSurfaces = new Mapping {
    for (i, m in modes) {
      ["m\(i)"] = new surfaceMod.SurfaceDef {
        content = m.body
        bakeInto = nodes.NODE_ID
        bakeAs = "panel"
        bakeIndex = i
        activation = modeVar.selects
      }
    }
  }
  children = new Listing {
    when (modes.length > 1) {
      for (i, m in modes) {
        new ModeButton {
          label = m.label
          icon = m.icon
          // Strict, as [[Tabs]]' buttons, so an unseeded choice lights none.
          active = "String(\(modeVar.below.chosen)) === '\(i)'"
          // A switch answers too fast for a spinner to mean anything.
          tapAction = (modeVar.choose(i.toString())) { busyVisual = false }
        }
      }
    }
  }
}

/// `(c.modes) { modes { … } }`.
hidden modes: Modes = new Modes {}

/// The node variable a [[Modes]] declares and its buttons write.
const modeVar: varMod.Variable = new { name = "mode" }

// The bar wraps under the control where the cell is too narrow for both. The
// cell variables are reset, or the panel's cell inherits a grid's third (#546).
const local modesCss: String = """
  .fh-modes{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem;--fh-cell-flex:0 0 auto;--fh-cell-width:auto}
  .fh-modes-panel{display:flex;flex:1 1 12rem;min-inline-size:0}
  .fh-modes-panel>.fh-cell{flex:1 1 auto}
  .fh-modes-bar{display:flex;gap:.25rem}
  .fh-modes-bar>.fh-cell>button{background:var(--fh-surface-alt);color:var(--fh-text)}
  .fh-modes-bar>.fh-cell>button.fh-chosen{background:var(--fh-accent);color:var(--fh-on-accent)}
  """

/// The node variable a [[Tabs]] declares and its buttons write. Fixed, as the
/// window chooser's is, so the declaration and its writers cannot drift.
const tabVar: varMod.Variable = new { name = "tab" }

const local function stateActivation(p: pred.Predicate): surfaceMod.StateActivation =
  new { condition = p }

/// A conditional section: `then` while `condition` holds over live state, the
/// optional `else` while it does not. The tabs machinery with a condition in
/// place of the viewer's selection, so the choice is shared by every viewer and
/// the inactive branch is neither rendered nor updated.
///
///   c.iff(q.entity(dump.e_x).stateIs("on"))
///     .then(c.title("on")).`else`(c.title("off"))
///   (c.iff(p)) { `then` { ...cards... } `else` { ...cards... } }
///
/// An If inside `else` is else-if.
class If extends nodes.Node {
  card = "ifhost"
  // `fh-ifhost` lets the base stylesheet collapse a cell whose branches all
  // failed.
  cardDef = new nodes.CardDef {
    regions = new Mapping { ["branch"] = new nodes.Region { fill = "baked" } }
    template = #"<div class="fh-ifhost" id="{{hostId}}">{{#branch}}{{{html}}}{{/branch}}</div>"#
  }
  cellClasses { "fh-cols-full" }
  hidden condition: pred.Predicate
  hidden `then`: Listing<nodes.LayoutNode> = new {}
  hidden `else`: Listing<nodes.LayoutNode> = new {}
  // First match in `bakeIndex` order; `else` is the always-true member 1. Both
  // share one `bakeAs`, since the backend reads it off a group's first member.
  inlineSurfaces = new Mapping {
    ["then"] = new surfaceMod.SurfaceDef {
      content = new layout.Row { children = `then` }
      bakeInto = nodes.NODE_ID
      bakeAs = "branch"
      bakeIndex = 0
      activation = stateActivation(condition)
    }
    when (!`else`.isEmpty) {
      ["else"] = new surfaceMod.SurfaceDef {
        content = new layout.Row { children = `else` }
        bakeInto = nodes.NODE_ID
        bakeAs = "branch"
        bakeIndex = 1
        activation = stateActivation(pred.alwaysHolds)
      }
    }
  }
  /// Append one node, or `new Listing { ... }` for several, to `then`.
  function then(n: nodes.LayoutNode|Listing<nodes.LayoutNode>): If = let (l = this)
    if (n is Listing) (l) { `then` { ...n } } else (l) { `then` { n } }
  /// `` .`else`(c.title("off")) ``.
  function `else`(n: nodes.LayoutNode|Listing<nodes.LayoutNode>): If = let (l = this)
    if (n is Listing) (l) { `else` { ...n } } else (l) { `else` { n } }
}

/// `c.iff(p).then(...).`else`(...)`. `p` must name the entities it reads
/// (`q.entity(e)`, or an aggregate over `q.from(…)`). A `Boolean` is accepted
/// because the build folds: `q.from(emptyRoom).any()` is already `false`.
function iff(p: pred.Predicate|Boolean): If =
  new If {
    condition =
      if (p is Boolean) (if (p) pred.alwaysHolds else pred.neverHolds)
      else p
  }
