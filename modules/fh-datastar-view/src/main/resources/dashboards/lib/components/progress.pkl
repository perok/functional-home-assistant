/// An appliance mid-cycle: the entity tile of its remaining-time sensor, a
/// countdown for its reading, what it is doing on the second line, and a bar
/// under it when the appliance says enough for one to be honest.
///
/// HA models an appliance as a few `sensor` entities, so this takes the two or
/// three that matter. The bar is optional because the data is: one washer
/// reports a remaining time and no programme length, and a total guessed from
/// history would be wrong on exactly the first paint after a reload.
module components.progress

import "../core/simple.pkl" as simpleMod
import "../core/slot.pkl" as slotMod
import "../core/tap.pkl" as tapMod
import "../hass.pkl"
import "bar.pkl" as barMod
import "entity.pkl" as entityMod

/// The remaining-time sensor's tile. A sensor, for its
/// [[hass.SensorEntity.durationSeconds]].
class ProgressCard extends entityMod.EntityCard {
  hidden entity: hass.SensorEntity

  /// The programme-length sensor, where the appliance reports one.
  hidden total: hass.SensorEntity? = null

  /// What the appliance is doing, shown as its own words and never
  /// interpreted: which state means "running" is the integration's.
  hidden status: hass.SensorEntity? = null

  /// Null where the reading is not a scalable duration, so the countdown drops
  /// out rather than show a guess.
  hidden scale: Number? = entity.durationSeconds

  reading =
    if (value != null) slotMod.valueSlot(value)
    else if (scale != null) new slotMod.Slot { transform = simpleMod.duration(scale!!) }
    else ""
  secondary =
    if (status != null) new slotMod.Slot { entityId = status!!.entity_id; transform = simpleMod.state() }
    else null
  features =
    if (total != null && barMod.canCount(entity, total!!)) new Listing { barMod.remaining(entity, total!!) }
    else new Listing {}

  function total(t: hass.SensorEntity): ProgressCard = let (self = this) (self) { total = t }
  function status(s: hass.SensorEntity): ProgressCard = let (self = this) (self) { status = s }
  function label(l: String|slotMod.Expr): ProgressCard = let (self = this) (self) { label = l }
  function icon(i: String): ProgressCard = let (self = this) (self) { icon = i }
  function tapAction(t: tapMod.TapAction): ProgressCard = let (self = this) (self) { tapAction = t }
}

///     c.progress(dump.entities.sensor_washer_timetoend)
///       .status(dump.entities.sensor_washer_appliancestate)
///       .label("Vaskemaskin")
function progress(remaining: hass.SensorEntity): ProgressCard =
  new { entity = remaining }
