/// A choice of one value from a set, in a style picked per use. The target is
/// what the choice is FOR, and it decides what a press does, what reads as
/// chosen, and where the options come from:
///
///     c.select(shade).options(List("pale", "deep")).style("dropdown")  // a node variable
///     c.select(dump.entities.robot_mode)                               // a select entity's options
///     c.select(lamp.effects!!).style("cycle")                          // a light's effects
///     c.select(shade).options(List("1h", "24h", "7d")).style("radial") // a ring, by a hold and a drag
///
/// A node variable is only chosen, never declared: whatever holds its readers
/// declares it, and the build refuses a select with no declarer above it (ADR
/// 0033). Each option is a node of its own, so a press dims only the option
/// pressed (ADR 0019).
///
/// Over a variable, the cycle and the dropdown's label are bake groups selected
/// by its value, so the first HTML shows the chosen option; the buttons are lit
/// by the client, as a tab bar's are. The server refuses a choice nothing on the
/// page reads, so `buttons` over a variable needs a reader: a chart's
/// `.over(v.ref)`, a bake group.
module components.select

import "../core/icon.pkl" as icons
import "../core/node.pkl" as nodes
import "../core/slot.pkl" as slotMod
import "../core/surface.pkl" as surfaceMod
import "../core/tap.pkl" as tapMod
import "../core/variable.pkl" as varMod
import "../hass.pkl"
import "base/surface.pkl" as surfaces

typealias SelectStyle = "buttons"|"dropdown"|"cycle"|"radial"

/// What a select chooses for.
typealias Target = varMod.Variable|hass.SelectEntity|hass.Effects

/// One option. A node variable's value travels in a route segment, so there it
/// must be a [[varMod.Value]]; an entity's travels in a JSON body.
class Choice {
  value: String
  label: String = value
  /// An MDI name, `mdi:palette`.
  icon: String? = null
}

/// A choice from a bare value, labelled by itself.
const function choiceOf(v: String|Choice): Choice =
  if (v is Choice) v else new Choice { value = v }

// Inside a JS or CEL string literal, inside a double-quoted attribute that
// Mustache's `{{…}}` HTML-escapes.
const local function quoted(s: String): String =
  "'" + s.replaceAll("\\", "\\\\").replaceAll("'", "\\'") + "'"

const local function targetName(t: Target): String =
  if (t is varMod.Variable) t.name
  else if (t is hass.Effects) t.owner.entity_id + " effects"
  else (t as hass.SelectEntity).entity_id

/// What the target itself offers: an entity's own list, none for a variable.
const local function offered(t: Target): List<String> =
  if (t is hass.SelectEntity) t.options.toList()
  else if (t is hass.Effects) t.list.toList()
  else List()

/// `{'v': 'label', …}`, a JS or CEL map literal.
const local function labelMap(cs: List<Choice>): String =
  "{" + cs.map((ch) -> "\(quoted(ch.value)): \(quoted(ch.label))").join(", ") + "}"

/// Whether `v` is the entity's current value, as CEL over its state.
const local function entityChosen(t: hass.SelectEntity|hass.Effects, v: String): slotMod.Expr =
  if (t is hass.Effects)
    slotMod.exprOf(t.owner, "attr[?'effect'].orValue('') == \(quoted(v))")
  else slotMod.exprOf(t as hass.SelectEntity, "state == \(quoted(v))")

const local function entityCall(t: hass.SelectEntity|hass.Effects, v: String): tapMod.Call =
  if (t is hass.Effects) tapMod.call("light/turn_on", t.owner).with("effect", v)
  else tapMod.call("select/select_option", t as hass.SelectEntity).with("option", v)

// Each option is a node, so the card is structure: a patch of the select never
// re-sends them.
const local optionsRegion: Mapping<String, nodes.Region> =
  new { [nodes.defaultRegion] = new nodes.Region {} }

const local panelRegion: Mapping<String, nodes.Region> =
  new { ["panel"] = new nodes.Region { fill = "baked" } }

// One member per option, shown while `v` is at its value: the server renders the
// chosen one, as a slider's mode panels.
const local function panelsOf(v: varMod.Variable, nodesFor: List<nodes.LayoutNode>, cs: List<Choice>): Mapping<String, surfaceMod.SurfaceDef> =
  new Mapping {
    for (i, ch in cs) {
      ["o\(i)"] = new surfaceMod.SurfaceDef {
        content = nodesFor[i]
        bakeInto = nodes.NODE_ID
        bakeAs = "panel"
        bakeIndex = i
        activation = v.selecting(ch.value)
      }
    }
  }

abstract class Select extends nodes.Node {
  hidden target: Target
  hidden choices: List<Choice> = offered(target).map((v) -> choiceOf(v))
  /// Whether a press chooses the NEXT option rather than its own.
  hidden cycling: Boolean = false

  /// These options, in this order. On an entity, a subset of what it offers,
  /// relabelled or with icons; a value it does not offer names itself.
  function options(os: List<String|Choice>): Select =
    let (self = this) let (cs = os.map((o) -> choiceOf(o))) let (have = offered(self.target))
      let (stray = if (self.target is varMod.Variable) List() else cs.filter((ch) -> !have.contains(ch.value)))
        if (!stray.isEmpty)
          throw("c.select(\(targetName(self.target))) offers no \(stray.map((ch) -> ch.value).join(", ")): it has \(have.join(", ")).")
        else (self) { choices = cs }

  /// The same choice in another style.
  function style(s: SelectStyle): Select =
    let (t = target) let (cs = choices)
      if (s == "buttons") new SelectButtons { target = t; choices = cs }
      else if (s == "dropdown")
        if (t is varMod.Variable) new VarSelectDropdown { target = t; choices = cs }
        else new SelectDropdown { target = t; choices = cs }
      else if (s == "radial")
        if (t is varMod.Variable) new VarSelectRadial { target = t; choices = cs }
        else new SelectRadial { target = t; choices = cs }
      else if (t is varMod.Variable) new VarSelectCycle { target = t; choices = cs }
      else new SelectCycle { target = t; choices = cs }

  /// One option's node: choosing `pick` on a press, lit while `ch` is chosen.
  function optionNode(ch: Choice, pick: Choice): nodes.LayoutNode =
    let (t = target) let (cyc = cycling)
      if (t is varMod.Variable)
        let (lit = "\(t.below.chosen) === \(quoted(ch.value))")
          if (cyc)
            new CycleButton {
              label = ch.label
              icon = ch.icon
              tapAction = t.choose(pick.value)
            }
          else
            new surfaces.TabButton {
              label = ch.label
              active = lit
              tapAction = t.choose(pick.value)
            }
      else
        new EntityOption {
          label = ch.label
          icon = ch.icon
          active = entityChosen(t, ch.value)
          tapAction = entityCall(t, pick.value)
        }

  /// Each option's node, in order.
  hidden optionNodes: List<nodes.LayoutNode> =
    let (self = this) let (cs = choices)
      if (cs.isEmpty)
        throw("c.select(\(targetName(target))) has no options\(if (target is varMod.Variable) ": give them with .options(…)" else "").")
      else cs.mapIndexed((i, ch) -> self.optionNode(ch, if (self.cycling) cs[(i + 1) % cs.length] else ch))

  children = optionNodes.toListing()
}

/// One button per option, the chosen one lit: a window chooser's bar.
class SelectButtons extends Select {
  card = "selectButtons"
  cardDef = new nodes.CardDef {
    regions = optionsRegion
    template = #"<div class="fh-tabs fh-select">{{#children}}{{{html}}}{{/children}}</div>"#
    css = """
      .fh-select>.fh-cell{display:contents}
      """
  }
}

/// The chosen option's label, live from the entity's state.
const local function chosenLabel(t: hass.SelectEntity|hass.Effects, cs: List<Choice>): slotMod.Slot =
  let (labels = labelMap(cs))
    new slotMod.Slot {
      entityId = if (t is hass.Effects) t.owner.entity_id else (t as hass.SelectEntity).entity_id
      transform =
        if (t is hass.Effects) "\(labels)[?attr[?'effect'].orValue('')].orValue('')"
        else "\(labels)[?state].orValue(state)"
      signal = slotMod.asText
      bypassUnavailable = false
    }

// The menu's markup around its label; the label differs by target.
const local function menuTemplate(chosen: String): String =
  #"<details class="fh-select-menu" data-on:click__outside="el.open = false"><summary class="fh-select-summary">"# +
    chosen +
    #"<i class="mdi mdi-chevron-down"></i></summary><div class="fh-select-list" data-on:click="el.closest('details').open = false">{{#children}}{{{html}}}{{/children}}</div></details>"#

const local menuCss: String = """
  .fh-select-menu{position:relative;display:inline-block}
  .fh-select-summary{display:inline-flex;align-items:center;gap:.25rem;list-style:none;cursor:pointer;
  min-block-size:2.5rem;padding-inline:1rem;border-radius:1.25rem;background:var(--fh-surface-alt);color:var(--fh-text)}
  .fh-select-summary::-webkit-details-marker{display:none}
  .fh-select-summary .fh-cell{display:contents}
  .fh-select-list{position:absolute;inset-block-start:calc(100% + .25rem);inset-inline-start:0;z-index:10;
  display:flex;flex-direction:column;min-inline-size:100%;padding-block:.25rem;border-radius:.75rem;
  background:var(--fh-surface);box-shadow:0 .25rem 1rem rgba(0,0,0,.25)}
  .fh-select-list .fh-cell{display:contents}
  .fh-select-list a{display:block;padding:.5rem 1rem;white-space:nowrap;cursor:pointer;color:var(--fh-text)}
  .fh-select-list :is(a.fh-chosen,.fh-active>a){font-weight:600;background:var(--fh-surface-alt)}
  """

const local cycleCss: String = """
  .fh-select-cycles{display:inline-flex}
  .fh-select-lit>.fh-cell:not(.fh-active){display:none}
  .fh-select-cycles :is(.fh-select-cycle,.fh-select-opt){display:inline-flex;align-items:center;
  min-block-size:2.5rem;padding-inline:1rem;border-radius:1.25rem;background:var(--fh-surface-alt);color:var(--fh-text)}
  """

/// The chosen option, opening a list of all of them. A `<details>`, so it
/// opens with no script, and on iPadOS 15, which has no `popover`. A choice
/// closes it, and so does a tap outside. Over an entity, the label is a live
/// slot; [[VarSelectDropdown]] is a variable's.
class SelectDropdown extends Select {
  card = "selectDropdown"
  cardDef = new nodes.CardDef {
    regions = optionsRegion
    template = menuTemplate(#"<span \#(slotMod.signalBind("chosen"))>{{chosen}}</span>"#)
    slots { "chosen" }
    css = menuCss
  }
  // A class-level property: a nested body cannot see `target`, which `Select`
  // declares.
  hidden chosen: slotMod.Slot = chosenLabel(target as hass.SelectEntity|hass.Effects, choices)
  slots { ["chosen"] = chosen }
}

/// [[SelectDropdown]] over a node variable: its label is one member per option,
/// baked by the variable's value.
class VarSelectDropdown extends Select {
  card = "selectVarDropdown"
  cardDef = new nodes.CardDef {
    regions = (optionsRegion) { ...panelRegion }
    template = menuTemplate(#"<span id="{{hostId}}">{{#panel}}{{{html}}}{{/panel}}</span>"#)
    css = menuCss
  }
  inlineSurfaces =
    let (cs = choices)
      panelsOf(target as varMod.Variable, cs.map((ch) -> new ChoiceLabel { label = ch.label; icon = ch.icon }), cs)
}

/// One button showing the chosen option; a press chooses the next, round. Over
/// an entity every option is rendered and the server lights the chosen one;
/// [[VarSelectCycle]] is a variable's.
class SelectCycle extends Select {
  card = "selectCycle"
  cardDef = new nodes.CardDef {
    regions = optionsRegion
    template = #"<div class="fh-select-cycles fh-select-lit">{{#children}}{{{html}}}{{/children}}</div>"#
    css = cycleCss
  }
  cycling = true
}

/// [[SelectCycle]] over a node variable: one member per option, baked by the
/// variable's value, so only the chosen option's button is sent.
class VarSelectCycle extends Select {
  card = "selectVarCycle"
  cardDef = new nodes.CardDef {
    regions = panelRegion
    template = #"<div id="{{hostId}}" class="fh-select-cycles">{{#panel}}{{{html}}}{{/panel}}</div>"#
    css = cycleCss
  }
  cycling = true
  children = new Listing {}
  inlineSurfaces = panelsOf(target as varMod.Variable, optionNodes, choices)
}

// ---- radial ----
//
// Press and hold the face, and the options ring it; drag to one and release to
// choose it. A quick tap opens the ring for tapping instead. The ring is placed
// by CSS from each option's position, so the server sends nothing per angle;
// the script only reads the pointer. A choice clicks the option's own button,
// so it is that option's tap, guard and busy look.

const local ringMax: Int = 12

const local ringScript: String = """
  window.fhRing=function(e,el,n){var r=el.getBoundingClientRect(),x=e.clientX-r.left-r.width/2,y=e.clientY-r.top-r.height/2;if(Math.hypot(x,y)<r.width/2+8)return -1;return Math.round(((Math.atan2(x,-y)*180/Math.PI+360)%360)/(360/n))%n};
  window.fhRingChoose=function(el,i){var c=el.parentElement.querySelector('.fh-radial-ring').children[i];if(c)(c.matches('a,button')?c:c.querySelector('a,button')).click()}
  """

// A ring's signals are this node's own and client-only.
const local function ringSig(name: String): String = "$_{{id}}__" + name

const local function radialTemplate(face: String): String =
  #"<div class="fh-radial" data-signals__ifmissing="{ _{{id}}__ring: false, _{{id}}__pick: -1, _{{id}}__was: false, _{{id}}__hold: 0 }" data-class:fh-open="\#(ringSig("ring"))" data-on:click__outside="\#(ringSig("ring")) = false">"# +
    #"<button type="button" class="fh-radial-face" "# +
    #"data-on:pointerdown="el.setPointerCapture(evt.pointerId); \#(ringSig("was")) = \#(ringSig("ring")); \#(ringSig("pick")) = -1; \#(ringSig("hold")) = setTimeout(() => \#(ringSig("ring")) = true, 250)" "# +
    #"data-on:pointermove="\#(ringSig("ring")) && (\#(ringSig("pick")) = fhRing(evt, el, {{count}}))" "# +
    #"data-on:pointerup="clearTimeout(\#(ringSig("hold"))); \#(ringSig("pick")) >= 0 ? (fhRingChoose(el, \#(ringSig("pick"))), \#(ringSig("ring")) = false, \#(ringSig("pick")) = -1) : (\#(ringSig("ring")) = !\#(ringSig("was")))" "# +
    #"data-on:pointercancel="clearTimeout(\#(ringSig("hold"))); \#(ringSig("ring")) = false; \#(ringSig("pick")) = -1">"# +
    face +
    #"</button><div class="fh-radial-ring" style="--fh-n:{{count}}" data-attr:data-pick="\#(ringSig("pick"))" data-on:click="\#(ringSig("ring")) = false">{{#children}}{{{html}}}{{/children}}</div></div>"#

const local ringCss: String = """
  .fh-radial{position:relative;display:inline-block}
  .fh-radial-face{display:inline-flex;align-items:center;gap:.25rem;touch-action:none;user-select:none;
  min-block-size:2.5rem;padding-inline:1rem;border-radius:1.25rem;background:var(--fh-surface-alt);color:var(--fh-text)}
  .fh-radial-face .fh-cell{display:contents}
  .fh-radial-ring{--fh-ring-r:5rem;position:absolute;left:50%;top:50%;inline-size:0;block-size:0;z-index:20;display:none}
  .fh-radial.fh-open .fh-radial-ring{display:block}
  .fh-radial-ring>*{position:absolute;left:0;top:0;white-space:nowrap;
  transform:translate(-50%,-50%) rotate(calc(var(--fh-i) * 360deg / var(--fh-n))) translateY(calc(-1 * var(--fh-ring-r))) rotate(calc(var(--fh-i) * -360deg / var(--fh-n)));
  padding:.5rem .75rem;border-radius:999px;background:var(--fh-surface);color:var(--fh-text);box-shadow:0 .125rem .5rem rgba(0,0,0,.3)}
  .fh-radial-ring a{color:inherit;cursor:pointer}
  .fh-radial-ring>:is(a.fh-chosen,.fh-active){font-weight:600}
  """ + IntSeq(1, ringMax).map((k) -> ".fh-radial-ring>:nth-child(\(k)){--fh-i:\(k - 1)}").join("")
    + IntSeq(1, ringMax).map((k) -> #".fh-radial-ring[data-pick="\#(k - 1)"]>:nth-child(\#(k)){background:var(--fh-accent);color:var(--fh-on-accent)}"#).join("")

/// A ring of options round its face, chosen by a hold and a drag: a phone's
/// select. Over an entity the face is the live state's label;
/// [[VarSelectRadial]] is a variable's.
class SelectRadial extends Select {
  card = "selectRadial"
  cardDef = new nodes.CardDef {
    regions = optionsRegion
    template = radialTemplate(#"<span \#(slotMod.signalBind("chosen"))>{{chosen}}</span>"#)
    slots { "chosen"; "count" }
    css = ringCss
    script = ringScript
  }
  hidden chosen: slotMod.Slot = chosenLabel(target as hass.SelectEntity|hass.Effects, choices)
  hidden count: String = ringCount(choices)
  slots {
    ["chosen"] = chosen
    ["count"] = count
  }
}

/// [[SelectRadial]] over a node variable: its face is one member per option,
/// baked by the variable's value.
class VarSelectRadial extends Select {
  card = "selectVarRadial"
  cardDef = new nodes.CardDef {
    regions = (optionsRegion) { ...panelRegion }
    template = radialTemplate(#"<span id="{{hostId}}">{{#panel}}{{{html}}}{{/panel}}</span>"#)
    slots { "count" }
    css = ringCss
    script = ringScript
  }
  inlineSurfaces =
    let (cs = choices)
      panelsOf(target as varMod.Variable, cs.map((ch) -> new ChoiceLabel { label = ch.label }), cs)
  hidden count: String = ringCount(choices)
  slots { ["count"] = count }
}

const local function ringCount(cs: List<Choice>): String =
  if (cs.length > ringMax)
    throw("c.select(…).style(\"radial\") rings up to \(ringMax) options; this has \(cs.length). A dropdown holds more.")
  else cs.length.toString()

/// The label a [[VarSelectDropdown]] shows for one option.
/// An icon replaces the label, as on a cycle's face, so a dropdown fits a
/// slider's pill; the list still names every option.
class ChoiceLabel extends nodes.Node {
  card = "selectChoice"
  cardDef = new nodes.CardDef {
    template = #"{{#glyph}}<i class="{{glyph}}" title="{{label}}"></i>{{/glyph}}{{^glyph}}<span>{{label}}</span>{{/glyph}}"#
    slots { "label" }
  }
  hidden label: String
  hidden icon: String? = null
  slots {
    ["label"] = label
    when (icon != null) {
      ["glyph"] = "mdi " + icons.mdiClass(icon!!)
    }
  }
}

/// The button a [[VarSelectCycle]] shows for one option; a press chooses the
/// next.
class CycleButton extends nodes.Node {
  card = "selectCycleButton"
  cardDef = new nodes.CardDef {
    template = #"<button class="fh-select-cycle" title="{{label}}" data-on:click="\#(tapMod.guardClick){{{onclick}}}"\#(tapMod.guard)>{{#glyph}}<i class="{{glyph}}"></i>{{/glyph}}{{^glyph}}{{label}}{{/glyph}}</button>"#
    slots { "label"; "onclick" }
  }
  hidden label: String
  hidden icon: String? = null
  hidden tapAction: tapMod.SetVar
  slots {
    ["label"] = label
    when (icon != null) {
      ["glyph"] = "mdi " + icons.mdiClass(icon!!)
    }
    for (k, v in tapMod.tapSlots(tapAction)) {
      [k] = v
    }
  }
}

/// One option of a select over an entity: `fh-active` on its cell while the
/// entity holds this value, decided by the server, so the first HTML is right.
class EntityOption extends nodes.ActiveNode {
  card = "selectEntityOption"
  cardDef = new nodes.CardDef {
    template = #"<a class="fh-select-opt" title="{{label}}" data-on:click="\#(tapMod.guardClick)\#(tapMod.click)"\#(tapMod.refusedAttr)\#(tapMod.guard)>{{#glyph}}<i class="{{glyph}}"></i>{{/glyph}}{{^glyph}}{{label}}{{/glyph}}</a>"#
    slots { "label" }
    css = """
      .fh-select .fh-active>.fh-select-opt{font-weight:600}
      """
  }
  hidden label: String
  hidden icon: String? = null
  hidden tapAction: tapMod.Call
  slots {
    ["label"] = label
    when (icon != null) {
      ["glyph"] = "mdi " + icons.mdiClass(icon!!)
    }
    for (k, v in tapMod.tapSlots(tapAction)) {
      [k] = v
    }
  }
}

/// `c.select(target)`: buttons until `.style(…)` says otherwise.
function select(t: Target): Select = new SelectButtons { target = t }
