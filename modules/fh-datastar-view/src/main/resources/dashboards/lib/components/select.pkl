/// A choice of one value from a set, in a style picked per use:
///
///     (c.column) {
///       vars = shade.declare("pale")
///       children {
///         c.select(shade, List("pale", "deep")).style("dropdown")
///         …readers of shade…
///       }
///     }
///
/// A select only chooses: whatever holds the readers declares the variable,
/// and the build refuses a select with no declarer above it (ADR 0033). Each
/// option is a node of its own, so a press dims only the option pressed while
/// the readers re-render (ADR 0019).
module components.select

import "../core/icon.pkl" as icons
import "../core/node.pkl" as nodes
import "../core/tap.pkl" as tapMod
import "../core/variable.pkl" as varMod
import "base/surface.pkl" as surfaces

typealias SelectStyle = "buttons"|"dropdown"|"cycle"

/// One option. The value travels in a route segment, hence a [[varMod.Value]].
class Choice {
  value: varMod.Value
  label: String = value
  /// An MDI name, `mdi:palette`.
  icon: String? = null
}

/// A choice from a bare value, labelled by itself.
const function choiceOf(v: varMod.Value|Choice): Choice =
  if (v is Choice) v else new Choice { value = v }

// Inside a JS string literal, inside a double-quoted attribute that Mustache's
// `{{…}}` HTML-escapes.
const local function jsString(s: String): String =
  "'" + s.replaceAll("\\", "\\\\").replaceAll("'", "\\'") + "'"

// Each option is a node, so the card is structure: a patch of the select never
// re-sends them.
const local optionsRegion: Mapping<String, nodes.Region> =
  new { [nodes.defaultRegion] = new nodes.Region {} }

abstract class Select extends nodes.Node {
  hidden variable: varMod.Variable
  hidden choices: List<Choice>
  /// Whether `v` is the one shown: the ask while one is out, else the commit.
  function isChosen(v: varMod.Value): String = "\(variable.below.chosen) === \(jsString(v))"
  /// The chosen option's label, as a JS expression.
  hidden chosenLabel: String =
    "({" + choices.map((ch) -> "\(jsString(ch.value)): \(jsString(ch.label))").join(", ") +
      "})[\(variable.below.chosen)] ?? ''"

  /// The same choice in another style.
  function style(s: SelectStyle): Select =
    let (v = variable) let (cs = choices)
      if (s == "buttons") new SelectButtons { variable = v; choices = cs }
      else if (s == "dropdown") new SelectDropdown { variable = v; choices = cs }
      else new SelectCycle { variable = v; choices = cs }
}

/// One button per option, the chosen one lit: a window chooser's bar.
class SelectButtons extends Select {
  card = "selectButtons"
  cardDef = new nodes.CardDef {
    regions = optionsRegion
    template = #"<div class="fh-tabs fh-select">{{#children}}{{{html}}}{{/children}}</div>"#
  }
  children = let (self = this) new Listing {
    for (ch in self.choices) {
      new surfaces.TabButton {
        label = ch.label
        active = self.isChosen(ch.value)
        tapAction = self.variable.choose(ch.value)
      }
    }
  }
}

/// The chosen option, opening a list of all of them. A `<details>`, so it
/// opens with no script, and on iPadOS 15, which has no `popover`. A choice
/// closes it, and so does a tap outside.
class SelectDropdown extends Select {
  card = "selectDropdown"
  cardDef = new nodes.CardDef {
    regions = optionsRegion
    template = #"<details class="fh-select-menu" data-on:click__outside="el.open = false"><summary class="fh-select-summary"><span data-text="{{chosen}}"></span><i class="mdi mdi-chevron-down"></i></summary><div class="fh-select-list" data-on:click="el.closest('details').open = false">{{#children}}{{{html}}}{{/children}}</div></details>"#
    slots { "chosen" }
    css = """
      .fh-select-menu{position:relative;display:inline-block}
      .fh-select-summary{display:inline-flex;align-items:center;gap:.25rem;list-style:none;cursor:pointer;
      min-block-size:2.5rem;padding-inline:1rem;border-radius:1.25rem;background:var(--fh-surface-alt);color:var(--fh-text)}
      .fh-select-summary::-webkit-details-marker{display:none}
      .fh-select-list{position:absolute;inset-block-start:calc(100% + .25rem);inset-inline-start:0;z-index:10;
      display:flex;flex-direction:column;min-inline-size:100%;padding-block:.25rem;border-radius:.75rem;
      background:var(--fh-surface);box-shadow:0 .25rem 1rem rgba(0,0,0,.25)}
      .fh-select-list>a{display:block;padding:.5rem 1rem;white-space:nowrap;cursor:pointer;color:var(--fh-text)}
      .fh-select-list>a.fh-chosen{font-weight:600;background:var(--fh-surface-alt)}
      """
  }
  slots = let (shown = chosenLabel) new Mapping { ["chosen"] = shown }
  children = let (self = this) new Listing {
    for (ch in self.choices) {
      new surfaces.TabButton {
        label = ch.label
        active = self.isChosen(ch.value)
        tapAction = self.variable.choose(ch.value)
      }
    }
  }
}

/// One option's button in a [[SelectCycle]]: shown while its option is
/// chosen, and a press chooses the next.
class CycleButton extends nodes.Node {
  card = "selectCycleButton"
  cardDef = new nodes.CardDef {
    // Hidden until Datastar shows the chosen one: no button can be right
    // before the committed value is read.
    template = #"<button class="fh-select-cycle" style="display:none" data-show="{{shown}}" title="{{label}}" data-on:click="\#(tapMod.guardClick){{{onclick}}}"\#(tapMod.guard)>{{#glyph}}<i class="{{glyph}}"></i>{{/glyph}}{{^glyph}}{{label}}{{/glyph}}</button>"#
    slots { "label"; "onclick"; "shown" }
    wrapAsCell = false
  }
  hidden label: String
  hidden icon: String? = null
  hidden shown: String
  hidden tapAction: tapMod.SetVar
  slots {
    ["label"] = label
    ["shown"] = shown
    when (icon != null) {
      ["glyph"] = "mdi " + icons.mdiClass(icon!!)
    }
    for (k, v in tapMod.tapSlots(tapAction)) {
      [k] = v
    }
  }
}

/// One button showing the chosen option; a press chooses the next, round.
class SelectCycle extends Select {
  card = "selectCycle"
  cardDef = new nodes.CardDef {
    regions = optionsRegion
    template = #"<div class="fh-select-cycles">{{#children}}{{{html}}}{{/children}}</div>"#
    css = """
      .fh-select-cycles{display:inline-flex}
      .fh-select-cycle{min-block-size:2.5rem;padding-inline:1rem;border-radius:1.25rem;
      background:var(--fh-surface-alt);color:var(--fh-text)}
      """
  }
  children = let (self = this) let (cs = self.choices) new Listing {
    for (i, ch in cs) {
      new CycleButton {
        label = ch.label
        icon = ch.icon
        shown = self.isChosen(ch.value)
        tapAction = self.variable.choose(cs[(i + 1) % cs.length].value)
      }
    }
  }
}

/// `c.select(v, List("1h", "24h"))`: buttons until `.style(…)` says otherwise.
function select(v: varMod.Variable, options: List<varMod.Value|Choice>): Select =
  if (options.isEmpty) throw("c.select(\(v.name)) has no options.")
  else new SelectButtons { variable = v; choices = options.map((o) -> choiceOf(o)) }
