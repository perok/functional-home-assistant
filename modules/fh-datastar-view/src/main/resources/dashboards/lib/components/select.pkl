/// A choice of one value from a set, in a style picked per use. The target is
/// what the choice is FOR, and it decides what a press does, what reads as
/// chosen, and where the options come from:
///
///     c.select(shade).options(List("pale", "deep")).style("dropdown")  // a node variable
///     c.select(dump.entities.robot_mode)                               // a select entity's options
///     c.select(lamp.effects!!).style("cycle")                          // a light's effects
///     c.select(heater.hvacModes)                                       // any other hass.Options
///
/// A node variable is only chosen, never declared: whatever holds its readers
/// declares it, and the build refuses a select with no declarer above it (ADR
/// 0033). Each option is a node of its own, so a press dims only the option
/// pressed (ADR 0019).
///
/// Over a variable, the cycle and the dropdown's label are bake groups selected
/// by its value, so the first HTML shows the chosen option; the buttons are lit
/// by the client, as a tab bar's are. The server refuses a choice nothing on the
/// page reads, so `buttons` over a variable needs a reader: a chart's
/// `.over(v.ref)`, a bake group.
module components.select

import "../core/icon.pkl" as icons
import "../core/node.pkl" as nodes
import "../core/slot.pkl" as slotMod
import "../core/surface.pkl" as surfaceMod
import "../core/tap.pkl" as tapMod
import "../core/variable.pkl" as varMod
import "../hass.pkl"
import "base/button.pkl" as buttonMod
import "base/surface.pkl" as surfaces

typealias SelectStyle = "buttons"|"dropdown"|"cycle"

/// What `c.select` takes: a `select` entity stands for its own options.
typealias Target = varMod.Variable|hass.Options|hass.SelectEntity

/// What a select chooses for, once `c.select` has resolved an entity to its
/// options.
typealias Over = varMod.Variable|hass.Options

/// One option. A node variable's value travels in a route segment, so there it
/// must be a [[varMod.Value]]; an entity's travels in a JSON body.
class Choice {
  value: String
  label: String = value
  /// An MDI name, `mdi:palette`.
  icon: String? = null
}

/// A choice from a bare value, labelled by itself.
const function choiceOf(v: String|Choice): Choice =
  if (v is Choice) v else new Choice { value = v }

// Inside a JS or CEL string literal, inside a double-quoted attribute that
// Mustache's `{{…}}` HTML-escapes.
const local function quoted(s: String): String =
  "'" + s.replaceAll("\\", "\\\\").replaceAll("'", "\\'") + "'"

const local function targetName(t: Over): String =
  if (t is hass.Options) t.owner.entity_id + (if (t.name != null) " " + t.name!! else "")
  else t.name

/// What the target itself offers: an entity's own list, none for a variable.
const local function offered(t: Over): List<String> =
  if (t is hass.Options) t.list.toList() else List()

/// `{'v': 'label', …}`, a JS or CEL map literal.
const local function labelMap(cs: List<Choice>): String =
  "{" + cs.map((ch) -> "\(quoted(ch.value)): \(quoted(ch.label))").join(", ") + "}"

/// The entity's current value, as CEL.
const local function currentOf(o: hass.Options): String =
  if (o.attr != null) "attr[?\(quoted(o.attr!!))].orValue('')" else "state"

/// Whether `v` is the entity's current value.
const local function entityChosen(o: hass.Options, v: String): slotMod.Expr =
  slotMod.exprOf(o.owner, "\(currentOf(o)) == \(quoted(v))")

const local function entityCall(o: hass.Options, v: String): tapMod.Call =
  tapMod.call(o.service, o.owner).with(o.key, v)

// Each option is a node, so the card is structure: a patch of the select never
// re-sends them.
const local optionsRegion: Mapping<String, nodes.Region> =
  new { [nodes.defaultRegion] = new nodes.Region {} }

const local panelRegion: Mapping<String, nodes.Region> =
  new { ["panel"] = new nodes.Region { fill = "baked" } }

// One member per option, shown while `v` is at its value: the server renders the
// chosen one, as a slider's mode panels.
const local function panelsOf(v: varMod.Variable, nodesFor: List<nodes.LayoutNode>, cs: List<Choice>): Mapping<String, surfaceMod.SurfaceDef> =
  new Mapping {
    for (i, ch in cs) {
      ["o\(i)"] = new surfaceMod.SurfaceDef {
        content = nodesFor[i]
        bakeInto = nodes.NODE_ID
        bakeAs = "panel"
        bakeIndex = i
        activation = v.selecting(ch.value)
      }
    }
  }

abstract class Select extends nodes.Node {
  hidden target: Over
  hidden choices: List<Choice> = offered(target).map((v) -> choiceOf(v))
  /// Whether a press chooses the NEXT option rather than its own.
  hidden cycling: Boolean = false

  /// These options, in this order. On an entity, a subset of what it offers,
  /// relabelled or with icons; a value it does not offer names itself.
  function options(os: List<String|Choice>): Select =
    let (self = this) let (cs = os.map((o) -> choiceOf(o))) let (have = offered(self.target))
      let (stray = if (self.target is varMod.Variable) List() else cs.filter((ch) -> !have.contains(ch.value)))
        if (!stray.isEmpty)
          throw("c.select(\(targetName(self.target))) offers no \(stray.map((ch) -> ch.value).join(", ")): it has \(have.join(", ")).")
        else (self) { choices = cs }

  /// The same choice in another style. A style is a class of its own (one card
  /// each, since a card name has one template: `nodes.cardsIn`), so this builds
  /// a new node: it carries what was set on this one,
  /// `.columns(6)` before it included, and the card computes the rest.
  function style(s: SelectStyle): Select =
    let (self = this) let (t = target) let (cs = choices)
    let (fresh =
        if (s == "buttons") new SelectButtons { target = t; choices = cs }
        else if (s == "dropdown")
          if (t is varMod.Variable) new VarSelectDropdown { target = t; choices = cs }
          else new SelectDropdown { target = t; choices = cs }
        else if (t is varMod.Variable) new VarSelectCycle { target = t; choices = cs }
        else new SelectCycle { target = t; choices = cs })
      (fresh) {
        cellClasses = self.cellClasses
        stateClasses = self.stateClasses
        liveClasses = self.liveClasses
        liveProperties = self.liveProperties
        id = self.id
        vars = self.vars
        starts = self.starts
        perMember = self.perMember
        expressionValues = self.expressionValues
      }

  /// One option's node: choosing `pick` on a press, lit while `ch` is chosen.
  /// A cycle's face is a pill in the option's look, as a slider's buttons are.
  function optionNode(ch: Choice, pick: Choice): nodes.LayoutNode =
    let (t = target) let (cyc = cycling)
      if (t is varMod.Variable)
        if (cyc)
          // A view switch answers too fast for a spinner to mean anything.
          buttonMod.pill((t.choose(pick.value)) { icon = ch.icon; label = ch.label; busyVisual = false })
        else surfaces.tabButton(t, ch.value, ch.label)
      else if (cyc)
        buttonMod.pill((entityCall(t, pick.value)) { icon = ch.icon; label = ch.label })
          .classWhen("fh-chosen", entityChosen(t, ch.value))
      else
        new EntityOption {
          label = ch.label
          icon = ch.icon
          active = entityChosen(t, ch.value)
          tapAction = entityCall(t, pick.value)
        }

  /// Each option's node, in order.
  hidden optionNodes: List<nodes.LayoutNode> =
    let (self = this) let (cs = choices)
      if (cs.isEmpty)
        throw("c.select(\(targetName(target))) has no options\(if (target is varMod.Variable) ": give them with .options(…)" else "").")
      else cs.mapIndexed((i, ch) -> self.optionNode(ch, if (self.cycling) cs[(i + 1) % cs.length] else ch))

  children = optionNodes.toListing()
}

/// One button per option, the chosen one lit: a window chooser's bar.
class SelectButtons extends Select {
  card = "selectButtons"
  cardDef = new nodes.CardDef {
    regions = optionsRegion
    template = #"<div class="fh-tabs fh-select">{{#children}}{{{html}}}{{/children}}</div>"#
    css = """
      .fh-select>.fh-cell{display:contents}
      """
  }
}

// The menu's markup around its label; the label differs by target.
const local function menuTemplate(chosen: String): String =
  #"<details class="fh-select-menu" data-on:click__outside="el.open = false"><summary class="fh-select-summary">"# +
    chosen +
    #"<i class="mdi mdi-chevron-down"></i></summary><div class="fh-select-list" data-on:click="el.closest('details').open = false">{{#children}}{{{html}}}{{/children}}</div></details>"#

// An open list hangs over the cells after it, and a later cell painted above it
// once (a chart's svg took the click meant for an option), so the open menu and
// its cell both rise; `:has` is iPadOS 15.4+, so the menu's own z-index stays.
const local menuCss: String = """
  .fh-select-menu{position:relative;display:inline-block}
  .fh-select-menu[open],.fh-cell:has(>.fh-select-menu[open]){position:relative;z-index:20}
  .fh-select-summary{display:inline-flex;align-items:center;gap:.25rem;list-style:none;cursor:pointer;
  min-block-size:2.5rem;padding-inline:1rem;border-radius:1.25rem;background:var(--fh-surface-alt);color:var(--fh-text)}
  .fh-select-summary::-webkit-details-marker{display:none}
  .fh-select-summary .fh-cell{display:contents}
  .fh-select-list{position:absolute;inset-block-start:calc(100% + .25rem);inset-inline-start:0;z-index:10;
  display:flex;flex-direction:column;min-inline-size:100%;padding-block:.25rem;border-radius:.75rem;
  background:var(--fh-surface);box-shadow:0 .25rem 1rem rgba(0,0,0,.25)}
  .fh-select-list .fh-cell{display:contents}
  .fh-select-list a{display:block;padding:.5rem 1rem;white-space:nowrap;cursor:pointer;color:var(--fh-text)}
  .fh-select-list :is(a.fh-chosen,.fh-active>a){font-weight:600;background:var(--fh-surface-alt)}
  """

// Over an entity every face is sent and the server marks the chosen one: its
// own class, not a lit pill's `fh-active`, which would read as "on".
const local cycleCss: String = """
  .fh-select-cycles{display:inline-flex}
  .fh-select-marked>.fh-cell:not(.fh-chosen){display:none}
  """

/// The chosen option, opening a list of all of them. A `<details>`, so it
/// opens with no script, and on iPadOS 15, which has no `popover`. A choice
/// closes it, and so does a tap outside. Over an entity, the label is a live
/// slot; [[VarSelectDropdown]] is a variable's.
class SelectDropdown extends Select {
  card = "selectDropdown"
  cardDef = new nodes.CardDef {
    regions = optionsRegion
    template = menuTemplate(#"<span \#(slotMod.signalBind("chosen"))>{{chosen}}</span>"#)
    slots { "chosen" }
    css = menuCss
  }
  hidden target: hass.Options
  // A class-level property: a nested body cannot see `target`, which `Select`
  // declares. A value outside the options shows as itself.
  hidden chosen: slotMod.Slot =
    let (o = target) let (labels = labelMap(choices)) let (current = currentOf(o))
      new slotMod.Slot {
        entityId = o.owner.entity_id
        transform = "\(labels)[?\(current)].orValue(\(current))"
        signal = slotMod.asText
        bypassUnavailable = false
      }
  slots { ["chosen"] = chosen }
}

/// [[SelectDropdown]] over a node variable: its label is one member per option,
/// baked by the variable's value.
class VarSelectDropdown extends Select {
  hidden target: varMod.Variable
  card = "selectVarDropdown"
  cardDef = new nodes.CardDef {
    regions = (optionsRegion) { ...panelRegion }
    template = menuTemplate(#"<span id="{{hostId}}">{{#panel}}{{{html}}}{{/panel}}</span>"#)
    css = menuCss
  }
  inlineSurfaces =
    let (cs = choices)
      panelsOf(target, cs.map((ch) -> new ChoiceLabel { label = ch.label; icon = ch.icon }), cs)
}

/// One button showing the chosen option; a press chooses the next, round. Over
/// an entity every option is rendered and the server marks the chosen one;
/// [[VarSelectCycle]] is a variable's.
class SelectCycle extends Select {
  hidden target: hass.Options
  card = "selectCycle"
  cardDef = new nodes.CardDef {
    regions = optionsRegion
    template = #"<div class="fh-select-cycles fh-select-marked">{{#children}}{{{html}}}{{/children}}</div>"#
    css = cycleCss
  }
  cycling = true
}

/// [[SelectCycle]] over a node variable: one member per option, baked by the
/// variable's value, so only the chosen option's button is sent.
class VarSelectCycle extends Select {
  hidden target: varMod.Variable
  card = "selectVarCycle"
  cardDef = new nodes.CardDef {
    regions = panelRegion
    template = #"<div id="{{hostId}}" class="fh-select-cycles">{{#panel}}{{{html}}}{{/panel}}</div>"#
    css = cycleCss
  }
  cycling = true
  children = new Listing {}
  inlineSurfaces = panelsOf(target, optionNodes, choices)
}

/// The label a [[VarSelectDropdown]] shows for one option. An icon replaces
/// the label, as on a cycle's face, so a dropdown fits a slider's pill; the
/// list still names every option.
class ChoiceLabel extends nodes.Node {
  card = "selectChoice"
  cardDef = new nodes.CardDef {
    template = #"{{#glyph}}<i class="{{glyph}}" title="{{label}}"></i>{{/glyph}}{{^glyph}}<span>{{label}}</span>{{/glyph}}"#
    slots { "label" }
  }
  hidden label: String
  hidden icon: String? = null
  slots {
    ["label"] = label
    when (icon != null) {
      ["glyph"] = "mdi " + icons.mdiClass(icon!!)
    }
  }
}

/// One option of a select over an entity: `fh-active` on its cell while the
/// entity holds this value, decided by the server, so the first HTML is right.
class EntityOption extends nodes.ActiveNode {
  card = "selectEntityOption"
  cardDef = new nodes.CardDef {
    template = #"<a class="fh-select-opt" title="{{label}}" data-on:click="\#(tapMod.guardClick)\#(tapMod.click)"\#(tapMod.refusedAttr)\#(tapMod.guard)>{{#glyph}}<i class="{{glyph}}"></i>{{/glyph}}{{^glyph}}{{label}}{{/glyph}}</a>"#
    slots { "label" }
    css = """
      .fh-select .fh-active>.fh-select-opt{font-weight:600}
      """
  }
  hidden label: String
  hidden icon: String? = null
  hidden tapAction: tapMod.Call
  slots {
    ["label"] = label
    when (icon != null) {
      ["glyph"] = "mdi " + icons.mdiClass(icon!!)
    }
    for (k, v in tapMod.tapSlots(tapAction)) {
      [k] = v
    }
  }
}

/// `c.select(target)`: buttons until `.style(…)` says otherwise.
function select(t: Target): Select =
  new SelectButtons { target = if (t is hass.SelectEntity) t.choices else t }
