/// A horizontal bar filled to a fraction, as a tile feature or on its own. It
/// knows nothing about Home Assistant: `components/bar.pkl` fills it from
/// entities.
module components.base.bar

import "../../core/node.pkl" as nodes
import "../../core/slot.pkl" as slotMod

// The fill is the browser's arithmetic, because it can be a function of two
// readings and a slot reads one. Computed once into a node-scoped signal, which
// both the width and `aria-valuenow` read. `|| 0` turns a reading of `unknown`
// (NaN) into an empty bar rather than `NaN%`, which CSS ignores, leaving the
// last width standing. The object form, because in `data-computed:<key>` a
// `__` starts the modifiers: the key form named the signal `_<id>` and the
// width read one nobody set, and an id can hold a `__` of its own.
const local valueSlot: slotMod.Slot = slotMod.slot("value")
const local ofSlot: slotMod.Slot = slotMod.slot("of")
const local scaleSlot: slotMod.Slot = slotMod.slot("scale")
const local downSlot: slotMod.Slot = slotMod.slot("down")

const local fillSig: String = "_{{id}}__fill"
const local fillExpr: String =
  "Math.min(100, Math.max(0, \(downSlot.ifSet("100 - "))\(ofSlot.ifSetElse("100 * \(valueSlot.jsValue)\(scaleSlot.ifSet(" * \(scaleSlot)")) / \(ofSlot.jsValue)", "+\(valueSlot.jsValue)")))) || 0"
// Hidden while a reading has no value (`""`, a `valueWhile` that does not hold)
// or is not a number (`unknown`). `isNaN('')` is false, hence both.
const local readable: String =
  "\(valueSlot.jsValue) !== '' && !isNaN(\(valueSlot.jsValue))\(ofSlot.ifSet(" && \(ofSlot.jsValue) !== '' && !isNaN(\(ofSlot.jsValue))"))"

/// The fill is `value` as a percentage, or `value × scale ÷ of` with [[of]],
/// reversed when [[down]]. Its readings are signals: a reading that moves costs
/// its few bytes, never the bar. The bar hides while either reading is `""` or
/// not a number.
class ProgressBar extends nodes.Node {
  card = "progressBar"
  cardDef = new nodes.CardDef {
    // Not a `<progress>`, whose parts need a vendor pseudo-element each; the
    // ARIA role carries its meaning.
    template = """
      <div class="fh-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" data-show="\(readable)" data-computed="{'\(fillSig)': () => \(fillExpr)}" data-attr:aria-valuenow="Math.round($\(fillSig))"><div class="fh-bar-fill" data-style:width="$\(fillSig) + '%'"></div></div>
      """
    css = """
      .fh-bar{block-size:.5rem;inline-size:100%;border-radius:.25rem;
      background:var(--fh-track,rgba(128,128,128,.25));overflow:hidden}
      .fh-bar-fill{block-size:100%;inline-size:0;border-radius:inherit;
      background:var(--fh-accent);transition:inline-size .3s linear}
      """
  }
  hidden value: slotMod.Reading
  /// The whole the value is a part of; without one, the value is a percentage.
  hidden of: slotMod.Reading? = null
  /// One unit of `value` in units of `of`, when the two differ: `60` for
  /// minutes left out of a total in seconds.
  hidden scale: Number = 1
  /// Fills as the value falls: time left fills toward done.
  hidden down: Boolean = false
  slots {
    slotMod.signalled(valueSlot, value, slotMod.asHandler)
    when (of != null) {
      slotMod.signalled(ofSlot, of!!, slotMod.asHandler)
      when (scale != 1) { scaleSlot.of(scale.toString()) }
    }
    downSlot.setIf(down)
  }
}

/// A bar filled to a percentage reading.
function percent(v: slotMod.Reading): ProgressBar = new { value = v }

/// A bar filled to `v` out of `whole`.
function partOf(v: slotMod.Reading, whole: slotMod.Reading): ProgressBar = new { value = v; of = whole }
