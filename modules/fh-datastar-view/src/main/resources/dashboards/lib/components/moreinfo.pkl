/// More-info: one entity's card, its domain's controls, its recorded past where
/// that means anything, and its raw facts, in a popup — what a tap on an entity
/// with no action opens (#106).
module components.moreinfo

import "../core/node.pkl" as nodes
import "../core/slot.pkl" as slotMod
import "../core/tap.pkl" as tapMod
import "../hass.pkl"
import "../layout.pkl" as layout
import "base/button.pkl" as buttonMod
import "history.pkl" as historyMod
import "entity.pkl" as entityMod
import "light.pkl" as light

/// An entity's id, and every attribute it reports as `name: value` lines. One
/// live slot, because which attributes exist is a runtime fact and a template
/// has no loop.
class EntityInfo extends nodes.Node {
  card = "entityInfo"
  cardDef = new nodes.CardDef {
    template = """
      <div class="card entity-info">
        <code class="entity-info-id">{{entity_id}}</code>{{#attributes}}
        <pre class="entity-info-attrs">{{attributes}}</pre>{{/attributes}}
      </div>
      """
    slots { "entity_id"; "attributes" }
    // Capped, so a chatty entity cannot push the controls and ✕ off screen.
    css = """
      .entity-info{display:flex;flex-direction:column;gap:.5rem}
      .entity-info-id{font-family:monospace;font-size:.8rem;word-break:break-all;
      color:var(--fh-text-dim)}
      .entity-info-attrs{margin:0;max-block-size:14rem;overflow:auto;font-size:.75rem;
      line-height:1.5;white-space:pre-wrap;overflow-wrap:anywhere;
      color:var(--fh-text-dim)}
      """
  }
  hidden entity: hass.Entity
  slots {
    ["entity_id"] = entity.entity_id
    ["attributes"] = new slotMod.Slot { transform = ATTR_LINES; default = "" }
  }
}

function entityInfo(e: hass.Entity): EntityInfo = new EntityInfo { entity = e }

// Sorted, because HA's attribute order is not stable. `transformList` over a
// map walks its entries (CEL's transformations extension).
const local ATTR_LINES =
  #"attr.transformList(k, v, k + ': ' + str(v)).sort().join('\n')"#

/// What a more-info popup holds. Only `light` adds controls. The chart is
/// decided at build time from [[hass.SensorEntity.isNumeric]], so a
/// non-numeric entity's popup makes no recorder call.
function moreInfoBody(e: hass.Entity): layout.Column = new layout.Column {
  children {
    // The tap is pinned to the domain's: the default is `moreInfo(e)` for a
    // domain with none, and this card would then build its own popup forever.
    (entityMod.entityCard(e)) { tapAction = tapMod.byDomain(e) }
    when (e is hass.LightEntity) {
      light.controls(e as hass.LightEntity)
    }
    when (e is hass.SensorEntity && (e as hass.SensorEntity).isNumeric) {
      (historyMod.windowChooser) {
        children { historyMod.historyChart(e as hass.SensorEntity).chosen() }
      }
    }
    entityInfo(e)
    buttonMod.button("Close", tapMod.closePopup())
  }
}

/// `c.entityCard(e).tapAction(c.tap.moreInfo(e))`, or `c.entityCard(e) |>
/// c.informative`. An inline popup: the body is this entity's alone.
function moreInfo(e: hass.Entity): tapMod.OpenSurface = tapMod.openPopupInline(moreInfoBody(e))

/// The default click for an entity card: its domain's service, else more-info,
/// so no card shows a pointer over a service that does not exist (#106).
function defaultTap(e: hass.Entity): tapMod.TapAction = tapMod.byDomain(e) ?? moreInfo(e)

/// `c.entityCard(x) |> c.informative`, naming `x` once.
informative: Mixin<entityMod.EntityCard> = new { tapAction = moreInfo(entity) }
