/// The things you press: button, pill, toggle.
module components.control

import "../core/node.pkl" as nodes
import "../core/slot.pkl" as slotMod
import "../core/tap.pkl" as tapMod
import "../core/text.pkl" as textMod
import "../core/icon.pkl" as icons
import "../core/simple.pkl" as simpleMod
import "../hass.pkl"

// What a pressable card says when it has nothing to press. `const` because it
// is called from class bodies.
const local function noAction(ctor: String): String =
  "\(ctor): nothing happens on click — pass an `action`, or an `entity` whose "
    + "domain implies one (the table is `hass/actions.pkl`)"

/// Generic click button (service call or navigate). `action = null` falls back
/// to the domain-derived action of the button's `entity`, and a button with
/// neither is a BUILD error — see [[Button.tap]]. (Tab-bar entries are NOT
/// buttons — see [[TabButton]].)
class Button extends nodes.Node {
  card = "button"
  cardDef = new nodes.CardDef {
    // A button that GOES somewhere is an `<a href>`, not a scripted click: the
    // browser then gives it middle-click, open-in-new-tab, the status-bar
    // preview, and a working click before Datastar has even loaded. `.button`
    // is BeerCSS's element-independent button styling, so the two forms look
    // the same (verified in beer.min.css: every button rule is
    // `:is(button,.button)`). Only `label` is a declared slot — the other two
    // are the two arms of one choice, so neither is always present.
    //
    // A button may carry a GLYPH, a label, or both. Icon-only is `round`
    // (BeerCSS `circle small`), because a button with nothing but a glyph in a
    // rectangle reads as a broken label, and round is what every framework and
    // every phone means by "icon button". The shape travels as a slot rather
    // than being derived in the template, because `{{^label}}` nested inside
    // `{{#glyph}}` says the same thing in a form nobody can read.
    //
    // `lit` tints the control while its entity is on — a CLASS signal slot, so
    // the state costs a frame and never a re-render. Absent unless asked for.
    //
    // A GLYPH button additionally takes `busyShapeClass` while its call is in
    // flight: BeerCSS paints a morphing shape around the icon, which is the
    // in-flight affordance an icon has instead of a label going dim. A labelled
    // button gets `busyClass` alone, as it always did.
    template = """
      {{#href}}<a class="button {{#round}}circle small{{/round}}{{^round}}card{{/round}}{{#hasLit}} {{lit}}{{/hasLit}}"{{#hasLit}} \(slotMod.signalBind("lit")){{/hasLit}} href="{{{href}}}">{{#glyph}}<i class="mdi {{glyph}}"></i>{{/glyph}}{{#label}}\(textMod.hole("label")){{/label}}</a>{{/href}}{{^href}}<button class="{{#round}}circle small{{/round}}{{^round}}card{{/round}}{{#hasLit}} {{lit}}{{/hasLit}}"{{#hasLit}} \(slotMod.signalBind("lit")){{/hasLit}} data-on:click="{{#busy}}\(tapMod.busyGuard){{/busy}}{{{onclick}}}"{{#busy}} \(tapMod.busyAttrs){{/busy}}{{#busyVisual}} \(tapMod.busyClass){{#glyph}} \(tapMod.busyShapeClass){{/glyph}}{{/busyVisual}}>{{#glyph}}<i class="mdi {{glyph}}"></i>{{/glyph}}{{#label}}\(textMod.hole("label")){{/label}}</button>{{/href}}
      """
    // `label` stays declared — every button has one, even when it is the empty
    // string an icon-only button carries. `glyph`/`round`/`lit` do not: they are
    // optional pieces, absent on the ordinary labelled button.
    slots { "label" }
    // A LABELLED button fills its layout cell — `:not(.circle)`, because a round
    // one is sized by its SHAPE and stretching it to the cell's width made an
    // oval. This rule's specificity (0,2,0) beats BeerCSS's own `.circle`
    // (0,1,0), so it wins silently rather than being overridden by the
    // framework; the exception has to be written here or not at all.
    //
    // A framework that sizes buttons to their
    // label (BeerCSS does) left-aligns a short pill in a wide box: three nav
    // buttons on one row came out ragged, spaced by leftover cell rather than by
    // the gap. Every other card already fills its cell, so this is the cell
    // contract catching up with them, not a button special case. `border-box`
    // because a content-box button would add its padding on top of the 100% and
    // overflow. Only a cell's own root: the popup ✕ and the offline-banner
    // button live outside the layout and keep hugging their labels.
    // A label longer than the button is a LABEL, not an overflow: frameworks
    // size a button to one line of text (BeerCSS pins `block-size` to its
    // `--_size`), so a two-word entity name spilled out of the pill sideways.
    // WHAT it does instead is `core/text.pkl`'s to say — what is here is only
    // the room to do it: a button that may take a second line must be free to
    // grow down, and `min-block-size` keeps the resting height it had, so a
    // one-line button is pixel-identical either way.
    css = """
      .fh-cell>:is(.button,button):not(.circle){inline-size:100%;box-sizing:border-box;
      block-size:auto;min-block-size:2.5rem;padding-block:.5rem}
      """
  }
  hidden entity: hass.Entity? = null
  hidden label: (String|slotMod.Expr)? = null
  /// A glyph before the label, as an MDI name (`mdi:power`). With `label = ""`
  /// the button is icon-only and renders round — see [[iconButton]].
  hidden icon: String? = null
  /// Tint the control while its entity is on. Off by default: most buttons DO
  /// something rather than reflecting a state, and a button that lit up for no
  /// reason would be worse than one that never does. Needs an [[entity]].
  hidden lit: Boolean = false
  /// What pressing it DOES. Defaults to the entity's domain action where the
  /// button has an entity — and with neither, this FAILS the build: a button is
  /// defined by what pressing it does, so not knowing that is not a state it
  /// should reach. It used to default to `homeassistant/toggle` with an empty
  /// entity id, so `(c.button) { label = "x" }` posted a call that could only
  /// ever error at HA (issue #106).
  hidden tapAction: tapMod.TapAction =
    (if (entity != null) tapMod.byDomain(entity!!) else null)
      ?? throw(noAction("c.button"))
  // Copy the action's inline surfaces onto the node (mirror jsonnet tapInline).
  inlineSurfaces = tapAction.inlineSurfaces
  slots {
    when (entity != null) {
      ["entity_id"] = entity!!.entity_id
    }
    ["label"] = slotMod.labelSlot(entity, label)
    when (icon != null) {
      ["glyph"] = icons.mdiClass(icon!!)
      // Round exactly when there is nothing but the glyph. `label` is the
      // AUTHORED value, not the resolved slot: a button with an entity resolves
      // to its friendly_name, and asking about that would make every
      // icon-carrying entity button rectangular.
      when (label == "") {
        ["round"] = "1"
      }
    }
    when (lit && entity != null) {
      // `""` for off — an empty string is the only falsy value a slot can
      // produce, and `"false"` would read as ON. Opted in
      // ([[simpleMod.enumOf]]).
      ["lit"] = new slotMod.Slot {
        simple = simpleMod.enumOf("on", "lit", "")
        default = ""
        bypassUnavailable = false
        signal = slotMod.asClass("lit")
      }
      // A LITERAL flag gating both the class hole and the binding. It cannot be
      // `{{#lit}}` itself: the slot's value is "" whenever the entity is off,
      // and in the PATCH form it is always "" — so the section would collapse
      // and take the binding with it, leaving the element inert for good (ADR
      // 0017). It also keeps an unlit button byte-identical to what it was
      // before this card grew the option.
      ["hasLit"] = "1"
    }
    // The anchor form wins when the tap offers one; the other slot is then
    // omitted entirely rather than emitted-and-ignored, so the node JSON says
    // which element it is.
    when (tapAction.href != null) {
      ["href"] = tapAction.href!!
    } else {
      ["onclick"] = tapAction.onclick
    }
    // Only the non-anchor arm carries the busy splice — an anchor is a
    // navigate, which is never guarded (`busy = false`), so this can never
    // name a slot the template does not place. The GUARD (`busy`) and the
    // LOOK (`busyVisual`) are separate slots: the class binding behind
    // `busyVisual` is the whole `fh-disabled`/`fh-loading` visual, and a tap
    // with `busyVisual = false` still swallows re-clicks, just never dims.
    when (tapAction.href == null && tapAction.busy) {
      ["busy"] = "1"
    }
    when (tapAction.href == null && tapAction.busy && tapAction.busyVisual) {
      ["busyVisual"] = "1"
    }
  }
  // Fluent config (see [[EntityCard]]'s builder methods).
  function entity(e: hass.Entity): Button = let (self = this) (self) { entity = e }
  function label(l: String|slotMod.Expr): Button = let (self = this) (self) { label = l }
  function icon(i: String): Button = let (self = this) (self) { icon = i }
  function lit(l: Boolean): Button = let (self = this) (self) { lit = l }
  function tapAction(a: tapMod.TapAction): Button = let (self = this) (self) { tapAction = a }
}

/// On/off control — BeerCSS's `.switch` (a checkbox styled as a MD3 switch:
/// `<label class="switch"><input type="checkbox"><span></span></label>`).
/// Unlike [[Button]]/[[Pill]], the checkbox itself must show which state it is
/// IN, not just act on it, so `checked` is a live slot baked from the entity's
/// own state — the same baked-attribute move as [[Slider]]'s fill, and for the
/// same reason: an SSE morph only replaces markup, so the state must already be
/// in the HTML it sends rather than something a client script re-derives.
/// Always calls a service (there is no href arm — a checkbox cannot be an
/// `<a>`), defaulting to the same domain-resolved toggle every [[Button]] does.
class Toggle extends nodes.Node {
  card = "toggle"
  cardDef = new nodes.CardDef {
    template = """
      <article class="card row toggle">
        <span class="max \(textMod.BOX)">\(textMod.run("label"))</span>
        <label class="switch">
          <input type="checkbox" value="on" {{#checked}}checked{{/checked}} \(slotMod.signalBind("checked")) data-on:click="{{#busy}}\(tapMod.busyGuard){{/busy}}{{{onclick}}}"{{#busy}} \(tapMod.busyAttrs){{/busy}}{{#busyVisual}} \(tapMod.busyClass){{/busyVisual}} />
          <span></span>
        </label>
      </article>
      """
    slots { "label" }
    // The `toggle` class exists only so this rule has something to name — a
    // framework's `.row` is a shared class and must not be retuned through it.
    //
    // A flex item's automatic minimum size is its CONTENT, so a long label
    // pushed the switch off the card's right edge — the control the card exists
    // for, gone. The label giving way is `core/text.pkl`'s `min-inline-size:0`;
    // this is the other half, and it has to be said here: the SWITCH must never
    // be the thing that shrinks.
    css = """
      .card.row.toggle>.switch{flex:0 0 auto}
      """
  }
  hidden entity: hass.Entity
  hidden label: (String|slotMod.Expr)? = null
  /// Defaults to the entity's domain action. A switch that cannot be switched
  /// is not a thing, so a domain with no action ([[hass_actions]]) fails the
  /// build here rather than rendering a checkbox that does nothing — use
  /// [[EntityCard]] (which falls back to more-info) for those.
  hidden tapAction: tapMod.TapAction = tapMod.byDomain(entity) ?? throw(noAction("c.toggle"))
  inlineSurfaces = tapAction.inlineSurfaces
  slots {
    ["entity_id"] = entity.entity_id
    ["label"] = slotMod.labelSlot(entity, label)
    // Opt OUT of the unavailable bypass (unlike a display value, "unavailable"
    // is not a checkbox state) so an unavailable entity just renders unchecked.
    //
    // A TWO-WAY signal slot (ADR 0017), which is the only correct binding for a
    // checkbox: `data-attr:checked` sets the ATTRIBUTE, and after load the
    // browser reads the PROPERTY, so an attribute patch would move nothing. The
    // value is `"on"`/`""` to match the input's `value="on"` — the bundle's
    // checkbox setter compares a string signal against `el.value` — and the
    // template renders the initial `checked` attribute from a mustache SECTION
    // off the same slot, which an empty string collapses. So the document (and
    // a JS-less reader) still gets the state in the markup, and the patch form
    // withholds it because the signal owns it from then on.
    //
    // Two-way is a small behaviour change worth naming: a click now moves the
    // signal immediately, so the switch flips optimistically and the frame that
    // follows either confirms it or puts it back.
    ["checked"] = new slotMod.Slot {
      simple = simpleMod.enumOf("on", "on", "")
      default = ""
      bypassUnavailable = false
      signal = slotMod.asBind
    }
    ["onclick"] = tapAction.onclick
    when (tapAction.busy) {
      ["busy"] = "1"
    }
    when (tapAction.busy && tapAction.busyVisual) {
      ["busyVisual"] = "1"
    }
  }
  function label(l: String|slotMod.Expr): Toggle = let (self = this) (self) { label = l }
  function tapAction(a: tapMod.TapAction): Toggle = let (self = this) (self) { tapAction = a }
}

/// Static toggle as a call — see [[Toggle]].
function toggle(e: hass.Entity): Toggle = new Toggle { entity = e }
/// The SAME constructor as a VALUE, for a query's render positions (mirrors
/// [[entityCard]]).
hidden toggle: (hass.Entity) -> Toggle = (e) -> toggle(e)

/// Compact tappable pill — the same two arms as [[Button]] (navigate = `<a>`,
/// service call = `<button>`), styled as a chip and sized to its label instead
/// of to its cell. For a run of small choices — floors, scenes, modes — where a
/// row of full-width buttons would read as a stack of unrelated slabs.
///
/// Its cell defaults to `fh-hug` (the same self-defaulted-cell move [[Tabs]]
/// makes with `fh-cols-full`), which is the whole difference in layout terms:
/// a hugging cell packs at the container's gap, so pills in a [[Grid]] centre
/// and wrap as one group. An author still overrides it — `columns(n)` and
/// `fullWidth()` compose on top, and a pill that spans a grid column is a
/// perfectly reasonable thing to ask for.
class Pill extends nodes.Node {
  card = "pill"
  cardDef = new nodes.CardDef {
    // BeerCSS's `.chip`: outlined, `--on-surface-variant` text, pill radius,
    // and already `box-sizing:border-box` (unlike `.button`, which is
    // content-box — see the theme's `.fh-cell>.button` rule).
    // A chip is already pill-shaped, so unlike [[Button]] there is no round
    // variant: a glyph-only chip is a chip with a glyph in it.
    template = """
      {{#href}}<a class="chip" href="{{{href}}}">{{#glyph}}<i class="mdi {{glyph}}"></i>{{/glyph}}{{#label}}\(textMod.hole("label")){{/label}}</a>{{/href}}{{^href}}<button class="chip" data-on:click="{{#busy}}\(tapMod.busyGuard){{/busy}}{{{onclick}}}"{{#busy}} \(tapMod.busyAttrs){{/busy}}{{#busyVisual}} \(tapMod.busyClass){{#glyph}} \(tapMod.busyShapeClass){{/glyph}}{{/busyVisual}}>{{#glyph}}<i class="mdi {{glyph}}"></i>{{/glyph}}{{#label}}\(textMod.hole("label")){{/label}}</button>{{/href}}
      """
    slots { "label" }
  }
  cell = new nodes.Cell { classes { "fh-hug" } }
  hidden entity: hass.Entity? = null
  hidden label: (String|slotMod.Expr)? = null
  /// A glyph before the label, as an MDI name — see [[Button.icon]]. With
  /// `label = ""` the chip is glyph-only.
  hidden icon: String? = null
  /// See [[Button.tapAction]] — same rule, same build error.
  hidden tapAction: tapMod.TapAction =
    (if (entity != null) tapMod.byDomain(entity!!) else null)
      ?? throw(noAction("c.pill"))
  inlineSurfaces = tapAction.inlineSurfaces
  slots {
    when (entity != null) {
      ["entity_id"] = entity!!.entity_id
    }
    ["label"] = slotMod.labelSlot(entity, label)
    when (icon != null) {
      ["glyph"] = icons.mdiClass(icon!!)
    }
    when (tapAction.href != null) {
      ["href"] = tapAction.href!!
    } else {
      ["onclick"] = tapAction.onclick
    }
    when (tapAction.href == null && tapAction.busy) {
      ["busy"] = "1"
    }
    when (tapAction.href == null && tapAction.busy && tapAction.busyVisual) {
      ["busyVisual"] = "1"
    }
  }
  function entity(e: hass.Entity): Pill = let (self = this) (self) { entity = e }
  function label(l: String|slotMod.Expr): Pill = let (self = this) (self) { label = l }
  function icon(i: String): Pill = let (self = this) (self) { icon = i }
  function tapAction(a: tapMod.TapAction): Pill = let (self = this) (self) { tapAction = a }
}

/// A service/navigate button as a call: `c.button("Close", c.tap.closePopup())`.
function button(l: String, a: tapMod.TapAction): Button = new Button { label = l; tapAction = a }
/// The compact form of the same thing: `c.pill("Underetasje", c.tap.navigate("under"))`.
function pill(l: String, a: tapMod.TapAction): Pill = new Pill { label = l; tapAction = a }

/// A round icon button — [[Button]] with a glyph and no label:
///
///     c.iconButton("mdi:power", c.tap.toggle)
///     c.iconButton("mdi:power", c.tap.toggle).entity(l).lit(true)
///
/// `const` so a class body can call it (the slider's head actions do).
const function iconButton(i: String, a: tapMod.TapAction): Button =
  new Button { icon = i; label = ""; tapAction = a }
