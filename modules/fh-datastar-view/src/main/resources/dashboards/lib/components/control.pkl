/// The things you press that are ABOUT an entity: an entity button and a
/// toggle. The ones that know nothing about Home Assistant are
/// `components/base/button.pkl`'s.
module components.control

import "../core/node.pkl" as nodes
import "../core/slot.pkl" as slotMod
import "../core/tap.pkl" as tapMod
import "../core/text.pkl" as textMod
import "../core/simple.pkl" as simpleMod
import "../hass.pkl"
import "base/button.pkl" as buttonMod

/// A button ABOUT an entity: [[buttonMod.Button]] with its inputs filled from
/// it. Named after it, pressing it does what its domain does
/// (`hass/actions.pkl`) unless told otherwise, and a reading that names no
/// entity reads this one. `c.entityButton(l)`,
/// `c.entityButton(l).active(c.isOn(l))`.
///
/// THIN, as an HA-layer class is: no card, template or slots of its own, only
/// the base's inputs, so it is exactly a base button an author could have
/// built by hand (`components.test.pkl` holds it to that). It inherits the
/// base's card, so the registry skips it.
class EntityButton extends buttonMod.Button {
  hidden entity: hass.Entity
  label = entity.friendly_name ?? entity.entity_id
  tapAction = tapMod.byDomain(entity) ?? throw(buttonMod.noAction("c.entityButton"))
  subject = entity.entity_id
}

/// See [[EntityButton]].
const function entityButton(e: hass.Entity): EntityButton = new EntityButton { entity = e }

/// Put a refused switch back where the SERVER last had it.
///
/// [[Toggle.checked]] is two-way bound, so a press moves it immediately and
/// waits to be confirmed. A refusal is exactly the case where confirmation
/// never comes — HA changed nothing, so no state frame follows — and the switch
/// then sits in the one position known to be wrong, until something unrelated
/// moves the entity.
///
/// Truth is the `switched` slot: the SAME transform as `checked`, so this is a
/// copy and not a mapping, but a shared server-owned signal rather than the
/// node-scoped one `data-bind` writes into. Two signals is the point — a
/// control that can be moved locally needs somewhere the local move cannot
/// reach, which is the same split the slider makes between its committed value
/// and `_slide`.
const local restoreSwitch: String =
  tapMod.restoreOnRefusal(
    "$" + slotMod.signalRef("checked") + " = $" + slotMod.signalRef("switched")
  )

/// On/off control — BeerCSS's `.switch` (a checkbox styled as a MD3 switch:
/// `<label class="switch"><input type="checkbox"><span></span></label>`).
/// Unlike a button or a pill, the checkbox itself must show which state it is
/// IN, not just act on it, so `checked` is a live slot baked from the entity's
/// own state — the same baked-attribute move as [[Slider]]'s fill, and for the
/// same reason: an SSE morph only replaces markup, so the state must already be
/// in the HTML it sends rather than something a client script re-derives.
/// Always calls a service (there is no href arm — a checkbox cannot be an
/// `<a>`), defaulting to the same domain-resolved toggle an [[EntityButton]] does.
///
/// A refused command puts the switch BACK — see [[restoreSwitch]]. Optimism
/// plus no rollback is the one combination that leaves a control lying.
class Toggle extends nodes.Node {
  card = "toggle"
  cardDef = new nodes.CardDef {
    template = """
      <article class="card row toggle" \(slotMod.signalBind("switched"))\(tapMod.guardLook)>
        <span class="max \(textMod.BOX)">\(textMod.run("label"))</span>
        <label class="switch">
          <input type="checkbox" value="on" {{#checked}}checked{{/checked}} \(slotMod.signalBind("checked")) data-on:click="\(tapMod.guardClick)\(tapMod.click)"\(slotMod.ifSlot("inert")){{#inert}} disabled{{/inert}} \(slotMod.signalBind("inert"))\(slotMod.endIfSlot("inert")) \(restoreSwitch)\(tapMod.guardMechanism) />
          <span></span>
        </label>
      </article>
      """
    slots { "label" }
    // The `toggle` class exists only so this rule has something to name — a
    // framework's `.row` is a shared class and must not be retuned through it.
    //
    // A flex item's automatic minimum size is its CONTENT, so a long label
    // pushed the switch off the card's right edge — the control the card exists
    // for, gone. The label giving way is `core/text.pkl`'s `min-inline-size:0`;
    // this is the other half, and it has to be said here: the SWITCH must never
    // be the thing that shrinks.
    css = """
      .card.row.toggle>.switch{flex:0 0 auto}
      """
  }
  hidden entity: hass.Entity
  hidden label: (String|slotMod.Expr)? = null
  /// Defaults to the entity's domain action. A switch that cannot be switched
  /// is not a thing, so a domain with no action ([[hass_actions]]) fails the
  /// build here rather than rendering a checkbox that does nothing — use
  /// [[EntityCard]] (which falls back to more-info) for those.
  hidden tapAction: tapMod.TapAction = tapMod.byDomain(entity) ?? throw(buttonMod.noAction("c.toggle"))
  inlineSurfaces = tapAction.inlineSurfaces
  slots {
    ["entity_id"] = entity.entity_id
    ["label"] = slotMod.labelSlot(entity, label)
    // Opt OUT of the unavailable bypass (unlike a display value, "unavailable"
    // is not a checkbox state) so an unavailable entity just renders unchecked.
    //
    // A TWO-WAY signal slot (ADR 0017), which is the only correct binding for a
    // checkbox: `data-attr:checked` sets the ATTRIBUTE, and after load the
    // browser reads the PROPERTY, so an attribute patch would move nothing. The
    // value is `"on"`/`""` to match the input's `value="on"` — the bundle's
    // checkbox setter compares a string signal against `el.value` — and the
    // template renders the initial `checked` attribute from a mustache SECTION
    // off the same slot, which an empty string collapses. So the document (and
    // a JS-less reader) still gets the state in the markup, and the patch form
    // withholds it because the signal owns it from then on.
    //
    // Two-way is a small behaviour change worth naming: a click moves the
    // signal immediately, so the switch flips optimistically. What confirms it
    // is the next state frame — and a REFUSED command produces none, which is
    // why [[restoreSwitch]] exists rather than the flip simply being undone by
    // the traffic that follows.
    ["checked"] = new slotMod.Slot {
      transform = simpleMod.enumOf("on", "on", "")
      default = ""
      bypassUnavailable = false
      signal = slotMod.asBind
    }
    // The same reading as `checked`, on a SHARED signal instead of the
    // node-scoped one `data-bind` owns — so there is a copy of the truth the
    // press cannot overwrite. It rides a `data-` attribute because it needs
    // some binding to exist and this is the honest one: the value is data about
    // the control, and having it in the DOM makes the rollback inspectable
    // rather than something only a signals dump can show.
    ["switched"] = new slotMod.Slot {
      transform = simpleMod.enumOf("on", "on", "")
      default = ""
      bypassUnavailable = false
      signal = slotMod.asAttr("data-switched")
    }
    for (k, v in tapMod.tapRoute(tapAction, "disabled")) {
      [k] = v
    }
    when (tapAction.busy) {
      ["busy"] = "1"
    }
    when (tapAction.busy && tapAction.busyVisual) {
      ["busyVisual"] = "1"
    }
  }
  function label(l: String|slotMod.Expr): Toggle = let (self = this) (self) { label = l }
  function tapAction(a: tapMod.TapAction): Toggle = let (self = this) (self) { tapAction = a }
}

/// Static toggle as a call — see [[Toggle]].
function toggle(e: hass.Entity): Toggle = new Toggle { entity = e }
/// The SAME constructor as a VALUE, for a query's render positions (mirrors
/// [[entityCard]]).
hidden toggle: (hass.Entity) -> Toggle = (e) -> toggle(e)
