/// The things you press that are ABOUT an entity: an entity button and a
/// toggle. The ones that know nothing about Home Assistant are
/// `components/base/button.pkl`'s.
module components.control

import "../core/icon.pkl" as icons
import "../core/slot.pkl" as slotMod
import "../core/tap.pkl" as tapMod
import "../core/simple.pkl" as simpleMod
import "../hass.pkl"
import "base/button.pkl" as buttonMod
import "base/onoff.pkl" as switchMod

/// [[buttonMod.Button]] filled from an entity: its name, its domain's tap, and
/// it as the subject. `c.entityButton(l).active(c.isOn(l))`. Thin — no card of
/// its own, so it is exactly a button an author could build
/// (`components.test.pkl` holds it to that).
class EntityButton extends buttonMod.Button {
  hidden entity: hass.Entity
  label = entity.friendly_name ?? entity.entity_id
  tapAction = tapMod.byDomain(entity) ?? throw(buttonMod.noAction("c.entityButton"))
  subject = entity.entity_id
}

const function entityButton(e: hass.Entity): EntityButton = new EntityButton { entity = e }

/// [[switchMod.Switch]] filled from an entity: on while it is `on`, flipping
/// it does what its domain does. A domain with no action fails the build
/// rather than render a switch that does nothing; `EntityCard` falls back to
/// more-info instead.
class Toggle extends switchMod.Switch {
  hidden entity: hass.Entity
  label = entity.friendly_name ?? entity.entity_id
  // No unavailable bypass: an unavailable entity renders unchecked.
  on = new slotMod.Slot {
    transform = simpleMod.enumOf("on", "on", "")
    default = ""
    bypassUnavailable = false
  }
  tapAction = tapMod.byDomain(entity) ?? throw(buttonMod.noAction("c.toggle"))
  subject = entity.entity_id
  glyph = icons.glyphOf(entity, null)
}

function toggle(e: hass.Entity): Toggle = new Toggle { entity = e }
/// The constructor as a value, for a query's render positions.
hidden toggle: (hass.Entity) -> Toggle = (e) -> toggle(e)
