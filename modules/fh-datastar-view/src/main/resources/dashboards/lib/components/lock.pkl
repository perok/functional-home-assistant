/// Lock composition: the tile, and the latch a lock reporting
/// `LockEntityFeature.OPEN` adds beyond lock and unlock. A lock's ordinary card
/// is `c.entityCard(l)`, whose default tap already locks or unlocks by state.
/// What is not modelled is listed on [[hass.LockEntity]].
module components.lock

import "../core/node.pkl" as nodes
import "../layout.pkl" as layout
import "../core/tap.pkl" as tapMod
import "../core/slot.pkl" as slotMod
import "../hass.pkl"
import "../hass/lock.pkl" as hassLock
import "control.pkl" as control
import "base/button.pkl" as buttonMod
import "base/text.pkl" as textMod
import "entity.pkl" as entityMod
import "tap.pkl" as verbs

/// Release the latch (`lock/open`; an unlocked door is still shut), behind a
/// confirmation, as HA guards this one control: a latch opens a door, where
/// every other tap moves something that can be moved back. Here the second
/// press is in a popup, a different place rather than the same spot twice.
function openLatch(l: hass.LockEntity): control.EntityButton =
  control
    .entityButton(l)
    .label("Open")
    .tapAction(tapMod.openPopupInline(confirmOpen(l)))
    .icon("mdi:door-open")
    // The opener's own reason, since a popup carries no call; the press inside
    // refuses the same states through its call.
    .disabled(slotMod.stateIn(l, hassLock.CANNOT_OPEN))

local function confirmOpen(l: hass.LockEntity): layout.Column = new layout.Column {
  children {
    textMod.title("Open the door?")
    // Pinned to the domain action: the default would open more-info on top.
    (entityMod.entityCard(l)) { tapAction = tapMod.byDomain(l) }
    buttonMod.button("Open the door", verbs.locks.openLatch(l))
    buttonMod.button("Cancel", tapMod.closePopup())
  }
}

/// Lock and Unlock side by side, HA's `lock-commands` card feature: two fixed
/// presses rather than one that reads the state, so a second press while a
/// slow lock catches up repeats the first instead of undoing it.
function lockButtons(l: hass.LockEntity): layout.Row = new layout.Row {
  children {
    control.entityButton(l).label("Lock").tapAction(verbs.locks.lock(l)).icon("mdi:lock")
    control.entityButton(l).label("Unlock").tapAction(verbs.locks.unlock(l)).icon("mdi:lock-open-variant")
  }
}

/// The tile with [[lockButtons]] as its feature, and the latch under them when
/// the lock reports `OPEN`, as HA's area dashboards compose a lock. The
/// features sit outside the tile's tappable row; the tile opens more-info,
/// which shows [[moreInfoCard]]. Read off the entity: a one-bit capability has
/// no group to pass (ADR 0013).
function controls(l: hass.LockEntity): nodes.LayoutNode = withControls(entityMod.entityCard(l), l)

/// [[controls]] for the more-info popup: the same buttons, and a tile that
/// opens nothing, since it would only open the popup it is in.
function moreInfoCard(l: hass.LockEntity): nodes.LayoutNode =
  withControls((entityMod.entityCard(l)) { tapAction = null }, l)

local function withControls(card: entityMod.EntityCard, l: hass.LockEntity): nodes.LayoutNode =
  card.features(List(lockButtons(l)) + (if (l.supportsOpen) List(openLatch(l)) else List()))
