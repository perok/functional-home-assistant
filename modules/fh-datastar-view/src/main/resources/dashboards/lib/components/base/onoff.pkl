/// An on/off switch that knows nothing about Home Assistant: a label, a reading
/// that says whether it is on, and the tap that flips it. A switch ABOUT an
/// entity is `components/control.pkl`'s `Toggle`, which only fills these.
module components.base.onoff

import "../../core/node.pkl" as nodes
import "../../core/slot.pkl" as slotMod
import "../../core/tap.pkl" as tapMod
import "../../core/text.pkl" as textMod
import "button.pkl" as buttonMod

// A press moves `checked` at once and waits for a state frame, and a refused
// command sends none. So a refusal copies back `switched`: the same reading, on
// a shared signal the press cannot write — the slider's committed/`_slide`
// split.
const local restoreSwitch: String =
  tapMod.restoreOnRefusal(
    "$" + slotMod.signalRef("checked") + " = $" + slotMod.signalRef("switched")
  )

/// BeerCSS's `.switch`, a checkbox styled as an MD3 switch. It must show which
/// state it is in, so [[on]] is a live reading. No href arm: a checkbox cannot
/// be an `<a>`.
open class Switch extends nodes.Node {
  card = "switch"
  cardDef = new nodes.CardDef {
    template = """
      <article class="card row toggle" \(slotMod.signalBind("switched"))\(tapMod.guardLook)>
        \(slotMod.ifSlot("icon"))<span class="fh-badge"><i class="{{icon}}" \(slotMod.signalBind("icon"))></i></span>\(slotMod.endIfSlot("icon"))<span class="max \(textMod.BOX)">\(textMod.run("label"))</span>
        <label class="switch">
          <input type="checkbox" value="on" {{#checked}}checked{{/checked}} \(slotMod.signalBind("checked")) data-on:click="\(tapMod.guardClick)\(tapMod.click)"\(tapMod.refusedAttr) \(restoreSwitch)\(tapMod.guardMechanism) />
          <span></span>
        </label>
      </article>
      """
    slots { "label" }
    // A long label must never shrink the switch off the card. `toggle` exists
    // so this does not retune the framework's shared `.row`.
    css = """
      .card.row.toggle>.switch{flex:0 0 auto}
      """
  }
  hidden label: (String|slotMod.Expr)? = null
  /// A reading yielding `"on"` or `""`: the bundle compares a string signal
  /// against `value="on"`, and `""` closes the document form's section.
  ///
  /// It feeds `checked`, two-way bound (the browser reads the property, not
  /// the attribute, after load), and `switched`, the server's copy
  /// ([[restoreSwitch]]).
  hidden on: slotMod.Slot
  hidden tapAction: tapMod.TapAction = throw(buttonMod.noAction("c.switch"))
  inlineSurfaces = tapAction.inlineSurfaces
  /// The `<i>`'s whole class, a literal or a reading, as `Tile.glyph`.
  hidden glyph: (String|slotMod.Slot)? = null
  /// See `Button.subject`.
  hidden subject: String? = null
  slots {
    when (subject != null) {
      ["entity_id"] = subject!!
    }
    ["label"] = slotMod.labelSlot(null, label)
    when (glyph != null) {
      ["icon"] =
        if (glyph is slotMod.Slot) (glyph as slotMod.Slot) { signal = slotMod.asAttr("class") }
        else glyph!!
    }
    ["checked"] = (on) { signal = slotMod.asBind }
    ["switched"] = (on) { signal = slotMod.asAttr("data-switched") }
    for (k, v in tapMod.tapRoute(tapAction)) {
      [k] = v
    }
    for (k, v in tapMod.guardSlots(tapAction)) {
      [k] = v
    }
  }
  function label(l: String|slotMod.Expr): Switch = let (self = this) (self) { label = l }
  function tapAction(a: tapMod.TapAction): Switch = let (self = this) (self) { tapAction = a }
}
