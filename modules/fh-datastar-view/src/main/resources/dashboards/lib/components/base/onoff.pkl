/// An on/off switch that knows nothing about Home Assistant: a label, a reading
/// that says whether it is on, and the tap that flips it. A switch ABOUT an
/// entity is `components/control.pkl`'s `Toggle`, which only fills these.
module components.base.onoff

import "../../core/badge.pkl" as badgeMod
import "../../core/node.pkl" as nodes
import "../../core/slot.pkl" as slotMod
import "../../core/tap.pkl" as tapMod
import "../../core/text.pkl" as textMod
import "button.pkl" as buttonMod

// A press moves `checked` at once and waits for a state frame, and a refused
// command sends none. So a refusal copies back `switched`: the same reading, on
// a shared signal the press cannot write — the slider's committed/`_slide`
// split.
const local restoreSwitch: String =
  tapMod.restoreOnRefusal(checked.assign(switched.jsValue))

const local labelSlot: slotMod.Slot = slotMod.slot("label")
const local checked: slotMod.Slot = slotMod.slot("checked")
const local switched: slotMod.Slot = slotMod.slot("switched")

/// `fh-switch`, BeerCSS's `.switch` under the default theme: a checkbox styled
/// as an MD3 switch. It must show which state it is in, so [[on]] is a live
/// reading. No href arm: a checkbox cannot be an `<a>`.
///
/// Its badge's on look is [[active]], a boolean reading: [[on]] is a string the
/// checkbox compares, so it cannot also be one.
open class Switch extends nodes.ActiveNode {
  card = "switch"
  cardDef = new nodes.CardDef {
    template = """
      <article class="fh-card fh-toggle fh-tile-card" \(switched.bind)\(tapMod.guardLook)>
        <div class="fh-tile">\(badgeMod.seat("", "\(badgeMod.icon)", badgeMod.tapSpin))<span class="fh-lines"><span class="\(textMod.BOX)">\(textMod.run(labelSlot))</span></span>
        <label class="fh-switch">
          <input type="checkbox" value="on" \(checked.ifTrue("checked")) \(checked.bind) data-on:click="\(tapMod.guardClick)\(tapMod.click)"\(tapMod.refusedAttr) \(restoreSwitch)\(tapMod.guardMechanism) />
          <span></span>
        </label></div>
      </article>
      """
    // The tile's row (`core/css.pkl`), ending on the switch. A long label must
    // never shrink the switch off the card.
    css = """
      .fh-tile>.fh-switch{flex:0 0 auto}
      """
  }
  hidden label: (String|slotMod.Expr)? = null
  /// A reading yielding `"on"` or `""`: the bundle compares a string signal
  /// against `value="on"`, and `""` closes the document form's section.
  ///
  /// It feeds `checked`, two-way bound (the browser reads the property, not
  /// the attribute, after load), and `switched`, the server's copy
  /// ([[restoreSwitch]]).
  hidden on: slotMod.Reading
  hidden tapAction: tapMod.TapAction = throw(buttonMod.noAction("c.switch"))
  inlineSurfaces = tapAction.inlineSurfaces
  /// The `<i>`'s whole class, a literal or a reading, as `Tile.glyph`.
  hidden glyph: (String|slotMod.Reading)? = null
  /// See `Button.subject`.
  hidden subject: String? = null
  slots {
    slotMod.subject.of(subject)
    labelSlot.of(slotMod.labelSlot(null, label))
    badgeMod.iconOf(glyph)
    slotMod.signalled(checked, on, slotMod.asBind)
    slotMod.signalled(switched, on, slotMod.asAttr("data-switched"))
    ...tapMod.tapRoute(tapAction)
    ...tapMod.guardSlots(tapAction)
    ...badgeMod.slots(active)
  }
  function label(l: String|slotMod.Expr): Switch = let (self = this) (self) { label = l }
  function tapAction(a: tapMod.TapAction): Switch = let (self = this) (self) { tapAction = a }
  function active(a: nodes.BooleanInput): Switch = let (self = this) (self) { active = a }
}
