/// The popup dialog: a card like any other, which [[components.popup]] puts in
/// the page's `popups` while the root's `popups` variable names it. Nothing
/// below `components/` knows a popup exists (ADR 0002).
module components.base.popup

import "../../core/node.pkl" as nodeMod
import "../../core/slot.pkl" as slotMod

/// Closing a popup is going back: each open popup has a history entry of its
/// own, whose popstate clears or restores the variable (ADR 0005). Guarded by
/// the variable's committed signal (`VarKey.committedSignal` of the root's
/// `popups`, written out here; `VarSignalNamesSuite` holds the two together),
/// so a close outside a popup cannot leave the page.
const closeExpr: String = "$_var_root__popups && history.back()"

/// The overlay `<dialog>` and a ✕, closed also by Escape and a tap on the
/// backdrop. Built by [[components.popup.popup]], which gives it the id the
/// variable holds.
class Popup extends nodeMod.Node {
  card = "popup"
  cardDef = new nodeMod.CardDef {
    // The backdrop is the root and holds the dialog, whose clicks bubble to it:
    // only one on the backdrop itself closes.
    classes = "fh-popup-backdrop"
    attrs = #"data-on:click="evt.target === el && \#(closeExpr)""#
    template = #"<dialog open class="fh-popup"><button class="fh-popup-close" data-on:click="\#(closeExpr)" data-on:keydown__window="evt.key === 'Escape' && \#(closeExpr)">✕</button>\#(slotMod.childrenSlot)</dialog>"#
    // The frame is the theme's `<dialog>`. The ✕ is 44px, the touch-target
    // minimum, with a surface of its own, and `z-index:1`: at that size it
    // overlaps a title, which was otherwise on top of it. The dialog is not
    // modal, so the backdrop is what stops a tap beside it reaching the page.
    css = """
      .fh-popup-backdrop{position:fixed;inset:0;z-index:100;background:var(--fh-scrim)}
      dialog.fh-popup{max-inline-size:min(90vw,32rem);z-index:101}
      .fh-popup-close{position:absolute;inset-block-start:.5rem;inset-inline-end:.5rem;
      display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;
      inline-size:2.75rem;block-size:2.75rem;padding:0;border:0;border-radius:999px;z-index:1;
      background:var(--fh-surface-alt);color:var(--fh-text-dim);
      font-size:1.25rem;line-height:1;cursor:pointer}
      .fh-popup-close:is(:hover,:focus-visible){color:var(--fh-text)}
      """
  }
}
