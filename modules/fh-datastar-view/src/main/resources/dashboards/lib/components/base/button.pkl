/// The things you press that know nothing about Home Assistant: a button and a
/// pill, each a label, a glyph and a tap. A button ABOUT an entity is
/// `components/control.pkl`'s `EntityButton`, which only fills these inputs.
///
/// Imports no `hass` module, and `BaseComponentsSuite` keeps it that way.
module components.base.button

import "../../core/node.pkl" as nodes
import "../../core/slot.pkl" as slotMod
import "../../core/tap.pkl" as tapMod
import "../../core/text.pkl" as textMod
import "../../core/icon.pkl" as icons

/// What a pressable card says when it has nothing to press.
const function noAction(ctor: String): String =
  "\(ctor): nothing happens on click — pass an action (`c.tap.toggle(e)`, "
    + "`c.tap.call(service, target)`), or use `c.entityButton(e)` for an entity "
    + "whose domain implies one (the table is `hass/actions.pkl`)"

// The label, and [[Button.secondary]] under it in a column that only opens when
// there is one.
const local buttonText: String =
  slotMod.ifSlot("secondary") + #"<span class="fh-lines">"# + slotMod.endIfSlot("secondary")
    + "{{#label}}" + textMod.hole("label") + "{{/label}}"
    + slotMod.ifSlot("secondary")
    + #"<span class="fh-sub \#(textMod.BOX)">"# + textMod.liveRun("secondary") + "</span></span>"
    + slotMod.endIfSlot("secondary")

// The glyph's WHOLE class, as `Tile.glyph`, so a reading can swap it.
const local glyphTag: String =
  #"<i class="{{glyph}}" "# + slotMod.signalBind("glyph") + "></i>"

// One literal token per size, so a theme's class rules reach it (ADR 0020).
const local pressClass: String =
  "fh-press" + slotMod.ifSlot("glyph") + " fh-badged" + slotMod.endIfSlot("glyph")
    + "{{#sizeSmall}} fh-size-small{{/sizeSmall}}{{#sizeMedium}} fh-size-medium{{/sizeMedium}}"
    + "{{#sizeLarge}} fh-size-large{{/sizeLarge}}"

// A labelled button fills its cell, as every other card does; a framework
// sizing buttons to their label left three nav buttons ragged. `block-size:auto`
// lets a long label take a second line where BeerCSS pins the height.
//
// It rests on the card surface and takes the accent only while `fh-active`,
// which sits on the cell; a container painting its buttons by position must
// leave an active one alone. Inside a card it steps to the alternate surface,
// or it would vanish into it, and its badge steps the other way.
//
// One height per size, `--fh-press-size`, which a theme may point at its own;
// the badge and the padding around it are fractions of it, so a large button
// keeps the 2.25rem badge every other card wears.
const local pressCss: String = """
  .fh-press.fh-size-small{--fh-press-size:2rem}
  .fh-press.fh-size-medium{--fh-press-size:2.5rem}
  .fh-press.fh-size-large{--fh-press-size:3rem}
  .fh-cell>:is(.fh-button,button).fh-press{inline-size:100%;box-sizing:border-box;
  block-size:auto;min-block-size:var(--fh-press-size,3rem);justify-content:flex-start;gap:.75rem;
  padding:calc(var(--fh-press-size,3rem) * .125) 1.25rem;border-radius:999px;text-align:start;
  --fh-badge-size:calc(var(--fh-press-size,3rem) * .75);
  background:var(--fh-surface);color:var(--fh-text);box-shadow:var(--fh-raise)}
  .fh-cell>:is(.fh-button,button).fh-press.fh-badged{padding-inline-start:.5rem}
  .fh-card .fh-cell>:is(.fh-button,button).fh-press{background:var(--fh-surface-alt);box-shadow:none}
  .fh-card .fh-press .fh-badge:not([aria-busy=true]){background:var(--fh-surface)}
  .fh-press .fh-sub{color:var(--fh-text-dim)}
  .fh-cell.fh-active>:is(.fh-button,button){background:var(--fh-accent);color:var(--fh-on-accent)}
  .fh-cell.fh-active>.fh-press .fh-sub{color:inherit;opacity:.8}
  .fh-cell>:is(.fh-button,button).fh-circle{background:var(--fh-surface-alt);color:var(--fh-accent)}
  .fh-cell.fh-active>:is(.fh-button,button).fh-circle{background:var(--fh-accent);color:var(--fh-on-accent)}
  """

/// A label, a glyph and a tap that names its own target.
open class Button extends nodes.ActiveNode {
  card = "button"
  cardDef = new nodes.CardDef {
    // A navigating button is an `<a href>`, so the browser gives it
    // middle-click and a click that works before Datastar loads. `fh-button`
    // is for a theme that styles a class where it styles `<button>`, so both
    // forms look the same.
    //
    // A labelled button is a card-like pill (`fh-press`), its glyph in a round
    // badge that also carries the spinner. Icon-only is `round`
    // (`fh-circle`): a glyph alone in a rectangle reads as a broken label, and
    // there the button itself spins.
    template = """
      {{#href}}<a class="fh-button {{#round}}fh-circle{{/round}}{{^round}}\(pressClass){{/round}}\(tapMod.currentClass)"\(tapMod.currentAttr) href="{{{href}}}">\(slotMod.ifSlot("glyph")){{#round}}\(glyphTag){{/round}}{{^round}}<span class="fh-badge">\(glyphTag)</span>{{/round}}\(slotMod.endIfSlot("glyph"))\(buttonText)</a>{{/href}}{{^href}}<button class="{{#round}}fh-circle{{/round}}{{^round}}\(pressClass){{/round}}" data-on:click="\(tapMod.guardClick)\(tapMod.click)"\(tapMod.refusedAttr)\(tapMod.guard){{#busyVisual}}\(slotMod.ifSlot("glyph")){{#round}} \(tapMod.busyShapeClass){{/round}}\(slotMod.endIfSlot("glyph")){{/busyVisual}}>\(slotMod.ifSlot("glyph")){{#round}}\(glyphTag){{/round}}{{^round}}<span class="fh-badge fh-icon-shape"{{#busyVisual}} \(tapMod.busyShapeClass){{/busyVisual}}>\(glyphTag)</span>{{/round}}\(slotMod.endIfSlot("glyph"))\(buttonText)</button>{{/href}}
      """
    css = pressCss
  }
  hidden label: (String|slotMod.Expr)? = null
  /// A smaller, dimmer second line: a literal, an expression or any reading.
  hidden secondary: slotMod.Secondary? = null
  /// A glyph before the label, as an MDI name (`mdi:power`). With `label = ""`
  /// the button is icon-only and round; a small one is a [[Pill]].
  hidden icon: String? = null
  /// The `<i>`'s whole class, a literal or a reading, as `Tile.glyph`; [[icon]]
  /// by default. An entity button reads its entity's.
  hidden glyph: (String|slotMod.Slot)? = if (icon != null) "mdi " + icons.mdiClass(icon!!) else null
  /// The pill's height, which a theme sets per size. Large fits the badge
  /// every card wears; a round icon button has its own.
  hidden size: "small"|"medium"|"large" = "large"
  /// Required: a button is what pressing it does (#106).
  hidden tapAction: tapMod.TapAction = throw(noAction("c.button"))
  inlineSurfaces = tapAction.inlineSurfaces
  /// Disables the button while it holds, ORed with whatever its tap refuses —
  /// for a reason of the button's own (a popup opener has no call to carry
  /// one): `lit.none()`.
  hidden disabled: nodes.BooleanInput? = null
  /// The entity a reading that names none reads. The HA layer sets it.
  hidden subject: String? = null
  // A navigating button is a link, which has no inert form, so `disabled` on
  // one is refused rather than quietly dropped. The value `slots` reads, since a
  // Pkl local nothing forces never runs.
  local ownDisabled: (slotMod.Slot|String)? =
    if (disabled == null || disabled == false) null
    else if (tapAction.href != null)
      throw("c.button: `disabled` needs a button, but this one navigates and "
        + "renders as a link — `disabled` is a form-control attribute. Drop "
        + "it, or give it a service tap.")
    else nodes.disabledSlot(disabled)
  slots {
    when (subject != null) {
      ["entity_id"] = subject!!
    }
    ["label"] = slotMod.labelSlot(null, label)
    when (glyph != null) {
      ["glyph"] =
        if (glyph is slotMod.Slot) (glyph as slotMod.Slot) { signal = slotMod.asAttr("class") }
        else glyph!!
      // The AUTHORED label, not the resolved one, or every entity button would
      // be round.
      when (label == "" && secondary == null) {
        ["round"] = "1"
      }
    }
    when (size == "small") { ["sizeSmall"] = "1" }
    when (size == "medium") { ["sizeMedium"] = "1" }
    when (size == "large") { ["sizeLarge"] = "1" }
    when (secondary != null) {
      ["secondary"] = slotMod.secondarySlot(secondary!!)
    }
    // `ownDisabled` is read first to force the anchor-plus-`disabled` check;
    // by the time it returns it is null on the anchor arm.
    when (ownDisabled == null && tapAction.href != null) {
      ["href"] = tapAction.href!!
      ...tapMod.currentSlots(tapAction)
    } else {
      for (k, v in tapMod.tapRoute(tapAction)) {
        [k] = v
      }
      when (ownDisabled != null) {
        ["disabled"] = ownDisabled!!
      }
      // The anchor has no splice for the guard.
      for (k, v in tapMod.guardSlots(tapAction)) {
        [k] = v
      }
    }
  }
  function label(l: String|slotMod.Expr): Button = let (self = this) (self) { label = l }
  /// `c.button("Stue", tap).secondary("Turns off 4 lights")`.
  function secondary(s: slotMod.Secondary): Button = let (self = this) (self) { secondary = s }
  function icon(i: String): Button = let (self = this) (self) { icon = i }
  /// No glyph, not even the one an entity button reads off its entity.
  function noIcon(): Button = let (self = this) (self) { glyph = null }
  /// `c.button("Stue", tap).size("medium")`.
  function size(s: "small"|"medium"|"large"): Button = let (self = this) (self) { size = s }
  function tapAction(a: tapMod.TapAction): Button = let (self = this) (self) { tapAction = a }
  /// `c.entityButton(l).active(c.isOn(l))`.
  function active(a: nodes.BooleanInput): Button = let (self = this) (self) { active = a }
  /// `c.entityButton(l).disabled(c.stateIn(l, List("open")))`.
  function disabled(r: nodes.BooleanInput): Button = let (self = this) (self) { disabled = r }
}

/// A small button sized to what it shows: a label (an emoji is text), an MDI
/// icon, or both. Round when an icon or a label of up to two characters is all
/// it shows. Its look defaults to its tap's, and a toggle's is lit while its
/// entity is on. Its cell defaults to `fh-hug`, so pills pack and wrap as
/// one group; `columns(n)` still composes on top.
///
///     c.pill(c.tap.toggle(l))                       // the tap's power icon, round
///     c.pill(c.tap.activate(kveld))                 // the scene's name
///     c.pill(c.view.navigate("under")).label("⬇️ Under")
class Pill extends nodes.ActiveNode {
  card = "pill"
  cardDef = new nodes.CardDef {
    // BeerCSS's `.chip` under the default theme, already border-box. A round
    // one is `fh-circle`, the class an icon button carries, so the two are one
    // size. Its glyph keeps the spinner's colour (`aria-busy`, which
    // any theme's spinner carries). It wears the
    // button's surface, so a run of pills and a button read as one family.
    template = """
      {{#href}}<a class="fh-chip{{#round}} fh-circle{{/round}}\(tapMod.currentClass)"\(tapMod.currentAttr) href="{{{href}}}"{{#name}} title="{{name}}" aria-label="{{name}}"{{/name}}>{{#glyph}}<i class="mdi {{glyph}}"></i>{{/glyph}}{{#label}}\(textMod.hole("label")){{/label}}</a>{{/href}}{{^href}}<button class="fh-chip{{#round}} fh-circle{{/round}}" data-on:click="\(tapMod.guardClick)\(tapMod.click)"\(tapMod.refusedAttr)\(tapMod.guard){{#name}} title="{{name}}" aria-label="{{name}}"{{/name}}{{#busyVisual}}{{#glyph}} \(tapMod.busyShapeClass){{/glyph}}{{/busyVisual}}>{{#glyph}}<i class="mdi {{glyph}}"></i>{{/glyph}}{{#label}}\(textMod.hole("label")){{/label}}</button>{{/href}}
      """
    css = """
      .fh-cell>.fh-chip{background:var(--fh-surface);color:var(--fh-text);
      border-color:transparent;border-radius:999px;box-shadow:var(--fh-raise)}
      .fh-card .fh-cell>.fh-chip{background:var(--fh-surface-alt);box-shadow:none}
      .fh-cell>.fh-chip:not([aria-busy=true])>i.mdi{color:var(--fh-accent)}
      .fh-cell.fh-active>.fh-chip{background:var(--fh-accent);color:var(--fh-on-accent)}
      .fh-cell.fh-active>.fh-chip:not([aria-busy=true])>i.mdi{color:inherit}
      """
  }
  cellClasses { "fh-hug" }
  /// See [[Button.tapAction]].
  hidden tapAction: tapMod.TapAction = throw(noAction("c.pill"))
  /// See [[Button.icon]]; the tap's by default.
  hidden icon: String? = tapAction.icon
  /// The text shown: the author's, else the tap's when there is no icon.
  hidden label: (String|slotMod.Expr)? = if (icon == null) tapAction.label else null
  // The accessible name of a pill showing no text.
  local name: String? = if (label == null) tapAction.label else null
  local round: Boolean =
    if (label == null) true else icon == null && label is String && (label as String).length <= 2
  active = tapAction.lit ?? false
  inlineSurfaces = tapAction.inlineSurfaces
  slots {
    ["label"] =
      if (label == null && icon == null)
        throw("c.pill: this tap has no look of its own; give the pill .label(…) or .icon(…)")
      else slotMod.labelSlot(null, label)
    when (icon != null) {
      ["glyph"] = icons.mdiClass(icon!!)
    }
    when (round) {
      ["round"] = "1"
    }
    when (name != null) {
      ["name"] = name!!
    }
    when (tapAction.href != null) {
      ["href"] = tapAction.href!!
      ...tapMod.currentSlots(tapAction)
    } else {
      for (k, v in tapMod.tapRoute(tapAction)) {
        [k] = v
      }
      for (k, v in tapMod.guardSlots(tapAction)) {
        [k] = v
      }
    }
  }
  function label(l: String|slotMod.Expr): Pill = let (self = this) (self) { label = l }
  function icon(i: String): Pill = let (self = this) (self) { icon = i }
  /// Text only, without the tap's icon: `c.pill(c.tap.toggle(k)).label("Kveld").noIcon()`.
  function noIcon(): Pill = let (self = this) (self) { icon = null }
  function tapAction(a: tapMod.TapAction): Pill = let (self = this) (self) { tapAction = a }
  /// `c.pill(c.tap.activate(s)).active(latest.eq(s))`, where
  /// `latest = q.from(scenes).orderBy(q.desc(q.stateProp)).first()`.
  function active(a: nodes.BooleanInput): Pill = let (self = this) (self) { active = a }
}

/// `c.button("Close", c.view.closePopup())`.
function button(l: String, a: tapMod.TapAction): Button = new Button { label = l; tapAction = a }
/// `c.pill(c.tap.toggle(l))`, `c.pill(c.view.navigate("under")).label("Under")`.
const function pill(a: tapMod.TapAction): Pill = new Pill { tapAction = a }
