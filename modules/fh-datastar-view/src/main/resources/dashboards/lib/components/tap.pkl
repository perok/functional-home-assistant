/// What a click does in Home Assistant — `c.tap`. Every verb names what it acts
/// on, after HA's `tap_action` variants, so a tap means the same on any card:
///
///     c.button("Kjøkken", c.tap.toggle(dump.entities.kjokken))
///     c.button("Stue av", c.tap.lights.off(dump.areas.stue))
///     c.pill(c.tap.activate(dump.entities.kveld))
///     c.button("Stue", c.tap(dump.entities.stue))
///
/// What only changes the screen — more-info, popups, navigation — is `c.view`.
/// A dashboard-tier module because [[default]] can be more-info, a component;
/// the tap kit a component author builds on is `core/tap.pkl`.
module components.tap

import "../core/tap.pkl" as core
import "../core/slot.pkl" as slotMod
import "../hass.pkl"
import "../hass/lock.pkl" as hassLock
import "../query.pkl" as q
import "moreinfo.pkl" as moreinfo

/// Toggle `e`: its domain's own service where `hass/actions.pkl` names one, HA's
/// domain-dispatching `homeassistant/toggle` otherwise.
function toggle(e: hass.Entity): core.Call = (core.toggle(e)) { icon = "mdi:power"; label = "Toggle"; lit = slotMod.activeOf(e) }

/// What a tap on an entity card does unless told otherwise: its domain's
/// service where it has one, more-info where it does not or the domain is a
/// lock (ADR 0016). `c.tap(e)` is the same.
function default(e: hass.Entity): core.TapAction =
  (moreinfo.defaultTap(e)) { label = e.friendly_name ?? e.entity_id }

/// Fire `x` through its own domain's service: `scene/turn_on`, `script/turn_on`,
/// `button/press` or `input_button/press`. `.with("transition", "2")` fades a
/// scene in.
function activate(x: hass.Activatable): core.Call =
  (core.byDomain(x)!!) { label = x.friendly_name ?? x.entity_id }

/// `service` on `target`, for any service with no typed verb here. Carry one
/// value with `.with(key, value)`:
/// `c.tap.call("light/turn_on", l).with("effect", "colorloop")`.
///
/// An area or floor reaches every entity HA puts there when the call runs, so
/// a light added to the room later is included (issue #389). A set reaches the
/// members present at the press, in one call; its `.count()` in a label reads
/// the same members:
///
///     local lit = q.from(hass.lights(dump.areas.stue.all)).where(q.eq(q.stateProp, "on"))
///     c.button("Stue av", c.tap.call("light/turn_off", lit))
///       .secondary(c.expr(#"string(lit) + ' on'"#))
///       .expressionValues(new Mapping { ["lit"] = lit.count() })
function call(service: String, target: core.Target|q.EntitySet): core.Call =
  core.call(service, lowered(target))

const local function lowered(t: core.Target|q.EntitySet): core.Target =
  if (t is q.EntitySet) t.count() else t

/// `c.tap.lights.off(dump.areas.stue)` — on a light, a room, a floor or a set
/// of lights ([[call]]).
class Lights {
  function on(scope: hass.LightEntity|hass.Area|hass.Floor|q.EntitySet): core.Call =
    (core.call("light/turn_on", lowered(scope))) { icon = "mdi:lightbulb-on"; label = "On" }
  function off(scope: hass.LightEntity|hass.Area|hass.Floor|q.EntitySet): core.Call =
    (core.call("light/turn_off", lowered(scope))) { icon = "mdi:lightbulb-off"; label = "Off" }
  /// HA toggles each light on its own: in a half-lit room the lit ones go off
  /// and the others come on.
  function toggle(scope: hass.LightEntity|hass.Area|hass.Floor|q.EntitySet): core.Call =
    (core.call("light/toggle", lowered(scope))) { icon = "mdi:lightbulb"; label = "Toggle"; lit = if (scope is hass.LightEntity) slotMod.activeOf(scope) else null }
}

hidden lights: Lights = new {}

/// `c.tap.locks.lock(l)`. Each is refused where HA's own button is disabled
/// (`hass/lock.pkl`), by every card that sends it. [[toggle]] picks `lock` or
/// `unlock` from the state instead.
class Locks {
  function lock(l: hass.LockEntity): core.Call =
    (core.call("lock/lock", l)) { disabledWhile = hassLock.CANNOT_LOCK.toListing(); icon = "mdi:lock"; label = "Lock" }
  function unlock(l: hass.LockEntity): core.Call =
    (core.call("lock/unlock", l)) { disabledWhile = hassLock.CANNOT_UNLOCK.toListing(); icon = "mdi:lock-open-variant"; label = "Unlock" }
  /// HA's `lock/open`: the door opens, not just unlocks. `open` itself is a Pkl
  /// keyword. Refused in HA's `canOpen` states (`hass/lock.pkl`) by every card
  /// that sends it.
  function openLatch(l: hass.LockEntity): core.Call =
    (core.call("lock/open", l)) { disabledWhile = hassLock.CANNOT_OPEN.toListing(); icon = "mdi:door-open"; label = "Open" }
}

hidden locks: Locks = new {}
