/// A value slider that knows nothing about Home Assistant: a track over a
/// range, a label line with an optional badge and readout, buttons at the right
/// of the line, and optional member rows under it. HA's slider is
/// `components/slider.pkl`'s `EntitySlider`, which only fills these.
module components.base.slider

import "../../core/node.pkl" as nodes
import "../../core/slot.pkl" as slotMod
import "../../core/tap.pkl" as tapMod
import "../../core/text.pkl" as textMod
import "button.pkl" as buttonMod

// The dragged position as a percentage of the card's own range, in JS — the
// client-side twin of a percent reading, spliced into the template so the
// range arrives through the `min`/`max` SLOTS: `cardDef` is shared by every
// slider on the page, so it cannot read one slider's range.
//
// `evt.target.value` rather than the bound signal, because `data-bind` listens
// for `input` on this same element and the earlier-registered listener wins —
// off the event there is no ordering to get wrong.
const local function posFrom(v: String): String =
  "((\(v) - {{min}}) * 100 / ({{max}} - {{min}}))"

const local dragPos: String = posFrom("evt.target.value")

/// The client-owned position: what the control is SHOWING, which during a
/// gesture is the finger and at rest is whatever the server last said.
///
/// It has to be a second signal rather than the value slot itself, and the
/// reason is not tidiness: `data-on-signal-patch` fires on every write to a
/// name, local ones included, so a card cannot tell the SERVER's write from
/// its own drag on one signal. "Where the device is" and "where the control
/// is" therefore need two names to be distinguishable at all (ADR 0025).
///
/// The corollary is what makes this a fix rather than a refactor: while the
/// drag wrote the server's own slot, the session's `holds` — what the server
/// believes this DOM has — was false, so a commit that FAILED produced no
/// correcting frame (the server's value never moved) and the slider kept
/// showing a position the device never took.
const local slideSig: String = "_{{id}}__slide"

/// Adopt what the device says: confirmation and CORRECTION are the same line,
/// so HA clamping a brightness needs no case of its own. Filtered to the value
/// signal, which only the server writes now.
const local adoptCommitted: String =
  #"data-on-signal-patch-filter="{include:/^\#(slotMod.signalRef("value"))$/}" data-on-signal-patch="$\#(slideSig) = $\#(slotMod.signalRef("value"))""#

// The same statement as [[adoptCommitted]] — "show what the device last said"
// — reached when nothing is coming. `fill` and `state` are RECOMPUTED rather
// than shadowed, because they are functions of the position: restoring the
// position restores them, and the formula is the one the drag already uses.
//
// Sourced from the committed signal, not from the just-assigned `slideSig`, so
// the three writes have no ordering between them. Comma-separated because this
// splices inside a `&&`, where a `;` would not parse.
const local rollbackToCommitted: String =
  let (committed = "$" + slotMod.signalRef("value"))
    "$\(slideSig) = \(committed), " +
      "$\(slotMod.signalRef("fill")) = (100 - \(posFrom(committed))) + '%'" +
      "{{#dragPercent}}, $\(slotMod.signalRef("state")) = " +
      "Math.round(\(posFrom(committed))) + ' %'{{/dragPercent}}"

/// The two ways an ask ends with no commit coming (ADR 0025), both answered by
/// [[rollbackToCommitted]]: the stream the commit would have ridden is DOWN
/// (`_sse`, the shell's own counter), or the server REFUSED — which it says by
/// patching this node's error signal, since a refused action answers 200
/// carrying signals rather than a status (ADR 0024). Neither is a timeout.
///
/// They are two attributes on two ELEMENTS, and that is not cosmetic. The
/// refusal half reads a signal, so it would want the input's one
/// `data-on-signal-patch` — already spent on [[adoptCommitted]] — and merging
/// them breaks the slider: `failedOn` clears the error signal when the NEXT
/// commit starts, so a merged handler would take its else-branch mid-flight and
/// snap the thumb back to the committed value under the finger that just moved
/// it. On the track wrapper the two never meet.
const local restoreOnDeadStream: String =
  #"data-effect="$_sse > 0 && (\#(rollbackToCommitted))""#

const local restoreOnRefusal: String =
  #"data-on-signal-patch-filter="{include:/^\#(tapMod.errorSig)$/}" data-on-signal-patch="$\#(tapMod.errorSig) && (\#(rollbackToCommitted))""#

/// The slider's own row — label, readout, track, action — as a NODE.
///
/// It is a node rather than a part of [[Slider]] because only a LEAF can be
/// patched, and the head sits beside the members: they are two regions of one
/// card. So a brightness change re-renders this and never the rows under it.
///
/// Built by [[Slider]], never by an author: it takes the slots the slider
/// already computed, so its fifteen values are derived in exactly one place.
class SliderHead extends nodes.Node {
  card = "sliderHead"
  // `display:contents`, so the backend's own `.fh-cell` wrapper does not become
  // a box between `.slider-card` and this row — and so the group's grid rules
  // can still name the chain that distinguishes the MASTER's head from its
  // members' (see `sliderCss`).
  cellClasses { "slider-head-cell" }
  cardDef = new nodes.CardDef {
    // TWO regions, and between them they are everything on this row that is not
    // a signal or a literal.
    //
    // `text` holds the label and its second line — the ONLY bytes here that
    // move. Everything else that changes on this card is a signal (ADR 0017),
    // which is what lets the head be structure at all: a signal never becomes
    // bytes in this element, so it does not need this element patched.
    //
    // A rename now repaints a `<strong>`, where it used to repaint the whole
    // row — track, badge and all.
    regions = new Mapping {
      ["text"] = new nodes.Region {}
      ["actions"] = new nodes.Region {}
    }
    template = """
      <div class="slider-body">
        <div class="slider-head">
          {{#icon}}<div class="slider-icon"{{#busyVisual}} \(tapMod.busyClassChange) \(tapMod.busyShapeClassChange){{/busyVisual}}><i class="mdi {{icon}}"></i></div>{{/icon}}
          {{#text}}{{{html}}}{{/text}}
          \(slotMod.ifSlot("state"))<span class="fh-reading" \(slotMod.signalBind("state"))>{{state}}</span>\(slotMod.endIfSlot("state"))
          <div class="slider-actions">{{#actions}}{{{html}}}{{/actions}}</div>
        </div>
        <div class="slider max" style="--_start: 0%;--_end: {{fill}}" \(slotMod.signalBind("fill")) \(restoreOnRefusal){{#busyVisual}} \(tapMod.busyClassChange){{/busyVisual}}{{^busyVisual}}\(tapMod.tapDisabledClass){{/busyVisual}}>
          {{^toggle}}<input type="range" min="{{min}}" max="{{max}}" value="{{value}}"
            \(slotMod.signalBind("value"))
            data-signals__ifmissing="{ \(slideSig): '{{value}}' }"
            data-bind="\(slideSig)"
            \(adoptCommitted)
            \(restoreOnDeadStream)
            \(tapMod.busyAttrsChange)
            data-on:input="$\(slotMod.signalRef("fill")) = (100 - \(dragPos)) + '%'{{#dragPercent}}; $\(slotMod.signalRef("state")) = Math.round(\(dragPos)) + ' %'{{/dragPercent}}"
            data-on:change="\(tapMod.refusalGuard)\(tapMod.busyGuardChange)@post('sse/call/{{dashboardSlug}}/{{{service}}}/{{targetKind}}/{{targetId}}/{{dataKey}}/' + $\(slideSig) + '?node={{id}}', \(tapMod.noSignals))" />{{/toggle}}
          <span style="background:{{fillColor}}" \(slotMod.signalBind("fillColor"))></span>
          {{#toggle}}<button type="button" class="slider-toggle" aria-label="{{label}}"
            \(slotMod.signalBind("value"))
            data-on:click="\(tapMod.busyGuardChange)\(tapMod.click)"
            \(tapMod.busyAttrsChange)></button>{{/toggle}}
        </div>
      </div>
      """
    // `state` is NOT declared: a grouped head omits the slot entirely (see
    // [[Slider.reading]]), and a declared slot is one every node of the card
    // must have.
    //
    // `label` stays declared even though the visible label moved into `text`:
    // the toggle variant's whole-track button needs an `aria-label`, and that
    // is drawn when the card is drawn. It is an `onRender` slot on this node
    // for exactly that reason — read every render, never a reason to have one,
    // which is what an accessible name on static markup wants. (`once` would
    // also be legal on structure and is wrong here: a rename would never
    // reach the label at all.)
    slots { "label"; "value"; "service"; "targetKind"; "targetId"; "min"; "max" }
  }
}

/// The label and its second line — the head's only moving BYTES, so its own
/// node and its own patch target.
///
/// Split out when the head became structure ([[SliderHead]]): a card holding
/// regions is never patched, and these two are the values that need patching.
/// The upside was not the point but is real — a friendly-name change now
/// re-renders a `<strong>`, not a whole slider row.
///
/// `display:contents` on its cell, so `strong` and `.fh-sub` stay layout
/// children of `.slider-head` and the group's grid still places them.
class SliderText extends nodes.Node {
  card = "sliderText"
  cellClasses { "slider-text" }
  cardDef = new nodes.CardDef {
    template = """
      <strong class="\(textMod.BOX)">\(textMod.run("label"))</strong>\(slotMod.ifSlot("secondary"))<span class="fh-sub \(textMod.BOX)">\(textMod.liveRun("secondary"))</span>\(slotMod.endIfSlot("secondary"))
      """
    // `secondary` is optional (a plain row carries none), so it is not
    // declared. Guarded by PRESENCE, not by its value: a live one is a signal,
    // blank in the patch form, and a value guard would delete its element.
    slots { "label" }
  }
}

/// The slider. Its inputs are named for what they ARE on the card; the card
/// decides how each is carried. `position`, `fill` and `reading` are three
/// readings rather than one the card derives the others from, because a
/// transform is a CEL string or a Simple shape and neither composes.
///
/// Give it MEMBERS and the same card is a GROUP: the slider becomes the head
/// (the group light, the cover group) and the members are the rows it
/// stands for, stacked inside it with the master's fill painted across the
/// whole card behind them — one control with its parts shown, not a titled
/// list.
///
///   (c.entitySlider(dump.entities.light_lys)) {
///     icon = "mdi:lightbulb-group"
///     secondary = c.exprOf(dump.entities.sensor_kitchen_temp, #"state + ' °C'"#)
///     tapAction = c.tap.toggle(dump.entities.light_lys)
///     members { c.entitySlider(a).readout("percent") c.entitySlider(b).readout("percent") }
///   }
///
/// One card rather than a separate group card, because the members are
/// ORDINARY nodes: a member can be another grouped slider (nesting works by
/// construction), an [[EntityCard]], or a [[DynamicGroup]] of everything in an
/// area, and each keeps its own entity, its own domain config and its own live
/// patch. `EntitySlider.withSubSliders` is the chain form of the common "a master
/// and its member entities" case.
///
/// The head and the members are two REGIONS of the card, so a state change on
/// the master repaints the head alone and never the rows (ADR 0012) — the
/// reason this is a structural card even when it holds nothing.
///
/// The registry names stay `slider`, `sliderHead` and `sliderText`, the names
/// this card has always had on the wire.
open class Slider extends nodes.Node {
  card = "slider"
  /// The label line's text, a literal or a reading.
  hidden title: String|slotMod.Slot
  /// A second line under the label — on an entity slider, often an
  /// [[slotMod.Expr]] naming a DIFFERENT entity (the room's temperature beside
  /// its lights). Null renders none.
  hidden secondary: slotMod.Secondary? = null
  /// The badge's MDI class (`mdi-lightbulb`). Null renders no badge.
  hidden glyph: String? = null
  /// The span of the track. The input carries them as its `min`/`max`.
  hidden rangeMin: Number
  hidden rangeMax: Number
  /// WHERE THE DEVICE IS, as the input's number. Server-written, and never
  /// touched by this card: the drag moves [[slideSig]] and adopts this.
  hidden position: slotMod.Slot
  /// The track fill, as the `--_end` length (distance from the RIGHT edge, per
  /// BeerCSS's span/clip-path convention). The value carries its own `%`.
  hidden fill: slotMod.Slot
  /// The fill's colour, where it can move. Null paints [[fillDefault]], read
  /// once: a constant is neither a signal nor a re-read.
  hidden fillColor: slotMod.Slot? = null
  hidden fillDefault: String = "currentcolor"
  /// The readout beside the label. Null renders none.
  hidden reading: slotMod.Slot? = null
  /// Whether a DRAG also moves the readout. Only a percentage is a function of
  /// the position.
  hidden readingFollowsDrag: Boolean = false
  /// What a release posts: a call with a key and no value, which the drag
  /// supplies.
  hidden commit: tapMod.Call? = null
  /// Set, the track is one button posting this, and there is no range input.
  hidden press: tapMod.TapAction? = null
  /// Whether this slider's busy LOOK shows at all — the commit's immediate
  /// `fh-disabled` dim on the track and badge, its delayed spinner on the
  /// badge, AND the power button's. The GUARD and the
  /// input freeze (`data-attr:disabled`) are signal-driven and stay either way;
  /// false only hides the visuals. The power button additionally honours its
  /// OWN tap's `TapAction.busyVisual`, so the two knobs compose.
  hidden busyVisual: Boolean = true
  /// The buttons at the right of the head, left to right (#151), after
  /// [[leadingActions]]. Empty renders none, which is what a plain row has.
  hidden actions: Listing<buttonMod.Button> = new {}
  /// Buttons a subclass puts first, so an author's [[actions]] add to them
  /// rather than replace them.
  hidden leadingActions: Listing<buttonMod.Button> = new {}
  /// The rows this slider stands for. Named `members` rather than `children`
  /// because `children` now says WHICH REGION on every node, and this card has
  /// two — the head is one, these are the other.
  hidden members: Listing<nodes.LayoutNode> = new {}
  /// The entity a reading that names none reads — see `Button.subject`.
  hidden subject: String? = null
  // Everything the ROW shows, handed to [[SliderHead]]: the head is a card that
  // only knows how to draw them.
  hidden headSlots: Mapping<String, slotMod.Slot|String> = new {
    when (subject != null) {
      ["entity_id"] = subject!!
    }
    // `onRender`, not live: the visible label is [[SliderText]]'s now, and what
    // is left of it here is the toggle variant's `aria-label`. The head holds
    // regions, so it is never patched — an `onRender` read is right whenever
    // the card IS drawn and never asks for a drawing of its own, which is
    // exactly what an accessible name on static markup wants.
    ["label"] = if (title is slotMod.Slot) (title as slotMod.Slot) { reads = "onRender" } else title
    when (glyph != null) {
      ["icon"] = glyph!!
    }
    // The commit's busy LOOK (the wrapper + badge `fh-disabled` bindings) is
    // gated on the card's own `busyVisual`. Each head action carries its own
    // now — see `sliderAction`.
    when (busyVisual) {
      ["busyVisual"] = "1"
    }
    // Omitted entirely when there is no readout, which the template reads as
    // the slot's ABSENCE rather than its emptiness — a signal slot's value is
    // blank in the patch form, so a section over the value itself dropped the
    // span and its binding on the first patch and never restored them.
    // A TEXT signal slot (ADR 0017): the readout is one of the four things on
    // this card that move with the position, and all four are signals — see
    // `value`/`fill`/`fillColor` below. Between them they are the whole reason a
    // slider used to re-render on every tick.
    when (reading != null) {
      ["state"] = (reading!!) { signal = slotMod.asText }
    }
    // `data-attr:value` is a PLACEMENT, not a binding that does anything: this
    // signal is read by [[adoptCommitted]] and [[rollbackToCommitted]], and it
    // has no DOM home of its own. ADR 0017 requires every signal slot to place
    // its bind somewhere, so it lands on the attribute the value would
    // naturally have had — where `data-bind` beats it from the first pass and
    // it is inert for the life of the page.
    //
    // Measured, and contradicting what the spec alone suggested (the dirty-value
    // flag is real, but `data-bind` sets `.value` through the IDL before any
    // user touches it, so the attribute never positions the thumb even once):
    // `DatastarMorphContractSuite`, "data-bind makes a co-located
    // data-attr:value inert from the start". The live position is [[slideSig]].
    ["value"] = (position) { signal = slotMod.asAttr("value") }
    // A STYLE signal slot bound to `--_end`, so the fill follows the position
    // without the card being re-rendered. The binding reads the signal bare, so
    // the unit is decided in the transform and nowhere else.
    ["fill"] = (fill) { signal = slotMod.asStyle("--_end") }
    // The fill COLOUR, on the `<span>`'s own style attribute — NOT the
    // wrapper's, which beer.min.js overwrites wholesale (`style.cssText = …`)
    // every time it repaints the fill. Bound to the span's OWN `background`,
    // which is also why a moving one has to be a signal: leaving it as bytes
    // would re-render the card on exactly the ticks the other three avoid.
    ["fillColor"] =
      if (fillColor != null)
        (fillColor!!) {
          default = fillDefault
          bypassUnavailable = false
          signal = slotMod.asStyle("background")
          reads = "live"
        }
      else new slotMod.Slot {
        transform = "''"
        default = fillDefault
        bypassUnavailable = false
        reads = "once"
      }
    // A section flag, not the expression itself: the expression names signals,
    // and a signal's name is a template var the renderer fills.
    when (readingFollowsDrag) {
      ["dragPercent"] = "1"
    }
    // The press variant: no range input, the track itself is the button. A
    // section flag plus the click expression, because `cardDef` is one template
    // shared by every slider on the page — the shape has to travel as a slot.
    // ONE route per row: the press's where the track is a button, the
    // commit's where it is a range. Both carry the tap's refusal, which
    // disables the control (`busyAttrsChange`) and dims the track.
    when (press != null) {
      ["toggle"] = "1"
    }
    for (k, v in tapMod.tapRoute(press ?? commit ?? throw("A slider needs a commit or a press."))) {
      [k] = v
    }
    ["min"] = "\(rangeMin)"
    ["max"] = "\(rangeMax)"
  }
  // What [[SliderText]] draws: the label and its optional second line, the two
  // values on this row that move as BYTES. Live here, unlike the head's own
  // `label` — this node IS a patch target, which is why they were split out.
  hidden textSlots: Mapping<String, slotMod.Slot|String> = new {
    when (subject != null) {
      ["entity_id"] = subject!!
    }
    ["label"] = title
    when (secondary != null) {
      ["secondary"] = slotMod.secondarySlot(secondary!!)
    }
  }
  // The one difference the card's markup takes from having members: the group
  // modifier class. Everything else the two shapes need is an optional piece a
  // plain row does not carry anyway.
  slots {
    when (!members.isEmpty) {
      ["group"] = "slider-group"
    }
  }
  children = new Mapping {
    ["head"] = new Listing {
      (new SliderHead {}) {
        slots = headSlots
        children = new Mapping {
          ["text"] = new Listing { (new SliderText {}) { slots = textSlots } }
          ["actions"] = new Listing { ...leadingActions ...actions }
        }
      }
    }
    ["children"] = members
  }

  function actions(xs: List<buttonMod.Button>): Slider =
    let (self = this) (self) { actions = xs.toListing() }
  function busyVisual(b: Boolean): Slider = let (self = this) (self) { busyVisual = b }
  // The range input rides inside BeerCSS's slider markup (`.slider` wrapper +
  // trailing `<span>` = the painted MD3 track, `max` = full card width; NO
  // `.tooltip` — its value text bled through behind the track, and the live
  // value already shows in the head line). The FILL is OURS, never BeerCSS's:
  // its own fill is an inline style its JS writes on `input`, which a Datastar
  // morph wipes — and with the vars defaulting to 0% the track then snaps to
  // fully-filled. The `fill` slot owns `--_end` instead, baked into the style
  // attribute for the first paint and bound as a signal after it, with
  // `data-on:input` keeping it under the thumb mid-gesture. The label line is a
  // `.slider-head` class contract (both themes style it) — NOT a `<header>`
  // (BeerCSS styles header as a 4rem app-bar grid, which swallowed the text)
  // and NOT BeerCSS `.row`/`.max` (inline-size:100% squeezes the state span
  // into per-character wrapping).
  //
  // A drag is LIVE client-side (`data-on:input`) but only COMMITS on release
  // (`data-on:change` → the value POST), so a drag back on while that POST is
  // in flight must not fire a second commit. `\(tapMod.busyAttrsChange)`
  // (indicator + `data-attr:disabled`) and `\(tapMod.busyGuardChange)` are the
  // same busy pieces the power button uses, under the input's own
  // `_<id>__busy_change` signal — see `tap.pkl` for why the name is separate
  // and why disabling is safe.
  //
  // A [[press]] row drops the range input and puts a full-bleed button in
  // its place, LAST so it sits over the painted fill without either of them
  // needing a stacking rule. It reuses the input's own `_<id>__busy_change`
  // signal rather than a tap's `_<id>__busy`: it stands exactly where the commit
  // did, and the power button may still be holding the other name (the
  // one-guarded-element-per-node rule in ADR 0019).
  //
  // TWO regions: the head is a [[SliderHead]] node, the members are the author's
  // rows. That is what keeps a brightness change off the rows — a patch targets
  // the head, and the members are not inside it (ADR 0012). This card is
  // STRUCTURE, so it is never itself a patch target.
  //
  // A member-less slider still renders an empty `.slider-members` the theme
  // hides, because a card is one shape and its optional pieces (icon, second
  // line, button, members) are absent rather than different.
  cardDef = new nodes.CardDef {
    regions = new Mapping {
      ["head"] = new nodes.Region {}
      [nodes.defaultRegion] = new nodes.Region {}
    }
    template = """
      <article class="card slider-card{{#group}} {{group}}{{/group}}">{{#head}}{{{html}}}{{/head}}<div class="slider-members">{{#children}}{{{html}}}{{/children}}</div></article>
      """
    css = sliderCss
  }
}

// The slider's own structure — the largest card in the library and the one that
// most needs its CSS next to its markup. Colour goes through the `--fh-*`
// variables (`core/css.pkl`); what stays with the theme is paint and BeerCSS's
// private knobs (`--_padding`, `.shape`), because those name things this card
// does not emit.
//
// `.slider.max` IS emitted here (BeerCSS's slider markup — wrapper + trailing
// `<span>` painted as the MD3 track), so the rules keyed on it are this card's
// even though the class name is the framework's.
const local sliderCss: String = """
  /* The label line: label left, live state right. It is PAINTED OVER the track
     (`.slider.max` is an absolutely-positioned overlay filling the card), so it
     must not take the pointer — without this the label and the live value are
     two dead strips the user has to aim around.
     The readout is pushed right rather than the line being `space-between`,
     because the line has THREE items once a slider carries its entity's icon
     badge — and "spread evenly" would centre the label between the badge and
     the readout instead of keeping it next to what it names.
     An explicit line-height, because `normal` is the FONT's own figure: the line
     box then changes size with whatever font resolved, which is half of how the
     same markup ends up looking different per engine. 1.5 is what the current
     stack already computed, so this pins today's rhythm rather than changing it.
     The label and its second line are text BOXES (`core/text.pkl`); the readout
     deliberately is not — it is a level or an on/off, not prose to clip.
     It does RESERVE its width, though, and that is the point of
     `--fh-readout-size`: shrink-wrapped, the box was as wide as whatever it
     currently reads, so a drag from `9 %` to `100 %` widened it and slid its
     left edge — and the label, which caps against that edge, re-clipped on
     every frame. Reserving the widest ordinary reading and aligning to the END
     pins the edge, so the number changes and nothing moves. A LONGER reading
     (`unavailable`) still gets its room; the floor only stops the box from
     collapsing below it. */
  /* `min-inline-size:0` is what keeps the readout on the card. A member row lays
     the head out as a GRID item (`.slider-members .card` below), and a grid
     item's automatic minimum is its min-content width — which `nowrap` text
     makes the WHOLE label, so the row grew past the card, `overflow:hidden`
     clipped it, and a long name pushed the reading off the right edge entirely.
     Zero lets the label shrink and clip as it does on a plain row, where the
     head is an ordinary block and never had the problem. */
  .slider-head{display:flex;gap:.75rem;align-items:center;padding:.5rem;line-height:1.5;z-index:3;pointer-events:none;min-inline-size:0}
  .slider-head>.fh-reading{margin-inline-start:auto;flex:0 0 auto;
  min-inline-size:var(--fh-readout-size,3.25rem);text-align:end}
  /* The edge of the control, drawn OVER the fill and never under it. Without it
     a nearly-full slider has no visible end: the fill runs to the card's own
     boundary and, on a bright light against a light palette, the last few
     percent are the same brightness as the page behind them — so the row reads
     as "some colour ending somewhere". The ring is what says where.
     A pseudo-element rather than the card's own `box-shadow:inset`, which is
     painted BEHIND the descendants and therefore behind the fill — that is the
     rule this replaces, and it was invisible on exactly the rows (a member near
     100 %) it was added for. `border-radius:inherit` takes the card's, since
     that is the box it traces. */
  .slider-card{position:relative}
  .slider-card:after{content:"";position:absolute;inset:0;border-radius:inherit;
  box-shadow:inset 0 0 0 .0625rem var(--fh-border);pointer-events:none;z-index:4}
  /* A slider is dragged sideways, so say so: the grab hand reads as "pick this
     up and move it anywhere". */
  .slider.max,.slider.max>input{cursor:ew-resize}
  .slider.max>input::-webkit-slider-thumb{cursor:ew-resize}
  .slider.max>input::-moz-range-thumb{cursor:ew-resize}
  /* The loading commit overrides the drag affordance once a slider's value POST
     has held past the loading delay: the wrapper and the input each set their own
     ew-resize, so `.fh-loading` alone (which matches the input only by
     inheritance) never beats them. Pairs with `.fh-disabled`'s dim (which lands
     instantly, before this), so the whole control says "wait" together. */
  .slider.max.fh-loading,.slider.max.fh-loading>input{cursor:progress}
  .slider.max.fh-loading>input::-webkit-slider-thumb{cursor:progress}
  .slider.max.fh-loading>input::-moz-range-thumb{cursor:progress}
  /* Slide the fill to a state change instead of snapping. `inset` is what
     BeerCSS derives from `--_start`/`--_end`, so animating it covers every
     writer of those props alike; `background` covers a light changing colour.
     Suppressed while the slider is being dragged — there the fill must track the
     thumb frame by frame, and a transition reads as lag. :active alone is not
     enough: a pointer drag ends with the input still focused, and the echoed
     state should land where the user let go. */
  .slider.max>span:not([class]){transition:inset .3s cubic-bezier(.2,0,0,1),background .3s linear}
  .slider.max:is(:active,:focus-within,.fh-armed)>span:not([class]){transition:none}
  /* Touch: the CSS half of the axis-intent gate (theme.pkl's sliderHoldScript
     owns the timing). The range input is inert so a swipe that starts on a card
     scrolls the list instead of setting a value, and `pan-y` keeps that scroll
     native; the script drives the value itself — on a drag once armed, and on a
     TAP, which an inert input would otherwise swallow entirely. */
  @media (pointer:coarse){
  .slider.max{touch-action:pan-y}
  .slider.max>input{pointer-events:none}
  .slider.max.fh-armed{box-shadow:inset 0 0 0 .125rem var(--fh-accent)}
  }
  /* The toggle variant's whole-track button (a light that only switches). It is
     invisible on purpose — the fill IS the feedback — so every one of a
     framework's button paints has to be undone, `all:unset` being unavailable
     here because it would also drop the box the click needs. `cursor:pointer`
     rather than the `ew-resize` above, which is the point: this row is pressed,
     not dragged.
     `block-size:auto` is load-bearing, not tidiness: BeerCSS gives every
     `button` a fixed `2.5rem` height, which OVER-CONSTRAINS `inset:0` — the
     browser keeps the top and the height and throws the bottom away, so the
     button was a 40 px strip at the top of a 64 px card. Invisible in itself,
     except that a hover paints the framework's overlay across exactly that box:
     the press target sat above the middle of the row it belongs to. */
  .slider-toggle{position:absolute;inset:0;block-size:auto;inline-size:auto;
  z-index:1;margin:0;padding:0;border:0;
  background:none;box-shadow:none;color:inherit;font:inherit;border-radius:inherit;
  appearance:none;-webkit-appearance:none;cursor:pointer}
  /* The card's two structural wrappers, both boxless. `.slider-body` is one so
     the head and the track are laid out by the CARD, exactly as they were when
     this was a single element rather than a node holding regions. */
  .slider-body{display:contents}
  /* The head is a NODE, so the backend wraps it in an id'd `.fh-cell`. That
     wrapper must not become a box between the card and the row — and it must
     stay IN the group chain below, which is what tells the master's head from
     its members' (theirs sit under `.slider-members` and their own card). */
  .slider-head-cell{display:contents}
  .slider-members:empty{display:none}
  /* A slider that HOLDS sliders. The master's fill is the whole card's
     background, painted BEHIND the member rows, which is what makes the group
     read as one control rather than a titled list — `.slider.max` already fills
     the card, so the group only has to keep the rows on top of it and the drag
     surface off them.

     The head is the same markup a plain row has: the badge, the second line and
     the button are pieces a plain row simply does not carry, so only the
     arrangement changes — a two-row grid with the badge and the button spanning
     both rows. */
  .slider-group{overflow:hidden}
  /* Scoped through `.slider-body` on purpose: `display:contents` removes its BOX,
     not its place in the DOM, so it still has to appear in a selector — and every
     one of these rules must miss the members' own heads and tracks, which are
     `.slider-head`/`.slider.max` too.
     Rows are DECLARED, not implicit, so the label and its second line are one
     block of ordinary text: an implicit grid sizes its rows to whatever spans
     them, and the badge (taller than two lines together) pushed the two lines
     apart to fill itself. Declaring them makes the text keep its own rhythm and
     the badge centre against the pair. Same reason the spans say `1/3` rather
     than `1/-1`: `-1` is the last line of the EXPLICIT grid, which is only well
     defined now that there is one. */
  .slider-group>.slider-head-cell>.slider-body>.slider-head{display:grid;grid-template-columns:auto 1fr auto auto;
  grid-template-rows:auto auto;align-items:center;align-content:center;
  min-block-size:4.5rem;box-sizing:border-box;gap:0 .75rem}
  .slider-group>.slider-head-cell>.slider-body>.slider-head>.slider-text>strong{grid-column:2;grid-row:1}
  .slider-group>.slider-head-cell>.slider-body>.slider-head>.slider-text>.fh-sub{grid-column:2;grid-row:2}
  .slider-group>.slider-head-cell>.slider-body>.slider-head>.slider-icon{grid-row:1/3}
  .slider-group>.slider-head-cell>.slider-body>.slider-head>.fh-reading{grid-column:3;grid-row:1/3}
  .slider-group>.slider-head-cell>.slider-body>.slider-head>.slider-actions{grid-column:4;grid-row:1/3}
  /* `flex:0 0 auto` because the badge is a CIRCLE with a fixed glyph in it: as a
     shrinkable flex item it gave width away to a long label (2rem measured down
     to 1.5rem at a phone's 360px), which turns the circle into an ellipse and
     leaves the 1.25rem glyph painting over its own edge. The label is the thing
     with somewhere to go — it clips. */
  .slider-icon{display:flex;align-items:center;justify-content:center;
  flex:0 0 auto;inline-size:2rem;block-size:2rem;border-radius:50%;
  background:var(--fh-surface-alt);color:var(--fh-accent)}
  .slider-icon>i{font-size:1.25rem}
  /* Bigger on a group's head alone, where the badge reads as a card header
     rather than a row's icon. */
  .slider-group>.slider-head-cell>.slider-body>.slider-head>.slider-icon{inline-size:2.75rem;block-size:2.75rem}
  .slider-group>.slider-head-cell>.slider-body>.slider-head>.slider-icon>i{font-size:1.5rem}
  /* The head's two node regions. Both wrappers are boxless for the same reason
     `.slider-head-cell` is: the backend gives every node an `.fh-cell`, and
     neither of these should become a box between the row and what it holds —
     the group's grid places `strong`, `.fh-sub` and the button strip
     itself. The actions are ordinary `c.iconButton`s, so the rule names the
     STRIP's cells rather than a class only this card's buttons carry. */
  .slider-text,.slider-actions>.fh-cell{display:contents}
  /* The button strip. It takes the pointer back from `.slider-head`'s
     `pointer-events:none` — the buttons are the only things in the row that ARE
     controls — and `:empty` removes it on a slider with no actions, which is
     every plain row. A card is ONE shape: its optional pieces are absent, not
     different (same reason `.slider-members:empty` is here), and without the
     `:empty` rule the flex gap and the group's fourth grid column would hold
     space for nothing. */
  .slider-actions{display:flex;align-items:center;gap:.25rem;pointer-events:auto}
  .slider-actions:empty{display:none}
  /* The head's buttons are the shared round icon button, so this paints them by
     POSITION rather than by a class of their own — the card says how a control
     in its head looks, which is the same thing `.slider-members .card` does for
     a member row. An ACTIVE one is the button card's own look, which this must
     not cover: both rules weigh the same, and this card's CSS comes later. */
  .slider-actions>.fh-cell:not(.fh-active)>button{background:var(--fh-surface-alt);color:var(--fh-text)}
  /* BeerCSS's `.slider.max` is already `position:absolute;inset:0` of the card,
     so the master's track — and its painted span — span the WHOLE card, members
     included. Nothing constrains the master's range input to the head strip
     either, and it should not: the member rows are painted over it (opaque,
     stacked below), so a drag lands on the master exactly where its own fill is
     what the finger is on. */
  .slider-group>.slider-head-cell>.slider-body>.slider.max>span:not([class]){inset:0 var(--_end) 0 0;block-size:auto;border-radius:0;opacity:.45;pointer-events:none}
  /* Above the master's painted `<span>`, which is positioned and would otherwise
     cover the member rows' own backgrounds — the fill belongs AROUND the rows,
     not through them.
     Indented to start where the head's BADGE does, not where its card does — so
     the rows read as belonging to the head rather than as a second list. It also
     lands each row's own label at the head's label, since the row is inset by
     exactly the difference between the two badge sizes. */
  .slider-members{display:flex;flex-direction:column;gap:.25rem;
  padding:0 .5rem .5rem;z-index:2}
  /* A member is an ordinary slider card collapsed onto its own track: card and
     track share one grid cell, so the label and the live value ride ON the fill
     instead of sitting in a line above it. Members carry their own surface and no
     elevation — a shadow over the master's coloured fill reads as grime.
     Its edge is the shared `.slider-card:after` ring above, which is also what a
     DARK palette needs to see the row at all: a sunken surface and a card
     surface are a couple of percent apart there, so an OFF member (no fill,
     nothing but its own background) all but vanished into the group. */
  .slider-members .card{display:grid;min-block-size:3rem;margin:0;
  background:var(--fh-surface-sunken);
  border-radius:1.5rem;overflow:hidden}
  .slider-members :is(.slider-head,.slider.max){grid-area:1/1}
  /* Block padding off: a row is sized by `min-block-size`, so its own padding
     would only make it taller than the pill it is. */
  .slider-members .slider-head{align-items:center;padding-block:0;padding-inline:.75rem}
  .slider-members .slider.max{margin:0;block-size:100%}
  .slider-members .slider.max>input{block-size:100%}
  .slider-members .slider.max:before{display:none}
  .slider-members .slider.max>span:not([class]){inset:0 var(--_end) 0 0;block-size:auto;border-radius:0}
  """

