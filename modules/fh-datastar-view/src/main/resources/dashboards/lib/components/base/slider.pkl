/// A value slider that knows nothing about Home Assistant: a track over a
/// range, a label line with an optional badge and readout, buttons at the right
/// of the line, and optional member rows under it. HA's slider is
/// `components/slider.pkl`'s `EntitySlider`, which only fills these.
module components.base.slider

import "../../core/node.pkl" as nodes
import "../../core/predicate.pkl" as predMod
import "../../core/slot.pkl" as slotMod
import "../../core/tap.pkl" as tapMod
import "../../core/text.pkl" as textMod
import "button.pkl" as buttonMod

// The dragged position as a percentage of the card's range, in JS. The range
// comes through the `min`/`max` slots: `cardDef` is shared by every slider.
// `evt.target.value`, not the bound signal: `data-bind` listens for the same
// `input` and its earlier-registered listener runs first.
const local function posFrom(v: String): String =
  "((\(v) - {{min}}) * 100 / ({{max}} - {{min}}))"

const local dragPos: String = posFrom("evt.target.value")

/// What the control SHOWS: the finger during a gesture, the server's last word
/// at rest. A second signal beside the value slot, because
/// `data-on-signal-patch` fires on local writes too, so one signal cannot tell
/// the server's write from the drag's (ADR 0025).
const local slideSig: String = "_{{id}}__slide"

/// Adopt what the device says, which is confirmation and correction alike (HA
/// clamping a brightness needs no case of its own).
const local adoptCommitted: String =
  #"data-on-signal-patch-filter="{include:/^\#(slotMod.signalRef("value"))$/}" data-on-signal-patch="$\#(slideSig) = $\#(slotMod.signalRef("value"))""#

// [[adoptCommitted]] for when no commit is coming. `fill` and `state` are
// recomputed from the committed signal, so the three writes have no order
// between them. Comma-separated: this splices inside a `&&`.
const local rollbackToCommitted: String =
  let (committed = "$" + slotMod.signalRef("value"))
    "$\(slideSig) = \(committed), " +
      "$\(slotMod.signalRef("fill")) = (100 - \(posFrom(committed))) + '%'" +
      "{{#dragPercent}}, $\(slotMod.signalRef("state")) = " +
      "Math.round(\(posFrom(committed))) + ' %'{{/dragPercent}}"

/// The two ways an ask ends with no commit coming (ADR 0025): the stream is
/// down, or the server refused (ADR 0024).
///
/// On two elements on purpose. Merged into the input's one
/// `data-on-signal-patch`, the refusal half would run when `failedOn` clears the
/// error at the NEXT commit's start, and snap the thumb back under the finger.
const local restoreOnDeadStream: String =
  #"data-effect="$_sse > 0 && (\#(rollbackToCommitted))""#

const local restoreOnRefusal: String =
  #"data-on-signal-patch-filter="{include:/^\#(tapMod.errorSig)$/}" data-on-signal-patch="$\#(tapMod.errorSig) && (\#(rollbackToCommitted))""#

/// The slider's own row — badge, readout, track, actions — as a node of its
/// own, so a brightness change repaints this and never the member rows beside
/// it (ADR 0012). Built by [[Slider]], never by an author.
class SliderHead extends nodes.Node {
  card = "sliderHead"
  // `display:contents`, so the cell is no box, and the group rules can still
  // tell the master's head from its members'.
  cellClasses { "slider-head-cell" }
  cardDef = new nodes.CardDef {
    // Everything else on this row that moves is a signal (ADR 0017), which is
    // what lets the head be structure.
    regions = new Mapping {
      ["text"] = new nodes.Region {}
      ["actions"] = new nodes.Region {}
    }
    template = """
      <div class="slider-body">
        <div class="slider-head">
          {{#icon}}<div class="slider-icon"{{#busyVisual}} \(tapMod.busyClassChange) \(tapMod.busyShapeClassChange){{/busyVisual}}><i class="mdi {{icon}}"></i></div>{{/icon}}
          {{#text}}{{{html}}}{{/text}}
          \(slotMod.ifSlot("state"))<span class="fh-reading" \(slotMod.signalBind("state"))>{{state}}</span>\(slotMod.endIfSlot("state"))
          <div class="slider-actions">{{#actions}}{{{html}}}{{/actions}}</div>
        </div>
        <div class="slider max" style="--_start: 0%;--_end: {{fill}}" \(slotMod.signalBind("fill")) \(restoreOnRefusal){{#busyVisual}} \(tapMod.busyClassChange){{/busyVisual}}{{^busyVisual}}\(tapMod.refusedClass){{/busyVisual}}>
          {{^toggle}}<input type="range" min="{{min}}" max="{{max}}" value="{{value}}"
            \(slotMod.signalBind("value"))
            data-signals__ifmissing="{ \(slideSig): '{{value}}' }"
            data-bind="\(slideSig)"
            \(adoptCommitted)
            \(restoreOnDeadStream)
            \(tapMod.busyAttrsChange)
            data-on:input="$\(slotMod.signalRef("fill")) = (100 - \(dragPos)) + '%'{{#dragPercent}}; $\(slotMod.signalRef("state")) = Math.round(\(dragPos)) + ' %'{{/dragPercent}}"
            data-on:change="\(tapMod.refusalGuard)\(tapMod.busyGuardChange)@post('sse/call/{{dashboardSlug}}/{{{service}}}/{{targetKind}}/{{targetId}}/{{dataKey}}/' + $\(slideSig) + '?node={{id}}', \(tapMod.noSignals))" />{{/toggle}}
          <span style="background:{{fillColor}}" \(slotMod.signalBind("fillColor"))></span>
          {{#toggle}}<button type="button" class="slider-toggle" aria-label="{{label}}"
            \(slotMod.signalBind("value"))
            data-on:click="\(tapMod.busyGuardChange)\(tapMod.click)"
            \(tapMod.busyAttrsChange)></button>{{/toggle}}
        </div>
      </div>
      """
    // `state` is not declared: a grouped head omits it. `label` is the toggle
    // button's `aria-label`.
    slots { "label"; "value"; "service"; "targetKind"; "targetId"; "min"; "max" }
  }
}

/// The label and its second line: the head's only moving bytes, so a node and
/// a patch target of their own. `display:contents` on its cell, so the group's
/// grid still places `strong` and `.fh-sub`.
class SliderText extends nodes.Node {
  card = "sliderText"
  cellClasses { "slider-text" }
  cardDef = new nodes.CardDef {
    template = """
      <strong class="\(textMod.BOX)">\(textMod.run("label"))</strong>\(slotMod.ifSlot("secondary"))<span class="fh-sub \(textMod.BOX)">\(textMod.liveRun("secondary"))</span>\(slotMod.endIfSlot("secondary"))
      """
    // Guarded by the slot's presence, not its value: a live one is blank in the
    // patch form, and a value guard would delete its element.
    slots { "label" }
  }
}

/// The slider. `position`, `fill` and `reading` are three readings rather than
/// one the card derives the rest from, because a transform is a CEL string or a
/// Simple shape and neither composes.
///
/// Given members, the same card is a GROUP: the slider is the head (the group
/// light) and the members are the rows it stands for, over the master's fill.
///
///   (c.entitySlider(dump.entities.light_lys)) {
///     icon = "mdi:lightbulb-group"
///     secondary = c.exprOf(dump.entities.sensor_kitchen_temp, #"state + ' °C'"#)
///     tapAction = c.tap.toggle(dump.entities.light_lys)
///     members { c.entitySlider(a).readout("percent") c.entitySlider(b).readout("percent") }
///   }
///
/// Members are ordinary nodes — another grouped slider, an [[EntityCard]], a
/// query set — each with its own live patch. `EntitySlider.withSubSliders` is
/// the chain form.
open class Slider extends nodes.Node {
  card = "slider"
  hidden title: String|slotMod.Slot
  /// On an entity slider, often an [[slotMod.Expr]] naming a DIFFERENT entity
  /// (the room's temperature beside its lights).
  hidden secondary: slotMod.Secondary? = null
  /// The badge's MDI class (`mdi-lightbulb`). Null renders no badge.
  hidden glyph: String? = null
  hidden rangeMin: Number
  hidden rangeMax: Number
  /// Where the device is, as the input's number. Server-written; the drag moves
  /// [[slideSig]] and adopts this.
  hidden position: slotMod.Slot
  /// The track fill as BeerCSS's `--_end`, a distance from the right edge. The
  /// value carries its own `%`.
  hidden fill: slotMod.Slot
  /// Null paints [[fillDefault]].
  hidden fillColor: slotMod.Slot? = null
  hidden fillDefault: String = "currentcolor"
  hidden reading: slotMod.Slot? = null
  /// Whether a drag also moves the readout: only a percentage is a function of
  /// the position.
  hidden readingFollowsDrag: Boolean = false
  /// What a release posts: a call with a key and no value, which the drag
  /// supplies.
  hidden commit: tapMod.Call? = null
  /// Set, the track is one button posting this, with no range input.
  hidden press: tapMod.TapAction? = null
  /// Whether the commit's busy look shows. The guard and the input freeze stay
  /// either way; each head action also honours its own tap's `busyVisual`.
  hidden busyVisual: Boolean = true
  /// The buttons at the right of the head, after [[leadingActions]] (#151).
  hidden actions: Listing<buttonMod.Button> = new {}
  /// Buttons a subclass puts first, so an author's [[actions]] add to them.
  hidden leadingActions: Listing<buttonMod.Button> = new {}
  /// Not `children`: this card has two regions, and these fill one.
  hidden members: Listing<nodes.LayoutNode> = new {}
  /// The entity a reading that names none reads — see `Button.subject`.
  hidden subject: String? = null
  /// Disables the range (or the press) while it holds, ORed with the commit's
  /// own refusal, as `Button.disabled`.
  hidden disabled: nodes.BooleanInput? = null
  hidden headSlots: Mapping<String, slotMod.Slot|String> = new {
    when (subject != null) {
      ["entity_id"] = subject!!
    }
    when (nodes.disabledSlot(disabled) != null) {
      ["disabled"] = nodes.disabledSlot(disabled)!!
    }
    // `onRender`: an `aria-label` on a head that is never patched.
    ["label"] = if (title is slotMod.Slot) (title as slotMod.Slot) { reads = "onRender" } else title
    when (glyph != null) {
      ["icon"] = glyph!!
    }
    when (busyVisual) {
      ["busyVisual"] = "1"
    }
    // Absent rather than empty when there is no readout: a signal slot is blank
    // in the patch form, so a section over the value would drop the span.
    when (reading != null) {
      ["state"] = (reading!!) { signal = slotMod.asText }
    }
    // Placed only because every signal slot must place its bind: `data-bind`
    // makes `data-attr:value` inert from the first pass
    // (`DatastarMorphContractSuite`). The live position is [[slideSig]].
    ["value"] = (position) { signal = slotMod.asAttr("value") }
    ["fill"] = (fill) { signal = slotMod.asStyle("--_end") }
    // On the span's own style, not the wrapper's, which beer.min.js overwrites
    // wholesale on every repaint.
    ["fillColor"] =
      if (fillColor != null)
        (fillColor!!) {
          default = fillDefault
          bypassUnavailable = false
          signal = slotMod.asStyle("background")
          reads = "live"
        }
      else new slotMod.Slot {
        transform = "''"
        default = fillDefault
        bypassUnavailable = false
        reads = "once"
      }
    // Section flags, because one `cardDef` serves every slider on the page.
    when (readingFollowsDrag) {
      ["dragPercent"] = "1"
    }
    when (press != null) {
      ["toggle"] = "1"
    }
    for (k, v in tapMod.tapRoute(press ?? commit ?? throw("A slider needs a commit or a press."))) {
      [k] = v
    }
    ["min"] = "\(rangeMin)"
    ["max"] = "\(rangeMax)"
  }
  hidden textSlots: Mapping<String, slotMod.Slot|String> = new {
    when (subject != null) {
      ["entity_id"] = subject!!
    }
    ["label"] = title
    when (secondary != null) {
      ["secondary"] = slotMod.secondarySlot(secondary!!)
    }
  }
  slots {
    when (!members.isEmpty) {
      ["group"] = "slider-group"
    }
  }
  children = new Mapping {
    ["head"] = new Listing {
      (new SliderHead {}) {
        slots = headSlots
        // On the head, the node whose slot reads it: values are local.
        derivedValues {
          when (disabled is predMod.Predicate) { ["__disabled"] = disabled!! }
        }
        children = new Mapping {
          ["text"] = new Listing { (new SliderText {}) { slots = textSlots } }
          ["actions"] = new Listing { ...leadingActions ...actions }
        }
      }
    }
    ["children"] = members
  }

  function actions(xs: List<buttonMod.Button>): Slider =
    let (self = this) (self) { actions = xs.toListing() }
  function busyVisual(b: Boolean): Slider = let (self = this) (self) { busyVisual = b }
  function disabled(d: nodes.BooleanInput): Slider = let (self = this) (self) { disabled = d }
  // BeerCSS's slider markup: the `.slider` wrapper and a trailing `<span>`
  // painted as the track, without `.tooltip`, whose text bled through behind
  // the track. The fill is ours, not BeerCSS's: its JS writes an inline style a
  // morph wipes. The label line is `.slider-head`, not a `<header>` (BeerCSS
  // makes that an app bar) nor `.row` (which squeezes the readout).
  //
  // A press row puts its button LAST, over the fill, and reuses the commit's
  // `__busy_change` signal: it stands where the commit did, and the power button
  // may hold the other name (ADR 0019).
  //
  // A member-less slider still renders an empty `.slider-members`: a card is
  // one shape, its optional pieces absent rather than different.
  cardDef = new nodes.CardDef {
    regions = new Mapping {
      ["head"] = new nodes.Region {}
      [nodes.defaultRegion] = new nodes.Region {}
    }
    template = """
      <article class="card slider-card{{#group}} {{group}}{{/group}}">{{#head}}{{{html}}}{{/head}}<div class="slider-members">{{#children}}{{{html}}}{{/children}}</div></article>
      """
    css = sliderCss
    script = sliderTouchScript
  }
}

/// The gesture half of the touch rules in [[sliderCss]], which leave the range
/// input inert on a coarse pointer so a swipe over a slider card scrolls. A tap
/// that stops a fling is not meant as one, hence `STILL_MS`.
///
/// The value is driven from here because a synthesized `pointerdown` is
/// untrusted and cannot start the input's native drag.
const local sliderTouchScript: String = """
  (() => {
    const ARM_PX = 6, SCROLL_PX = 10, TAP_MS = 350, STILL_MS = 400;
    let wrap = null, input = null, x0 = 0, y0 = 0, t0 = 0, pointerId = 0;
    let armed = false, tap = false, lastScroll = 0;
    document.addEventListener('scroll', () => { lastScroll = Date.now(); },
      { capture: true, passive: true });

    const release = () => {
      if (wrap) {
        wrap.classList.remove('fh-armed');
        try { wrap.releasePointerCapture(pointerId); } catch (e) {}
      }
      wrap = null; input = null; armed = false; tap = false;
    };

    const setAt = (clientX, commit) => {
      if (!wrap || !input) return;
      const box = wrap.getBoundingClientRect();
      if (!box.width) return;
      const min = +input.min || 0, max = +input.max || 100, step = +input.step || 1;
      const along = Math.min(1, Math.max(0, (clientX - box.left) / box.width));
      const value = Math.min(max, Math.max(min,
        Math.round((min + along * (max - min)) / step) * step));
      if (value != +input.value) {
        input.value = value;
        input.dispatchEvent(new Event('input', { bubbles: true }));
      }
      if (commit) input.dispatchEvent(new Event('change', { bubbles: true }));
    };

    document.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return;
      const slider = e.target && e.target.closest && e.target.closest('.slider.max');
      if (!slider) return;
      release();
      const range = slider.querySelector('input[type=range]');
      if (!range) return;
      wrap = slider; input = range;
      x0 = e.clientX; y0 = e.clientY; t0 = e.timeStamp; pointerId = e.pointerId;
      tap = Date.now() - lastScroll > STILL_MS;
    }, true);

    document.addEventListener('pointermove', (e) => {
      if (!wrap) return;
      const dx = e.clientX - x0, dy = e.clientY - y0;
      if (!armed) {
        if (Math.abs(dy) > SCROLL_PX && Math.abs(dy) > Math.abs(dx)) { release(); return; }
        if (Math.abs(dx) < ARM_PX) return;
        armed = true;
        wrap.classList.add('fh-armed');
        try { wrap.setPointerCapture(pointerId); } catch (e) {}
        if (navigator.vibrate) navigator.vibrate(8);
      }
      setAt(e.clientX, false);
    }, true);

    const end = (e) => {
      if (!wrap) return;
      const isTap = tap && e.timeStamp - t0 <= TAP_MS
        && Math.abs(e.clientX - x0) < ARM_PX && Math.abs(e.clientY - y0) < SCROLL_PX;
      if (e.type === 'pointerup' && (armed || isTap)) setAt(e.clientX, true);
      release();
    };
    document.addEventListener('pointerup', end, true);
    document.addEventListener('pointercancel', end, true);
  })();
  """

// Colour goes through `--fh-*`; BeerCSS's private knobs stay with the theme.
// `.slider.max` is BeerCSS's class but this card emits it, so its rules are
// here.
const local sliderCss: String = """
  /* Painted over the track, so it must not take the pointer. The readout is
     pushed right rather than `space-between`, which would centre the label
     between badge and readout. `line-height` pins the font-independent rhythm.
     `--fh-readout-size` reserves the readout's width, so a drag from `9 %` to
     `100 %` does not move the label's clip edge. */
  /* `min-inline-size:0`: as a member row's grid item the head's automatic
     minimum is the whole nowrap label, which pushed the reading off the card. */
  .slider-head{display:flex;gap:.75rem;align-items:center;padding:.5rem;line-height:1.5;z-index:3;pointer-events:none;min-inline-size:0}
  .slider-head>.fh-reading{margin-inline-start:auto;flex:0 0 auto;
  min-inline-size:var(--fh-readout-size,3.25rem);text-align:end}
  /* The control's edge, OVER the fill: a nearly-full bright slider otherwise has
     no visible end. A pseudo-element, because an inset box-shadow paints behind
     the descendants. */
  .slider-card{position:relative}
  .slider-card:after{content:"";position:absolute;inset:0;border-radius:inherit;
  box-shadow:inset 0 0 0 .0625rem var(--fh-border);pointer-events:none;z-index:4}
  .slider.max,.slider.max>input{cursor:ew-resize}
  .slider.max>input::-webkit-slider-thumb{cursor:ew-resize}
  .slider.max>input::-moz-range-thumb{cursor:ew-resize}
  /* The wrapper and input each set their own cursor, so `.fh-loading` alone
     never beats them. */
  .slider.max.fh-loading,.slider.max.fh-loading>input{cursor:progress}
  .slider.max.fh-loading>input::-webkit-slider-thumb{cursor:progress}
  .slider.max.fh-loading>input::-moz-range-thumb{cursor:progress}
  /* Slide the fill to a state change, but not under a drag, where a transition
     reads as lag. `:focus-within` too: a pointer drag ends with the input
     focused. */
  .slider.max>span:not([class]){transition:inset .3s cubic-bezier(.2,0,0,1),background .3s linear}
  .slider.max:is(:active,:focus-within,.fh-armed)>span:not([class]){transition:none}
  /* Touch: the input is inert so a swipe scrolls; sliderTouchScript drives the
     value. */
  @media (pointer:coarse){
  .slider.max{touch-action:pan-y}
  .slider.max>input{pointer-events:none}
  .slider.max.fh-armed{box-shadow:inset 0 0 0 .125rem var(--fh-accent)}
  }
  /* The toggle variant's whole-track button, invisible on purpose: the fill is
     the feedback. Not `all:unset`, which drops the box the click needs.
     `block-size:auto`: BeerCSS's fixed button height over-constrains `inset:0`,
     leaving a 40px strip at the top of the card. */
  .slider-toggle{position:absolute;inset:0;block-size:auto;inline-size:auto;
  z-index:1;margin:0;padding:0;border:0;
  background:none;box-shadow:none;color:inherit;font:inherit;border-radius:inherit;
  appearance:none;-webkit-appearance:none;cursor:pointer}
  .slider-body{display:contents}
  .slider-head-cell{display:contents}
  .slider-members:empty{display:none}
  /* A slider holding sliders: the master's fill is the whole card's
     background, behind the rows, so the group reads as one control. */
  .slider-group{overflow:hidden}
  /* Through `.slider-body`, so these miss the members' own heads. Rows are
     declared, or the taller badge pushes the label's two lines apart; `1/3`
     rather than `1/-1` for the same explicit grid. */
  .slider-group>.slider-head-cell>.slider-body>.slider-head{display:grid;grid-template-columns:auto 1fr auto auto;
  grid-template-rows:auto auto;align-items:center;align-content:center;
  min-block-size:4.5rem;box-sizing:border-box;gap:0 .75rem}
  .slider-group>.slider-head-cell>.slider-body>.slider-head>.slider-text>strong{grid-column:2;grid-row:1}
  .slider-group>.slider-head-cell>.slider-body>.slider-head>.slider-text>.fh-sub{grid-column:2;grid-row:2}
  .slider-group>.slider-head-cell>.slider-body>.slider-head>.slider-icon{grid-row:1/3}
  .slider-group>.slider-head-cell>.slider-body>.slider-head>.fh-reading{grid-column:3;grid-row:1/3}
  .slider-group>.slider-head-cell>.slider-body>.slider-head>.slider-actions{grid-column:4;grid-row:1/3}
  /* `flex:0 0 auto`: shrinkable, the circle turned into an ellipse beside a long
     label. */
  .slider-icon{display:flex;align-items:center;justify-content:center;
  flex:0 0 auto;inline-size:2rem;block-size:2rem;border-radius:50%;
  background:var(--fh-surface-alt);color:var(--fh-accent)}
  .slider-icon>i{font-size:1.25rem}
  .slider-group>.slider-head-cell>.slider-body>.slider-head>.slider-icon{inline-size:2.75rem;block-size:2.75rem}
  .slider-group>.slider-head-cell>.slider-body>.slider-head>.slider-icon>i{font-size:1.5rem}
  .slider-text,.slider-actions>.fh-cell{display:contents}
  /* The buttons are the row's only controls, so they take the pointer back. */
  .slider-actions{display:flex;align-items:center;gap:.25rem;pointer-events:auto}
  .slider-actions:empty{display:none}
  /* By position, not by a class of their own; an active button keeps its look. */
  .slider-actions>.fh-cell:not(.fh-active)>button{background:var(--fh-surface-alt);color:var(--fh-text)}
  /* The master's track spans the whole card, members included, so a drag lands
     on the master wherever its fill is. */
  .slider-group>.slider-head-cell>.slider-body>.slider.max>span:not([class]){inset:0 var(--_end) 0 0;block-size:auto;border-radius:0;opacity:.45;pointer-events:none}
  /* Above the master's span, and indented to the head's badge, so the rows read
     as the head's own. */
  .slider-members{display:flex;flex-direction:column;gap:.25rem;
  padding:0 .5rem .5rem;z-index:2}
  /* A member: card and track share one grid cell, so the label rides on the
     fill. No elevation: a shadow over the master's fill reads as grime. */
  .slider-members .card{display:grid;min-block-size:3rem;margin:0;
  background:var(--fh-surface-sunken);
  border-radius:1.5rem;overflow:hidden}
  .slider-members :is(.slider-head,.slider.max){grid-area:1/1}
  .slider-members .slider-head{align-items:center;padding-block:0;padding-inline:.75rem}
  .slider-members .slider.max{margin:0;block-size:100%}
  .slider-members .slider.max>input{block-size:100%}
  .slider-members .slider.max:before{display:none}
  .slider-members .slider.max>span:not([class]){inset:0 var(--_end) 0 0;block-size:auto;border-radius:0}
  """
