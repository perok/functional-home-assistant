/// A value slider that knows nothing about Home Assistant: a track over a
/// range, a label line with an optional badge and readout, buttons at the right
/// of the line, and optional member rows under it. HA's slider is
/// `components/slider.pkl`'s `EntitySlider`, which only fills these.
module components.base.slider

import "../../core/badge.pkl" as badgeMod
import "../../core/icon.pkl" as icons
import "../../core/node.pkl" as nodes
import "../../core/predicate.pkl" as predMod
import "../../core/slot.pkl" as slotMod
import "../../core/surface.pkl" as surfaceMod
import "../../core/tap.pkl" as tapMod
import "../../core/text.pkl" as textMod
import "../../core/variable.pkl" as varMod
import "button.pkl" as buttonMod

// The dragged position as a percentage of the card's range, in JS. The range
// comes through the `min`/`max` slots: `cardDef` is shared by every slider.
// `evt.target.value`, not the bound signal: `data-bind` listens for the same
// `input` and its earlier-registered listener runs first.
const local function posFrom(v: String): String =
  "((\(v) - {{min}}) * 100 / ({{max}} - {{min}}))"

const local dragPos: String = posFrom("evt.target.value")

/// A hue track's marker is painted in the hue under it, the same `hsl` the
/// server's `fillColor` sends, so a drag recolours it before any commit.
const local function hueMarker(hue: String): String =
  "$\(slotMod.signalRef("fillColor")) = 'hsl(' + Math.round(\(hue)) + ',100%,50%)'"

/// What the control SHOWS: the finger during a gesture, the server's last word
/// at rest. A second signal beside the value slot, because
/// `data-on-signal-patch` fires on local writes too, so one signal cannot tell
/// the server's write from the drag's (ADR 0025).
const local slideSig: String = "_{{id}}__slide"

/// Adopt what the device says, which is confirmation and correction alike (HA
/// clamping a brightness needs no case of its own).
const local adoptCommitted: String =
  #"data-on-signal-patch-filter="{include:/^\#(slotMod.signalRef("value"))$/}" data-on-signal-patch="$\#(slideSig) = $\#(slotMod.signalRef("value"))""#

// [[adoptCommitted]] for when no commit is coming. `fill` and `state` are
// recomputed from the committed signal, so the three writes have no order
// between them. Comma-separated: this splices inside a `&&`.
const local rollbackToCommitted: String =
  let (committed = "$" + slotMod.signalRef("value"))
    "$\(slideSig) = \(committed), " +
      "$\(slotMod.signalRef("fill")) = (100 - \(posFrom(committed))) + '%'" +
      "{{#dragPercent}}, $\(slotMod.signalRef("state")) = " +
      "Math.round(\(posFrom(committed))) + ' %'{{/dragPercent}}" +
      "{{#hueTrack}}, \(hueMarker(committed)){{/hueTrack}}"

/// The two ways an ask ends with no commit coming (ADR 0025): the stream is
/// down, or the server refused (ADR 0024).
///
/// On two elements on purpose. Merged into the input's one
/// `data-on-signal-patch`, the refusal half would run when `failedOn` clears the
/// error at the NEXT commit's start, and snap the thumb back under the finger.
const local restoreOnDeadStream: String =
  #"data-effect="$_sse > 0 && (\#(rollbackToCommitted))""#

const local restoreOnRefusal: String =
  #"data-on-signal-patch-filter="{include:/^\#(tapMod.errorSig)$/}" data-on-signal-patch="$\#(tapMod.errorSig) && (\#(rollbackToCommitted))""#

/// The slider's own row — badge, readout, track, actions — as a node of its
/// own, so a brightness change repaints this and never the member rows beside
/// it (ADR 0012). Built by [[Slider]], never by an author. The badge is here,
/// so the slider's on look is too.
class SliderHead extends nodes.ActiveNode {
  card = "sliderHead"
  // `display:contents`, so the cell is no box, and the group rules can still
  // tell the master's head from its members'.
  cellClasses { "fh-slider-head-cell" }
  cardDef = new nodes.CardDef {
    // Everything else on this row that moves is a signal (ADR 0017), which is
    // what lets the head be structure.
    regions = new Mapping {
      ["text"] = new nodes.Region {}
      ["actions"] = new nodes.Region {}
    }
    template = """
      <div class="fh-slider-body">
        <div class="fh-slider-head{{#greyed}} fh-slider-greyed{{/greyed}}">
          \(badgeMod.seat(" fh-slider-icon", "mdi {{icon}}", "{{#busyVisual}} \(tapMod.busyClassChange) \(tapMod.busyShapeClassChange){{/busyVisual}}"))
          {{#text}}{{{html}}}{{/text}}
          \(slotMod.ifSlot("state"))<span class="fh-reading" \(slotMod.signalBind("state"))>{{state}}</span>\(slotMod.endIfSlot("state"))
          <div class="fh-slider-actions">{{#actions}}{{{html}}}{{/actions}}</div>
        </div>
        <div class="fh-slider{{#hueTrack}} fh-track-hue{{/hueTrack}}{{#kelvinTrack}} fh-track-kelvin{{/kelvinTrack}}{{#greyed}} fh-slider-greyed{{/greyed}}" \(restoreOnRefusal){{#busyVisual}} \(tapMod.busyClassChange){{/busyVisual}}{{^busyVisual}}\(tapMod.refusedClass){{/busyVisual}}>
          {{^toggle}}<input type="range" min="{{min}}" max="{{max}}" value="{{value}}"
            \(slotMod.signalBind("value"))
            data-signals__ifmissing="{ \(slideSig): '{{value}}' }"
            data-bind="\(slideSig)"
            \(adoptCommitted)
            \(restoreOnDeadStream)
            \(tapMod.busyAttrsChange)
            data-on:input="$\(slotMod.signalRef("fill")) = (100 - \(dragPos)) + '%'{{#dragPercent}}; $\(slotMod.signalRef("state")) = Math.round(\(dragPos)) + ' %'{{/dragPercent}}{{#hueTrack}}; \(hueMarker("evt.target.value")){{/hueTrack}}"
            data-on:change="\(tapMod.refusalGuard)\(tapMod.busyGuardChange)@post('sse/call/{{dashboardSlug}}/{{{service}}}/{{targetKind}}/{{targetId}}?node={{id}}', \(tapMod.withData("{{dataKey}}", "{{#valueRest}}[{{/valueRest}}Number($\(slideSig)){{#valueRest}}{{valueRest}}]{{/valueRest}}")))" />{{/toggle}}
          <span style="--fh-fill: {{fill}};background:{{fillColor}}" \(slotMod.signalBind("fill")) \(slotMod.signalBind("fillColor"))></span>
          {{#toggle}}<button type="button" class="fh-slider-toggle" aria-label="{{label}}"
            \(slotMod.signalBind("value"))
            data-on:click="\(tapMod.busyGuardChange)\(tapMod.click)"
            \(tapMod.busyAttrsChange)></button>{{/toggle}}
        </div>
      </div>
      """
    // `state` is not declared: a grouped head omits it. `label` is the toggle
    // button's `aria-label`.
    slots { "label"; "value"; "service"; "targetKind"; "targetId"; "min"; "max" }
  }
}

/// The label and its second line: the head's only moving bytes, so a node and
/// a patch target of their own. `display:contents` on its cell, so the group's
/// grid still places `strong` and `.fh-sub`.
class SliderText extends nodes.Node {
  card = "sliderText"
  cellClasses { "fh-slider-text" }
  cardDef = new nodes.CardDef {
    template = """
      <strong class="\(textMod.BOX)">\(textMod.run("label"))</strong>\(slotMod.ifSlot("secondary"))<span class="fh-sub \(textMod.BOX)">\(textMod.liveRun("secondary"))</span>\(slotMod.endIfSlot("secondary"))
      """
    // Guarded by the slot's presence, not its value: a live one is blank in the
    // patch form, and a value guard would delete its element.
    slots { "label" }
  }
}

/// The node variable a slider with main controls declares: the value of the
/// head it shows. A group's rows read the head's, so they switch with it.
const controlVar: varMod.Variable = new { name = "control" }

/// One head a [[SliderControls]] can show, while [[controlVar]] is at [[value]].
class ControlHead {
  value: varMod.Value
  head: SliderHead
}

/// One of a slider's [[Slider.buttons]]: a tap, shown as a pill in its look;
/// a node, such as a pill or a `c.select`; or a [[nodes.SubjectButton]]. A null is
/// no button.
typealias SliderButton = tapMod.TapAction|nodes.LayoutNode|nodes.SubjectButton

const local function pillsOf(bs: List<SliderButton?>): Listing<nodes.LayoutNode> =
  bs.filterNonNull()
    .map((b) ->
      if (b is nodes.SubjectButton) throw("A c.its button is about the slider's own entity, and this slider has none.")
      else if (b is tapMod.TapAction) buttonMod.pill(b)
      else b as nodes.LayoutNode)
    .toListing()

// One panel per main control, baked into the node: the shown one is in the first HTML,
// so nothing waits on a script to pick it.
const local function controlPanels(ms: List<ControlHead>): Mapping<String, surfaceMod.SurfaceDef> =
  new Mapping {
    for (i, m in ms) {
      ["m\(i)"] = new surfaceMod.SurfaceDef {
        content = m.head
        bakeInto = nodes.NODE_ID
        bakeAs = "panel"
        bakeIndex = i
        activation = controlVar.selecting(m.value)
      }
    }
  }

/// The buttons at the track's end, the switch between the main controls among
/// them: one pill over every head, so it stays put while they swap.
class SliderPill extends nodes.Node {
  card = "sliderPill"
  cellClasses { "fh-slider-pill-cell" }
  cardDef = new nodes.CardDef {
    regions = new Mapping { [nodes.defaultRegion] = new nodes.Region {} }
    template = #"<div class="fh-slider-pill">{{#children}}{{{html}}}{{/children}}</div>"#
  }
  hidden buttons: List<SliderButton?>
  children = new Mapping { [nodes.defaultRegion] = pillsOf(buttons) }
}

/// A slider's head as one of several, chosen by [[controlVar]], with the pill
/// beside it. The tabs machinery (ADR 0033): a head not shown is neither
/// rendered nor kept live. A group's row has the heads and no pill.
class SliderControls extends nodes.Node {
  card = "sliderControls"
  cellClasses { "fh-slider-controls-cell" }
  cardDef = new nodes.CardDef {
    regions = new Mapping {
      [nodes.defaultRegion] = new nodes.Region {}
      ["panel"] = new nodes.Region { fill = "baked" }
    }
    template = #"<div class="fh-slider-controls"><div id="{{hostId}}" class="fh-slider-controls-panel">{{#panel}}{{{html}}}{{/panel}}</div>{{#children}}{{{html}}}{{/children}}</div>"#
  }
  hidden controls: List<ControlHead>
  inlineSurfaces = controlPanels(controls)
}

/// The slider. `position`, `fill` and `reading` are three readings rather than
/// one the card derives the rest from, because a transform is a CEL string or a
/// Simple shape and neither composes.
///
/// Given members, the same card is a GROUP: the slider is the head (the group
/// light) and the members are the rows it stands for, over the master's fill.
///
///   (c.entitySlider(dump.entities.light_lys)) {
///     icon = "mdi:lightbulb-group"
///     secondary = c.exprOf(dump.entities.sensor_kitchen_temp, #"state + ' °C'"#)
///     buttons = List(c.tap.toggle(dump.entities.light_lys))
///     members { c.entitySlider(a).readout("percent") c.entitySlider(b).readout("percent") }
///   }
///
/// Members are ordinary nodes — another grouped slider, an [[EntityCard]], a
/// query set — each with its own live patch. `EntitySlider.withSubSliders` is
/// the chain form.
open class Slider extends nodes.Node {
  card = "slider"
  hidden title: String|slotMod.Slot
  /// On an entity slider, often an [[slotMod.Expr]] naming a DIFFERENT entity
  /// (the room's temperature beside its lights).
  hidden secondary: slotMod.Secondary? = null
  /// The badge's MDI class (`mdi-lightbulb`). Null renders no badge.
  hidden glyph: String? = null
  /// The badge's on look, as `Tile.active`.
  hidden active: nodes.BooleanInput = false
  hidden rangeMin: Number
  hidden rangeMax: Number
  /// Where the device is, as the input's number. Server-written; the drag moves
  /// [[slideSig]] and adopts this.
  hidden position: slotMod.Slot
  /// The track fill as `--fh-fill`, a distance from the right edge. The
  /// value carries its own `%`.
  hidden fill: slotMod.Slot
  /// Null paints [[fillDefault]].
  hidden fillColor: slotMod.Slot? = null
  hidden fillDefault: String = "currentcolor"
  hidden reading: slotMod.Slot? = null
  /// Whether a drag also moves the readout: only a percentage is a function of
  /// the position.
  hidden readingFollowsDrag: Boolean = false
  /// What a release posts: a call with a key and no value, which the drag
  /// supplies.
  hidden commit: tapMod.Call? = null
  /// The rest of a list the dragged number leads, for a key whose value is one:
  /// `,100` makes a hue `hs_color = [h, 100]`.
  hidden valueRest: String? = null
  /// Paints the track with the hues it picks and draws the fill as a marker at
  /// the position, in [[fillDefault]]: on a hue, a fill from the left edge
  /// says nothing.
  hidden hueTrack: Boolean = false
  /// Paints the track warm to cold, so a light in a colour mode, which reports
  /// no kelvin and so has no fill, still shows what the track sets.
  hidden kelvinTrack: Boolean = false
  /// Set, the track is one button posting this, with no range input.
  hidden press: tapMod.TapAction? = null
  /// Whether the commit's busy look shows. The guard and the input freeze stay
  /// either way; each head action also honours its own tap's `busyVisual`.
  hidden busyVisual: Boolean = true
  /// The pills at the right of the head, in this order (#151): a tap is a pill
  /// in its look. On a slider that declares [[controlVar]] they are on the
  /// pill, the switch between its [[controls]] among them.
  hidden buttons: List<SliderButton?> = List()
  /// [[buttons]] as shown, its [[nodes.SubjectButton]]s filled in by a
  /// subclass that knows an entity.
  hidden shownButtons: List<SliderButton?> = buttons
  /// Not `children`: this card has two regions, and these fill one.
  hidden members: Listing<nodes.LayoutNode> = new {}
  /// The entity a reading that names none reads — see `Button.subject`.
  hidden subject: String? = null
  /// Disables the range (or the press) while it holds, ORed with the commit's
  /// own refusal, as `Button.disabled`.
  hidden disabled: nodes.BooleanInput? = null
  hidden headSlots: Mapping<String, slotMod.Slot|String> = new {
    when (subject != null) {
      ["entity_id"] = subject!!
    }
    when (nodes.disabledSlot(disabled) != null) {
      ["disabled"] = nodes.disabledSlot(disabled)!!
    }
    // `onRender`: an `aria-label` on a head that is never patched.
    ["label"] = if (title is slotMod.Slot) (title as slotMod.Slot) { reads = "onRender" } else title
    when (glyph != null) {
      ["icon"] = glyph!!
    }
    for (k, v in badgeMod.slots(active)) {
      [k] = v
    }
    when (busyVisual) {
      ["busyVisual"] = "1"
    }
    // Absent rather than empty when there is no readout: a signal slot is blank
    // in the patch form, so a section over the value would drop the span.
    when (reading != null) {
      ["state"] = (reading!!) { signal = slotMod.asText }
    }
    // Placed only because every signal slot must place its bind: `data-bind`
    // makes `data-attr:value` inert from the first pass
    // (`DatastarMorphContractSuite`). The live position is [[slideSig]].
    ["value"] = (position) { signal = slotMod.asAttr("value") }
    // This and `fillColor` are on the span's own style, not the wrapper's, which
    // beer.min.js overwrites wholesale on every repaint.
    ["fill"] = (fill) { signal = slotMod.asStyle("--fh-fill") }
    ["fillColor"] =
      if (fillColor != null)
        (fillColor!!) {
          default = fillDefault
          bypassUnavailable = false
          signal = slotMod.asStyle("background")
          reads = "live"
        }
      else new slotMod.Slot {
        transform = "''"
        default = fillDefault
        bypassUnavailable = false
        reads = "once"
      }
    // Section flags, because one `cardDef` serves every slider on the page.
    when (readingFollowsDrag) {
      ["dragPercent"] = "1"
    }
    when (press != null) {
      ["toggle"] = "1"
    }
    when (valueRest != null) {
      ["valueRest"] = valueRest!!
    }
    when (hueTrack) {
      ["hueTrack"] = "1"
    }
    when (kelvinTrack) {
      ["kelvinTrack"] = "1"
    }
    when (greyed) {
      ["greyed"] = "1"
    }
    for (k, v in tapMod.tapRoute(press ?? commit ?? throw("A slider needs a commit or a press."))) {
      [k] = v
    }
    ["min"] = "\(rangeMin)"
    ["max"] = "\(rangeMax)"
  }
  hidden textSlots: Mapping<String, slotMod.Slot|String> = new {
    when (subject != null) {
      ["entity_id"] = subject!!
    }
    ["label"] = title
    when (secondary != null) {
      ["secondary"] = slotMod.secondarySlot(secondary!!)
    }
  }
  /// The heads it switches between, the first shown before anyone chooses. One
  /// or none is the plain [[headNode]].
  hidden controls: List<ControlHead> = List()
  /// Whether this node declares [[controlVar]]; false on a group's row, which
  /// reads its head's and has no pill.
  hidden declaresControl: Boolean = controls.length > 1
  /// Dimmed and disabled: a group's row standing in for a control it lacks.
  hidden greyed: Boolean = false
  /// What fills the member region; a subclass may adapt [[members]].
  hidden memberRows: Listing<nodes.LayoutNode> = members
  vars = if (declaresControl) controlVar.declare(controls[0].value) else null
  slots {
    when (!members.isEmpty) {
      ["group"] = "fh-slider-group"
    }
  }
  // An author's values go on the slider, but its readings are on the head and
  // the text, so each takes the ones it reads. One nothing here reads stays on
  // the slider, where the build names it.
  hidden headValues: Map<String, nodes.ExpressionValue> = nodes.valuesNamedIn(expressionValues, headSlots)
  hidden textValues: Map<String, nodes.ExpressionValue> = nodes.valuesNamedIn(expressionValues, textSlots)
  values =
    let (ownRead = nodes.valuesNamedIn(expressionValues, slots)
        + nodes.valuesNamedIn(expressionValues, liveClasses)
        + nodes.valuesNamedIn(expressionValues, liveProperties))
    let (own = expressionValues.toMap().filter((name, _) ->
        ownRead.containsKey(name) || !(headValues.containsKey(name) || textValues.containsKey(name))))
      if (own.isEmpty && derivedValues.isEmpty) null
      else new Mapping { ...own; ...derivedValues }
  /// This slider's own row; a slider with [[controls]] shows one of theirs.
  hidden headNode: SliderHead =
    let (headActive = active) (new SliderHead {}) {
      active = headActive
      slots = headSlots
      expressionValues = headValues.toMapping()
      // On the head, the node whose slot reads it: values are local.
      derivedValues {
        when (disabled is predMod.Predicate) { ["__disabled"] = disabled!! }
      }
      children = new Mapping {
        ["text"] = new Listing { (new SliderText {}) { slots = textSlots; expressionValues = textValues.toMapping() } }
        ["actions"] = pillsOf(shownButtons)
      }
    }
  children = new Mapping {
    ["head"] = new Listing {
      when (controls.length > 1) {
        let (cs = controls) let (bs = shownButtons) let (pill = declaresControl)
          new SliderControls {
            controls = cs
            children {
              when (pill) {
                new SliderPill { buttons = bs }
              }
            }
          }
      } else {
        headNode
      }
    }
    ["children"] = memberRows
  }

  /// `.buttons(List(c.tap.toggle(l), c.view.colourWheel(l.colour!!)))`.
  function buttons(xs: List<SliderButton?>): Slider =
    let (self = this) (self) { buttons = xs }
  function busyVisual(b: Boolean): Slider = let (self = this) (self) { busyVisual = b }
  function disabled(d: nodes.BooleanInput): Slider = let (self = this) (self) { disabled = d }
  // BeerCSS's slider markup, `fh-slider` being its `.slider.max`: the wrapper
  // and a trailing `<span>` painted as the track, without `.tooltip`, whose
  // text bled through behind the track. The fill is ours, `--fh-fill` on the
  // span, not BeerCSS's: its JS writes the wrapper's inline style, which a morph
  // wipes. The label line is `.fh-slider-head`, not a `<header>` (BeerCSS makes
  // that an app bar) nor `.row` (which squeezes the readout).
  //
  // A press row puts its button LAST, over the fill, and reuses the commit's
  // `__busy_change` signal: it stands where the commit did, and the power button
  // may hold the other name (ADR 0019).
  //
  // A member-less slider still renders an empty `.fh-slider-members`: a card is
  // one shape, its optional pieces absent rather than different.
  cardDef = new nodes.CardDef {
    regions = new Mapping {
      ["head"] = new nodes.Region {}
      [nodes.defaultRegion] = new nodes.Region {}
    }
    template = """
      <article class="fh-card fh-slider-card{{#group}} {{group}}{{/group}}">{{#head}}{{{html}}}{{/head}}<div class="fh-slider-members">{{#children}}{{{html}}}{{/children}}</div></article>
      """
    css = sliderCss
    script = sliderTouchScript
  }
}

/// The gesture half of the touch rules in [[sliderCss]], which leave the range
/// input inert on a coarse pointer so a swipe over a slider card scrolls. A tap
/// that stops a fling is not meant as one, hence `STILL_MS`.
///
/// The value is driven from here because a synthesized `pointerdown` is
/// untrusted and cannot start the input's native drag.
const local sliderTouchScript: String = """
  (() => {
    const ARM_PX = 6, SCROLL_PX = 10, TAP_MS = 350, STILL_MS = 400;
    let wrap = null, input = null, x0 = 0, y0 = 0, t0 = 0, pointerId = 0;
    let armed = false, tap = false, lastScroll = 0;
    document.addEventListener('scroll', () => { lastScroll = Date.now(); },
      { capture: true, passive: true });

    const release = () => {
      if (wrap) {
        wrap.classList.remove('fh-armed');
        try { wrap.releasePointerCapture(pointerId); } catch (e) {}
      }
      wrap = null; input = null; armed = false; tap = false;
    };

    const setAt = (clientX, commit) => {
      if (!wrap || !input) return;
      const box = wrap.getBoundingClientRect();
      if (!box.width) return;
      const min = +input.min || 0, max = +input.max || 100, step = +input.step || 1;
      const along = Math.min(1, Math.max(0, (clientX - box.left) / box.width));
      const value = Math.min(max, Math.max(min,
        Math.round((min + along * (max - min)) / step) * step));
      if (value != +input.value) {
        input.value = value;
        input.dispatchEvent(new Event('input', { bubbles: true }));
      }
      if (commit) input.dispatchEvent(new Event('change', { bubbles: true }));
    };

    document.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return;
      const slider = e.target && e.target.closest && e.target.closest('.fh-slider');
      if (!slider) return;
      release();
      const range = slider.querySelector('input[type=range]');
      if (!range) return;
      wrap = slider; input = range;
      x0 = e.clientX; y0 = e.clientY; t0 = e.timeStamp; pointerId = e.pointerId;
      tap = Date.now() - lastScroll > STILL_MS;
    }, true);

    document.addEventListener('pointermove', (e) => {
      if (!wrap) return;
      const dx = e.clientX - x0, dy = e.clientY - y0;
      if (!armed) {
        if (Math.abs(dy) > SCROLL_PX && Math.abs(dy) > Math.abs(dx)) { release(); return; }
        if (Math.abs(dx) < ARM_PX) return;
        armed = true;
        wrap.classList.add('fh-armed');
        try { wrap.setPointerCapture(pointerId); } catch (e) {}
        if (navigator.vibrate) navigator.vibrate(8);
      }
      setAt(e.clientX, false);
    }, true);

    const end = (e) => {
      if (!wrap) return;
      const isTap = tap && e.timeStamp - t0 <= TAP_MS
        && Math.abs(e.clientX - x0) < ARM_PX && Math.abs(e.clientY - y0) < SCROLL_PX;
      if (e.type === 'pointerup' && (armed || isTap)) setAt(e.clientX, true);
      release();
    };
    document.addEventListener('pointerup', end, true);
    document.addEventListener('pointercancel', end, true);
  })();
  """

// Colour goes through `--fh-*`; BeerCSS's private knobs stay with the theme.
// The track is `.fh-slider-body>.fh-slider`, never `.fh-slider` alone: BeerCSS
// styles it as `.slider.max` (`all:unset`, its own cursor), and one class less
// would lose to that and leave the touch rules inert.
const local sliderCss: String = """
  /* Painted over the track, so it must not take the pointer. The readout is
     pushed right rather than `space-between`, which would centre the label
     between badge and readout. `line-height` pins the font-independent rhythm.
     `--fh-readout-size` reserves the readout's width, so a drag from `9 %` to
     `100 %` does not move the label's clip edge. */
  /* `min-inline-size:0`: as a member row's grid item the head's automatic
     minimum is the whole nowrap label, which pushed the reading off the card. */
  .fh-slider-head{display:flex;gap:.75rem;align-items:center;padding:1rem;line-height:1.5;z-index:3;pointer-events:none;min-inline-size:0}
  .fh-slider-head>.fh-reading{margin-inline-start:auto;flex:0 0 auto;
  min-inline-size:var(--fh-readout-size,3.25rem);text-align:end}
  /* The insets are the rows', as on a tile (`.fh-tile`), so the badge sits
     where a tile's does whatever the theme pads an `<article>` with. */
  .fh-slider-card{position:relative;padding:0}
  /* A member row's edge, OVER the fill: an off row is otherwise invisible on a
     dark palette, and a full one has no end. A pseudo-element, because an inset
     box-shadow paints behind the descendants. A slider card of its own has none,
     like a tile. */
  .fh-slider-members .fh-slider-card:after{content:"";position:absolute;inset:0;border-radius:inherit;
  box-shadow:inset 0 0 0 .0625rem var(--fh-border);pointer-events:none;z-index:4}
  .fh-slider-body>.fh-slider,.fh-slider-body>.fh-slider>input{cursor:ew-resize}
  .fh-slider-body>.fh-slider>input::-webkit-slider-thumb{cursor:ew-resize}
  .fh-slider-body>.fh-slider>input::-moz-range-thumb{cursor:ew-resize}
  /* The wrapper and input each set their own cursor, so `.fh-loading` alone
     never beats them. */
  .fh-slider-body>.fh-slider.fh-loading,.fh-slider-body>.fh-slider.fh-loading>input{cursor:progress}
  .fh-slider-body>.fh-slider.fh-loading>input::-webkit-slider-thumb{cursor:progress}
  .fh-slider-body>.fh-slider.fh-loading>input::-moz-range-thumb{cursor:progress}
  /* Slide the fill to a state change, but not under a drag, where a transition
     reads as lag. `:focus-within` too: a pointer drag ends with the input
     focused. */
  .fh-slider-body>.fh-slider>span:not([class]){transition:inset .3s cubic-bezier(.2,0,0,1),background .3s linear}
  .fh-slider-body>.fh-slider:is(:active,:focus-within,.fh-armed)>span:not([class]){transition:none}
  /* Touch: the input is inert so a swipe scrolls; sliderTouchScript drives the
     value. */
  @media (pointer:coarse){
  .fh-slider-body>.fh-slider{touch-action:pan-y}
  .fh-slider-body>.fh-slider>input{pointer-events:none}
  .fh-slider-body>.fh-slider.fh-armed{box-shadow:inset 0 0 0 .125rem var(--fh-accent)}
  }
  /* The toggle variant's whole-track button, invisible on purpose: the fill is
     the feedback. Not `all:unset`, which drops the box the click needs.
     `block-size:auto`: BeerCSS's fixed button height over-constrains `inset:0`,
     leaving a 40px strip at the top of the card. */
  .fh-slider-toggle{position:absolute;inset:0;block-size:auto;inline-size:auto;
  z-index:1;margin:0;padding:0;border:0;
  background:none;box-shadow:none;color:inherit;font:inherit;border-radius:inherit;
  appearance:none;-webkit-appearance:none;cursor:pointer}
  .fh-slider-body{display:contents}
  .fh-slider-head-cell{display:contents}
  .fh-slider-members:empty{display:none}
  /* A slider holding sliders: the master's fill is the whole card's
     background, behind the rows, so the group reads as one control. */
  .fh-slider-group{overflow:hidden}
  /* Main controls: the shown head beside the pill, which sits over the track's end as
     any slider's buttons do: the track is the card's, a group's rows included.
     Static, or BeerCSS's `*{position:relative}` makes a wrapper the track's
     box. */
  .fh-slider-controls-cell,.fh-slider-pill-cell,.fh-slider-pill .fh-cell{display:contents}
  .fh-slider-controls{display:flex;flex-wrap:nowrap;align-items:center;position:static}
  .fh-slider-controls-panel{position:static;flex:1 1 auto;min-inline-size:0;align-self:stretch}
  .fh-slider-pill{display:flex;flex-direction:row;flex:0 0 auto;align-items:center;gap:.25rem;padding-inline:.5rem;z-index:3;--fh-cell-flex:0 0 auto;--fh-cell-width:auto}
  .fh-slider-pill .fh-cell:not(.fh-active)>button{background:var(--fh-surface-alt);color:var(--fh-text)}
  /* A row's head and track share the panel's one grid cell, as they share the
     row's without controls, so the label stays centred; its pill, if it has one,
     sits at the row's end, in line with the head's buttons above. */
  .fh-slider-members .fh-slider-controls{align-items:stretch}
  .fh-slider-members .fh-slider-controls-panel{display:grid}
  .fh-slider-members .fh-slider-pill{padding-inline:.25rem}
  .fh-slider-greyed{opacity:.45}
  /* Through `.fh-slider-body`, so these miss the members' own heads. Rows are
     declared, or the badge spanning both pushes the label's two lines apart;
     `1/3` rather than `1/-1` for the same explicit grid. A tile's height with a
     second line. */
  .fh-slider-group>:not(.fh-slider-members) .fh-slider-body>.fh-slider-head{display:grid;grid-template-columns:auto 1fr auto auto;
  grid-template-rows:auto auto;align-items:center;align-content:center;
  min-block-size:5rem;box-sizing:border-box;gap:0 .75rem}
  .fh-slider-group>:not(.fh-slider-members) .fh-slider-body>.fh-slider-head>.fh-slider-text>strong{grid-column:2;grid-row:1}
  .fh-slider-group>:not(.fh-slider-members) .fh-slider-body>.fh-slider-head>.fh-slider-text>.fh-sub{grid-column:2;grid-row:2}
  .fh-slider-group>:not(.fh-slider-members) .fh-slider-body>.fh-slider-head>.fh-slider-icon{grid-row:1/3}
  .fh-slider-group>:not(.fh-slider-members) .fh-slider-body>.fh-slider-head>.fh-reading{grid-column:3;grid-row:1/3}
  .fh-slider-group>:not(.fh-slider-members) .fh-slider-body>.fh-slider-head>.fh-slider-actions{grid-column:4;grid-row:1/3}
  .fh-slider-text,.fh-slider-actions>.fh-cell{display:contents}
  /* The buttons are the row's only controls, so they take the pointer back. */
  .fh-slider-actions{display:flex;align-items:center;gap:.25rem;pointer-events:auto}
  .fh-slider-actions:empty{display:none}
  /* By position, not by a class of their own; an active button keeps its look. */
  .fh-slider-actions>.fh-cell:not(.fh-active)>button{background:var(--fh-surface-alt);color:var(--fh-text)}
  /* The master's track spans the whole card, members included, so a drag lands
     on the master wherever its fill is. */
  .fh-slider-group>:not(.fh-slider-members) .fh-slider-body>.fh-slider>span:not([class]){inset:0 var(--fh-fill) 0 0;block-size:auto;border-radius:0;opacity:.45;pointer-events:none}
  /* Above the master's span, and indented to the head's badge, so the rows read
     as the head's own. */
  .fh-slider-members{display:flex;flex-direction:column;gap:.25rem;
  padding:0 1rem 1rem;z-index:2}
  /* A member: card and track share one grid cell, so the label rides on the
     fill. No elevation: a shadow over the master's fill reads as grime. */
  .fh-slider-members .fh-card{display:grid;min-block-size:3rem;margin:0;
  background:var(--fh-surface-sunken);
  border-radius:1.5rem;overflow:hidden}
  .fh-slider-members :is(.fh-slider-head,.fh-slider-body>.fh-slider){grid-area:1/1}
  .fh-slider-members .fh-slider-head{align-items:center;padding-block:0;padding-inline:.75rem}
  .fh-slider-members .fh-slider-body>.fh-slider{margin:0;block-size:100%}
  .fh-slider-members .fh-slider-body>.fh-slider>input{block-size:100%}
  .fh-slider-members .fh-slider-body>.fh-slider:before{display:none}
  .fh-slider-members .fh-slider-body>.fh-slider>span:not([class]){inset:0 var(--fh-fill) 0 0;block-size:auto;border-radius:0}
  /* The veil keeps the label readable over a saturated band. */
  .fh-slider-body>.fh-slider.fh-track-hue{--fh-track-veil:color-mix(in srgb,var(--fh-surface) 35%,transparent);
  background:linear-gradient(var(--fh-track-veil),var(--fh-track-veil)),
  linear-gradient(to right,#f00,#ff0 16.67%,#0f0 33.33%,#0ff 50%,#00f 66.67%,#f0f 83.33%,#f00)}
  /* The ends of `sliderFillColourRamp`, so the fill matches the band it covers. */
  .fh-slider-body>.fh-slider.fh-track-kelvin{--fh-track-veil:color-mix(in srgb,var(--fh-surface) 35%,transparent);
  background:linear-gradient(var(--fh-track-veil),var(--fh-track-veil)),
  linear-gradient(to right,rgb(255,166,87),rgb(201,226,255))}
  /* The marker is a knob in the hue it marks, ringed so it reads on any band.
     `.fh-slider-card` outranks a group master's span rule. */
  .fh-slider-card .fh-slider-body>.fh-slider.fh-track-hue>span:not([class]){inset:.375rem var(--fh-fill) .375rem auto;
  block-size:auto;inline-size:.875rem;transform:translateX(50%);border-radius:.4375rem;opacity:1;pointer-events:none;
  box-shadow:0 0 0 .1875rem #fff,0 0 0 .25rem rgba(0,0,0,.35),0 .125rem .375rem .25rem rgba(0,0,0,.25)}
  """
