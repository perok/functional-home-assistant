/// Reads of a provider, as `c.fetch`: an expression value a slot's or a node's
/// CEL reads by name, the answer fetched before it runs and cached by the
/// provider.
///
///     new Slot {
///       entityId = left.entity_id
///       transform = "math.greatest(past.map(p, p[1]))"
///       expressionValues { ["past"] = c.fetch.history(left).over(c.window.raw(7.d)) }
///     }
///
/// Not `q.`, which picks entities at build time and reaches no network. A
/// fetch wakes nothing: the slot is read when its own entity changes, or when
/// its card is drawn (ADR 0034).
module components.fetch

import "../hass.pkl"
import "history.pkl" as historyMod
import "window.pkl" as windowMod

/// One sensor's recorded readings over a window, read in CEL as its points:
/// `list(list(double))` of `[epochMillis, value]`, oldest first. Every
/// reading, not a chart's ~300: thinning can drop the one a computation wants,
/// such as where a countdown started. Over a statistics window, every bucket:
/// a chart's thinning is its drawing's, never the answer's.
class History extends historyMod.HistoryFetch {
  hidden sensor: hass.SensorEntity
  entity = sensor.entity_id
  window = windowMod.raw(24.h)

  function over(w: windowMod.Window|windowMod.Chosen): History =
    let (self = this) (self) { window = w }
}

/// `e`'s raw rows over the last 24 hours; `.over(c.window.raw(7.d))` for
/// another window.
function history(e: hass.SensorEntity): History = new History { sensor = e }
