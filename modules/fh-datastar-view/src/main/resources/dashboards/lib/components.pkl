/// Dashboard components for the Pkl authoring track — the typed counterpart
/// of `components.libsonnet` (MVP subset: containers, sectionTitle,
/// entityCard, button, slider; see ADR 0006 for what is deferred).
///
/// Cards are CLASSES ("class-as-builder"): the `hidden` properties are the
/// typed authoring surface, and each class derives the backend contract from
/// them — `{kind: "component", card, slots, children}` nodes, where a slot is
/// either a bare string (a constant literal) or a [[Slot]] object (a live
/// JSONata transform). Hidden properties never render, so the emitted JSON is
/// exactly what `Dashboard` decodes.
///
/// CONTRACT: literal slots must be JSON strings, never numbers — the backend
/// slot decoder rejects numbers (stringify numeric config: `"\(...)"`).
module components

// The domain schema, imported as a package-internal sibling. `dump.pkl` (which
// is generated with the same relative `import "hass.pkl"`) resolves it to the
// SAME module URI as this one, so the two share ONE set of hass types — the
// load-bearing identity constraint (ADR 0010). Because entries pull both this
// module AND `dump.pkl` through the `@fh-dashboard` package alias, each such
// relative import resolves under the one package base, keeping that single URI.
import "hass.pkl"
import "pkl:reflect"

// ---- backend output shapes (mirror fh.view.model) ----

/// The object form of a slot (fh.view.model.SlotSource). A live JSONata
/// expression over the card's entity; `reactive = false` marks an
/// identity-derived slot (resolved once, never re-rendered on state change).
class Slot {
  entityId: String? = null
  transform: String = "$state"
  default: String? = null
  bypassUnavailable: Boolean = true
  reactive: Boolean = true
}

/// Per-node layout-cell parameters (mirrors fh.view.model.Cell): extra CSS
/// classes the renderer puts on this node's `.fh-cell` wrapper. The class
/// names are the theme-agnostic `fh-` layout contract (see lib/theme.pkl).
/// Authors normally use the builder methods on [[LayoutNode]] (`columns`,
/// `fullWidth`, `cellClass`) rather than writing one directly.
class Cell {
  classes: Listing<String> = new {}
}

/// The common supertype of every layout-tree node. `kind` is the circe
/// discriminator: `"component"` for a [[Node]], `"dynamic"` for a
/// [[DynamicGroup]].
///
/// Every node is a CELL: the renderer wraps it in an id'd `.fh-cell` (the
/// real flex/grid item), and the layout builders below put `fh-` contract
/// classes on that wrapper. They follow HA's `grid_options` conventions —
/// inside a [[Grid]] (12 columns), `columns(n)` is a card's width in grid
/// columns (default 4, a third of the grid, like HA sections). No effect
/// inside a [[Row]]/[[Column]], which size by share/fill, not spans. The
/// builders return the base [[LayoutNode]] type, so chain them AFTER
/// card-specific ones:
/// `c.entityCard(e).tap(c.toggleTap).columns(3)`.
abstract class LayoutNode {
  kind: String
  /// Layout-cell classes for this node's wrapper. Null (dropped from the wire
  /// JSON) until a layout builder adds one.
  cell: Cell? = null
  /// This cell spans `n` of the surrounding grid's 12 columns (HA
  /// `grid_options.columns`). No effect outside a [[Grid]]/group.
  function columns(n: Int(this >= 1 && this <= 12)): LayoutNode = addCellClass("fh-cols-\(n)")
  /// Span the surrounding grid's full width (HA `columns: full`).
  function fullWidth(): LayoutNode = addCellClass("fh-cols-full")
  /// Shrink this cell to its content instead of filling its share. The escape
  /// from the default every other card wants — see [[Pill]], which is this plus
  /// chip styling.
  function hug(): LayoutNode = addCellClass("fh-hug")
  /// Escape hatch: put an arbitrary class on the wrapper (a theme helper, a
  /// custom rule). Must be a plain class token — validated at build time.
  function cellClass(cls: String): LayoutNode = addCellClass(cls)
  // Shared appender: replace `cell` with a copy carrying one more class (the
  // null default is never amended — amending a null Listing is an error).
  //
  // ONE SPAN PER NODE: adding an `fh-cols-*` class DROPS any it already had.
  // Both `columns(n)` and `fullWidth()` emit a `flex-basis` rule, so with two
  // present which one applies would be decided by the order of the rules in the
  // stylesheet, not by the author's last word — a silently-losing override. It
  // is also what lets a card DEFAULT its span ([[Tabs]], [[If]]) and still be
  // overridden per node.
  function addCellClass(cls: String): LayoutNode =
    let (self = this)
    let (had = if (self.cell != null) self.cell!!.classes.toList() else List())
    let (kept = if (cls.startsWith("fh-cols-")) had.filter((c) -> !c.startsWith("fh-cols-")) else had)
      (self) {
        cell = new Cell {
          classes = new Listing<String> {
            for (c in kept) { c }
            cls
          }
        }
      }
}

abstract class Node extends LayoutNode {
  kind: "component" = "component"
  card: String
  // The card's template + declared slots, CO-LOCATED with the class that
  // populates them. `hidden`, so it never emits into a node's JSON — the
  // [[cards]] registry at the bottom collects each concrete subclass's
  // class-level default by reflection. Must be a self-contained default (no
  // instance-property references). NOTE (multiline templates): each HTML
  // *attribute value* must stay on one physical line — line breaks between
  // tags/attributes are harmless whitespace, but a newline inside an
  // attribute would break it.
  hidden cardDef: CardDef
  // A LIVE slot on a bare container is a build error — the hazard the whole
  // self/mount split exists to remove. Such a card hosts content AND would
  // re-render on state, and having no `self` its patch would carry everything
  // its mount holds. Declaring a `self` is the fix, and it lifts the ban.
  //
  // Checked at the NODE, not the card, because liveness is a property of the
  // VALUE: `Slot|String` IS the distinction (a Pkl `String` is exactly the
  // wire's `literal`), so [[Grid]] keeps its `class` slot — a literal — and only
  // a genuinely reactive one is rejected. Mirrors
  // `LayoutNode.Component.liveEntities`, subject case included (the subject
  // counts only when `entity_id` is a literal).
  slots: Mapping<String, Slot|String>(
    !bareContainer(cardDef) || !toMap().values.any((v) ->
      v is Slot && v.reactive && (v.entityId != null ||
        (containsKey("entity_id") && this["entity_id"] is String)))
  ) = new {}
  // Widened to LayoutNode so a container can nest either a component or a
  // dynamic group.
  children: Listing<LayoutNode> = new {}
  // A node-level map of inline surfaces the build-phase hoist lifts into the
  // top-level `surfaces` registry (keyed `<node-id>_<localKey>`), splicing the
  // node's real id into every [[NODE_ID]] token in the subtree. Null (dropped
  // from JSON by omitNullProperties) unless a tap composes an inline popup.
  inlineSurfaces: Mapping<String, SurfaceDef>? = null
}

/// A card's markup. A LEAF card is just a `template`; a card that HOLDS other
/// nodes splits into two parts placed at independent holes in it:
///
///   - `mount` — the element the children occupy. Filled as its own operation
///     (a tab select, a popup open, a group repaint); a live patch never
///     renders into it.
///   - `self` — the card's own presentation: a tab bar, a header, a frame. This
///     is what a live patch renders, under the engine's `{{selfId}}`.
///
/// They are SIBLINGS — `self` must not contain the `{{{mount}}}` hole — and
/// that is the whole mechanism: a top-level patch matches only the element
/// carrying its own id, so a patch at the self element cannot reach the mount.
/// Hence the rule the design rests on: a node's patch carries its own rendering
/// and NEVER the contents of a mount, so a host changing cannot re-render what
/// it hosts (docs/adr/0012-each-session-renders-what-it-is-owed.md).
///
/// A container with a `mount` and NO `self` ([[Row]]/[[Column]]/[[Grid]]) has
/// only children to show, so its whole HTML contains them and it must never be
/// patched — which is why a LIVE slot on that shape is a build error.
abstract class CardDef {
  /// The whole card. Defaults to the two parts back to back, which is right for
  /// a container that is nothing but its mount.
  template: String = "{{{self}}}{{{mount}}}"
  slots: Listing<String> = new {}
  // Whether the renderer wraps this card's HTML in the id'd `.fh-cell` layout
  // wrapper. Null (dropped by omitNullProperties, backend defaults TRUE) for
  // every normal card; set `false` only for a card whose root must stay a
  // direct child of a framework-structural parent (the [[TabButton]] anchors
  // under BeerCSS's `.tabs > a`). It means exactly "my root must not be wrapped
  // in a layout box" — NOT "never a morph target", which is now decided by card
  // shape (a container patches through its `self`).
  wrapAsCell: Boolean? = null
}

/// A card with no children: one `template`, nothing to mount.
class LeafCard extends CardDef {}

/// A card that HOLDS other nodes. Splitting the two parts into separate
/// properties placed at independent holes is what makes "they are siblings"
/// structural: the ONLY way to nest them would be for `self` to contain the
/// mount hole, and the constraint below forbids exactly that.
class ContainerCard extends CardDef {
  /// Where child nodes go. Carries `id="{{mountId}}"` only when something FILLS
  /// it — a tab panel, an [[If]] branch — which is exactly where a surface's
  /// `bakeAs` names it. A plain container's children arrive nested, so its mount
  /// needs no id.
  mount: String
  /// The card's own presentation, patched independently of the mount. It IS the
  /// patch target, so it must carry the engine's `{{selfId}}`; and it must not
  /// nest the mount, or a patch would carry the mounted content after all.
  self: String?(this == null ||
    (this.contains("{{selfId}}") && !this.contains("{{{mount}}}"))) = null
}

/// Whether a card holds content but has NO presentation of its own — so its
/// whole HTML contains its children, and patching it would re-render them. Such
/// a card must never enter a diff set, which is why a LIVE slot on it is a build
/// error (see [[Node.slots]]).
const local function bareContainer(d: CardDef): Boolean =
  d is ContainerCard && d.self == null

/// An on-demand render subtree the build-phase hoist lifts into the top-level
/// `surfaces` registry (mirrors fh.view.model.Surface). Registered surfaces are
/// authored directly (a top-level `surfaces` mapping); inline surfaces ride on a
/// node's [[Node.inlineSurfaces]] and are hoisted, keyed `<node-id>_<localKey>`.
/// `bakeInto`/`bakeAs`/`bakeIndex` drive first-paint baking (tabs, [[If]]
/// branches); a plain popup leaves them null. `activation` is HOW the surface
/// becomes visible — [[UserActivation]] or [[StateActivation]] — nullable so
/// omitNullProperties drops it and the backend defaults to user activation,
/// closed (a plain popup declares nothing).
open class SurfaceDef {
  content: LayoutNode
  bakeInto: String? = null
  bakeAs: String? = null
  bakeIndex: Int? = null
  activation: (UserActivation|StateActivation)? = null
}

/// USER activation (mirrors fh.view.model.Activation.User): the surface is
/// shown by a user action — a popup open, a tab click — so which member a
/// client sees is per-session truth (uiState). `defaultOpen` bakes it
/// from the first paint (a tab bar's first tab).
class UserActivation {
  kind: "user" = "user"
  defaultOpen: Boolean = false
}

/// STATE activation (mirrors fh.view.model.Activation.State): the surface is
/// shown while its quantified `condition` holds over live entity state — server
/// truth, identical for every viewer (an [[If]] branch). A [[Predicate]] tests
/// ONE entity, so the condition needs a `quantifier` over the whole state map:
/// "any" = some entity matches (∃ — with an [[entityIs]] pin, the "entity X is
/// in state Y" case), "none" = no entity matches (∄ — deliberately its own
/// quantifier, NOT a `.not()` inside the condition, which would still quantify
/// existentially), "all" = every entity matches (∀).
class StateActivation {
  kind: "state" = "state"
  condition: Predicate
  quantifier: "any"|"none"|"all" = "any"
}

/// A REGISTERED popup surface: the `body` cards are wrapped in the [[Popup]]
/// dialog automatically (registered popup surfaces must carry their own wrap —
/// ADR 0002). `lib/entry.pkl` makes this the `surfaces` mapping default, so an
/// entry amends a popup surface into existence with no `new` and no wrap:
///   surfaces { ["detail"] { body { c.title("...") c.entityCard(e) } } }
/// A non-popup surface is still an explicit assignment:
///   ["x"] = new c.SurfaceDef { content = ... }
class PopupSurface extends SurfaceDef {
  hidden body: Listing<LayoutNode> = new {}
  content = new Popup { children = body }
}

// ---- author-facing descriptors ----

/// A live value expression for a display field that also accepts a plain
/// string: `label = expr(#"$attr.friendly_name & " " & $state"#)` vs the
/// literal `label = "Kitchen"`.
class Expr {
  entityId: String? = null
  transform: String
}

function expr(s: String): Expr = new { transform = s }

/// A live value expression bound to an EXPLICIT entity (a cross-entity read):
/// the emitted slot names its own `entityId` instead of inheriting the card's.
/// Mirrors jsonnet `entityOf` (components.libsonnet:102-105).
function exprOf(eo: hass.Entity, s: String): Expr = new { entityId = eo.entity_id; transform = s }

/// A tap descriptor: the whole Datastar click expression, either live (a Slot
/// reading $entity_id/$domain) or a constant string. A tap that opens
/// an INLINE popup also carries `inlineSurfaces` (the dialog content); the card
/// copies it onto the node so the hoist can lift it.
///
/// A tap that goes somewhere ([[navigate]]) ALSO sets `href`, and a card that
/// can be an anchor must prefer it — that is what gives the browser real link
/// behavior (middle-click, open-in-new-tab, status bar, no JS). `onclick` is
/// then the equivalent for cards whose root element cannot be an `<a>` (the
/// `<article>` of [[EntityCard]]), so every card renders the same intent.
class Tap {
  onclick: Slot|String
  href: String? = null
  inlineSurfaces: Mapping<String, SurfaceDef>? = null
}

// The placeholder a node uses to refer to its own backend-minted id — the SAME
// id the renderer injects as `{{id}}`. The build-phase hoist
// (DashboardBuild.hoistInlineSurfaces / NodeIdToken) splices the real id in.
// MUST equal DashboardBuild.NodeIdToken. Authors never type it — the
// `openPopupInline` tap embeds it (paired with an `inlineSurfaces` marker under
// the matching local key).
const NODE_ID: String = "@@NODE_ID@@"

// The default service route (domain/service) for a tap, resolved per entity
// at runtime ($domain). Scenes/scripts turn_on, buttons press, everything
// else homeassistant/toggle — same JSONata as components.libsonnet.
const local defaultRoute =
  #"($a := $lookup({"scene": "scene/turn_on", "script": "script/turn_on", "button": "button/press", "input_button": "input_button/press"}, $domain); $a ? $a : "homeassistant/toggle")"#

// Wrap a JSONata route expression into the full Datastar click expression
//   @post('sse/action/<domain>/<service>/<entity_id>', <no signals>)
// All app URLs are RELATIVE: they resolve against the page's <base href>
// (`/` served directly, the ingress prefix behind the HA supervisor proxy).
//
// SENDS NO SIGNALS. This route reads nothing from the request body — the
// domain, service and entity are all in the path — but Datastar's default is to
// serialise the whole signal store into every request, so without the filter
// each tap ships `conn`, the four cursor signals and every `ui_*` for the server
// to ignore. `exclude` is a REGEX (not a glob), so `.*` is "everything";
// `filterSignals` must be nested or it is silently ignored — see the datastar
// skill, both verified against the pinned bundle rather than the vendored docs.
const local noSignals = #"{filterSignals:{exclude:'.*'}}"#

const local function serviceOnclick(route: String): String =
  #""@post('sse/action/" & ("# + route + #") & "/" & $entity_id & "', "# +
    noSignals + #")""#

// A click expression is identity-derived: it inherits the card's entity to
// resolve $entity_id/$domain, but never varies with state (reactive = false)
// and must resolve even when the entity is unavailable.
const local function clickSlot(transformExpr: String): Slot = new {
  transform = transformExpr
  reactive = false
  bypassUnavailable = false
}

/// Service call resolved from the entity's domain (the default tap).
const toggleTap: Tap = new { onclick = clickSlot(serviceOnclick(defaultRoute)) }

/// Explicit "<domain>/<service>" override, e.g. serviceTap("lock/lock").
function serviceTap(action: String): Tap =
  new { onclick = clickSlot(serviceOnclick("\"" + action + "\"")) }

// The value-carrying action route: the service call gets `service_data`, with
// the value riding in the URL PATH (the same route the slider's template posts
// to). A path segment, so a value containing a space is percent-encoded — the
// one character that actually shows up in HA's own vocabularies (effect names
// like "Color loop", preset modes).
const local function serviceValueOnclick(action: String, key: String, value: String): String =
  #""@post('sse/action/"# + action + #"/" & $entity_id & "/"# + key + "/"
    + value.replaceAll(" ", "%20") + #"', "# + noSignals + #")""#

/// A service call carrying ONE static value: `serviceValueTap("light/turn_on",
/// "effect", "colorloop")`. The entity comes from the card the tap sits on, so
/// the same tap works on any card that has one.
function serviceValueTap(action: String, key: String, value: String): Tap =
  new { onclick = clickSlot(serviceValueOnclick(action, key, value)) }

/// Go to dashboard `slug` — an ordinary document load, so the browser owns the
/// history entry (ADR 0002). The `href` is RELATIVE and resolves against
/// <base href> (works directly and behind ingress); the `onclick` twin is for
/// non-anchor cards only and has to build the URL itself, since
/// `location.assign` does not consult <base href>.
function navigate(slug: String): Tap = new {
  href = "d/\(slug)"
  onclick = "window.location.assign(new URL('d/\(slug)',document.baseURI))"
}

/// Dismiss the (single, at-a-time) open popup — the id-less `POST
/// /sse/popup/close`. Drop a button carrying this inside a popup's content.
/// Clears `ui_popups` client-side, the same way a tab button sets `ui_<id>`:
/// the signal is what a refresh and a reconnect restore from.
function closePopup(): Tap = new { onclick = "@post('sse/popup/close'); $ui_popups = ''" }

/// Open the surface REGISTERED under `surfaceId` (a top-level `surfaces` entry).
/// A registered popup surface is [[Popup]]-wrapped (the `<dialog>`); the backend
/// renders it bare into the `#popups` mount.
function openPopup(surfaceId: String): Tap =
  new { onclick = "@post('sse/surface/open/\(surfaceId)'); $ui_popups = '\(surfaceId)'" }

/// Open an INLINE popup: `content` is wrapped in a [[Popup]] dialog and stashed
/// under this node's `inlineSurfaces["self"]`; the onclick references the future
/// surface id (`<NODE_ID>_self`) the hoist mints and splices. (Pkl can't
/// union-dispatch string|node in one function like jsonnet's `openPopup`, so the
/// registered and inline forms are two named functions — a deliberate API
/// deviation, see ADR 0006.)
// The parameter is `body`, NOT `content`: a bare `content` inside the nested
// `new SurfaceDef { content = new Popup { children { <here> } } }` amend would
// bind to SurfaceDef's own `content` member (a self-reference → stack overflow),
// per the Pkl amend-scoping gotcha.
function openPopupInline(body: Node): Tap = new {
  onclick = "@post('sse/surface/open/\(NODE_ID)_self'); $ui_popups = '\(NODE_ID)_self'"
  inlineSurfaces = new Mapping {
    ["self"] = new SurfaceDef { content = new Popup { children { body } } }
  }
}

// ---- shared slot builders (port of labelSlot/valueSlot/secondarySlot) ----

// Auto-appended unit for a value display: the entity's unit_of_measurement,
// space-separated, when it has one.
const local UNIT =
  #" & ($attr.unit_of_measurement ? " " & $attr.unit_of_measurement : "")"#

// label: Expr -> live (still resolving when unavailable, so a label shows the
// name, not "unavailable"); String -> literal; null -> the entity's
// friendly_name (falling back to its id) baked as a literal.
const local function labelSlot(entity: hass.Entity?, label: (String|Expr)?): Slot|String =
  if (label is Expr) new Slot { entityId = label.entityId; transform = label.transform; bypassUnavailable = false }
  else if (label != null) label
  // Dynamic default: a LIVE friendly_name (falling back to entity_id),
  // inheriting the matched entity — mirrors components.libsonnet:78-80.
  else if (entity != null && entity.isDynamic) new Slot { transform = "$attr.friendly_name ? $attr.friendly_name : $entity_id"; bypassUnavailable = false }
  else if (entity != null) entity.friendly_name ?? entity.entity_id
  else ""

// value: null -> $state (+ unit); String -> that attribute (+ unit);
// Expr -> your expression verbatim (you own the unit).
const local function valueSlot(value: (String|Expr)?): Slot =
  if (value is Expr) new Slot { entityId = value.entityId; transform = value.transform }
  else new Slot {
    transform = (if (value == null) "$state" else "$attr." + value) + UNIT
  }

// secondary (only built when authored): String -> an attribute (no unit);
// Expr -> live. Empty default keeps the mustache section collapsed when blank.
const local function secondarySlot(secondary: String|Expr): Slot =
  new Slot {
    entityId = if (secondary is Expr) secondary.entityId else null
    transform = if (secondary is Expr) secondary.transform else "$attr." + secondary
    default = ""
  }

// ---- the components ----

// `cssClass` is the authoring name (`class` is a Pkl reserved word); it emits
// the literal slot key `"class"` that the `{{#class}}` template sections read.
class Row extends Node {
  card = "fhrow"
  // Pure mount: the row IS where its children go, so there is no `self` and
  // `template` stays the default. No id — nothing fills a row from outside.
  cardDef = new ContainerCard {
    mount = """
      <div class="fh-row{{#class}} {{class}}{{/class}}">{{#children}}{{{html}}}{{/children}}</div>
      """
  }
  hidden cssClass: String? = null
  slots {
    when (cssClass != null) {
      ["class"] = cssClass!!
    }
  }
  // Fluent config (see [[EntityCard]]'s builder methods).
  function cssClass(cls: String): Row = let (self = this) (self) { cssClass = cls }
}

/// Amendable base instance — `(c.row) { children { ... } }`. The parens are
/// MANDATORY: Pkl requires them around ANY amend parent that isn't a `new`
/// expression (qualified reads, method calls, even bare in-scope names).
/// There is no comma-free call form: function arguments are always
/// comma-separated, and a typed-object amend body accepts only PROPERTIES
/// (bare elements/entries need a Listing/Mapping parent — hence `children`).
hidden row: Row = new Row {}

class Column extends Node {
  card = "fhcol"
  cardDef = new ContainerCard {
    mount = """
      <div class="fh-col{{#class}} {{class}}{{/class}}">{{#children}}{{{html}}}{{/children}}</div>
      """
  }
  hidden cssClass: String? = null
  slots {
    when (cssClass != null) {
      ["class"] = cssClass!!
    }
  }
  // Fluent config (see [[EntityCard]]'s builder methods).
  function cssClass(cls: String): Column = let (self = this) (self) { cssClass = cls }
}
/// Amendable base instance — `(c.column) { children { ... } }` (see [[row]]).
hidden column: Column = new Column {}

/// 12-column grid container — the DEFAULT top-level container (the HA
/// "sections" feel): children flow as rows, each cell spanning `columns(n)`
/// of 12 (default 4 — a third, HA's default card size); `fullWidth()` spans
/// the row. A PARTIAL row (spans not summing to 12) group-centers by default;
/// `centered(false)` left-packs. Theme-agnostic markup (`.fh-grid`); the `fh-`
/// layout contract CSS lives in lib/theme.pkl.
class Grid extends Node {
  card = "fhgrid"
  cardDef = new ContainerCard {
    mount = """
      <div class="fh-grid{{#class}} {{class}}{{/class}}">{{#children}}{{{html}}}{{/children}}</div>
      """
  }
  hidden cssClass: String? = null
  /// Group-center the cells: a partial row is centered, a full row fills.
  /// DEFAULT true; `centered(false)` emits the `fh-start` marker to left-pack.
  hidden centered: Boolean = true
  slots {
    when (cssClass != null || !centered) {
      ["class"] = new Listing<String> {
        when (cssClass != null) { cssClass!! }
        when (!centered) { "fh-start" }
      }.toList().join(" ")
    }
  }
  // Fluent config (see [[EntityCard]]'s builder methods).
  function cssClass(cls: String): Grid = let (self = this) (self) { cssClass = cls }
  /// Toggle group-centering of the cells (see [[centered]] property).
  function centered(on: Boolean): Grid = let (self = this) (self) { centered = on }
}
/// Amendable base instance — `(c.grid) { children { ... } }` (see [[row]]).
hidden grid: Grid = new Grid {}

/// Static title text (not bound to an entity).
class SectionTitle extends Node {
  card = "sectionTitle"
  cardDef = new LeafCard {
    template = """
      <h2 class="section">{{label}}</h2>
      """
    slots { "label" }
  }
  hidden text: String
  slots {
    ["label"] = text
  }
}

/// Default entity icon per domain — Material Symbols names (the font ships
/// with the BeerCSS theme; a theme without an icon font should hide
/// `.entity header i`). Resolved at RUNTIME via `$lookup($domain)` (the slider
/// config's identity-slot mechanism), so dynamic-group ($self) cards get the
/// matched entity's icon too; an unlisted domain yields "" and the template
/// section renders nothing.
const local domainIcons: Mapping<String, String> = new {
  ["light"] = "lightbulb"
  ["switch"] = "toggle_on"
  ["input_boolean"] = "toggle_on"
  ["sensor"] = "sensors"
  ["binary_sensor"] = "sensors"
  ["lock"] = "lock"
  ["cover"] = "blinds"
  ["climate"] = "thermostat"
  ["fan"] = "mode_fan"
  ["media_player"] = "speaker"
  ["camera"] = "videocam"
  ["person"] = "person"
  ["scene"] = "palette"
  ["script"] = "description"
  ["automation"] = "smart_toy"
  ["vacuum"] = "vacuum"
  ["weather"] = "partly_cloudy_day"
  ["button"] = "radio_button_checked"
}
const local iconLookup: String =
  "$lookup({" + (new Listing {
    for (d, i in domainIcons) {
      "\"\(d)\":\"\(i)\""
    }
  }).toList().join(",") + "}, $domain)"

/// HA-like entity card: domain icon + label + value (state or attribute, unit
/// auto-appended) + optional secondary line + optional tap. `icon` overrides
/// the domain default with a literal Material Symbols name.
class EntityCard extends Node {
  card = "entityCard"
  cardDef = new LeafCard {
    template = """
      <article class="card entity{{#tappable}} tappable{{/tappable}}"{{#tappable}}
        data-on:click="{{{onclick}}}"{{/tappable}}>
        <header>{{#icon}}<i>{{icon}}</i>{{/icon}}{{label}}</header>
        <span class="state">{{value}}</span>{{#secondary}}
        <span class="secondary">{{secondary}}</span>{{/secondary}}
      </article>
      """
    slots { "label"; "value"; "entity_id" }
  }
  hidden entity: hass.Entity
  hidden label: (String|Expr)? = null
  hidden value: (String|Expr)? = null
  hidden secondary: (String|Expr)? = null
  hidden icon: String? = null
  hidden tap: Tap? = null
  // Copy the tap's inline surfaces onto the node so the hoist lifts them
  // (mirror jsonnet tapInline, components.libsonnet:186-188). Null when the tap
  // is null or carries no inline popup → dropped by omitNullProperties.
  inlineSurfaces = if (tap != null) tap!!.inlineSurfaces else null
  slots {
    // entity_id is the card's subject — the magical slot the others inherit.
    ["entity_id"] = entity.entity_id
    ["label"] = labelSlot(entity, label)
    ["value"] = valueSlot(value)
    // Author literal, else the runtime domain lookup. Identity-derived
    // (reactive = false); bypass OFF so an unavailable entity still resolves
    // its icon from $domain rather than leaking raw state into the slot.
    ["icon"] =
      if (icon != null) icon!!
      else new Slot { transform = iconLookup; reactive = false; bypassUnavailable = false }
    when (secondary != null) {
      ["secondary"] = secondarySlot(secondary!!)
    }
    when (tap != null) {
      ["tappable"] = "1"
      ["onclick"] = tap!!.onclick
    }
  }
  // ---- fluent config (builder style) ----
  // Each option is ALSO a method: it amends `this` and returns the same class,
  // so options chain paren-free — `c.entityCard(x).tap(c.toggleTap).label("Office")`
  // — instead of the mandatory-paren amend `(c.entityCard(x)) { ... }`. Methods
  // and properties are separate namespaces, so `function tap` coexists with the
  // `hidden tap` prop; late binding re-derives `slots` from the amended value, so
  // the emitted node JSON is byte-identical to the amend form (see the
  // builder-vs-amend identity test). `let (self = this)` captures the receiver
  // before the amend body (where a bare `this` would rebind). The param is never
  // named after the property it sets (that would self-reference in the amend).
  function label(l: String|Expr): EntityCard = let (self = this) (self) { label = l }
  function value(v: String|Expr): EntityCard = let (self = this) (self) { value = v }
  function secondary(s: String|Expr): EntityCard = let (self = this) (self) { secondary = s }
  function icon(i: String): EntityCard = let (self = this) (self) { icon = i }
  function tap(t: Tap): EntityCard = let (self = this) (self) { tap = t }
}

/// Static entity card as a call (amend options in parens).
function entityCard(e: hass.Entity): EntityCard = new EntityCard { entity = e }
/// The SAME constructor as a VALUE, for [[DynamicGroup]] render positions:
/// `branches { [domainIs("light")] = c.entityCard }`. Methods and function-value
/// properties are separate namespaces, so this delegate co-exists with the method
/// above — the parens in `entityCard(e)` pick the method (no recursion). The
/// factory param is `e`, NOT `entity`: a param named after the property it sets
/// self-references inside the amend (the amend-scoping gotcha).
hidden entityCard: (hass.Entity) -> EntityCard = (e) -> entityCard(e)

/// Generic click button (service call or navigate). `action = null` defaults
/// to the domain-resolved service call, which needs an entity. (Tab-bar
/// entries are NOT buttons — see [[TabButton]].)
class Button extends Node {
  card = "button"
  cardDef = new LeafCard {
    // A button that GOES somewhere is an `<a href>`, not a scripted click: the
    // browser then gives it middle-click, open-in-new-tab, the status-bar
    // preview, and a working click before Datastar has even loaded. `.button`
    // is BeerCSS's element-independent button styling, so the two forms look
    // the same (verified in beer.min.css: every button rule is
    // `:is(button,.button)`). Only `label` is a declared slot — the other two
    // are the two arms of one choice, so neither is always present.
    template = """
      {{#href}}<a class="button card" href="{{{href}}}">{{label}}</a>{{/href}}{{^href}}<button class="card" data-on:click="{{{onclick}}}">{{label}}</button>{{/href}}
      """
    slots { "label" }
  }
  hidden entity: hass.Entity? = null
  hidden label: (String|Expr)? = null
  hidden action: Tap? = null
  // The tap actually rendered — late binding re-derives it (and the slots
  // below) when a builder amends `action`.
  hidden tap: Tap = action ?? toggleTap
  // Copy the action's inline surfaces onto the node (mirror jsonnet tapInline).
  inlineSurfaces = if (action != null) action!!.inlineSurfaces else null
  slots {
    when (entity != null) {
      ["entity_id"] = entity!!.entity_id
    }
    ["label"] = labelSlot(entity, label)
    // The anchor form wins when the tap offers one; the other slot is then
    // omitted entirely rather than emitted-and-ignored, so the node JSON says
    // which element it is.
    when (tap.href != null) {
      ["href"] = tap.href!!
    } else {
      ["onclick"] = tap.onclick
    }
  }
  // Fluent config (see [[EntityCard]]'s builder methods).
  function entity(e: hass.Entity): Button = let (self = this) (self) { entity = e }
  function label(l: String|Expr): Button = let (self = this) (self) { label = l }
  function action(a: Tap): Button = let (self = this) (self) { action = a }
}

/// One tab in the [[Tabs]] bar — BeerCSS's NATIVE tab markup (`.tabs > a`
/// anchors), so the MD3 tab look (underline active indicator, hover/press
/// states, even distribution) comes from the framework, not hand-rolled CSS.
/// Built by [[Tabs]] internally; not an authoring surface. `active` is the
/// Datastar boolean expression driving the `.active` class client-side
/// (`data-class`); `onclick` opens the tab's hoisted surface, seeds the
/// signal.
class TabButton extends Node {
  card = "tab"
  cardDef = new LeafCard {
    template = #"<a data-on:click="{{{onclick}}}" data-class="{active: {{{active}}}}">{{label}}</a>"#
    slots { "label"; "onclick"; "active" }
    // The anchors must stay DIRECT children of the `.tabs` bar — BeerCSS's tab
    // styling is the structural selector `.tabs > a` — so this is the one card
    // that opts out of the universal `.fh-cell` wrapper.
    wrapAsCell = false
  }
  hidden label: String
  hidden onclick: String
  hidden active: String
  slots {
    ["label"] = label
    ["onclick"] = onclick
    ["active"] = active
  }
}

/// Compact tappable pill — the same two arms as [[Button]] (navigate = `<a>`,
/// service call = `<button>`), styled as a chip and sized to its label instead
/// of to its cell. For a run of small choices — floors, scenes, modes — where a
/// row of full-width buttons would read as a stack of unrelated slabs.
///
/// Its cell defaults to `fh-hug` (the same self-defaulted-cell move [[Tabs]]
/// makes with `fh-cols-full`), which is the whole difference in layout terms:
/// a hugging cell packs at the container's gap, so pills in a [[Grid]] centre
/// and wrap as one group. An author still overrides it — `columns(n)` and
/// `fullWidth()` compose on top, and a pill that spans a grid column is a
/// perfectly reasonable thing to ask for.
class Pill extends Node {
  card = "pill"
  cardDef = new LeafCard {
    // BeerCSS's `.chip`: outlined, `--on-surface-variant` text, pill radius,
    // and already `box-sizing:border-box` (unlike `.button`, which is
    // content-box — see the theme's `.fh-cell>.button` rule).
    template = """
      {{#href}}<a class="chip" href="{{{href}}}">{{label}}</a>{{/href}}{{^href}}<button class="chip" data-on:click="{{{onclick}}}">{{label}}</button>{{/href}}
      """
    slots { "label" }
  }
  cell = new Cell { classes { "fh-hug" } }
  hidden entity: hass.Entity? = null
  hidden label: (String|Expr)? = null
  hidden action: Tap? = null
  hidden tap: Tap = action ?? toggleTap
  inlineSurfaces = if (action != null) action!!.inlineSurfaces else null
  slots {
    when (entity != null) {
      ["entity_id"] = entity!!.entity_id
    }
    ["label"] = labelSlot(entity, label)
    when (tap.href != null) {
      ["href"] = tap.href!!
    } else {
      ["onclick"] = tap.onclick
    }
  }
  function entity(e: hass.Entity): Pill = let (self = this) (self) { entity = e }
  function label(l: String|Expr): Pill = let (self = this) (self) { label = l }
  function action(a: Tap): Pill = let (self = this) (self) { action = a }
}

/// POPUP dialog container — a NORMAL container card (like [[Row]]/[[Column]])
/// that wraps a popup surface's content in the overlay `<dialog>` + a ✕ posting
/// the id-less close. Composed INTO a surface's content, NOT applied as backend
/// chrome. Authors rarely touch it directly: [[openPopupInline]] wraps its body
/// in one, and a registered surface gets it via the [[PopupSurface]] default.
class Popup extends Node {
  card = "popup"
  // `open` is static markup (a `<dialog>` without it is display:none); the
  // dialog is transient — present only while open. The ✕ posts the id-less
  // close. Ported verbatim from components.libsonnet:511.
  cardDef = new ContainerCard {
    mount = #"<dialog open class="popup"><button class="popup-close" data-on:click="@post('sse/popup/close'); $ui_popups = ''">✕</button>{{#children}}{{{html}}}{{/children}}</dialog>"#
  }
}
/// Amendable base instance — `(c.popup) { children { ... } }` (see [[row]]).
hidden popup: Popup = new Popup {}

/// A tab bar over ONE inline panel — one tab visible at a time. Pure
/// composition (mirror jsonnet `tabs`, components.libsonnet:467-499): each tab's
/// cards become an inline surface baked into this component's panel host
/// (`bakeInto = NODE_ID`, `bakeAs = "panel"`), sharing one exclusivity group;
/// the bar buttons open them and set the active-tab signal `ui_<id>` — which
/// the backend reads (it rides every request) and the panel host mirrors into
/// the `ui.<id>` URL param, so reconnect / navigate / refresh all restore the
/// tab flash-free. The first tab is default-open (baked on
/// first paint) via `UserActivation { defaultOpen = true }` — the rest emit no
/// `activation` at all (null, dropped by omitNullProperties) and decode to the
/// closed user default.
class Tabs extends Node {
  card = "tabs"
  // The bar is BeerCSS's `.tabs` element (its children are [[TabButton]]
  // anchors); the panel host + `{{{panel}}}` hole live below it.
  // `data-signals` seeds the active-tab signal to the baked tab's index
  // (`{{bakeIndex}}`, injected by the renderer — on a refresh that IS the URL's
  // `ui.<id>`, which is how the seed round-trips). `data-effect` mirrors every
  // later change back into the URL via the page shell's `fhUrl` helper.
  //
  // The active-tab signal is SEEDED on the bar with `__ifmissing`, and mirrored
  // to the URL from the panel below. Seeding initialises rather than asserts, so
  // a re-render can never overwrite the tab this client actually chose — which
  // a tab click racing a patch already in flight otherwise does.
  //
  // It has to be the BAR, not the panel: `__ifmissing` declines for a signal
  // something has already READ, and this bar's buttons read `$ui_<id>` for
  // their highlight. A parent's seed reaches its children's readers; a later
  // sibling's does not, and the signal would stay "" forever (pinned by
  // `DatastarMorphContractSuite`).
  //
  // `{{bakeIndex}}` in a `self` makes this node variant-bearing (ADR 0012): one
  // rendering per member, its own log entry per variant, and every path that
  // renders it by id must know the viewer — including `Patches.resume`, which
  // is why that had to learn the viewer first.
  // THE self/mount split's one real user in the shipped library. The bar is the
  // card's own presentation (`self`), the panel is where the selected tab's
  // content is mounted, and they are SIBLINGS — so re-rendering the bar cannot
  // touch the panel. BeerCSS already dictated this shape: its tab styling is the
  // structural selector `.tabs > a`.
  //
  // The bar carries no live value today (the active highlight is client-side,
  // `data-class` off `ui_<id>`), so the `self` machinery is not yet exercised —
  // but this is the card a live header ("the tab bar with the current
  // temperature") would be authored on.
  //
  // `{{mountId}}` replaces the hand-derived `{{id}}_panel`: it resolves to
  // `Surface.hostId`, the same string the backend addresses, so Pkl and Scala
  // stop agreeing by convention.
  cardDef = new ContainerCard {
    template = """
      <div class="fh-col">{{{self}}}{{{mount}}}</div>
      """
    self = """
      <div id="{{selfId}}" class="tabs" data-signals__ifmissing="{ ui_{{id}}: {{bakeIndex}} }">{{#children}}{{{html}}}{{/children}}</div>
      """
    mount = """
      <div id="{{mountId}}" class="tab-panel" data-effect="fhUrl('ui.{{id}}', $ui_{{id}})">{{{panel}}}</div>
      """
  }
  // A tab bar is a section-level component, not a third of a grid row. Its own
  // cell is what makes `.columns(n)` on a `Tabs` node WORK — before the split it
  // was accepted and then silently dropped, because a bake owner was denied the
  // wrapper those classes ride on.
  cell = new Cell { classes { "fh-cols-full" } }
  /// label -> that tab's cards. Bar order = insertion order (Mapping preserves
  /// it). The Listing DEFAULT lets a tab amend into existence and add cards
  /// directly — no `new`, no `children`:
  ///   (c.tabs) { tabs { ["Lights"] { c.entityCard(e) c.slider(l) } } }
  /// Each tab's cards are wrapped in a [[Row]] panel; a tab wanting a different
  /// container nests it as the single card: `["X"] { new Column { ... } }`.
  hidden tabs: Mapping<String, Listing<LayoutNode>> = new { default = (_) -> new Listing {} }
  // Insertion-ordered labels; the derivations below need the tab INDEX (surface
  // keys, bakeIndex, the signal seed), which a Mapping generator lacks — a List
  // generator yields (index, element).
  hidden labels: List<String> = tabs.keys.toList()
  // Each tab's cards hoisted into a Row-wrapped panel surface.
  inlineSurfaces = new Mapping {
    for (i, l in labels) {
      ["t\(i)"] = new SurfaceDef {
        content = new Row { children = tabs[l] }
        bakeInto = NODE_ID
        bakeAs = "panel"
        bakeIndex = i
        activation = if (i == 0) new UserActivation { defaultOpen = true } else null
      }
    }
  }
  // The `.tabs` bar anchors: each opens its tab's surface (`<id>_t<i>`) and
  // sets the active-tab signal; the URL mirror follows from the panel host's
  // effect. `$` is a literal Datastar signal sigil (Pkl only interpolates
  // `\(...)`); the exact onclick text is asserted in the tests.
  children = new Listing {
    for (i, l in labels) {
      new TabButton {
        label = l
        active = "$ui_\(NODE_ID) == \(i)"
        onclick = "@post('sse/surface/open/\(NODE_ID)_t\(i)'); $ui_\(NODE_ID) = \(i)"
      }
    }
  }
}

/// Amendable base instance — `(c.tabs) { tabs { ["Lights"] { ... } } }`.
hidden tabs: Tabs = new Tabs {}

// The slider's controllable config per domain: the service to call, the
// service_data key the value rides on, the range bounds, and which attribute
// is the live position. Add a domain (cover/fan/climate…) by adding a row —
// TYPED: a missing/misspelled field is a build error. A STATIC slider resolves
// its config AT BUILD TIME from the entity's domain (baked literals); a slider
// bound to [[hass.SELF]] (a dynamic-group case) can't know the domain until a
// match, so it falls back to jsonnet's runtime `$lookup($domain)` over this
// same table (see [[sliderLookup]]).
class SliderSpec {
  action: String
  key: String
  min: Int
  max: Int
  value: String
}

const sliderSpec: Mapping<String, SliderSpec> = new {
  ["light"] = new { action = "light/turn_on"; key = "brightness"; min = 1; max = 255; value = "brightness" }
  ["cover"] = new { action = "cover/set_cover_position"; key = "position"; min = 0; max = 100; value = "current_position" }
  ["fan"] = new { action = "fan/set_percentage"; key = "percentage"; min = 0; max = 100; value = "percentage" }
}

// A JSONata object literal `{"<domain>": <spec.field>}` over the sliderSpec
// table — `{"light":"light/turn_on","cover":...}` (JSONata object syntax IS
// JSON). Pkl has no reflect-by-string, so the field is a lambda accessor;
// String values are quoted, Int (min/max) values emitted bare. Mirrors jsonnet
// sliderDomainMap (components.libsonnet:225-229) but over all three domains.
const local function sliderDomainMap(get: (SliderSpec) -> Any): String =
  "{" + (new Listing {
    for (d, s in sliderSpec) {
      let (v = get.apply(s))
        "\"\(d)\":" + (if (v is String) "\"\(v)\"" else "\(v)")
    }
  }).toList().join(",") + "}"

// `$lookup(<map>, $domain)` — resolve a config field from the entity's domain
// at runtime (components.libsonnet:231).
const local function sliderLookup(get: (SliderSpec) -> Any): String =
  "$lookup(" + sliderDomainMap(get) + ", $domain)"

// The live position: read the domain's position attribute off $attr
// (components.libsonnet:233).
const local sliderValueLookup: String = "$lookup($attr, " + sliderLookup((s) -> s.value) + ")"

// The slider fill colour from the entity's own light attributes: an explicit
// `rgb_color` wins, else `color_temp_kelvin` interpolated over the mired-free
// 2000K..6500K span between a warm amber and a cool white — the same ramp HA's
// own temperature picker shows. Null for every entity that reports neither
// (covers, fans, a light that is off), which the slot's default turns back into
// `currentcolor`.
const local sliderFillColor: String =
  #"($rgb := $attr.rgb_color; $k := $attr.color_temp_kelvin; $count($rgb) = 3 "#
  + #"? "rgb(" & $string($rgb[0]) & "," & $string($rgb[1]) & "," & $string($rgb[2]) & ")" "#
  + #": $k != null ? ($t := $k < 2000 ? 0 : ($k > 6500 ? 1 : ($k - 2000) / 4500); "#
  + #""rgb(" & $string($round(255 - 54 * $t)) & "," & $string($round(166 + 60 * $t)) "#
  + #"& "," & $string($round(87 + 168 * $t)) & ")") : null)"#

// A slider config slot (action/key/min/max): author override → build-time spec
// literal (stringified — the backend slot decoder rejects numbers) → the
// runtime `$lookup($domain)` fallback for a spec-less ($self) slider. The
// lookup form is identity-derived (reactive = false, never a live dependency)
// and resolves even when the entity is unavailable (components.libsonnet:237).
// `override` is a Pkl reserved word — the param is `ovr`.
const local function sliderConfig(ovr: String?, spec: SliderSpec?, get: (SliderSpec) -> Any): Slot|String =
  if (ovr != null) ovr
  else if (spec != null) "\(get.apply(spec!!))"
  else new Slot { transform = sliderLookup(get); reactive = false; bypassUnavailable = false }

/// What a [[Slider]] drives: an ENTITY (its domain's default axis — a light's
/// brightness, a cover's position) or one of that entity's capability GROUPS
/// (`l.colourTemp`). The group carries its `owner`, so passing one names the
/// entity exactly once and the slider derives everything else from it.
///
/// This union is the "which axis" decision as a VALUE rather than a name, which
/// is what keeps a wrong choice visible in the editor: `c.slider(l.colourTemp)`
/// on a light with no kelvin range is a nullability mismatch pkl-lsp reports
/// without evaluating. A selector enum or a `.colourTemp()` builder method
/// would both hide the choice from it — see ADR 0013, "Shapes considered".
typealias SlideAxis = hass.Entity|hass.ColourTemp

/// Value slider. Accepts either a static entity whose domain has a sliderSpec
/// row (config baked at build time) or [[hass.SELF]] inside a dynamic case
/// (config resolved per matched entity via runtime `$lookup($domain)`). A
/// slider on e.g. a static sensor is a BUILD error naming the dashboard line.
class Slider extends Node {
  card = "slider"
  // The range input rides inside BeerCSS's slider markup (`.slider` wrapper +
  // trailing `<span>` = the painted MD3 track, `max` = full card width; NO
  // `.tooltip` — its value text bled through behind the track, and the live
  // value already shows in the head line). The FILL is backend-rendered:
  // the template bakes `--_start`/`--_end` as an inline style from the `fill`
  // slot, because BeerCSS's own fill is an inline style its JS writes on
  // `input` events — a Datastar morph wipes it and (the vars defaulting to
  // 0%) the track snaps to fully-filled. Baking it makes every morph correct
  // by construction; beer.min.js still repaints live DURING a drag. The label
  // line is a `.slider-head` class contract (both themes style it) — NOT a
  // `<header>` (BeerCSS styles header as a 4rem app-bar grid, which swallowed
  // the text) and NOT BeerCSS `.row`/`.max` (inline-size:100% squeezes the
  // state span into per-character wrapping).
  //
  // The drag signal is `_`-prefixed on purpose: Datastar sends every
  // non-`_` signal with EVERY backend action, so an unprefixed one would ride
  // the URL of every action POST and every SSE reconnect — a dashboard with a
  // dozen sliders paid several hundred bytes per request for state only this
  // browser uses. It is read client-side into the action URL (`$_val_…`) and
  // never from a request body, so nothing server-side loses anything.
  cardDef = new LeafCard {
    template = """
      <article class="card">
        <div class="slider-head"><strong>{{label}}</strong><span class="state">{{state}}</span></div>
        <div class="slider max" style="--_start: 0%;--_end: {{fill}}%">
          <input type="range" min="{{min}}" max="{{max}}"
            data-signals="{ _val_{{id}}: {{value}} }"
            data-bind="_val_{{id}}"
            data-on:change="@post('sse/action/{{{action}}}/{{{entity_id}}}/{{key}}/' + $_val_{{id}}, \(noSignals))" />
          <span style="background:{{fillColor}}"></span>
        </div>
      </article>
      """
    slots { "label"; "state"; "value"; "action"; "min"; "max"; "key"; "entity_id" }
  }
  /// WHAT this slider drives — see [[SlideAxis]]. Setting `entity` directly
  /// still works and means the domain's default axis; the two default to each
  /// other, so exactly one of them is ever needed.
  hidden on: SlideAxis = entity
  hidden entity: hass.Entity(isDynamic || sliderSpec.containsKey(domain)) =
    if (on is hass.ColourTemp) on.owner else on
  hidden label: (String|Expr)? = null
  // Per-instance overrides of the domain default. Each DEFAULTS to what the
  // axis says, so a capability axis configures the whole slider and an author
  // amending one of these still wins (late binding re-derives `slots`).
  hidden action: String? = if (on is hass.ColourTemp) "light/turn_on" else null
  hidden key: String? = if (on is hass.ColourTemp) "color_temp_kelvin" else null
  hidden min: Int? = if (on is hass.ColourTemp) on.min_kelvin else null
  hidden max: Int? = if (on is hass.ColourTemp) on.max_kelvin else null
  // The ATTRIBUTE holding the live position, overriding the domain default
  // (`brightness` for a light) — so a slider driving a second axis of the same
  // entity tracks the value it actually writes.
  hidden valueAttr: String? =
    if (on is hass.ColourTemp) "color_temp_kelvin" else null
  // Null for a dynamic ($self) slider — the domain is unknown until a match, so
  // config falls through sliderConfig to the runtime lookup tier.
  hidden spec: SliderSpec? = if (entity.isDynamic) null else sliderSpec[entity.domain]
  // The JSONata pieces of the `fill` computation, honouring the same three
  // config tiers as the input's own slots: author override → build-time spec
  // literal → runtime $lookup($domain).
  hidden valueExpr: String =
    if (valueAttr != null) "$attr." + valueAttr!!
    else if (spec != null) "$attr." + spec!!.value
    else sliderValueLookup
  hidden minExpr: String =
    if (min != null) "\(min!!)"
    else if (spec != null) "\(spec!!.min)"
    else sliderLookup((s) -> s.min)
  hidden maxExpr: String =
    if (max != null) "\(max!!)"
    else if (spec != null) "\(spec!!.max)"
    else sliderLookup((s) -> s.max)
  slots {
    ["entity_id"] = entity.entity_id
    ["label"] = labelSlot(entity, label)
    // The display header (inherits entity_id, bypassUnavailable default).
    ["state"] = new Slot {}
    // The range input's numeric position: opt OUT of bypass so an unavailable
    // entity falls back to `default` ("0") rather than "unavailable". Static:
    // read the domain's position attr; dynamic: $lookup it per match.
    ["value"] = new Slot {
      transform = valueExpr
      default = "0"
      bypassUnavailable = false
    }
    // The track fill, as the `--_end` percentage (distance from the RIGHT
    // edge, per BeerCSS's span/clip-path convention): 100 - value% of the
    // min..max range. Null-guarded — an absent position attribute (light off)
    // means an empty fill (end = 100), not a JSONata type error.
    //
    // NOT rounded: beer.min.js recomputes the same percentage unrounded on
    // load and after every morph, so a rounded server value visibly twitched
    // into place (brightness 155 of 1..255: `39%` baked, `39.37…%` a frame
    // later). Full precision makes the JS rewrite a no-op.
    ["fill"] = new Slot {
      transform = "($v := \(valueExpr); $v != null ? 100 - (($v - \(minExpr)) * 100 / (\(maxExpr) - \(minExpr))) : 100)"
      default = "100"
      bypassUnavailable = false
    }
    // The fill COLOUR, on the `<span>`'s own style attribute — NOT the
    // wrapper's, which beer.min.js overwrites wholesale (`style.cssText = …`)
    // every time it repaints the fill. A light reports either an explicit
    // `rgb_color` or a `color_temp_kelvin`, which maps onto the usual
    // warm→cool ramp; anything else (a cover, a fan, a light that is off)
    // yields null and the slot default hands the paint back to the theme.
    ["fillColor"] = new Slot {
      transform = sliderFillColor
      default = "currentcolor"
      bypassUnavailable = false
    }
    ["action"] = sliderConfig(action, spec, (s) -> s.action)
    ["key"] = sliderConfig(key, spec, (s) -> s.key)
    ["min"] = sliderConfig(if (min != null) "\(min)" else null, spec, (s) -> s.min)
    ["max"] = sliderConfig(if (max != null) "\(max)" else null, spec, (s) -> s.max)
  }
  // Fluent config (see [[EntityCard]]'s builder methods). The per-instance
  // overrides mirror the `hidden` props above; amending re-runs the three-tier
  // `sliderConfig` resolution with the new value.
  function label(l: String|Expr): Slider = let (self = this) (self) { label = l }
  function action(a: String): Slider = let (self = this) (self) { action = a }
  function key(k: String): Slider = let (self = this) (self) { key = k }
  function min(m: Int): Slider = let (self = this) (self) { min = m }
  function max(m: Int): Slider = let (self = this) (self) { max = m }
  function valueAttr(a: String): Slider = let (self = this) (self) { valueAttr = a }
}

/// Value slider as a call (see [[Slider]] for the domain contract). Takes an
/// entity for its domain's default axis, or a capability group for that axis:
/// `c.slider(l)` is brightness, `c.slider(l.colourTemp)` is colour temperature.
function slider(a: SlideAxis): Slider = new Slider { on = a }
/// The slider constructor as a VALUE, for [[DynamicGroup]] render positions.
hidden slider: (hass.Entity) -> Slider = (e) -> slider(e)

// ---- call-style card factories (methods construct; `|>` adds) ----
// Entity-first construction as a CALL, options via a PARENTHESIZED amend:
//   (c.entityCard(dump.entities.x)) { tap = c.toggleTap; label = "Office" }
// (the outer parens are mandatory — `c.entityCard(x) { ... }` is a parse error).
// The trivial card collapses to a bare call `c.entityCard(x)`; `new c.X { ... }`
// stays fully supported (same classes). `|>` is reserved for ADDITIONS (mixins),
// never construction — methods aren't first-class, so there is no `x |> entityCard`.

/// The common toggle-on-tap addition: `c.entityCard(x) |> c.tappable`.
tappable: Mixin<EntityCard> = new { tap = toggleTap }

/// Static title text as a call: `c.title("Active now")`.
function title(t: String): SectionTitle = new SectionTitle { text = t }
/// A service/navigate button as a call: `c.button("Close", c.closePopup())`.
function button(l: String, a: Tap): Button = new Button { label = l; action = a }
/// The compact form of the same thing: `c.pill("Underetasje", c.navigate("under"))`.
function pill(l: String, a: Tap): Pill = new Pill { label = l; action = a }

// ---- floor/area composition (typed-dump driven) ----

/// One section per area of `floor` that HAS lights: the area name as a
/// [[SectionTitle]] followed by a [[Slider]] per light, each area wrapped in its
/// own column. The typed counterpart of `overetasje.jsonnet`'s `areaView`,
/// driven by the generated dump's `Floor.areas` / `Area.lights` member lists
/// (both `hidden` on [[hass.Floor]]/[[hass.Area]] — readable, never rendered).
/// Areas with no lights are skipped, so the result is exactly the light-bearing
/// sections. Returns a [[Column]] so it drops straight into an entry's tree.
function floorView(floor: hass.Floor): Column = new Column {
  children {
    for (area in floor.areas) {
      when (!area.lights.isEmpty) {
        new Column {
          children {
            title(area.area_name)
            for (light in area.lights) {
              slider(light)
            }
          }
        }
      }
    }
  }
}

// ---- capability-conditional composition (light) ----
// What the dump's capability GROUPS are for (ADR 0013). A card that needs a
// capability takes THE GROUP — never the entity plus a flag, and never the
// entity plus the group. One argument carries both the values and (via its
// `owner`) the subject, so it cannot be aimed at an entity that lacks the
// capability and there is no second argument to disagree with.

/// One pill per named effect the light exposes, each posting
/// `light/turn_on effect=<name>`: `c.effectPills(l.effects)`.
function effectPills(fx: hass.Effects): Row = new Row {
  children {
    for (name in fx.list) {
      pill(name, serviceValueTap("light/turn_on", "effect", name))
        .entity(fx.owner)
    }
  }
}

/// Every control this light actually supports, and none it does not: a
/// brightness slider when it dims (a tappable card when it only switches), a
/// colour-temperature slider when it has a kelvin range, an effect pill row
/// when it names effects.
///
/// This is the payoff of typing capabilities as groups — the composition reads
/// as the capability list, and adding a control for a capability the light
/// lacks is not a runtime blank, it is unwriteable.
function lightControls(l: hass.LightEntity): Column = new Column {
  children {
    when (l.supportsBrightness) {
      slider(l)
    } else {
      (entityCard(l)) |> tappable
    }
    when (l.colourTemp != null) {
      slider(l.colourTemp!!)
    }
    when (l.effects != null) {
      effectPills(l.effects!!)
    }
  }
}

// ---- dynamic groups (the Predicate AST + Mapping-branch DSL) ----
// A dynamic group renders one card PER live entity matching a `query`,
// optionally dispatching the card per entity. The matched entity's
// id/entity_id/label are auto-injected and every inheriting slot is rebound to
// it (Renderer.renderCase) — so a case is built with the SAME leaf classes as a
// static card, just passing `hass.SELF` as the entity. `hass.SELF` is an
// INTERNAL sentinel: authors write render lambdas `(e) -> ...` and never see it
// (`caseOf` applies the lambda to it below). Port of components.libsonnet:579-661.

/// A property-query comparison operator. TYPED — a misspelled op is now a build
/// error (the backend `Op` decoder is case-insensitive over exactly these).
typealias PredicateOp = "eq"|"ne"|"lt"|"lte"|"gt"|"gte"

/// The runtime property-query AST. `kind` is the circe discriminator.
/// Combinators are METHODS (methods never render, so no `hidden` needed):
/// `domainIs("light").and(stateIs("on"))`, `.or(...)`, `.not()`. `and`/`or`/`not`
/// are legal method names — the Pkl operators are `&&`/`||`/`!`, so no collision.
abstract class Predicate {
  kind: String
  /// Matches when BOTH this and `other` match.
  function and(other: Predicate): PAnd = let (l = this) new PAnd { items { l; other } }
  /// Matches when EITHER this or `other` matches.
  function or(other: Predicate): POr = let (l = this) new POr { items { l; other } }
  /// Matches when this does NOT. (`let (l = this)`: a bare `this` inside the
  /// `new {}` body rebinds to the freshly-built object, not the receiver.)
  function not(): PNot = let (l = this) new PNot { item = l }
}

/// `property <op> value`. `property` is one of `"domain"`, `"state"`,
/// `"entity_id"`, or `"attr:<name>"`; `value` is Any so a numeric threshold
/// rides as a JSON number (unlike a slot literal, a query value is not
/// stringified).
class Cmp extends Predicate {
  kind: "cmp" = "cmp"
  property: String
  op: PredicateOp
  value: Any
}

class PAnd extends Predicate {
  kind: "and" = "and"
  items: Listing<Predicate>
}

class POr extends Predicate {
  kind: "or" = "or"
  items: Listing<Predicate>
}

class PNot extends Predicate {
  kind: "not" = "not"
  item: Predicate
}

// `const` so [[always]] (referenced from the [[DynamicGroup]] class body) may
// call it. Parameters are NOT named after the properties they set: inside a
// `new { property = property }` amend the RHS binds to the object's own member
// (infinite recursion), so each argument gets a distinct name.
const function cmp(prop: String, cmpOp: PredicateOp, cmpVal: Any): Cmp =
  new { property = prop; op = cmpOp; value = cmpVal }

/// Matches every entity (a domain is never literally this sentinel). `const`
/// because [[DynamicGroup.cases]] references it from the class body.
const always: Cmp = cmp("domain", "ne", "__never__")

/// `domain == d`, e.g. `domainIs("light")`.
function domainIs(d: String): Cmp = cmp("domain", "eq", d)
/// `state == s`, e.g. `stateIs("on")`.
function stateIs(s: String): Cmp = cmp("state", "eq", s)
/// `entity_id == id`, e.g. `entityIs("light.kitchen")` — pins a condition to
/// ONE entity, so an existentially quantified [[StateActivation]] ("any")
/// reads "entity X is in state Y": `entityIs(...).and(stateIs("on"))`.
function entityIs(id: String): Cmp = cmp("entity_id", "eq", id)
/// `attr:device_class == dc`, e.g. `deviceClassIs("battery")`.
function deviceClassIs(dc: String): Cmp = cmp("attr:device_class", "eq", dc)
/// `attr:<name> < threshold`, e.g. `attrBelow("battery_level", 20)`.
function attrBelow(name: String, threshold: Any): Cmp = cmp("attr:" + name, "lt", threshold)
/// `state < threshold`.
function stateBelow(threshold: Any): Cmp = cmp("state", "lt", threshold)
// Battery sensors expose the % as their STATE with device_class "battery"
// (non-numeric states like "unavailable" simply don't match `state < x`).
/// Battery sensors under `threshold` percent.
function lowBattery(threshold: Any): PAnd = deviceClassIs("battery").and(stateBelow(threshold))

/// One dispatch branch: a predicate + the card (built against `hass.SELF`) to
/// render when it matches. Keeps the card + its slots but drops the build-time
/// `entity_id` slot (the renderer sets the matched entity as the subject per
/// match) and the unused children.
class Case {
  `when`: Predicate
  card: String
  slots: Mapping<String, Slot|String> = new {}
  /// Layout-cell classes for each per-entity member wrapper this case renders
  /// (copied from the render fn's node by [[caseOf]]).
  cell: Cell? = null
}

// Build a [[Case]] from a predicate and a render fn: apply the fn to the
// INTERNAL `hass.SELF` placeholder to obtain the card, then keep its card name +
// slots but filter the `entity_id` key out (the renderer injects the matched
// entity per match). `const local` because [[DynamicGroup.cases]] calls it from
// the class body. Cases stay leaf-only today (children dropped), but the
// `(e) -> ...` shape already distributes the entity explicitly, so it needs no
// redesign if the wire format ever grows composite cases.
const local function caseOf(p: Predicate, r: (hass.Entity) -> Node): Case =
  let (node = r.apply(hass.SELF))
    new Case {
      `when` = p
      card = node.card
      slots = new Mapping {
        for (k, v in node.slots) {
          when (k != "entity_id") {
            [k] = v
          }
        }
      }
      // The render fn's layout-cell classes apply to every member wrapper.
      cell = node.cell
    }

/// A runtime-resolved group: render one card PER live entity matching `query`.
/// Branches are a `Mapping<Predicate, render fn>` — one line per branch, author
/// order preserved (= first-match dispatch order), a duplicate predicate a build
/// error, and each branch replaceable BY KEY when amending a base group (a
/// Listing amend would be append-only). Each render fn is `(hass.Entity) -> Node`:
/// the author writes exactly where the matched entity flows and never sees the
/// `$self` sentinel. `render` is the fallback for entities no branch matched (and
/// the ONLY card when `branches` is empty).
class DynamicGroup extends LayoutNode {
  kind: "dynamic" = "dynamic"
  query: Predicate
  hidden branches: Mapping<Predicate, (hass.Entity) -> Node> = new {}
  /// The card for entities no branch matched; null when a branch covers them all.
  // TODO rename as else, or no, also just add else and we translate either or to fallback
  hidden render: ((hass.Entity) -> Node)? = null
  cases: Listing<Case>(!isEmpty) = new Listing {
    for (p, r in branches) { caseOf(p, r) }
    when (render != null) { caseOf(always, render!!) }
  }
}

// ---- conditional sections (If/else via state-activated surfaces) ----
// An If is NOT a new wire kind: it reuses the tabs machinery literally — a
// host card with one bake hole + one inline surface per branch
// (`bakeInto`/`bakeAs`/`bakeIndex`) — but the ACTIVE member is selected by a
// quantified condition over live entity state ([[StateActivation]]) instead of
// the client's selection, so the choice is server truth, shared by every viewer.
// Hidden-branch silence is structural: branch nodes live in surface indexes,
// never the main reverse index, so the inactive branch is not rendered and
// receives no updates.

// Build a [[StateActivation]]. `p`/`q` are NOT named after the properties they
// set (the amend-scoping gotcha — `condition = condition` inside the `new`
// would self-recurse); `const local` because [[If.inlineSurfaces]] calls it
// from the class body.
const local function stateActivation(p: Predicate, q: "any"|"none"|"all"): StateActivation =
  new { condition = p; quantifier = q }

/// A conditional section: the `then` cards are shown while the quantified
/// `condition` holds over live entity state, the (optional) `else` cards while
/// it does not. Built by [[iff]]/[[iffNone]]/[[iffAll]] — builder calls for
/// single-card branches, the amend form for multi-card ones:
///   c.iff(c.entityIs("light.x").and(c.stateIs("on")))
///     .then(c.title("on")).`else`(c.title("off"))
///   (c.iff(p)) { `then` { ...cards... } `else` { ...cards... } }
/// With no matching member (a condition that fails and no `else`) the host
/// bakes empty; nesting an If inside `else` is the else-if story.
class If extends Node {
  card = "ifhost"
  // Pure mount: one `{{{branch}}}` bake hole (the selected member's rendered
  // content, injected by the backend like the tabs `{{{panel}}}` — not a
  // declared slot). No `self` at all — an If has no presentation of its own, so
  // there is nothing about it that could change without its content changing.
  // `fh-ifhost` exists so the layout can collapse an unmatched conditional. With
  // no matching branch the bake hole is the empty string, and without the class
  // the surrounding `fh-cols-full` cell still claimed a full-width flex line —
  // one band of dead vertical space per hidden `If`. See `theme.layoutCss`.
  cardDef = new ContainerCard {
    mount = #"<div class="fh-ifhost" id="{{mountId}}">{{{branch}}}</div>"#
  }
  // A conditional SECTION, sized like one; its content's own layout stays the
  // branch `Row`'s business. (Layout transparency was considered and dropped:
  // the branch is always Row-wrapped, so it is a box regardless and could never
  // flow into a grandparent grid.)
  cell = new Cell { classes { "fh-cols-full" } }
  hidden condition: Predicate
  hidden quant: "any"|"none"|"all" = "any"
  // `else` is a Pkl reserved word, hence the backticks; `then` is not, but is
  // backticked for visual pairing (backticks are pure quoting, not identity).
  hidden `then`: Listing<LayoutNode> = new {}
  hidden `else`: Listing<LayoutNode> = new {}
  // Each branch's cards hoisted into a Row-wrapped surface (like a tab panel).
  // Selection is first-match in `bakeIndex` order: `then` is member 0 with the
  // authored condition; `else` — present only when non-empty — is member 1
  // with the always-true predicate. BOTH members carry the SAME `bakeAs`
  // ("branch"): the backend reads a group's bake var off its first member.
  inlineSurfaces = new Mapping {
    ["then"] = new SurfaceDef {
      content = new Row { children = `then` }
      bakeInto = NODE_ID
      bakeAs = "branch"
      bakeIndex = 0
      activation = stateActivation(condition, quant)
    }
    when (!`else`.isEmpty) {
      ["else"] = new SurfaceDef {
        content = new Row { children = `else` }
        bakeInto = NODE_ID
        bakeAs = "branch"
        bakeIndex = 1
        activation = stateActivation(always, "any")
      }
    }
  }
  /// Append card(s) to the `then` branch — one node, or `new Listing { ... }`
  /// for several (a bare `new { ... }` argument cannot infer the Listing type;
  /// multi-card branches read best in the amend form). Repeat calls append,
  /// and the derived surfaces re-derive across chained calls (late binding).
  function then(n: LayoutNode|Listing<LayoutNode>): If = let (l = this)
    if (n is Listing) (l) { `then` { ...n } } else (l) { `then` { n } }
  /// Append card(s) to the `else` branch — call sites backtick the reserved
  /// word: `` .`else`(c.title("off")) ``.
  function `else`(n: LayoutNode|Listing<LayoutNode>): If = let (l = this)
    if (n is Listing) (l) { `else` { ...n } } else (l) { `else` { n } }
}

/// A conditional section as a call: `c.iff(p).then(...).`else`(...)` — shown
/// while SOME entity matches `p` (quantifier "any"; pin one entity with
/// [[entityIs]]). See [[If]] for the amend form.
function iff(p: Predicate): If = new If { condition = p }
/// [[iff]] with quantifier "none": shown while NO entity matches `p`.
function iffNone(p: Predicate): If = new If { condition = p; quant = "none" }
/// [[iff]] with quantifier "all": shown while EVERY entity matches `p`.
function iffAll(p: Predicate): If = new If { condition = p; quant = "all" }

// ---- the backend-facing card library (DERIVED from the card classes) ----
// Each card class carries its own template + declared slots (`cardDef`,
// co-located with the logic; hidden, so it never emits into a node's JSON).
// [[cardsOf]] assembles `cardName -> CardDef` by reflecting over the concrete
// [[Node]] subclasses of the given modules — within a module, registration is
// automatic: a new card is just a class. `reflect.Property.defaultValue` reads
// the evaluated CLASS-LEVEL default, which is why a `cardDef` must be
// self-contained.
//
// Why a LIST of modules rather than just this one: a card class defined outside
// this library (a third-party component) has to reach the registry too, or the
// backend has no template to render it with. Pkl cannot discover those on its
// own — `reflect.Module.imports` yields import URIs as plain STRINGS, and Pkl
// has no reflect-by-string, so there is no way to walk the import graph and
// collect what it finds. The module VALUES must therefore be named, which is
// what an entry's `componentModules` does (see `entry.pkl`).
//
// Note a component must live in its own module: classes in an AMENDING module
// (every entry) require the `local` modifier, and `local` classes are invisible
// to reflect — so a card class written inline in an entry can never register.

const local nodeClass = reflect.Class(Node)

const local function cardNameOf(clsName: String, cls: reflect.Class): String =
  let (v = cls.properties["card"].defaultValue)
    if (v is String) v
    else throw("card class \(clsName) must default `card` to a literal card name")

const local function cardDefOf(clsName: String, cls: reflect.Class): CardDef =
  let (v = cls.properties["cardDef"].defaultValue)
    if (v is CardDef) v
    else throw("card class \(clsName) must set `cardDef` (its template + declared slots)")

/// The card registry for `mods` — every concrete [[Node]] subclass they define,
/// keyed by its card name. Two modules claiming the SAME card name is a Pkl
/// error ("Duplicate definition of member"), so a component module cannot
/// silently shadow a library card.
function cardsOf(mods: List<Module>): Mapping<String, CardDef> = new {
  for (m in mods) {
    for (clsName, cls in reflect.Module(m).classes) {
      when (cls.isSubclassOf(nodeClass) && cls != nodeClass && !cls.modifiers.contains("abstract")) {
        [cardNameOf(clsName, cls)] = cardDefOf(clsName, cls)
      }
    }
  }
}

/// This library's own cards — the registry an entry gets by default.
cards: Mapping<String, CardDef> = cardsOf(List(module))
