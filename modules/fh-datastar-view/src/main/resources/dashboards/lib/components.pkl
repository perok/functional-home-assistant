/// The shipped components — what a dashboard entry imports as `c`.
///
/// A facade: every card lives in a family module beside it
/// (`components/entity.pkl`, …), which is also importable directly. The
/// component-author kit (`core/node.pkl`, `core/slot.pkl`, `core/surface.pkl`,
/// `core/predicate.pkl`) is deliberately not re-exported. Your own card
/// classes need no registering: a dashboard registers what it uses.
///
/// A re-export must carry an explicit type (`hidden tap: tapMod = tapMod`): an
/// untyped one evaluates and then completes to nothing in the editor. This
/// module must never use `extends` either
/// (`docs/issue-report-2-pkl-lsp-extends-completion.md`).
module components

import "pkl:reflect"
import "hass.pkl"
import "core/node.pkl" as nodes
import "core/slot.pkl" as slotMod
import "core/simple.pkl" as simpleMod
import "core/text.pkl" as coreTextMod
import "core/tap.pkl" as tapMod
import "core/surface.pkl" as surfaceMod
import "core/predicate.pkl" as pred
import "core/access.pkl" as accessMod
import "layout.pkl" as layoutMod
import "components/base/text.pkl" as textMod
import "components/entity.pkl" as entityMod
import "components/control.pkl" as control
import "components/base/button.pkl" as buttonMod
import "components/base/onoff.pkl" as switchMod
import "components/base/tile.pkl" as tileMod
import "components/base/bar.pkl" as barBaseMod
import "components/bar.pkl" as barMod
import "components/base/slider.pkl" as sliderBaseMod
import "components/slider.pkl" as sliderMod
import "components/base/surface.pkl" as surfaces
import "components/history.pkl" as historyMod
import "components/its.pkl" as itsMod
import "components/light.pkl" as lightMod
import "components/lock.pkl" as lockMod
import "components/moreinfo.pkl" as moreinfo
import "components/progress.pkl" as progressMod
import "components/tap.pkl" as tapVerbs
import "components/view.pkl" as viewVerbs
import "components/select.pkl" as selectMod
import "components/wheel.pkl" as wheelMod
import "core/variable.pkl" as varMod
import "recipes.pkl" as recipesMod

// ---- namespaces ----

/// What a click does in Home Assistant, each verb naming what it acts on:
/// `c.tap.toggle(l)`, `c.tap.lights.off(dump.areas.stue)`,
/// `c.tap.activate(scene)`. `c.tap(e)` is the method beside it: what a tap on
/// `e`'s own card does.
hidden tap: tapVerbs = tapVerbs

/// What a click shows, touching nothing in Home Assistant: `c.view.moreInfo(l)`,
/// `c.view.openPopup("detail")`, `c.view.navigate("under")`.
hidden view: viewVerbs = viewVerbs

/// What the card's OWN entity offers, for its buttons: `c.its.toggle`,
/// `c.its.mainControl`, `c.its.colourWheel`. Each names no target and shows
/// nothing where the entity cannot do it (ADR 0015).
hidden its: itsMod = itsMod

/// What a tap on `e` means, from its domain: a scene activates, a light
/// toggles, a lock or a sensor opens more-info (`c.tap.default`).
function tap(e: hass.Entity): tapMod.TapAction = tapVerbs.default(e)

/// The fast-tier slot constructors: `c.simple.attr("brightness")`,
/// `c.simple.percent("brightness", 1, 255)`.
hidden simple: simpleMod = simpleMod

/// `c.light.controls(l)`, `c.light.effectPills(l.effects)`.
hidden light: lightMod = lightMod

/// `c.lock.controls(l)`, `c.lock.openLatch(l)`.
hidden lock: lockMod = lockMod

/// Progress bars, for a tile's features: `c.bar.percent(e)`,
/// `c.bar.remaining(left, total)`.
hidden bar: barMod = barMod

/// Whole sections: `c.recipes.floorView(floor)`.
hidden recipes: recipesMod = recipesMod

/// Who may see a dashboard: `c.access.admin`, `c.access.public`,
/// `c.access.users(List(dump.users.peri))`. On an entry's `access`, or on
/// `site.pkl`'s for every dashboard (#89).
hidden access: accessMod = accessMod

// ---- classes an author names ----

typealias LayoutNode = nodes.LayoutNode
typealias Node = nodes.Node
/// For the rare `cell = new c.Cell { … }` the builders do not cover.
typealias Cell = nodes.Cell
typealias Row = layoutMod.Row
typealias Column = layoutMod.Column
typealias Grid = layoutMod.Grid
/// `"top"` or `"bottom"`: where `.stick(…)` keeps a card.
typealias Edge = nodes.Edge
typealias SurfaceDef = surfaceMod.SurfaceDef
typealias PopupSurface = surfaceMod.PopupSurface
typealias Popup = surfaceMod.Popup
typealias TapAction = tapMod.TapAction
typealias Expr = slotMod.Expr
typealias SectionTitle = textMod.SectionTitle
typealias Label = textMod.Label
/// `"normal"`, `"dim"`, `"error"` or `"warning"`.
typealias Tone = coreTextMod.Tone
typealias EntityCard = entityMod.EntityCard
typealias EntityInfo = moreinfo.EntityInfo
typealias Button = buttonMod.Button
typealias EntityButton = control.EntityButton
typealias Pill = buttonMod.Pill
typealias Toggle = control.Toggle
typealias Tabs = surfaces.Tabs
typealias If = surfaces.If
typealias Slider = sliderBaseMod.Slider
typealias EntitySlider = sliderMod.EntitySlider
typealias SlideAxis = sliderMod.SlideAxis
/// `"wrap"`, `"clip"` or `"scroll"`: an entry's `textOverflow` for the whole
/// dashboard, `.textOverflow(…)` for one card.
typealias TextOverflow = coreTextMod.Overflow

// ---- amendable base instances: `(c.row) { children { … } }` ----

hidden row: layoutMod.Row = layoutMod.row
hidden column: layoutMod.Column = layoutMod.column
/// The 12-column grid, the default top-level container.
hidden grid: layoutMod.Grid = layoutMod.grid
/// Space that takes what its row or column leaves: `(c.row) { children { a; c.spacer; b } }`.
hidden spacer: nodes.LayoutNode = layoutMod.spacer
/// The popup dialog; rarely written by hand (see `c.view.openPopupInline`).
hidden popup: surfaceMod.Popup = surfaceMod.popup
/// `(c.tabs) { tabs { ["Lights"] { ... } } }`.
hidden tabs: surfaces.Tabs = surfaces.tabs

// ---- mixins ----

/// `c.entityCard(x) |> c.tappable`.
hidden tappable: Mixin<entityMod.EntityCard> = entityMod.tappable
/// `c.entityCard(x) |> c.informative`.
hidden informative: Mixin<entityMod.EntityCard> = moreinfo.informative

// ---- the cards, as calls ----
// Real methods, since a function-valued property cannot be called as `c.f(x)`.
// `PklBuildSuite` checks this list against the family modules.

/// `c.title("Active now")`.
function title(t: String): textMod.SectionTitle = textMod.title(t)
/// A line of text in a tone: `c.label("Away until Monday")`.
function label(t: String): textMod.Label = textMod.label(t)
/// HA-like entity card: icon, label and value.
function entityCard(e: hass.Entity): entityMod.EntityCard = entityMod.entityCard(e)
/// An entity's id and every attribute it reports.
function entityInfo(e: hass.Entity): moreinfo.EntityInfo = moreinfo.entityInfo(e)
/// On/off control, styled as a switch.
function toggle(e: hass.Entity): control.Toggle = control.toggle(e)
/// `c.button("Close", c.view.closePopup())`, `c.button("Kjøkken", c.tap.toggle(l))`.
function button(l: String, a: tapMod.TapAction): buttonMod.Button = buttonMod.button(l, a)
/// A button about an entity — its name, its icon and its domain's tap:
/// `c.entityButton(l).active(c.isOn(l))`.
function entityButton(e: hass.Entity): control.EntityButton = control.entityButton(e)
/// A small button in its tap's look: `c.pill(c.tap.toggle(l))`, or
/// `c.pill(c.view.navigate("under")).label("⬇️ Under")`.
function pill(a: tapMod.TapAction): buttonMod.Pill = buttonMod.pill(a)
/// An entity for its domain's default axis, or a capability group for that
/// axis: `c.entitySlider(l.colourTemp)`.
function entitySlider(a: sliderMod.SlideAxis): sliderMod.EntitySlider = sliderMod.entitySlider(a)
/// An appliance mid-cycle, from its remaining-time sensor: a countdown, and a
/// bar where it also reports a programme length.
function progress(remaining: hass.SensorEntity): progressMod.ProgressCard =
  progressMod.progress(remaining)
/// A sensor's last 24 hours, drawn on the server; `.over("7d")` for another
/// window. Numeric sensors only (`e.isNumeric`).
function historyChart(e: hass.SensorEntity): historyMod.HistoryChart =
  historyMod.historyChart(e)
/// Now, low and high over the last 24 hours; `.over(…)` and `.fromChooser()` as
/// [[historyChart]].
function historyReadings(e: hass.SensorEntity): historyMod.HistoryReadings =
  historyMod.historyReadings(e)
/// A window bar over the charts beneath it:
/// `(c.windowChooser) { children { c.historyChart(s).fromChooser() } }`.
hidden windowChooser: selectMod.Chooser = historyMod.windowChooser
/// One main-control switch over the light sliders beneath it:
/// `(c.controlChooser) { children { c.entitySlider(l).fromChooser() } }`.
hidden controlChooser: selectMod.Chooser = sliderMod.controlChooser
/// A node variable named `name`, for a node's `vars` and a [[select]] below
/// it: `local shade = c.variable("shade")`.
function variable(name: String): varMod.Variable =
  let (n = name) new varMod.Variable { name = n }
/// One value for `t` — a node variable something above declares, a select
/// entity, or a light's `effects` — as buttons until `.style("dropdown")` or
/// `.style("cycle")`; `.options(…)` picks, orders and relabels them.
function select(t: selectMod.Target): selectMod.Select = selectMod.select(t)
/// A select of a node variable over the cards beneath it, declaring the
/// variable at its first option or `.defaultingTo(…)`:
/// `(c.chooser(c.select(view).options(List("simple", "detail")))) { children { … } }`.
function chooser(s: selectMod.Select): selectMod.Chooser = selectMod.chooser(s)
/// A section shown while `p` holds over live state.
function iff(p: pred.Predicate|Boolean|varMod.ValueIs): surfaces.If = surfaces.iff(p)
/// `c.expr(#"str(math.round(num(state) * 10.0) / 10.0) + ' V'"#)`.
function expr(s: String): slotMod.Expr = slotMod.expr(s)
/// [[expr]] over another entity than the card's.
function exprOf(eo: hass.Entity, s: String): slotMod.Expr = slotMod.exprOf(eo, s)
/// One live attribute of the card's entity:
/// `c.entityCard(l).secondary(c.attr("device_class"))`.
function attr(attrName: String): slotMod.Slot = slotMod.attr(attrName)
/// Whether `e`'s state is one of `states`, live:
/// `c.button(…).disabled(c.stateIn(l, List("open")))`.
function stateIn(e: hass.Entity, states: List<String>): slotMod.Slot = slotMod.stateIn(e, states)
/// Whether `e` is `on`, live: `c.entityButton(l).active(c.isOn(l))`.
function isOn(e: hass.Entity): slotMod.Slot = slotMod.stateIn(e, List("on"))
/// What `c.view.moreInfo(e)`'s popup holds.
function moreInfoBody(e: hass.Entity): layoutMod.Column = moreinfo.moreInfoBody(e)

// ---- constructors as values, for a query's render positions ----

hidden entityCard: (hass.Entity) -> entityMod.EntityCard = entityMod.entityCard
hidden toggle: (hass.Entity) -> control.Toggle = control.toggle
hidden entitySlider: (hass.Entity) -> sliderMod.EntitySlider = sliderMod.entitySlider

// ---- the library's index ----
//
// What this library ships, for reading a card's markup without building a
// node. A dashboard's registry is not this: it is the cards its tree uses
// (`entry.pkl`).

/// The modules that declare this library's card classes. Reflection sees only
/// classes a module declares, so the facade cannot stand in for the families.
const modules: List<Module> = List(
  layoutMod,
  textMod,
  entityMod,
  buttonMod,
  switchMod,
  tileMod,
  barBaseMod,
  control,
  sliderBaseMod,
  sliderMod,
  surfaces,
  surfaceMod,
  moreinfo,
  historyMod,
  selectMod,
  wheelMod
)

/// Every concrete card class in [[modules]], by card name. A class that
/// extends a card without naming its own IS that card (`EntityButton` is a
/// `button`), so it is not listed twice.
cards: Mapping<String, nodes.CardDef> = new {
  for (m in modules) {
    for (_, cls in reflect.Module(m).classes) {
      when (cls.isSubclassOf(nodeClass) && !cls.modifiers.contains("abstract")
        && cls.properties.containsKey("card")) {
        [cls.properties["card"].defaultValue as String] =
          cls.properties["cardDef"].defaultValue as nodes.CardDef
      }
    }
  }
}

const local nodeClass = reflect.Class(nodes.Node)
