/// The `history` provider, as `p.history`: one sensor's recorded past over a
/// window. A chart draws it (`c.history.chart`); a component's CEL reads it as
/// an input, `list(list(double))` of `[epochMillis, value]`, oldest
/// first:
///
///     inputs { ["past"] = p.history.of(left, p.history.raw(7.d)) }
///
/// The answer is every reading of a raw window and every bucket of a statistics
/// one; a chart thins what it draws. The author picks the window; the server
/// picks nothing (ADR 0031).
module providers.history

import "../core/slot.pkl" as slotMod
import "../core/variable.pkl" as varMod
import "../hass.pkl"

/// The question: one sensor over one window. The entity is never a variable,
/// because substituting it is an access question (ADR 0023).
class HistoryFetch extends slotMod.Fetch {
  provider = "history"
  hidden sensor: hass.SensorEntity
  fixed entity: String = sensor.entity_id
  window: Over

  /// Whatever reads this is read again when the sensor changes: a decision
  /// over it is made again, a slot re-rendered. Off, a history is read again
  /// only when something else it is read with moves.
  function updateOnEntityChange(): this =
    (this) { dependsOn = List(entity) }
}

/// `e` over `w`.
const function of(e: hass.SensorEntity, w: Over): HistoryFetch =
  new HistoryFetch { sensor = e; window = w }

/// A window written down, or one a node variable chooses.
typealias Over = Window|Chosen

/// Build with [[raw]] or [[statistics]] (`fh.view.history.Window`).
abstract class Window {
  kind: String
  /// Seconds; [[raw]] and [[statistics]] take a `Duration`.
  span: Int(isPositive)
}

class Raw extends Window {
  kind: "Raw" = "Raw"
}

typealias Period = "5minute"|"hour"|"day"|"week"|"month"|"year"

class Statistics extends Window {
  kind: "Statistics" = "Statistics"
  period: Period
  /// Read raw rows instead when there are no statistics: only an entity with a
  /// `state_class` has any, and without this such a chart draws nothing.
  fallback: Boolean = false

  function orRaw(): this = let (self = this) (self) { fallback = true }
}

/// A window picked by what `by` reads: the case whose `is` it equals, else
/// `otherwise`, else none, and a chart with no window draws its default. `by`
/// is any reading of text, a bool or a whole number: a node variable's value,
/// or an entity's state, decided once per state change. With no `otherwise`,
/// the server refuses a viewer's value no case takes.
class Chosen {
  kind: "Chosen" = "Chosen"
  by: slotMod.Expr
  cases: Listing<Case>
  otherwise: Window? = null
}

/// One of a [[Chosen]]'s windows, and the key that picks it.
class Case {
  `is`: String|Boolean|Int
  value: Window
}

/// `d` of the recorder's raw rows: every reading. HA keeps them
/// `purge_keep_days` (10 by default).
const function raw(d: Duration): Raw = new Raw { span = seconds(d) }

/// `d` of HA's statistics at `p`: each bucket's mean, else a total sensor's
/// reading, at the bucket's end. Hourly and longer are kept forever; the
/// period must be shorter than `d`.
const function statistics(d: Duration, p: Period): Statistics =
  new Statistics { span = seconds(d); period = p }

/// `v`'s value picks one of `table`.
const function chosen(v: varMod.Variable, table: Mapping<String, Window>): Chosen =
  new Chosen {
    by = v.value
    cases { for (k, w in table) { new Case { `is` = k; value = w } } }
  }

/// More-info's windows, and `c.history.chooser`'s: an hour of raw rows, then
/// statistics, falling back to raw rows for a sensor without any.
const presets: Mapping<String, Window> = new {
  ["1h"] = raw(1.h)
  ["24h"] = statistics(24.h, "5minute").orRaw()
  ["7d"] = statistics(7.d, "hour").orRaw()
  ["30d"] = statistics(30.d, "hour").orRaw()
}

const local function seconds(d: Duration): Int = d.toUnit("s").value.toInt()
