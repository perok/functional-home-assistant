/// One dashboard: the card registry and the theme, so an entry sets `card`
/// (and optionally `title`, `surfaces`, `theme`, `access`) and nothing else.
///
/// Reached through `site.pkl`'s `dashboards`, inline (`["home"] { card = ... }`)
/// or as a module that amends this one and is imported into a key. The slug is
/// the key, never the file name (ADR 0021).
module entry

import "components.pkl" as c
import "core/access.pkl" as accessMod
import "core/css.pkl" as cssMod
import "core/text.pkl" as textMod
import "theme-beer.pkl" as themeMod

/// The modules whose card classes this dashboard can use. The library's are
/// always here; add yours:
///
///   import "@fh-dashboard/components.pkl" as c
///   import "mycards.pkl" as mine
///   componentModules { mine }
///   card = (c.column) { children { mine.gauge(...) } }
///
/// Explicit, because Pkl reflection sees an import only as a URI string and
/// cannot find your cards on its own. A module you forget is a "card not
/// found" at build time. Cards must live in a module of their own: a class
/// inline in an entry must be `local`, which reflection cannot see.
hidden componentModules: Listing<Module> = new {
  for (m in c.modules) { m }
}

/// The card registry from [[componentModules]].
cards = c.cardsOf(componentModules.toList())

/// What every card here does with a label longer than its box: `wrap`, `clip`
/// (the default) or `scroll` (`core/text.pkl`). One card differs with
/// `.textOverflow(…)`.
hidden textOverflow: textMod.Overflow = textMod.defaultOverflow

/// The base CSS (`core/css.pkl`), assigned here so a theme cannot drop it
/// (ADR 0020). [[textOverflow]] lands last, at `:root`, so any node naming a
/// mode of its own still wins.
css = cssMod.baseCss + "\n" + textMod.rootCss(textOverflow)

/// BeerCSS Material 3 (`theme-beer.pkl`). Swap with
/// `theme = import("theme-mine.pkl").theme`, or amend:
/// `theme { md3Light { ["primary"] = "#..." } }`.
theme = themeMod.theme

/// The page `<title>`; null falls back to the slug.
title: String? = null

/// Popups opened by `openPopup(id)`. Inline popups and tab panels are hoisted
/// in at build time, so most entries leave this empty. A popup amends into
/// existence:
///   surfaces { ["detail"] { body { c.title("...") c.entityCard(e) } } }
/// Anything else is `["x"] = new c.SurfaceDef { ... }`.
surfaces: Mapping<String, c.SurfaceDef> = new { default = (_) -> new c.PopupSurface {} }

/// Who may see this dashboard (#89); null inherits the site's rule. HA is the
/// identity provider (`core/access.pkl`).
///
///     access = c.access.public                       // a hallway tablet
///     access = c.access.admin                        // the admin-only one
///     access = c.access.users(List(dump.users.peri))  // just these people
access: accessMod.Access? = null

/// The root of the layout tree. Forgetting it reports "Tried to read property
/// `card` but its value is undefined" with the caret on THIS line, not yours;
/// the trailing "rendering path `dashboards[<slug>].card`" names the dashboard.
card: c.Node
