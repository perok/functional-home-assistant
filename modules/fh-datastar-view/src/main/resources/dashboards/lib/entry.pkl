/// ONE dashboard: the scaffold that used to be copy-pasted into each entry —
/// the reflected card registry and the shared theme — so a dashboard is written
/// as `card` (plus an optional `title`/`surfaces`, or a `theme` override) and
/// nothing else.
///
/// You reach this module through `site.pkl`'s `dashboards` mapping, either
/// inline (`["home"] { card = ... }`) or as a file of its own that
/// `amends "@fh-dashboard/entry.pkl"` and is imported into a key. The SLUG is
/// that mapping key — never the filename (ADR 0021).
///
/// `title` feeds the page `<title>` (Server falls back to the slug when null);
/// `omitNullProperties` drops it from the wire JSON when left unset.
///
/// AUTHORING NOTE — the required `card`: because `card` has no default here, a
/// dashboard that forgets to set it fails with
///   "Tried to read property `card` but its value is undefined"
/// whose caret points at THIS module's `card` line (below), NOT at your own
/// source (Pkl reports a missing required property at the class/base definition
/// — see the CLAUDE.md Pkl gotchas). The trailing "occurred when rendering path
/// `dashboards[<slug>].card`" names WHICH dashboard, though. The fix is there:
/// assign `card = new c.Column { ... }` (or another `c.Node`).
module entry

import "components.pkl" as c
import "core/access.pkl" as accessMod
import "core/css.pkl" as cssMod
import "theme-beer.pkl" as themeMod

/// The component modules whose card classes this dashboard can use. The
/// authoring library is always here; ADD a module to use cards it defines:
///
///   import "@fh-dashboard/components.pkl" as c
///   import "mycards.pkl" as mine
///   componentModules { mine }
///   card = (c.column) { children { mine.gauge(...) } }
///
/// Why this is explicit rather than inferred from your imports: Pkl reflection
/// exposes an import only as a URI string and cannot turn one back into a
/// module, so the library has no way to find your cards unless you name them.
/// Forgetting to register a module you use is a "card not found" from
/// `Dashboard.validate` at build time, not a broken dashboard at runtime.
///
/// Your cards must live in their own module (not inline in this entry): classes
/// in an amending module need `local`, and `local` classes are invisible to
/// reflection, so an inline card class would never register.
hidden componentModules: Listing<Module> = new {
  for (m in c.modules) { m }
}

/// The reflected card registry (each card class's template, slots and CSS),
/// collected from [[componentModules]]. Two modules claiming one card name is an
/// error.
///
/// Built with the THEME, because this is the one point where a theme's own class
/// names reach card markup (`core/node.pkl`'s `cardsWith` — the spinner is
/// today's only user). A card's markup is a class-level default that cannot see
/// the theme; the registry is an ordinary call that can.
cards = c.cardsWith(componentModules.toList(), theme.classes)

/// The CSS every dashboard gets whatever its theme: the `fh-` layout contract,
/// the `--fh-*` variables the cards read, and the classes the runtime itself
/// emits (`core/css.pkl`). Assigned here rather than reached through the theme
/// precisely so a theme cannot drop it — it may only override it, since the
/// renderer emits it first (ADR 0020).
css = cssMod.baseCss

/// The shared theme — BeerCSS Material Design 3 (`theme-beer.pkl`; see
/// `theme.pkl` for the contract + roster). Override in an entry that wants a
/// different look (`theme = (import "lib/theme-mine.pkl").theme`, any module
/// exporting a `theme.pkl` Theme) or retune
/// this one by amending (`theme { md3Light { ["primary"] = "#..." } }`).
theme = themeMod.theme

/// The page `<title>`; null (the default, dropped from the wire JSON) means the
/// Server falls back to the dashboard's slug.
title: String? = null

/// Registered popup surfaces (opened by an `openPopup(id)` tap). Inline popups
/// and tab panels ride on their node's `inlineSurfaces` and are hoisted into
/// this registry at build time, so most entries leave this empty.
///
/// The mapping DEFAULT is a [[c.PopupSurface]], so a popup surface amends into
/// existence — no `new`, and the [[c.Popup]] dialog wrap is automatic:
///   surfaces { ["detail"] { body { c.title("...") c.entityCard(e) } } }
/// A non-popup surface is an explicit `["x"] = new c.SurfaceDef { ... }`.
surfaces: Mapping<String, c.SurfaceDef> = new { default = (_) -> new c.PopupSurface {} }

/// Who may see this dashboard (issue #89). `null` — the default — means
/// "whatever the site says", so the rule is written in ONE place unless a
/// particular dashboard differs:
///
///     access = c.access.public                       // a hallway tablet
///     access = c.access.admin                        // the admin-only one
///     access = c.access.users(List(dump.users.peri))  // just these people
///
/// Home Assistant is the identity provider — these are HA's users and HA's
/// admin role, not a second account system (see `core/access.pkl`).
///
/// `omitNullProperties` drops it from the wire JSON when unset, which is what
/// lets the backend tell "inherit the site's" apart from "this dashboard really
/// does want the default".
access: accessMod.Access? = null

/// The root of the layout tree — the ONE property every entry must set (see the
/// authoring note above about the error location when it is forgotten).
card: c.Node
