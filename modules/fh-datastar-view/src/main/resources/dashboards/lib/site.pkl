/// The one entrypoint (ADR 0021): a workspace's `site.pkl` amends this and
/// names every dashboard it serves. A dashboard is data here, so a hundred can
/// come from a loop, and adding one is an edit that hot-reloads.
///
///     amends "@fh-dashboard/site.pkl"
///     import "@fh-dashboard/components.pkl" as c
///
///     default = "home"
///     dashboards {
///       ["home"] { title = "Home"; card = (c.grid) { children { ... } } }
///       ["kitchen"] = import("kitchen.pkl")   // a module that amends entry.pkl
///     }
///
/// Any other `*.pkl` beside it is an ordinary module.
module site

import "entry.pkl"
import "core/access.pkl" as accessMod

/// Every dashboard, keyed by slug — the key is the route (`/d/<slug>`). Amend
/// a key into existence (`["home"] { card = ... }`), or assign a module that
/// amends `entry.pkl` with the CALL form, `import("kitchen.pkl")`; the
/// declaration form does not parse here. A comprehension works too:
/// `for (f in dump.floors.all) { [f.floor_id] { card = floorCard(f) } }`.
dashboards: Mapping<String, entry> = new { default = (_) -> (entry) {} }

/// The slug served at `/`. Null, or a slug not in [[dashboards]], means the
/// key `dashboard`, else the first key.
default: String? = null

/// Who may see every dashboard that does not set its own `access` (#89). A
/// logged-in HA user by default, since every dashboard shows somebody's home.
/// `c.access.public` makes a page open to anyone who can reach this server,
/// with buttons that still act on the home.
access: accessMod.Access = accessMod.authenticated
