/// The house-wide namespaces every generated dump has, as a contract rather
/// than whatever `PklDump` emits (ADR 0013). The seeded starter site names no
/// entity, only queries over these, so a namespace the generator stopped
/// emitting would fail somebody's first boot; a declaration whose lists default
/// to `List()` answers an empty house instead.
///
/// Each answers `all`, as `dump.floors` and an area do, and names its members:
///
///     q.from(dump.lights.all)                       // the house
///     dump.scenes.kveld                             // one, by its object id
///     q.from(hass.lights(dump.areas.stue.all))      // one room
///
/// The generator subclasses each one it has members for and fills
/// `allWithHidden`; `all` derives from it here. Which namespace an entity lands
/// in is the generator's call, so `PklBuildSuite` holds each `all` equal to its
/// selector over `dump.entities.all`. `areas`/`floors`/`devices`/`users` are
/// typed per home and declared by the generator alone.
///
/// `open`, because the dump `extends` it: `amends` would forbid its class
/// declarations.
open module dumpBase

import "../hass.pkl"

/// Every entity, by its key (`dump.entities.light_kitchen`): the house's
/// scope, so `all` is every entity HA does not hide, in entity-id order.
open class EntityNamespace {
  hidden allWithHidden: List<hass.Entity> = List()
  hidden all: List<hass.Entity> = hass.shown(allWithHidden)
}

// One per selector in `hass.pkl`, typed, since a class cannot take a type
// parameter. Members are named by object id (`dump.lights.kitchen`).

open class LightNamespace {
  hidden allWithHidden: List<hass.LightEntity> = List()
  hidden all: List<hass.LightEntity> = hass.lights(hass.shown(allWithHidden))
}

open class LockNamespace {
  hidden allWithHidden: List<hass.LockEntity> = List()
  hidden all: List<hass.LockEntity> = hass.locks(hass.shown(allWithHidden))
}

open class SensorNamespace {
  hidden allWithHidden: List<hass.SensorEntity> = List()
  hidden all: List<hass.SensorEntity> = hass.sensors(hass.shown(allWithHidden))
}

open class BinarySensorNamespace {
  hidden allWithHidden: List<hass.BinarySensorEntity> = List()
  hidden all: List<hass.BinarySensorEntity> =
    hass.binarySensors(hass.shown(allWithHidden))
}

open class SwitchNamespace {
  hidden allWithHidden: List<hass.SwitchEntity> = List()
  hidden all: List<hass.SwitchEntity> = hass.switches(hass.shown(allWithHidden))
}

open class SceneNamespace {
  hidden allWithHidden: List<hass.SceneEntity> = List()
  hidden all: List<hass.SceneEntity> = hass.scenes(hass.shown(allWithHidden))
}

open class ScriptNamespace {
  hidden allWithHidden: List<hass.ScriptEntity> = List()
  hidden all: List<hass.ScriptEntity> = hass.scripts(hass.shown(allWithHidden))
}

open class ButtonNamespace {
  hidden allWithHidden: List<hass.ButtonEntity> = List()
  hidden all: List<hass.ButtonEntity> = hass.buttons(hass.shown(allWithHidden))
}

open class InputButtonNamespace {
  hidden allWithHidden: List<hass.InputButtonEntity> = List()
  hidden all: List<hass.InputButtonEntity> =
    hass.inputButtons(hass.shown(allWithHidden))
}

open class ClimateNamespace {
  hidden allWithHidden: List<hass.ClimateEntity> = List()
  hidden all: List<hass.ClimateEntity> = hass.climates(hass.shown(allWithHidden))
}

open class FanNamespace {
  hidden allWithHidden: List<hass.FanEntity> = List()
  hidden all: List<hass.FanEntity> = hass.fans(hass.shown(allWithHidden))
}

/// Every entity no other namespace claims. No members by name: they span
/// domains, so an object id is not unique here; `dump.entities` names them.
open class GenericNamespace {
  hidden allWithHidden: List<hass.Entity> = List()
  hidden all: List<hass.Entity> = hass.generic(hass.shown(allWithHidden))
}

entities: EntityNamespace = new {}
lights: LightNamespace = new {}
locks: LockNamespace = new {}
sensors: SensorNamespace = new {}
binarySensors: BinarySensorNamespace = new {}
switches: SwitchNamespace = new {}
scenes: SceneNamespace = new {}
scripts: ScriptNamespace = new {}
buttons: ButtonNamespace = new {}
inputButtons: InputButtonNamespace = new {}
climates: ClimateNamespace = new {}
fans: FanNamespace = new {}
generic: GenericNamespace = new {}
