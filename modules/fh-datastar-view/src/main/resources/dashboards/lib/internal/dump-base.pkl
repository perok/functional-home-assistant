/// The house-wide lists every generated dump has, as a contract rather than
/// whatever `PklDump` emits (ADR 0013). The seeded starter site names no
/// entity, only queries over these, so a list the generator stopped emitting
/// would fail somebody's first boot; a declaration with a `List()` default
/// answers an empty house instead.
///
/// Only the house carries per-domain lists. A smaller scope answers `all`, and
/// a selector takes the domain out of it:
///
///     q.from(dump.lights)                          // the house
///     q.from(hass.lights(dump.areas.stue.all))     // one room
///
/// Only `allWithHidden` is generated; the rest derive through the functions an
/// author calls, so the two cannot disagree. `entities`/`areas`/`floors`/…
/// are typed per home and declared by the generator.
///
/// `open`, because the dump `extends` it: `amends` would forbid its class
/// declarations.
open module dumpBase

import "../hass.pkl"

/// Every entity, hidden ones included, in entity-id order: the one list the
/// generator fills.
hidden allWithHidden: List<hass.Entity> = List()

/// [[allWithHidden]] minus the entities hidden in HA. Every list below derives
/// from it.
hidden all: List<hass.Entity> = hass.shown(allWithHidden)

/// In entity-id order; sort with plain Pkl before `from` for another.
hidden lights: List<hass.LightEntity> = hass.lights(all)
hidden locks: List<hass.LockEntity> = hass.locks(all)
hidden sensors: List<hass.SensorEntity> = hass.sensors(all)
hidden binarySensors: List<hass.BinarySensorEntity> = hass.binarySensors(all)
hidden switches: List<hass.SwitchEntity> = hass.switches(all)
/// Every entity no other list claims.
hidden generic: List<hass.Entity> = hass.generic(all)
