/// Queries over a STATIC candidate set, for what plain composition cannot say:
/// filtering on live state, and presence. A fixed list is still plain Pkl —
///
///     for (light in hass.lights(dump.areas.stue.all)) { c.entitySlider(light) }
///
/// — and reaching for `q.from(...)` there buys nothing.
///
/// The candidates are decided at build time from the dump (ADR 0003): a
/// registry fact such as `area_id == "stue"` selects candidates and never
/// reaches the wire, and only conditions on live state survive, as per-member
/// guards. The runtime decides presence and order, nothing else.
///
///     q.from(hass.lights(dump.areas.stue.all))
///       .where(q.eq(q.stateProp, "on"))
///       .render((e) -> c.entitySlider(e))
///
/// Not here yet: a set nested inside a member, and `min`/`max` over a property.
module query

import "core/predicate.pkl" as pred
import "core/node.pkl" as nodes
import "hass.pkl"

typealias Scalar = String|Int|Float|Boolean

// ---- boolean structure -----------------------------------------------------
//
// A list is conjunction, so `where` takes one directly; `any`/`all`/`not`
// nest freely:
//
//   .where(q.any(List(q.candidate((e) -> e.dimmable), q.eq(q.stateProp, "on"))))
//
// `&&`/`||` do not cross the seam: Pkl rejects `Boolean && Cmp`, which keeps a
// live condition out of a static position.

/// Everything that can appear where a condition is expected, resolved or not.
/// The two positions that would make the alias cyclic take `Any`.
typealias Cond = Boolean|pred.Predicate|Pending|CandidateTerm|Group

/// A comparison whose key is not resolved yet: it folds to a `Boolean` on a
/// registry fact, or becomes a live `pred.Cmp`.
class Pending {
  key: PropName
  op: pred.PredicateOp
  value: Scalar
}

/// A term computed from the candidate. A term rather than a bare lambda, so it
/// composes: inside `any`/`all`/`not` a lambda has no candidate in scope.
class CandidateTerm {
  fn: (hass.Entity) -> Any
}

/// A group with an unresolved operand. [[all]]/[[any]]/[[not]] fold
/// immediately when they can, so an author never picks an eager or lazy form.
class Group {
  gop: "all"|"any"|"not"
  items: List<Any>
}

const local function isResolved(xs: List<Cond>): Boolean =
  xs.every((i) -> i is Boolean || i is pred.Predicate)

function all(xs: List<Cond>): Cond =
  if (isResolved(xs)) foldAll(xs as List<Boolean|pred.Predicate>)
  else new Group { gop = "all"; items = xs }

/// A statically-true term short-circuits the whole thing, which is why presence
/// residuals can differ between members of one set.
function any(xs: List<Cond>): Cond =
  if (isResolved(xs)) foldAny(xs as List<Boolean|pred.Predicate>)
  else new Group { gop = "any"; items = xs }

function not(x: Cond): Cond =
  if (x is Boolean) !x
  else if (x is pred.Predicate) new pred.PNot { item = x }
  else new Group { gop = "not"; items = List(x) }

// Both folds canonicalise — flatten same-kind nesting, dedupe, unwrap a single
// survivor — so a presence residual equal to a branch guard is not evaluated
// twice. One level suffices, since every group is built through these.
const local function flatten(
  gop: String, ts: List<pred.Predicate>
): List<pred.Predicate> =
  ts.flatMap((t) ->
    if (gop == "and" && t is pred.PAnd) t.items.toList()
    else if (gop == "or" && t is pred.POr) t.items.toList()
    else List(t)).distinct

const local function listing(ts: List<pred.Predicate>): Listing<pred.Predicate> =
  new Listing { for (t in ts) { t } }

const local function foldAll(xs: List<Boolean|pred.Predicate>): Boolean|pred.Predicate =
  if (xs.any((i) -> i is Boolean && i == false)) false
  else
    let (rest = flatten("and", xs.filter((i) -> i is pred.Predicate) as List<pred.Predicate>))
      if (rest.isEmpty) true
      else if (rest.length == 1) rest.first
      else new pred.PAnd { items = listing(rest) }

const local function foldAny(xs: List<Boolean|pred.Predicate>): Boolean|pred.Predicate =
  if (xs.any((i) -> i is Boolean && i == true)) true
  else
    let (rest = flatten("or", xs.filter((i) -> i is pred.Predicate) as List<pred.Predicate>))
      if (rest.isEmpty) false
      else if (rest.length == 1) rest.first
      else new pred.POr { items = listing(rest) }

// ---- property references, shared by predicates and ordering -----------------
//
// A property is named, and the BUILD decides where it comes from: a registry
// fact when every candidate carries it, a live attribute otherwise
// (`friendly_name` is both).

open class PropName {
  name: String
  /// Allow the property to be missing on some candidates (it reads as null).
  /// Without it, mixed availability is a build error: the name would be a
  /// registry fact for some members and a live attribute for others.
  optional: Boolean = false
}

/// Forces the live reading of a name that is also a registry fact.
class LiveAttr extends PropName {}

function prop(n: String): PropName = new { name = n }

function attr(n: String): LiveAttr = new { name = n }

function optional(p: PropName): PropName = (p) { optional = true }

const stateProp: PropName = new PropName { name = "state" }

/// See [[CandidateTerm]].
function candidate(f: (hass.Entity) -> Cond|List<Cond>): CandidateTerm =
  new { fn = f }

/// A live attribute name, checked against what the candidates can report, so a
/// typo fails the build instead of never matching. Only candidates with a
/// non-empty schema are checked: empty means the domain is not modelled yet
/// (ADR 0013).
const local function checkLive(items: List<hass.Entity>, name: String): String =
  let (modelled = items.filter((e) -> !e.volatileAttrs.isEmpty))
    if (modelled.isEmpty || modelled.any((e) -> e.volatileAttrs.containsKey(name)))
      "attr:" + name
    else
      throw("""
        No candidate can report a live attribute called '\(name)'.

        The ones that could say what they report list: \(
          modelled
            .flatMap((e) -> e.volatileAttrs.keys.toList())
            .distinct
            .sort()
            .join(", ")
        ).

        If this is a real attribute the schema does not model yet — an
        integration-specific one such as `off_brightness` — write
        `q.attr("\(name)")`, which means "a live attribute, unchecked".
        """)

/// ALL candidates have it => a registry fact; NONE => a live attribute; SOME
/// => a build error unless `optional`.
const local function resolveProp(items: List<hass.Entity>, p: PropName): String =
  if (p.name == "state") "state"
  else if (p is LiveAttr) "attr:" + p.name
  else
    let (have = items.filter((e) -> e.hasProperty(p.name)).length)
      if (items.isEmpty || have == 0) checkLive(items, p.name)
      else if (have == items.length) "reg:" + p.name
      else if (p.optional) "reg:" + p.name
      else throw("""
        Property '\(p.name)' is present on \(have) of \(items.length) candidates.
        That is ambiguous: it would be a registry fact for some members and a
        live attribute for others. Either narrow the candidates so every one
        carries it, or wrap it in `q.optional(...)` to accept a null where it is
        missing.
        """)

const local function isBuildReadable(items: List<hass.Entity>, p: PropName): Boolean =
  resolveProp(items, p).startsWith("reg:")

const local function applyOp(cmpOp: String, l: Any, r: Any): Boolean =
  if (cmpOp == "eq") l == r
  else if (cmpOp == "ne") l != r
  else if (cmpOp == "gt") l > r
  else if (cmpOp == "gte") l >= r
  else if (cmpOp == "lt") l < r
  else if (cmpOp == "lte") l <= r
  else throw("unknown comparison operator '\(cmpOp)'")

// ---- comparisons: the same terms work in `where` and in `orderBy` ----------

const local function cmp(k: PropName, cmpOp: pred.PredicateOp, v: Scalar): Pending =
  new { key = k; op = cmpOp; value = v }

function eq(k: PropName, v: Scalar): Pending = cmp(k, "eq", v)
function ne(k: PropName, v: Scalar): Pending = cmp(k, "ne", v)
function gt(k: PropName, v: Scalar): Pending = cmp(k, "gt", v)
function lt(k: PropName, v: Scalar): Pending = cmp(k, "lt", v)

// ---- naming another entity --------------------------------------------------

/// A term about a DIFFERENT entity than the member, named at build time and
/// tested live:
///
///     q.candidate((e) -> q.entity(motionSensorFor(e.area_id)).stateIs("on"))
class EntityRef {
  id: String
  /// The dump entity the property is checked against; null for a computed id.
  hidden source: hass.Entity?

  function stateIs(s: String): pred.Cmp = cmpOn(id, source, stateProp, "eq", s)
  function stateIsNot(s: String): pred.Cmp = cmpOn(id, source, stateProp, "ne", s)
  function eq(k: PropName, v: Scalar): pred.Cmp = cmpOn(id, source, k, "eq", v)
  function ne(k: PropName, v: Scalar): pred.Cmp = cmpOn(id, source, k, "ne", v)
  function gt(k: PropName, v: Scalar): pred.Cmp = cmpOn(id, source, k, "gt", v)
  function lt(k: PropName, v: Scalar): pred.Cmp = cmpOn(id, source, k, "lt", v)
}

/// Prefer the typed dump entity — `q.entity(dump.e_taklys)` — so a typo is a
/// Pkl error and the property is checked against it. A String is accepted for
/// computed ids.
function entity(e: hass.Entity|String): EntityRef =
  if (e is String) new { id = e; source = null }
  else new { id = (e as hass.Entity).entity_id; source = e }

// Always live: the build knows which entity, never its state. A name the given
// entity does not carry only warns, until volatile attributes are checkable.
const local function cmpOn(
  who: String, src: hass.Entity?, k: PropName, cmpOp: pred.PredicateOp, v: Scalar
): pred.Cmp =
  let (_checked =
        if (src != null && k.name != "state" && !src.hasProperty(k.name))
          trace("fh: '\(k.name)' is not a property of \(who) — assuming a live attribute") != null
        else true)
    new {
      entity = who
      property = if (k.name == "state") "state" else "attr:" + k.name
      op = cmpOp
      value = v
    }

// ---- ordering ---------------------------------------------------------------
//
// A list of positions rather than a lambda: an ordering key is the same
// reference for every member. For a computed ordering, sort the input list
// before `from`.

/// One ordering position. `by` is a property (sort by its value) or a
/// comparison (sort by whether it holds).
class OrderSpec {
  by: PropName|Pending
  dir: "asc"|"desc" = "asc"
}

function asc(k: PropName|Pending): OrderSpec = new { by = k; dir = "asc" }
function desc(k: PropName|Pending): OrderSpec = new { by = k; dir = "desc" }

// `const` because [[EntitySet.orderBy]] calls it from a class body.
const local function spec(k: OrderSpec|PropName|Pending): OrderSpec =
  if (k is OrderSpec) k else new OrderSpec { by = k as (PropName|Pending) }

const local function specKey(s: OrderSpec): PropName =
  if (s.by is Pending) (s.by as Pending).key else s.by as PropName

/// What the build sorted, and what the runtime must still compare.
class Ordering {
  entities: List<hass.Entity>
  terms: List<pred.SortTerm>
}

// A build-readable position is sorted now and emits nothing. Registry keys may
// follow the live ones — pre-sorting supplies the tiebreak, since the runtime's
// sort is stable — but not precede them: the runtime has no registry.
const local function foldOrder(
  items: List<hass.Entity>, specs: List<OrderSpec>
): Ordering =
  if (specs.isEmpty || items.isEmpty) new Ordering { entities = items; terms = List() }
  else
    let (liveAt = specs.findIndexOrNull((s) -> !isBuildReadable(items, specKey(s))))
      if (liveAt == null)
        new Ordering { entities = sortNow(items, specs); terms = List() }
      else
        let (leading = specs.take(liveAt + 1))
        let (trailing = specs.drop(liveAt + 1))
          if (leading.any((s) -> isBuildReadable(items, specKey(s))))
            throw("""
              Cannot order by '\(leading.findOrNull((s) -> isBuildReadable(items, specKey(s))).ifNonNull((s) -> specKey(s).name))'
              before the live key '\(specKey(specs[liveAt]).name)'. A registry
              fact that outranks a live value would have to be resolved by the
              runtime, which holds no registry. Put the registry keys LAST (they
              are then the tiebreak, and the build supplies it), or sort the
              input list with ordinary Pkl before `from`.
              """)
          else
            new Ordering {
              entities = sortNow(items, trailing)
              terms = specs.take(liveAt + 1).map((s) -> liveTerm(items, s))
            }

// Stable sorts from the least significant key outwards. `desc` compares the
// other way rather than reversing, which would also reverse the ties.
const local function sortNow(
  items: List<hass.Entity>, specs: List<OrderSpec>
): List<hass.Entity> =
  specs.reverse().fold(items, (acc, s) ->
    // Outside `sortWith`, or the key resolves O(n log n) times.
    let (prepared = if (s.by is Pending) ready(items, s.by as Pending) else null)
      acc.sortWith((x, y) ->
        let (a = orderValue(prepared, items, s, x))
          let (b = orderValue(prepared, items, s, y))
            if (s.dir == "desc") a > b else a < b))

// A comparison sorts on its truth; `desc` puts true first, matching the
// runtime's `holds` ordering.
const local function orderValue(
  prepared: Ready?, items: List<hass.Entity>, s: OrderSpec, e: hass.Entity
): String|Int|Float|Boolean =
  if (prepared != null) decide(prepared, items, e) as Boolean
  else e.getProperty((s.by as PropName).name) as (String|Int|Float|Boolean)

const local function liveTerm(
  items: List<hass.Entity>, s: OrderSpec
): pred.SortTerm =
  new {
    by =
      if (s.by is Pending)
        let (pd = s.by as Pending)
          new pred.SortHolds {
            predicate = new pred.Cmp {
              property = resolveProp(items, pd.key)
              op = pd.op
              value = pd.value
            }
          }
      else new pred.SortProp { property = resolveProp(items, s.by as PropName) }
    dir = s.dir
  }

// ---- the set ----------------------------------------------------------------

class Branch {
  key: (hass.Entity) -> Boolean|pred.Predicate
  render: (hass.Entity) -> nodes.Node
}

/// What [[EntitySet.where]] and [[EntitySet.caseOf]] accept: a condition, a
/// [[candidate]] term, a list of either (conjunction), or a lambda over the
/// candidate.
typealias Filter = ((hass.Entity) -> Cond|List<Cond>)|Cond|List<Cond>

/// A chainable candidate set. Each method returns an amended copy; nothing is
/// evaluated until [[build]].
class EntitySet {
  hidden items: List<hass.Entity>
  hidden filters: List<Filter> = List()
  hidden branches: List<Branch> = List()
  hidden specs: List<OrderSpec> = List()
  hidden cap: Int? = null

  /// Keep the candidates matching `f`. Static terms drop candidates at build
  /// time; live ones become the member's guard.
  function where(f: Filter): EntitySet =
    let (l = this) (l) { filters = l.filters.add(f) }

  /// Lexicographic, most significant first.
  function orderBy(
    ks: List<OrderSpec|PropName|Pending>|OrderSpec|PropName|Pending
  ): EntitySet =
    let (l = this)
      let (asList = if (ks is List) ks as List<OrderSpec|PropName|Pending> else List(ks))
        (l) { specs = l.specs + asList.map((k) -> spec(k)) }

  /// At most `n` present members, after ordering. Every candidate still ships:
  /// only the runtime knows which are cut.
  function limit(n: Int(this > 0)): EntitySet = let (l = this) (l) { cap = n }

  /// One guarded rendering; the guard folds like [[where]]'s.
  function caseOf(g: Filter, r: (hass.Entity) -> nodes.Node): EntitySet =
    let (l = this)
      let (prepared = ready(l.items, g))
        (l) {
          branches = l.branches.add(new Branch {
            key = (e) -> decide(prepared, l.items, e)
            render = r
          })
        }

  /// Several guarded renderings, in match order.
  function cases(m: Mapping<Filter, (hass.Entity) -> nodes.Node>): EntitySet =
    let (l = this)
      (l) {
        branches = l.branches + m.toMap().entries.map((p) ->
          let (prepared = ready(l.items, p.key))
            new Branch { key = (e) -> decide(prepared, l.items, e); render = p.value })
      }

  /// The unconditional last clause. Optional: a candidate matching no clause is
  /// not rendered, which is how "show it only while on" is written.
  function `else`(r: (hass.Entity) -> nodes.Node): EntitySet = caseOf(true, r)

  function render(r: (hass.Entity) -> nodes.Node): EntitySet = caseOf(true, r)

  /// How many candidates are present: `.count().gt(2)`. Reads only `where`, so
  /// a set can be counted without a card.
  function count(): CountRef =
    let (l = this)
      new {
        residuals =
          let (prepared = l.filters.map((f) -> ready(l.items, f)))
            l.items
              .map((e) ->
                Pair(e.entity_id, foldAll(prepared.map((r) -> decide(r, l.items, e)))))
              .filter((p) -> !(p.second is Boolean && p.second == false))
      }

  function any(): Cond = count().gt(0)
  function none(): Cond = count().eq(0)
  function all(): Cond = let (l = this) count().eq(l.count().residuals.length)

  /// The layout node. Pkl has no implicit conversion, so a chain ends here.
  function build(): pred.SetNode =
    let (l = this)
      let (ordering = foldOrder(l.items, l.specs))
        let (prepared = l.filters.map((f) -> ready(l.items, f)))
          buildSet(
            ordering,
            l.items,
            l.branches,
            l.cap,
            (e) -> foldAll(prepared.map((r) -> decide(r, l.items, e))))
}

function from(xs: List<hass.Entity>): EntitySet = new EntitySet { items = xs }

/// A count waiting to be compared. Comparing it yields a condition, or a
/// constant when no candidate's presence depends on live state — so `.any()`
/// on a room with no lights is `false` at build time and its card is dropped.
class CountRef extends pred.Tally {
  /// Candidate id -> `true` if the build settled it, else its live predicate.
  hidden residuals: List<Pair<String, Boolean|pred.Predicate>>
  candidates = new Listing { for (p in residuals) { p.first } }
  `when` = new Mapping {
    for (p in residuals) {
      when (p.second is pred.Predicate) {
        [p.first] = p.second as pred.Predicate
      }
    }
  }

  hidden knownCount: Int? =
    if (residuals.every((p) -> p.second == true)) residuals.length else null

  function gt(v: Int): Cond = let (l = this) l.compareTo("gt", v)
  function lt(v: Int): Cond = let (l = this) l.compareTo("lt", v)
  function eq(v: Int): Cond = let (l = this) l.compareTo("eq", v)
  function ne(v: Int): Cond = let (l = this) l.compareTo("ne", v)

  function compareTo(cmpOp: pred.PredicateOp, v: Int): Cond =
    let (l = this)
      if (l.knownCount != null) staticCompare(cmpOp, l.knownCount!!, v)
      else
        new pred.Count {
          candidates = l.candidates
          `when` = l.`when`
          op = cmpOp
          value = v
        }
}

const local function staticCompare(cmpOp: String, n: Int, v: Int): Boolean =
  if (cmpOp == "gt") n > v
  else if (cmpOp == "lt") n < v
  else if (cmpOp == "eq") n == v
  else n != v

// ---- the fold ---------------------------------------------------------------
//
// Two steps: [[ready]] resolves each name against the candidates ONCE per set,
// and [[decide]] then folds per candidate. Fused, a `where` on a named property
// was O(n²) — 1 s for 2000 candidates.

abstract class Ready

/// A settled term, or a live [[pred.Cmp]], whose wire form is the same for
/// every candidate.
class ReadyConst extends Ready { value: Boolean|pred.Predicate }

/// A comparison on a registry fact, read off each candidate by the build.
class ReadyReg extends Ready {
  name: String
  op: pred.PredicateOp
  value: Scalar
}

class ReadyGroup extends Ready {
  gop: "all"|"any"|"not"
  terms: List<Ready>
}

/// A term the candidate produces, so it can only resolve per candidate — the
/// reason to prefer the data form when a term does not read the candidate.
class ReadyFn extends Ready { fn: (hass.Entity) -> Any }

const local function ready(items: List<hass.Entity>, f: Any): Ready =
  if (f is Function) new ReadyFn { fn = f as ((hass.Entity) -> Any) }
  else if (f is CandidateTerm) new ReadyFn { fn = (f as CandidateTerm).fn }
  else if (f is List)
    new ReadyGroup {
      gop = "all"
      terms = (f as List<Any>).map((x) -> ready(items, x))
    }
  else if (f is Group)
    let (g = f as Group)
      new ReadyGroup { gop = g.gop; terms = g.items.map((x) -> ready(items, x)) }
  else if (f is Pending)
    let (pd = f as Pending)
      let (from = resolveProp(items, pd.key))
        if (from.startsWith("reg:"))
          new ReadyReg { name = pd.key.name; op = pd.op; value = pd.value }
        else
          new ReadyConst {
            value = new pred.Cmp { property = from; op = pd.op; value = pd.value }
          }
  else new ReadyConst { value = f as (Boolean|pred.Predicate) }

// `items` travels only to re-enter [[ready]] for a [[ReadyFn]].
const local function decide(
  r: Ready, items: List<hass.Entity>, e: hass.Entity
): Boolean|pred.Predicate =
  if (r is ReadyConst) r.value
  else if (r is ReadyReg) applyOp(r.op, e.getPropertyOrNull(r.name), r.value)
  else if (r is ReadyFn) decide(ready(items, r.fn.apply(e)), items, e)
  else
    let (g = r as ReadyGroup)
      let (kids = g.terms.map((x) -> decide(x, items, e)))
        if (g.gop == "all") foldAll(kids)
        else if (g.gop == "any") foldAny(kids)
        else if (kids.first is Boolean) !(kids.first as Boolean)
        else new pred.PNot { item = kids.first as pred.Predicate }

// The branches that can still win for one candidate, with their residual
// guards. An unconditional branch ends the list: nothing after it can win.
const local function liveBranches(
  e: hass.Entity, branches: List<Branch>
): List<Pair<Branch, pred.Predicate?>> =
  let (evaluated = branches
        .map((b) -> Pair(b, b.key.apply(e)))
        .filter((p) -> !(p.second is Boolean && p.second == false)))
    let (firstUnconditional = evaluated.findIndexOrNull((p) -> p.second == true))
      (if (firstUnconditional == null) evaluated else evaluated.take(firstUnconditional + 1))
        .map((p) ->
          Pair(p.first, if (p.second is pred.Predicate) p.second as pred.Predicate else null))

// Through the fold, so a presence residual equal to the branch guard collapses.
const local function conjoin(
  presence: Boolean|pred.Predicate, branch: pred.Predicate?
): pred.Predicate? =
  let (parts =
        (if (presence is pred.Predicate) List(presence as pred.Predicate) else List()) +
        (if (branch != null) List(branch) else List()))
    if (parts.isEmpty) null else foldAll(parts) as pred.Predicate

// `items` is the UNSORTED list: sorting must not change whether a name is a
// registry fact. Presence is folded into each clause's guard, so presence and
// dispatch share one field.
const local function buildSet(
  ordering: Ordering,
  items: List<hass.Entity>,
  branches: List<Branch>,
  cap: Int?,
  presence: (hass.Entity) -> Boolean|pred.Predicate
): pred.SetNode =
  let (kept = ordering.entities
        .map((e) -> Pair(e, presence.apply(e)))
        .filter((p) -> !(p.second is Boolean && p.second == false)))
  let (dispatched = kept
        .map((p) -> Pair(p.first, liveBranches(p.first, branches)))
        .filter((p) -> !p.second.isEmpty))
  let (presenceOf = kept.toMap((p) -> p.first.entity_id, (p) -> p.second))
  let (rendered = dispatched.map((p) ->
        Pair(p.first, p.second.map((b) ->
          Pair(b.first.render.apply(p.first),
               conjoin(presenceOf[p.first.entity_id], b.second))))))
    new pred.SetNode {
      candidates = new Listing { for (p in dispatched) { p.first.entity_id } }
      orderBy = new Listing { for (t in ordering.terms) { t } }
      limit = cap
      members = new Mapping {
        for (p in rendered) {
          [p.first.entity_id] = new pred.SetMember {
            clauses = new Listing {
              for (q in p.second) {
                new pred.SetClause { `when` = q.second; node = q.first }
              }
            }
          }
        }
      }
    }
