/// The query surface over a STATIC candidate set — the second way an entity
/// reaches a node, for the things plain composition cannot express: filtering on
/// live state, and presence.
///
/// Plain Pkl stays the first answer. A fixed list of lights is still
///
///     for (light in dump.stue.lights) { c.slider(light) }
///
/// and reaching for `q.from(...)` to write that is a regression in authoring
/// cost with nothing bought. This module earns its place only when the set has
/// to react to live state.
///
/// Its own namespace, not part of `components.pkl`: this is a query language,
/// and a card knows nothing about it. A `render` lambda hands back an ordinary
/// component node, which is the only seam between the two.
///
/// The shape of the thing (`docs/plan-dynamics-one-entity-lifecycle.md`): the
/// CANDIDATES are decided here, at build time, from the typed dump. Registry
/// facts fold away — `area_id == "stue"` selects candidates and never reaches
/// the wire — and only conditions on live state survive, as per-member guards.
/// So the runtime decides presence and nothing else; it never materialises an
/// entity the build did not know about.
///
///     q.from(dump.stue.lights)
///       .where(q.eq(q.stateProp, "on"))
///       .render((e) -> c.slider(e))
///
/// NOT YET HERE (phase 3, with the runtime support they need): `limit`,
/// ordering by a live value, aggregates (`count`/`any`/`none`), and a set
/// nested inside a member. They are absent rather than present-and-erroring, so
/// pkl-lsp says "unknown method" at the point of use.
module query

import "components.pkl"
import "hass.pkl"

/// A comparison value. Not `Any` — only scalars are comparable.
typealias Scalar = String|Int|Float|Boolean

// ---- boolean structure -----------------------------------------------------
//
// A LIST is conjunction — the common case, so `where` takes one directly and no
// wrapper is needed. Disjunction and negation are explicit, and nest freely:
//
//   .where(q.any(List(q.candidate((e) -> e.dimmable), q.eq(q.stateProp, "on"))))
//
// `&&`/`||` cannot be used across the seam: Pkl rejects `Boolean && Cmp`, which
// is what keeps a live condition from being smuggled into a static position.

/// Everything that can appear where a condition is expected, resolved or not.
/// Usable in every NON-recursive position; the two positions that would close
/// the alias cycle take `Any` and say why.
typealias Cond = Boolean|components.Predicate|Pending|CandidateTerm|Group

/// An UNRESOLVED comparison — its key is still a [[PropName]], so where the
/// value comes from is not decided yet. Resolving it against the candidates
/// either FOLDS it to a `Boolean` (a registry fact the build can read) or
/// produces a live `components.Cmp`.
class Pending {
  key: PropName
  op: components.PredicateOp
  value: Scalar
}

/// A term computed FROM the candidate by an author lambda, resolved at build
/// time. A first-class term rather than a bare lambda so that it COMPOSES: a
/// lambda has no candidate in scope inside `any`/`all`/`not`, and a
/// `candidate` term does.
///
/// `fn`'s return is `Any` and not `Cond` ONLY because a typealias may not be
/// cyclic in Pkl and `Cond` mentions this class. Everything the resolver
/// accepts is still a `Cond`; the looseness stops at this one field.
class CandidateTerm {
  fn: (hass.Entity) -> Any
}

/// An UNRESOLVED boolean group. [[all]]/[[any]]/[[not]] fold immediately when
/// every operand is already resolved, and produce this when one is not — so the
/// same three functions cover both and an author never picks between an eager
/// and a lazy variant. `items` is `List<Any>` for the same alias-cycle reason.
class Group {
  gop: "all"|"any"|"not"
  items: List<Any>
}

// Parameters are deliberately NOT named after the properties they set: inside a
// `new { items = items }` the RHS binds to the object's own member and recurses
// ~10 000 deep, with a trace pointing at the field rather than the cause.
const local function isResolved(xs: List<Cond>): Boolean =
  xs.every((i) -> i is Boolean || i is components.Predicate)

/// Conjunction. A statically-false term decides the candidate immediately.
function all(xs: List<Cond>): Cond =
  if (isResolved(xs)) foldAll(xs as List<Boolean|components.Predicate>)
  else new Group { gop = "all"; items = xs }

/// Disjunction. A statically-true term short-circuits the whole thing — which
/// is why presence residuals can DIFFER between members of one set, and so why
/// presence has to live on the clause rather than beside it.
function any(xs: List<Cond>): Cond =
  if (isResolved(xs)) foldAny(xs as List<Boolean|components.Predicate>)
  else new Group { gop = "any"; items = xs }

/// Negation. Static stays static; a live term becomes a runtime `not`.
function not(x: Cond): Cond =
  if (x is Boolean) !x
  else if (x is components.Predicate) new components.PNot { item = x }
  else new Group { gop = "not"; items = List(x) }

/// Fold a mixed list of build-time Booleans and runtime predicates.
/// `false` => this candidate is decided statically and drops out entirely.
/// `true`  => nothing defers; no predicate reaches the wire.
///
/// Both folds CANONICALISE — same-kind nesting is flattened, structurally equal
/// terms deduped, a single survivor unwrapped. Not cosmetic: a presence residual
/// identical to a branch guard would otherwise emit `and[state==on, state==on]`,
/// and the runtime would evaluate the same predicate twice. One level of
/// flattening suffices, because every group is built through these.
const local function flatten(
  gop: String, ts: List<components.Predicate>
): List<components.Predicate> =
  ts.flatMap((t) ->
    if (gop == "and" && t is components.PAnd) t.items.toList()
    else if (gop == "or" && t is components.POr) t.items.toList()
    else List(t)).distinct

const local function listing(ts: List<components.Predicate>): Listing<components.Predicate> =
  new Listing { for (t in ts) { t } }

const local function foldAll(xs: List<Boolean|components.Predicate>): Boolean|components.Predicate =
  if (xs.any((i) -> i is Boolean && i == false)) false
  else
    let (rest = flatten("and", xs.filter((i) -> i is components.Predicate) as List<components.Predicate>))
      if (rest.isEmpty) true
      else if (rest.length == 1) rest.first
      else new components.PAnd { items = listing(rest) }

const local function foldAny(xs: List<Boolean|components.Predicate>): Boolean|components.Predicate =
  if (xs.any((i) -> i is Boolean && i == true)) true
  else
    let (rest = flatten("or", xs.filter((i) -> i is components.Predicate) as List<components.Predicate>))
      if (rest.isEmpty) false
      else if (rest.length == 1) rest.first
      else new components.POr { items = listing(rest) }

// ---- property references, shared by predicates AND ordering ----------------
//
// ONE vocabulary. A property is NAMED, not namespaced by the author: say
// `q.prop("friendly_name")` and the BUILD decides where it comes from — a
// registry fact when every candidate carries it as a property, a live attribute
// otherwise. `friendly_name` is genuinely both, and an author should not have to
// know which we picked.

/// A named property, namespace-resolved at build time (see [[resolveProp]]).
open class PropName {
  name: String
  /// Allow the property to be missing on SOME candidates; missing reads as
  /// null. Without it, mixed availability is a build error — it would mean the
  /// name is a registry fact for some members and a live attribute for others,
  /// which are not the same thing.
  optional: Boolean = false
}

/// Force the LIVE reading of a name that is also a registry fact.
class LiveAttr extends PropName {}

function prop(n: String): PropName = new { name = n }

function attr(n: String): LiveAttr = new { name = n }

/// Accept a property only SOME candidates carry; missing reads as null.
function optional(p: PropName): PropName = (p) { optional = true }

/// The live state value.
const stateProp: PropName = new PropName { name = "state" }

/// A term computed FROM the candidate. Prefer this over a bare lambda when the
/// term has to COMPOSE — inside `any`/`all`/`not` a lambda has no candidate in
/// scope, and this does.
function candidate(f: (hass.Entity) -> Cond|List<Cond>): CandidateTerm =
  new { fn = f }

/// Where a named property actually comes from, for these candidates.
///
/// ALL candidates have it  => a registry fact, readable by the build.
/// NONE have it            => a live attribute. Not validatable further today:
///                            volatile attribute values are deliberately absent
///                            from the dump (they would churn its content
///                            hash), so there is no list of legal names to
///                            check a typo against. The capability-derived
///                            schema closes this.
/// SOME have it            => AMBIGUOUS, and a build error unless `optional`.
const local function resolveProp(items: List<hass.Entity>, p: PropName): String =
  if (p.name == "state") "state"
  else if (p is LiveAttr) "attr:" + p.name
  else
    let (have = items.filter((e) -> e.hasProperty(p.name)).length)
      if (items.isEmpty || have == 0) "attr:" + p.name
      else if (have == items.length) "reg:" + p.name
      else if (p.optional) "reg:" + p.name
      else throw("""
        Property '\(p.name)' is present on \(have) of \(items.length) candidates.
        That is ambiguous: it would be a registry fact for some members and a
        live attribute for others. Either narrow the candidates so every one
        carries it, or wrap it in `q.optional(...)` to accept a null where it is
        missing.
        """)

/// True when the build can read this property itself, and so fold a comparison
/// on it away entirely.
const local function isBuildReadable(items: List<hass.Entity>, p: PropName): Boolean =
  resolveProp(items, p).startsWith("reg:")

const local function applyOp(cmpOp: String, l: Any, r: Any): Boolean =
  if (cmpOp == "eq") l == r
  else if (cmpOp == "ne") l != r
  else if (cmpOp == "gt") l > r
  else if (cmpOp == "gte") l >= r
  else if (cmpOp == "lt") l < r
  else if (cmpOp == "lte") l <= r
  else throw("unknown comparison operator '\(cmpOp)'")

/// Resolve one pending comparison for ONE candidate: folded to a Boolean when
/// the build can read the property, otherwise a live term.
const local function resolvePending(
  items: List<hass.Entity>, e: hass.Entity, pd: Pending
): Boolean|components.Predicate =
  if (isBuildReadable(items, pd.key))
    applyOp(pd.op, e.getPropertyOrNull(pd.key.name), pd.value)
  else
    new components.Cmp {
      property = resolveProp(items, pd.key)
      op = pd.op
      value = pd.value
    }

// ---- comparisons: the same terms work in `where` and in `orderBy` ----------

const local function cmp(k: PropName, cmpOp: components.PredicateOp, v: Scalar): Pending =
  new { key = k; op = cmpOp; value = v }

function eq(k: PropName, v: Scalar): Pending = cmp(k, "eq", v)
function ne(k: PropName, v: Scalar): Pending = cmp(k, "ne", v)
function gt(k: PropName, v: Scalar): Pending = cmp(k, "gt", v)
function lt(k: PropName, v: Scalar): Pending = cmp(k, "lt", v)

// ---- naming another entity --------------------------------------------------

/// A term about a DIFFERENT entity than the member. The reference is resolved at
/// build time — usually derived from the candidate, as in "this light's room's
/// motion sensor" — while the test itself stays live:
///
///     q.candidate((e) -> q.entity(motionSensorFor(e.area_id)).stateIs("on"))
///
/// Keeps the ENTITY, not just its id, so a comparison is checked against that
/// exact entity. Pkl has no generics, so the static type cannot be carried — but
/// per-entity is the sharper question anyway, and it matches ADR 0013, which
/// puts capabilities on a class generated PER ENTITY: "does this entity have
/// `brightness`" beats "is this a light".
class EntityRef {
  id: String
  /// The dump entity, when one was given. Null for a computed id, which cannot
  /// be checked.
  hidden source: hass.Entity?

  /// The shorthand: naming an entity is nearly always to test its state, so
  /// that should not cost a `q.eq(q.stateProp, …)` every time.
  function stateIs(s: String): components.Cmp = cmpOn(id, source, stateProp, "eq", s)
  function stateIsNot(s: String): components.Cmp = cmpOn(id, source, stateProp, "ne", s)
  function eq(k: PropName, v: Scalar): components.Cmp = cmpOn(id, source, k, "eq", v)
  function ne(k: PropName, v: Scalar): components.Cmp = cmpOn(id, source, k, "ne", v)
  function gt(k: PropName, v: Scalar): components.Cmp = cmpOn(id, source, k, "gt", v)
  function lt(k: PropName, v: Scalar): components.Cmp = cmpOn(id, source, k, "lt", v)
}

/// Name one entity. Prefer passing the typed dump entity —
/// `q.entity(dump.e_taklys)` — so a typo is a Pkl error AND the property is
/// checked against that entity. A bare String is accepted for computed ids, at
/// the cost of both.
function entity(e: hass.Entity|String): EntityRef =
  if (e is String) new { id = e; source = null }
  else new { id = (e as hass.Entity).entity_id; source = e }

// A cross-entity term cannot fold: the build knows WHICH entity, never its
// state. So it is always live, and always names a `state`/`attr:` property.
//
// When the entity itself was given, the named property is checked against it — a
// registry fact it does not carry is a typo, and saying so here beats a
// condition that silently never matches. A volatile name is not checkable YET
// (the capability-derived schema is not built); once it is, this becomes an
// error rather than a warning.
const local function cmpOn(
  who: String, src: hass.Entity?, k: PropName, cmpOp: components.PredicateOp, v: Scalar
): components.Cmp =
  let (_checked =
        if (src != null && k.name != "state" && !src.hasProperty(k.name))
          trace("fh: '\(k.name)' is not a property of \(who) — assuming a live attribute") != null
        else true)
    new {
      entity = who
      property = if (k.name == "state") "state" else "attr:" + k.name
      op = cmpOp
      value = v
    }

// ---- ordering ---------------------------------------------------------------
//
// A declarative LIST of positions rather than a lambda: a `where` predicate
// genuinely depends on the candidate, an ordering key never does — `brightness`
// is the same reference for every member. For a COMPUTED ordering, sort the
// input list with ordinary Pkl before `from`.

/// One authored ordering position, most significant first.
class OrderSpec {
  by: PropName
  dir: "asc"|"desc" = "asc"
}

function asc(k: PropName): OrderSpec = new { by = k; dir = "asc" }
function desc(k: PropName): OrderSpec = new { by = k; dir = "desc" }

// `const` because [[EntitySet.orderBy]] calls it from a class body.
const local function spec(k: OrderSpec|PropName): OrderSpec =
  if (k is OrderSpec) k else new OrderSpec { by = k as PropName }

/// Sort the candidates NOW, from the least significant key outwards so the
/// result is lexicographic. Every position must be build-readable: ordering by a
/// LIVE value needs the runtime to compare present members, which is phase 3, and
/// erroring here beats emitting an `orderBy` the renderer would ignore.
const local function foldOrder(
  items: List<hass.Entity>, specs: List<OrderSpec>
): List<hass.Entity> =
  if (specs.isEmpty || items.isEmpty) items
  else
    let (live = specs.filter((s) -> !isBuildReadable(items, s.by)))
      if (!live.isEmpty)
        throw("""
          Cannot order by '\(live.first.by.name)': it is a live value, and
          ordering by live values is not implemented yet (it needs the runtime
          to re-compare present members as they change). Order by a registry
          fact — `friendly_name`, `area_id` — or sort the input list with
          ordinary Pkl before `from`.
          """)
      else
        // Least significant key outwards, each sort STABLE, so the result is
        // lexicographic. `desc` compares the other way rather than reversing
        // the sorted list: reversing would also reverse the ties, undoing the
        // order the less significant keys just established.
        specs.reverse().fold(items, (acc, s) ->
          acc.sortWith((x, y) ->
            let (a = x.getProperty(s.by.name) as (String|Int|Float|Boolean))
              let (b = y.getProperty(s.by.name) as (String|Int|Float|Boolean))
                if (s.dir == "desc") a > b else a < b))

// ---- the set ----------------------------------------------------------------

/// One authored dispatch branch: a key applied per candidate, and the node to
/// render when it wins. The key returns `Boolean` (folds at build time) or a
/// predicate (defers to the wire).
class Branch {
  key: (hass.Entity) -> Boolean|components.Predicate
  render: (hass.Entity) -> components.Node
}

/// What [[EntitySet.where]] and [[EntitySet.caseOf]] accept: the data form, a
/// [[candidate]] term, a list of either (conjunction), or a bare lambda over the
/// candidate.
typealias Filter = ((hass.Entity) -> Cond|List<Cond>)|Cond|List<Cond>

/// A chainable candidate set. Every method returns an amended copy, so a chain
/// is pure accumulation and nothing is evaluated until [[build]].
class EntitySet {
  hidden items: List<hass.Entity>
  hidden filters: List<Filter> = List()
  hidden branches: List<Branch> = List()
  hidden specs: List<OrderSpec> = List()

  /// Keep candidates matching the condition. Accepts a LAMBDA (when the term
  /// reads the candidate directly) or the DATA form built from the same
  /// property references ordering uses, which needs no lambda at all. A `List`
  /// result is conjunction.
  ///
  /// Static terms drop candidates at build time; live terms become the member's
  /// guard. One method, one fold — the author never names the seam.
  function where(f: Filter): EntitySet =
    let (l = this) (l) { filters = l.filters.add(f) }

  /// Lexicographic, most significant first. One position or a list of them.
  function orderBy(ks: List<OrderSpec|PropName>|OrderSpec|PropName): EntitySet =
    let (l = this)
      let (asList = if (ks is List) ks as List<OrderSpec|PropName> else List(ks))
        (l) { specs = l.specs + asList.map((k) -> spec(k)) }

  /// One guarded rendering. The guard takes exactly what [[where]] takes and
  /// folds the same way: a `Boolean` decides at build time, anything else
  /// defers to the wire.
  function caseOf(g: Filter, r: (hass.Entity) -> components.Node): EntitySet =
    let (l = this)
      (l) {
        branches = l.branches.add(new Branch {
          key = (e) -> normalise(l.items, e, g)
          render = r
        })
      }

  /// Several guarded renderings at once. A `Mapping` keeps author order — which
  /// is match order — and rejects duplicate keys.
  function cases(m: Mapping<Filter, (hass.Entity) -> components.Node>): EntitySet =
    let (l = this)
      (l) {
        branches = l.branches + m.toMap().entries.map((p) ->
          new Branch { key = (e) -> normalise(l.items, e, p.key); render = p.value })
      }

  /// The unconditional last clause. OPTIONAL, and its absence is meaningful: a
  /// candidate matching no clause is simply not rendered, which is how "show it
  /// only while on" is written.
  function `else`(r: (hass.Entity) -> components.Node): EntitySet = caseOf((_e) -> true, r)

  /// The only rendering, when there is nothing to dispatch on.
  function render(r: (hass.Entity) -> components.Node): EntitySet = caseOf((_e) -> true, r)

  /// The emitted node. A chain ends here — Pkl has no implicit conversion, so
  /// the set is a layout node only once you ask for it.
  function build(): components.SetNode =
    let (l = this)
      buildSet(
        foldOrder(l.items, l.specs),
        l.items,
        l.branches,
        (e) -> foldAll(l.filters.map((f) -> normalise(l.items, e, f))))
}

/// Start a query over any list of typed dump entities.
function from(xs: List<hass.Entity>): EntitySet = new EntitySet { items = xs }

// ---- the fold ---------------------------------------------------------------

/// Reduce one filter, in any of its accepted forms, to a single folded term for
/// candidate `e`.
const local function normalise(
  items: List<hass.Entity>, e: hass.Entity, f: Any
): Boolean|components.Predicate =
  let (r = if (f is Function) (f as ((Any) -> Any)).apply(e) else f)
    if (r is List) foldAll((r as List<Any>).map((x) -> normalise(items, e, x)))
    else if (r is Pending) resolvePending(items, e, r as Pending)
    else if (r is CandidateTerm) normalise(items, e, (r as CandidateTerm).fn)
    else if (r is Group)
      let (g = r as Group)
        let (kids = g.items.map((x) -> normalise(items, e, x)))
          if (g.gop == "all") foldAll(kids)
          else if (g.gop == "any") foldAny(kids)
          else if (kids.first is Boolean) !(kids.first as Boolean)
          else new components.PNot { item = kids.first as components.Predicate }
    else r as (Boolean|components.Predicate)

/// Which branches survive for one candidate, in author order, with their
/// residual runtime condition. A branch whose key folded to `false` is gone; one
/// that folded to `true` is unconditional and ENDS the list, because nothing
/// after it can ever win.
const local function liveBranches(
  e: hass.Entity, branches: List<Branch>
): List<Pair<Branch, components.Predicate?>> =
  let (evaluated = branches
        .map((b) -> Pair(b, b.key.apply(e)))
        .filter((p) -> !(p.second is Boolean && p.second == false)))
    let (firstUnconditional = evaluated.findIndexOrNull((p) -> p.second == true))
      (if (firstUnconditional == null) evaluated else evaluated.take(firstUnconditional + 1))
        .map((p) ->
          Pair(p.first, if (p.second is components.Predicate) p.second as components.Predicate else null))

/// Conjoin a candidate's presence residual with one branch's residual. Either
/// may be statically decided; the result is the guard the wire must carry, or
/// null when nothing defers.
///
/// Routed through the fold rather than building a `PAnd` directly, so a presence
/// residual identical to the branch guard collapses to one term instead of being
/// conjoined with itself.
const local function conjoin(
  presence: Boolean|components.Predicate, branch: components.Predicate?
): components.Predicate? =
  let (parts =
        (if (presence is components.Predicate) List(presence as components.Predicate) else List()) +
        (if (branch != null) List(branch) else List()))
    if (parts.isEmpty) null else foldAll(parts) as components.Predicate

/// Build the wire node from a static candidate list and authored branches.
///
/// `ordered` is the candidates in render order; `items` is the UNSORTED original,
/// which property resolution reads — sorting must not change whether a name is a
/// registry fact.
const local function buildSet(
  ordered: List<hass.Entity>,
  items: List<hass.Entity>,
  branches: List<Branch>,
  presence: (hass.Entity) -> Boolean|components.Predicate
): components.SetNode =
  // 1. presence folds PER CANDIDATE; a statically-absent one is dropped here and
  //    never reaches the wire.
  let (kept = ordered
        .map((e) -> Pair(e, presence.apply(e)))
        .filter((p) -> !(p.second is Boolean && p.second == false)))
  // 2. dispatch: which branches can still win for each surviving candidate.
  let (dispatched = kept
        .map((p) -> Pair(p.first, liveBranches(p.first, branches)))
        .filter((p) -> !p.second.isEmpty))
  let (presenceOf = kept.toMap((p) -> p.first.entity_id, (p) -> p.second))
  // 3. render every (candidate, branch) pair, folding this candidate's presence
  //    residual into each branch's guard — which is what lets presence and
  //    dispatch share one field instead of needing a presence field beside it.
  let (rendered = dispatched.map((p) ->
        Pair(p.first, p.second.map((b) ->
          Pair(b.first.render.apply(p.first),
               conjoin(presenceOf[p.first.entity_id], b.second))))))
    new components.SetNode {
      candidates = new Listing { for (p in dispatched) { p.first.entity_id } }
      members = new Mapping {
        for (p in rendered) {
          [p.first.entity_id] = new components.SetMember {
            clauses = new Listing {
              for (q in p.second) {
                new components.SetClause { `when` = q.second; node = q.first }
              }
            }
          }
        }
      }
    }
