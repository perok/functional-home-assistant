/// The BeerCSS Material 3 theme (ADR 0026), the default. BeerCSS styles
/// semantic elements (`<article>`, `<button>`, `<dialog>`), which is what the
/// cards emit, so `styles` carries only paint (ADR 0020): two colour bridges
/// and the few rules that name something BeerCSS owns.
///
/// Retune by amending: `theme = (beer.theme) { md3Light { ["primary"] = "#7d5260" } }`,
/// or the HA tokens with `(beer.theme) { tokens { ["primary-color"] = "#..." } }`.
/// The MD3 roles are BeerCSS's own
/// (https://github.com/beercss/beercss/blob/main/docs/SETTINGS.md).
///
/// The palette is emitted at body specificity, all three class states in every
/// selector, because BeerCSS has no `prefers-color-scheme` query and sets
/// `body.dark` from JS (ADR 0026). So the mode follows the device only; a manual
/// `ui("mode", …)` flip is unsupported.
module themeBeer

import "theme.pkl" as themeMod

/// Pinned; bump deliberately and re-check the facts ADR 0026 rests on.
const local beerVersion: String = "4.0.23"
const local beerCdn: String = "https://cdn.jsdelivr.net/npm/beercss@\(beerVersion)/dist/cdn"

/// Material Design Icons, HA's own set, so an entity's `icon` renders as its
/// author chose. ~500 KB for a few dozen used glyphs: the way out is to inline
/// the used icons as SVG paths at build time (`@mdi/js`), since every icon name
/// is known then.
const local mdiVersion: String = "7.4.47"
const local mdiCdn: String =
  "https://cdn.jsdelivr.net/npm/@mdi/font@\(mdiVersion)/css/materialdesignicons.min.css"

/// The text font BeerCSS's `--font` asks for and never loads. Without it each
/// engine falls back to a different sans, and a label sits centred in one and
/// high in another. Localised by `AssetCache`.
const local interCdn: String =
  "https://cdn.jsdelivr.net/npm/@fontsource/inter@5/latin.css"

const local function cssVars(m: Mapping<String, String>): String =
  new Listing { for (k, v in m) { "--\(k):\(v)" } }.toList().join(";")

class BeerTheme extends themeMod.Theme {

  /// The 36-role MD3 palette, generated once from HA's blue seed `#03a9f4` with
  /// `@material/material-color-utilities` (the `surface-*` tiers are the
  /// neutral palette at the spec tones). Read late-bound by [[styles]]. HA's
  /// brighter blue comes back through the token re-pointing in [[styles]].
  hidden md3Light: Mapping<String, String> = new {
    ["primary"] = "#006493"
    ["on-primary"] = "#ffffff"
    ["primary-container"] = "#cae6ff"
    ["on-primary-container"] = "#001e30"
    ["secondary"] = "#50606e"
    ["on-secondary"] = "#ffffff"
    ["secondary-container"] = "#d3e5f5"
    ["on-secondary-container"] = "#0c1d29"
    ["tertiary"] = "#65587b"
    ["on-tertiary"] = "#ffffff"
    ["tertiary-container"] = "#ebddff"
    ["on-tertiary-container"] = "#201634"
    ["error"] = "#ba1a1a"
    ["on-error"] = "#ffffff"
    ["error-container"] = "#ffdad6"
    ["on-error-container"] = "#410002"
    ["background"] = "#fcfcff"
    ["on-background"] = "#1a1c1e"
    ["surface"] = "#fcfcff"
    ["on-surface"] = "#1a1c1e"
    ["surface-variant"] = "#dde3ea"
    ["on-surface-variant"] = "#41474d"
    ["outline"] = "#72787e"
    ["outline-variant"] = "#c1c7ce"
    ["shadow"] = "#000000"
    ["scrim"] = "#000000"
    ["inverse-surface"] = "#2e3133"
    ["inverse-on-surface"] = "#f0f0f3"
    ["inverse-primary"] = "#8dcdff"
    ["surface-dim"] = "#d9dadd"
    ["surface-bright"] = "#f9f9fc"
    ["surface-container-lowest"] = "#ffffff"
    ["surface-container-low"] = "#f3f3f6"
    ["surface-container"] = "#edeef1"
    ["surface-container-high"] = "#e8e8eb"
    ["surface-container-highest"] = "#e2e2e5"
  }

  /// The dark counterpart of [[md3Light]] (same generation run).
  hidden md3Dark: Mapping<String, String> = new {
    ["primary"] = "#8dcdff"
    ["on-primary"] = "#00344f"
    ["primary-container"] = "#004b70"
    ["on-primary-container"] = "#cae6ff"
    ["secondary"] = "#b7c9d9"
    ["on-secondary"] = "#22323f"
    ["secondary-container"] = "#384956"
    ["on-secondary-container"] = "#d3e5f5"
    ["tertiary"] = "#cfc0e8"
    ["on-tertiary"] = "#362b4b"
    ["tertiary-container"] = "#4d4162"
    ["on-tertiary-container"] = "#ebddff"
    ["error"] = "#ffb4ab"
    ["on-error"] = "#690005"
    ["error-container"] = "#93000a"
    ["on-error-container"] = "#ffb4ab"
    ["background"] = "#1a1c1e"
    ["on-background"] = "#e2e2e5"
    ["surface"] = "#1a1c1e"
    ["on-surface"] = "#e2e2e5"
    ["surface-variant"] = "#41474d"
    ["on-surface-variant"] = "#c1c7ce"
    ["outline"] = "#8b9198"
    ["outline-variant"] = "#41474d"
    ["shadow"] = "#000000"
    ["scrim"] = "#000000"
    ["inverse-surface"] = "#e2e2e5"
    ["inverse-on-surface"] = "#2e3133"
    ["inverse-primary"] = "#006493"
    ["surface-dim"] = "#111416"
    ["surface-bright"] = "#37393c"
    ["surface-container-lowest"] = "#0c0e11"
    ["surface-container-low"] = "#1a1c1e"
    ["surface-container"] = "#1e2022"
    ["surface-container-high"] = "#282a2d"
    ["surface-container-highest"] = "#333537"
  }

  stylesheets {
    "\(beerCdn)/beer.min.css"
    interCdn
  }

  // Nothing about the layout depends on the icon font, so it waits.
  deferredStylesheets {
    mdiCdn
  }

  // For this theme's CSS, not behaviour: the slider fill is JS-driven, and the
  // light/dark body class comes from here. Its listeners are delegated, so they
  // survive morphs.
  scripts {
    "\(beerCdn)/beer.min.js"
  }

  // `responsive` is BeerCSS's centred max-width container.
  chrome = """
    <main class="responsive" id="dashboard">{{{body}}}</main>
    <div id="popups">{{{popups}}}</div>
    """

  // BeerCSS's self-morphing SVG mask, in place of the plain ring. Bound, never
  // left in place and styled inert: `.shape>i{filter:invert(1)}` is
  // unconditional.
  classes {
    ["fh-busy-spin"] = "shape loading-indicator"
  }

  styles = """
    /* The MD3 palette, late-bound from md3Light/md3Dark. */
    body,body.light,body.dark{\(cssVars(md3Light))}
    @media (prefers-color-scheme:dark){
      body,body.light,body.dark{\(cssVars(md3Dark))}
    }
    /* HA tokens over the MD3 roles, last so it wins in both schemes: HA blue,
       HA background and text, and the HA card colour on the card and dialog
       surfaces. */
    body,body.light,body.dark{
      --primary:var(--primary-color);
      --on-primary:var(--text-primary-color);
      --background:var(--primary-background-color);
      --surface:var(--primary-background-color);
      --on-background:var(--primary-text-color);
      --on-surface:var(--primary-text-color);
      --on-surface-variant:var(--secondary-text-color);
      --outline-variant:var(--divider-color);
      --error:var(--error-color);
      --surface-container-low:var(--card-background-color);
      --surface-container-high:var(--card-background-color);
    }
    /* The other direction: the variables cards read, pointed at MD3 roles, so
       `--fh-surface-alt` gets a container tier HA has no token for. */
    body,body.light,body.dark{
      --fh-accent:var(--primary);
      --fh-on-accent:var(--on-primary);
      --fh-text:var(--on-surface);
      --fh-text-dim:var(--on-surface-variant);
      --fh-surface-alt:var(--surface-container-highest);
      --fh-surface-sunken:var(--surface-container);
      --fh-border:var(--outline-variant);
      --fh-error:var(--error);
      --fh-on-error:var(--on-error);
      --fh-chart-fill:color-mix(in srgb,var(--primary) 14%,transparent);
      --fh-scrim:var(--overlay);
    }

    /* BeerCSS styles a bare `<i>` as Material Symbols, so the MDI family is
       restated. */
    .entity header i.mdi{font-family:"Material Design Icons"}
    /* The spinner shape around a glyph. `background` restated, or the host's
       resting background paints it; the glyph takes `--on-primary` rather than
       BeerCSS's `invert(1)`, meant for photos. */
    .fh-icon-shape.shape,.slider-icon.shape,.circle.shape{
      display:inline-flex;align-items:center;justify-content:center;
      vertical-align:middle;background:var(--primary)}
    .shape>i.mdi{filter:none;color:var(--on-primary)}
    /* Only the header badge has no box of its own; `.shape` defaults to 3.5rem. */
    .fh-icon-shape.shape{inline-size:2.25rem;block-size:2.25rem}
    @media (prefers-reduced-motion:reduce){
      /* The morph is the mask's own `<animate>`, which CSS cannot reach. */
      .shape.loading-indicator{mask-image:none;border-radius:50%}
    }
    /* BeerCSS's card-scale knob, which its other rules also read: half the
       default, matched by the slider line's own .5rem. */
    .slider-card{--_padding:.5rem}
    .slider-members .card{--_padding:0}
    """
}

/// The instance entries reference, and may amend.
theme: BeerTheme = new {}
