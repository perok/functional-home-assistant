/// The BeerCSS Material Design 3 theme (`docs/plan-beercss-theme.md`) — the
/// DEFAULT theme (wired in `entry.pkl`; contract + roster in `theme.pkl`).
/// An entry retunes it by amending (`theme { md3Light { ... } }`) or swaps to
/// another theme entirely (any sibling module exporting a `theme.pkl` Theme).
///
/// BeerCSS styles SEMANTIC ELEMENTS directly (`<article>` = card, `<button>` =
/// filled MD3 button, `<dialog>` = dialog), which is exactly what the card
/// templates emit — so this theme needs no bespoke card CSS: BeerCSS supplies
/// the MD3 look under the contract classes, and `styles` below carries only
/// the color bridge + the residual contract CSS BeerCSS doesn't cover.
///
/// THEMING — the color variables are BeerCSS's own MD3 roles, documented in
/// https://github.com/beercss/beercss/blob/main/docs/SETTINGS.md. They live
/// here (not in the shared `tokens.pkl`) because they are BeerCSS-specific,
/// as amendable `hidden` class properties: `styles` is derived from them
/// LATE-BOUND, so an entry can retune the palette and everything recomputes —
///   theme = (beer.theme) { md3Light { ["primary"] = "#7d5260" } }
/// The HA-named tokens stay in `tokens.pkl` (shared cross-theme contract, HA
/// theme drop-in); they too are amendable per instance, as plain Theme
/// properties: `(beer.theme) { tokens { ["primary-color"] = "#..." } }`.
///
/// COLOR BRIDGE (the load-bearing subtlety, spike-verified on 4.0.23):
/// `beer.min.css` has NO `prefers-color-scheme` media query — light values
/// live on `:root, body.light`, dark ONLY on `body.dark`, and `beer.min.js`
/// auto-adds `light`/`dark` to `<body>` at startup from the device scheme.
/// A `body.dark` rule beats anything we define on `:root`, so the palette
/// below is emitted at BODY specificity, with all three class states in every
/// selector (`body, body.light, body.dark`) so ours always ties BeerCSS's
/// selectors and wins by document order (theme `styles` are injected in the
/// body, after the `<link>`s). Order within `styles` then does the cascade
/// work: MD3 light palette -> dark palette (under OUR media query) -> the
/// HA-token re-pointing (last, so it wins in both schemes; its `var()`
/// references resolve through `:root` tokens that flip via `tokensDark`).
/// Consequence: mode is device-driven only — a manual `ui("mode", ...)` flip
/// would move the body class but not our media query, and is unsupported.
module themeBeer

import "tokens.pkl" as tokenPalette
import "theme.pkl" as themeMod

/// Pinned — never `@latest` (visual stability; the dist bundles the Material
/// Symbols fonts with absolute CDN fallback URLs, so icons need no extra
/// `<link>`). Bump deliberately and re-verify the spikes in
/// `docs/plan-beercss-theme.md`.
const local beerVersion: String = "4.0.23"
const local beerCdn: String = "https://cdn.jsdelivr.net/npm/beercss@\(beerVersion)/dist/cdn"

/// Material Design Icons — HA's OWN icon set, so an entity's `icon` attribute
/// (`mdi:thermometer`) renders as the glyph its author picked instead of being
/// translated into some near-equivalent. Pinned for the same reason as BeerCSS.
///
/// **The cost, and the way out.** This is ~394 KB of woff2 plus ~100 KB of CSS
/// for ~7 500 icons, of which one dashboard uses a few dozen. It is here
/// because it is one line and it works; it is not the end state.
///
/// The end state is to INLINE the icons actually used, at build time, as SVG
/// paths — which is available because every icon name is known at build time
/// (`components.iconFor` resolves it from the dump, not from live state). The
/// shape:
///
///   - add `@mdi/js` as a BUILD dependency (name -> path data, tree-shakeable);
///   - resolve the name to its path where `iconFor` resolves the name today,
///     and emit the path as the literal slot value;
///   - the card template becomes
///     `<svg viewBox="0 0 24 24"><path d="{{{icon}}}"/></svg>`, and
///     `.entity header i` becomes a rule on that `svg`;
///   - drop this stylesheet, and the `mdi ` class prefix with it.
///
/// That trades ~500 KB of always-loaded font for a few KB of markup that is
/// already being sent, and removes a CDN round trip from first paint — which
/// matters most on the PWA/remote path, where the font is not warm in cache.
/// The reason it is not done here is scope, not doubt.
const local mdiVersion: String = "7.4.47"
const local mdiCdn: String =
  "https://cdn.jsdelivr.net/npm/@mdi/font@\(mdiVersion)/css/materialdesignicons.min.css"

/// A mapping rendered as CSS custom-property declarations
/// (`--primary:#006493;--on-primary:#ffffff;…`). `const` (like [[beerCdn]]):
/// class bodies may only reference `const` module members.
const local function cssVars(m: Mapping<String, String>): String =
  new Listing { for (k, v in m) { "--\(k):\(v)" } }.toList().join(";")

class BeerTheme extends themeMod.Theme {

  /// The full 36-role MD3 palette (light), generated ONCE (2026-07-07) from
  /// the HA blue seed `#03a9f4` with Google's
  /// `@material/material-color-utilities` (`themeFromSourceColor`; the
  /// `surface-dim/bright/container*` tiers, which the legacy scheme object
  /// lacks, are the neutral palette at the spec tones — light
  /// 87/98/100/96/94/92/90, dark 6/24/4/10/12/17/22). Key names = BeerCSS's
  /// variable names sans `--` (see the SETTINGS.md link in the module doc).
  /// `hidden` (never on the wire) and read late-bound by [[styles]] — amend
  /// entries here to retune the theme. Note the spec-toned primary is
  /// #006493, not HA blue: the brighter HA blue arrives via the HA-token
  /// re-pointing layer in [[styles]], keeping the HA look.
  hidden md3Light: Mapping<String, String> = new {
    ["primary"] = "#006493"
    ["on-primary"] = "#ffffff"
    ["primary-container"] = "#cae6ff"
    ["on-primary-container"] = "#001e30"
    ["secondary"] = "#50606e"
    ["on-secondary"] = "#ffffff"
    ["secondary-container"] = "#d3e5f5"
    ["on-secondary-container"] = "#0c1d29"
    ["tertiary"] = "#65587b"
    ["on-tertiary"] = "#ffffff"
    ["tertiary-container"] = "#ebddff"
    ["on-tertiary-container"] = "#201634"
    ["error"] = "#ba1a1a"
    ["on-error"] = "#ffffff"
    ["error-container"] = "#ffdad6"
    ["on-error-container"] = "#410002"
    ["background"] = "#fcfcff"
    ["on-background"] = "#1a1c1e"
    ["surface"] = "#fcfcff"
    ["on-surface"] = "#1a1c1e"
    ["surface-variant"] = "#dde3ea"
    ["on-surface-variant"] = "#41474d"
    ["outline"] = "#72787e"
    ["outline-variant"] = "#c1c7ce"
    ["shadow"] = "#000000"
    ["scrim"] = "#000000"
    ["inverse-surface"] = "#2e3133"
    ["inverse-on-surface"] = "#f0f0f3"
    ["inverse-primary"] = "#8dcdff"
    ["surface-dim"] = "#d9dadd"
    ["surface-bright"] = "#f9f9fc"
    ["surface-container-lowest"] = "#ffffff"
    ["surface-container-low"] = "#f3f3f6"
    ["surface-container"] = "#edeef1"
    ["surface-container-high"] = "#e8e8eb"
    ["surface-container-highest"] = "#e2e2e5"
  }

  /// The dark counterpart of [[md3Light]] (same generation run).
  hidden md3Dark: Mapping<String, String> = new {
    ["primary"] = "#8dcdff"
    ["on-primary"] = "#00344f"
    ["primary-container"] = "#004b70"
    ["on-primary-container"] = "#cae6ff"
    ["secondary"] = "#b7c9d9"
    ["on-secondary"] = "#22323f"
    ["secondary-container"] = "#384956"
    ["on-secondary-container"] = "#d3e5f5"
    ["tertiary"] = "#cfc0e8"
    ["on-tertiary"] = "#362b4b"
    ["tertiary-container"] = "#4d4162"
    ["on-tertiary-container"] = "#ebddff"
    ["error"] = "#ffb4ab"
    ["on-error"] = "#690005"
    ["error-container"] = "#93000a"
    ["on-error-container"] = "#ffb4ab"
    ["background"] = "#1a1c1e"
    ["on-background"] = "#e2e2e5"
    ["surface"] = "#1a1c1e"
    ["on-surface"] = "#e2e2e5"
    ["surface-variant"] = "#41474d"
    ["on-surface-variant"] = "#c1c7ce"
    ["outline"] = "#8b9198"
    ["outline-variant"] = "#41474d"
    ["shadow"] = "#000000"
    ["scrim"] = "#000000"
    ["inverse-surface"] = "#e2e2e5"
    ["inverse-on-surface"] = "#2e3133"
    ["inverse-primary"] = "#006493"
    ["surface-dim"] = "#111416"
    ["surface-bright"] = "#37393c"
    ["surface-container-lowest"] = "#0c0e11"
    ["surface-container-low"] = "#1a1c1e"
    ["surface-container"] = "#1e2022"
    ["surface-container-high"] = "#282a2d"
    ["surface-container-highest"] = "#333537"
  }

  tokens = tokenPalette.light
  tokensDark = tokenPalette.dark

  stylesheets {
    "\(beerCdn)/beer.min.css"
    mdiCdn
  }

  // Required by this theme's CSS, not for behavior (which stays Datastar's):
  // the slider track-fill is JS-driven (`--_start`/`--_end` private props),
  // and the auto light/dark body class comes from here too (the bridge above
  // works with OR without it). Binds via delegated listeners + a
  // MutationObserver, so Datastar SSE morphs re-bind.
  scripts {
    "\(beerCdn)/beer.min.js"
  }

  // The gesture half of the touch rules below — see themeMod.sliderHoldScript.
  inlineScripts {
    themeMod.sliderHoldScript
  }

  // Same contract as theme.pkl: the `#dashboard` swap target (enforced by
  // Dashboard.validate) + the `#popups` overlay mount, whose hole carries a
  // popup restored on refresh so it paints with the page. `responsive` is
  // BeerCSS's centered max-width container.
  chrome = """
    <main class="responsive" id="dashboard">{{{body}}}</main>
    <div id="popups">{{{popups}}}</div>
    """

  styles = """
    /* MD3 role palette ([[md3Light]]/[[md3Dark]], late-bound). Body
       specificity + all three class states + declaration order: see the
       module doc for why each is required. */
    body,body.light,body.dark{\(cssVars(md3Light))}
    @media (prefers-color-scheme:dark){
      body,body.light,body.dark{\(cssVars(md3Dark))}
    }
    /* HA-token re-pointing — LAST so it wins in both schemes. Keeps the HA
       look on MD3: HA blue as primary, HA background/text/divider, and the
       card/dialog surfaces (article reads --surface-container-low, dialog
       --surface-container-high) on the HA card color. */
    body,body.light,body.dark{
      --primary:var(--primary-color);
      --on-primary:var(--text-primary-color);
      --background:var(--primary-background-color);
      --surface:var(--primary-background-color);
      --on-background:var(--primary-text-color);
      --on-surface:var(--primary-text-color);
      --on-surface-variant:var(--secondary-text-color);
      --outline-variant:var(--divider-color);
      --error:var(--error-color);
      --surface-container-low:var(--card-background-color);
      --surface-container-high:var(--card-background-color);
    }

    /* Contract CSS BeerCSS doesn't cover (cards/buttons/dialogs/sliders it
       styles as elements). The fh- LAYOUT contract (grid/row/col/cell spans)
       is the shared framework-agnostic default from theme.pkl. */
    \(themeMod.layoutCss)
    .section{color:var(--primary)}
    .state{color:var(--on-surface-variant)}
    .entity .secondary{display:block;font-size:.8em;color:var(--on-surface-variant)}
    /* Entity icon in the card header. MDI, not the Material Symbols the
       BeerCSS dist bundles — HA's own `icon` attribute is an MDI name, so this
       is the set that can render what an author actually chose. The
       `font-family` is restated because BeerCSS styles a bare `<i>` as Material
       Symbols and would otherwise win the cascade over `.mdi:before`. */
    .entity header i.mdi{font-family:"Material Design Icons";font-size:1.25rem;line-height:1;vertical-align:text-bottom;margin-inline-end:.375rem;color:var(--primary)}
    .card.tappable{cursor:pointer}
    /* A button FILLS its layout cell. BeerCSS sizes buttons to their label
       (inline-flex, content-box), which inside a cell — always a full share of
       its row or an n/12 grid span — left-aligns a short pill in a wide box:
       three nav buttons on one row came out ragged, spaced by leftover cell
       rather than by the gap. Every other card already fills its cell, so this
       is the cell contract catching up with them, not a button special case.
       `border-box` because BeerCSS buttons are content-box, so a bare 100%
       would add 2rem of padding on top of it and overflow. Only a cell's own
       root: the popup ✕ and the offline-banner button live outside the layout
       and keep hugging their labels. */
    .fh-cell>:is(.button,button){inline-size:100%;box-sizing:border-box}
    /* The slider card's label line (class contract, like .card): label left,
       live state right. It is PAINTED OVER the track (`.slider.max` is an
       absolutely-positioned overlay filling the card), so it must not take the
       pointer — without this the label and the live value are two dead strips
       the user has to aim around. */
    .slider-head{display:flex;gap:.75rem;align-items:baseline;justify-content:space-between;z-index:3;pointer-events:none}
    /* A slider is dragged sideways, so say so: BeerCSS's grab hand reads as
       "pick this up and move it anywhere". */
    .slider.max,.slider.max>input{cursor:ew-resize}
    .slider.max>input::-webkit-slider-thumb{cursor:ew-resize}
    .slider.max>input::-moz-range-thumb{cursor:ew-resize}
    /* Slide the fill to a state change instead of snapping. `inset` is what
       BeerCSS derives from `--_start`/`--_end`, so animating it covers both the
       server-baked value and beer.min.js's repaint; `background` covers a light
       changing colour. Suppressed while the slider is being dragged — there the
       fill must track the thumb frame by frame, and a transition reads as lag.
       :active alone is not enough: a pointer drag ends with the input still
       focused, and the echoed state should land where the user let go. */
    .slider.max>span:not([class]){transition:inset .3s cubic-bezier(.2,0,0,1),background .3s linear}
    .slider.max:is(:active,:focus-within,.fh-armed)>span:not([class]){transition:none}
    /* Touch: the CSS half of the press-and-hold gate (fhSliderHold in the page
       shell owns the timing). The range input is inert so a swipe that starts
       on a card scrolls the list instead of setting a value, and `pan-y` keeps
       that scroll native; the script drives the value itself once armed. */
    @media (pointer:coarse){
      .slider.max{touch-action:pan-y}
      .slider.max>input{pointer-events:none}
      .slider.max.fh-armed{box-shadow:inset 0 0 0 .125rem var(--primary)}
    }
    /* A slider card that HOLDS sliders (`c.sliderGroup`). The master's fill is
       the whole card's background, painted BEHIND the member rows, which is
       what makes the group read as one control rather than a titled list.

       BeerCSS positions a slider's painted `<span>` absolutely, and everything
       in BeerCSS is `position:relative` — so the span is normally trapped in
       its own wrapper. Taking the head and the wrapper OUT of positioning
       (`position:static`) hands the span the card as its containing block, and
       `inset:0 var(--_end) 0 0` then spans it edge to edge, full height. The
       `:before` inactive track would escape the same way, so it goes.

       The range input covers the head strip alone: a drag lower down the card
       belongs to the member row under the finger. */
    .slider-group{padding:0;overflow:hidden}
    .slider-group-head,.slider-group-track{position:static}
    /* Track and bar occupy the SAME grid cell, so the whole head strip is the
       master's drag surface with the icon/title/button painted over it. */
    .slider-group-head{display:grid;min-block-size:4.5rem}
    .slider-group-head>*{grid-area:1/1}
    .slider-group-track{margin:0;block-size:100%}
    .slider-group-track:before{display:none}
    .slider-group-track>input{block-size:100%}
    .slider-group-track>span:not([class]){inset:0 var(--_end) 0 0;block-size:auto;border-radius:0;opacity:.45;pointer-events:none}
    /* Inert, like `.slider-head` — the one thing in the bar that IS a control
       has to take the pointer back. */
    .slider-group-bar{display:flex;align-items:center;gap:.75rem;padding:.75rem 1rem;z-index:3;pointer-events:none}
    .slider-group-icon{flex:0 0 auto;display:flex;align-items:center;justify-content:center;
      inline-size:2.75rem;block-size:2.75rem;border-radius:50%;
      background:var(--surface-container-highest);color:var(--primary)}
    .slider-group-icon>i{font-size:1.5rem}
    .slider-group-title{display:flex;flex-direction:column;min-inline-size:0}
    .slider-group-title>.slider-group-sub{font-size:.8rem;color:var(--on-surface-variant)}
    .slider-group-action{pointer-events:auto;margin-inline-start:auto;
      background:var(--surface-container-highest);color:var(--on-surface)}
    .slider-group-action.lit{background:var(--primary);color:var(--on-primary)}
    /* Above the master's painted `<span>`, which is positioned and would
       otherwise cover the member rows' own backgrounds — the fill belongs
       AROUND the rows, not through them. */
    .slider-group-members{display:flex;flex-direction:column;gap:.5rem;padding:0 .5rem .5rem;z-index:2}
    /* A member is an ordinary slider card collapsed onto its own track: card
       and track share one grid cell, so the label and the live value ride ON
       the fill instead of sitting in a line above it. Members carry their own
       surface and no elevation — a shadow over the master's coloured fill reads
       as grime. */
    .slider-group-members .card{display:grid;min-block-size:3rem;margin:0;padding:0;
      background:var(--surface-container);box-shadow:none;border-radius:1.5rem;overflow:hidden}
    .slider-group-members .card>*{grid-area:1/1}
    .slider-group-members .slider-head{align-items:center;padding-inline:1rem}
    .slider-group-members .slider.max{margin:0;block-size:100%}
    .slider-group-members .slider.max>input{block-size:100%}
    .slider-group-members .slider.max:before{display:none}
    .slider-group-members .slider.max>span:not([class]){inset:0 var(--_end) 0 0;block-size:auto;border-radius:0}
    /* Tabs: the bar is BeerCSS's native `.tabs > a` element — even tab
       distribution, underline active indicator, hover/press states, all
       framework CSS (an inline-size override to make tabs hug their labels
       was tried and REVERTED: it detached the active underline from the
       anchor). Only the panel wrapper is ours. */
    .tab-panel{display:contents}

    /* Popup: BeerCSS's <dialog> styling (fixed, centered, elevated,
       surface-container-high) does the chrome; cap the width and unfill the ✕
       (a bare <button> is a filled primary pill by default). */
    dialog.popup{max-inline-size:min(90vw,32rem)}
    .popup-close{position:absolute;top:.5rem;right:.5rem;background:transparent;
      color:var(--on-surface-variant);block-size:auto;padding:.25rem .5rem;font-size:1rem}

    /* Connection banners. Structure/behavior are emitted by the server shell
       (Server.page); this owns the look. Shared layout, then a colour per failure
       kind — SSE transport (MD3 error role, flips in dark mode) vs upstream HA
       feed (warning amber) — so the two are visually distinct. A fixed bar
       overlaying the top; `data-show` keeps them hidden while healthy. */
    .fh-offline{position:fixed;top:0;left:0;right:0;z-index:1000;text-align:center;
      padding:.5rem 1rem;font-weight:600;box-shadow:0 1px 4px rgba(0,0,0,.3)}
    .fh-offline-sse{background:var(--error,#ba1a1a);color:var(--on-error,#fff)}
    .fh-offline-ha{background:var(--warning-color,#ffa600);color:#000}
    .fh-offline-action{background:transparent;border:1px solid currentColor;color:inherit;
      border-radius:.25rem;padding:.1rem .5rem;margin-left:.5rem;cursor:pointer;font:inherit}
    """
}

/// The theme instance entries reference (and optionally amend — see the
/// module doc for the `md3Light`/`tokens` amend forms).
theme: BeerTheme = new {}
