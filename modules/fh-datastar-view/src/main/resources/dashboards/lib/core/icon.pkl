/// The MDI name a card shows for an entity, so a third-party card can look like
/// a shipped one without copying the tables (`hass/icons.pkl`).
module core.icon

import "../hass.pkl"
import "simple.pkl" as simpleMod
import "../hass/icons.pkl" as tables

/// `mdi:thermometer` -> `mdi-thermometer`, the stylesheet's class; either
/// spelling is accepted.
const function mdiClass(name: String): String =
  name.replaceFirst("mdi:", "mdi-")

/// The icon, at build time, in HA's order: the entity's own `icon`, then its
/// device_class, then its domain. Read with `getPropertyOrNull`, since an
/// entity reporting no `icon` has no such property (ADR 0013).
///
/// A non-MDI override (a HACS `hue:` icon) falls through to the tables: the
/// stylesheet has no glyph for it, and blank is worse than the domain default.
const function iconFor(e: hass.Entity?): String? =
  if (e == null) null
  else
    let (own = e.getPropertyOrNull("icon"))
    let (dc = e.getPropertyOrNull("device_class"))
      if (own is String && own.startsWith("mdi:")) mdiClass(own)
      else if (dc is String && tables.deviceClassIcons.containsKey(dc))
        mdiClass(tables.deviceClassIcons[dc])
      else if (tables.domainIcons.containsKey(e.domain)) mdiClass(tables.domainIcons[e.domain])
      else null

/// The live icon, or null: for a domain without a state table, and for an
/// entity with its own `icon` or a `device_class`, either of which wins as in
/// HA. An unknown state falls back to [[iconFor]]'s answer, since HA adds
/// states after a domain ships.
const function stateIconFor(e: hass.Entity?): simpleMod.Simple? =
  if (e == null || !tables.stateIcons.containsKey(e.domain)) null
  else
    let (own = e.getPropertyOrNull("icon"))
    let (dc = e.getPropertyOrNull("device_class"))
      if (own is String || dc is String) null
      else
        let (table = tables.stateIcons[e.domain])
          simpleMod.matchOf(
            new Mapping {
              for (st, name in table) {
                [st] = "mdi " + mdiClass(name)
              }
            },
            "mdi " + (iconFor(e) ?? "")
          )
