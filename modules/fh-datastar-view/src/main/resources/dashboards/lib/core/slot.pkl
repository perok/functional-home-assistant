/// Slot values — what a card puts in a template hole — and the builders that
/// make a third-party card's label, value and second line mean what a shipped
/// card's do.
///
/// A slot is a bare String (a literal) or a [[Reading]]: a CEL transform over the
/// card's entity, or a [[simpleMod.Simple]] in the same field (the fast tier,
/// ADR 0028 — the form is the tier).
module core.slot

import "../hass.pkl"
import "../hass/active.pkl" as activeTables
import "predicate.pkl" as predMod
import "simple.pkl" as simpleMod
import "stage.pkl" as stageMod
import "node.pkl" as nodes

/// What a slot reads, with no binding yet (`docs/terminology.md`): the card it
/// is handed to puts it in a [[Slot]], which says where it lands.
/// `fh.view.model.SlotSource`, less the slot's `signal` and `type`.
class Reading {
  entityId: String? = null
  /// CEL, a [[simpleMod.Simple]], or on a fetch slot a [[stageMod.Stage]] over
  /// the provider's answer.
  transform: (String|simpleMod.Simple|stageMod.Stage) =
    if (fetch == null) simpleMod.state() else stageMod.passthrough
  default: String? = null
  bypassUnavailable: Boolean = true
  /// When this value is read, and whether a change is a reason to re-render:
  ///
  ///   - `live` — read every render, and a change to the entity is a render.
  ///   - `onRender` — read every render, never a reason for one (a friendly
  ///     name, a unit). The only mode structure may use on an entity.
  ///   - `once` — resolved once per (entity, transform), for a function of
  ///     WHICH entity this is (a service from `domain`). A rename would not
  ///     show until the dashboard rebuilds.
  ///
  /// A fetch slot is `onRender`: a provider's answer is never pushed.
  reads: "live"|"onRender"|"once" = if (fetch == null) "live" else "onRender"
  /// Makes this a fetch slot, read from a provider rather than live state
  /// (`providers/history.pkl`'s `HistoryFetch`).
  fetch: Fetch? = null
  /// Named inputs this slot's CEL reads, beside its node's
  /// ([[nodes.Node.expressionValues]]): the same kinds, a fetch included
  /// (`p.history.of(e, w)`), so a slot can carry what it reads. A name in both
  /// is a build error.
  hidden expressionValues: Mapping<String, nodes.ExpressionValue> = new {}
  values: Mapping<String, nodes.ExpressionValue>? =
    if (expressionValues.isEmpty) null else expressionValues
  /// When this slot has a value at all; otherwise it is `""`, its transform does
  /// not run and its fetches are not read:
  ///
  ///   valueWhile = q.entity(left).gt(q.prop("state"), 0)
  ///
  /// A constant, a condition (decided without CEL, over the slot's entity
  /// when it names none), or a reading of a bool; none may read a fetch.
  hidden valueWhile: nodes.BooleanInput = true
  valueWhileSlot: Reading? =
    if (valueWhile == true) null
    else if (valueWhile == false) nodes.booleanReading(predMod.neverHolds)
    else nodes.booleanReading(valueWhile as Reading|Expr|predMod.Predicate)
}

/// One named value a card's template places, filled per node. The template
/// reaches it through this object, so its name is written once:
///
/// ```
/// const local label = slotMod.slot("label")
/// template = "<span \(label.bind)>\(label)</span>"
/// slots { label.of(slotMod.labelSlot(null, text)) }
/// ```
///
/// Interpolated, it is the plain hole: `\(label)` is `{{label}}`. A slot with
/// no value is not set, which [[ifSet]] tests; one with only a name is what a
/// template piece shared across cards places (`core/tap.pkl`'s).
class Slot {
  name: String(!contains("."))
  /// A literal, a [[Reading]], or null: not set.
  value: (String|Reading)? = null
  /// Carry the value as a Datastar signal rather than bytes, so a change costs a
  /// frame entry instead of a re-render (ADR 0017). The template must place
  /// [[bind]]; the backend rejects it otherwise. Only a [[Reading]] moves.
  signal: SignalBind? = null
  /// `"bool"` for a slot the template reads as on/off, where the string
  /// `"false"` would be truthy; the build refuses a reading that is not one.
  /// `"cssClass"` for one placed in a `class` attribute ([[cssClass]]). Null is
  /// text; a `class:` binding is a bool by kind.
  type: SlotType? = null

  /// `{{{name}}}`, unescaped: markup the value already is (a chart).
  fixed raw: String = "{{{" + name + "}}}"
  /// The binding a signal slot places beside its hole, on the element whose
  /// text it is: `<span \(value.bind)>\(value)</span>`. Empty when the value is
  /// not a signal, which keeps the no-signals rendering reachable.
  fixed bind: String = "{{{" + name + ".bind}}}"
  /// The value as JavaScript, for a handler of the card's own: a literal reads
  /// back as `'light/toggle'`, a signal as its `$…` read, so one template
  /// serves both. A live slot that is not a signal is a build error.
  fixed jsValue: String = "{{{" + name + ".jsValue}}}"
  /// The signal's name, for an expression of the card's own (a signal-patch
  /// filter). A read is [[jsValue]] and a write [[assign]]. Signal-only: the
  /// build refuses it where it could render on a node whose slot is not one.
  fixed signalName: String = "{{" + name + ".signal}}"

  /// `$<signal> = js`: a write to this slot's signal from the card's own
  /// handler (a drag painting the fill). Signal-only, as [[signalName]].
  function assign(js: String): String = "$" + signalName + " = " + js

  /// `body` while the node sets this slot. Never `{{#name}}` around a signal's
  /// binding: the patch form withholds the value, so that section closes on the
  /// first patch and takes the element with it (ADR 0017).
  function ifSet(body: String): String = "{{#\(name).has}}\(body){{/\(name).has}}"
  function ifUnset(body: String): String = "{{^\(name).has}}\(body){{/\(name).has}}"
  /// `body` while the value is truthy: `""`, `false` and absence are not.
  function ifTrue(body: String): String = "{{#\(name)}}\(body){{/\(name)}}"
  function ifFalse(body: String): String = "{{^\(name)}}\(body){{/\(name)}}"
  /// Both halves, where each is the other's alternative.
  function ifSetElse(set: String, unset: String): String = ifSet(set) + ifUnset(unset)
  function ifTrueElse(yes: String, no: String): String = ifTrue(yes) + ifFalse(no)

  /// This slot holding `v`.
  function of(v: (String|Reading)?): Slot = let (self = this) (self) { value = v }
  /// A flag: set while `b` holds, for a template that reads it with
  /// [[ifSet]]/[[ifUnset]]. Not `of(Boolean)`, since a value can be a real
  /// `false` (`attr:disabled`).
  function setIf(b: Boolean): Slot = of(if (b) "1" else null)

  function toString(): String = "{{" + name + "}}"
}

const function slot(n: String): Slot = new { name = n }

/// A slot whose value is classes, placed in a `class` attribute: the theme's
/// class rules reach its value as they reach the template (ADR 0020). A
/// literal or a reading, filled with [[Slot.of]] like any other.
const function cssClass(n: String): Slot = new { name = n; type = "cssClass" }

/// The entity a card is about, which its other slots read unless they name
/// their own (`Dashboard.SubjectSlot`).
const subject: Slot = slot("entity_id")

/// A read of a named provider. Each provider's component module declares its
/// typed question as a subclass, which the backend decodes by `provider`.
abstract class Fetch {
  provider: String
}

typealias SlotType = "text"|"bool"|"cssClass"

/// Where a signal slot's value lands in the DOM. One constrained String, since
/// the wire form is one string and the kinds take a name; a typo is an eval
/// error. Build one with the `as…` helpers below.
typealias SignalBind =
  String(matches(Regex(#"text|bind|handler|(style|attr|class):\S+"#)))

/// `data-text`.
const asText: SignalBind = "text"

/// `data-bind`, two-way, for a form control's state: setting the attribute does
/// not move the property the browser reads once the element exists.
const asBind: SignalBind = "bind"

/// `data-style:<property>`. The value carries its own unit (`39.37%`).
const function asStyle(property: String): SignalBind = "style:" + property

/// `data-attr:<name>`. A boolean value sets or removes a boolean attribute:
/// `""` SETS one, only a real `false` removes it.
///
/// Prefer a real `disabled` here over [[asClass]] for a control the ENTITY's
/// state makes unusable — the browser then stops the click itself. Not for an
/// action in flight (ADR 0019): a disabled button loses focus.
const function asAttr(name: String): SignalBind = "attr:" + name

/// `data-class:<name>`, present while the value is truthy — `"false"` is ON. A
/// card that also paints the value inline needs `""`, or `true` lands in its
/// class list.
const function asClass(name: String): SignalBind = "class:" + name

/// No binding: an event handler reads the value through [[Slot.jsValue]] or
/// [[Slot.signalName]]. For a value that only a click consumes, so the markup
/// stays constant (ADR 0017).
const asHandler: SignalBind = "handler"

/// Whether `e`'s state is one of `states`, as a boolean reading.
const function stateIn(e: hass.Entity, states: List<String>): Reading = new {
  entityId = e.entity_id
  transform = simpleMod.stateIn(states.toListing())
  bypassUnavailable = false
}

/// Whether `e` is on as HA's tile draws it, live, or null for a domain with no
/// on look (a sensor). The tables are `hass/active.pkl`.
const function activeOf(e: hass.Entity): Reading? =
  if (activeTables.neutral.contains(e.domain)) null
  else new Reading {
    entityId = e.entity_id
    transform =
      if (activeTables.onIn.containsKey(e.domain))
        simpleMod.stateIn(activeTables.onIn[e.domain].toListing())
      else
        let (offStates =
          List("unavailable", "unknown")
            + (if (e.domain == "alert") activeTables.alertOffIn else List("off"))
            + (activeTables.offIn.getOrNull(e.domain) ?? List()))
          simpleMod.matchOf(new Mapping { for (st in offStates) { [st] = false } }, true)
    bypassUnavailable = false
  }

/// A timestamp state as the clock time it names, `18:03`, in `time_zone`: the
/// server's, which under the add-on is HA's own (Supervisor sets `TZ`). Any
/// other state passes through, so `unknown` still reads.
const CLOCK_TIME_EXPR: String = #"""
  state.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T')
    ? cel.bind(t, timestamp(state),
        cel.bind(h, t.getHours(time_zone), cel.bind(m, t.getMinutes(time_zone),
          (h < 10 ? '0' : '') + string(h) + ':' + (m < 10 ? '0' : '') + string(m))))
    : state
  """#

/// What an entity card reads out when told nothing: the clock time of a scene
/// or a button's last activation, else null (the state with its unit).
const function readingOf(e: hass.Entity): Expr? =
  if (activeTables.lastHappened.contains(e.domain)) new Expr { transform = CLOCK_TIME_EXPR }
  else null


/// A live value for a display field that also takes a plain string:
/// `label = expr(#"attr[?'friendly_name'].orValue('') + ' ' + state"#)`.
class Expr {
  entityId: String? = null
  transform: String
}

function expr(s: String): Expr = new { transform = s }

/// [[expr]] over another entity than the card's.
function exprOf(eo: hass.Entity, s: String): Expr = new { entityId = eo.entity_id; transform = s }

// Expr and Simple resolve even while unavailable, so a label shows the name;
// null bakes the friendly name.
const function labelSlot(entity: hass.Entity?, label: (String|Expr|simpleMod.Simple)?): Reading|String =
  if (label is Expr) new Reading { entityId = label.entityId; transform = label.transform; bypassUnavailable = false }
  else if (label is simpleMod.Simple) new Reading { transform = label; bypassUnavailable = false }
  else if (label != null) label
  else if (entity != null) entity.friendly_name ?? entity.entity_id
  else ""

// null: the state plus the entity's unit. A String names an attribute, with the
// unit. An Expr or Simple is used as given, unit and all.
const function valueSlot(value: (String|Expr|simpleMod.Simple)?): Reading =
  if (value is Expr) new Reading { entityId = value.entityId; transform = value.transform }
  else if (value is simpleMod.Simple) new Reading { transform = value }
  else if (value == null) new Reading { transform = simpleMod.suffixUnit("unit_of_measurement") }
  else new Reading { transform = simpleMod.attrUnit(value) }

/// A card's second line. A String is the text itself, never an attribute name
/// (that is [[attr]]).
typealias Secondary = String|Expr|Reading

/// `at` holding a second line. A live reading becomes a text signal, so a card
/// places it with `textMod.liveRun` under [[Slot.ifSet]].
const function secondary(at: Slot, s: Secondary?): Slot =
  if (s is Expr) (at) { value = new Reading { entityId = s.entityId; transform = s.transform; default = "" }; signal = asText }
  else if (s is Reading && s.fetch == null && s.reads == "live") (at) { value = s; signal = asText }
  else at.of(s)

/// `at` holding `v` as a signal bound as `kind`.
const function signalled(at: Slot, v: Reading, kind: SignalBind): Slot =
  (at) { value = v; signal = kind }

/// `at` (a [[cssClass]] slot) holding an element's whole class: a reading moves
/// as a signal on `class`, so a glyph can swap.
const function liveClass(at: Slot, v: (String|Reading)?): Slot =
  if (v is Reading) (at) { value = v; signal = asAttr("class") } else at.of(v)

/// `at` holding text: a reading moves as a text signal (ADR 0017), so a
/// ticking value costs a few bytes instead of the card.
const function liveText(at: Slot, v: (String|Reading)?): Slot =
  if (v is Reading) (at) { value = v; signal = asText } else at.of(v)

/// One attribute of the card's entity, blank when absent:
/// `c.entityCard(l).secondary(c.attr("device_class"))`.
const function attr(attrName: String): Reading =
  new Reading { transform = simpleMod.attr(attrName); default = "" }
