/// Slot values — what a card puts in a template hole — and the builders that
/// make a third-party card's label, value and second line mean what a shipped
/// card's do.
///
/// A slot is a bare String (a literal) or a [[Slot]]: a CEL transform over the
/// card's entity, or a [[simpleMod.Simple]] in the same field (the fast tier,
/// ADR 0028 — the form is the tier).
module core.slot

import "../hass.pkl"
import "../hass/active.pkl" as activeTables
import "simple.pkl" as simpleMod
import "stage.pkl" as stageMod
import "variable.pkl" as varMod

/// The object form of a slot (`fh.view.model.SlotSource`).
class Slot {
  entityId: String? = null
  /// CEL, a [[simpleMod.Simple]], or on a query slot a [[stageMod.Stage]] over
  /// the provider's answer.
  transform: (String|simpleMod.Simple|stageMod.Stage) =
    if (query == null) "state" else stageMod.passthrough
  default: String? = null
  bypassUnavailable: Boolean = true
  /// When this value is read, and whether a change is a reason to re-render:
  ///
  ///   - `live` — read every render, and a change to the entity is a render.
  ///   - `onRender` — read every render, never a reason for one (a friendly
  ///     name, a unit). The only mode structure may use on an entity.
  ///   - `once` — resolved once per (entity, transform), for a function of
  ///     WHICH entity this is (a service from `domain`). A rename would not
  ///     show until the dashboard rebuilds.
  ///
  /// A query slot is `onRender`: a provider's answer is never pushed.
  reads: "live"|"onRender"|"once" = if (query == null) "live" else "onRender"
  /// Carry the value as a Datastar signal rather than bytes, so a change costs a
  /// frame entry instead of a re-render (ADR 0017). The template must place
  /// [[signalBind]] for this slot; the backend rejects it otherwise.
  signal: SignalBind? = null
  /// `"bool"` for a slot the template reads as on/off, where the string
  /// `"false"` would be truthy; the build refuses a reading that is not one.
  /// Null is text; a `class:` binding is a bool by kind.
  type: SlotType? = null
  /// Makes this a query slot, read from a provider rather than live state
  /// (`components/history.pkl`'s `chartSlot`, or [[querySlot]]).
  query: Query? = null
}

/// A read of a named provider, checked by the backend's `Queries.parse`.
class Query {
  provider: String
  /// A value, or a read of a node variable ([[varMod.ref]]). The backend
  /// refuses a variable value that would make the query read an entity its
  /// dashboard does not show (ADR 0023).
  params: Mapping<String, String|varMod.Ref>
}

const function querySlot(
  name: String,
  args: Mapping<String, String|varMod.Ref>
): Slot =
  new Slot { query = new Query { provider = name; params = args } }

typealias SlotType = "text"|"bool"

/// Where a signal slot's value lands in the DOM. One constrained String, since
/// the wire form is one string and the kinds take a name; a typo is an eval
/// error. Build one with the `as…` helpers below.
typealias SignalBind =
  String(matches(Regex(#"text|bind|handler|(style|attr|class):\S+"#)))

/// `data-text`.
const asText: SignalBind = "text"

/// `data-bind`, two-way, for a form control's state: setting the attribute does
/// not move the property the browser reads once the element exists.
const asBind: SignalBind = "bind"

/// `data-style:<property>`. The value carries its own unit (`39.37%`).
const function asStyle(property: String): SignalBind = "style:" + property

/// `data-attr:<name>`. A boolean value sets or removes a boolean attribute:
/// `""` SETS one, only a real `false` removes it.
///
/// Prefer a real `disabled` here over [[asClass]] for a control the ENTITY's
/// state makes unusable — the browser then stops the click itself. Not for an
/// action in flight (ADR 0019): a disabled button loses focus.
const function asAttr(name: String): SignalBind = "attr:" + name

/// `data-class:<name>`, present while the value is truthy — `"false"` is ON. A
/// card that also paints the value inline needs `""`, or `true` lands in its
/// class list.
const function asClass(name: String): SignalBind = "class:" + name

/// No binding: an event handler reads the value through [[signalRef]]. For a
/// value that only a click consumes, so the markup stays constant (ADR 0017).
const asHandler: SignalBind = "handler"

/// The binding a signal slot's card places beside the `{{name}}` hole:
///
/// ```
/// <span class="fh-reading" \(signalBind("value"))>{{value}}</span>
/// ```
///
/// The backend fills it, and with nothing when the value is not a signal, which
/// keeps the no-signals rendering reachable.
const function signalBind(name: String): String = "{{{" + name + "__bind}}}"

/// The signal's name, for an expression of the card's own (the slider's commit
/// URL). Signal-only.
const function signalRef(name: String): String = "{{" + name + "__signal}}"

/// The slot's value as a JS expression, for a handler of the card's own:
///
/// ```
/// @post('sse/call/{{dashboardSlug}}/' + \(slotRead("service")) + '/entity/{{entity_id}}')
/// ```
///
/// A literal reads back as `'light/toggle'`, a signal as its `$…` read, so one
/// template serves both and the card never branches. A live slot that is not a
/// signal is a build error.
const function slotRead(name: String): String = "{{{" + name + "__read}}}"

/// Whether `e`'s state is one of `states`, as a boolean reading.
const function stateIn(e: hass.Entity, states: List<String>): Slot = new {
  entityId = e.entity_id
  transform = simpleMod.stateIn(states.toListing())
  bypassUnavailable = false
}

/// Whether `e` is on as HA's tile draws it, live, or null for a domain with no
/// on look (a sensor). The tables are `hass/active.pkl`.
const function activeOf(e: hass.Entity): Slot? =
  if (activeTables.neutral.contains(e.domain)) null
  else new Slot {
    entityId = e.entity_id
    transform =
      if (activeTables.onIn.containsKey(e.domain))
        simpleMod.stateIn(activeTables.onIn[e.domain].toListing())
      else
        let (offStates =
          List("unavailable", "unknown")
            + (if (e.domain == "alert") activeTables.alertOffIn else List("off"))
            + (activeTables.offIn.getOrNull(e.domain) ?? List()))
          simpleMod.matchOf(new Mapping { for (st in offStates) { [st] = false } }, true)
    bypassUnavailable = false
  }

/// The section for optional markup holding a slot:
///
/// ```
/// \(ifSlot("icon"))<i class="{{icon}}" \(signalBind("icon"))></i>\(endIfSlot("icon"))
/// ```
///
/// Never `{{#icon}}`: a signal's value is withheld in the patch form, so a
/// section on the value deletes its own element on the first patch
/// (`SignalSectionSuite`). `name__has` is filled for every declared slot.
const function ifSlot(name: String): String = "{{#" + name + "__has}}"

const function endIfSlot(name: String): String = "{{/" + name + "__has}}"

const function ifNoSlot(name: String): String = "{{^" + name + "__has}}"

const function endIfNoSlot(name: String): String = "{{/" + name + "__has}}"

/// A live value for a display field that also takes a plain string:
/// `label = expr(#"attr[?'friendly_name'].orValue('') + ' ' + state"#)`.
class Expr {
  entityId: String? = null
  transform: String
}

function expr(s: String): Expr = new { transform = s }

/// [[expr]] over another entity than the card's.
function exprOf(eo: hass.Entity, s: String): Expr = new { entityId = eo.entity_id; transform = s }

const UNIT_EXPR =
  #"attr[?'unit_of_measurement'].optMap(u, ' ' + u).orValue('')"#

// Expr and Simple resolve even while unavailable, so a label shows the name;
// null bakes the friendly name.
const function labelSlot(entity: hass.Entity?, label: (String|Expr|simpleMod.Simple)?): Slot|String =
  if (label is Expr) new Slot { entityId = label.entityId; transform = label.transform; bypassUnavailable = false }
  else if (label is simpleMod.Simple) new Slot { transform = label; bypassUnavailable = false }
  else if (label != null) label
  else if (entity != null) entity.friendly_name ?? entity.entity_id
  else ""

// null: the state plus the entity's unit. A String names an attribute, with the
// unit — two reads, so CEL. An Expr or Simple is used as given, unit and all.
const function valueSlot(value: (String|Expr|simpleMod.Simple)?): Slot =
  if (value is Expr) new Slot { entityId = value.entityId; transform = value.transform }
  else if (value is simpleMod.Simple) new Slot { transform = value }
  else if (value == null) new Slot { transform = simpleMod.suffixUnit("unit_of_measurement") }
  else new Slot {
    transform =
      "attr[?'" + value + "'].orValue('')" +
      " + (" + UNIT_EXPR + ")"
  }

/// A card's second line. A String is the text itself, never an attribute name
/// (that is [[attr]]).
typealias Secondary = String|Expr|Slot

/// A live reading becomes a text signal, so a card placing it uses
/// `textMod.liveRun` under [[ifSlot]].
const function secondarySlot(s: Secondary): String|Slot =
  if (s is Expr) new Slot { entityId = s.entityId; transform = s.transform; default = ""; signal = asText }
  else if (s is Slot && s.query == null && s.reads == "live" && s.signal == null) (s) { signal = asText }
  else s

/// One attribute of the card's entity, blank when absent:
/// `c.entityCard(l).secondary(c.attr("device_class"))`.
const function attr(attrName: String): Slot =
  new Slot { transform = simpleMod.attr(attrName); default = "" }
