/// Slot values — what a card puts in a template hole, and the shared builders
/// that shape the common ones the same way every card does.
///
/// A slot is either a bare String (a constant literal) or a [[Slot]] object: a
/// live CEL transform over the card's entity ([[Slot.transform]], the engine
/// tier) or an opted-in [[simpleMod.Simple]] structure ([[Slot.simple]], the fast tier —
/// the field IS the tier selection; nothing recognizes expression spelling).
/// The builders are the reason a third-party card can look like a shipped one:
/// `labelSlot` falls back to friendly_name, `valueSlot` appends the entity's
/// unit, `secondarySlot` keeps the mustache section collapsed when blank.
module core.slot

import "../hass.pkl"
import "simple.pkl" as simpleMod

/// The object form of a slot (fh.view.model.SlotSource): a CEL expression
/// over the card's entity. [[Slot.reads]] says when it is read.
class Slot {
  entityId: String? = null
  transform: String = "state"
  /// The EXPLICIT fast-tier opt-in (plan Phase 3): one of the
  /// [[simpleMod.Simple]] structures, evaluated by hand-rolled reads with its
  /// idiomatic CEL as the documented definition. Setting this IS the tier
  /// selection — mutually exclusive with authoring `transform` (the backend
  /// rejects both).
  simple: simpleMod.Simple? = null
  default: String? = null
  bypassUnavailable: Boolean = true
  /// WHEN this value is read, and whether reading it is a reason to re-render.
  ///
  ///   - `live` — read every render, and a change to the entity IS a render.
  ///     A brightness, a state readout.
  ///   - `onRender` — read every render, and never a reason to have one. A
  ///     friendly name, a unit: right whenever the card is drawn, costing no
  ///     subscription. The only mode a STRUCTURAL card may use on an entity,
  ///     since structure is never patched.
  ///   - `once` — resolved once per (entity, transform) and reused for the
  ///     dashboard's life. For a value that is a function of WHICH entity this
  ///     is rather than of its state: a service action from `domain`, an id in
  ///     a URL. Wrong for anything that can move — a rename would not show
  ///     until the dashboard rebuilds.
  ///
  /// Three values and not two flags: `reactive: Boolean` could say "track and
  /// re-read" or "ignore and read once", and the pairing an author keeps
  /// wanting — a value that CAN move but is not worth waking the card for —
  /// was the one it could not express.
  reads: "live"|"onRender"|"once" = "live"
  /// Carry this value as a Datastar SIGNAL rather than as bytes in the element,
  /// so a change to it costs a signals frame instead of re-rendering the whole
  /// card (ADR 0017). The value says WHERE it lands — see [[SignalBind]] —
  /// because that is the one thing the backend cannot infer.
  ///
  /// The card's template MUST place [[signalBind]] for this slot, or the value
  /// stops updating; the backend rejects the dashboard if it does not.
  signal: SignalBind? = null
}

/// WHERE a signal slot's value lands in the DOM. Spelled as a constrained
/// String rather than a class hierarchy for two reasons: the wire form IS one
/// string (so a class would need flattening on the way out), and the
/// parameterised kinds take a property/attribute/class NAME, which a plain
/// union of literals cannot express.
///
/// The constraint is what a union would have bought — a typo is an eval error
/// naming the value, not a slot that silently binds nothing. Build one with
/// [[asText]] / [[asBind]] / [[asStyle]] / [[asAttr]] / [[asClass]] rather than
/// writing the string, so the spelling lives in one place.
typealias SignalBind =
  String(matches(Regex(#"text|bind|(style|attr|class):\S+"#)))

/// `data-text` — the element's whole text content. The common case: a reading,
/// a label, a state.
const asText: SignalBind = "text"

/// `data-bind` — TWO-WAY on a form control. The backend writes the signal and
/// the user's input writes it back. What a range input's position wants, and
/// what a checkbox's `checked` wants: setting the ATTRIBUTE does not move the
/// property the browser reads once the element exists.
const asBind: SignalBind = "bind"

/// `data-style:<property>` — one CSS property, custom properties included. The
/// VALUE carries its own unit (`39.37%`, `#ffb46b`), so nothing composes an
/// expression around it: the transform decides the shape, in one place.
const function asStyle(property: String): SignalBind = "style:" + property

/// `data-attr:<name>` — one attribute. NOT for a form control's state; see
/// [[asBind]].
const function asAttr(name: String): SignalBind = "attr:" + name

/// `data-class:<name>` — one class, present while the value is truthy. A
/// BOOLEAN state: the transform must yield `""` for off, because an empty
/// string is the only falsy thing a slot can produce — `"false"` reads as ON.
const function asClass(name: String): SignalBind = "class:" + name

/// The binding a signal slot's card places, beside the ordinary `{{name}}`
/// hole:
///
/// ```
/// <span class="state" \(signalBind("value"))>{{value}}</span>
/// ```
///
/// The backend fills `name__bind` with the whole attribute — whichever of
/// `data-text`/`data-bind`/`data-style:…`/`data-attr:…` the slot's [[Slot.signal]]
/// named, and NOTHING when the value is not signal-backed. That is why the
/// backend owns it: a card that wrote `data-text` itself could not have it
/// un-written, and the plain (no-signals) rendering would stop being reachable.
/// Raw (`{{{…}}}`) because it IS markup.
const function signalBind(name: String): String = "{{{" + name + "__bind}}}"

/// The signal's NAME, for the one thing a canned binding cannot cover: a card
/// composing it into an expression of its own (a slider's action URL reads its
/// own bound position). Not a binding — but a card that uses it is relying on
/// the signal existing, so it is not usable by a client that takes no signals.
const function signalRef(name: String): String = "{{" + name + "__signal}}"

/// [[valueSlot]] as a text signal slot — the same value, carried as a signal.
/// The card must place `signalBind("value")`.
const function signalValueSlot(value: (String|Expr|simpleMod.Simple)?): Slot =
  (valueSlot(value)) { signal = asText }

/// A live value expression for a display field that also accepts a plain
/// string: `label = expr(#"('friendly_name' in attr ? attr['friendly_name'] : '') + ' ' + state"#)`
/// vs the literal `label = "Kitchen"`.
class Expr {
  entityId: String? = null
  transform: String
}

function expr(s: String): Expr = new { transform = s }

/// A live value expression bound to an EXPLICIT entity (a cross-entity read):
/// the emitted slot names its own `entityId` instead of inheriting the card's.
/// Mirrors jsonnet `entityOf` (components.libsonnet:102-105).
function exprOf(eo: hass.Entity, s: String): Expr = new { entityId = eo.entity_id; transform = s }

// Auto-appended unit for a value display: the entity's unit_of_measurement,
// space-separated, when it has one. The append is a guarded CEL conditional
// spliced onto the value expression with a `+` (presence is a real boolean;
// `attr['x']` on an absent key is an eval error, so every read is guarded).
const UNIT_EXPR =
  #"'unit_of_measurement' in attr ? ' ' + attr['unit_of_measurement'] : ''"#

// label: Expr -> live (still resolving when unavailable, so a label shows the
// name, not "unavailable"); Simple -> the opted-in structure (same bypass
// semantics as Expr); String -> literal; null -> the entity's
// friendly_name (falling back to its id) baked as a literal.
const function labelSlot(entity: hass.Entity?, label: (String|Expr|simpleMod.Simple)?): Slot|String =
  if (label is Expr) new Slot { entityId = label.entityId; transform = label.transform; bypassUnavailable = false }
  else if (label is simpleMod.Simple) new Slot { simple = label; bypassUnavailable = false }
  else if (label != null) label
  else if (entity != null) entity.friendly_name ?? entity.entity_id
  else ""

// value: null -> state (+ unit); String -> that attribute, guarded (+ unit);
// Expr -> your expression verbatim (you own the unit); Simple -> the opted-in
// structure verbatim (you own everything — no unit is auto-appended; [[unit]]
// is the unit shape).
const function valueSlot(value: (String|Expr|simpleMod.Simple)?): Slot =
  if (value is Expr) new Slot { entityId = value.entityId; transform = value.transform }
  else if (value is simpleMod.Simple) new Slot { simple = value }
  else new Slot {
    transform =
      (if (value == null) "state"
       else "('" + value + "' in attr ? attr['" + value + "'] : '')") +
      " + (" + UNIT_EXPR + ")"
  }

// secondary (only built when authored): String -> an attribute, guarded (no
// unit); Expr -> live; Simple -> the opted-in structure. Empty default keeps
// the mustache section collapsed when blank.
const function secondarySlot(secondary: String|Expr|simpleMod.Simple): Slot =
  if (secondary is simpleMod.Simple) new Slot { simple = secondary; default = "" }
  else new Slot {
    entityId = if (secondary is Expr) secondary.entityId else null
    transform =
      if (secondary is Expr) secondary.transform
      else "'" + secondary + "' in attr ? attr['" + secondary + "'] : \"\""
    default = ""
  }
