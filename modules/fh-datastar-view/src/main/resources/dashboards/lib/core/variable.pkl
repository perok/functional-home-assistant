/// NODE VARIABLES — a node declares a named choice, a descendant reads it.
///
/// Resolution is by NAME up the ancestor chain: a node that declares nothing is
/// transparent, a nested declaration shadows, and a reader with no declarer is
/// a build error naming both. The server resolves it before rendering, because
/// the first HTML a browser gets is complete. ADR 0033 lists the rules.
///
/// A [[Variable]] is only a name: a reader holds one, written independently of
/// whichever node above declares it. A [[Declaration]] is one node owning a
/// value for that name, and holds the variable it declares:
///
///     const window: varMod.Variable = new { name = "window" }
///
///     (c.column) {
///       vars { window.defaultingTo("24h") }
///       children { c.history.chart(sensor).over((p) -> p.history.chosen(window, p.history.presets)) }
///     }
///
/// No list of allowed values: the write boundary refuses a value no declared
/// reader takes, such as a key a chosen window's table lacks. For a closed
/// set, emit the declaration and its control from one select
/// (`components/select.pkl`'s `Chooser`).
module core.variable

import "tap.pkl" as tapMod
import "surface.pkl" as surfaceMod
import "../hass.pkl"

/// A plain token: it is spelled into signal names and the URL.
typealias Name = String(matches(Regex("[A-Za-z][A-Za-z0-9_]*")))

/// A value a viewer can choose: a plain token, since it travels in a route
/// segment and a JS string.
typealias Value = String(matches(Regex("[A-Za-z0-9_.:-]+")))

/// The wire shape of a read: what a chosen window is chosen `by`
/// (`fh.view.model.Choice.Chosen`). `var` is the wire key, hence the backticks;
/// get one from [[Variable.ref]].
class Ref {
  `var`: String
}

/// A node variable as one typed value: its name, and every spelling of it a
/// reader below its declarer needs.
class Variable {
  name: Name

  /// A read of it, resolved up the ancestors at build time.
  fixed ref: Ref = let (n = name) new Ref { `var` = n }

  /// The declaring node's id, written from a node below it: a token the build
  /// splices (`DashboardBuild.declarerToken`) and refuses where nothing above
  /// declares the name.
  fixed declarer: String = "@@VAR:\(name)@@"

  /// Its signals and URL param, written from a node below the declarer: a
  /// button, a highlight.
  fixed below: Spelling =
    let (n = name) let (d = declarer) new Spelling { variable = n; declarerId = d }

  /// The same, written in the declarer's own template, where `{{id}}` is its
  /// id.
  fixed own: Spelling = let (n = name) new Spelling { variable = n; declarerId = "{{id}}" }

  /// The activation of a bake group whose member this variable chooses by
  /// index: a tab bar's panel.
  fixed selects: surfaceMod.VarActivation = let (n = name) new { name = n }

  /// The activation of the bake member this variable shows at `at`.
  function selecting(at: Value): surfaceMod.VarActivation =
    let (n = name) let (v = at) new { name = n; at = new surfaceMod.AtValue { value = v } }

  /// The activation of the bake member it shows at every value no other member
  /// names.
  fixed selectingAnyOther: surfaceMod.VarActivation =
    let (n = name) new { name = n; at = new surfaceMod.AtOtherwise {} }

  /// Whether it holds `at`, as an If's condition: `c.iff(window.valueIs("30d"))`.
  /// Not a predicate, so it cannot be combined with one over entity state. Named
  /// beside `q`'s `stateIs`, since `is` is a Pkl keyword.
  function valueIs(at: Value): ValueIs = let (self = this) new ValueIs { variable = self; value = at }

  /// Its declaration, at `value` until a viewer chooses: an entry in the
  /// declaring node's `vars`.
  function defaultingTo(value: Value): Declaration =
    let (self = this) let (v = value) new Declaration { variable = self; default = v }

  /// Choose `value`, from a node below the declarer. It sets only the pending
  /// ask; the server commits once the readers have re-rendered (ADR 0025).
  function choose(value: Value): tapMod.SetVar =
    let (n = name) let (d = declarer) let (s = below)
      new tapMod.SetVar {
        onclick = tapMod.clickSlot(
          "\"$" + s.pending + " = '" + value + "'; " +
            #"@post('sse/var/" + dashboard_slug + "/"# + d + "/" + n + "/" + value +
            "?group=\(s.group)'" + #")""#
        )
      }
}

/// One node's declaration of a [[Variable]]. Its value, highest first: the
/// viewer's choice, its [[initialTransform]]'s result, its [[default]].
class Declaration {
  /// What it declares, for the readers below: `d.variable.ref`.
  hidden variable: Variable
  fixed name: Name = variable.name
  /// What it holds before anyone chooses.
  default: Value
  /// Whether a choice is mirrored into the page URL, so a refresh or a link
  /// keeps it. Off, it lives as long as the page: [[notInUrl]].
  inUrl: Boolean = true
  /// Where a session opens it instead of at [[default]]: [[withInitialTransform]].
  initialTransform: InitialTransform? = null

  /// Kept out of the page URL: a choice a refresh may forget, such as one
  /// light's control in a set of many. A link naming it is still read.
  function notInUrl(): Declaration = let (self = this) (self) { inUrl = false }

  /// Opened by CEL over `e`'s state, run once as a session opens; it does not
  /// follow the entity afterwards. A result no reader takes keeps [[default]].
  function withInitialTransform(e: hass.Entity, cel: String): Declaration =
    let (self = this) let (id = e.entity_id)
      (self) { initialTransform = new InitialTransform { entityId = id; transform = cel } }
}

/// A node variable at one value: what an If over a variable is chosen by.
class ValueIs {
  variable: Variable
  value: Value
}

/// Where a session opens a variable: CEL over one entity's state, which the
/// dashboard then watches.
class InitialTransform {
  entityId: String
  transform: String
}

/// One variable's signals and URL param, from wherever its declarer's id is
/// written. The server's spelling is `fh.view.runtime.VarKey`, and
/// `VarSignalNamesSuite` holds the two equal.
class Spelling {
  hidden variable: Name
  hidden declarerId: String

  /// The selection group, which also names the pending ask.
  fixed group: String = "var_\(declarerId)__\(variable)"
  /// What the server says is in effect; only it writes this.
  fixed committed: String = "_\(group)"
  /// What this client has asked for.
  fixed pending: String = tapMod.pendingSignal(group)
  fixed urlParam: String = "v.\(declarerId).\(variable)"
  /// What a highlight compares: the ask while one is out, else the commit.
  fixed chosen: String = tapMod.pendingOrCommittedOf(group, committed)
}
