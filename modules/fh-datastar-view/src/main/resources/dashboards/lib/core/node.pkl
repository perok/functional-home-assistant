/// The layout tree and the card contract — what a component-library author
/// extends to add a card of their own.
///
/// A card is a CLASS: subclass [[Node]], give it a `card` name and a `cardDef`
/// (its template + declared slots), and [[cardsOf]] finds it by reflection. Every
/// node is a CELL — the renderer wraps it in an id'd `.fh-cell`, and the layout
/// builders here put the `fh-` contract classes on that wrapper.
///
/// CONTRACT: literal slots must be JSON strings, never numbers — the backend
/// slot decoder rejects numbers (stringify numeric config: `"\(...)"`).
module core.node

import "slot.pkl" as slotMod
import "surface.pkl" as surfaceMod
import "text.pkl" as textMod
import "pkl:reflect"

/// Per-node layout-cell parameters (mirrors fh.view.model.Cell): extra CSS
/// classes the renderer puts on this node's `.fh-cell` wrapper. The class
/// names are the theme-agnostic `fh-` layout contract (see lib/theme.pkl).
/// Authors normally use the builder methods on [[LayoutNode]] (`columns`,
/// `fullWidth`, `cellClass`) rather than writing one directly.
class Cell {
  classes: Listing<String> = new {}
}

/// The common supertype of every layout-tree node. `kind` is the circe
/// discriminator: `"component"` for a [[Node]], `"set"` for a [[SetNode]].
///
/// Every node is a CELL: the renderer wraps it in an id'd `.fh-cell` (the
/// real flex/grid item), and the layout builders below put `fh-` contract
/// classes on that wrapper. They follow HA's `grid_options` conventions —
/// inside a [[Grid]] (12 columns), `columns(n)` is a card's width in grid
/// columns (default 4, a third of the grid, like HA sections). No effect
/// inside a [[Row]]/[[Column]], which size by share/fill, not spans. The
/// builders return the base [[LayoutNode]] type, so chain them AFTER
/// card-specific ones:
/// `c.entityCard(e).tapAction(c.tap.toggle).columns(3)`.
abstract class LayoutNode {
  kind: String
  /// Layout-cell classes for this node's wrapper. Null (dropped from the wire
  /// JSON) until a layout builder adds one.
  cell: Cell? = null
  /// This cell spans `n` of the surrounding grid's 12 columns (HA
  /// `grid_options.columns`). No effect outside a [[Grid]]/group.
  function columns(n: Int(this >= 1 && this <= 12)): LayoutNode = addCellClass("fh-cols-\(n)")
  /// Span the surrounding grid's full width (HA `columns: full`).
  function fullWidth(): LayoutNode = addCellClass("fh-cols-full")
  /// Shrink this cell to its content instead of filling its share. The escape
  /// from the default every other card wants — see [[Pill]], which is this plus
  /// chip styling.
  function hug(): LayoutNode = addCellClass("fh-hug")
  /// What this card does with a label too long for its box — wrap it, clip it
  /// with an ellipsis, or scroll it (`core/text.pkl`). Applies to this node AND
  /// everything under it, so a group sets it once and a single member inside
  /// still overrides it.
  ///
  /// The dashboard's own default is `entry.pkl`'s `textOverflow`; reach for this
  /// where ONE card differs — a card whose label must be readable in full, a
  /// tile that must not change height.
  function textOverflow(o: textMod.Overflow): LayoutNode = addCellClass(textMod.cls(o))
  /// Escape hatch: put an arbitrary class on the wrapper (a theme helper, a
  /// custom rule). Must be a plain class token — validated at build time.
  function cellClass(cls: String): LayoutNode = addCellClass(cls)
  // Shared appender: replace `cell` with a copy carrying one more class (the
  // null default is never amended — amending a null Listing is an error).
  //
  // ONE PER NODE, per FAMILY: adding an `fh-cols-*` class DROPS any it already
  // had, and the same for `fh-text-*`. Both `columns(n)` and `fullWidth()` emit
  // a `flex-basis` rule, so with two present which one applies would be decided
  // by the order of the rules in the stylesheet, not by the author's last word —
  // a silently-losing override. It is also what lets a card DEFAULT its span
  // ([[Tabs]], [[If]]) and still be overridden per node.
  function addCellClass(cls: String): LayoutNode =
    let (self = this)
    let (family = List("fh-cols-", "fh-text-").findOrNull((p) -> cls.startsWith(p)))
    let (had = if (self.cell != null) self.cell!!.classes.toList() else List())
    let (kept = if (family != null) had.filter((c) -> !c.startsWith(family)) else had)
      (self) {
        cell = new Cell {
          classes = new Listing<String> {
            for (c in kept) { c }
            cls
          }
        }
      }
}

abstract class Node extends LayoutNode {
  kind: "component" = "component"
  card: String
  // The card's template + declared slots, CO-LOCATED with the class that
  // populates them. `hidden`, so it never emits into a node's JSON — the
  // [[cards]] registry at the bottom collects each concrete subclass's
  // class-level default by reflection. Must be a self-contained default (no
  // instance-property references). NOTE (multiline templates): each HTML
  // *attribute value* must stay on one physical line — line breaks between
  // tags/attributes are harmless whitespace, but a newline inside an
  // attribute would break it.
  hidden cardDef: CardDef
  // A live slot carrying BYTES on a STRUCTURAL card is a build error: such a
  // card holds content AND would re-render on state, and its patch would carry
  // everything it holds. Put the live markup in a region as a node
  // ([[SliderHead]]), or move the value to a SIGNAL slot — which is allowed
  // here, because it never becomes bytes in this card's element: it is seeded
  // on the node's wrapper and updated by its own frame.
  //
  // Checked at the NODE, not the card, because liveness is a property of the
  // VALUE: `Slot|String` IS the distinction (a Pkl `String` is exactly the
  // wire's `literal`), so [[Grid]] keeps its `class` slot — a literal — and only
  // a genuinely LIVE one is rejected — `onRender` and `once` read an entity
  // without tracking it, which is exactly what structure may do, and a SIGNAL
  // slot is exempt whatever it reads: its value never becomes bytes in this
  // card. Mirrors `LayoutNode.Component.liveEntitiesAsBytes`, subject case
  // included (the subject counts only when `entity_id` is a literal).
  slots: Mapping<String, slotMod.Slot|String>(
    !isStructure(cardDef) || !toMap().values.any((v) ->
      v is slotMod.Slot && v.reads == "live" && v.signal == null &&
        (v.entityId != null ||
        (containsKey("entity_id") && this["entity_id"] is String)))
  ) = new {}
  /// An id of the author's choosing, replacing the position-derived one for
  /// this node AND rooting its descendants (`detail`, `detail_0`, …).
  ///
  /// Node ids are user-visible: a tab bar mirrors its own into the `ui.<id>`
  /// URL param, and every signal a card owns is named after it. Positional ids
  /// make both of those hostage to layout — insert a card above a tab bar and
  /// every bookmark pointing at a tab stops resolving. Naming the node is how
  /// an author says "this one's identity is mine, not the tree's".
  ///
  /// Rarely needed: leave it null and the id is derived, which is right for
  /// almost everything. `Dashboard.validate` checks a name is a plain token,
  /// is globally unique, and is not inside a candidate set's clause (which is
  /// instantiated once per member, so every member would claim the name).
  id: String? = null
  /// What fills this node's regions — what an AUTHOR writes.
  ///
  /// A bare `Listing` is the DEFAULT region — the one hole most cards have:
  /// `Grid { children { … } }`. A `Mapping` names each region, which is what a
  /// card with more than one hole needs ([[Slider]] holds its head in one and
  /// its members in another).
  ///
  /// Two forms rather than making everyone name the only hole they have — the
  /// same trade [[slotMod.Slot]] makes between a bare String and an object.
  /// `hidden`, because the two forms stop here: [[regions]] is what reaches the
  /// wire, and it has one.
  ///
  /// Widened to LayoutNode so a container can nest either a component or a
  /// dynamic group.
  hidden children: Listing<LayoutNode>|Mapping<String, Listing<LayoutNode>> = new Listing {}
  /// [[children]] with the default region NAMED — the one form on the wire, and
  /// not something an author assigns.
  ///
  /// The sugar is worth having and two wire forms are not: every reader of the
  /// JSON would have to know both, and the one that omits the region name is
  /// the one that cannot say which hole it means. Normalising here keeps the
  /// authoring convenience and leaves the record explicit — `Component.regions`
  /// in the backend is a plain map, and the build's hoist walks one shape.
  ///
  /// Null (dropped by omitNullProperties) when there is nothing to fill, which
  /// is every leaf.
  regions: Mapping<String, Listing<LayoutNode>>? =
    if (children is Mapping) children
    else if (children.isEmpty) null
    else new Mapping { [defaultRegion] = children }
  // A node-level map of inline surfaces the build-phase hoist lifts into the
  // top-level `surfaces` registry (keyed `<node-id>_<localKey>`), splicing the
  // node's real id into every [[NODE_ID]] token in the subtree. Null (dropped
  // from JSON by omitNullProperties) unless a tap composes an inline popup.
  inlineSurfaces: Mapping<String, surfaceMod.SurfaceDef>? = null
}

/// A named hole in a card's `template`, and how it gets filled.
///
/// `eager` — the node's own children, composed with the card in one render.
/// `baked` — a hole a SURFACE fills per viewer, lazily and as its own
/// operation: a tab panel, an [[If]] branch, a popup. Only the selected member
/// is ever rendered, which is what keeps an unopened tab free.
///
/// A baked region's element carries `id="{{hostId}}"`, because something has to
/// address it to fill it. An eager region needs no id: its children arrive
/// nested, in the same bytes.
class Region {
  fill: "eager"|"baked" = "eager"
}

/// The region a bare `children` Listing fills, and the hole every one-region
/// card spells `{{#children}}` in its template. `LayoutNode.DefaultRegion` in
/// the backend.
const defaultRegion: String = "children"

/// A card's markup: one `template`, with a named [[Region]] for each hole in it
/// that something else fills.
///
/// A card is a LEAF (no regions — its whole template is what a live patch
/// renders) or STRUCTURE (regions — it holds content it does not own), and that
/// is the whole rule: a patch replaces a node's own element, and a structural
/// card's element contains the regions, so structure is never a patch target
/// (docs/adr/0012-each-session-renders-what-it-is-owed.md).
///
/// So a structural card ([[Row]]/[[Column]]/[[Grid]], [[Slider]]) has only what
/// it holds to show, and a live slot on one that carries its value as BYTES is
/// a build error. A card that wants its own bytes to change puts that markup in
/// a region, as a node — which is what [[SliderHead]] is.
///
/// A SIGNAL slot (ADR 0017) is fine on structure, and is the reason that
/// sentence says "as bytes". A signal is seeded on the node's `.fh-cell`
/// wrapper, which structure has, and updated by a frame addressed by name —
/// neither step patches the element, so nothing about structure is in its way.
class CardDef {
  /// The whole card, holes included.
  template: String
  /// name -> how that hole is filled. The template must place a hole for each:
  /// `{{#name}}{{{html}}}{{/name}}` for an eager region, `{{{name}}}` for a
  /// baked one.
  ///
  /// Null (dropped from JSON by omitNullProperties) for a LEAF card, which is
  /// most of them — same convention as [[wrapAsCell]] and
  /// [[Node.inlineSurfaces]]. A structural card assigns `new Mapping { … }`
  /// rather than amending, because a null default has nothing to amend.
  regions: Mapping<String, Region>? = null
  slots: Listing<String> = new {}
  /// The CSS this card's markup needs to work — its own class names, their box,
  /// flow and spacing — collected from every card in the registry and emitted
  /// ahead of the theme's `styles` (see `Renderer.themeStyleTag`), so a theme
  /// overrides any of it by ordinary cascade order.
  ///
  /// Structure, not paint: colour goes through the `--fh-*` variables
  /// `core/css.pkl` defines, never a framework's own role name, so the card
  /// still reads correctly under a theme that never loaded that framework.
  /// A rule keyed on a class the card does NOT emit belongs in the theme.
  css: String = ""
  // Whether the renderer wraps this card's HTML in the id'd `.fh-cell` layout
  // wrapper. Null (dropped by omitNullProperties, backend defaults TRUE) for
  // every normal card; set `false` only for a card whose root must stay a
  // direct child of a framework-structural parent (the [[TabButton]] anchors
  // under BeerCSS's `.tabs > a`). It means exactly "my root must not be wrapped
  // in a layout box" — NOT "never a morph target", which is decided by card
  // SHAPE: a leaf is one, structure never is.
  wrapAsCell: Boolean? = null
}

/// Whether a card holds content — STRUCTURE, so its whole HTML contains what it
/// holds and patching it would re-render that. Such a card must never enter a
/// diff set, which is why a live BYTES slot on it is a build error (see
/// [[Node.slots]]). `CardDef.isStructure` in the backend.
const local function isStructure(d: CardDef): Boolean = d.regions != null

// ---- the backend-facing card library (DERIVED from the card classes) ----
// Each card class carries its own template + declared slots (`cardDef`,
// co-located with the logic; hidden, so it never emits into a node's JSON).
// [[cardsOf]] assembles `cardName -> CardDef` by reflecting over the concrete
// [[Node]] subclasses of the given modules — within a module, registration is
// automatic: a new card is just a class. `reflect.Property.defaultValue` reads
// the evaluated CLASS-LEVEL default, which is why a `cardDef` must be
// self-contained.
//
// Why a LIST of modules rather than just this one: a card class defined outside
// this library (a third-party component) has to reach the registry too, or the
// backend has no template to render it with. Pkl cannot discover those on its
// own — `reflect.Module.imports` yields import URIs as plain STRINGS, and Pkl
// has no reflect-by-string, so there is no way to walk the import graph and
// collect what it finds. The module VALUES must therefore be named, which is
// what an entry's `componentModules` does (see `entry.pkl`).
//
// Note a component must live in its own module: classes in an AMENDING module
// (every entry) require the `local` modifier, and `local` classes are invisible
// to reflect — so a card class written inline in an entry can never register.

const local nodeClass = reflect.Class(Node)

const local function cardNameOf(clsName: String, cls: reflect.Class): String =
  let (v = cls.properties["card"].defaultValue)
    if (v is String) v
    else throw("card class \(clsName) must default `card` to a literal card name")

const local function cardDefOf(clsName: String, cls: reflect.Class): CardDef =
  let (v = cls.properties["cardDef"].defaultValue)
    if (v is CardDef) v
    else throw("card class \(clsName) must set `cardDef` (its template + declared slots)")

/// The card registry for `mods` — every concrete [[Node]] subclass they define,
/// keyed by its card name. Two modules claiming the SAME card name is a Pkl
/// error ("Duplicate definition of member"), so a component module cannot
/// silently shadow a library card.
///
/// Uses [[defaultClasses]] for the theme-class holes; a dashboard goes through
/// [[cardsWith]] instead (`entry.pkl` does), which is where the chosen theme's
/// names land.
function cardsOf(mods: List<Module>): Mapping<String, CardDef> =
  cardsWith(mods, defaultClasses)

/// [[cardsOf]] with the theme's class names filled into the [[CLASS_BIND]]
/// holes — the one point where a THEME reaches a card's markup.
///
/// It has to happen here, and it took a moment to see why. A card's markup is a
/// class-level `cardDef` default read by `pkl:reflect`, so it can only reference
/// `const` members of its own module's imports — never the theme, which the
/// ENTRY picks much later. But the registry is assembled by an ordinary function
/// call, in the entry, where the theme is in scope. So the theme reaches the
/// templates one step after they are written, by rewriting the holes.
function cardsWith(
  mods: List<Module>,
  classes: Mapping<String, String>
): Mapping<String, CardDef> = new {
  for (m in mods) {
    for (clsName, cls in reflect.Module(m).classes) {
      when (cls.isSubclassOf(nodeClass) && cls != nodeClass && !cls.modifiers.contains("abstract")) {
        [cardNameOf(clsName, cls)] = injectClasses(cardDefOf(clsName, cls), classes)
      }
    }
  }
}

/// The hole a card leaves for a class name only the THEME knows —
/// `@@CLASSBIND:<key>:<signal>@@`, replaced by [[cardsWith]] with one
/// `data-class:<name>="<signal>"` per name the theme lists under `<key>`
/// (space-separated, so one key can name several). An unknown key expands to
/// nothing, which is the right answer for a theme that does not want the
/// binding at all.
///
/// Written by `core/tap.pkl` (the busy spinner), not by hand. The same
/// splice-a-token-and-fill-it-later shape as [[NODE_ID]].
const CLASS_BIND: Regex = Regex(#"@@CLASSBIND:(\w+):([^@]*)@@"#)

/// What the holes expand to when nobody names a class — the `fh-` fallback
/// every theme inherits and `core/css.pkl` styles.
const defaultClasses: Mapping<String, String> = new {
  ["busySpin"] = "fh-busy-spin"
}

const local function bindClasses(
  key: String,
  signal: String,
  classes: Mapping<String, String>
): String =
  (classes.getOrNull(key) ?? "")
    .split(" ")
    .filter((c) -> c != "")
    .map((c) -> #"data-class:\#(c)="\#(signal)""#)
    .join(" ")

const local function fillHoles(s: String, classes: Mapping<String, String>): String =
  s.replaceAllMapped(CLASS_BIND, (m) ->
    bindClasses(m.groups[1].value, m.groups[2].value, classes))

// Every part of a card that can carry markup. `css` is left alone: a class
// binding is an attribute, and a selector naming a theme's class belongs in
// that theme's own styles.
const local function injectClasses(d: CardDef, classes: Mapping<String, String>): CardDef =
  (d) { template = fillHoles(d.template, classes) }



// The placeholder a node uses to refer to its own backend-minted id — the SAME
// id the renderer injects as `{{id}}`. The build-phase hoist
// (DashboardBuild.hoistInlineSurfaces / NodeIdToken) splices the real id in.
// MUST equal DashboardBuild.NodeIdToken. Authors never type it — the
// `openPopupInline` tap embeds it (paired with an `inlineSurfaces` marker under
// the matching local key).
const NODE_ID: String = "@@NODE_ID@@"
