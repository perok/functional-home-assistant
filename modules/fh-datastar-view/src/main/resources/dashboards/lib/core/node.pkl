/// The layout tree and the card contract — what a component author extends.
///
/// A card is a class: subclass [[Node]], give it a `card` name and a `cardDef`,
/// and use it; [[cardsIn]] registers it off the node. The library writes every
/// card's root element ([[CardDef]]): an id'd `.fh-cell`, which the layout
/// builders here put classes on.
module core.node

import "../hass.pkl"
import "predicate.pkl" as predMod
import "simple.pkl" as simpleMod
import "slot.pkl" as slotMod
import "surface.pkl" as surfaceMod
import "tap.pkl" as tapMod
import "text.pkl" as textMod
import "variable.pkl" as varMod

typealias Input = String|Int|Float|Boolean|predMod.Tally|slotMod.Expr|slotMod.Fetch|hass.Entity

/// What fills a boolean slot: a `Boolean` the build knows, or a value
/// expression of a bool: a reading (`c.isOn(l)`, `c.expr("on > 2")`) or a
/// condition (`q.from(lights).where(…).any()`). An aggregate the build can
/// settle IS a `Boolean`, so a room with no lights needs no live slot.
typealias BooleanInput = Boolean|slotMod.Expr

/// The reading a live [[BooleanInput]] is; a condition becomes one holding its
/// source and steps.
const function booleanReading(input: slotMod.Expr): slotMod.Reading =
  if (input is slotMod.Reading) input
  else let (p = input as slotMod.Expr) new slotMod.Reading { source = p.source; steps = p.steps }

/// `at` holding a live [[BooleanInput]], read as a bool.
const function booleanSlot(at: slotMod.Slot, input: slotMod.Expr): slotMod.Slot =
  (at) { value = booleanReading(input); type = "bool" }

/// A card's own `disabled`, as the slot `tapMod.refused` ORs in: not set for
/// `false`, a literal for `true`, else a handler.
const function disabledSlot(d: BooleanInput?): slotMod.Slot =
  if (d == null || d == false) tapMod.disabled
  else if (d == true) tapMod.disabled.of(true)
  else
    (booleanSlot(tapMod.disabled, d as slotMod.Expr)) {
      signal = slotMod.asHandler
    }

/// What the renderer places on a node's root: its cell slots, keyed by the
/// class name or the custom property. A class is `true` (always there) or a
/// reading; a style is a reading. `layout` is the layout builders' classes,
/// written ahead of `classes`, which a `layoutCell = false` card refuses.
/// Authors use the [[LayoutNode]] builders rather than writing one.
class Cell {
  layout: Listing<String> = new {}
  classes: Mapping<String, Boolean|Map<String, Any>> = new {}
  styles: Mapping<String, Map<String, Any>> = new {}
  /// Classes decided for the viewer as the document renders: [[LayoutNode.cellClassAtRender]].
  atRender: Mapping<String, Map<String, Any>>? = null
}

/// How `site.pkl` and `entry.pkl` render the wire: a [[Cell]]'s empty fields are
/// left out. They stay non-null for the author, since a null default cannot be
/// amended (`new c.Cell { classes { … } }`).
const wireRenderer: JsonRenderer = new {
  converters {
    [Cell] = (cell) -> cell.toMap().filter((_, v) -> !((v is Listing || v is Mapping) && v.isEmpty))
  }
}

/// Every layout-tree node. `kind` is the wire discriminator.
///
/// A button the card holding it fills in from its subject entity (`c.its`), so
/// it names no target. A card takes them in its buttons and resolves them before
/// its base card sees them; a base card knows no entity, and refuses one left
/// unresolved. ADR 0015.
open class SubjectButton {}

/// The builders follow HA's `grid_options`: inside a [[Grid]], `columns(n)` is
/// a width in 12ths (default 4). Like every builder they return `this`, so they
/// chain in any order: `c.entityCard(e).columns(3).tapAction(c.tap.toggle(e))`.
abstract class LayoutNode {
  kind: String
  /// Inputs each builder amends, so the order an author chains them in does not
  /// matter: a card's own live class and an author's `.columns(3)` both land.
  hidden cellClasses: Listing<String> = new {}
  /// What [[columns]], [[fullWidth]], [[hug]], [[grow]] and [[stick]] add: the
  /// root as a layout box.
  hidden layoutClasses: Listing<String> = new {}
  /// Classes a card derives from its own inputs ([[ActiveNode]]'s). Kept apart
  /// from [[cellClasses]], which a builder replaces whole, so an input set
  /// after `.columns(3)` still lands.
  hidden stateClasses: Listing<String> = new {}
  /// The live cell classes and styles ([[cellClassWhen]], [[cellStyle]]). A set has
  /// no slots to bind them with, so the builders refuse them there.
  hidden liveClasses: Mapping<String, slotMod.Reading> = new {}
  hidden liveStyles: Mapping<String, slotMod.Reading> = new {}
  /// What [[cellClassAtRender]] adds.
  hidden renderClasses: Mapping<String, slotMod.Reading> = new {}
  /// Derived from the four above. Setting it directly replaces whatever the
  /// builders would have added.
  cell: Cell? =
    let (static = (cellClasses.toList() + stateClasses.toList()).distinct)
    let (boxClasses = layoutClasses.toList().distinct)
    let (subjectId = if (this is Node) subjectOf(this.slots) else null)
    let (attrs = if (this is Node) this.cardDef.attrs else "")
    let (doubled = liveClasses.keys.toList().filter((cls) -> attrs.contains("data-class:\(cls)=") || attrs.contains("data-class:\(cls)__")))
      if (this is Node && !this.cardDef.layoutCell && !boxClasses.isEmpty)
        throw("card '\(this.card)' has layoutCell = false, so its root is no layout box: drop \(boxClasses.join(", "))")
      else if (!doubled.isEmpty)
        throw("card '\((this as Node).card)' binds data-class:\(doubled.first) in its attrs, which cellClassWhen(\"\(doubled.first)\") binds too: the browser keeps only one")
      else if (static.isEmpty && boxClasses.isEmpty && liveClasses.isEmpty && liveStyles.isEmpty && renderClasses.isEmpty) null
      else new Cell {
        layout { for (c in boxClasses) { c } }
        classes {
          for (c in static) { [c] = true }
          for (c, r in liveClasses) { [c] = wireReading(r, subjectId, false) }
        }
        styles {
          for (p, r in liveStyles) { [p] = wireReading(r, subjectId, false) }
        }
        atRender =
          if (renderClasses.isEmpty) null
          else new Mapping { for (c, r in renderClasses) { [c] = wireReading(r, subjectId, false) } }
      }
  /// Span `n` of the surrounding grid's 12 columns. No effect outside a
  /// [[Grid]] or a group.
  function columns(n: Int(this >= 1 && this <= 12)): this = addLayoutClass("fh-cols-\(n)")
  function fullWidth(): this = addLayoutClass("fh-cols-full")
  /// Shrink to the content instead of filling the cell's share.
  function hug(): this = addLayoutClass("fh-hug")
  /// Take the space the surrounding row or column leaves: the body between a
  /// header and a footer, or the rest of a wrapped row's line.
  function grow(): this = addLayoutClass("fh-grow")
  /// Stay on screen while the page scrolls, at that edge, for as long as the
  /// surrounding box is: a footer in the page's main column always is.
  function stick(edge: Edge): this = addLayoutClass("fh-stick-\(edge)")
  /// Wrap, clip or scroll a label too long for its box (`core/text.pkl`), for
  /// this node and everything under it. The dashboard default is `entry.pkl`'s
  /// `textOverflow`.
  function textOverflow(o: textMod.Overflow): this = addCellClass(textMod.cls(o))
  /// Any plain class token on the root; validated at build time.
  function cellClass(cls: String): this = addCellClass(cls)
  /// [[cellClass]] while `when` holds, bound on the root so no template
  /// places it:
  ///
  ///     c.entityButton(l).cellClassWhen("warm", c.isOn(l))   // css: .fh-cell.warm>button
  ///     c.button(…).cellClassWhen("fh-some", lit.any())
  function cellClassWhen(cls: String, `when`: BooleanInput): this =
    let (self = this)
      if (`when` is Boolean) (if (`when`) self.addCellClass(cls) else self)
      else if (!(self is Node)) throw("cellClassWhen: a live class is a slot, which only a card node has — put it on the clause's node")
      else (self) { liveClasses { [cls] = booleanReading(`when`) } }
  /// [[cellClass]] while `when` holds for the viewer, decided as the document
  /// renders and written into `class`: no signal, no binding, never sent again,
  /// so a page's raw HTML shows it without scripts. It may read a node variable
  /// (`v.valueIs(x)`), and only here or in a value slot:
  ///
  ///     tab.cellClassAtRender("fh-chosen", v.valueIs("1"))
  ///
  /// A patch of the node leaves it out, so keep it live with the card's own
  /// `data-class` where the class must follow a change.
  function cellClassAtRender(cls: String, `when`: slotMod.Expr): this =
    let (self = this)
      if (!(self is Node)) throw("cellClassAtRender: a class decided at render is a slot, which only a card node has — put it on the clause's node")
      else (self) { renderClasses { [cls] = booleanReading(`when`) } }
  /// A custom property on the root, set from a reading and kept live, for
  /// the card's CSS to read by inheritance:
  ///
  ///     c.button(…).cellStyle("--fh-fill", c.expr("string(on * 100 / total) + '%'"))
  ///     // css: button.fh-cell { background-size: var(--fh-fill) 100% }
  ///
  /// Only `--…`: a plain property would fight the theme's framework.
  function cellStyle(name: String(startsWith("--")), reading: slotMod.Reading): this =
    let (self = this)
      if (!(self is Node)) throw("cellStyle: a live style is a slot, which only a card node has — put it on the clause's node")
      else (self) { liveStyles { [name] = reading } }
  // One class per family (`fh-cols-*`, `fh-text-*`, hug or grow, one edge): two
  // would be decided by stylesheet order, not by the author's last word. This is
  // also what lets a card default its span, or a pill its hug, and still be
  // overridden.
  function addCellClass(cls: String): this =
    let (self = this)
      (self) { cellClasses = withClass(self.cellClasses, cls) }
  function addLayoutClass(cls: String): this =
    let (self = this)
      (self) { layoutClasses = withClass(self.layoutClasses, cls) }
}

const local function withClass(had: Listing<String>, cls: String): Listing<String> =
  let (family = cellClassFamilies.findOrNull((f) -> f.any((p) -> cls.startsWith(p))))
  let (all = had.toList())
  let (kept = if (family != null) all.filter((c) -> !family.any((p) -> c.startsWith(p))) else all)
    new Listing<String> {
      for (c in kept) { c }
      cls
    }

/// Where a stuck cell stays: [[LayoutNode.stick]].
typealias Edge = "top"|"bottom"

const local cellClassFamilies: List<List<String>> =
  List(List("fh-cols-"), List("fh-text-"), List("fh-hug", "fh-grow"), List("fh-stick-"))

abstract class Node extends LayoutNode {
  kind: "Component" = "Component"
  card: String
  /// The card's markup, the same for every node of one [[card]] name: the wire
  /// holds one template per name, compiled once. So it cannot branch on this
  /// node's own properties, which surprises: `tag = if (href != null) "a" else
  /// "button"` builds two defs under one name and fails the build with "card
  /// 'x' has 2 different cardDefs" ([[cardsIn]]). Branch on a fact known at
  /// build by giving each form its own name and def ([[variants]]); branch on
  /// a live value inside the template, through a slot. Keep each HTML attribute
  /// value on one line.
  hidden cardDef: CardDef
  /// A card whose root differs by a fact known at build time (a button that
  /// navigates is an `<a>`): one name and constant def per form, `card` picking
  /// the name and `cardDef` its def. The library's index (`components.pkl`'s
  /// `cards`) reads these, since such a `card` has no value without a node.
  hidden variants: Mapping<String, CardDef>? = null
  // The structural check mirrors `LayoutNode.Component.liveEntitiesAsBytes`.
  /// What this node's card reads ([[slotMod.Slot]]): `slots { label.of(…) }`. A
  /// slot with no value is not set; [[templateSlots]] is what reaches the backend.
  ///
  /// On a structural card (one with regions) a live slot read as bytes is refused,
  /// since its patch would carry everything the card holds: put live markup in a
  /// region as a node, or make it a signal slot. `once` and `onRender` reads are
  /// fine.
  hidden slots: Listing<slotMod.Slot>(
    !isStructure(cardDef) || !toList().any((s) ->
      s.value is slotMod.Reading && !(s.value.source is slotMod.CelRead) && s.value.reads == "live" && s.signal == null &&
        (s.value.entityId != null ||
        toList().any((t) -> t.name == "entity_id" && t.value is String))),
    namedOnce(this, card)
  ) = new {}
  /// [[slots]] as the wire holds them, by name.
  fixed templateSlots: Mapping<String, Any> = wireSlots(slots, subjectOf(slots))
  /// [[slots]] that are set, by name.
  hidden slotsByName: Map<String, slotMod.Slot> =
    slots.toList().filter((s) -> s.value != null).toMap((s) -> s.name, (s) -> s)
  /// An id of the author's choosing for this node and the root of its
  /// descendants' (`detail`, `detail_0`, …). Ids are user-visible — a tab bar
  /// mirrors its own into the URL — so naming the node keeps a bookmark working
  /// when a card is inserted above it. Must be a unique plain token, outside
  /// any candidate set's clause.
  id: String? = null
  /// What fills this node's regions. A `Listing` fills the default region
  /// (`Grid { children { … } }`); a `Mapping` names each one, for a card with
  /// more than one hole ([[Slider]]).
  hidden children: Listing<LayoutNode>|Mapping<String, Listing<LayoutNode>> = new Listing {}
  /// [[children]] with the default region named: the one form on the wire.
  regions: Mapping<String, Listing<LayoutNode>>? =
    if (children is Mapping) children
    else if (children.isEmpty) null
    else new Mapping { [defaultRegion] = children }
  /// The node variables this node declares ([[varMod]]). Its subtree is where
  /// they apply, a tab panel or `If` branch included; a popup does not see the
  /// page's.
  ///
  ///   local view = c.variable("view")
  ///   (c.column) {
  ///     vars { view.defaultingTo("plain").notInUrl() }
  ///     children { c.select(view).options(List("plain", "detail")) }
  ///   }
  vars: Listing<varMod.Declaration>(isDistinctBy((d) -> d.name)) = new {}
  /// Named inputs this node's own CEL reads: a literal, a live count
  /// (`q.from(xs).where(…).count()`, an `int`), the ids present (`….present()`,
  /// a `list(string)`) or a live condition (`….any()`, a `bool`).
  ///
  ///   ((c.button(f.floor_name, c.tap.lights.off(f))) {
  ///     inputs {
  ///       ["lights_on"] = q.from(lights).where(q.eq(q.stateProp, "on")).count()
  ///       ["lights_total"] = lights.length
  ///     }
  ///   }).secondary(c.expr(#"string(lights_on) + ' / ' + string(lights_total)"#))
  hidden inputs: Mapping<String, Input> = new {}
  wireInputs: Map<String, Any>? =
    if (inputs.isEmpty) null
    else inputs.toMap().mapValues((_, v) -> slotMod.wireInput(v))
  // Lifted into the top-level `surfaces` by the build's hoist, keyed
  // `<node-id>_<localKey>`, with the node's id spliced into every [[NODE_ID]].
  inlineSurfaces: Mapping<String, surfaceMod.SurfaceDef>? = null

  /// [[inputs]] as a chain step:
  ///
  ///   c.button(f.floor_name, c.tap.lights.off(f))
  ///     .secondary(c.expr(#"string(lights_on) + ' on'"#))
  ///     .inputs(new Mapping {
  ///       ["lights_on"] = q.from(lights).where(q.eq(q.stateProp, "on")).count()
  ///     })
  function inputs(vs: Mapping<String, Input>): this =
    (this) { inputs = vs }
}

/// The entries of `vs` some CEL reading in `slots` names. Values are
/// node-local (ADR 0034), so a structural card hands each of its parts the ones
/// that part's slots read; the build's own parse then checks every part.
const function inputsNamedIn(
  vs: Mapping<String, Input>,
  slots: Listing<slotMod.Slot>
): Map<String, Input> =
  let (cels = slots.toList().map((s) -> s.value)
      .filter((v) -> v is slotMod.Reading)
      .flatMap((v) -> (v as slotMod.Reading).steps.toList())
      .filter((st) -> st is simpleMod.Cel)
      .map((st) -> (st as simpleMod.Cel).src))
    vs.toMap().filter((name, _) ->
      cels.any((t) -> t.contains(Regex(#"(?<![\w.])\#(name)(?!\w)"#))))

/// A [[Node]] with an on look: `fh-active` on its cell while [[active]] holds,
/// for the card's CSS to paint. A button fills its pill; a badge takes
/// `css.pkl`'s look, the card marking it `badge.pkl`'s way when it can be off.
abstract class ActiveNode extends Node {
  /// `true`, `c.isOn(l)`, `c.expr("on > 0")`, or `lit.any()`.
  hidden active: BooleanInput = false
  stateClasses {
    when (active == true) { "fh-active" }
  }
  liveClasses {
    when (!(active is Boolean)) {
      ["fh-active"] = booleanReading(active as slotMod.Expr)
    }
  }
}

/// A named hole in a card's template. `eager` holds the node's own children,
/// rendered with the card. `baked` is filled per viewer by a surface (a tab
/// panel, an [[If]] branch, a popup), and its element carries
/// `id="{{hostId}}"` so it can be addressed.
class Region {
  fill: "eager"|"baked" = "eager"
}

/// The region a bare `children` Listing fills; `LayoutNode.DefaultRegion` in
/// the backend.
const defaultRegion: String = "children"

/// A card's markup. A card is a LEAF (no regions) or STRUCTURE (regions), and a
/// patch replaces a node's own element, so structure is never a patch target
/// (ADR 0012). A card that wants its own bytes to change puts that markup in a
/// region, as a node ([[SliderHead]]).
class CardDef {
  /// The root element's name. The library writes the root from this,
  /// [[classes]] and [[attrs]], with the node's id and cell classes on it, so
  /// [[template]] is its content.
  tag: String(matches(Regex("[a-z][a-z0-9]*(-[a-z0-9]+)*"))) = "div"
  /// The root's own classes, after `fh-cell` and before the node's cell
  /// classes.
  classes: String = ""
  /// The root's other attributes, as markup. Not `id`, `class`, `style` or
  /// `data-signals`, which the root carries already: the browser keeps only the
  /// first of two.
  attrs: String(!contains(Regex(#"(?<![\w:-])(id|class|style|data-signals)="#))) = ""
  /// `false` for a root that must not be a layout box: no `fh-cell` class, and
  /// no [[LayoutNode.columns]] and the like. A [[TabButton]] under
  /// `.fh-tabs > a` would otherwise take a `.fh-col`'s full-width cell.
  layoutCell: Boolean = true
  /// Mustache, and the card's list of inputs: a name outside every section
  /// must be a slot the node sets (or `id`, `hostId`, `dashboardSlug`), one
  /// inside a section may be absent, and every slot the node sets must be
  /// named here. The build checks both. A template places a slot through its
  /// handle ([[slotMod.Slot]]: `\(label)`, `label.bind`, `label.ifSet(…)`).
  template: String
  /// The template places each as `{{{name}}}`, eager or baked: once, and
  /// outside every section. A structural card assigns `new Mapping { … }`: a null default
  /// has nothing to amend.
  regions: Mapping<String, Region>? = null
  /// The CSS this card's markup needs to work, emitted ahead of the theme's
  /// `styles` (ADR 0020). Colour goes through the `--fh-*` variables, never a
  /// framework's role name; a rule on a class the card does not emit belongs in
  /// the theme.
  css: String = ""
  /// A classic script this card's markup needs, inlined once per page before
  /// first paint; a theme cannot drop it. Bind through document-level
  /// listeners: the card's DOM is morphed under it.
  script: String? = null
}

/// A [[CardDef]] as the wire holds it: the root written around the template,
/// with the two holes the renderer fills, `cellClasses` (each with its leading
/// space) and `cell` (the id, the signal seed, the cell bindings).
class WireCard {
  template: String
  regions: Mapping<String, Region>?
  css: String
  script: String?
  layoutCell: Boolean?
}

const local function wireCard(d: CardDef): WireCard = new {
  template =
    let (cls = (if (d.layoutCell) List("fh-cell") else List()) + (if (d.classes.isEmpty) List() else List(d.classes)))
      "<\(d.tag) class=\"\(cls.join(" ")){{{cellClasses}}}\"{{{cell}}}\(if (d.attrs.isEmpty) "" else " " + d.attrs)>\(d.template)</\(d.tag)>"
  regions = d.regions
  css = d.css
  script = d.script
  layoutCell = if (d.layoutCell) null else false
}

const local function isStructure(d: CardDef): Boolean = d.regions != null

// The wire is keyed by name, so a second slot of one name would silently win.
const local function namedOnce(slots: Listing<slotMod.Slot>, card: String): Boolean =
  let (twice = slots.toList().map((s) -> s.name).groupBy((n) -> n).filter((_, ns) -> ns.length > 1).keys)
    if (twice.isEmpty) true
    else throw("card '\(card)': slot \(twice.toList().map((n) -> "'\(n)'").join(", ")) is listed twice in `slots`")

// The entity a reading that names none reads: the card's `entity_id` literal.
const local function subjectOf(slots: Listing<slotMod.Slot>): String? =
  let (s = slots.toList().findOrNull((t) -> t.name == slotMod.subject.name))
    if (s?.value is String) s.value as String else null

// A reading as the wire holds it: its set fields, an empty `steps` left out,
// and its `valueWhileSlot` under the wire's name. The card's own entity is not
// named, since a read that names none reads it, and on a card with none a
// leading CEL is the source, reading no entity rather than a missing one. A
// `themed` one ends with the theme's class swap.
const local function wireReading(r: slotMod.Reading, subject: String?, themed: Boolean): Map<String, Any> =
  let (src = r.source)
  let (own =
    if (src is slotMod.EntityRead && src.of != null && src.of == subject) (src) { of = null }
    else src)
  let (first = r.steps.toList().firstOrNull)
  let (celSource = subject == null && first is simpleMod.Cel && own is slotMod.EntityRead && own.of == null)
  let (source =
    if (celSource) let (c = first as simpleMod.Cel) new slotMod.CelRead { src = c.src; inputs = c.inputs }
    else own)
  let (vw = r.valueWhileSlot)
  let (steps = (if (celSource) r.steps.toList().drop(1) else r.steps.toList())
    + (if (themed) List(themeStage) else List()))
    Map("source", source)
      + (if (steps.isEmpty) Map() else Map("steps", steps))
      + (if (r.default != null) Map("default", r.default) else Map())
      + (if (r.dependsOn != null) Map("dependsOn", r.dependsOn) else Map())
      + (if (vw != null) Map("valueWhile", wireReading(vw, subject, false)) else Map())

const local themeStage: simpleMod.ThemeClassesStage = new {}

// By name, set ones only, a reading carrying its slot's `signal` and `type`,
// and a literal a bare value. A themed slot's value takes the theme's swap as
// its last step.
const local function wireSlots(slots: Listing<slotMod.Slot>, subject: String?): Mapping<String, Any> = new {
  for (s in slots) {
    when (s.value != null) {
      [s.name] =
        if (s.value is slotMod.Reading)
          wireReading(s.value as slotMod.Reading, subject, s.themed)
            + (if (s.signal != null) Map("signal", s.signal) else Map())
            + (if (s.type != null) Map("type", s.type) else Map())
        else if (s.signal != null)
          throw("slot '\(s.name)' is a constant literal and cannot be a signal slot — a value that never moves has nothing to patch")
        else if (s.themed) Map("source", s.value, "steps", List(themeStage))
        else if (s.type != null) Map("source", s.value, "type", s.type)
        else s.value
    }
  }
}
/// Every card the trees under `roots` use, by name — a page ships these cards'
/// templates, CSS and scripts and no others. Read off the nodes rather than
/// their classes, so a card class registers by being used, from any module.
/// Every node of one card must carry the same `cardDef`.
const function cardsIn(roots: List<LayoutNode>): Mapping<String, WireCard> =
  roots.flatMap((r) -> nodesUnder(r))
    .groupBy((n) -> n.card)
    .mapValues((name, ns) ->
      let (defs = ns.map((n) -> n.cardDef).distinct)
        if (defs.length == 1) wireCard(defs.first)
        else throw("card '\(name)' has \(defs.length) different cardDefs: two card classes claim the name, or a cardDef reads its own node"))
    .toMapping()

// Every place a node can hold another; a new one belongs here, or its cards
// are "unknown card" at validate.
const local function nodesUnder(n: LayoutNode): List<Node> =
  if (n is Node)
    List(n)
      + (n.regions?.toMap()?.values ?? List()).flatMap((l) -> l.toList()).flatMap((k) -> nodesUnder(k))
      + (n.inlineSurfaces?.toMap()?.values ?? List()).flatMap((s) -> nodesUnder(s.content))
  else if (n is predMod.SetNode)
    n.members.toMap().values.flatMap((m) -> m.clauses.toList()).flatMap((c) -> nodesUnder(c.node))
  else throw("unknown node kind '\(n.kind)'")

// A node's own backend-minted id, spliced in by the build's hoist. Must equal
// `DashboardBuild.NodeIdToken`.
const NODE_ID: String = "@@NODE_ID@@"
