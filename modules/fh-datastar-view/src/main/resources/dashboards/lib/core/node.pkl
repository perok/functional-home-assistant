/// The layout tree and the card contract — what a component author extends.
///
/// A card is a class: subclass [[Node]], give it a `card` name and a `cardDef`,
/// and use it; [[cardsIn]] registers it off the node. The renderer wraps every
/// node in an id'd `.fh-cell`, which the layout builders here put classes on.
module core.node

import "predicate.pkl" as predMod
import "slot.pkl" as slotMod
import "surface.pkl" as surfaceMod
import "tap.pkl" as tapMod
import "text.pkl" as textMod
import "variable.pkl" as varMod

typealias ExpressionValue = String|Int|Float|Boolean|predMod.Tally|predMod.Predicate|slotMod.Fetch

/// What fills a boolean slot: a `Boolean` the build knows, a reading
/// (`c.isOn(l)`), an `Expr` (`c.expr("on > 2")`), or a condition
/// (`q.from(lights).where(…).any()`). An aggregate the build can settle IS a
/// `Boolean`, so a room with no lights needs no live slot.
typealias BooleanInput = Boolean|slotMod.Reading|slotMod.Expr|predMod.Predicate

/// The reading a live [[BooleanInput]] is. A condition is its transform,
/// decided on the fast path.
const function booleanReading(input: slotMod.Reading|slotMod.Expr|predMod.Predicate): slotMod.Reading =
  if (input is slotMod.Reading) input
  else if (input is slotMod.Expr)
    new slotMod.Reading {
      entityId = input.entityId
      transform = input.transform
      bypassUnavailable = false
    }
  else new slotMod.Reading { transform = input; bypassUnavailable = false }

/// `at` holding a live [[BooleanInput]], read as a bool.
const function booleanSlot(at: slotMod.Slot, input: slotMod.Reading|slotMod.Expr|predMod.Predicate): slotMod.Slot =
  (at) { value = booleanReading(input); type = "bool" }

/// A card's own `disabled`, as the slot `tapMod.refused` ORs in: not set for
/// `false`, a literal for `true`, else a handler.
const function disabledSlot(d: BooleanInput?): slotMod.Slot =
  if (d == null || d == false) tapMod.disabled
  else if (d == true) tapMod.disabled.of("1")
  else
    (booleanSlot(tapMod.disabled, d as slotMod.Reading|slotMod.Expr|predMod.Predicate)) {
      signal = slotMod.asHandler
    }

/// What the renderer places on a node's `.fh-cell` wrapper: its cell slots,
/// keyed by the class name or the custom property. A class is `"1"` (always
/// there) or a reading; a style is a reading. Authors use the [[LayoutNode]]
/// builders rather than writing one.
class Cell {
  classes: Mapping<String, String|Map<String, Any>> = new {}
  styles: Mapping<String, Map<String, Any>> = new {}
}

/// Every layout-tree node. `kind` is the wire discriminator.
///
/// A button the card holding it fills in from its subject entity (`c.its`), so
/// it names no target. A card takes them in its buttons and resolves them before
/// its base card sees them; a base card knows no entity, and refuses one left
/// unresolved. ADR 0015.
open class SubjectButton {}

/// The builders follow HA's `grid_options`: inside a [[Grid]], `columns(n)` is
/// a width in 12ths (default 4). They return [[LayoutNode]], so chain them
/// AFTER card-specific ones:
/// `c.entityCard(e).tapAction(c.tap.toggle(e)).columns(3)`.
abstract class LayoutNode {
  kind: String
  /// Inputs each builder amends, so the order an author chains them in does not
  /// matter: a card's own live class and an author's `.columns(3)` both land.
  hidden cellClasses: Listing<String> = new {}
  /// Classes a card derives from its own inputs ([[ActiveNode]]'s). Kept apart
  /// from [[cellClasses]], which a builder replaces whole, so an input set
  /// after `.columns(3)` still lands.
  hidden stateClasses: Listing<String> = new {}
  /// The live cell classes and styles ([[cellClassWhen]], [[cellStyle]]). A set has
  /// no slots to bind them with, so the builders refuse them there.
  hidden liveClasses: Mapping<String, slotMod.Reading> = new {}
  hidden liveStyles: Mapping<String, slotMod.Reading> = new {}
  /// Derived from the four above. Setting it directly replaces whatever the
  /// builders would have added.
  cell: Cell? =
    let (static = (cellClasses.toList() + stateClasses.toList()).distinct)
      if (static.isEmpty && liveClasses.isEmpty && liveStyles.isEmpty) null
      else new Cell {
        classes {
          for (c in static) { [c] = "1" }
          for (c, r in liveClasses) { [c] = wireReading(r) }
        }
        styles {
          for (p, r in liveStyles) { [p] = wireReading(r) }
        }
      }
  /// Span `n` of the surrounding grid's 12 columns. No effect outside a
  /// [[Grid]] or a group.
  function columns(n: Int(this >= 1 && this <= 12)): LayoutNode = addCellClass("fh-cols-\(n)")
  function fullWidth(): LayoutNode = addCellClass("fh-cols-full")
  /// Shrink to the content instead of filling the cell's share.
  function hug(): LayoutNode = addCellClass("fh-hug")
  /// Take the space the surrounding row or column leaves: the body between a
  /// header and a footer, or the rest of a wrapped row's line.
  function grow(): LayoutNode = addCellClass("fh-grow")
  /// Stay on screen while the page scrolls, at that edge, for as long as the
  /// surrounding box is: a footer in the page's main column always is.
  function stick(edge: Edge): LayoutNode = addCellClass("fh-stick-\(edge)")
  /// Wrap, clip or scroll a label too long for its box (`core/text.pkl`), for
  /// this node and everything under it. The dashboard default is `entry.pkl`'s
  /// `textOverflow`.
  function textOverflow(o: textMod.Overflow): LayoutNode = addCellClass(textMod.cls(o))
  /// Any plain class token on the wrapper; validated at build time.
  function cellClass(cls: String): LayoutNode = addCellClass(cls)
  /// [[cellClass]] while `when` holds, bound on the wrapper so no template
  /// places it:
  ///
  ///     c.entityButton(l).cellClassWhen("warm", c.isOn(l))   // css: .fh-cell.warm>button
  ///     c.button(…).cellClassWhen("fh-some", lit.any())
  function cellClassWhen(cls: String, `when`: BooleanInput): LayoutNode =
    let (self = this)
      if (`when` is Boolean) (if (`when`) self.addCellClass(cls) else self)
      else if (!(self is Node)) throw("cellClassWhen: a live class is a slot, which only a card node has — put it on the clause's node")
      else (self) { liveClasses { [cls] = booleanReading(`when`) } }
  /// A custom property on the wrapper, set from a reading and kept live, for
  /// the card's CSS to read by inheritance:
  ///
  ///     c.button(…).cellStyle("--fh-fill", c.expr("string(on * 100 / total) + '%'"))
  ///     // css: .fh-cell>button { background-size: var(--fh-fill) 100% }
  ///
  /// Only `--…`: a plain property would fight the theme's framework.
  function cellStyle(name: String(startsWith("--")), reading: slotMod.Reading|slotMod.Expr): LayoutNode =
    let (self = this)
    let (s = if (reading is slotMod.Expr)
        new slotMod.Reading { entityId = reading.entityId; transform = reading.transform }
      else reading as slotMod.Reading)
      if (!(self is Node)) throw("cellStyle: a live style is a slot, which only a card node has — put it on the clause's node")
      else (self) { liveStyles { [name] = s } }
  // One class per family (`fh-cols-*`, `fh-text-*`, hug or grow, one edge): two
  // would be decided by stylesheet order, not by the author's last word. This is
  // also what lets a card default its span, or a pill its hug, and still be
  // overridden.
  function addCellClass(cls: String): LayoutNode =
    let (self = this)
    let (family = cellClassFamilies.findOrNull((f) -> f.any((p) -> cls.startsWith(p))))
    let (had = self.cellClasses.toList())
    let (kept = if (family != null) had.filter((c) -> !family.any((p) -> c.startsWith(p))) else had)
      (self) {
        cellClasses = new Listing<String> {
          for (c in kept) { c }
          cls
        }
      }
}

/// Where a stuck cell stays: [[LayoutNode.stick]].
typealias Edge = "top"|"bottom"

const local cellClassFamilies: List<List<String>> =
  List(List("fh-cols-"), List("fh-text-"), List("fh-hug", "fh-grow"), List("fh-stick-"))

abstract class Node extends LayoutNode {
  kind: "Component" = "Component"
  card: String
  // The same for every node of the card ([[cardsIn]]), so it must not
  // reference instance properties beyond a slot's name. Keep each HTML
  // attribute value on one line.
  hidden cardDef: CardDef
  // The structural check mirrors `LayoutNode.Component.liveEntitiesAsBytes`.
  /// What this node's card reads ([[slotMod.Slot]]): `slots { label.of(…) }`. A
  /// slot with no value is not set; [[templateSlots]] is what reaches the backend.
  ///
  /// On a structural card (one with regions) a live slot read as bytes is refused,
  /// since its patch would carry everything the card holds: put live markup in a
  /// region as a node, or make it a signal slot. `once` and `onRender` reads are
  /// fine.
  hidden slots: Listing<slotMod.Slot>(
    !isStructure(cardDef) || !toList().any((s) ->
      s.value is slotMod.Reading && s.value.reads == "live" && s.signal == null &&
        (s.value.entityId != null ||
        toList().any((t) -> t.name == "entity_id" && t.value is String))),
    namedOnce(this, card)
  ) = new {}
  /// [[slots]] as the wire holds them, by name.
  fixed templateSlots: Mapping<String, Any> = wireSlots(slots)
  /// [[slots]] that are set, by name.
  hidden slotsByName: Map<String, slotMod.Slot> =
    slots.toList().filter((s) -> s.value != null).toMap((s) -> s.name, (s) -> s)
  /// An id of the author's choosing for this node and the root of its
  /// descendants' (`detail`, `detail_0`, …). Ids are user-visible — a tab bar
  /// mirrors its own into the URL — so naming the node keeps a bookmark working
  /// when a card is inserted above it. Must be a unique plain token, outside
  /// any candidate set's clause.
  id: String? = null
  /// What fills this node's regions. A `Listing` fills the default region
  /// (`Grid { children { … } }`); a `Mapping` names each one, for a card with
  /// more than one hole ([[Slider]]).
  hidden children: Listing<LayoutNode>|Mapping<String, Listing<LayoutNode>> = new Listing {}
  /// [[children]] with the default region named: the one form on the wire.
  regions: Mapping<String, Listing<LayoutNode>>? =
    if (children is Mapping) children
    else if (children.isEmpty) null
    else new Mapping { [defaultRegion] = children }
  /// The node variables this node declares ([[varMod]]). Its subtree is where
  /// they apply, a tab panel or `If` branch included; a popup does not see the
  /// page's.
  ///
  ///   local view = c.variable("view")
  ///   (c.column) {
  ///     vars { view.defaultingTo("plain").notInUrl() }
  ///     children { c.select(view).options(List("plain", "detail")) }
  ///   }
  vars: Listing<varMod.Declaration>(isDistinctBy((d) -> d.name)) = new {}
  /// Named values this node's own CEL reads: a literal, a live count
  /// (`q.from(xs).where(…).count()`, an `int`) or a live condition (`….any()`,
  /// a `bool`).
  ///
  ///   ((c.button(f.floor_name, c.tap.lights.off(f))) {
  ///     expressionValues {
  ///       ["lights_on"] = q.from(lights).where(q.eq(q.stateProp, "on")).count()
  ///       ["lights_total"] = lights.length
  ///     }
  ///   }).secondary(c.expr(#"string(lights_on) + ' / ' + string(lights_total)"#))
  hidden expressionValues: Mapping<String, ExpressionValue> = new {}
  values: Mapping<String, ExpressionValue>? =
    if (expressionValues.isEmpty) null else expressionValues
  // Lifted into the top-level `surfaces` by the build's hoist, keyed
  // `<node-id>_<localKey>`, with the node's id spliced into every [[NODE_ID]].
  inlineSurfaces: Mapping<String, surfaceMod.SurfaceDef>? = null

  /// [[expressionValues]] as a chain step:
  ///
  ///   c.button(f.floor_name, c.tap.lights.off(f))
  ///     .secondary(c.expr(#"string(lights_on) + ' on'"#))
  ///     .expressionValues(new Mapping {
  ///       ["lights_on"] = q.from(lights).where(q.eq(q.stateProp, "on")).count()
  ///     })
  function expressionValues(vs: Mapping<String, ExpressionValue>): Node =
    let (self = this) (self) { expressionValues = vs }
}

/// The entries of `vs` some CEL reading in `slots` names. Values are
/// node-local (ADR 0034), so a structural card hands each of its parts the ones
/// that part's slots read; the build's own parse then checks every part.
const function valuesNamedIn(
  vs: Mapping<String, ExpressionValue>,
  slots: Listing<slotMod.Slot>
): Map<String, ExpressionValue> =
  let (cels = slots.toList().map((s) -> s.value)
      .filter((v) -> v is slotMod.Reading && v.transform is String)
      .map((v) -> (v as slotMod.Reading).transform as String))
    vs.toMap().filter((name, _) ->
      cels.any((t) -> t.contains(Regex(#"(?<![\w.])\#(name)(?!\w)"#))))

/// A [[Node]] with an on look: `fh-active` on its cell while [[active]] holds,
/// for the card's CSS to paint. A button fills its pill; a badge takes
/// `css.pkl`'s look, the card marking it `badge.pkl`'s way when it can be off.
abstract class ActiveNode extends Node {
  /// `true`, `c.isOn(l)`, `c.expr("on > 0")`, or `lit.any()`.
  hidden active: BooleanInput = false
  stateClasses {
    when (active == true) { "fh-active" }
  }
  liveClasses {
    when (!(active is Boolean)) {
      ["fh-active"] = booleanReading(active as slotMod.Reading|slotMod.Expr|predMod.Predicate)
    }
  }
}

/// A named hole in a card's template. `eager` holds the node's own children,
/// rendered with the card. `baked` is filled per viewer by a surface (a tab
/// panel, an [[If]] branch, a popup), and its element carries
/// `id="{{hostId}}"` so it can be addressed.
class Region {
  fill: "eager"|"baked" = "eager"
}

/// The region a bare `children` Listing fills; `LayoutNode.DefaultRegion` in
/// the backend.
const defaultRegion: String = "children"

/// A card's markup. A card is a LEAF (no regions) or STRUCTURE (regions), and a
/// patch replaces a node's own element, so structure is never a patch target
/// (ADR 0012). A card that wants its own bytes to change puts that markup in a
/// region, as a node ([[SliderHead]]).
class CardDef {
  /// Mustache, and the card's list of inputs: a name outside every section
  /// must be a slot the node sets (or `id`, `hostId`, `dashboardSlug`), one
  /// inside a section may be absent, and every slot the node sets must be
  /// named here. The build checks both. A template places a slot through its
  /// handle ([[slotMod.Slot]]: `\(label)`, `label.bind`, `label.ifSet(…)`).
  template: String
  /// The template places each as `{{{name}}}`, eager or baked: once, and
  /// outside every section. A structural card assigns `new Mapping { … }`: a null default
  /// has nothing to amend.
  regions: Mapping<String, Region>? = null
  /// The CSS this card's markup needs to work, emitted ahead of the theme's
  /// `styles` (ADR 0020). Colour goes through the `--fh-*` variables, never a
  /// framework's role name; a rule on a class the card does not emit belongs in
  /// the theme.
  css: String = ""
  /// A classic script this card's markup needs, inlined once per page before
  /// first paint; a theme cannot drop it. Bind through document-level
  /// listeners: the card's DOM is morphed under it.
  script: String? = null
  // `false` only for a card whose root must be a direct child of a framework
  // parent (a [[TabButton]] under `.fh-tabs > a`). It does not decide whether the
  // card is a morph target; its shape does.
  wrapAsCell: Boolean? = null
}

const local function isStructure(d: CardDef): Boolean = d.regions != null

// The wire is keyed by name, so a second slot of one name would silently win.
const local function namedOnce(slots: Listing<slotMod.Slot>, card: String): Boolean =
  let (twice = slots.toList().map((s) -> s.name).groupBy((n) -> n).filter((_, ns) -> ns.length > 1).keys)
    if (twice.isEmpty) true
    else throw("card '\(card)': slot \(twice.toList().map((n) -> "'\(n)'").join(", ")) is listed twice in `slots`")

// A reading as the wire holds it: its set fields.
const local function wireReading(r: slotMod.Reading): Map<String, Any> =
  r.toMap().filter((_, v) -> v != null)

// By name, set ones only, a reading carrying its slot's `signal` and `type`,
// and a literal its `type` when it has one (a `cssClass`), else a bare string.
const local function wireSlots(slots: Listing<slotMod.Slot>): Mapping<String, Any> = new {
  for (s in slots) {
    when (s.value != null) {
      [s.name] =
        if (s.value is slotMod.Reading)
          wireReading(s.value as slotMod.Reading)
            + (if (s.signal != null) Map("signal", s.signal) else Map())
            + (if (s.type != null) Map("type", s.type) else Map())
        else if (s.signal != null)
          throw("slot '\(s.name)' is a constant literal and cannot be a signal slot — a value that never moves has nothing to patch")
        else if (s.type != null) Map("literal", s.value, "type", s.type)
        else s.value
    }
  }
}
/// Every card the trees under `roots` use, by name — a page ships these cards'
/// templates, CSS and scripts and no others. Read off the nodes rather than
/// their classes, so a card class registers by being used, from any module.
/// Every node of one card must carry the same `cardDef`.
const function cardsIn(roots: List<LayoutNode>): Mapping<String, CardDef> =
  roots.flatMap((r) -> nodesUnder(r))
    .groupBy((n) -> n.card)
    .mapValues((name, ns) ->
      let (defs = ns.map((n) -> n.cardDef).distinct)
        if (defs.length == 1) defs.first
        else throw("card '\(name)' has \(defs.length) different cardDefs: two card classes claim the name, or a cardDef reads its own node"))
    .toMapping()

// Every place a node can hold another; a new one belongs here, or its cards
// are "unknown card" at validate.
const local function nodesUnder(n: LayoutNode): List<Node> =
  if (n is Node)
    List(n)
      + (n.regions?.toMap()?.values ?? List()).flatMap((l) -> l.toList()).flatMap((k) -> nodesUnder(k))
      + (n.inlineSurfaces?.toMap()?.values ?? List()).flatMap((s) -> nodesUnder(s.content))
  else if (n is predMod.SetNode)
    n.members.toMap().values.flatMap((m) -> m.clauses.toList()).flatMap((c) -> nodesUnder(c.node))
  else throw("unknown node kind '\(n.kind)'")

// A node's own backend-minted id, spliced in by the build's hoist. Must equal
// `DashboardBuild.NodeIdToken`.
const NODE_ID: String = "@@NODE_ID@@"
