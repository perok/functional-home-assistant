/// The CSS every dashboard gets, whatever its theme: the layout contract, the
/// colour variables cards are written against, and the look of what the
/// runtime itself emits or binds. Layer 1 of ADR 0020's three — `entry.pkl` puts
/// it on the dashboard, so a theme can override it but never drop it.
module core.css

import "text.pkl" as textMod

/// One semantic variable per job, defaulting to the HA token that means the
/// same thing; a theme re-points them to its framework's roles. A card says
/// `var(--fh-text-dim)`, never a Material role that exists only because BeerCSS
/// is loaded.
///
/// Three carry literals because neither HA nor a framework names the role:
/// `--fh-default-color`, the paint where a card must assume a colour the device
/// did not report (an `onoff` light), `--fh-scrim`, behind an open popup, and
/// `--fh-raise`, the shadow a card-like control rests on.
const local paletteVars: String = """
  :root{
  --fh-accent:var(--primary-color);
  --fh-on-accent:var(--text-primary-color);
  --fh-text:var(--primary-text-color);
  --fh-text-dim:var(--secondary-text-color);
  --fh-surface:var(--card-background-color);
  --fh-raise:0 .0625rem .1875rem rgb(0 0 0 / .2);
  --fh-surface-alt:var(--secondary-background-color);
  --fh-surface-sunken:var(--secondary-background-color);
  --fh-border:var(--divider-color);
  --fh-error:var(--error-color);
  --fh-on-error:var(--text-primary-color);
  --fh-warning:var(--warning-color);
  --fh-default-color:rgb(189, 189, 176);
  --fh-scrim:rgb(0 0 0 / .32);
  }
  """

/// The `fh-` layout contract (ADR 0008):
///
///   - `.fh-grid`: 12 columns, a cell spanning `columns(n)` (default 4). Flexbox
///     rather than grid, so a partial row centres while a full one fills;
///     `.fh-start` left-packs. `(100% + gap) * n/12 - gap` makes spans summing
///     to 12 fit one row exactly.
///   - `.fh-row`: children share the width. `.fh-col`: children fill it.
///   - `.fh-hug`: the cell shrinks to its content instead of filling its share.
///
/// A container states its children's layout as INHERITED custom properties
/// (`--fh-cell-flex`, …), never a child selector: a query set's `.fh-group` is
/// `display:contents` but stays in the DOM as a patch target, and inheritance
/// crosses it where a `.fh-row>.fh-cell` selector would stop at it. The default
/// spans sit in `:where()`, so an authored `.fh-cols-<n>` always wins.
const layoutCss: String = """
  .fh-grid{display:flex;flex-wrap:wrap;justify-content:center;gap:var(--fh-gap,1rem);--fh-cell-flex:0 1 calc((100% + var(--fh-gap,1rem)) * 4 / 12 - var(--fh-gap,1rem))}
  .fh-grid.fh-start{justify-content:flex-start}
  .fh-group{display:contents}
  :where(.fh-cell){flex:var(--fh-cell-flex,0 1 auto);min-width:0;align-self:var(--fh-cell-align-self,stretch);width:var(--fh-cell-width,auto)}
  """ + colSpans + """

  .fh-cols-full{flex-basis:100%}
  .fh-row{display:flex;gap:var(--fh-gap,1rem);flex-wrap:wrap;--fh-cell-flex:1 1 0;--fh-cell-align-self:flex-start}
  .fh-cell.fh-hug{flex:0 0 auto}
  .fh-col{display:flex;flex-direction:column;gap:var(--fh-gap,1rem);--fh-cell-width:100%}
  .fh-cell:has(>.fh-ifhost:empty){display:none}
  @media (max-width:640px){.fh-grid>.fh-cell,.fh-group>.fh-cell{flex-basis:100%}}
  """

const local colSpans: String = new Listing {
  for (n in IntSeq(1, 12)) {
    ".fh-cols-\(n){flex-basis:calc((100% + var(--fh-gap,1rem)) * \(n) / 12 - var(--fh-gap,1rem))}"
  }
}.toList().join("\n")

/// What `core/tap.pkl` binds onto whatever a tap lands on (ADR 0019).
/// `fh-disabled`/`fh-loading` are immediate and plain. `.fh-busy-spin` is the
/// delayed spinner, unless the theme replaces it (`Theme.classes`).
const local busyCss: String = """
  /* One "you cannot use this" look, in flight or refused; only in flight adds
     `fh-loading`, so the cursor tells them apart. */
  .fh-disabled{opacity:.5}
  .fh-disabled:not(.fh-loading){cursor:not-allowed}
  .fh-loading{cursor:progress}
  /* A button whose own `disabled` reading holds, with no class. */
  .fh-cell button:disabled{opacity:.5;cursor:not-allowed}
  /* A refused press, until the next one. An outline, so it reads on a card, a
     chip and a track alike without repainting what the control shows. */
  .fh-error{outline:2px solid var(--fh-error);outline-offset:2px;border-radius:inherit}
  .fh-busy-spin{display:inline-flex;align-items:center;justify-content:center;
  inline-size:var(--fh-badge-size,2.25rem);block-size:var(--fh-badge-size,2.25rem);
  box-sizing:border-box;border-radius:50%;
  border:.125rem solid var(--fh-accent);border-block-start-color:transparent;
  animation:fh-busy-spin .8s linear infinite}
  @keyframes fh-busy-spin{to{rotate:1turn}}
  /* A label has no glyph to wrap, so the ring follows the text. */
  .fh-busy-after::after{content:"";display:inline-block;inline-size:.8em;
  block-size:.8em;margin-inline-start:.4em;vertical-align:-.1em;
  box-sizing:border-box;border-radius:50%;border:.125rem solid currentColor;
  border-block-start-color:transparent;animation:fh-busy-spin .8s linear infinite}
  @media (prefers-reduced-motion:reduce){
  .fh-busy-spin,.fh-busy-after::after{animation:none;border-block-start-color:var(--fh-accent);opacity:.5}
  }
  """

/// What the shell emits: the connection banners (`Server.page`) and the failed
/// action toast (`src/js/shell.ts`). The SSE banner is an error, the HA one a
/// warning.
const local shellCss: String = """
  .fh-offline{position:fixed;top:0;left:0;right:0;z-index:1000;text-align:center;
  padding:.5rem 1rem;font-weight:600;box-shadow:0 1px 4px rgba(0,0,0,.3)}
  .fh-offline-sse{background:var(--fh-error);color:var(--fh-on-error)}
  .fh-offline-ha{background:var(--fh-warning);color:#000}
  .fh-offline-action{background:transparent;border:1px solid currentColor;color:inherit;
  border-radius:.25rem;padding:.1rem .5rem;margin-left:.5rem;cursor:pointer;font:inherit}
  /* An unloading page is not a connection problem. `!important`, because
     `data-show` reveals a banner by clearing its inline display. */
  .fh-leaving .fh-offline{display:none!important}
  .fh-toast{position:fixed;bottom:1rem;left:50%;transform:translateX(-50%);
  z-index:1100;background:var(--fh-error);color:var(--fh-on-error);padding:.75rem 1rem;
  border-radius:999px;font-weight:600;box-shadow:0 4px 12px rgba(0,0,0,.3)}
  """

/// The roles every card shares: `fh-reading`, a card's own live value;
/// `fh-sub`, a smaller line about it (`em`, so it scales where nested);
/// `fh-section`, a heading over a group; `fh-badge`, the round seat a card's
/// glyph sits in (`badge.pkl`), `--fh-badge-size` across (a button sizes it to
/// itself); `fh-lines`, a title with its reading and second line under it;
/// `fh-tile-card` and its `fh-tile` row, badge then lines then whatever the
/// card ends on, which the tile and the switch share; `fh-current-dashboard`,
/// a link to the dashboard already open, ringed rather than filled, since a
/// fill means on.
///
/// A badge paints its cell's on look, HA's tile scheme: the accent on a tint
/// of it while the cell is `fh-active`, a dimmed glyph on a badge marked
/// `fh-onoff` (one that can be off, `badge.pkl`) while it is not, and the
/// accent on the plain seat for one with no off (a sensor). On rides inherited
/// variables that every cell resets, so a slider's member rows never wear the
/// slider's look.
///
/// Prefixed, because these share the cascade with the theme's framework, whose
/// single-word utilities can be `!important`. Sizes are absolute, because a
/// bare `<h2>` takes BeerCSS's display scale (45px against a 14px card).
const local sharedCss: String = """
  .fh-reading{color:var(--fh-text-dim)}
  .fh-sub{font-size:.8em;color:var(--fh-text-dim)}
  .fh-section{color:var(--fh-accent);font-size:1.125rem;font-weight:600;
  line-height:1.3;margin:0}
  .fh-cell{--_fh-on-bg:initial;--_fh-on-fg:initial}
  .fh-cell.fh-active{--_fh-on-bg:color-mix(in srgb,var(--fh-accent) 20%,transparent);--_fh-on-fg:var(--fh-accent)}
  .fh-badge{display:inline-flex;align-items:center;justify-content:center;
  flex:0 0 auto;inline-size:var(--fh-badge-size,2.25rem);block-size:var(--fh-badge-size,2.25rem);
  border-radius:50%;background:var(--_fh-on-bg,var(--fh-surface-alt));color:var(--_fh-on-fg,var(--fh-accent))}
  .fh-badge.fh-onoff{color:var(--_fh-on-fg,var(--fh-text-dim))}
  .fh-badge>i{font-size:calc(var(--fh-badge-size,2.25rem) * 5 / 9);line-height:1}
  .fh-lines{display:flex;flex-direction:column;align-items:flex-start;min-inline-size:0}
  .fh-tile-card{display:flex;flex-direction:column;padding:0}
  .fh-tile{display:flex;align-items:center;gap:.75rem;min-inline-size:0;
  padding:1rem;border-radius:inherit}
  .fh-tile>.fh-lines{flex:1 1 auto}
  .fh-cell>.fh-current-dashboard{outline:.125rem solid var(--fh-accent);outline-offset:-.125rem}
  """

/// No pinch or double-tap zoom on touch (#306): a dashboard is an app surface
/// there. `touch-action` rather than `user-scalable=no`, which iOS ignores; on
/// the root, since touch-action intersects down the tree and a slider's
/// narrower `pan-y` still applies. A desktop keeps its zoom.
const local gestureCss: String = """
  @media (pointer:coarse){
  html{touch-action:pan-x pan-y}
  }
  """

/// What `entry.pkl` puts on the dashboard's `css`, in cascade order.
/// `core/text.pkl` is here because every card places its label boxes.
const baseCss: String =
  List(paletteVars, layoutCss, busyCss, shellCss, sharedCss, gestureCss, textMod.css)
    .join("\n")
