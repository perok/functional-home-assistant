/// Surfaces — the on-demand subtrees the build's hoist lifts into a
/// dashboard's `surfaces`: popups. [[Popup]] is here
/// because the mechanism itself wraps with it; the dialog is a card the
/// authoring layer composes, never backend chrome (ADR 0002).
module core.surface

import "node.pkl" as nodeMod
import "slot.pkl" as slotMod

/// One popup (`fh.view.model.Surface`); `activation` null is user-activated and
/// closed. A choice's branches are not surfaces here: a nodes slot's fill
/// carries them (`core/choice.pkl`).
///
/// An OWNED popup belongs to one node and is written inline there. A popup any
/// number of taps may open earns a registry entry: the test is being named from
/// more than one place, or from somewhere that is not its parent.
/// `openPopupInline` is locality only — its id derives from the owning node, so
/// no second tap can name it.
open class SurfaceDef {
  content: nodeMod.LayoutNode
  activation: UserActivation? = null
}

/// A popup, shown by a tap; per session. `defaultOpen` shows it from the first
/// paint.
class UserActivation {
  kind: "User" = "User"
  defaultOpen: Boolean = false
}

/// A registered popup whose `body` is wrapped in the [[Popup]] dialog. The
/// entry's `surfaces` default, so a popup amends into existence:
///   surfaces { ["detail"] { body { c.title("...") c.entityCard(e) } } }
class PopupSurface extends SurfaceDef {
  hidden body: Listing<nodeMod.LayoutNode> = new {}
  content = new Popup { children = body }
}

/// Closing a popup is going back: each open popup has a history entry of its
/// own (ADR 0005). Guarded, so a close outside a popup cannot leave the page.
const closeExpr: String = "$ui_popups && history.back()"

/// The popup dialog: the overlay `<dialog>` and a ✕, closed also by Escape and
/// a tap on the backdrop.
class Popup extends nodeMod.Node {
  card = "popup"
  cardDef = new nodeMod.CardDef {
    // The backdrop is the root and holds the dialog, whose clicks bubble to it:
    // only one on the backdrop itself closes.
    classes = "fh-popup-backdrop"
    attrs = #"data-on:click="evt.target === el && \#(closeExpr)""#
    template = #"<dialog open class="fh-popup"><button class="fh-popup-close" data-on:click="\#(closeExpr)" data-on:keydown__window="evt.key === 'Escape' && \#(closeExpr)">✕</button>\#(slotMod.childrenSlot)</dialog>"#
    // The frame is the theme's `<dialog>`. The ✕ is 44px, the touch-target
    // minimum, with a surface of its own, and `z-index:1`: at that size it
    // overlaps a title, which was otherwise on top of it. The dialog is not
    // modal, so the backdrop is what stops a tap beside it reaching the page.
    css = """
      .fh-popup-backdrop{position:fixed;inset:0;z-index:100;background:var(--fh-scrim)}
      dialog.fh-popup{max-inline-size:min(90vw,32rem);z-index:101}
      .fh-popup-close{position:absolute;inset-block-start:.5rem;inset-inline-end:.5rem;
      display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;
      inline-size:2.75rem;block-size:2.75rem;padding:0;border:0;border-radius:999px;z-index:1;
      background:var(--fh-surface-alt);color:var(--fh-text-dim);
      font-size:1.25rem;line-height:1;cursor:pointer}
      .fh-popup-close:is(:hover,:focus-visible){color:var(--fh-text)}
      """
  }
}
/// `(c.popup) { children { ... } }`.
hidden popup: Popup = new Popup {}
