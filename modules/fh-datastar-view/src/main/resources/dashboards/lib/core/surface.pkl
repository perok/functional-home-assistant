/// Surfaces — the on-demand subtrees the build's hoist lifts into a
/// dashboard's `surfaces`: popups, tab panels, `If` branches. [[Popup]] is here
/// because the mechanism itself wraps with it; the dialog is a card the
/// authoring layer composes, never backend chrome (ADR 0002).
module core.surface

import "node.pkl" as nodes
import "predicate.pkl" as pred

/// One surface (`fh.view.model.Surface`). `bake*` drive first-paint baking
/// (tabs, [[If]] branches); `activation` null is user-activated and closed.
///
/// An OWNED surface (a tab panel, an `If` branch) belongs to one node and is
/// written inline there. A popup any number of taps may open earns a registry
/// entry: the test is being named from more than one place, or from somewhere
/// that is not its parent. `openPopupInline` is locality only — its id derives
/// from the owning node, so no second tap can name it.
open class SurfaceDef {
  content: nodes.LayoutNode
  bakeInto: String? = null
  bakeAs: String? = null
  bakeIndex: Int? = null
  activation: (UserActivation|VarActivation|StateActivation)? = null
}

/// A popup, shown by a tap; per session. `defaultOpen` shows it from the first
/// paint. Never a baked member: a host is filled by a [[VarActivation]] or a
/// [[StateActivation]].
class UserActivation {
  kind: "user" = "user"
  defaultOpen: Boolean = false
}

/// The member whose `bakeIndex` is the node variable `name`, as seen from the
/// node it bakes into: a tab bar's panel. Per viewer, like [[UserActivation]],
/// but declared, so a choice is a variable write (ADR 0033).
class VarActivation {
  kind: "var" = "var"
  name: String
}

/// Shown while `condition` holds over live state — the same for every viewer.
/// Subject-free: every comparison names its own entity, and one that names
/// none is a `Dashboard.validate` error.
class StateActivation {
  kind: "state" = "state"
  condition: pred.Predicate
}

/// A registered popup whose `body` is wrapped in the [[Popup]] dialog. The
/// entry's `surfaces` default, so a popup amends into existence:
///   surfaces { ["detail"] { body { c.title("...") c.entityCard(e) } } }
class PopupSurface extends SurfaceDef {
  hidden body: Listing<nodes.LayoutNode> = new {}
  content = new Popup { children = body }
}

/// Closing a popup is going back: each open popup has a history entry of its
/// own (ADR 0005). Guarded, so a close outside a popup cannot leave the page.
const closeExpr: String = "$ui_popups && history.back()"

/// The popup dialog: the overlay `<dialog>` and a ✕, closed also by Escape and
/// a tap on the backdrop.
class Popup extends nodes.Node {
  card = "popup"
  cardDef = new nodes.CardDef {
    regions = new Mapping { [nodes.defaultRegion] = new nodes.Region {} }
    template = #"<div class="popup-backdrop" data-on:click="\#(closeExpr)"></div><dialog open class="popup"><button class="popup-close" data-on:click="\#(closeExpr)" data-on:keydown__window="evt.key === 'Escape' && \#(closeExpr)">✕</button>{{#children}}{{{html}}}{{/children}}</dialog>"#
    // The frame is the theme's `<dialog>`. The ✕ is 44px, the touch-target
    // minimum, with a surface of its own, and `z-index:1`: at that size it
    // overlaps a title, which was otherwise on top of it. The dialog is not
    // modal, so the backdrop is what stops a tap beside it reaching the page.
    css = """
      .popup-backdrop{position:fixed;inset:0;z-index:100;background:var(--fh-scrim)}
      dialog.popup{max-inline-size:min(90vw,32rem);z-index:101}
      .popup-close{position:absolute;inset-block-start:.5rem;inset-inline-end:.5rem;
      display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;
      inline-size:2.75rem;block-size:2.75rem;padding:0;border:0;border-radius:999px;z-index:1;
      background:var(--fh-surface-alt);color:var(--fh-text-dim);
      font-size:1.25rem;line-height:1;cursor:pointer}
      .popup-close:is(:hover,:focus-visible){color:var(--fh-text)}
      """
  }
}
/// `(c.popup) { children { ... } }`.
hidden popup: Popup = new Popup {}
