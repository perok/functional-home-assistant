/// Who may see a dashboard (#89). HA is the identity provider: these rules
/// admit HA users and say nothing about who anyone is.
///
/// On `entry.pkl`'s `access`, with a site-wide default on `site.pkl`; a
/// dashboard that sets none inherits the site's:
///
///     // site.pkl
///     access = a.admin                       // everything is admin-only...
///     dashboards {
///       ["wall"] { access = a.public; ... }  // ...except the hallway tablet
///       ["home"] { ... }                     // inherits: admin
///     }
///
/// Reached as `c.access`.
module core.access

import "../hass.pkl"

/// `kind` is the wire discriminator: the backend's `Access` enum, lowercased.
/// Closed: every case is one HA can answer, except [[Public]], which HA has no
/// notion of.
abstract class Access {
  kind: String
}

/// No login: a wall tablet, a kitchen screen. Its taps still act on the home.
class Public extends Access { kind = "public" }

/// Any HA user. The default.
class Authenticated extends Access { kind = "authenticated" }

/// HA admins, owner included.
class Admin extends Access { kind = "admin" }

/// Exactly these HA users, an unlisted admin included: an implicit admin
/// override would make "only these two people" untrue. Built by [[users]].
class Users extends Access {
  kind = "users"
  ids: Listing<String>(!isEmpty)
}

const public: Public = new Public {}

const authenticated: Authenticated = new Authenticated {}

const admin: Admin = new Admin {}

/// `c.access.users(List(dump.users.peri, dump.users.heidi))`. Typed users, not
/// ids, so a misspelled name fails the build. A `List`, since Pkl has no
/// varargs.
const function users(people: List<hass.User>): Users = new Users {
  ids { for (p in people) { p.user_id } }
}
