/// What a card does with a label longer than its box. A card marks its label
/// boxes with [[hole]] / [[run]]; a dashboard or a single node picks the mode.
///
/// The mode travels as inherited custom properties, so the nearest ancestor
/// wins; `.fh-text-clip .fh-text` selectors would tie and let stylesheet order
/// decide.
module core.text

import "slot.pkl" as slotMod

/// `wrap` takes another line (breaking inside a word if it must, for an entity
/// id). `clip` cuts one line with an ellipsis, the default, so a grid of cards
/// stays a grid. `scroll` slides one line by exactly what does not fit, so a
/// label that fits sits still.
typealias Overflow = "wrap"|"clip"|"scroll"

/// Also the fallback in every `var()` below.
const defaultOverflow: Overflow = "clip"

/// The class that puts one node and its subtree in a mode
/// (`LayoutNode.textOverflow`).
const function cls(o: Overflow): String = "fh-text-" + o

const function vars(o: Overflow): String =
  new Listing {
    "--fh-text-lines:\(if (o == "wrap") "normal" else "nowrap")"
    "--fh-text-break:\(if (o == "wrap") "anywhere" else "normal")"
    "--fh-text-clip:\(if (o == "wrap") "visible" else "hidden")"
    "--fh-text-ellipsis:\(if (o == "clip") "ellipsis" else "clip")"
    // Only a scrolling box measures itself, which contains its inline axis, so
    // it must grow into its line as a flex item instead of sizing to its text.
    "--fh-text-track:\(if (o == "scroll") "inline-size" else "normal")"
    "--fh-text-flex:\(if (o == "scroll") "1 1 auto" else "0 1 auto")"
    "--fh-text-run:\(if (o == "scroll") "inline-block" else "inline")"
    "--fh-text-motion:\(if (o == "scroll") "fh-text-scroll 12s linear infinite" else "none")"
  }.toList().join(";")

/// The dashboard default, at `:root`, so a node's [[cls]] is nearer.
const function rootCss(o: Overflow): String = ":root{\(vars(o))}"

/// A label box: the element the card's own layout sizes. Add it to an element
/// the card already has and place [[run]] inside, or use [[hole]].
const BOX: String = "fh-text"

/// The text inside a box: a marquee translates it past the box, and a bare
/// text node has nothing to translate.
const function run(name: String): String =
  #"<span class="fh-text-run">{{\#(name)}}</span>"#

/// [[run]] for a signal value. The binding sits on the run: on the box, a
/// `data-text` patch would replace the run and the scrolling would stop.
const function liveRun(name: String): String =
  #"<span class="fh-text-run" \#(slotMod.signalBind(name))>{{\#(name)}}</span>"#

/// Box and run, for a card with no element of its own to mark.
const function hole(name: String): String =
  #"<span class="\#(BOX)">\#(run(name))</span>"#

/// `"normal"` is the card's own text colour; the others the `--fh-*` role.
typealias Tone = "normal"|"dim"|"error"|"warning"

/// A short line in a [[Tone]], for a card with something to say. `body` is
/// template markup; `tone` is a String so it can come through a slot.
///
/// The runtime writes the same structure where a chart could not be drawn
/// (`Staged.label`, held equal by `FailureLabelSuite`), so change both.
const function label(tone: String, body: String): String =
  #"<span class="fh-label fh-label-\#(tone) \#(BOX)"><span class="fh-text-run">\#(body)</span></span>"#

/// Emitted once with the base CSS. The box is always a block, because
/// `text-overflow` needs one to cut. `max-inline-size` is what makes it cut:
/// an unstretched flex item (`.fh-lines` is a column with `flex-start`) is
/// sized to fit its content, which for one line is the whole label, so the
/// box ran past the card and never showed an ellipsis.
const css: String = """
  .fh-text{display:block;min-inline-size:0;
  flex:var(--fh-text-flex,0 1 auto);
  white-space:var(--fh-text-lines,nowrap);
  overflow-wrap:var(--fh-text-break,normal);
  overflow:var(--fh-text-clip,hidden);
  text-overflow:var(--fh-text-ellipsis,ellipsis);
  container-type:var(--fh-text-track,normal);max-inline-size:100%}
  .fh-text>.fh-text-run{display:var(--fh-text-run,inline);animation:var(--fh-text-motion,none)}
  .fh-label-dim{color:var(--fh-text-dim)}
  .fh-label-error{color:var(--fh-error)}
  .fh-label-warning{color:var(--fh-warning)}
  \(modeCss)
  /* `100cqw` is the box, `100%` in a translate the run's own width, so the
     travel is negative exactly when the text does not fit, and `min()` pins
     the rest at zero. No measuring, nothing to redo on resize. */
  @keyframes fh-text-scroll{
  0%,12%{transform:translateX(0)}
  88%,100%{transform:translateX(min(0px,calc(100cqw - 100%)))}
  }
  /* Reduced motion gets the clipped line, which still says there is more. */
  @media (prefers-reduced-motion:reduce){
  .fh-text>.fh-text-run{animation:none}
  .fh-text{text-overflow:ellipsis}
  }
  """

const local modeCss: String = new Listing {
  for (o in List("wrap", "clip", "scroll")) {
    ".\(cls(o)){\(vars(o))}"
  }
}.toList().join("\n")
