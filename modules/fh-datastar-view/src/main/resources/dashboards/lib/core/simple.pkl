/// The steps of a reading ([[slotMod.Reading]]), and the fast tier's
/// constructors (ADR 0028). A reading's value is its source read, then each
/// step run on it: a [[Cel]] is engine work, every other step a static lookup
/// that is TOTAL over every value a live entity can produce. Totality is the
/// part that matters: CEL's `double(state)` errors on `unknown`, and an error
/// renders as its own message on a wall panel. Anything more is CEL.
///
/// Where a step has a CEL spelling, its constructor documents it and
/// `TransformSuite`'s parity sweep pins the rendered bytes equal to it. Where
/// the engine would error, the step renders its absent form instead — the
/// documented divergence, pinned too. Each class is `fh.view.model.Step`'s case
/// of the same name and fields, which `WireShapeSuite` checks.
module core.simple

import "node.pkl" as nodes
import "slot.pkl" as slotMod

abstract class Step {
  kind: String
}

/// CEL over the source's entity (`state`, `attr`, `entity_id`, `domain`, when
/// the reading has one), `dashboard_slug`, `time_zone` and its named `values`.
class Cel extends Step {
  kind: "Cel" = "Cel"
  src: String
  /// Named inputs of this expression alone, beside its node's
  /// ([[nodes.Node.expressionValues]]): the same kinds, a fetch included
  /// (`p.history.of(e, w)`). A name in both is a build error.
  hidden values: Mapping<String, nodes.ExpressionValue>? = null
  inputs: Map<String, Any>? = values?.toMap()?.mapValues((_, v) -> slotMod.wireInput(v))
}

/// The size of a [[slotMod.PresentRead]] list.
class CountStep extends Step {
  kind: "Count" = "Count"
}

/// One value in, one text out, over operands that are themselves values.
abstract class Format extends Step {}

class Prefix extends Format {
  kind: "Prefix" = "Prefix"
  text: slotMod.Operand
}

class Suffix extends Format {
  kind: "Suffix" = "Suffix"
  text: slotMod.Operand
}

class WithUnit extends Format {
  kind: "WithUnit" = "WithUnit"
  unit: slotMod.Operand
}

class Percent extends Format {
  kind: "Percent" = "Percent"
  min: slotMod.Operand
  max: slotMod.Operand
}

class Fill extends Format {
  kind: "Fill" = "Fill"
  min: slotMod.Operand
  max: slotMod.Operand
}

class Duration extends Format {
  kind: "Duration" = "Duration"
  scale: Number
}

/// A lookup:
/// `cel.bind(m, {'k': 'v', ...}, value in m ? m[value] : 'otherwise')`.
///
/// Arms may be Booleans, the only value that turns a boolean attribute off
/// (`""` sets one). Mixing Strings and Booleans is a build error: CEL wants one
/// type across a map's values. `otherwise` is required because HA adds states
/// to a domain after it ships, and an unmatched one must degrade, not blank. It
/// may be a read, `attrOf("effect")` to show an unlabelled value as itself.
class Match extends Format {
  kind: "Match" = "Match"
  cases: Mapping<String, String|Boolean>
  otherwise: slotMod.Operand
}

/// Which part of an entity a read takes; a read of the state names none.
class Attr {
  kind: "Attr" = "Attr"
  name: String
}

// `const`, because components call them from class bodies.

/// `state`.
const function state(): slotMod.Reading = new slotMod.Reading {}

/// `attr[?'attribute']`; absent renders `""` and the slot's default applies.
const function attr(attrName: String): slotMod.Reading =
  new slotMod.Reading { part = new Attr { name = attrName } }

/// An attribute of the reading's entity, as a step's operand.
const function attrOf(attrName: String): slotMod.EntityRead =
  new slotMod.EntityRead { part = new Attr { name = attrName } }

/// `state + attr[?'attribute'].optMap(u, ' ' + u).orValue('')`. A unit that is
/// not a String renders the state alone, and an empty state stays empty.
const function suffixUnit(attrName: String): slotMod.Reading =
  new slotMod.Reading { steps { new WithUnit { unit = attrOf(attrName) } } }

/// The attribute, a space and its `unit_of_measurement` when it has one;
/// absent renders `""` and the slot's default applies.
const function attrUnit(attrName: String): slotMod.Reading =
  (attr(attrName)) { steps { new WithUnit { unit = attrOf("unit_of_measurement") } } }

/// `'literal' + state`.
const function prefix(lit: String): slotMod.Reading =
  new slotMod.Reading { steps { new Prefix { text = lit } } }

/// `state + 'literal'`.
const function suffix(lit: String): slotMod.Reading =
  new slotMod.Reading { steps { new Suffix { text = lit } } }

/// The state looked up: [[Match]].
const function matchOf(byState: Mapping<String, String|Boolean>, elseV: slotMod.Operand): slotMod.Reading =
  new slotMod.Reading { steps { new Match { cases = byState; otherwise = elseV } } }

/// The one-armed [[matchOf]].
const function enumOf(eq: String, thenV: String|Boolean, elseV: String|Boolean): slotMod.Reading =
  matchOf(new Mapping { [eq] = thenV }, elseV)

/// Whether the state is one of these: [[matchOf]] with `true` arms and a
/// `false` otherwise.
const function stateIn(states: Listing<String>): slotMod.Reading =
  matchOf(new Mapping { for (s in states) { [s] = true } }, false)

/// The attribute as a percentage of `[min, max]`, rounded half away from zero
/// like `math.round`. Numeric as `double()` is; otherwise `"0 %"`.
const function percent(attrName: String, minV: Number, maxV: Number): slotMod.Reading =
  (attr(attrName)) { steps { new Percent { min = minV; max = maxV } } }

/// [[percent]]'s complement for a right-anchored track, unrounded, since it is
/// a CSS length. Otherwise `"100%"`.
const function fill(attrName: String, minV: Number, maxV: Number): slotMod.Reading =
  (attr(attrName)) { steps { new Fill { min = minV; max = maxV } } }

/// The state as a number of `unitSeconds`, rendered `4h 13m` / `13m` / `45s`.
/// Otherwise `""`: an appliance between programmes reports `unknown`, where
/// `0s` would claim it just finished. Pass `e.durationSeconds`, which is null
/// for a unit with no fixed length.
const function duration(unitSeconds: Number): slotMod.Reading =
  new slotMod.Reading { steps { new Duration { scale = unitSeconds } } }

/// A CEL step.
const function cel(expression: String): Cel = new Cel { src = expression }
