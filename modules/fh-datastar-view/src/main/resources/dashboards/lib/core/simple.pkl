/// The simple tier: the explicit fast path for slot values (ADR 0028). A slot's
/// value is CEL (a String) or one of these structures, a condition
/// (`q.entity(e).stateIs("on")`, `lit.any()`) included; the form is the tier.
///
/// A shape joins when it is a static lookup and TOTAL over every value a live
/// entity can produce. Totality is the part that matters: CEL's
/// `double(state)` errors on `unknown`, and an error renders as its own message
/// on a wall panel. Every read is of the slot's entity unless it names another
/// in `entity`. Anything more is CEL.
///
/// Where a shape has a CEL spelling, its constructor documents it and
/// `TransformSuite`'s parity sweep pins the rendered bytes equal to it. Where
/// the engine would error, the structure renders its absent form instead — the
/// documented divergence, pinned too. The constructors are the only door.
module core.simple

import "predicate.pkl" as predMod

/// An operator over one read: one class per `Transform.Simple.Op` case, of the
/// same name and with the same fields, which `WireShapeSuite` checks. `kind`
/// names the shape and `op` the operator, each its Scala case name.
abstract class SimpleValue {
  kind: "Op" = "Op"
  op: String
  /// The entity read; null is the slot's. Another one wakes the slot too.
  entity: String? = null
}

class State extends SimpleValue { op: "State" = "State" }

class Attr extends SimpleValue {
  op: "Attr" = "Attr"
  attribute: String
}

class SuffixUnit extends SimpleValue {
  op: "SuffixUnit" = "SuffixUnit"
  attribute: String
}

class AttrUnit extends SimpleValue {
  op: "AttrUnit" = "AttrUnit"
  attribute: String
}

class Prefix extends SimpleValue {
  op: "Prefix" = "Prefix"
  literal: String
}

class Suffix extends SimpleValue {
  op: "Suffix" = "Suffix"
  literal: String
}

class Percent extends SimpleValue {
  op: "Percent" = "Percent"
  attribute: String
  min: Number
  max: Number
}

class Fill extends SimpleValue {
  op: "Fill" = "Fill"
  attribute: String
  min: Number
  max: Number
}

class Duration extends SimpleValue {
  op: "Duration" = "Duration"
  scale: Number
}

/// A read as a lookup:
/// `cel.bind(m, {'k': 'v', ...}, state in m ? m[state] : 'otherwise')`.
///
/// Arms may be Booleans, the only value that turns a boolean attribute off
/// (`""` sets one). Mixing Strings and Booleans is a build error: CEL wants one
/// type across a map's values. `otherwise` is required because HA adds states
/// to a domain after it ships, and an unmatched one must degrade, not blank. It
/// may be a read of the same entity, `attr("effect")` to show an unlabelled
/// value as itself, which is text.
class SimpleMatch {
  kind: "Match" = "Match"
  cases: Mapping<String, String|Boolean>
  otherwise: String|Boolean|SimpleValue|SimpleMatch
  /// `"attr:<name>"`, or another property as a condition reads one; null is
  /// the state.
  property: String? = null
  entity: String? = null
}

typealias Simple = SimpleValue|SimpleMatch|predMod.Predicate

// `const`, because components call them from class bodies.

/// `state`.
const function state(): Simple = new State {}

/// `attr[?'attribute']`; absent renders `""` and the slot's default applies.
const function attr(attrName: String): Simple =
  new Attr { attribute = attrName }

/// `state + attr[?'attribute'].optMap(u, ' ' + u).orValue('')`. A unit that is not a
/// String renders the state alone.
const function suffixUnit(attrName: String): Simple =
  new SuffixUnit { attribute = attrName }

/// The attribute, a space and its `unit_of_measurement` when it has one;
/// absent renders `""` and the slot's default applies.
const function attrUnit(attrName: String): Simple =
  new AttrUnit { attribute = attrName }

/// `'literal' + state`.
const function prefix(lit: String): Simple =
  new Prefix { literal = lit }

/// `state + 'literal'`.
const function suffix(lit: String): Simple =
  new Suffix { literal = lit }

const function matchOf(byState: Mapping<String, String|Boolean>, elseV: String|Boolean): Simple =
  new SimpleMatch { cases = byState; otherwise = elseV }

/// The one-armed [[matchOf]].
const function enumOf(eq: String, thenV: String|Boolean, elseV: String|Boolean): Simple =
  new SimpleMatch { cases = new { [eq] = thenV }; otherwise = elseV }

/// Whether the state is one of these: [[matchOf]] with `true` arms and a
/// `false` otherwise.
const function stateIn(states: Listing<String>): Simple =
  new SimpleMatch {
    cases = new { for (s in states) { [s] = true } }
    otherwise = false
  }

/// The attribute as a percentage of `[min, max]`, rounded half away from zero
/// like `math.round`. Numeric as `double()` is; otherwise `"0 %"`.
const function percent(attrName: String, minV: Number, maxV: Number): Simple =
  new Percent { attribute = attrName; min = minV; max = maxV }

/// [[percent]]'s complement for a right-anchored track, unrounded, since it is
/// a CSS length. Otherwise `"100%"`.
const function fill(attrName: String, minV: Number, maxV: Number): Simple =
  new Fill { attribute = attrName; min = minV; max = maxV }

/// The state as a number of `unitSeconds`, rendered `4h 13m` / `13m` / `45s`.
/// Otherwise `""`: an appliance between programmes reports `unknown`, where
/// `0s` would claim it just finished. Pass `e.durationSeconds`, which is null
/// for a unit with no fixed length.
const function duration(unitSeconds: Number): Simple =
  new Duration { scale = unitSeconds }
