/// Taps — what a click DOES, as the whole Datastar expression a card splices
/// into `data-on:click`.
///
/// A tap is either a service call, a navigation (which also carries an `href`,
/// so a card whose root can be an `<a>` gets real link behaviour), or a surface
/// open/close. Re-exported as the `c.tap` namespace for authors.
module core.tap

import "node.pkl" as nodes
import "slot.pkl" as slotMod
import "surface.pkl" as surfaceMod
import "../hass.pkl"
import "../hass/actions.pkl" as hassActions

/// A tap descriptor: the whole Datastar click expression, either a Slot
/// (reading `$entity_id`, and `$state` for the one state-dependent form) or a
/// constant string. A tap that opens
/// an INLINE popup also carries `inlineSurfaces` (the dialog content); the card
/// copies it onto the node so the hoist can lift it.
///
/// A tap that goes somewhere ([[navigate]]) ALSO sets `href`, and a card that
/// can be an anchor must prefer it — that is what gives the browser real link
/// behavior (middle-click, open-in-new-tab, status bar, no JS). `onclick` is
/// then the equivalent for cards whose root element cannot be an `<a>` (the
/// `<article>` of [[EntityCard]]), so every card renders the same intent.
class TapAction {
  onclick: slotMod.Slot|String
  href: String? = null
  inlineSurfaces: Mapping<String, surfaceMod.SurfaceDef>? = null
  /// Whether this tap is worth GUARDING: while its POST is in flight, a second
  /// click is a no-op. TRUE on the service taps (the only ones with a server
  /// round-trip worth guarding); FALSE on `navigate` (a full document load — no
  /// in-flight UI wanted) and the surface opens/closes (instant local POSTs,
  /// where a busy state would fight the popup itself). The slider's continuous
  /// value drag is NOT guarded even though it posts: it is not a discrete tap.
  ///
  /// The opt-out is the flag itself: a tap with `busy = false` renders
  /// byte-identical to before this field existed.
  busy: Boolean = false
  /// Whether the guard's in-flight window also shows the theme's busy LOOK
  /// ([[busyClass]] — the `fh-disabled` dim and the `fh-loading` spinner,
  /// both bound to the same Datastar signal). Independent of [[busy]]:
  /// `busy = true, busyVisual = false` still swallows a re-click, it just
  /// never dims or spins — for a control whose action answers fast, where
  /// any busy flicker reads as noise. The dim is IMMEDIATE (it is the
  /// "your tap landed, the control is inert" feedback); only the spinner
  /// waits, on the derived signal [[busyShapeClass]] builds.
  busyVisual: Boolean = true
}
// Wrap a JSONata route expression into the full Datastar click expression
//   @post('sse/action/<slug>/<domain>/<service>/<entity_id>', <no signals>)
// All app URLs are RELATIVE: they resolve against the page's <base href>
// (`/` served directly, the ingress prefix behind the HA supervisor proxy).
//
// `$dashboardSlug` is bound by the renderer, like `$entity_id`: a dashboard
// module does not know its own slug (`site.pkl` supplies it as a key, and
// `fh push --slug` renames it). The server needs it to bound what a tap may
// touch — an action may only reach an entity its own dashboard names, so
// admission to one dashboard is not admission to the whole house (ADR 0023).
//
// A card that builds an action URL in its own TEMPLATE writes `{{dashboardSlug}}`
// for the same value (the slider's commit). Two spellings, one fact, and each
// names the mechanism that actually fills it: Mustache renders a template, but a
// transform's OUTPUT is inserted raw, so Mustache never sees it.
//
// SENDS NO SIGNALS. This route reads nothing from the request body — the
// domain, service and entity are all in the path — but Datastar's default is to
// serialise the whole signal store into every request, so without the filter
// each tap ships `conn`, the four cursor signals and every `ui_*` for the server
// to ignore. `exclude` is a REGEX (not a glob), so `.*` is "everything";
// `filterSignals` must be nested or it is silently ignored — see the datastar
// skill, both verified against the pinned bundle rather than the vendored docs.
const noSignals = #"{filterSignals:{exclude:'.*'}}"#

/// The busy pieces a card splices onto a guarded tap's element, keeping the
/// `_<nodeId>__busy` signal name in ONE place (`{{id}}` stays a Mustache token
/// inside them — the renderer fills it per node). Splice them ONLY when the
/// tap has `busy = true`:
///
///   data-on:click="{{#busy}}\(tapMod.busyGuard){{/busy}}{{{onclick}}}"
///   {{#busy}}\(tapMod.busyAttrs){{/busy}}{{#busyVisual}} \(tapMod.busyClass){{/busyVisual}}
///
/// `busyGuard` makes the click expression a no-op while the signal is truthy
/// (the anti-spam); `busyAttrs` arms the indicator that drives the signal and
/// the guard. `busyClass` is the IMMEDIATE visual — `fh-disabled` (dim) and
/// `fh-loading` (cursor) land the instant the tap does, because "your tap
/// landed and this control is inert now" is exactly what a tap should answer.
/// The SPINNER is the delayed half and lives in `busyShapeClass`.
/// A card splices it only when the tap also has `busyVisual = true`.
/// One guarded element per node, so the name is never shared — a sibling's
/// `finished` would otherwise clear an in-flight busy (see
/// `docs/adr/0019-an-action-in-flight.md`).
/// The IN-FLIGHT LOOK, for any signal that is truthy while something is
/// outstanding. Parameterised because the look is one fact and the state is
/// not: an ADR 0019 `busy` boolean and an ADR 0025 pending VALUE both wear it,
/// and so does the slider's separate commit signal. The signals must keep their
/// own names (they are keyed differently and written by different things — see
/// [[pendingSignal]]); only the classes are shared.
const function inFlightClass(sig: String): String =
  #"data-class:fh-disabled="$\#(sig)" data-class:fh-loading="$\#(sig)""#

/// The re-click guard, as the prefix that makes a click expression a no-op
/// while `sig` is truthy.
const local function guardOn(sig: String): String = "$" + sig + " ? '' : "

// The indicator names the signal via the VALUE form (`data-indicator="<name>"`),
// NOT the keyed form: the pinned v1.0.2 bundle splits a namespaced attribute's
// KEY on `__` (its mod separator), so `data-indicator:_{{id}}__busy` would arm a
// signal named `_<id>` and the `__busy` suffix would silently become a mod —
// the busy class and guard read `_<id>__busy`, so nothing ever showed or gated.
// The value string is not split (verified against the pinned bundle's `hn`).
const local function indicatorOn(sig: String): String =
  #"data-indicator="\#(sig)""#

/// The two busy signal names. A tap's own, and the slider's separate
/// value-commit one — see [[busyGuardChange]] for why that must not be shared.
const busySig: String = "_{{id}}__busy"
const busyChangeSig: String = "_{{id}}__busy_change"

const busyGuard: String = guardOn(busySig)
const busyAttrs: String = indicatorOn(busySig)
const busyClass: String = inFlightClass(busySig)

/// How long an action may take before it is worth SAYING it is taking a
/// while. Below this, the spinner never appears at all.
const busyDelayMs: Int = 300

/// The spinner splice, for an element that hosts an `i.mdi` glyph (the entity
/// header badge, the slider's head badge and its power button). The class it
/// gains is the THEME's to name — the splice leaves a [[nodes.CLASS_BIND]] hole
/// under the key `busySpin`, which the registry fills with whatever the theme
/// lists there (BeerCSS's `shape loading-indicator`, an SVG mask that morphs
/// itself around the glyph; `fh-busy-spin`, a plain ring, for a theme that says
/// nothing). Only the TIMING is ours.
///
/// The [[busyDelayMs]] gate is a DERIVED SIGNAL, not a CSS `animation-delay`.
/// A class carries more than paint: `shape` also gives the element a box
/// (`display`, size, background), and no `animation-delay` can defer THAT —
/// the layout moved the instant the class landed. Worse, the only property a
/// delay could hold back is `opacity`, which dims the element AND the glyph
/// inside it, so a sub-threshold action blinked its own icon out and back.
/// Gating the SIGNAL instead means the class is simply absent until we mean
/// it, and the CSS is then an ordinary "this is what a spinner looks like".
///
/// Read the derivation: the busy signal flips, [[busyDelayMs]] later the
/// handler copies whatever it is by THEN. A fast action is already false, so
/// nothing is ever added and nothing renders. A slow one is still true, so
/// the spinner appears at full strength. The same delay on the way down is
/// deliberate — it swallows the on/off chatter of a burst of quick taps.
///
/// `data-on-signal-patch` fires on EVERY signal write, local ones included
/// (verified in the pinned bundle: the store proxy's setter dispatches it), so
/// the indicator's own write is what drives this. The `-filter` companion is
/// not optional — unfiltered, every HA state patch on the page would arm a
/// timer on every guarded element. Node ids are `[A-Za-z0-9_]` only
/// (`Dashboard.sanitize`), so interpolating one into the regex is safe.
///
/// The class must be ABSENT at rest rather than styled inert: BeerCSS's
/// `.shape>i{filter:invert(1)}` is unconditional, so a permanently-present
/// class would tint the glyph when nothing is happening. A theme naming its
/// spinner class here inherits that rule — bind, never style-inert.
///
/// `__ifmissing` is load-bearing: this element is a morph target, and a plain
/// `data-signals` would re-seed the signal to false on every patch that
/// touches it — including the ones the in-flight action itself provokes.
const local function busySpinner(sig: String): String = #"""
  data-signals__ifmissing="{\#(sig)_slow:false}" data-on-signal-patch-filter="{include:/^\#(sig)$/}" data-on-signal-patch__delay.\#(busyDelayMs)ms="$\#(sig)_slow = $\#(sig)" @@CLASSBIND:busySpin:$\#(sig)_slow@@
  """#

const busyShapeClass: String = busySpinner("_{{id}}__busy")

/// The slider's VALUE-COMMIT variant of the busy pieces. A slider commits its
/// position on RELEASE (its `data-on:change` → the value POST), and dragging
/// back on while that POST is still in flight would fire a second commit the
/// server would happily process — so the range input carries its OWN
/// `_<nodeId>__busy_change` signal. The separate name is required, not
/// cosmetic: a slider may ALSO have a guarded power button, and a shared name
/// would let one element's `finished` clear the other's in-flight busy (the
/// per-element invariant in `docs/adr/0019-an-action-in-flight.md`).
///
/// Splice them on the slider's own markup:
///
///   <input … \(tapMod.busyAttrsChange)
///     data-on:change="\(tapMod.busyGuardChange)@post(…)" />
///   <div class="slider max" … \(tapMod.busyClassChange)>
///
/// `busyAttrsChange` also DISABLES the input while the signal is set. That is
/// safe because busy can only become true on RELEASE (never mid-drag), so
/// disabling freezes the control between drags and the browser fires no
/// `input`/`change` at all — the guard is the belt for a programmatic
/// dispatch. The boolean comes from the indicator plugin, so the attr plugin's
/// `true`→`setAttribute`/`false`→`removeAttribute` toggle works exactly.
const busyGuardChange: String = guardOn(busyChangeSig)
const busyAttrsChange: String =
  indicatorOn(busyChangeSig) + #" data-attr:disabled="$\#(busyChangeSig)""#
const busyClassChange: String = inFlightClass(busyChangeSig)
/// [[busyShapeClass]]'s commit-signal twin, for the slider's head badge —
/// the track carries no icon of its own, so the badge is what spins for the
/// whole commit window.
const busyShapeClassChange: String = busySpinner("_{{id}}__busy_change")

const local function serviceOnclick(route: String): String =
  #""@post('sse/action/" & $dashboardSlug & "/" & ("# + route + #") & "/" & $entity_id & "', "# +
    noSignals + #")""#

// A click expression inherits the card's entity to resolve $entity_id, and must
// resolve even when that entity is unavailable (an unavailable light is exactly
// the one you want to click). `live` is the rare case: a route the CURRENT state
// picks ([[stateService]]), which has to re-render like any other state
// reading. Everything else is identity-derived — `reactive = false` keeps it in
// the renderer's identity cache.
const local function clickSlot(transformExpr: String, live: Boolean): slotMod.Slot = new {
  transform = transformExpr
  reactive = live
  bypassUnavailable = false
}

// The click expression for a surface OPEN. A TRANSFORM, not a constant string,
// for one reason: only a transform can read `$dashboardSlug`, and the route
// needs the slug. A literal slot is used verbatim — no Mustache pass, no
// binding — so a constant could never carry it.
//
// It reads no entity, and does not need one: a slot with no entity resolves
// against an empty `EntityState` (`Renderer.resolveSlot`), and `$dashboardSlug`
// is bound independently of it. That is what lets a pill with no entity of its
// own open a popup.
//
// `head` is the client-side half — the PENDING assignment that records what
// this click asked for — spliced inside the produced expression rather than
// before it, since the whole click expression is one string. It runs FIRST so
// the display moves on the press rather than on the response.
const local function openSurfaceOnclick(surfaceId: String, head: String): slotMod.Slot =
  clickSlot(
    // The closing quote is `"\""`, not `#"""#` — the latter opens a MULTI-LINE
    // raw string and swallows the rest of the module.
    "\"" + head + #"@post('sse/surface/" & $dashboardSlug & "/open/"# + surfaceId + #"')"# +
      "\"",
    false
  )

/// The PENDING signal for a selection group — what this client has ASKED to
/// show, where `ui_<groupId>` is what the server says it IS showing. Only the
/// client ever writes it, and it CLEARS ITSELF once the committed value agrees
/// ([[pendingClear]]), so a tap that never landed cannot leave a selection
/// asserted. See `docs/plan-pending-signals.md`.
///
/// `_`-prefixed, so it never rides a request: the server learns what was asked
/// for from the URL path, not the signal store.
const function pendingSignal(groupId: String): String = "_\(groupId)__pending"

/// The pending signal's seed ENTRY, for splicing into a host's existing
/// `data-signals__ifmissing` object — a second attribute of that name on the
/// same element would simply be dropped by the parser.
///
/// `__ifmissing` for the same reason the `ui_` seed uses it: a plain seed would
/// wipe an in-flight pending on every re-render of the host.
const function pendingSeedEntry(groupId: String): String =
  "\(pendingSignal(groupId)): ''"

/// What empties a group's pending signal: **it was answered, or nothing can
/// answer it.** One rule, one attribute — a second `data-effect` on the same
/// element would simply be dropped by the parser.
///
/// The answered half is DERIVED from `ui_<groupId>` rather than sent with it,
/// and that is what makes concurrent taps correct: tap A then tap B, and A's
/// response must leave B's pending alone. A clear in the frame could not tell
/// them apart; comparing to the committed value can. `==` is loose on purpose —
/// the seed is a number and a committed index arrives as a string.
///
/// The other half is `_sse`, the shell's connection-health counter: the commit
/// travels on the SSE stream, so a stream that is DOWN is the exact statement
/// that no commit is coming. This is not a timeout and there is no deadline —
/// a POST that fails outright fails because the transport did, and the same
/// transport is what would have carried the answer. When the stream returns,
/// the connect states the committed selections again ([[SurfaceGraph]]
/// `committedSelections`), so the display lands on truth rather than on a
/// guess. A REFUSAL — a status the server actually sent, on a working stream —
/// is the remaining case, and [[pendingFail]] has it.
///
/// This effect READS AND WRITES the same signal, which is the shape that loops.
/// It settles because the assignment falsifies its own guard, and
/// `DatastarMorphContractSuite` MEASURES that rather than assuming it.
const function pendingClear(groupId: String): String =
  let (sig = pendingSignal(groupId))
    #"data-effect="$\#(sig) !== '' && ($ui_\#(groupId) == $\#(sig) || $_sse > 0) && ($\#(sig) = '')""#

/// The refusal case: the server answered, and the answer was no (ADR 0024's
/// 4xx statuses). Nothing will commit, so the ask ends here.
///
/// Keyed on the `error` type and nothing else, which the pinned bundle makes
/// exact rather than approximate: that type is dispatched from `onopen`, so it
/// fires precisely when a RESPONSE with a status arrived. A request that got no
/// response at all is not this case — it is a dead transport, which
/// [[pendingClear]]'s `_sse` half owns.
///
/// `datastar-fetch` is dispatched on `document` and does not bubble, hence
/// `__document` — a `data-on` modifier verified in the pinned bundle
/// (`n.has("window") ? s = window : n.has("document") && (s = document)`),
/// which also names the event argument `evt`.
const function pendingFail(groupId: String): String =
  let (sig = pendingSignal(groupId))
    #"data-on:datastar-fetch__document="evt.detail.type === 'error' && ($\#(sig) = '')""#

/// What a control reads to show a selection: the pending value while one is
/// outstanding, the committed one otherwise. `''` is falsy, so no pending means
/// the server's answer shows — and nothing is ever rolled back, because nothing
/// wrong was ever committed.
const function pendingOrCommitted(groupId: String): String =
  "($" + pendingSignal(groupId) + " || $ui_" + groupId + ")"

/// The tab bar's own open-a-member click: [[openSurfaceOnclick]] preceded by
/// the group's PENDING assignment. The committed `ui_<groupId>` is the SERVER's
/// to write, on the swap this POST asks for — before, the click set it here and
/// a POST that never landed left the URL claiming a panel the DOM did not have
/// (ADR 0024's open half). Public only because the bar is built in
/// `components/surface.pkl`, which cannot reach a `const local`.
const function selectSurface(surfaceId: String, groupId: String, value: String): slotMod.Slot =
  openSurfaceOnclick(surfaceId, "$" + pendingSignal(groupId) + " = '" + value + "'; ")

/// Explicit "<domain>/<service>" override, e.g. service("lock/lock").
const function service(action: String): TapAction =
  new { onclick = clickSlot(serviceOnclick("\"" + action + "\""), false); busy = true }

/// Toggle whatever the card's entity is, via HA's own domain-dispatching
/// `homeassistant.toggle`. The blunt instrument, and an explicit choice now
/// rather than the default: [[byDomain]] names each domain's own service, and
/// knows which domains have none. Still the right answer for an entity whose
/// domain this library does not know but you do.
const toggle: TapAction = service("homeassistant/toggle")

/// A service call whose service depends on the entity's CURRENT state: `then`
/// while the state equals `whenState`, `otherwise` in every other state. The
/// lock case — `stateService("locked", "lock/unlock", "lock/lock")`.
///
/// The one tap that carries a LIVE expression, so its click slot re-renders on
/// state change like a value slot does. Prefer a plain [[service]] wherever a
/// real `toggle` service exists.
const function stateService(whenState: String, then: String, otherwise: String): TapAction =
  new {
    onclick = clickSlot(
      serviceOnclick(#"$state = "\#(whenState)" ? "\#(then)" : "\#(otherwise)""#),
      true
    )
    busy = true
  }

/// What a tap on `e` should call, decided from its domain at BUILD time — or
/// **null when its domain has no sensible service call**, which is the answer
/// for most of a real instance (sensors, diagnostics, `update`, anything whose
/// value must be chosen rather than toggled).
///
/// That null is the point: a card turns it into a more-info tap rather than
/// rendering a pointer cursor over a service that does not exist. The table is
/// `hass/actions.pkl`; override any single card with `.tap(...)`.
const function byDomain(e: hass.Entity): TapAction? =
  let (action = hassActions.forDomain(e.domain))
    if (action == null) null
    else if (action is hassActions.Call) service(action.action)
    else
      let (byState = action as hassActions.CallByState)
        stateService(byState.whenState, byState.then, byState.otherwise)

// The value-carrying action route: the service call gets `service_data`, with
// the value riding in the URL PATH (the same route the slider's template posts
// to). A path segment, so a value containing a space is percent-encoded — the
// one character that actually shows up in HA's own vocabularies (effect names
// like "Color loop", preset modes).
const local function serviceValueOnclick(action: String, key: String, value: String): String =
  #""@post('sse/action/" & $dashboardSlug & "/"# + action + #"/" & $entity_id & "/"# + key + "/"
    + value.replaceAll(" ", "%20") + #"', "# + noSignals + #")""#

/// A service call carrying ONE static value: `serviceValue("light/turn_on",
/// "effect", "colorloop")`. The entity comes from the card the tap sits on, so
/// the same tap works on any card that has one.
function serviceValue(action: String, key: String, value: String): TapAction =
  new { onclick = clickSlot(serviceValueOnclick(action, key, value), false); busy = true }

/// Go to dashboard `slug` — an ordinary document load, so the browser owns the
/// history entry (ADR 0002). The `href` is RELATIVE and resolves against
/// <base href> (works directly and behind ingress); the `onclick` twin is for
/// non-anchor cards only and has to build the URL itself, since
/// `location.assign` does not consult <base href>.
function navigate(slug: String): TapAction = new {
  href = "d/\(slug)"
  onclick = "window.location.assign(new URL('d/\(slug)',document.baseURI))"
}

/// Dismiss the (single, at-a-time) open popup — `POST
/// /sse/popup/<slug>/close`. Drop a button carrying this inside a popup's
/// content. `ui_popups` — what a refresh and a reconnect restore the dialog
/// from — is cleared by the SWAP, not here: the dialog leaves the DOM and the
/// signal stops claiming it in the same frame, so the two cannot disagree.
function closePopup(): TapAction =
  new {
    onclick = clickSlot(#""@post('sse/popup/" & $dashboardSlug & "/close')""#, false)
  }

/// Open the surface REGISTERED under `surfaceId` (a top-level `surfaces` entry).
/// A registered popup surface is [[Popup]]-wrapped (the `<dialog>`); the backend
/// renders it bare into the `#popups` mount.
// No client-side `$ui_popups` assignment, unlike a tab's PENDING one: nothing
// on the page displays a popup selection — the dialog itself is what the swap
// patches in — so a pending value here would be a signal nobody reads. The
// committed `ui_popups` still arrives, which is what a refresh restores from.
function openPopup(surfaceId: String): TapAction =
  new {
    onclick = openSurfaceOnclick(surfaceId, "")
  }

/// Open an INLINE popup: `content` is wrapped in a [[Popup]] dialog and stashed
/// under this node's `inlineSurfaces["self"]`; the onclick references the future
/// surface id (`<NODE_ID>_self`) the hoist mints and splices. (Pkl can't
/// union-dispatch string|node in one function like jsonnet's `openPopup`, so the
/// registered and inline forms are two named functions — a deliberate API
/// deviation, see ADR 0006.)
// The parameter is `body`, NOT `content`: a bare `content` inside the nested
// `new SurfaceDef { content = new Popup { children { <here> } } }` amend would
// bind to SurfaceDef's own `content` member (a self-reference → stack overflow),
// per the Pkl amend-scoping gotcha.
//
// Typed `LayoutNode`, not `Node`: `Popup.children` (inherited from [[Node]])
// is itself `Listing<LayoutNode>` so a container can hold either a component
// or a candidate set (`q...build()`'s `SetNode`) — this parameter must accept
// the same widened type or it rejects exactly the case `children` was widened
// for.
function openPopupInline(body: nodes.LayoutNode): TapAction = new {
  onclick = openSurfaceOnclick("\(nodes.NODE_ID)_self", "")
  inlineSurfaces = new Mapping {
    ["self"] = new surfaceMod.SurfaceDef { content = new surfaceMod.Popup { children { body } } }
  }
}
