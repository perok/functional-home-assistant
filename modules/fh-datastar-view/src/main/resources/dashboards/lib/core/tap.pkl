/// Taps — what a click does, as the Datastar expression a card splices into
/// `data-on:click`. The author's verbs are `c.tap` (`components/tap.pkl`); this
/// is the kit a component builds on.
module core.tap

import "node.pkl" as nodes
import "slot.pkl" as slotMod
import "simple.pkl" as simpleMod
import "surface.pkl" as surfaceMod
import "../hass.pkl"
import "../hass/actions.pkl" as hassActions

/// HA expands an area or a floor when the call runs, so a light added to the
/// room later is included.
typealias Target = hass.Entity|hass.Area|hass.Floor

/// A [[Call]] or a [[Click]], rendered in one place ([[tapRoute]]).
///
/// A card that can be an anchor must prefer `href` when set: that is what gives
/// a navigate real link behaviour (middle-click, open-in-new-tab, no JS).
abstract class TapAction {
  href: String? = null
  /// The dashboard a navigate goes to, so a card can mark the one already open
  /// ([[currentSlots]]).
  hidden page: String? = null
  /// An inline popup's content; the card copies it onto the node for the hoist.
  inlineSurfaces: Mapping<String, surfaceMod.SurfaceDef>? = null
  /// While this tap's POST is in flight a second click is a no-op (ADR 0019).
  /// Set by the KIND of tap, never by a card: a navigate is a document load and
  /// the popup close sends no request.
  busy: Boolean = false
  /// Whether the in-flight window also dims and spins. `false` keeps the
  /// re-click guard, for a control whose action answers too fast for a flicker
  /// to mean anything.
  busyVisual: Boolean = true
}

class Call extends TapAction {
  /// `"<domain>/<service>"`: a literal when known at build time, a handler
  /// signal when the target's live state picks it ([[stateService]]). Only the
  /// service, not the URL: only a card's template can name the slug and node id
  /// ([[serviceClick]]).
  service: slotMod.Slot|String
  /// Named by the tap, never borrowed from the card, so a card may show one
  /// entity and act on another, or on a room.
  target: Target
  /// The one value a call carries, as the route's trailing `/<key>/<value>`. A
  /// key with no value is a commit whose value the card supplies (the slider).
  dataKey: String? = null
  dataValue: String? = null
  /// `call("light/turn_on", l).with("effect", "colorloop")`.
  ///
  /// A space breaks the path segment, and a `'` would close the JS string the
  /// URL sits in: Mustache's `&#39;` is decoded back before the expression is
  /// parsed.
  function with(key: String, value: String): Call =
    let (self = this)
      (self) {
        dataKey = key
        dataValue = value.replaceAll(" ", "%20").replaceAll("'", "%27")
      }
  /// States of the target in which this call is meaningless, so every card that
  /// sends it refuses the press. On the call rather than the card, so a second
  /// card sending the same call cannot go unguarded. Not the busy guard: this
  /// follows the ENTITY, including a lock someone moved from its keypad.
  disabledWhile: Listing<String> = new {}
  busy = true
}

/// A tap that is its own click expression. `onclick` is what a card whose root
/// cannot be an `<a>` places for a navigate.
open class Click extends TapAction {
  onclick: slotMod.Slot|String
}

/// Guarded like a [[Call]]: the open answers only once the surface's queries
/// have resolved, and a chart's history fetch is a wait worth showing (#412).
class OpenSurface extends Click {
  busy = true
}

// URLs are relative to the page's <base href>, which is the ingress prefix
// behind the HA proxy. Every route names the dashboard slug so the server can
// admit only calls that dashboard declares (ADR 0023): `{{dashboardSlug}}` in a
// template, `dashboard_slug` in a transform, whose output is inserted raw.
//
// A call reads nothing from the request body, so it sends no signals.
const noSignals = #"{filterSignals:{exclude:'.*'}}"#

// What a card writes for a guarded tap:
//
//   data-on:click="\(tapMod.guardClick){{{onclick}}}"
//   \(tapMod.guard){{#busyVisual}}{{#glyph}} \(tapMod.busyShapeClass){{/glyph}}{{/busyVisual}}
//
// [[guard]] and [[guardClick]] carry their own `{{#busy}}` sections, so a card
// places them unconditionally. Their signal names must match what the server
// patches on a refusal (ADR 0024), which a third-party card should not need to
// know. The spinner is the card's to place: only its template knows which
// element hosts the glyph.

// ---- refusal ---------------------------------------------------------------
//
// A node refuses while its tap does (`tapDisabled`) or its card says so
// (`disabled`). Everything below reads the two through [[refused]].

/// The refusal as one JS expression. `||` binds tighter than `?:`, so a guard
/// needs no parentheses round it.
const refused: String =
  slotMod.ifSlot("tapDisabled") + slotMod.slotRead("tapDisabled") + slotMod.endIfSlot("tapDisabled")
    + slotMod.ifSlot("tapDisabled") + slotMod.ifSlot("disabled") + " || "
    + slotMod.endIfSlot("disabled") + slotMod.endIfSlot("tapDisabled")
    + slotMod.ifSlot("disabled") + slotMod.slotRead("disabled") + slotMod.endIfSlot("disabled")

/// `s`, when the node carries either refusal slot.
const function whenRefusable(s: String): String =
  slotMod.ifSlot("tapDisabled") + s + slotMod.endIfSlot("tapDisabled")
    + slotMod.ifNoSlot("tapDisabled") + slotMod.ifSlot("disabled") + s
    + slotMod.endIfSlot("disabled") + slotMod.endIfNoSlot("tapDisabled")

/// `s` while the node refuses now. Document form only: the patch form withholds
/// the values, and the binding beside it keeps the state live.
const function refusedNow(s: String): String =
  "{{#tapDisabled}}" + s + "{{/tapDisabled}}{{^tapDisabled}}{{#disabled}}" + s
    + "{{/disabled}}{{/tapDisabled}}"

/// `fh-disabled` + `fh-loading` while `sig` is truthy, and `fh-disabled` also
/// while the node refuses — in ONE binding, because a second binding of the
/// same class on an element is dropped.
const function inFlightOrRefused(sig: String): String =
  #"data-class:fh-disabled="$\#(sig)"# + whenRefusable(" || " + refused)
    + #"" data-class:fh-loading="$\#(sig)""#

/// The disabled look alone, for `busyVisual = false`.
const refusedClass: String =
  whenRefusable(#" data-class:fh-disabled=""# + refused + "\"")

/// The refusal as a real `disabled`, for a form control, so the browser also
/// drops it from the tab order.
const refusedAttr: String =
  refusedNow(" disabled") + whenRefusable(#" data-attr:disabled=""# + refused + "\"")

/// The prefix that makes a handler a no-op while the node refuses. This is what
/// stops the post on a host that cannot be `disabled` (a tile's `<article>`);
/// it stays on hosts that can, so no card can be the one that forgot it.
const refusalGuard: String = whenRefusable(refused + " ? '' : ")

const local function guardOn(sig: String): String = "$" + sig + " ? '' : "

// The VALUE form, never the keyed `data-indicator:_{{id}}__busy`: the bundle
// splits an attribute key on `__`, its modifier separator.
const local function indicatorOn(sig: String): String =
  #"data-indicator="\#(sig)""#

/// A tap's own busy signal, and the slider's separate commit one
/// ([[busyGuardChange]]).
const busySig: String = "_{{id}}__busy"
const busyChangeSig: String = "_{{id}}__busy_change"

/// Why the last press on this control failed, as text; `''` when it did not.
/// `data-indicator` clears on either outcome, so without it a refusal looks
/// like a success once the global toast is gone. The server sets it on a
/// refused call (keyed on `?node={{id}}`); [[failedOn]] covers a non-200, whose
/// body the bundle never parses.
const errorSig: String = "_{{id}}__error"

/// Tells the server which selection group a surface open answers, so a refusal
/// can end its pending ask. A query parameter, because the value route already
/// ends in positional segments.
const local function groupQuery(group: String): String = "?group=\(group)'"

/// Sets [[errorSig]] when this element's fetch fails and clears it when this
/// element starts another, so a retry needs no separate clear.
///
/// The bundle dispatches `datastar-fetch` on `document` for EVERY fetch, the
/// SSE stream included, hence the `evt.detail.el === el` filter. `finished` is
/// not a clear: it also fires after `error`.
const local function failedOn(sig: String): String =
  #"data-on:datastar-fetch__document="evt.detail.el === el && (evt.detail.type === 'error' ? ($\#(sig) = 'Command failed (' + evt.detail.argsRaw.status + ')') : evt.detail.type === 'started' && ($\#(sig) = ''))""#

/// `fh-error` is the base stylesheet's to paint (`core/css.pkl`).
const local function failedClass(sig: String): String =
  #"data-class:fh-error="$\#(sig)""#

/// The whole in-flight and error contract for one control, as one splice. The
/// leading spaces sit inside the sections, so an unguarded tap emits nothing.
const guard: String = guardMechanism + guardLook

/// Must sit on the element that ISSUES the action: [[failedOn]] filters on it,
/// and the server answers the `data-fh-node` it sent.
const guardMechanism: String =
  "{{#busy}} " + indicatorOn(busySig) + " " + failedOn(errorSig)
    + #" data-fh-node="{{id}}""# + "{{/busy}}"

/// Separate from [[guardMechanism]] for a card whose acting element is not its
/// visible one: a BeerCSS switch hides its `<input>`, so an outline there is
/// one nobody sees.
const guardLook: String =
  "{{#busyVisual}} " + inFlightOrRefused(busySig) + " " + failedClass(errorSig)
    + "{{/busyVisual}}{{^busyVisual}}" + refusedClass + "{{/busyVisual}}"

/// Puts an optimistic control back where the server last said it was, when an
/// action on this node is refused: a refusal sends no state frame to correct
/// it. `restore` is the assignment that reads the server-owned signal back.
const function restoreOnRefusal(restore: String): String =
  #"data-on-signal-patch-filter="{include:/^\#(errorSig)$/}" data-on-signal-patch="$\#(errorSig) && (\#(restore))""#

/// [[guard]]'s half for INSIDE the click expression. Spliced into the template,
/// not the expression: a tap's expression is a transform's output, inserted
/// raw, so a `{{id}}` in it would never be filled.
const guardClick: String = "{{#busy}}" + guardOn(busySig) + "{{/busy}}"

/// How long an action may take before the spinner says it is taking a while.
const busyDelayMs: Int = 300

/// A copy of `sig` that follows it [[busyDelayMs]] late, so a fast action never
/// shows a spinner. A derived signal rather than `animation-delay`, because
/// BeerCSS's `shape` class also changes the element's box, which no delay can
/// hold back — and it must be absent at rest, since `.shape>i{filter:invert(1)}`
/// is unconditional.
///
/// The `-filter` keeps every other signal patch from arming a timer.
/// `__ifmissing`, because a plain seed would reset the copy on every morph the
/// action itself provokes.
const local function slowCopy(sig: String): String = #"""
  data-signals__ifmissing="{\#(sig)_slow:false}" data-on-signal-patch-filter="{include:/^\#(sig)$/}" data-on-signal-patch__delay.\#(busyDelayMs)ms="$\#(sig)_slow = $\#(sig)"
  """#

// A theme swaps the class through `Theme.classes`.
const local function busySpinner(sig: String): String =
  slowCopy(sig) + #" data-class:fh-busy-spin="$\#(sig)_slow""#

/// The spinner splice, for an element hosting an `i.mdi` glyph.
const busyShapeClass: String = busySpinner("_{{id}}__busy")

/// [[busyShapeClass]] for a host that holds text (a tab): a theme's spinner
/// may be a mask around an icon, so this draws `fh-busy-after` instead.
const busyTextClass: String =
  slowCopy("_{{id}}__busy") + #" data-class:fh-busy-after="$_{{id}}__busy_slow""#

/// The slider's value-commit guard, on its own signal: a slider may also have a
/// guarded power button, and one element's `finished` must not clear the
/// other's busy (ADR 0019).
///
///   <input … \(tapMod.busyAttrsChange)
///     data-on:change="\(tapMod.busyGuardChange)@post(…)" />
///   <div class="slider max" … \(tapMod.busyClassChange)>
///
/// Disabling the input while busy is safe because busy starts on RELEASE, never
/// mid-drag.
const busyGuardChange: String = guardOn(busyChangeSig)
// The error stays on [[errorSig]]: a refusal is a fact about the node.
const busyAttrsChange: String =
  indicatorOn(busyChangeSig) + refusedNow(" disabled")
    + #" data-attr:disabled="$\#(busyChangeSig)"# + whenRefusable(" || " + refused) + "\" "
    + failedOn(errorSig) + #" data-fh-node="{{id}}""#
const busyClassChange: String =
  inFlightOrRefused(busyChangeSig) + " " + failedClass(errorSig)
/// For the slider's head badge, which spins for the whole commit.
const busyShapeClassChange: String = busySpinner("_{{id}}__busy_change")

/// A service call, assembled in the card's template from [[routeSlots]]: the
/// one place that can name `{{dashboardSlug}}`, `{{id}}` and the slot read.
///
/// `service__read` is a quoted literal for a build-time service and a signal
/// for a state-picked one, so the template is the same either way, and a lock
/// tile's bytes stay constant across lock/unlock (ADR 0017).
const serviceClick: String =
  #"@post('sse/call/{{dashboardSlug}}/' + "# + slotMod.slotRead("service") +
    #" + '/{{targetKind}}/{{targetId}}"# +
    slotMod.ifSlot("dataKey") + "/{{dataKey}}/{{dataValue}}" +
    slotMod.endIfSlot("dataKey") +
    #"?node={{id}}', "# + noSignals + ")"

/// What every card with a tap places: `data-on:click="\(guardClick)\(click)"`.
/// The arm is picked by whether [[tapSlots]] emitted a `service` slot. Service
/// URLs stay in Pkl because nothing in Scala knows an HA domain (ADR 0016).
const click: String =
  refusalGuard +
    slotMod.ifSlot("service") + serviceClick + slotMod.endIfSlot("service") +
    slotMod.ifNoSlot("service") + "{{{onclick}}}" + slotMod.endIfNoSlot("service")

/// Every state in which this tap must refuse the press: the call's own
/// [[Call.disabledWhile]], plus `unavailable`, which HA rejects in every
/// domain. Only for an entity target — an area has no state — and never for a
/// click: more-info on a dead entity is where its reason is.
const function refusedStates(t: TapAction, target: Target?): List<String> =
  if (target is hass.Entity)
    ((t as Call).disabledWhile.toList() + List("unavailable")).distinct
  else List()

/// A boolean, because only a real `false` removes a boolean attribute (ADR
/// 0017). Read by expression rather than bound, since how it shows is the
/// host's.
const function tapDisabledSlot(states: List<String>): slotMod.Slot = new {
  transform = simpleMod.stateIn(states.toListing())
  // `unavailable` is one of the arms, so the raw state has to reach the match.
  bypassUnavailable = false
  signal = slotMod.asHandler
}

/// What [[serviceClick]] builds the URL from, and what the server reads back as
/// the call this node declares (`Dashboard.calls`, ADR 0023).
const local function routeSlots(
  action: slotMod.Slot|String,
  target: Target,
  key: String?
): Mapping<String, slotMod.Slot|String> =
  new {
    ["service"] =
      if (action is slotMod.Slot && target is hass.Entity)
        (action as slotMod.Slot) { entityId = target.entity_id }
      else action
    ["targetKind"] =
      if (target is hass.Entity) "entity" else if (target is hass.Area) "area" else "floor"
    ["targetId"] =
      if (target is hass.Entity) target.entity_id
      else if (target is hass.Area) target.area_id
      else (target as hass.Floor).floor_id
    when (key != null) {
      ["dataKey"] = key!!
    }
  }

/// The route slots [[click]] reads, and the refusal with them, so no card can
/// place a route without it. Separate from [[tapSlots]] for a card with no
/// `tappable` section (a [[Button]]'s anchor arm). One node holds one tap's
/// route.
const function tapRoute(t: TapAction): Mapping<String, slotMod.Slot|String> =
  let (target = if (t is Call) t.target else null)
  let (reads = if (target is hass.Entity) target.entity_id else null)
  let (states = refusedStates(t, target))
    new {
      when (t is Call) {
        for (k, v in routeSlots(t.service, t.target, t.dataKey)) {
          [k] = v
        }
        when (t.dataValue != null) {
          ["dataValue"] = t.dataValue!!
        }
      } else {
        ["onclick"] = (t as Click).onclick
      }
      when (!states.isEmpty) {
        ["tapDisabled"] = (tapDisabledSlot(states)) { entityId = reads }
      }
    }

/// Every slot a tap contributes, for a card to fold in with one generator:
///
/// ```
/// slots {
///   for (k, v in tapMod.tapSlots(tapAction)) { [k] = v }
/// }
/// ```
const function tapSlots(t: TapAction?): Mapping<String, slotMod.Slot|String> =
  new {
    when (t != null) {
      ["tappable"] = "1"
      for (k, v in tapRoute(t!!)) {
        [k] = v
      }
      for (k, v in guardSlots(t!!)) {
        [k] = v
      }
    }
  }

/// The slots [[guard]] and [[guardClick]] open, for a card that takes
/// [[tapRoute]] rather than [[tapSlots]].
const function guardSlots(t: TapAction): Mapping<String, String> =
  new {
    when (t.busy) {
      ["busy"] = "1"
    }
    when (t.busy && t.busyVisual) {
      ["busyVisual"] = "1"
    }
  }

// `once`, so the node stays in the renderer's identity cache; it must resolve
// on an unavailable entity, which is exactly the one you want to click.
const local function clickSlot(transformExpr: String): slotMod.Slot = new {
  transform = transformExpr
  reads = "once"
  bypassUnavailable = false
}

// A transform rather than a constant, because only a transform can read
// `dashboard_slug`. `head` is the pending assignment, run first so the display
// moves on the press; `group` is the selection group a refusal ends
// ([[pendingClear]]), null for a popup.
const local function openSurfaceOnclick(
  surfaceId: String,
  head: String,
  group: String?
): slotMod.Slot =
  clickSlot(
    // `"\""`, not `#"""#`, which would open a multi-line string.
    "\"" + head + #"@post('sse/surface/""# +
      #" + dashboard_slug + "/open/"# + surfaceId +
      (if (group == null) "'" else groupQuery(group)) + #")""#
  )

/// What this client has ASKED a selection group to show; `ui_<groupId>` is
/// what the server says it shows (ADR 0025). Cleared by [[pendingClear]].
const function pendingSignal(groupId: String): String = "_\(groupId)__pending"

/// The pending signal's seed entry, for splicing into a host's existing
/// `data-signals__ifmissing` object (a second attribute of that name is
/// dropped).
const function pendingSeedEntry(groupId: String): String =
  "\(pendingSignal(groupId)): ''"

/// Empties the pending signal once the committed value agrees. Comparing to
/// the committed value, rather than clearing in the frame, is what keeps tap
/// A's response from clearing tap B's pending. `==` is loose: the seed is a
/// number, a committed index a string. The page-wide ends (a dead stream, a
/// non-200) are `Server.PendingSweep`'s.
const function pendingClear(groupId: String): String =
  pendingClearAgainst(groupId, "ui_\(groupId)")

/// [[pendingClear]] against a named committed signal (a node variable's lives
/// under `_var_`).
const function pendingClearAgainst(groupId: String, committed: String): String =
  let (sig = pendingSignal(groupId))
    #"data-effect="$\#(sig) !== '' && $\#(committed) == $\#(sig) && ($\#(sig) = '')""#

/// The pending value while one is outstanding, else the committed one.
const function pendingOrCommitted(groupId: String): String =
  pendingOrCommittedOf(groupId, "ui_\(groupId)")

const function pendingOrCommittedOf(groupId: String, committed: String): String =
  "($" + pendingSignal(groupId) + " || $" + committed + ")"

/// A tab bar's open-a-member click. It sets only the pending signal; the
/// committed `ui_<groupId>` is the server's to write. Public because the bar is
/// built in `components/base/surface.pkl`.
const function selectSurface(surfaceId: String, groupId: String, value: String): OpenSurface =
  new {
    onclick = openSurfaceOnclick(surfaceId, "$" + pendingSignal(groupId) + " = '" + value + "'; ", groupId)
  }

/// `call("scene/turn_on", dump.entities.kveld)`. An area or floor target
/// reaches entities the dashboard never names, so the server allows only the
/// exact (service, target) pairs the dashboard declares (ADR 0023).
const function call(action: String, on: Target): Call = new { service = action; target = on }

/// `e`'s domain's own service where `hass/actions.pkl` names one, else HA's
/// `homeassistant/toggle`.
const function toggle(e: hass.Entity): Call =
  byDomain(e) ?? call("homeassistant/toggle", e)

/// A call whose service the target's CURRENT state picks (a lock: unlock while
/// locked, else lock). The service rides a handler signal, so the card's bytes
/// stay constant across state changes; it arrives in the same frame as the
/// visible state, so a click acts on what the user is looking at (ADR 0016).
const local function stateService(e: hass.Entity, byState: hassActions.CallByState): Call =
  new {
    service = new slotMod.Slot {
      transform = simpleMod.enumOf(byState.whenState, byState.then, byState.otherwise)
      bypassUnavailable = false
      signal = slotMod.asHandler
    }
    target = e
    disabledWhile = byState.disabledWhile
  }

/// What a tap on `e` calls, from its domain at build time — or null when the
/// domain has no sensible call, which a card turns into a more-info tap.
const function byDomain(e: hass.Entity): Call? =
  let (action = hassActions.forDomain(e.domain))
    if (action == null) null
    else if (action is hassActions.Call) call(action.action, e)
    else stateService(e, action as hassActions.CallByState)

/// Go to dashboard `slug`, as a document load (ADR 0002). The `onclick` twin
/// builds the URL itself because `location.assign` ignores <base href>.
function navigate(slug: String): Click = new {
  href = "d/\(slug)"
  page = slug
  onclick = "window.location.assign(new URL('d/\(slug)',document.baseURI))"
}

/// `current`, true on the dashboard a navigate goes to, for a card's anchor to
/// place `fh-current-dashboard` and `aria-current="page"` under. Read once per renderer,
/// which is one dashboard, so it costs no signal; the build cannot answer it,
/// since a module does not know its slug.
const function currentSlots(t: TapAction): Mapping<String, slotMod.Slot> = new {
  when (t.page != null) {
    ["current"] = new slotMod.Slot {
      transform = "dashboard_slug == '" + t.page!!.replaceAll("\\", "\\\\").replaceAll("'", "\\'") + "'"
      reads = "once"
      type = "bool"
      bypassUnavailable = false
    }
  }
}

/// What an anchor places for [[currentSlots]]: the class, then the attribute.
const currentClass: String = "{{#current}} fh-current-dashboard{{/current}}"
const currentAttr: String = #"{{#current}} aria-current="page"{{/current}}"#

/// Dismiss the open popup, as its ✕ does.
function closePopup(): Click =
  new {
    onclick = surfaceMod.closeExpr
  }

/// Open the popup registered under `surfaceId` in the entry's `surfaces`.
// No pending assignment: nothing on the page displays a popup selection.
function openPopup(surfaceId: String): OpenSurface =
  new {
    onclick = openSurfaceOnclick(surfaceId, "", null)
  }

/// Open `body` in a popup of this node's own; the hoist mints its id
/// (`<NODE_ID>_self`). A separate function from [[openPopup]] because Pkl
/// cannot dispatch on String|Node (ADR 0006).
function openPopupInline(body: nodes.LayoutNode): OpenSurface = new {
  onclick = openSurfaceOnclick("\(nodes.NODE_ID)_self", "", null)
  inlineSurfaces = new Mapping {
    ["self"] = new surfaceMod.SurfaceDef { content = new surfaceMod.Popup { children { body } } }
  }
}
