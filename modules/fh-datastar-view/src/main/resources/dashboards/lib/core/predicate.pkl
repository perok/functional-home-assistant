/// The conditions and candidate-set wire that `query.pkl` builds and the
/// backend decodes. A condition is a bool `fh.view.model.ValueExpr` (its
/// `source` and `steps`) of simple steps: each class here keeps what its
/// builder names hidden and writes that wire. Wherever one is taken, any bool
/// value expression is too, a reading or CEL included (ADR 0035). Here rather than in
/// `query.pkl` so the query language and the card library share the wire
/// without depending on each other. There are no free constructors, so a term
/// always carries a binding.
module core.predicate

import "node.pkl" as nodes
import "simple.pkl" as simpleMod
import "slot.pkl" as slotMod

typealias PredicateOp = simpleMod.CompareOp

/// A condition: a [[slotMod.Expr]] of a bool, of simple steps (ADR
/// 0028). It is not a [[slotMod.Reading]], so a slot's fields (`entityId`,
/// `default`, …) are refused rather than ignored. The combinators are methods,
/// since the operators `&&`/`||`/`!` do not cross the seam.
abstract class Predicate extends slotMod.Expr {
  function and(other: Predicate): PAnd = let (l = this) new PAnd { items { l; other } }
  function or(other: Predicate): POr = let (l = this) new POr { items { l; other } }
  function not(): PNot = let (l = this) new PNot { item = l }
}

/// `part <op> value`: the state, or the attribute `part` names. `value` rides
/// as JSON, so a threshold stays a number.
class Cmp extends Predicate {
  hidden part: simpleMod.Attr? = null
  hidden op: PredicateOp
  hidden value: Any
  /// Absent means the entity this is about: a card's subject, or the member a
  /// guard is decided for. Present names another, which reaches the reverse
  /// index through the reading's entities, or the node is never woken by it.
  hidden entity: String? = null
  source = let (c = this) new slotMod.EntityRead { of = c.entity; part = c.part }
  steps = let (c = this) new Listing { new simpleMod.CompareStep { op = c.op; to = c.value } }
}

/// A static candidate list and which of it is present (`fh.view.model.Value.Present`):
/// a candidate with no guard in `when`, and one whose guard holds, an unnamed
/// read in it reading that candidate. A [[Count]] counts them.
open class Tally extends slotMod.Value {
  kind: "Present" = "Present"
  candidates: Listing<String>
  `when`: Mapping<String, slotMod.Expr> = new {}
}

/// The ids of a [[Tally]]'s present candidates, uncounted: a named input CEL
/// reads as a `list(string)`.
class PresentList extends Tally

/// How many of a static candidate list are present, against a number: `any`
/// is `> 0`, `none` is `== 0`, `all` is `== length`. `when` guards per
/// candidate, since residuals diverge across one set; a candidate absent from
/// it is unconditionally present.
class Count extends Predicate {
  hidden candidates: Listing<String>
  hidden `when`: Mapping<String, slotMod.Expr> = new {}
  hidden op: PredicateOp
  hidden value: Any
  source = let (c = this) new Tally { candidates = c.candidates; `when` = c.`when` }
  steps =
    let (c = this)
      new Listing {
        new simpleMod.CountStep {}
        new simpleMod.CompareStep { op = c.op; to = c.value }
      }
}

/// The first of a list of ids under `orderBy`, ties to list order
/// (`fh.view.model.Step.First`).
class FirstStep extends simpleMod.Step {
  kind: "First" = "First"
  orderBy: Listing<SortTerm> = new {}
}

/// Whether [[entity]] is the first present candidate under [[orderBy]]: the
/// scene activated last, in a row of scenes. `candidates` are in the build's
/// order, which breaks ties; `when` guards as for [[Count]].
class First extends Predicate {
  hidden candidates: Listing<String>
  hidden `when`: Mapping<String, slotMod.Expr> = new {}
  hidden orderBy: Listing<SortTerm> = new {}
  hidden entity: String
  source = let (c = this) new Tally { candidates = c.candidates; `when` = c.`when` }
  steps =
    let (c = this)
      new Listing {
        new FirstStep { orderBy = c.orderBy }
        new simpleMod.CompareStep { op = "eq"; to = c.entity }
      }
}

/// At least two items: [[alwaysHolds]] is the empty one.
class PAnd extends Predicate {
  hidden items: Listing<slotMod.Expr>
  source = let (p = this) new slotMod.ListRead { items = p.items }
  steps { new simpleMod.AllOfStep {} }
}

/// At least two items: [[neverHolds]] is the empty one.
class POr extends Predicate {
  hidden items: Listing<slotMod.Expr>
  source = let (p = this) new slotMod.ListRead { items = p.items }
  steps { new simpleMod.AnyOfStep {} }
}

class PNot extends Predicate {
  hidden item: slotMod.Expr
  source = item.source
  steps = let (p = this) new Listing { ...p.item.steps; new simpleMod.NotStep {} }
}

/// A condition the build settled.
class PConst extends Predicate {
  hidden holds: Boolean
  source = holds
}

// ---- candidate sets (ADR 0003) ----

/// "If `when` holds, render `node`." The node is complete, so a clause cannot
/// be wrong about which member it belongs to. `when = null` is unconditional.
class SetClause {
  `when`: slotMod.Expr? = null
  node: nodes.LayoutNode
}

/// The first clause whose guard holds decides; falling off the end means not
/// rendered, which is how "only while on" is written.
class SetMember {
  clauses: Listing<SetClause>
}

/// A set over a candidate list known at build time; the runtime decides
/// presence and order, never membership.
class SetNode extends nodes.LayoutNode {
  kind: "SetNode" = "SetNode"
  /// In render order, already sorted when the ordering folded to registry facts.
  candidates: Listing<String>
  /// Most significant first; empty when the ordering folded away.
  orderBy: Listing<SortTerm> = new {}
  /// At most this many present members, after ordering. A cut member is absent
  /// from the DOM, not hidden in it.
  limit: Int? = null
  members: Mapping<String, SetMember>
}

/// One ordering position, read per member: a property's value
/// ([[propertyKey]]), or whether a condition holds, true first under `asc`. A
/// registry key never reaches it: it folds into the candidate order.
class SortTerm {
  by: slotMod.Expr
  dir: "asc"|"desc" = "asc"
}

/// The member's state, or the attribute `attr` names.
const function propertyKey(attr: simpleMod.Attr?): slotMod.Reading =
  new slotMod.Reading { source = new slotMod.EntityRead { part = attr } }

/// Vacuously true, and reads nothing: [[iff]] of a condition the build settled
/// as true.
const alwaysHolds: PConst = new PConst { holds = true }

/// Never holds: [[iff]] of a settled false.
const neverHolds: PConst = new PConst { holds = false }
