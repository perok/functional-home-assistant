/// The predicate and candidate-set wire AST that `query.pkl` builds and the
/// backend decodes. Here rather than in `query.pkl` so the query language and
/// the card library share the wire without depending on each other. There are
/// no free constructors, so a term always carries a binding.
module core.predicate

import "node.pkl" as nodes

/// The backend's `Op` decoder accepts exactly these.
typealias PredicateOp = "eq"|"ne"|"lt"|"lte"|"gt"|"gte"

/// `kind` is the wire discriminator. The combinators are methods, since the
/// operators `&&`/`||`/`!` do not cross the seam.
abstract class Predicate {
  kind: String
  function and(other: Predicate): PAnd = let (l = this) new PAnd { items { l; other } }
  function or(other: Predicate): POr = let (l = this) new POr { items { l; other } }
  function not(): PNot = let (l = this) new PNot { item = l }
}

/// `property <op> value`, where `property` is `"domain"`, `"state"`,
/// `"entity_id"` or `"attr:<name>"`. `value` rides as JSON, so a threshold
/// stays a number.
class Cmp extends Predicate {
  kind: "cmp" = "cmp"
  property: String
  op: PredicateOp
  value: Any
  /// Absent means the subject. Present names another entity, which reaches
  /// the reverse index through `SetNode.liveEntities` — or the node is never
  /// woken by it.
  entity: String? = null
}

/// A static candidate list and which of it is present: a [[Count]] before it
/// is compared.
open class Tally {
  candidates: Listing<String>
  `when`: Mapping<String, Predicate> = new {}
}

/// How many of a static candidate list are present, against a number: `any`
/// is `> 0`, `none` is `== 0`, `all` is `== length`. `when` guards per
/// candidate, since residuals diverge across one set; a candidate absent from
/// it is unconditionally present.
class Count extends Predicate {
  kind: "count" = "count"
  candidates: Listing<String>
  `when`: Mapping<String, Predicate> = new {}
  op: PredicateOp
  value: Any
}

class PAnd extends Predicate {
  kind: "and" = "and"
  items: Listing<Predicate>
}

class POr extends Predicate {
  kind: "or" = "or"
  items: Listing<Predicate>
}

class PNot extends Predicate {
  kind: "not" = "not"
  item: Predicate
}

// ---- candidate sets (ADR 0003) ----

/// "If `when` holds, render `node`." The node is complete, so a clause cannot
/// be wrong about which member it belongs to. `when = null` is unconditional.
class SetClause {
  `when`: Predicate? = null
  node: nodes.LayoutNode
}

/// The first clause whose guard holds decides; falling off the end means not
/// rendered, which is how "only while on" is written.
class SetMember {
  clauses: Listing<SetClause>
}

/// A set over a candidate list known at build time; the runtime decides
/// presence and order, never membership.
class SetNode extends nodes.LayoutNode {
  kind: "set" = "set"
  /// In render order, already sorted when the ordering folded to registry facts.
  candidates: Listing<String>
  /// Most significant first; empty when the ordering folded away.
  orderBy: Listing<SortTerm> = new {}
  /// At most this many present members, after ordering. A cut member is absent
  /// from the DOM, not hidden in it.
  limit: Int? = null
  members: Mapping<String, SetMember>
}

/// One ordering position: a property's value ([[SortProp]]), or whether a
/// predicate holds ([[SortHolds]], true first under `asc`).
class SortTerm {
  by: SortKey
  dir: "asc"|"desc" = "asc"
}

abstract class SortKey {
  kind: String
}

class SortProp extends SortKey {
  kind: "prop" = "prop"
  /// `state` or `attr:<name>`, never `reg:`: a registry key folds into the
  /// candidate order.
  property: String
}

class SortHolds extends SortKey {
  kind: "holds" = "holds"
  predicate: Predicate
}

/// An empty conjunction: vacuously true, and reads nothing. The `else` branch's
/// condition, and [[iff]] of a condition the build settled as true.
const alwaysHolds: PAnd = new PAnd { items = new Listing {} }

/// An empty disjunction, which never holds: [[iff]] of a settled false.
const neverHolds: POr = new POr { items = new Listing {} }
