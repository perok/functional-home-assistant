/// The containers — grid, row, column: the boxes cards are composed into.
/// [[Grid]] is the default top-level container; how one child sits is the
/// `columns(n)`/`fullWidth()`/`hug()`/`grow()`/`stick(edge)` builders on
/// `core/node.pkl`'s nodes.
module layout

import "core/node.pkl" as nodes

/// A classed `<div>` holding its children, plus an optional author class. Pure
/// structure: nothing fills a box from outside.
abstract class Box extends nodes.Node {
  /// An extra class on the box (`class` is reserved in Pkl).
  hidden cssClass: String? = null
  /// The box's own classes, after [[cssClass]] ([[Grid]]'s `fh-start`).
  hidden ownClasses: Listing<String> = new {}
  slots {
    when (cssClass != null || !ownClasses.isEmpty) {
      ["class"] = new Listing<String> {
        when (cssClass != null) { cssClass!! }
        ...ownClasses
      }.toList().join(" ")
    }
  }
}

/// Where a box's children sit along its own direction when they do not fill
/// it: a row's hugging pills, a column taller than its cards.
typealias Justify = "start"|"center"|"end"

const local function boxDef(cls: String): nodes.CardDef = new {
  regions = new Mapping { [nodes.defaultRegion] = new nodes.Region {} }
  template = #"<div class="\#(cls){{#class}} {{class}}{{/class}}">{{{children}}}</div>"#
}

class Row extends Box {
  card = "fhrow"
  cardDef = boxDef("fh-row")
  hidden justify: Justify = "start"
  hidden wraps: Boolean = false
  ownClasses {
    when (justify != "start") { "fh-justify-\(justify)" }
    when (wraps) { "fh-wrap" }
  }
  function cssClass(cls: String): Row = let (self = this) (self) { cssClass = cls }
  /// `"center"` centres a row of pills; each wrapped line is placed alike.
  function justify(j: Justify): Row = let (self = this) (self) { justify = j }
  /// Children keep their own width and wrap onto a new line when the row is
  /// full, rather than all shrinking to share one line.
  function wrap(): Row = let (self = this) (self) { wraps = true }
}

/// `(c.row) { children { ... } }`. The parens are required around any amend
/// parent that is not a `new`, and a typed body takes only properties, hence
/// `children`.
hidden row: Row = new Row {}

class Column extends Box {
  card = "fhcol"
  cardDef = boxDef("fh-col")
  hidden justify: Justify = "start"
  hidden fillsScreen: Boolean = false
  ownClasses {
    when (justify != "start") { "fh-justify-\(justify)" }
    when (fillsScreen) { "fh-fill-screen" }
  }
  function cssClass(cls: String): Column = let (self = this) (self) { cssClass = cls }
  /// Where the cards sit in a column taller than they are.
  function justify(j: Justify): Column = let (self = this) (self) { justify = j }
  /// At least as tall as the screen, for a dashboard's root column: a
  /// `.grow()` body keeps a footer at the bottom of a short page.
  function fillScreen(): Column = let (self = this) (self) { fillsScreen = true }
}
/// `(c.column) { children { ... } }`.
hidden column: Column = new Column {}

/// Nothing, taking the space its row or column leaves, so it pushes its
/// siblings apart: `(c.row) { children { title; c.spacer; settings } }`. An
/// empty column, so space is no card of its own.
hidden spacer: nodes.LayoutNode = column.grow()

/// The 12-column grid (HA's "sections"): each cell spans `columns(n)` of 12,
/// default 4; `fullWidth()` spans the row. A partial row is centred unless
/// `centered(false)`.
class Grid extends Box {
  card = "fhgrid"
  cardDef = boxDef("fh-grid")
  hidden centered: Boolean = true
  ownClasses {
    when (!centered) { "fh-start" }
  }
  function cssClass(cls: String): Grid = let (self = this) (self) { cssClass = cls }
  /// `false` left-packs a partial row.
  function centered(on: Boolean): Grid = let (self = this) (self) { centered = on }
}
/// `(c.grid) { children { ... } }`.
hidden grid: Grid = new Grid {}
