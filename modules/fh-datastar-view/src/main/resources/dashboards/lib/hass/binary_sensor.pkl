/// HA's `BinarySensorDeviceClass`, vendored from
/// `homeassistant/components/binary_sensor/const.py`
/// (https://developers.home-assistant.io/docs/core/entity/binary-sensor). A
/// snapshot to re-sync, like `hass/sensor.pkl`.
module hass_binary_sensor

/// What `on` means: the whole content of the domain. The polarity cannot be
/// guessed from the name — `door` is `on` when open, `lock` when UNLOCKED — so
/// a card saying "active" for `on` is wrong for about half; see [[ON_MEANS]].
typealias BinarySensorDeviceClass =
  "battery"|"battery_charging"|"co"|"cold"|"connectivity"|"door"|"garage_door"|
  "gas"|"heat"|"light"|"lock"|"moisture"|"motion"|"moving"|"occupancy"|
  "opening"|"plug"|"power"|"presence"|"problem"|"running"|"safety"|"smoke"|
  "sound"|"tamper"|"update"|"vibration"|"window"

/// What `on` reads as, in HA's own wording. A class absent here, or no class
/// at all, leaves `on`/`off` as all a card can honestly say.
const ON_MEANS: Mapping<BinarySensorDeviceClass, String> = new {
  ["battery"] = "low"
  ["battery_charging"] = "charging"
  ["co"] = "detected"
  ["cold"] = "cold"
  ["connectivity"] = "connected"
  ["door"] = "open"
  ["garage_door"] = "open"
  ["gas"] = "detected"
  ["heat"] = "hot"
  ["light"] = "detected"
  ["lock"] = "unlocked"
  ["moisture"] = "wet"
  ["motion"] = "detected"
  ["moving"] = "moving"
  ["occupancy"] = "occupied"
  ["opening"] = "open"
  ["plug"] = "plugged in"
  ["power"] = "detected"
  ["presence"] = "home"
  ["problem"] = "problem"
  ["running"] = "running"
  ["safety"] = "unsafe"
  ["smoke"] = "detected"
  ["sound"] = "detected"
  ["tamper"] = "tampering"
  ["update"] = "available"
  ["vibration"] = "detected"
  ["window"] = "open"
}
