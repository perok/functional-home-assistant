/// HA's `light` domain constants, vendored verbatim from
/// `homeassistant/components/light/const.py`
/// (https://developers.home-assistant.io/docs/core/entity/light): the
/// `ColorMode` enum and the `LightEntityFeature` bits.
///
/// The bits are safe to copy: append-only and never renumbered, since they are
/// persisted in state. Checked against 48 live lights — `EFFECT` agreed with
/// `effect_list` 48/48 and every `supported_features` value decoded with no
/// unknown bits; re-run that when syncing to a newer HA.
module hass_light

/// How a light expresses colour (`supported_color_modes`). `onoff` and
/// `brightness` are each the ONLY mode when present; `white` never is.
typealias ColorMode =
  "unknown"|"onoff"|"brightness"|"color_temp"|"hs"|"xy"|"rgb"|"rgbw"|"rgbww"|"white"

/// The modes that show an actual colour.
const COLOUR_MODES: List<ColorMode> = List("hs", "xy", "rgb", "rgbw", "rgbww")

/// The modes with a settable brightness; `unknown` (not reported yet) is not
/// one.
const DIMMABLE_MODES: List<ColorMode> =
  List("brightness", "color_temp", "hs", "xy", "rgb", "rgbw", "rgbww", "white")

// ---- LightEntityFeature ----
// Bits 1 and 2 are vacant: SUPPORT_BRIGHTNESS and SUPPORT_COLOR_TEMP, removed
// when colour modes replaced them.

/// Named effects, and so an `effect_list`.
const EFFECT: Int = 4

const FLASH: Int = 8

const TRANSITION: Int = 32

/// `hass_light.supports(e.supported_features, hass_light.TRANSITION)`.
const function supports(supportedFeatures: Int, flag: Int): Boolean =
  supportedFeatures.and(flag) != 0
