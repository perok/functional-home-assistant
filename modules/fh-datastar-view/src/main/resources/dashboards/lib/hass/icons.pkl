/// Domains whose glyph follows the STATE, as a [[simpleMod.SimpleMatch]] on the
/// fast tier, one shared display signal per entity (ADR 0017). A domain earns a
/// row when HA draws it differently per state AND the difference is what you
/// look at the tile to learn.
const stateIcons: Mapping<String, Mapping<String, String>> = new {
  // `jammed` gets its own alert glyph: it is the one lock state you want to
  // notice from across the room, and it is not "unlocked".
  ["lock"] = new {
    ["locked"] = "mdi:lock"
    ["unlocked"] = "mdi:lock-open"
    ["open"] = "mdi:lock-open-variant"
    ["opening"] = "mdi:lock-open-variant"
    ["locking"] = "mdi:lock-clock"
    ["unlocking"] = "mdi:lock-clock"
    ["jammed"] = "mdi:lock-alert"
  }
}
