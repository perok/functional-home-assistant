/// The MDI glyph tables Home Assistant's own frontend derives an icon from,
/// vendored — per device_class, per domain, and per STATE.
///
/// Here and not in `core/icon.pkl` for the reason ADR 0015 tiers by AUDIENCE: a
/// component author calls [[core.icon.iconFor]] and never reads a table, while
/// these are HA facts that go stale when HA changes. Everything with that
/// property lives under `hass/`, so re-syncing against a new release is one
/// directory rather than a hunt — the same reason `hass/actions.pkl` carries
/// the date its service list was checked.
///
/// Measured on a real instance (1069 entities): only 24% carry an `icon` at
/// all. HA's frontend derives the rest from domain + device_class + state, and
/// that derivation never crosses the wire — so these are not a nicety, they are
/// what three quarters of the cards render.
///
/// Names are MDI (`mdi:thermometer`) throughout, because that is what HOME
/// ASSISTANT's own icons are: an entity's `icon` attribute is whatever its user
/// or integration set, and translating those into another icon set is a lossy
/// table with no end. The theme loads the MDI stylesheet; see `theme-beer.pkl`
/// for its weight and the build-time SVG inlining that should replace it.
module hass_icons


/// Per device_class, where the domain alone is too coarse — a `temperature`
/// sensor should not look like a `humidity` one. Tried BEFORE [[domainIcons]].
///
/// One table, not one per domain: HA keys these by (domain, device_class) and a
/// few names genuinely differ, but the overlap is small and a single table is
/// the version worth maintaining by hand. Icons that vary with STATE are
/// [[stateIcons]] — a separate table, because they are a different KIND of
/// answer: this one resolves at build time to a literal, that one to a live
/// slot.
const deviceClassIcons: Mapping<String, String> = new {
  ["temperature"] = "mdi:thermometer"
  ["humidity"] = "mdi:water-percent"
  ["pressure"] = "mdi:gauge"
  ["atmospheric_pressure"] = "mdi:thermometer-lines"
  ["battery"] = "mdi:battery"
  ["power"] = "mdi:flash"
  ["energy"] = "mdi:lightning-bolt"
  ["voltage"] = "mdi:sine-wave"
  ["current"] = "mdi:current-ac"
  ["illuminance"] = "mdi:brightness-5"
  ["signal_strength"] = "mdi:wifi"
  ["timestamp"] = "mdi:clock"
  ["duration"] = "mdi:progress-clock"
  ["data_size"] = "mdi:database"
  ["data_rate"] = "mdi:transmission-tower"
  ["carbon_dioxide"] = "mdi:molecule-co2"
  ["pm25"] = "mdi:blur"
  ["pm10"] = "mdi:blur"
  ["water"] = "mdi:water"
  ["gas"] = "mdi:meter-gas"
  ["door"] = "mdi:door-open"
  ["garage_door"] = "mdi:garage-open"
  ["window"] = "mdi:window-open"
  ["opening"] = "mdi:square-outline"
  ["motion"] = "mdi:motion-sensor"
  ["occupancy"] = "mdi:home-account"
  ["presence"] = "mdi:home"
  ["moisture"] = "mdi:water-alert"
  ["smoke"] = "mdi:smoke-detector"
  ["problem"] = "mdi:alert-circle"
  ["connectivity"] = "mdi:lan-connect"
  ["update"] = "mdi:package-up"
  ["running"] = "mdi:play"
  ["lock"] = "mdi:lock"
  ["safety"] = "mdi:shield-check"
  ["tamper"] = "mdi:hand-back-right"
  ["sound"] = "mdi:music-note"
  ["vibration"] = "mdi:vibrate"
  ["plug"] = "mdi:power-plug"
  ["shutter"] = "mdi:window-shutter"
  ["blind"] = "mdi:blinds"
  ["curtain"] = "mdi:curtains"
  ["awning"] = "mdi:awning-outline"
  ["enum"] = "mdi:format-list-bulleted"
}

/// Per domain — the last resort before no icon at all. Covers every domain the
/// reference instance reports; an unlisted one yields null and the template
/// section renders nothing, which is the right failure (a wrong glyph is worse
/// than none).
const domainIcons: Mapping<String, String> = new {
  ["light"] = "mdi:lightbulb"
  ["switch"] = "mdi:toggle-switch-variant"
  ["input_boolean"] = "mdi:toggle-switch-variant"
  ["sensor"] = "mdi:eye"
  ["binary_sensor"] = "mdi:radiobox-blank"
  ["lock"] = "mdi:lock"
  ["cover"] = "mdi:window-shutter"
  ["climate"] = "mdi:thermostat"
  ["fan"] = "mdi:fan"
  ["media_player"] = "mdi:speaker"
  ["camera"] = "mdi:video"
  ["person"] = "mdi:account"
  ["device_tracker"] = "mdi:account-arrow-right"
  ["scene"] = "mdi:palette"
  ["script"] = "mdi:script-text"
  ["automation"] = "mdi:robot"
  ["vacuum"] = "mdi:robot-vacuum"
  ["lawn_mower"] = "mdi:robot-mower"
  ["weather"] = "mdi:weather-partly-cloudy"
  ["button"] = "mdi:gesture-tap-button"
  ["number"] = "mdi:ray-vertex"
  ["input_number"] = "mdi:ray-vertex"
  ["select"] = "mdi:form-select"
  ["input_select"] = "mdi:form-select"
  ["text"] = "mdi:form-textbox"
  ["input_text"] = "mdi:form-textbox"
  ["date"] = "mdi:calendar"
  ["datetime"] = "mdi:calendar-clock"
  ["time"] = "mdi:clock"
  ["calendar"] = "mdi:calendar"
  ["event"] = "mdi:calendar-clock"
  ["image"] = "mdi:image"
  ["update"] = "mdi:package-up"
  ["sun"] = "mdi:white-balance-sunny"
  ["zone"] = "mdi:map-marker-radius"
  ["notify"] = "mdi:message"
  ["conversation"] = "mdi:forum"
  ["siren"] = "mdi:bullhorn"
  ["valve"] = "mdi:pipe-valve"
  ["water_heater"] = "mdi:water-boiler"
  ["humidifier"] = "mdi:air-humidifier"
  ["alarm_control_panel"] = "mdi:shield-home"
}

/// Domains whose glyph is a function of the entity's STATE — HA shows a lock
/// open and a lock closed differently, and a tile that cannot is reading half
/// the entity out loud.
///
/// A `Mapping<state, mdi name>` per domain plus a fallback, which is exactly a
/// [[simpleMod.SimpleMatch]] — the state lookup that already exists, evaluated
/// on the fast tier with no engine involved. That is what makes this cheap
/// enough to be worth it: the reason it was ruled out before was a per-card
/// JSONata transform, and neither half of that is true any more (ADR 0027 moved
/// to CEL, and ADR 0017 shares a display signal per `(entity, transform)` — one
/// frame entry for the whole page, not one per card).
///
/// SMALL ON PURPOSE. One domain earns it here; the next is one row, the same
/// way `hass/actions.pkl` grows. A domain is worth adding when HA's own frontend
/// draws it differently per state AND the difference is the thing you look at
/// the tile to learn.
const stateIcons: Mapping<String, Mapping<String, String>> = new {
  // `jammed` gets its own alert glyph: it is the one lock state you want to
  // notice from across the room, and it is not "unlocked".
  ["lock"] = new {
    ["locked"] = "mdi:lock"
    ["unlocked"] = "mdi:lock-open"
    ["open"] = "mdi:lock-open-variant"
    ["opening"] = "mdi:lock-open-variant"
    ["locking"] = "mdi:lock-clock"
    ["unlocking"] = "mdi:lock-clock"
    ["jammed"] = "mdi:lock-alert"
  }
}
