/// What a TAP on an entity means, per domain — HA's service model, vendored.
/// A build-time table rather than a runtime lookup (ADR 0016). An absent
/// domain has no sensible tap, which is what lets a card fall back to
/// more-info.
///
/// Checked against a live instance's `/api/services` (2026-08-14, 83 service
/// domains); re-run that when syncing to a newer HA. A stale table is a missing
/// row, which degrades to more-info, rather than a wrong one.
module hass_actions

/// A tap whose service is the same in every state.
class Call {
  /// `"<domain>/<service>"`.
  action: String
}

/// A tap whose service the CURRENT state picks: [[then]] while the state is
/// [[whenState]], else [[otherwise]]. Deliberately a two-way test; growing past
/// one is the trigger to revisit ADR 0016.
class CallByState {
  whenState: String
  then: String
  otherwise: String
  /// States in which a tap is meaningless because the entity is already moving:
  /// `unlocking` is not `locked`, so a tap would post `lock/lock` against the
  /// command running. A guard, not a third branch. Transitional states only —
  /// a `jammed` lock should still take a retry.
  disabledWhile: Listing<String> = new {}
}

typealias DomainAction = Call|CallByState

/// Absent on purpose, though they have services: `update` (a stray tap would
/// flash firmware), `alarm_control_panel`, and `number`/`select`/`text`/
/// `date`/`time`, whose value must be chosen. Those open more-info.
const ACTIONS: Mapping<String, DomainAction> = new {
  ["light"] = new Call { action = "light/toggle" }
  ["switch"] = new Call { action = "switch/toggle" }
  ["fan"] = new Call { action = "fan/toggle" }
  ["cover"] = new Call { action = "cover/toggle" }
  ["valve"] = new Call { action = "valve/toggle" }
  ["climate"] = new Call { action = "climate/toggle" }
  ["humidifier"] = new Call { action = "humidifier/toggle" }
  ["siren"] = new Call { action = "siren/toggle" }
  ["remote"] = new Call { action = "remote/toggle" }
  ["media_player"] = new Call { action = "media_player/toggle" }
  ["input_boolean"] = new Call { action = "input_boolean/toggle" }
  // Enables or disables it; `automation/trigger` would run it.
  ["automation"] = new Call { action = "automation/toggle" }

  // No `toggle` of their own, so HA's dispatcher does it.
  ["camera"] = new Call { action = "homeassistant/toggle" }
  ["water_heater"] = new Call { action = "homeassistant/toggle" }
  ["group"] = new Call { action = "homeassistant/toggle" }

  ["button"] = new Call { action = "button/press" }
  ["input_button"] = new Call { action = "input_button/press" }
  ["scene"] = new Call { action = "scene/turn_on" }
  // Run it, as HA's own script rows do.
  ["script"] = new Call { action = "script/turn_on" }

  ["lock"] = new CallByState {
    whenState = "locked"
    then = "lock/unlock"
    otherwise = "lock/lock"
    // Locking an open door and retrying a jam are both meaningful.
    disabledWhile { "locking"; "unlocking"; "opening" }
  }
  ["vacuum"] = new CallByState {
    whenState = "cleaning"
    then = "vacuum/return_to_base"
    otherwise = "vacuum/start"
    disabledWhile { "returning" }
  }
  ["lawn_mower"] = new CallByState {
    whenState = "mowing"
    then = "lawn_mower/dock"
    otherwise = "lawn_mower/start_mowing"
    disabledWhile { "returning" }
  }
  // Starting a paused timer resumes it.
  ["timer"] = new CallByState {
    whenState = "active"
    then = "timer/pause"
    otherwise = "timer/start"
  }
}

/// What a tap on `domain` calls, or null, which a card turns into more-info.
const function forDomain(domain: String): DomainAction? = ACTIONS.getOrNull(domain)

/// Domains whose CARD opens more-info though the domain has a service, so a
/// stray tap on a wall tablet cannot unlock the front door. The service stays
/// in [[ACTIONS]] for what is pressed on purpose: an entity button, a toggle.
/// HA's tile never acts on a lock either.
const cardOpensMoreInfo: Set<String> = Set("lock")
