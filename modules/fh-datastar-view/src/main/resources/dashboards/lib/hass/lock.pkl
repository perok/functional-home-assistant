/// HA's `lock` domain constants, vendored verbatim from
/// `homeassistant/components/lock/const.py`
/// (https://developers.home-assistant.io/docs/core/entity/lock). The
/// `LockEntityFeature` bits are safe to copy: they are append-only, never
/// renumbered.
module hass_lock

/// Every state a lock reports; `locking`/`unlocking`/`opening` are transient,
/// and `jammed` means it tried and could not. The query layer still compares
/// states as plain Strings.
typealias LockState =
  "locked"|"unlocked"|"locking"|"unlocking"|"open"|"opening"|"jammed"

/// The lock can release its latch (`lock/open`), the domain's only flag.
const OPEN: Int = 1

/// HA's `canOpen`, as the states it says no in. Typed [[LockState]], which
/// keeps `"unavailable"` out: availability is `tap.refusedStates`'s, for every
/// service tap. A lock that never reports the optional transient states is
/// never inert, as with HA's own button.
const CANNOT_OPEN: List<LockState> = List(
  "open",
  "opening",
  "unlocking",
  "locking"
)

/// HA's `canLock` and `canUnlock` the same way: the state the press would
/// reach, and the transient ones. HA's `assumed_state` exception, which enables
/// both on a lock that cannot report its state, is not modelled.
const CANNOT_LOCK: List<LockState> = List("locked", "opening", "unlocking", "locking")
const CANNOT_UNLOCK: List<LockState> = List("unlocked", "opening", "unlocking", "locking")
