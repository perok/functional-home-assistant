#!/usr/bin/env bash
# pkl-fh — a `pkl` the IntelliJ plugin can be pointed at.
#
# Point the plugin's Pkl executable at this file (Settings -> Languages &
# Frameworks -> Pkl). It forwards every argument to the real pkl and injects the
# two settings a dashboards workspace needs, which the CLI otherwise drops.
#
# WHY this exists: `pkl project resolve <dir>` — exactly how the plugin syncs —
# ignores the project's own `evaluatorSettings`. Its `http.rewrites` can be
# lifted to `~/.pkl/settings.pkl` (`fh init-lsp-fix`), but from pkl 0.32 the
# resource allowlist is ALSO checked against the rewritten url, and `pkl:settings`
# has no `allowedResources` property to lift. The command line is the only
# remaining lever, and the plugin does not expose it — so we wrap the executable
# instead. See docs/pkl-issue-http-rewrites-project-resolve.md.
#
# Nothing is baked in: the instance URL is read from the workspace's own
# `.fh/machine.json`, so this keeps working when you re-point at another
# instance, and does nothing at all outside a dashboards workspace.
set -euo pipefail

# The real pkl. $FH_PKL wins; otherwise the first `pkl` on PATH that is not this
# script (so a symlinked/renamed copy cannot recurse into itself).
self=$(readlink -f "${BASH_SOURCE[0]}")
real=${FH_PKL:-}
if [[ -z $real ]]; then
  while read -r candidate; do
    [[ $(readlink -f "$candidate") != "$self" ]] || continue
    real=$candidate
    break
  done < <(type -ap pkl || true)
fi
[[ -n $real ]] || {
  echo "pkl-fh: no real pkl found — set FH_PKL to its path" >&2
  exit 1
}

# Only inject where pkl accepts the flags (verified by RUNNING them — the
# --help rendering is not a reliable oracle). Everything else — format, analyze,
# --version, shell-completion — passes through untouched. `skip` is how many
# leading words the subcommand itself occupies.
inject=false
skip=0
case "${1:-} ${2:-}" in
  "project resolve"*) inject=true; skip=2 ;;
  "eval "* | "test "* | "download-package "* | "repl "*) inject=true; skip=1 ;;
  eval | test | download-package | repl) inject=true; skip=1 ;;
esac

# The workspace: --project-dir, else the first PATH argument after the
# subcommand (`project resolve <dir>`), else the working directory. Then walk up
# for `.fh/`, since the plugin may name a subdirectory — and because for `eval`
# the positional is a file, not the workspace.
#
# Skipping the subcommand matters: `project` is itself a plausible directory
# name (sbt has one), so scanning from $1 picks the wrong workspace.
ws=""
prev=""
for arg in "${@:skip+1}"; do
  if [[ $prev == "--project-dir" ]]; then ws=$arg; break; fi
  if [[ $arg == --project-dir=* ]]; then ws=${arg#*=}; break; fi
  if [[ -z $ws && $arg != -* && -d $arg ]]; then ws=$arg; fi
  prev=$arg
done
ws=$(readlink -f "${ws:-$PWD}" 2>/dev/null || echo "$PWD")
while [[ $ws != "/" && ! -f $ws/.fh/machine.json ]]; do ws=$(dirname "$ws"); done

if [[ $inject == true && -f $ws/.fh/machine.json ]]; then
  url=$(sed -n 's/.*"instanceUrl"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
    "$ws/.fh/machine.json")
  if [[ -n $url ]]; then
    # `--allowed-resources` REPLACES pkl's defaults, so they are relisted; and
    # the allowlist is applied to the url BEFORE and AFTER the rewrite, so both
    # `https:` and the instance origin have to be present. Dots become `[.]` so
    # the pattern cannot match arbitrary characters.
    origin=${url//./[.]}
    set -- "$@" \
      --http-rewrite "https://fh.invalid/=${url}/system/pkl/packages/" \
      --allowed-resources "prop:,env:,file:,modulepath:,package:,projectpackage:,https:,^${origin}/"
  fi
fi

exec "$real" "$@"
