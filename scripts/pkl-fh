#!/usr/bin/env bash
# pkl-fh — a `pkl` the IntelliJ plugin can be pointed at.
#
# Point the plugin's Pkl executable at this file (Settings -> Languages &
# Frameworks -> Pkl). It forwards every argument to the real pkl and injects the
# two settings a dashboards workspace needs, which the CLI otherwise drops.
#
# WHY this exists: `pkl project resolve <dir>…` — exactly how the plugin syncs —
# ignores the project's own `evaluatorSettings`. Its `http.rewrites` can be
# lifted to `~/.pkl/settings.pkl` (`fh init-lsp-fix`), but from pkl 0.32 the
# resource allowlist is ALSO checked against the rewritten url, and `pkl:settings`
# has no `allowedResources` property to lift. The command line is the only
# remaining lever, and the plugin does not expose it — so we wrap the executable
# instead. See docs/issue-report-1-pkl-cli-http-rewrites-project-resolve.md.
#
# Nothing is baked in: instance URLs come from the workspaces' own
# `.fh/machine.json`, falling back to the rewrite in ~/.pkl/settings.pkl for the
# commands that name no directory — so this keeps working when you re-point at
# another instance. Widening is additive (pkl's defaults are always relisted)
# and never names a host you have not already configured.
set -euo pipefail

# The real pkl. $FH_PKL wins; then the first `pkl` on PATH that is not this
# script (so a renamed/symlinked copy cannot recurse into itself); then
# ~/pkl-cli, where this project's CLI conventionally lives.
self=$(readlink -f "${BASH_SOURCE[0]}")
real=${FH_PKL:-}
if [[ -z $real ]]; then
  while read -r candidate; do
    [[ $(readlink -f "$candidate") != "$self" ]] || continue
    real=$candidate
    break
  done < <(type -ap pkl || true)
fi
[[ -n $real || ! -x $HOME/pkl-cli ]] || real=$HOME/pkl-cli
[[ -n $real ]] || {
  echo "pkl-fh: no real pkl found — set FH_PKL to its path" >&2
  exit 1
}

# Only inject where pkl accepts the flags (established by RUNNING them — the
# --help rendering is not a reliable oracle). Everything else — format, analyze,
# --version, shell-completion — passes through untouched. `skip` is how many
# leading words the subcommand itself occupies.
inject=false
skip=0
case "${1:-} ${2:-}" in
  "project resolve"*) inject=true; skip=2 ;;
  "eval "* | "test "* | "download-package "* | "repl "*) inject=true; skip=1 ;;
  eval | test | download-package | repl) inject=true; skip=1 ;;
esac

# Never override a flag the caller already passed. The plugin supplies its own
# `--cache-dir ~/.pkl/cache` on `download-package`, and pkl takes the LAST
# occurrence — so appending ours would send the download to a different cache
# than the one the IDE then reads, which looks exactly like the bug this script
# exists to fix. We never inject `--cache-dir` at all for the same reason:
# whichever cache the caller picks, it has to be the only one in play.
has_flag() {
  local needle=$1 arg
  shift # else the needle itself matches and every flag looks already-present
  for arg in "$@"; do
    [[ $arg == "$needle" || $arg == "$needle="* ]] && return 0
  done
  return 1
}

# The instance origins to allow.
#
# The plugin syncs EVERY project in the content root in one call — here that is
# the lib package plus two dashboards workspaces — so this walks all of them and
# collects each distinct instance, rather than trusting the first. The first
# argument is routinely a project with no `.fh/` at all (the lib), and stopping
# there is why an earlier version injected nothing.
#
# Each candidate walks UP as well, since the plugin may name a subdirectory of
# the workspace.
urls=()
if [[ $inject == true ]]; then
  dirs=()
  prev=""
  for arg in "${@:skip+1}"; do
    if [[ $prev == "--project-dir" ]]; then dirs+=("$arg")
    elif [[ $arg == --project-dir=* ]]; then dirs+=("${arg#*=}")
    elif [[ $arg != -* && -d $arg ]]; then dirs+=("$arg")
    fi
    prev=$arg
  done
  [[ ${#dirs[@]} -gt 0 ]] || dirs=("$PWD")

  for dir in "${dirs[@]}"; do
    d=$(readlink -f "$dir" 2>/dev/null) || continue
    while [[ $d != "/" && ! -f $d/.fh/machine.json ]]; do d=$(dirname "$d"); done
    [[ -f $d/.fh/machine.json ]] || continue
    url=$(sed -n 's/.*"instanceUrl"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
      "$d/.fh/machine.json")
    [[ -n $url ]] || continue
    # Distinct only: the same instance normally serves every workspace.
    for seen in ${urls[@]+"${urls[@]}"}; do
      [[ $seen == "$url" ]] && url="" && break
    done
    [[ -n $url ]] && urls+=("${url%/}/")
  done

  # `download-package` carries package URIs and NO directory, so there is no
  # workspace to read. Fall back to the rewrite `fh init-lsp-fix` already put in
  # ~/.pkl/settings.pkl: its target names the same instance, and allowing that
  # exact prefix is tighter than allowing the origin.
  if [[ ${#urls[@]} -eq 0 && -f $HOME/.pkl/settings.pkl ]]; then
    target=$(sed -n \
      's|.*"https://fh[.]invalid/"\][[:space:]]*=[[:space:]]*"\([^"]*\)".*|\1|p' \
      "$HOME/.pkl/settings.pkl")
    [[ -n $target ]] && urls+=("${target%/}/")
  fi
fi

if [[ ${#urls[@]} -gt 0 ]]; then
  if ! has_flag --allowed-resources "$@"; then
    # `--allowed-resources` REPLACES pkl's defaults, so they are relisted; and
    # the allowlist is applied to the url BEFORE and AFTER the rewrite, so
    # `https:` has to stay alongside the instance prefixes. Dots become `[.]` so
    # a pattern cannot match arbitrary characters.
    allowed="prop:,env:,file:,modulepath:,package:,projectpackage:,https:"
    for url in "${urls[@]}"; do
      allowed+=",^${url//./[.]}"
    done
    set -- "$@" --allowed-resources "$allowed"
  fi
  # One rewrite prefix can only have one target, so the first instance wins —
  # they agree unless workspaces genuinely point at different instances. Skipped
  # when the settings.pkl fallback supplied the url, since that IS a rewrite.
  if ! has_flag --http-rewrite "$@" && [[ ${urls[0]} != *"/system/pkl/packages/" ]]; then
    set -- "$@" \
      --http-rewrite "https://fh.invalid/=${urls[0]}system/pkl/packages/"
  fi
fi

[[ -z ${FH_PKL_DEBUG:-} ]] || echo "pkl-fh: exec $real $*" >&2
exec "$real" "$@"
