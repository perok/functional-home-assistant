// A Pkl-authored tabs dashboard, served at /d/pkl-tabs (slug = filename) — the
// typed counterpart of tabs.jsonnet. Demonstrates the `Tabs` sugar: one bar over
// a single inline panel, one tab visible at a time.
//
// `(c.tabs) { tabs { ["Label"] { ...cards... } } }` is pure composition — each
// tab amends into existence off the mapping default (its body lists the panel's
// cards directly; the Row wrap is automatic), the build-phase hoist lifts each
// panel into the surfaces registry (sharing one exclusivity group + one inline
// mount), the bar buttons open them, the first tab bakes inline for an instant
// first paint, and the active tab is tracked in a signal (+ cookie) for the
// highlight and reload-restore. Switching reuses the same surface open/close
// machinery as popups.
//
// `amends "@fh-dashboard/entry.pkl"` supplies the `cards`/`theme` scaffold; this
// entry sets only `card` (its tab panels become hoisted surfaces at build time).
// (Plain `//` comments: a doc comment would attach to the first import, which
// Pkl rejects — entries have no `module` clause to absorb it.)

amends "@fh-dashboard/entry.pkl"

import "@fh-dashboard/components.pkl" as c
import "@fh-dashboard/hass.pkl" as hass
import "@fh-home/dump.pkl" as dump

// A floor carries its areas' lights under the same name every scope uses.
local floorLights = dump.overetasje.lights
local memberEntityIds =
  floorLights
    .flatMap((v) -> v.members.map((e) -> e.entity_id)) //dump.e_light_relative_kitchen.members
local allWithoutMembers =
  floorLights
    .toSet()
    .filter((l) -> !memberEntityIds.contains(l.entity_id))
local allAreas = allWithoutMembers.map((l) -> l.area_id).toSet()

card = (c.column) {
  children {
    c.title("Overetasje")
    (c.row) {
      children {
        c.button("« Home", c.tap.navigate("pkl-demo"))
      }
    }
    //(c.slider(dump.entities.light_relative_kitchen)) {
    (c.slider(dump.entities.light_light_hue_ea11e1_kjokken_light)) {
      icon = "mdi:lightbulb-group"
      secondary = c.exprOf(dump.entities.sensor_netatmo_kjokken_temperature, #"state + ' °C'"#)
      // TODO tapaction is on/off button? Not composable
      tapAction = c.tap.service("light/toggle")
      members {
        c.slider(dump.entities.light_hue_led_list_kjokken_light).readout("percent").icon(null)
        c.slider(dump.entities.light_light_hue_e0e381_kjokken_light).readout("percent").icon(null)
        c.slider(dump.entities.light_light_hue_ea11e1_kjokken_light).readout("percent").icon(null)
      }
    }

    for (area in allAreas) {
      // TODO shitty syntax https://github.com/apple/pkl/issues/549
      for (allInArea in List(allWithoutMembers.filter((l) -> l.area_id == area))) {
        when (allAreas.length > 0) {
          // TODO dump.areas.all[area].area_name ?
          c.title(
            (dump.areas.toMap().values as List<hass.Area>).find((a) -> a.area_id == area).area_name,
          )
          for (light in allInArea) {
            // TODO filter away unavailable here?
            c
              .slider(light)
              .withSubSliders(
                light.members.map((l) -> c.slider(l).readout("percent").icon(null))
              )
            //c.sliderGroup(light, light.members) // TODO mixin for children? .readout("percent").icon(null)
          }
        }
      }
    }
  }
}
