.scalex/

# runtime asset cache when the server is run from the repo root
/assets-cache/

# Local state for the repowise tool (knowledge graph, caches, lancedb).
# Never tracked: 25 MB of machine-local artifacts.
.repowise/

# `nix build` drops this symlink to the store path in the repo root.
/result

# scala-cli's build output for the `fh` laptop script (classes, tasty, the
# IDE handshake files). Regenerated by `scala-cli test .` in scripts/.
scripts/.scala-build/

# Per-machine Claude Code settings — the shared ones are `.claude/settings.json`,
# which IS tracked. This is the local override and belongs to whoever ran it.
.claude/settings.local.json

# Editor/agent backups. Nothing here is ever worth committing, and 172 of these
# plus the two dirs above once rode in on a `git add -A`.
*.bak

# JMH run output (sbt-jmh writes it to the working dir)
jmh-result.*
