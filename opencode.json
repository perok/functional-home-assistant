{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "metals": {
      "type": "local",
      "command": [
        "metals-mcp",
        "--workspace",
        ".",
        "--transport",
        "stdio"
      ],
      "enabled": true
    },
    "jcodemunch": {
      "type": "local",
      "command": [
        "jcodemunch-mcp"
      ],
      "enabled": true
    }
  }
}
