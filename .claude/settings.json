{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:*)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git stash *)",
      "Bash(sbt scalafmt *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(timeout 120 sbt dashboardBuild)",
      "Bash(sbt -batch 'fh-datastar-view/Test/compile')",
      "Bash(sbt -batch 'fh-datastar-view/testFull')",
      "Bash(sbt -batch dashboardBuild)",
      "Bash(sbt -batch -error 'fh-datastar-view/testFull')",
      "Bash(sbt -batch -error 'fh-datastar-view/scalafmt; fh-datastar-view/test:scalafmt')",
      "Bash(sbt -batch -error 'fh-datastar-view/scalafmt; fh-datastar-view/Test/scalafmt')",
      "Bash(timeout 150 sbt -batch -error 'dashboardBuild')",
      "Bash(sbt 'dashboardBuild ; scalafmt')"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false,
    "scalex@scalex-marketplace": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "scalafmt >&2",
            "if": "Bash(git add *)",
            "timeout": 60,
            "statusMessage": "Running scalafmt before git add..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/block-shell-file-edits.sh",
            "timeout": 10,
            "statusMessage": "Checking for shell-based file edits..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-protected-paths.sh",
            "timeout": 10,
            "statusMessage": "Checking protected paths..."
          }
        ]
      }
    ]
  }
}
